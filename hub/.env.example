# Runtime values for this generated build. Brand and architecture live in code.

# Application
# development is for localhost. production enables secure cookies and cached assets.
APP_ENV=development
# APP_URL is the address you open in the browser. Passkeys need https or localhost.
APP_URL=http://localhost:8090
PORT=8090
# SUPPORT_EMAIL=hello@moin.run  # where people write; the default is moin's own
# Comma-separated operator addresses. Each signs up with GitHub, whose verified primary email is this address.
# They may always sign up, also while sign-up is closed. On a self-hosted hub, put your own address
# here: without one, nobody can create the first account.
ADMIN_EMAILS=operator@example.com

# Database
DB_CONNECTION=./data/app.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)

# Session and token expiry
SESSION_EXPIRY=168h
TOKEN_EMAIL_VERIFY_EXPIRY=24h
TOKEN_EMAIL_CHANGE_EXPIRY=24h

# Keep empty unless a reverse proxy reaches the app through a private network.
# Set it so auth rate limits use the visitor IP without trusting fake proxy headers.
# Trust only that exact network. Never use 0.0.0.0/0 or ::/0.
# Docker: docker network inspect YOUR_NETWORK --format '{{(index .IPAM.Config 0).Subnet}}'
TRUSTED_PROXY_CIDRS=
# A self-hosted hub behind a Cloudflare Tunnel: the tunnel's token. update.sh then starts
# cloudflared and no web port is open. The hub itself never reads it.
# TUNNEL_TOKEN=
# Old domains of this hub, comma-separated, like https://old.example.com.
# It still answers there: browsers go on to APP_URL, daemons and the CLI move by themselves,
# and admins see under Admin, Old domain, what still arrives. Keep empty without one.
OLD_URLS=

# JSON API
# Comma-separated browser origins that may call /api/ with cookies or a bearer token,
# for example https://app.example.com,http://localhost:5173. Exact matches only, no wildcards.
# Keep empty when the frontend is served from APP_URL or the clients are native apps.
CORS_ALLOWED_ORIGINS=

# The moin GitHub App, which signs people in and connects repos. Leave these
# empty and an admin creates it in the web with one click: Create GitHub
# App. Set, they win over that one. By hand, create it on GitHub with
# Contents: read, Commit statuses: read and write and, under account
# permissions, Email addresses: read; events Push and Installation.
# Callback URLs: first {APP_URL}/app/github/setup, then
# {APP_URL}/auth/github/callback, with "Request user authorization (OAuth)
# during installation" and "Redirect on update" ticked; webhook URL:
# {APP_URL}/webhooks/github. The private key may use \n for newlines.
# Until the hub has an app, the admin signs in with a key from
# ./main recovery-key <email>.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Or the path of the key file, which keeps its line breaks.
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_APP_WEBHOOK_SECRET=
# The app's client ID and a client secret, from its settings page. moin
# uses them to sign people in with GitHub and to ask GitHub who installed
# the app, so nobody can connect another account's installation. Without
# them nobody signs in with GitHub, and moin warns at startup.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Email goes through Cloudflare Email Sending. EMAIL_FROM must be on a domain
# set up for sending in Cloudflare. Without the account ID and token in
# development, emails are written to the log instead.
EMAIL_FROM=noreply@example.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Seals the Cloudflare API token, alert targets, webhook signing secrets and
# the keys of the GitHub App the hub created, which the hub uses itself. 32
# bytes in base64: openssl rand -base64 32
# Required outside development. Changing it makes those unreadable.
SECRETS_KEY=

# Payments. BILLING=false runs a self-hosted hub: no Stripe, no
# prices, every workspace gets everything.
BILLING=true
# A self-hosted hub sends a few anonymous counts every five minutes:
# instance ID, version, servers, apps, deploys. TELEMETRY=false turns it off.
TELEMETRY=true
# A self-hosted hub asks GitHub once a day for the newest release
# and tells its admins when an update is out. UPDATE_CHECK=false turns it off.
UPDATE_CHECK=true
# true when the hub runs on the same server as its apps, as
# install.sh sets it up: the daemon's proxy serves it, and starts on the
# server's first connect.
SAME_SERVER=false
# false closes sign-up: new accounts only for ADMIN_EMAILS and invited people,
# others see "ask its admin for an invitation". A self-hosted hub
# (BILLING=false) is closed by default.
# Default: true with billing, false without.
# SIGNUPS_OPEN=true
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
# The hosted product: every price of it is the plan, also an older one a
# subscription still pays. The two prices are what a new checkout sells.
STRIPE_PRODUCT_ID_PRO=prod_xxxxxxxxxxxxx
STRIPE_PRICE_ID_PRO_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_ID_PRO_YEARLY=price_xxxxxxxxxxxxx
# S3-compatible storage. Cloudflare R2 and AWS S3 are supported. Development
# gets its own bucket, named <app>-development, with a key for that bucket
# only; production gets <app>-production. For R2:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto.
S3_REGION=auto
S3_BUCKET=moin-development
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
# Every change of the hub's own database goes to this bucket too,
# and a server without a database restores it from there on start. On by
# default in production.
# BACKUP_DATABASE=true
# Every domain of every live app is checked once a minute, like a visitor.
# On by default in production; off in development, so no real domain gets
# called. UPTIME=true turns them on.
# UPTIME=false
# S3_PRESIGN_EXPIRY_PUBLIC=168h
# S3_PRESIGN_EXPIRY_PRIVATE=1h

# Optional analytics and error tracking
UMAMI_WEBSITE_ID=
UMAMI_HOST=cloud.umami.is
PLAUSIBLE_DOMAIN=
PLAUSIBLE_HOST=plausible.io
GOOGLE_ANALYTICS_ID=
SENTRY_DSN=

# Prevent indexing on staging or private preview deployments.
# Default: false with billing, true on a self-hosted hub.
# ROBOTS_NOINDEX=false

# Logging
LOG_LEVEL=
LOG_FORMAT=pretty
LOG_HTTP=true
