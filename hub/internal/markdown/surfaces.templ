package markdown

import "github.com/axadrn/moin/hub/internal/ui/components"

// surfaceItem is one surface of a surfaces block: a line of code, or lines
// of rendered inline markdown.
type surfaceItem struct {
	Value string
	Label string
	Code  bool
	Text  string
	HTML  []string
}

// surfacesView is a surfaces block on a card: a components.Choice of the
// surfaces over what to do on the one picked. The checked radio shows its
// part by CSS alone (data-surfaces and data-surface in moin UI), so it works
// without a script; the first is picked. The docs page script makes every
// block of a page show the surface the reader picked last. name is the
// block's own radio group.
templ surfacesView(name string, items []surfaceItem) {
	<div class="moin-card" data-surfaces>
		@components.Choice(components.ChoiceProps{Name: name, Label: "Where", Options: surfaceOptions(items), Checked: items[0].Value})
		for _, item := range items {
			<div data-surface={ item.Value }>
				if item.Code {
					@components.Code(components.CodeProps{ID: name + "-" + item.Value + "-code", Text: item.Text})
				} else {
					<div class="moin-stack" data-gap="3">
						for _, html := range item.HTML {
							<p>
								@templ.Raw(html)
							</p>
						}
					</div>
				}
			</div>
		}
	</div>
}

func surfaceOptions(items []surfaceItem) []components.Option {
	options := make([]components.Option, 0, len(items))
	for _, item := range items {
		options = append(options, components.Option{Value: item.Value, Label: item.Label})
	}
	return options
}
