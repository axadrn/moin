package markdown

import (
	"github.com/axadrn/moin/hub/internal/ui/kit"
	"github.com/axadrn/moin/hub/internal/ui/components"
)

// surfaceItem is one surface of a surfaces block: a line of code, or lines
// of rendered inline markdown.
type surfaceItem struct {
	Value string
	Label string
	Code  bool
	Text  string
	HTML  []string
}

// surfacesView is a surfaces block on a card: a kit.Choice of the
// surfaces over what to do on the one picked. The checked radio shows its
// part by CSS alone, so it works without a script; the first is picked.
// The docs page script makes every block of a page show the surface the
// reader picked last. name is the block's own radio group.
templ surfacesView(name string, items []surfaceItem) {
	<div class={ "mt-6 min-w-0 overflow-hidden rounded-[18px] bg-card", kit.SurfaceShown } data-surfaces>
		<div class="max-w-full overflow-x-auto px-3 pt-3 [scrollbar-width:none]">
			@kit.Choice(name, "Where", surfaceOptions(items), items[0].Value)
		</div>
		for _, item := range items {
			<div class="hidden min-w-0 text-base [&_[data-slot=code-block]]:mt-0" data-surface={ item.Value }>
				if item.Code {
					<pre class="m-0 rounded-none bg-transparent px-6 py-4 pr-14"><code>{ item.Text }</code></pre>
				} else {
					for _, html := range item.HTML {
						<p class="m-0 px-6 py-4 [&+p]:pt-0">
							@templ.Raw(html)
						</p>
					}
				}
			</div>
		}
	</div>
}

func surfaceOptions(items []surfaceItem) []components.Option {
	options := make([]components.Option, 0, len(items))
	for _, item := range items {
		options = append(options, components.Option{Value: item.Value, Label: item.Label})
	}
	return options
}
