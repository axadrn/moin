package components

// Kind is how much a button stands out. One Primary per screen. No kind is
// the plain button.
type Kind string

const Primary Kind = "primary"

// ButtonProps is a Button. With Href it is a link that looks like a button.
// Icon is a round button with only an icon, and then Attrs needs an
// aria-label. Quiet has no background until the pointer is on it.
type ButtonProps struct {
	Kind  Kind
	Href  string
	Icon  bool
	Quiet bool
	Attrs templ.Attributes
}

templ Button(p ButtonProps) {
	if p.Href != "" {
		<a
			href={ templ.SafeURL(p.Href) }
			class="moin-button"
			if p.Kind != "" {
				data-kind={ string(p.Kind) }
			}
			data-icon?={ p.Icon }
			data-quiet?={ p.Quiet }
			{ p.Attrs... }
		>
			{ children... }
		</a>
	} else {
		<button
			type="button"
			class="moin-button"
			if p.Kind != "" {
				data-kind={ string(p.Kind) }
			}
			data-icon?={ p.Icon }
			data-quiet?={ p.Quiet }
			{ p.Attrs... }
		>
			{ children... }
		</button>
	}
}
