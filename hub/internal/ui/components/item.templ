package components

// List is a group of items on one card.
templ List() {
	<div class="moin-list">
		{ children... }
	</div>
}

// ItemProps is one Item of a List. What it does decides what it is:
//
//   - Href: it opens a page, the whole item is a link with a chevron.
//     External opens another site in a new tab.
//   - Button: it does something on this page. Danger makes its words red.
//   - For: it holds the control with that id, and its words are the label.
//     Form makes the item the form, for a control that saves itself.
//   - none of them: it only tells.
//
// Lead stands in front of the words: a face, an initial. Name and Note are
// the words, Value a quiet value at the end. Children come after the words:
// a status, a button, the control.
type ItemProps struct {
	Href     string
	External bool
	Button   bool
	Danger   bool
	For      string
	Form     bool
	Name     string
	Note     string
	Value    string
	Lead     templ.Component
	Attrs    templ.Attributes
}

templ Item(p ItemProps) {
	switch {
		case p.Href != "" && p.External:
			<a href={ templ.SafeURL(p.Href) } target="_blank" rel="noopener" class="moin-item" { p.Attrs... }>
				@itemText(p)
				{ children... }
				<i class="moin-out"></i>
			</a>
		case p.Href != "":
			<a href={ templ.SafeURL(p.Href) } class="moin-item" { p.Attrs... }>
				@itemText(p)
				{ children... }
				<i class="moin-chevron"></i>
			</a>
		case p.Button:
			<button type="button" class="moin-item" data-danger?={ p.Danger } { p.Attrs... }>
				if p.Name != "" {
					<span class="moin-strong">{ p.Name }</span>
				}
				{ children... }
			</button>
		case p.Form:
			<form class="moin-item" data-control { p.Attrs... }>
				@itemLabel(p)
				{ children... }
			</form>
		case p.For != "":
			<div class="moin-item" data-control { p.Attrs... }>
				@itemLabel(p)
				{ children... }
			</div>
		default:
			<div class="moin-item" { p.Attrs... }>
				@itemText(p)
				{ children... }
			</div>
	}
}

templ itemText(p ItemProps) {
	if p.Lead != nil {
		<span data-lead>
			@p.Lead
		</span>
	}
	if p.Name != "" {
		<div class="moin-item-text">
			<div class="moin-item-name">{ p.Name }</div>
			if p.Note != "" {
				<div class="moin-item-note">{ p.Note }</div>
			}
		</div>
	}
	if p.Value != "" {
		<span class="moin-item-value">{ p.Value }</span>
	}
}

templ itemLabel(p ItemProps) {
	<label for={ p.For } class="moin-item-text">
		<span class="moin-item-name">{ p.Name }</span>
		if p.Note != "" {
			<span class="moin-item-note">{ p.Note }</span>
		}
	</label>
}
