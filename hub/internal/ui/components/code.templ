package components

// CodeProps is a block of code with a copy button.
type CodeProps struct {
	ID   string
	Text string
}

// Code prints text to read and copy.
templ Code(p CodeProps) {
	<div class="moin-code">
		<button type="button" class="moin-copy" data-copy data-copy-target={ "#" + p.ID } aria-label="Copy the code">
			<i class="moin-icon moin-icon-copy"></i>
		</button>
		<pre id={ p.ID } tabindex="0">{ p.Text }</pre>
	</div>
}

// CommandProps is a Command.
type CommandProps struct {
	Text string
}

// Command is one terminal command to copy.
templ Command(p CommandProps) {
	<div class="moin-command">
		<code>{ p.Text }</code>
		<button type="button" class="moin-copy" data-copy={ p.Text } aria-label="Copy the command">
			<i class="moin-icon moin-icon-copy"></i>
		</button>
	</div>
}
