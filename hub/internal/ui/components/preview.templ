package components

// CodeProps is a block of code with a copy button.
type CodeProps struct {
	ID   string
	Text string
}

// Code prints text to read and copy.
templ Code(p CodeProps) {
	<div class="moin-code">
		<button type="button" class="moin-copy" data-copy data-copy-target={ "#" + p.ID } aria-label="Copy the code">
			<i class="moin-icon moin-icon-copy"></i>
		</button>
		<pre id={ p.ID } tabindex="0">{ p.Text }</pre>
	</div>
}

// PreviewProps is something shown live, with its code under it.
type PreviewProps struct {
	ID     string
	Code   string
	Resize bool
}

// Preview shows its children on a stage and the code behind a Code button.
templ Preview(p PreviewProps) {
	<div class="moin-preview">
		<div class="moin-preview-stage" data-resize?={ p.Resize }>
			{ children... }
		</div>
		<details class="moin-preview-source">
			<summary>Code<i class="moin-chevron"></i></summary>
			@Code(CodeProps{ID: p.ID, Text: p.Code})
		</details>
	</div>
}
