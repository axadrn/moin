package components

// State is one of the states every status in moin shows as.
type State string

const (
	StateLive    State = "live"
	StateRunning State = "running"
	StateWaiting State = "waiting"
	StateDone    State = "done"
	StateFailed  State = "failed"
	StateIdle    State = "idle"
)

// StatusProps is a Status: the state, and its word as children.
type StatusProps struct {
	State State
	Attrs templ.Attributes
}

// Status is a state's dot and its word, in a line of text.
templ Status(p StatusProps) {
	<span class="moin-status" data-state={ string(p.State) } { p.Attrs... }><i class="moin-dot" data-state={ string(p.State) }></i>{ children... }</span>
}

// ChipProps is a Chip: the state, and its word as children.
type ChipProps struct {
	State State
	Attrs templ.Attributes
}

// Chip is a state's dot and its word in a soft pill, next to a thing's name.
templ Chip(p ChipProps) {
	<span class="moin-chip" data-state={ string(p.State) } { p.Attrs... }>
		<i class="moin-dot" data-state={ string(p.State) }></i>
		<span>
			{ children... }
		</span>
	</span>
}

// DotProps is a Dot.
type DotProps struct {
	State State
	Attrs templ.Attributes
}

// Dot is the state alone, next to the words that name it.
templ Dot(p DotProps) {
	<i class="moin-dot" data-state={ string(p.State) } { p.Attrs... }></i>
}
