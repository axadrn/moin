package pages

import (
	"github.com/axadrn/moin/hub/internal/ui/kit"
	"fmt"
	"strconv"

	"github.com/axadrn/moin/hub/internal/api"
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
)

// DeployLogPanel is the log of one deploy. It streams from the server as
// HTML (hx-sse): each message is lines to append, and the last one the
// state; then the stream ends. The newest lines stay in view while you are
// at the bottom (flex-col-reverse), and stay put when you scroll up. No
// script. Follow is true when it shows the newest deploy and moves on to
// the next one that starts; then AppDetail sends it again, out of band.
templ DeployLogPanel(app model.App, deploy *api.Deploy, follow, oob bool) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name }}
	<div id="deploy-log-panel" class="flex min-w-0 *:flex-1" data-following?={ follow } hx-swap-oob?={ oob }>
		@panel(panelProps{Heading: "deploy-log-heading", Title: "Log", Action: deployLogActions(app, deploy), Body: panelBodyFlush}) {
			<div class="flex max-h-[32rem] flex-1 flex-col-reverse overflow-auto overscroll-contain outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset lg:min-h-72" tabindex="0" aria-label="Deploy log">
				if deploy == nil {
					<p class="px-6 font-sans text-sm text-muted-foreground">No deploy yet.</p>
				} else {
					<div
						id="deploy-log"
						class="moin-term moin-term-lines"
						hx-sse:connect={ appPath + "/deploys/" + strconv.Itoa(deploy.Number) + "/log" }
						hx-sse:close="done"
						hx-swap="beforeend"
					></div>
				}
			</div>
		}
	</div>
}

// deployLogActions are the version, its state, Copy, and Roll back when the
// deploy shown can run again: the one place to roll back, on the deploy
// you look at.
templ deployLogActions(app model.App, deploy *api.Deploy) {
	if deploy != nil {
		<span class="text-xs text-muted-foreground tabular-nums">{ fmt.Sprintf("v%d", deploy.Number) }</span>
		@deployLogState(deploy.Status, false)
		@copyButton("", "#deploy-log", "Copy the log")
		if canRollBack(app, *deploy) {
			@kit.Button(kit.Secondary, "", templ.Attributes{
				"hx-post":       ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name + "/rollback",
				"hx-vals":       fmt.Sprintf(`{"number": "%d"}`, deploy.Number),
				"hx-swap":       "none",
				"hx-disable":    "this",
				"hx-confirm":    fmt.Sprintf("Roll back to v%d? It runs that deploy again.", deploy.Number),
				"data-rollback": true,
			}) {
				Roll back
			}
		}
	}
}

// DeployLogStateOOB is the chip by the log once the deploy ended, for the
// last message of the stream.
func DeployLogStateOOB(status string) templ.Component { return deployLogState(status, true) }

// deployLogState is the chip by the log: following while it runs, then
// how it ended.
templ deployLogState(status string, oob bool) {
	{{ word, chip, dot := deployLogChip(status) }}
	<span id="deploy-log-state" hx-swap-oob?={ oob } class={ "inline-flex h-7 items-center gap-2 rounded-full pr-3 pl-2.5 text-[0.8125rem] font-semibold", chip }>
		<span class={ "inline-block size-2 rounded-full", dot }></span>
		{ word }
	</span>
}

func deployLogChip(status string) (string, string, string) {
	switch status {
	case model.DeployRunning:
		return "following", "bg-running/16 text-[color-mix(in_oklab,var(--running),var(--foreground)_28%)]", "moin-dot-run bg-running"
	case model.DeploySucceeded:
		return "succeeded", "bg-live/16 text-[color-mix(in_oklab,var(--live),var(--foreground)_18%)]", "bg-live"
	case model.DeployFailed:
		return "failed", "bg-failed/15 text-[color-mix(in_oklab,var(--failed),var(--foreground)_12%)]", "bg-failed"
	case "stopped":
		return "stopped following", "bg-muted text-muted-foreground", "bg-muted-foreground"
	}
	return status, "bg-muted text-muted-foreground", "bg-muted-foreground"
}

// DeployLogChunk is one message of the log stream: the lines that continue
// the open fold go into it, the rest is appended to the log.
templ DeployLogChunk(chunk LogChunk) {
	if chunk.Continue != nil {
		<div hx-swap-oob={ fmt.Sprintf("beforeend:#fold-%d", chunk.Continue.ID) }>
			for _, line := range chunk.Continue.Lines {
				@logRow(line)
			}
		</div>
		@foldCount(*chunk.Continue, true)
	}
	for _, item := range chunk.Items {
		if item.Line != nil {
			@logRow(*item.Line)
		} else {
			<details class="moin-term-fold">
				<summary class="moin-term-toggle">
					<span class="moin-term-arrow" aria-hidden="true">▸</span>
					@foldCount(*item.Fold, false)
				</summary>
				<div id={ fmt.Sprintf("fold-%d", item.Fold.ID) }>
					for _, line := range item.Fold.Lines {
						@logRow(line)
					}
				</div>
			</details>
		}
	}
}

templ foldCount(fold LogFold, oob bool) {
	<span id={ fmt.Sprintf("fold-%d-count", fold.ID) } hx-swap-oob?={ oob }>{ foldLabel(fold) }</span>
}

templ logRow(line LogLine) {
	<div class="moin-term-line" data-kind={ line.Kind } data-n={ strconv.Itoa(line.N) }>
		<span>
			{ line.Text }
			if line.Path != "" {
				<span class="moin-term-dim" title={ line.Path }>{ " (" + shortPath(line.Path) + ")" }</span>
			}
		</span>
	</div>
}
