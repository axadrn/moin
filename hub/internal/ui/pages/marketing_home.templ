package pages

import (
	"strconv"

	"github.com/axadrn/moin/hub/internal/brand"
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// Home is the landing page: the promise and a deploy, the first commands,
// the two one-way roads, the daily restore check, the watcher, the
// catalog, moin cloud, how it compares, open source, the questions people
// ask and the way in. Short: every part links to the docs for the rest.
// open is what the changelog says about how moin ships.
templ Home(open HomeOpen) {
	@layouts.Home(layouts.SEOProps{
		Title:       "Your ./deploy.sh. But your data comes back.",
		Description: brand.Description,
		Path:        ctxkeys.URLPath(ctx),
	}) {
		@templ.Raw(homeJSONLD(ctxkeys.RenderConfig(ctx).AppURL))
		<main>
			@HomeHero()
			<div class="moin-page">
				@HomeStart()
				@HomeRoads()
				@HomeChecked()
				@HomeWatcher()
				@HomeCatalog()
				@HomeCloud()
				@HomeCompare()
				@HomeOpenAndAgents(open)
				@HomeQuestions()
				@HomeEnd()
			</div>
		</main>
	}
}

// homePrimary is the one main button of the page.
templ homePrimary() {
	@components.Button(components.ButtonProps{Kind: components.Primary, Href: "/docs/getting-started"}) {
		Get started
	}
}

// ---------------------------------------------------------------- hero
// HomeHero is the whole first screen, up behind the floating navbar: the
// promise and the two buttons on top, a real deploy below.
templ HomeHero() {
	<section class="moin-hero">
		<div class="moin-page">
			<div class="moin-stack" data-gap="6" data-center>
				<h1 class="moin-display moin-stack" style="--gap:0">
					<span>Your ./deploy.sh.</span>
					<span class="moin-muted">But your data comes back.</span>
				</h1>
				<p class="moin-lead moin-center" style="--measure:38ch">One command puts your app on your server. Every backup is restored and checked, every day. No dashboard holds a key to your server.</p>
			</div>
			<div class="moin-row" data-gap="2" data-center data-wrap>
				@homePrimary()
				@components.Button(components.ButtonProps{Href: "/docs/how-it-works"}) {
					How it works
				}
			</div>
		</div>
		<div class="moin-page">
			@components.Code(components.CodeProps{ID: "home-deploy", Text: homeDeploy})
		</div>
	</section>
}

// homeDeploy is what the first deploy prints, as the CLI prints it.
const homeDeploy = `$ moin deploy prod
shop · 3f2a9c1 → prod
Set up moin on prod and deploy shop? [y/N] y
✓ moin. shop is live: https://shop.203-0-113-7.sslip.io
  Postgres found. No bucket yet: moin bucket set prod
Close public SSH, only Tailscale from now on? [Y/n]`

// ---------------------------------------------------------------- start
// homeMoment is the one big thing of a section: what you get, as you see it.
templ homeMoment(state, big, small string) {
	@components.Card(components.CardProps{Attrs: templ.Attributes{"data-center": true, "style": "--pad:2rem"}}) {
		<span class="moin-row moin-strong" data-gap="3">
			@components.Dot(components.DotProps{State: components.StateLive})
			{ state }
		</span>
		<p class="moin-statement">{ big }</p>
		<p class="moin-small moin-muted">{ small }</p>
	}
}

// HomeStart is how to begin: three commands, from a fresh server to live.
templ HomeStart() {
	<section id="how" class="moin-band">
		<h2 class="moin-statement">Three commands. Live.</h2>
		<p class="moin-lead">If <code class="moin-mono">ssh prod</code> works, <code class="moin-mono">moin deploy prod</code> works.</p>
		<div class="moin-grid">
			@components.Card(components.CardProps{}) {
				@components.List() {
					for index, step := range homeSteps(ctxkeys.RenderConfig(ctx).AppURL) {
						@homeStep(strconv.Itoa(index+1), step[0], step[1])
					}
				}
			}
			@homeMoment("shop", "It's live.", "shop.203-0-113-7.sslip.io, with HTTPS.")
		</div>
		<p class="moin-lead">
			Node. Bun. Python. Ruby. PHP. Go. Any Dockerfile. Any compose.yml. No Docker on your laptop.
			<a href="/docs/getting-started" class="moin-link moin-foreground">Get started</a>
		</p>
	</section>
}

// homeSteps are the three steps of Get started: what you do, and how.
func homeSteps(site string) [][2]string {
	return [][2]string{
		{"Install moin", "curl -fsSL " + site + "/cli.sh | sh"},
		{"Go to your app", "cd shop"},
		{"Deploy", "moin deploy prod"},
	}
}

// homeStep is one step: its number, what you do, and how.
templ homeStep(number, name, how string) {
	@components.Item(components.ItemProps{}) {
		<span class="moin-text moin-muted moin-digits">{ number }</span>
		<div class="moin-row moin-fill" data-gap="1" data-phone="stack">
			<span class="moin-fill moin-strong">{ name }</span>
			<code class="moin-truncate moin-mono moin-text moin-muted">{ how }</code>
		</div>
	}
}

// ---------------------------------------------------------------- roads
// HomeRoads is the shape of moin: commands go in over SSH, reports go
// out to a watcher, and nothing comes back the other way.
templ HomeRoads() {
	<section id="roads" class="moin-band">
		<h2 class="moin-statement">Two one-way roads.</h2>
		<p class="moin-lead">Commands go in. Reports go out. Nothing comes back the other way.</p>
		<div class="moin-grid" data-cols="2">
			@homeRoad("Commands go in.", "From your laptop to your server. Over SSH, with your key. No service in between.")
			@homeRoad("Reports go out.", "From your server to a watcher. The server acts on nothing a watcher says.")
		</div>
		@components.Card(components.CardProps{Ink: true, Attrs: templ.Attributes{"data-gap": "6", "style": "--pad:2rem"}}) {
			<p class="moin-statement">Only who has SSH can command your server.</p>
			<div class="moin-grid" data-cols="3">
				@homeInk("Public SSH closes.", "After the first deploy. Then only over Tailscale.", "/docs/security#ssh-only-over-tailscale")
				@homeInk("No updates by themselves.", "The server updates when you run moin update prod.", "/docs/security#updates")
				@homeInk("A hacked watcher", "sees names and times. It can't touch a server.", "/docs/security#if-a-watcher-is-hacked")
			</div>
		}
		<p class="moin-lead">
			<a href="/docs/how-it-works" class="moin-link moin-foreground">How it works</a>
		</p>
	</section>
}

// homeRoad is one of the two roads: where it goes, and how.
templ homeRoad(statement, line string) {
	@components.Card(components.CardProps{Attrs: templ.Attributes{"data-gap": "3", "style": "--pad:2rem"}}) {
		<p class="moin-statement">{ statement }</p>
		<p class="moin-text moin-muted">{ line }</p>
	}
}

// homeInk is one fact on the card that stands out.
templ homeInk(name, note, href string) {
	<a href={ templ.SafeURL(href) } class="moin-stack" data-gap="1">
		<span class="moin-strong">{ name }</span>
		<span class="moin-small moin-muted">{ note }</span>
	</a>
}

// ---------------------------------------------------------------- checked
// HomeChecked is why the backups can be trusted: each day the newest copy
// comes back for real.
templ HomeChecked() {
	<section id="backups" class="moin-band">
		<h2 class="moin-statement">Backups that come back.</h2>
		<div class="moin-bento">
			@components.Card(components.CardProps{Href: "/docs/backups", Attrs: templ.Attributes{"data-wide": true, "data-tall": true, "data-center": true, "style": "--pad:2rem"}}) {
				<span class="moin-row moin-strong" data-gap="3">
					@components.Dot(components.DotProps{State: components.StateLive})
					shop
				</span>
				<p class="moin-statement">Checked today.</p>
				<p class="moin-small moin-muted">Every day the newest copy is restored into a throwaway database and read. Then it tells you which copy it proved.</p>
			}
			@homeFeature("Found by themselves", "SQLite and Postgres. Nothing to set up.", "/docs/backups#what-moin-backs-up")
			@homeFeature("Your own bucket", "Any S3-compatible bucket. Never through us.", "/docs/backups#the-bucket")
			@homeFeature("Restore", "One command. Your app runs while it builds.", "/docs/backups#restore")
			@homeFeature("Undo a restore", "The data from before stays. One step back.", "/docs/backups#undo-a-restore")
		</div>
	</section>
}

templ homeFeature(name, note, href string) {
	@components.Card(components.CardProps{Href: href, Attrs: templ.Attributes{"data-gap": "1"}}) {
		<span class="moin-strong">{ name }</span>
		<span class="moin-small moin-muted">{ note }</span>
	}
}

// ---------------------------------------------------------------- watcher
// HomeWatcher is the one part that listens: it notices what the server
// can't say itself.
templ HomeWatcher() {
	<section id="watcher" class="moin-band">
		<h2 class="moin-statement">Someone notices.</h2>
		<p class="moin-lead">A dead server can't tell you it's dead. A watcher can.</p>
		<div class="moin-bento">
			@homeFeature("Knows your apps", "Servers, apps, domains, backups. Nothing to set up.", "/docs/watcher")
			@homeFeature("Alerts once", "Telegram. Slack. Discord. A webhook.", "/docs/watcher#alerts")
			@homeFeature("On another server", "A small second one. Or two that watch each other.", "/docs/watcher#where-it-runs")
			@homeFeature("Open source", "Run it yourself. Or let "+brand.Name+" cloud run it.", "/docs/watcher#run-one")
		</div>
	</section>
}

// ---------------------------------------------------------------- catalog
// HomeCatalog is the other way to deploy: an open source app from the
// catalog, with backups like any other.
templ HomeCatalog() {
	<section id="catalog" class="moin-band">
		<h2 class="moin-statement">Or pick an app.</h2>
		<p class="moin-lead">Umami. n8n. Open WebUI. Vaultwarden. Nextcloud. From the catalog, with backups and the daily check like any app.</p>
		@components.Command(components.CommandProps{Text: "moin deploy prod --catalog umami"})
		<p class="moin-lead">
			<a href="/catalog" class="moin-link moin-foreground">The catalog</a>
		</p>
	</section>
}

// ---------------------------------------------------------------- cloud
// HomeCloud is moin cloud: a watcher we run and a copy the server can't
// delete. It is coming; there is no price until it is sold.
templ HomeCloud() {
	<section id="cloud" class="moin-band">
		@components.Card(components.CardProps{Href: "/docs/cloud", Attrs: templ.Attributes{"data-gap": "3", "style": "--pad:2rem"}}) {
			<p class="moin-statement">{ brand.Name } cloud. <span class="moin-muted">Coming.</span></p>
			<p class="moin-text moin-muted">A watcher we run for you. And a copy of your backups that your server can add to, never delete. Your apps stay on your server.</p>
		}
	</section>
}

// ---------------------------------------------------------------- questions
// HomeQuestions are the questions people ask first; the rest is in the
// FAQ.
templ HomeQuestions() {
	<section id="questions" class="moin-band">
		<h2 class="moin-statement">Good questions.</h2>
		@components.Card(components.CardProps{}) {
			@components.List() {
				@homeQuestion("Is "+brand.Name+" open source?", "Yes. All of it. And free.")
				@homeQuestion("Is there a dashboard?", "No. The CLI is the interface. A terminal UI is coming.")
				@homeQuestion("Do I need Docker?", "Not on your laptop. "+brand.Name+" installs it on the server.")
				@homeQuestion("Which servers?", "Any Linux server you can reach with SSH as root. Any provider.")
				@homeQuestion("Can my team deploy?", "Everyone with a key on the server. moin keys add prod anna.pub.")
				@homeQuestion("What if "+brand.Name+" cloud is down?", "Nothing changes on your server. Apps and backups keep running.")
			}
		}
		<p class="moin-lead">
			<a href="/docs/faq" class="moin-link moin-foreground">All questions</a>
		</p>
	</section>
}

templ homeQuestion(question, answer string) {
	@components.Expand(components.ExpandProps{Name: question}) {
		@components.Item(components.ItemProps{}) {
			<span class="moin-fill moin-text moin-muted">{ answer }</span>
		}
	}
}

// ---------------------------------------------------------------- end
// HomeEnd is the end of the page in one card: the name, where it comes
// from, the promise and the way in. "Nothing goes missing" leads into
// "your data comes back".
templ HomeEnd() {
	<section id="start" class="moin-band">
		@components.Card(components.CardProps{Attrs: templ.Attributes{"data-gap": "8", "style": "--pad:clamp(2rem,6vw,3.5rem)"}}) {
			<div class="moin-huge">
				@components.Wordmark(components.WordmarkProps{Size: "1em"})
			</div>
			<p class="moin-lead" data-large>
				<span class="moin-mono">/mɔɪn/</span> · Hamburg for hello. Any hour, one word.
			</p>
			<p class="moin-lead" data-large>
				I'm Axel. Born and raised in Hamburg, next to one of Europe's busiest ports. Millions of containers. Packed once. Shipped anywhere. Nothing goes missing. Your apps are containers too. So I built { brand.Name }, and named it after home.
			</p>
			<p class="moin-statement">
				Your ./deploy.sh. <span class="moin-muted">But your data comes back.</span>
			</p>
			<div class="moin-row" data-gap="2" data-wrap>
				@homePrimary()
				@components.Button(components.ButtonProps{Href: "/docs"}) {
					Read the docs
				}
			</div>
			<p class="moin-small moin-muted">Free and open source.</p>
			@homeGulls()
			<div class="moin-bleed hub-harbor-in-card">
				@homeHarbor()
			</div>
		}
	</section>
}
