package pages

import (
	"context"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"strconv"
	"strings"

	"github.com/axadrn/moin/hub/internal/brand"
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// Home is the landing page: the promise over the container wall, how to
// start, what it does, backups, security, how it compares,
// open source, the prices, the questions people ask and the way in. Short: every row
// links to the docs for the rest. open is what the changelog says about how
// moin ships.
templ Home(network model.Network, open HomeOpen) {
	@layouts.Home(layouts.SEOProps{
		Title:       "Deploy anything. Lose nothing.",
		Description: brand.Description,
		Path:        ctxkeys.URLPath(ctx),
	}) {
		<main>
			@HomeHero()
			<div class="moin-page">
				if ctxkeys.RenderConfig(ctx).Billing && network.Deploys >= liveShowsAt {
					@HomeLive(network)
				}
				@HomeStart()
				@HomeDoes()
				@HomeCompare()
				@HomeOpenAndNext(open)
				if ctxkeys.RenderConfig(ctx).Billing {
					@HomePricing()
				}
				@HomeQuestions()
				@HomeEnd()
			</div>
		</main>
	}
}

// homePrimary is the one main button of the page: Deploy now, or Sign in
// while sign-up is closed. That it starts free is told on the sign-up page
// and the pricing.
templ homePrimary() {
	@components.Button(components.ButtonProps{Kind: components.Primary, Href: "/auth"}) {
		{ homeStartLabel(ctx) }
	}
}

func homeStartLabel(ctx context.Context) string {
	cfg := ctxkeys.RenderConfig(ctx)
	if cfg.Billing && !cfg.SignupsOpen {
		return "Sign in"
	}
	return "Deploy now"
}

// ---------------------------------------------------------------- hero
// HomeHero is the whole first screen, up behind the floating navbar, whose
// height its top padding adds back: the promise and the two buttons on
// top, and the wall of containers across the full width below, every
// container an app.
templ HomeHero() {
	<section class="moin-hero">
		<div class="moin-page">
			<div class="moin-stack" data-gap="6" data-center>
				<a href="/next" class="moin-badge">{ brand.Name } next: what grows next to deploys</a>
				<h1 class="moin-display moin-stack" style="--gap:0">
					<span>Deploy <br class="moin-only-phone"/>anything.</span>
					<span class="moin-muted">Lose nothing.</span>
				</h1>
				<p class="moin-lead moin-center moin-hidden-phone" style="--measure:34ch">Your apps on your servers. Backups on your schedule. Checked every day.</p>
			</div>
			<div class="moin-row" data-gap="2" data-center data-wrap>
				@homePrimary()
				@components.Button(components.ButtonProps{Href: "/docs"}) {
					Read the docs
				}
			</div>
		</div>
		<div>
			@homeHarbor()
		</div>
	</section>
}

// HomeNext says what grows next to deploys, and where to read more.
templ HomeNext() {
	@components.Card(components.CardProps{Attrs: templ.Attributes{"id": "next", "data-gap": "6", "style": "--pad:2rem"}}) {
		<h2 class="moin-statement">What grows next.</h2>
		<p class="moin-text moin-muted">Deploying stays the core. Everything else moves in. Tasks. Docs. Chat. Mail.</p>
		@components.List(templ.Attributes{"style": "--card:transparent"}) {
			@components.Item(components.ItemProps{Href: "/next", Name: brand.Name + " next", Note: "Highly experimental"})
			@components.Item(components.ItemProps{Href: "/docs/roadmap", Name: "The roadmap", Note: "Deploys first"})
		}
	}
}

// ---------------------------------------------------------------- live
// liveShowsAt is how many deploys it takes before the home page shows the
// live numbers: small ones say "nobody uses this". They are counted all the
// same.
const liveShowsAt = 1000

// HomeLive is what moin runs right now: the hosted hub counts
// itself, self-hosted ones report every five minutes. We say what is true.
templ HomeLive(network model.Network) {
	<section id="live" class="moin-band" data-live>
		<h2 class="moin-row moin-text moin-strong moin-muted" data-gap="2">
			@components.Dot(components.DotProps{State: components.StateLive})
			Running on { brand.Name } right now
		</h2>
		<dl class="moin-grid" data-fit style="--min:9rem">
			@homeLiveNumber(network.SelfHosted, "self-hosted hubs", "self-hosted")
			@homeLiveNumber(network.HostedWorkspaces, "teams on hosted moin", "hosted")
			@homeLiveNumber(network.Servers, "servers", "servers")
			@homeLiveNumber(network.Apps, "apps live", "apps")
			@homeLiveNumber(network.Deploys, "deploys so far", "deploys")
		</dl>
	</section>
}

templ homeLiveNumber(count int, label, name string) {
	<div class="moin-card" data-gap="1" data-live-number={ name }>
		<dt class="moin-sr-only">{ label }</dt>
		<dd class="moin-title moin-digits">{ liveCount(count) }</dd>
		<dd class="moin-small moin-muted">{ label }</dd>
	</div>
}

// ---------------------------------------------------------------- start
// homeMoment is the one big thing of a section: what you get, as you see it.
templ homeMoment(state, big, small string) {
	@components.Card(components.CardProps{Attrs: templ.Attributes{"data-center": true, "style": "--pad:2rem"}}) {
		<span class="moin-row moin-strong" data-gap="3">
			@components.Dot(components.DotProps{State: components.StateLive})
			{ state }
		</span>
		<p class="moin-statement">{ big }</p>
		<p class="moin-small moin-muted">{ small }</p>
	}
}

// homeSurface is one way to do the four steps of Get started.
type homeSurface struct {
	Value string
	Label string
	Steps [4]string
}

// homeSurfaces are the ways to do the four steps; none is the standard
// one. Web comes first because it needs nothing installed.
var homeSurfaces = []homeSurface{
	{"web", "Web", [4]string{"GitHub or email", "Servers, Add server", "Settings, Bucket", "Deploys, GitHub, Deploy"}},
	{"cli", "CLI", [4]string{"moin login", "moin servers add web-1", "moin buckets add default", "moin deploy"}},
	{"tui", "TUI", [4]string{"moin", "w, then a", "w, then k", "D"}},
	{"api", "API", [4]string{"An API token", "POST /api/v1/servers", "POST /api/v1/buckets", "POST /api/v1/apps/{app}/deploys"}},
	{"mcp", "MCP", [4]string{"Connect your AI agent", "add_server", "add_bucket", "deploy_ref"}},
}

// homeStepNames are the four steps, the same on every surface.
var homeStepNames = [4]string{"Log in", "Add a server", "Add your bucket", "Deploy"}

// homeSurfaceOptions are the choices of the four steps.
func homeSurfaceOptions() []components.Option {
	options := make([]components.Option, 0, len(homeSurfaces))
	for _, surface := range homeSurfaces {
		options = append(options, components.Option{Value: surface.Value, Label: surface.Label})
	}
	return options
}

// HomeStart is how to begin: the four steps of Get started, on the surface
// the reader picks. The checked radio shows its part by CSS alone.
templ HomeStart() {
	<section id="how" class="moin-band">
		<h2 class="moin-statement">Four steps. Live.</h2>
		<p class="moin-lead">On the web. In the terminal. With your AI agent. You pick.</p>
		<div class="moin-grid">
			<div class="moin-stack" data-surfaces>
				@components.Choice(components.ChoiceProps{Name: "home-surface", Label: "Where", Options: homeSurfaceOptions(), Checked: "web"})
				for _, surface := range homeSurfaces {
					<div data-surface={ surface.Value }>
						@components.List() {
							for index, step := range surface.Steps {
								@homeStep(strconv.Itoa(index+1), homeStepNames[index], step)
							}
						}
					</div>
				}
			</div>
			@homeMoment("my-app", "It's live.", "my-app.203-0-113-7.sslip.io, with HTTPS.")
		</div>
		<p class="moin-lead">
			Node. Bun. Python. Ruby. PHP. Go. Any Dockerfile. Any compose.yml.
			<a href="/docs/getting-started" class="moin-link moin-foreground">Get started</a>
		</p>
	</section>
}

// homeStep is one step: its number, what you do, and how.
templ homeStep(number, name, how string) {
	@components.Item(components.ItemProps{}) {
		<span class="moin-text moin-muted moin-digits">{ number }</span>
		<div class="moin-row moin-fill" data-gap="1" data-phone="stack">
			<span class="moin-fill moin-strong">{ name }</span>
			<code class="moin-truncate moin-mono moin-text moin-muted">{ how }</code>
		</div>
	}
}

// ---------------------------------------------------------------- backups
// HomeBackups is why the backups can be trusted.

// ---------------------------------------------------------------- security
// HomeSecurity is how moin reaches a server, and what the server can refuse.

// homeTile is a small tile of a section: a few words and where to read on.
templ homeTile(statement, line, href string) {
	<div style="--row:7rem">
		@components.List() {
			@components.Item(components.ItemProps{Href: href}) {
				<span class="moin-stack moin-fill" data-gap="1">
					<span class="moin-strong">{ statement }</span>
					<span class="moin-small moin-muted">{ line }</span>
				</span>
			}
		}
	</div>
}

// ---------------------------------------------------------------- does
// HomeDoes is everything moin does, as grouped rows like Settings: the
// name, a few words, and the guide.
templ HomeDoes() {
	<section id="product" class="moin-band">
		<h2 class="moin-statement">Everything. Built in.</h2>
		<div class="moin-bento">
			@components.Card(components.CardProps{Href: "/docs/guides/backups", Attrs: templ.Attributes{"data-wide": true, "data-tall": true, "data-center": true, "style": "--pad:2rem"}}) {
				<span class="moin-row moin-strong" data-gap="3">
					@components.Dot(components.DotProps{State: components.StateLive})
					my-app
				</span>
				<p class="moin-statement">Checked today.</p>
				<p class="moin-small moin-muted">A real restore. By itself. Every day. SQLite and Postgres. On your schedule.</p>
			}
			@components.Card(components.CardProps{Ink: true, Attrs: templ.Attributes{"data-wide": true, "data-gap": "6", "style": "--pad:2rem"}}) {
				<p class="moin-statement">Your server. Your keys.</p>
				<div class="moin-grid" data-cols="3">
					@homeInk("Only dials out.", "No port open for "+brand.Name+".", "/docs/why-moin#the-daemon-only-dials-out")
					@homeInk("No SSH key.", brand.Name+" never has one.", "/docs/guides/security")
					@homeInk("Your rules.", "You say what "+brand.Name+" may do.", "/docs/guides/security#rules")
				</div>
			}
			@homeFeature("Deploy", "Any repo. A compose.yml. An image.", "/docs/guides/deploy")
			@homeFeature("Domains", "HTTPS from the first deploy.", "/docs/guides/domains")
			@homeFeature("GitHub", "Every push. Or one commit.", "/docs/guides/github")
			@homeFeature("Catalog", "n8n. Umami. Open WebUI. And more.", "/catalog")
			@homeFeature("Data", "Browse. Edit. Run SQL.", "/docs/guides/data")
			@homeFeature("Uptime and alerts", "Mail. Slack. Discord. Telegram.", "/docs/guides/alerts")
			@homeFeature("AI agents", "Claude. Cursor. Any MCP client.", "/docs/guides/mcp")
			@homeFeature("Your own bucket", "Never through "+brand.Name+".", "/docs/guides/bucket")
			@homeFeature("Download anytime", "One file.", "/docs/guides/backups#download-a-copy")
			@homeFeature("Undo a restore", "One step back.", "/docs/guides/backups#undo-a-restore")
		</div>
	</section>
}

templ homeFeature(name, note, href string) {
	@components.Card(components.CardProps{Href: href, Attrs: templ.Attributes{"data-gap": "1"}}) {
		<span class="moin-strong">{ name }</span>
		<span class="moin-small moin-muted">{ note }</span>
	}
}

// homeInk is one fact on the card that stands out.
templ homeInk(name, note, href string) {
	<a href={ templ.SafeURL(href) } class="moin-stack" data-gap="1">
		<span class="moin-strong">{ name }</span>
		<span class="moin-small moin-muted">{ note }</span>
	</a>
}

// ---------------------------------------------------------------- pricing
// HomePricing puts the free self-hosted moin next to the hosted one: the
// same product, so the rows say what running it takes.
templ HomePricing() {
	<section id="pricing" class="moin-band">
		<h2 class="moin-statement">One price. Every feature.</h2>
		<div class="moin-grid" data-cols="2">
			@components.Card(components.CardProps{Attrs: templ.Attributes{"data-gap": "6", "style": "--pad:2rem", "data-plan": "hosted"}}) {
				<div class="moin-stack" data-gap="1">
					<span class="moin-strong">Hosted</span>
					<span class="moin-row" data-gap="2" data-baseline><span class="moin-title moin-digits">$29</span><span class="moin-small moin-muted">a month per workspace</span></span>
					<span class="moin-small moin-muted" data-yearly-deal>Or $249 a year. 30 days free. No card.</span>
				</div>
				@components.Button(components.ButtonProps{Kind: components.Primary, Href: "/auth"}) {
					{ homeStartLabel(ctx) }
				}
				@homePlanRows("Ready in minutes", "We run and update it", "GitHub and email set up", "Support by email")
			}
			@components.Card(components.CardProps{Attrs: templ.Attributes{"data-gap": "6", "style": "--pad:2rem", "data-plan": "self-hosted"}}) {
				<div class="moin-stack" data-gap="1">
					<span class="moin-strong">Self-hosted</span>
					<span class="moin-row" data-gap="2" data-baseline><span class="moin-title moin-digits">$0</span><span class="moin-small moin-muted">forever</span></span>
					<span class="moin-small moin-muted">Your own moin hub. On your server. Open source.</span>
				</div>
				@components.Button(components.ButtonProps{Href: "/docs/self-hosting"}) {
					Host it yourself
				}
				@homePlanRows("One command on one server", "Update in one click", "Your GitHub App. Email optional", "Help on GitHub")
			}
		</div>
		<p class="moin-lead" data-one-price>Unlimited servers. Unlimited apps. Unlimited team. Nothing to unlock.</p>
	</section>
}

templ homePlanRows(rows ...string) {
	<ul class="moin-stack moin-text" data-gap="3">
		for _, row := range rows {
			<li class="moin-row" data-gap="3">
				<svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16" class="moin-muted"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				{ row }
			</li>
		}
	</ul>
}

// ---------------------------------------------------------------- questions
// HomeQuestions are the five questions people ask first; the rest is in the
// FAQ.
templ HomeQuestions() {
	<section id="questions" class="moin-band">
		<h2 class="moin-statement">Good questions.</h2>
		@components.List() {
			@homeQuestion("Is "+brand.Name+" open source?", "Yes. And free to host yourself.")
			@homeQuestion("What if "+brand.Name+" is down?", "Your apps keep running. They are on your servers.")
			@homeQuestion("Can you see my data?", "Only what you open. It is never stored.")
			@homeQuestion("Do I need Docker?", "No. "+brand.Name+" installs it.")
			@homeQuestion("Which servers?", "Any Linux server with root access. Any provider.")
		}
		<p class="moin-lead">
			<a href="/docs/faq" class="moin-link moin-foreground">All questions</a>
		</p>
	</section>
}

templ homeQuestion(question, answer string) {
	@components.Expand(components.ExpandProps{Name: question}) {
		@components.Item(components.ItemProps{}) {
			<span class="moin-fill moin-text moin-muted">{ answer }</span>
		}
	}
}

// ---------------------------------------------------------------- end
// HomeEnd is the end of the page: the wordmark, the promise again and the
// way in.
// HomeEnd is the end of the page in one card: the name, where it comes
// from, the promise and the way in. "Nothing goes missing" leads into
// "Lose nothing".
templ HomeEnd() {
	<section id="start" class="moin-band">
		@components.Card(components.CardProps{Attrs: templ.Attributes{"data-gap": "8", "style": "--pad:clamp(2rem,6vw,3.5rem)"}}) {
			<div class="moin-huge">
				@components.Wordmark(components.WordmarkProps{Size: "1em"})
			</div>
			<p class="moin-lead" data-large>
				<span class="moin-mono">/mɔɪn/</span> · Hamburg for hello. Any hour, one word.
			</p>
			<p class="moin-lead" data-large>
				I'm Axel. Born and raised in Hamburg, next to one of Europe's busiest ports. Millions of containers. Packed once. Shipped anywhere. Nothing goes missing. Your apps are containers too. So I built { brand.Name }, and named it after home.
			</p>
			<p class="moin-statement">
				Deploy anything. <span class="moin-muted">Lose nothing.</span>
			</p>
			<div class="moin-row" data-gap="2" data-wrap>
				@homePrimary()
				@components.Button(components.ButtonProps{Href: "/docs/why-moin"}) {
					Why { brand.Name }
				}
			</div>
			<p class="moin-small moin-muted">
				if ctxkeys.RenderConfig(ctx).Billing {
					30 days free. No card. Or <a href="/docs/self-hosting" class="moin-link moin-foreground">host it yourself</a>, free forever.
				} else {
					Free and open source.
				}
			</p>
		}
	</section>
}

// homeInShort is the In short of a changelog entry without its backticks.
func homeInShort(text string) string {
	return strings.ReplaceAll(text, "`", "")
}
