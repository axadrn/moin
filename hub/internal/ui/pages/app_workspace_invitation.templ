package pages

import (
	"strings"

	"github.com/axadrn/moin/hub/internal/brand"
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// WorkspaceInvitation asks whether to join the workspace someone invited
// you to: who, as what, and one button.
templ WorkspaceInvitation(invitation *model.WorkspaceInvitation, errorMessage string) {
	{{ user := ctxkeys.User(ctx) }}
	{{ seo := layouts.SEOProps{Title: "Workspace invitation", Description: "Accept a workspace invitation"} }}
	if invitation == nil {
		@authScreen(seo, "Invitation not available") {
			@authLine() {
				{ invitationProblem(errorMessage) }
			}
			<div class="moin-stack">
				@authLink("/") {
					{ "Back to " + brand.Name }
				}
			</div>
		}
	} else {
		@authScreen(seo, "Join "+invitation.WorkspaceName) {
			@authStack() {
				@components.Card(components.CardProps{}) {
					@components.List() {
						@factRow("From", invitation.InviterName)
						@factRow("Role", model.WorkspaceRoleLabel(invitation.Role))
						@factRow("For", invitation.Email)
						if user != nil && !strings.EqualFold(user.Email, invitation.Email) {
							@factRow("You", user.Email)
						}
					}
				}
				if user != nil {
					<form action={ templ.SafeURL(ctxkeys.URLPath(ctx)) } method="POST" class="moin-stack">
						@components.CSRF()
						@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit"}) {
							{ "Join " + invitation.WorkspaceName }
						}
					</form>
				}
				if errorMessage != "" {
					<p class="moin-message moin-center" data-state="failed" role="alert">{ errorMessage }</p>
				}
				@authLink("/") {
					{ "Back to " + brand.Name }
				}
			}
		}
	}
}

// invitationProblem is why there is nothing to join.
func invitationProblem(message string) string {
	if message == "" {
		return "It expired, was revoked or was used already. Ask for a new one."
	}
	return message
}
