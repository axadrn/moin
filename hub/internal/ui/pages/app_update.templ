package pages

import (
	"github.com/axadrn/moin/hub/internal/ui/components"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/internal/build"
)

// UpdateNotice tells the admins of a self-hosted hub that a new
// release is out, with its "In short" line, its notes and the command
// that updates it on the server. Everyone else, and everyone on the
// hosted hub, gets an empty element.
templ UpdateNotice(info model.VersionInfo) {
	<div
		id="update-notice"
		class={ components.Page, "moin-hide-empty" }
		style="--page-top:var(--space-4)"
		data-update-notice
	>
		if info.Admin && info.UpdateAvailable {
			@updateLine(templ.Attributes{"data-update-available": info.Latest}) {
				<div class="moin-stack" data-gap="1">
					<p class="moin-strong">{ build.Name + " " + info.Latest + " is out." }</p>
					if info.Summary != "" {
						<p class="moin-small moin-muted">
							{ info.Summary }
						</p>
					}
					<p class="moin-small moin-muted">Read what is new, then on the server:</p>
				</div>
				<div class="moin-row" data-wrap data-gap="2">
					@components.Command(components.CommandProps{Text: model.UpdateCommand})
					@components.Button(components.ButtonProps{Attrs: components.OpenDialog("update-dialog")}) {
						What is new
					}
				</div>
			}
			@updateDialog(info)
		}
	</div>
}

// updateDialog shows the whole release notes: some updates need a step
// from the admin first, and the notes say which.
templ updateDialog(info model.VersionInfo) {
	@components.Dialog(components.DialogProps{ID: "update-dialog", Title: "What is new in " + info.Latest, Note: model.ReadFirst}) {
		if info.NotesHTML != "" {
			@components.Prose(components.ProseProps{HTML: info.NotesHTML})
		}
		<div class="moin-stack" data-gap="2">
			<p class="moin-text">Then on the server:</p>
			@components.Command(components.CommandProps{Text: model.UpdateCommand})
		</div>
		@components.DialogButtons() {
			if info.NotesURL != "" {
				@components.Button(components.ButtonProps{Href: info.NotesURL, Attrs: templ.Attributes{"target": "_blank", "rel": "noopener"}}) {
					Release notes
				}
			}
			@components.Button(components.ButtonProps{Kind: components.Primary, Attrs: components.CloseDialog()}) {
				Close
			}
		}
	}
}

// updateLine is the notice: one card over the page, its words left and
// what to do right, under them on a phone.
templ updateLine(attributes templ.Attributes) {
	@components.Card(components.CardProps{Attrs: attributes}) {
		<div class="moin-row" data-between data-gap="3" data-phone="stack">
			{ children... }
		</div>
	}
}

// DaemonUpdatesForm is the switch for automatic daemon updates, a row of a
// list that saves itself.
templ DaemonUpdatesForm(on bool) {
	@switchForm("daemon-updates-form", ctxkeys.AppBasePath(ctx)+"/servers/daemon-updates", "daemon-updates", "Update daemons automatically", "To "+build.Version+", one server at a time, never during a deploy", on)
}
