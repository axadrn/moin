package pages

import (
	"github.com/axadrn/moin/hub/internal/ui/components"
	"time"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/internal/build"
)

// UpdateNotice tells the admins of a self-hosted hub that a new
// release is out, with its "In short" line, and updates it with one click.
// While an update runs it asks again every five seconds. Everyone else, and
// everyone on the hosted hub, gets an empty element.
templ UpdateNotice(info model.VersionInfo) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ update := info.Update }}
	{{ running := update != nil && update.Running() }}
	<div
		id="update-notice"
		class={ components.Page, "pt-4 empty:hidden" }
		if running {
			hx-get={ basePath + "/update" }
			hx-trigger="every 5s"
			hx-swap="outerHTML"
		}
		data-update-notice
	>
		if info.Admin {
			switch  {
				case running:
					@updateLine(templ.Attributes{"data-update-state": update.State}) {
						@components.Status(components.StatusProps{State: components.StateRunning}) {
							{ "Updating " + build.Name + " to " + update.Version }
						}
						<p class="moin-small moin-muted">
							Back in a minute. Your apps keep running.
						</p>
					}
				case update != nil && (update.State == "rolled_back" || update.State == "failed"):
					@updateLine(templ.Attributes{"data-update-state": update.State}) {
						@components.Status(components.StatusProps{State: components.StateFailed}) {
							{ "The update to " + update.Version + " did not work" }
						}
						<p class="moin-small moin-muted">
							{ update.Reason }
							if update.State == "rolled_back" {
								{ " " + build.Name + " runs " + info.Version + " again." }
							}
							{ " " }
							<a class="text-foreground underline underline-offset-4" href={ templ.SafeURL("/docs/self-hosting#updates") }>What to do</a>
						</p>
					}
				case update != nil && update.State == "done" && update.Version == info.Version && time.Since(update.At) < 10*time.Minute:
					@updateLine(templ.Attributes{"data-update-state": "done"}) {
						@components.Status(components.StatusProps{State: components.StateLive}) {
							{ build.Name + " " + info.Version + " runs now" }
						}
						<div>
							@components.Button(components.ButtonProps{Href: info.NotesURL, Attrs: templ.Attributes{"target": "_blank", "rel": "noopener"}}) {
								Changelog
							}
						</div>
					}
				case info.UpdateAvailable:
					@updateLine(templ.Attributes{"data-update-available": info.Latest}) {
						<div class="flex flex-col gap-1">
							<p class="moin-strong">{ build.Name + " " + info.Latest + " is out" }</p>
							if info.Summary != "" {
								<p class="moin-small moin-muted">
									{ info.Summary }
								</p>
							}
						</div>
						<div class="flex flex-wrap items-center gap-2">
							if info.CanUpdate {
								<form hx-post={ basePath + "/update" } hx-swap="outerHTML" hx-target="#update-notice" hx-disable="find button">
									@components.CSRF()
									@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit"}) {
										Update now
									}
								</form>
							} else {
								<span class="moin-small moin-muted">On the server: <code class="font-mono text-foreground">sh update.sh</code></span>
							}
							if info.NotesURL != "" {
								@components.Button(components.ButtonProps{Href: info.NotesURL, Attrs: templ.Attributes{"target": "_blank", "rel": "noopener"}}) {
									Release notes
								}
							}
						</div>
					}
			}
		}
	</div>
}

// updateLine is the notice: one card over the page, its words left and
// what to do right, under them on a phone.
templ updateLine(attributes templ.Attributes) {
	<section class="flex flex-col gap-3 rounded-4xl bg-card p-5 sm:flex-row sm:items-center sm:justify-between sm:px-6" { attributes... }>
		{ children... }
	</section>
}

// DaemonUpdatesForm is the switch for automatic daemon updates, a row of a
// list that saves itself.
templ DaemonUpdatesForm(on bool) {
	@switchForm("daemon-updates-form", ctxkeys.AppBasePath(ctx)+"/servers/daemon-updates", "daemon-updates", "Update daemons automatically", "To "+build.Version+", one server at a time, never during a deploy", on)
}
