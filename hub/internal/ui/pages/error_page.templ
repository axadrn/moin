package pages

import (
	"strconv"

	"github.com/axadrn/moin/hub/internal/ui/components"
)

templ ErrorPage(status int, title, description string) {
	<!DOCTYPE html>
	<html lang="en" data-nonce={ templ.GetNonce(ctx) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="robots" content="noindex, nofollow"/>
			<title>{ title }</title>
			<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml"/>
			<script nonce={ templ.GetNonce(ctx) }>
				const theme = localStorage.getItem('moin-mode') || localStorage.getItem('theme') || 'system';
				const dark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
				document.documentElement.classList.toggle('dark', dark);
				document.documentElement.classList.toggle('light', theme === 'light');
			</script>
			<link href={ components.AssetURL("/assets/css/output.css") } rel="stylesheet"/>
			<link href={ components.AssetURL("/assets/ui/moin.css") } rel="stylesheet"/>
		</head>
		<body>
			@StatusScreen(title, description, strconv.Itoa(status)+" "+title)
		</body>
	</html>
}

// StatusScreen is the full page for 404s and errors: what happened, the
// way back, and the code as a log line.
templ StatusScreen(title, description, line string) {
	@authFrame(title) {
		@authLine() {
			{ description }
		}
		@authStack() {
			@components.Button(components.ButtonProps{Kind: components.Primary, Href: "/"}) {
				Back to home
			}
		}
		<p class="moin-small moin-mono moin-muted moin-center moin-break">{ line }</p>
	}
}
