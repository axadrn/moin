package pages

import (
	"fmt"

	"github.com/axadrn/moin/hub/internal/access"
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

templ Workspace(members []model.WorkspaceMember, invitations []model.WorkspaceInvitation) {
	@layouts.App("Team") {
		@WorkspaceContent(members, invitations)
	}
}

// WorkspaceContent is the team: inviting someone, the members with their
// roles, the invitations not accepted yet, the workspace's name, and
// leaving or deleting the workspace at the end. Every action answers it
// whole.
templ WorkspaceContent(members []model.WorkspaceMember, invitations []model.WorkspaceInvitation) {
	{{ workspace := ctxkeys.Workspace(ctx) }}
	{{ viewer := ctxkeys.WorkspaceMember(ctx) }}
	{{ subscription := ctxkeys.Subscription(ctx) }}
	{{ seatLimit := subscription.Access().Limit(access.LimitMembers) }}
	{{ basePath := workspace.Path() }}
	@panelPage(templ.Attributes{"id": "workspace-content", "hx-swap-oob": "true"}) {
		@components.Header(components.HeaderProps{Back: components.Back{Label: "Settings", Href: basePath + "/settings"}, Title: "Team"})
		if viewer.Can(model.WorkspacePermissionManageMembers) {
			@components.Card(components.CardProps{Title: "Invite a teammate"}) {
				<form
					action={ templ.SafeURL(basePath + "/workspace/invitations") }
					method="POST"
					class="moin-row"
					data-gap="2"
					data-phone="stack"
					hx-post={ basePath + "/workspace/invitations" }
					hx-swap="none"
					hx-disable="find button[type='submit']"
				>
					@components.CSRF()
					<label for="invite-email" class="moin-sr-only">Email</label>
					<div class="moin-fill">
						@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "invite-email", "name": "email", "type": "email", "placeholder": "teammate@example.com", "autocomplete": "off"}})
					</div>
					<div class="moin-row" data-gap="2">
						<div class="moin-width" data-fixed style="--width:9rem">
							@components.Select(components.SelectProps{ID: "invite-role", Name: "role", Label: "Role", Options: []components.Option{{Value: model.WorkspaceRoleMember, Label: "Member"}, {Value: model.WorkspaceRoleAdmin, Label: "Admin"}}, Value: model.WorkspaceRoleMember})
						</div>
						@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit", Attrs: templ.Attributes{"data-phone": "fill"}}) {
							Send invite
						}
					</div>
				</form>
			}
		}
		<section class="moin-section">
			<div class="moin-section-head">
				<h2>In the team</h2>
				@seatCount(seatText(len(members), seatLimit))
			</div>
			@components.Card(components.CardProps{}) {
				@components.List() {
					for _, member := range members {
						@components.Item(components.ItemProps{Name: member.Name, Note: member.Email, Lead: components.Avatar(components.AvatarProps{Name: member.Name, Initials: model.Initial(member.Name + member.Email)}), Attrs: templ.Attributes{"data-member": member.ID, "data-control": true}}) {
							if viewer.Can(model.WorkspacePermissionManageMembers) && (member.Role != model.WorkspaceRoleOwner || viewer.Can(model.WorkspacePermissionManageOwners)) {
								<div class="moin-row moin-width" style="--width:auto" data-gap="2">
									<form
										action={ templ.SafeURL(basePath + "/workspace/members/" + member.ID + "/role") }
										method="POST"
										class="moin-width"
										data-fixed
										style="--width:9rem"
										hx-post={ basePath + "/workspace/members/" + member.ID + "/role" }
										hx-trigger="change"
										hx-swap="none"
									>
										@components.CSRF()
										@components.Select(components.SelectProps{ID: "role-" + member.ID, Name: "role", Label: "Role of " + member.Name, Options: roleOptions(viewer.Can(model.WorkspacePermissionManageOwners)), Value: member.Role})
									</form>
									@components.Button(components.ButtonProps{Kind: components.Danger, Attrs: templ.Attributes{
										"hx-post":    basePath + "/workspace/members/" + member.ID + "/remove",
										"hx-swap":    "none",
										"hx-disable": "this",
										"hx-confirm": "Remove " + member.Name + " from " + workspace.Name + "?",
									}}) {
										Remove
									}
								</div>
							} else {
								<span class="moin-text moin-muted">{ model.WorkspaceRoleLabel(member.Role) }</span>
							}
						}
					}
				}
			}
		</section>
		if viewer.Can(model.WorkspacePermissionManageMembers) && len(invitations) > 0 {
			<section class="moin-section">
				<div class="moin-section-head">
					<h2>Invitations</h2>
				</div>
				@components.Card(components.CardProps{}) {
					@components.List() {
						for _, invitation := range invitations {
							@components.Item(components.ItemProps{Name: invitation.Email, Note: model.WorkspaceRoleLabel(invitation.Role) + " · expires " + invitation.ExpiresAt.Local().Format("Jan 2, 2006"), Attrs: templ.Attributes{"data-invitation": invitation.Email, "data-control": true}}) {
								<div class="moin-row moin-width" style="--width:auto" data-gap="2">
									@components.Button(components.ButtonProps{Attrs: templ.Attributes{
										"hx-post":    basePath + "/workspace/invitations/" + invitation.ID + "/resend",
										"hx-swap":    "none",
										"hx-disable": "this",
									}}) {
										Resend
									}
									@components.Button(components.ButtonProps{Kind: components.Danger, Attrs: templ.Attributes{
										"hx-post":    basePath + "/workspace/invitations/" + invitation.ID + "/revoke",
										"hx-swap":    "none",
										"hx-disable": "this",
										"hx-confirm": "Revoke the invitation of " + invitation.Email + "? The link in the email stops working.",
									}}) {
										Revoke
									}
								</div>
							}
						}
					}
				}
			</section>
		}
		if viewer.Can(model.WorkspacePermissionManageWorkspace) {
			@components.Card(components.CardProps{Title: "Workspace name"}) {
				<form
					action={ templ.SafeURL(basePath + "/workspace/name") }
					method="POST"
					hx-post={ basePath + "/workspace/name" }
					hx-swap="none"
					hx-disable="find button[type='submit']"
				>
					@components.CSRF()
					<label for="workspace-name" class="moin-sr-only">Workspace name</label>
					<div class="moin-row" data-gap="2" data-phone="stack">
						@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "workspace-name", "name": "name", "value": workspace.Name, "autocomplete": "off"}})
						@components.Button(components.ButtonProps{Type: "submit"}) {
							Save
						}
					</div>
				</form>
			}
		}
		@components.Card(components.CardProps{}) {
			@components.List() {
				@components.Item(components.ItemProps{Button: true, Danger: true, Name: "Leave workspace", Attrs: templ.Attributes{
					"hx-post":             basePath + "/workspace/leave",
					"hx-swap":             "none",
					"hx-disable":          "this",
					"hx-confirm":          "Leave " + workspace.Name + "? You lose access to it. A sole Owner hands ownership to someone else first.",
					"data-confirm-action": "Leave workspace",
				}})
				if viewer.Can(model.WorkspacePermissionDeleteWorkspace) {
					@components.Item(components.ItemProps{Button: true, Danger: true, Name: "Delete workspace", Attrs: templ.Attributes{
						"hx-post":             basePath + "/workspace/delete",
						"hx-swap":             "none",
						"hx-disable":          "this",
						"hx-confirm":          "Delete " + workspace.Name + " for good? Its team, invitations and activity go with it. A paid subscription must be cancelled and run out first.",
						"data-confirm-name":   workspace.Name,
						"data-confirm-action": "Delete permanently",
					}})
				}
			}
		}
	}
}

// seatCount is the count at the end of the members' title.
templ seatCount(text string) {
	<span class="moin-text moin-muted moin-digits">{ text }</span>
}

// roleOptions are the roles a viewer may give; only owners make owners.
func roleOptions(owners bool) []components.Option {
	options := []components.Option{{Value: model.WorkspaceRoleAdmin, Label: "Admin"}, {Value: model.WorkspaceRoleMember, Label: "Member"}}
	if owners {
		options = append([]components.Option{{Value: model.WorkspaceRoleOwner, Label: "Owner"}}, options...)
	}
	return options
}

// seatText counts the members, and the seats when the plan limits them.
func seatText(members, limit int) string {
	if limit == access.Unlimited {
		if members == 1 {
			return "1 person"
		}
		return fmt.Sprintf("%d people", members)
	}
	return fmt.Sprintf("%d of %d seats", members, limit)
}
