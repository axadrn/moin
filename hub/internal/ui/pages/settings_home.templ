package pages

import (
	"strings"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
	"github.com/axadrn/moin/internal/build"
)

// SettingsHomeView is what Settings shows beyond the request: GitHub.
type SettingsHomeView struct {
	// GitHub is whether this hub has the GitHub App, GitHubAccounts
	// the accounts this workspace connected.
	GitHub         bool
	GitHubAccounts []string
}

// SettingsHome is Settings of the workspace: what belongs to it first, then
// your workspaces (a tap switches), you, moin itself, and signing out at
// the end. Your picture in the bar opens it.
templ SettingsHome(view SettingsHomeView) {
	{{ user := ctxkeys.User(ctx) }}
	{{ workspace := ctxkeys.Workspace(ctx) }}
	{{ member := ctxkeys.WorkspaceMember(ctx) }}
	{{ base := ctxkeys.AppBasePath(ctx) }}
	{{ cfg := ctxkeys.RenderConfig(ctx) }}
	@layouts.App("Settings") {
		@panelPage() {
			@components.Header(components.HeaderProps{Title: "Settings"})
			<section class="moin-section">
				<div class="moin-section-head">
					<h2>{ workspace.Name }</h2>
				</div>
				@components.Card(components.CardProps{}) {
					@components.List() {
						@components.Item(components.ItemProps{Href: base + "/workspace", Name: "Team"})
						if view.GitHub {
							@components.Item(components.ItemProps{Href: base + "/settings/github", Name: "GitHub", Value: gitHubValue(view.GitHubAccounts)})
						}
						@components.Item(components.ItemProps{Href: base + "/alerts", Name: "Alerts"})
						@components.Item(components.ItemProps{Href: base + "/bucket", Name: "Bucket"})
						@components.Item(components.ItemProps{Href: base + "/activity", Name: "Activity"})
						if member != nil && member.Can(model.WorkspacePermissionManageBilling) && cfg.Billing {
							@components.Item(components.ItemProps{Href: base + "/billing", Name: "Billing"})
						}
					}
				}
			</section>
			<section class="moin-section">
				<div class="moin-section-head">
					<h2>Workspaces</h2>
				</div>
				@components.Card(components.CardProps{}) {
					@components.List() {
						for _, item := range ctxkeys.Workspaces(ctx) {
							if item.ID == workspace.ID {
								// The open one is no place to go: a check where
								// the others have their chevron.
								@components.Item(components.ItemProps{Name: item.Name, Note: model.WorkspaceRoleLabel(item.Role), Lead: workspaceLead(item)}) {
									<svg aria-label="Open now" viewBox="0 0 16 16" width="16" height="16"><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
								}
							} else {
								@components.Item(components.ItemProps{Href: item.Path() + "/settings", Name: item.Name, Note: model.WorkspaceRoleLabel(item.Role), Lead: workspaceLead(item)})
							}
						}
						@components.Item(components.ItemProps{Href: "/workspaces/new", Name: "New workspace"})
					}
				}
			</section>
			<section class="moin-section">
				<div class="moin-section-head">
					<h2>You</h2>
				</div>
				@components.Card(components.CardProps{}) {
					@components.List() {
						@components.Item(components.ItemProps{Href: base + "/settings/account", Name: user.Name, Note: user.Email, Lead: components.Avatar(components.AvatarProps{URL: user.AvatarURL, Name: user.Name, Initials: user.Initials()})})
					}
				}
			</section>
			<section class="moin-section">
				<div class="moin-section-head">
					<h2>moin</h2>
				</div>
				@components.Card(components.CardProps{}) {
					@components.List() {
						@components.Item(components.ItemProps{Name: "Appearance"}) {
							@components.Choice(components.ChoiceProps{Name: "appearance", Label: "Appearance", Options: []components.Option{
								{Value: "system", Label: "System", Attrs: templ.Attributes{"data-theme-set": "system"}},
								{Value: "light", Label: "Light", Attrs: templ.Attributes{"data-theme-set": "light"}},
								{Value: "dark", Label: "Dark", Attrs: templ.Attributes{"data-theme-set": "dark"}},
							}})
						}
						@components.Item(components.ItemProps{Href: "/docs", Name: "Docs"})
						@components.Item(components.ItemProps{Href: "/changelog", Name: "Changelog", Value: build.Version, Attrs: templ.Attributes{"data-changelog": build.Version}}) {
							@components.Dot(components.DotProps{State: components.StateLive, Attrs: templ.Attributes{"data-changelog-dot": true, "hidden": true, "aria-label": "New"}})
						}
						@components.Item(components.ItemProps{Name: "Support", Value: cfg.SupportEmail})
						@components.Item(components.ItemProps{Href: layouts.GitHubURL, External: true, Name: "Source code", Value: "GitHub"})
					}
				}
			</section>
			if ctxkeys.IsAdmin(ctx) {
				@components.Card(components.CardProps{}) {
					@components.List() {
						@components.Item(components.ItemProps{Href: "/admin", Name: "Admin"})
					}
				}
			}
			@components.Card(components.CardProps{}) {
				@components.List() {
					@components.Item(components.ItemProps{Button: true, Danger: true, Name: "Sign out", Attrs: templ.Attributes{"hx-post": "/auth/logout", "hx-swap": "none", "data-logout": "true"}})
				}
			}
		}
	}
}

// workspaceLead is the initial of a workspace in the list.
templ workspaceLead(item model.WorkspaceMembership) {
	@components.Avatar(components.AvatarProps{Name: item.Name, Initials: model.Initial(item.Name)})
}

// gitHubValue is what the GitHub row says: the accounts, or Connect.
func gitHubValue(accounts []string) string {
	if len(accounts) == 0 {
		return "Connect"
	}
	return strings.Join(accounts, ", ")
}

// SettingsGitHub is the GitHub connection of the workspace, once for every
// app: the accounts it reaches, each with the page on GitHub where its owner
// picks the repos moin may read (and can remove moin), and Connect.
templ SettingsGitHub(installations []model.GitHubInstallation) {
	{{ base := ctxkeys.AppBasePath(ctx) }}
	@layouts.App("GitHub · Settings") {
		@panelPage() {
			@components.Header(components.HeaderProps{Back: components.Back{Label: "Settings", Href: base + "/settings"}, Title: "GitHub"})
			@components.Card(components.CardProps{}) {
				@components.List() {
					for _, installation := range installations {
						if installation.SettingsURL != "" {
							@components.Item(components.ItemProps{Href: installation.SettingsURL, External: true, Name: installation.Account}) {
								<span class="moin-small moin-muted">Repos on GitHub</span>
							}
						} else {
							@components.Item(components.ItemProps{Name: installation.Account})
						}
					}
					@components.Item(components.ItemProps{Href: base + "/github/install?next=" + base + "/settings/github", Name: gitHubConnectLabel(installations)})
				}
			}
		}
	}
}

func gitHubConnectLabel(installations []model.GitHubInstallation) string {
	if len(installations) == 0 {
		return "Connect GitHub"
	}
	return "Connect another account"
}
