package pages

import (
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// IntegrationsView is what the workspace connected. GitHub is whether this
// hub has the GitHub App.
type IntegrationsView struct {
	GitHub         bool
	GitHubAccounts []model.GitHubInstallation
	Keys           service.Integrations
}

// Integrations are the accounts a workspace connects once, for every app
// and server: GitHub for repos, Cloudflare for tunnels, Tailscale for the
// tailnet. Each says whether it is connected. A connected one takes a new
// key, which replaces the old one; disconnecting sits at the end.
// Connecting, replacing or disconnecting answers the whole page.
templ Integrations(view IntegrationsView) {
	{{ base := ctxkeys.AppBasePath(ctx) }}
	@layouts.App("Integrations") {
		@panelPage() {
			@components.Header(components.HeaderProps{Back: components.Back{Label: "Settings", Href: base + "/settings"}, Title: "Integrations"})
			<div id="integrations" class="moin-stack" data-gap="6">
				if view.GitHub {
					@components.Card(components.CardProps{Title: "GitHub"}) {
						@components.List(templ.Attributes{"data-integration": "github"}) {
							for _, installation := range view.GitHubAccounts {
								if installation.SettingsURL != "" {
									@components.Item(components.ItemProps{Href: installation.SettingsURL, External: true, Lead: connectedDot(true), Name: installation.Account, Note: "Repos on GitHub"})
								} else {
									@components.Item(components.ItemProps{Lead: connectedDot(true), Name: installation.Account})
								}
							}
							@components.Item(components.ItemProps{Href: base + "/github/install?next=" + base + "/integrations", Name: ifElse(len(view.GitHubAccounts) == 0, "Connect GitHub", "Connect another account")})
						}
					}
				}
				@components.Card(components.CardProps{Title: "Cloudflare"}) {
					if view.Keys.Cloudflare {
						@components.List(templ.Attributes{"data-integration": "cloudflare"}) {
							@components.Item(components.ItemProps{Lead: connectedDot(true), Name: "Connected", Note: "Account " + view.Keys.CloudflareAccount})
						}
						@keyForm("cloudflare-token", "cloudflare_token", "New key", "Replaces the API token. Tunnels keep running.", "Save")
					} else {
						@keyForm("cloudflare-token", "cloudflare_token", "API token", "Account Cloudflare Tunnel Edit and Zone DNS Edit. Zone Settings Edit turns on Always Use HTTPS.", "Connect")
					}
				}
				@components.Card(components.CardProps{Title: "Tailscale"}) {
					if view.Keys.Tailscale {
						@components.List(templ.Attributes{"data-integration": "tailscale"}) {
							@components.Item(components.ItemProps{Lead: connectedDot(true), Name: "Connected", Note: "A server joins your tailnet for SSH only through Tailscale"})
						}
						@keyForm("tailscale-key", "tailscale_key", "New key", "Replaces the auth key. Servers stay in your tailnet.", "Save")
					} else {
						@keyForm("tailscale-key", "tailscale_key", "Auth key", "A reusable auth key, tskey-auth-…", "Connect")
					}
				}
				if view.Keys.Cloudflare || view.Keys.Tailscale {
					@components.Card(components.CardProps{}) {
						@components.List() {
							if view.Keys.Cloudflare {
								@disconnectButton("cloudflare", "Disconnect Cloudflare", "Disconnect Cloudflare? Turn the tunnels off first: without the token moin cannot delete them.")
							}
							if view.Keys.Tailscale {
								@disconnectButton("tailscale", "Disconnect Tailscale", "Disconnect Tailscale? Servers stay in your tailnet. New servers no longer join it.")
							}
						}
					}
				}
			</div>
		}
	}
}

// connectedDot is green for an account that is connected.
templ connectedDot(on bool) {
	@components.Dot(components.DotProps{State: components.State(ifElse(on, string(components.StateLive), string(components.StateIdle)))})
}

// keyForm connects an account with its key, or replaces the key of a
// connected one: the field and the button in one row, a hint under it.
templ keyForm(id, name, label, hint, button string) {
	{{ base := ctxkeys.AppBasePath(ctx) }}
	<form hx-post={ base + "/integrations" } hx-target="#integrations" hx-select="#integrations" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-integration-form={ name }>
		@components.CSRF()
		@components.Field(components.FieldProps{Label: label, For: id, Hint: hint}) {
			<div class="moin-row" data-gap="2" data-phone="stack">
				@components.Input(components.InputProps{Attrs: templ.Attributes{"id": id, "aria-describedby": id + "-hint", "name": name, "type": "password", "autocomplete": "off", "required": true}})
				@components.Button(components.ButtonProps{Type: "submit"}) {
					{ button }
				}
			</div>
		}
	</form>
}

// disconnectButton takes one account's key away, after one question.
templ disconnectButton(key, label, question string) {
	{{ base := ctxkeys.AppBasePath(ctx) }}
	@components.Item(components.ItemProps{Button: true, Danger: true, Name: label, Attrs: templ.Attributes{
		"hx-post":         base + "/integrations",
		"hx-vals":         `{"remove":"` + key + `"}`,
		"hx-target":       "#integrations",
		"hx-select":       "#integrations",
		"hx-swap":         "outerHTML",
		"hx-disable":      "this",
		"hx-confirm":      question,
		"data-remove-key": key,
	}})
}
