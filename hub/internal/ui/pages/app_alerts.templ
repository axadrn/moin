package pages

import (
	"strings"
	"time"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
	"github.com/axadrn/moin/internal/human"
)

// AlertsView is the alerts page: where the alerts of the workspace go.
// Created is the destination just added, SigningSecret its secret, shown
// this once.
type AlertsView struct {
	Destinations  []model.AlertDestination
	Created       *model.AlertDestination
	SigningSecret string
}

// alertKinds give the kind select its labels.
var alertKinds = []components.Option{
	{Value: model.AlertSlack, Label: "Slack"},
	{Value: model.AlertDiscord, Label: "Discord"},
	{Value: model.AlertTelegram, Label: "Telegram", Attrs: templ.Attributes{"data-other": true}},
	{Value: model.AlertWebhook, Label: "Webhook"},
}

// Alerts is where the alerts of the workspace go: by mail to owners and
// admins, and to the destinations listed here.
templ Alerts(view AlertsView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@layouts.App("Alerts") {
		@panelPage(templ.Attributes{"data-alerts-page": true}) {
			@components.Header(components.HeaderProps{Back: components.Back{Label: "Settings", Href: basePath + "/settings"}, Title: "Alerts"})
			<div id="alerts" class="moin-stack" data-gap="6">
				if view.SigningSecret != "" && view.Created != nil {
					<div data-signing-secret>
						@components.Card(components.CardProps{Title: "Signing secret of " + view.Created.Name}) {
							<p class="moin-small moin-muted">
								Shown this once. Every post carries <code class="moin-mono moin-foreground">X-Moin-Signature: sha256=…</code>, the HMAC-SHA256 of the body with this secret.
							</p>
							@components.Command(components.CommandProps{Text: view.SigningSecret})
						}
					</div>
				}
				@alertDestinations(view)
				if ctxkeys.WorkspaceMember(ctx).Can(model.WorkspacePermissionManageWorkspace) {
					@alertDestinationForm()
				}
				<section class="moin-section">
					<div class="moin-section-head">
						<h2>Email</h2>
					</div>
					@components.List() {
						@components.Item(components.ItemProps{Href: basePath + "/settings/account", Name: "Owners and admins", Note: "Each turns it off for themselves"})
					}
				</section>
			</div>
		}
	}
}

// alertDestinations lists the destinations, with a test and a remove for
// owners and admins.
templ alertDestinations(view AlertsView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ manage := ctxkeys.WorkspaceMember(ctx).Can(model.WorkspacePermissionManageWorkspace) }}
	{{ now := time.Now() }}
	<section class="moin-section">
		<div class="moin-section-head">
			<h2>Destinations</h2>
		</div>
		<div data-alert-destinations>
			@components.List() {
				if len(view.Destinations) == 0 {
					@components.Item(components.ItemProps{Name: "None yet", Note: "Alerts go by mail only"})
				}
				for _, destination := range view.Destinations {
					@components.Item(components.ItemProps{Attrs: templ.Attributes{"data-alert-destination": destination.Name, "data-control": true}}) {
						<div class="moin-fill moin-stack" data-gap="1">
							<div>
								<div class="moin-row" data-gap="2">
									<span class="moin-truncate moin-strong">{ destination.Name }</span>
									<span class="moin-text moin-muted">{ model.AlertKindLabel(destination.Kind) }</span>
								</div>
								<div class="moin-truncate moin-text moin-muted">
									<span class="moin-mono">{ destination.Hint }</span>
									{ " · " + alertEventsText(destination) }
									if destination.FailingSince == nil && destination.LastSentAt != nil {
										<span title={ stamp(*destination.LastSentAt) }>{ " · sent " + human.Ago(*destination.LastSentAt, now) }</span>
									}
								</div>
							</div>
							if destination.FailingSince != nil {
								<div class="moin-row moin-text moin-failed" data-gap="2" data-alert-failing>
									@components.Dot(components.DotProps{State: components.StateFailed})
									<span class="moin-truncate">{ "Failing since " + human.Ago(*destination.FailingSince, now) + ": " + destination.LastError }</span>
								</div>
							}
						</div>
						if manage {
							<div class="moin-row moin-width" style="--width:auto" data-gap="2">
								@components.Button(components.ButtonProps{Attrs: templ.Attributes{
									"hx-post":    basePath + "/alerts/destinations/" + destination.Name + "/test",
									"hx-target":  "#alerts",
									"hx-select":  "#alerts",
									"hx-swap":    "outerHTML",
									"hx-disable": "this",
								}}) {
									Send test
								}
								@components.Button(components.ButtonProps{Kind: components.Danger, Attrs: templ.Attributes{
									"hx-delete":  basePath + "/alerts/destinations/" + destination.Name,
									"hx-target":  "#alerts",
									"hx-select":  "#alerts",
									"hx-swap":    "outerHTML",
									"hx-disable": "this",
									"hx-confirm": "Remove " + destination.Name + "? Its alerts stop.",
								}}) {
									Remove
								}
							</div>
						}
					}
				}
			}
		</div>
	</section>
}

// alertDestinationForm adds a destination. Telegram has a bot token and a
// chat ID instead of a URL: CSS shows the fields of the picked kind.
templ alertDestinationForm() {
	@components.Card(components.CardProps{Title: "Add a destination"}) {
		<form
			class="moin-stack"
			data-gap="4"
			data-either
			hx-post={ ctxkeys.AppBasePath(ctx) + "/alerts/destinations" }
			hx-target="#alerts"
			hx-select="#alerts"
			hx-swap="outerHTML"
			hx-disable="find button[type='submit']"
			data-alert-form
		>
			@components.CSRF()
			<div class="moin-grid">
				@components.Field(components.FieldProps{Label: "Kind", For: "alert-kind"}) {
					@components.Select(components.SelectProps{ID: "alert-kind", Name: "kind", Label: "Kind", Options: alertKinds, Value: model.AlertSlack})
				}
				@alertField("name", "Name", "team-chat", "Lowercase letters, digits and dashes", "text", "")
			</div>
			@alertField("url", "Webhook URL", "https://hooks.slack.com/services/…", "Stored encrypted, never shown again", "password", "url")
			@alertField("bot_token", "Bot token", "123456:ABC-DEF…", "From @BotFather; add the bot to the chat first", "password", "telegram")
			@alertField("chat_id", "Chat ID", "-1001234567890", "The chat, group or channel, or @channelname", "text", "telegram")
			<div class="moin-stack" data-gap="2">
				<span class="moin-text moin-strong">Events</span>
				<div class="moin-grid" data-gap="6">
					for _, event := range model.AlertEvents {
						{{ id := "alert-event-" + strings.ReplaceAll(event, ".", "-") }}
						<label for={ id } class="moin-row" data-between data-gap="3">
							<span class="moin-text">{ model.AlertEventLabel(event) }</span>
							@components.Switch(components.SwitchProps{Attrs: templ.Attributes{"id": id, "name": "events", "value": event, "checked": true}})
						</label>
					}
				</div>
			</div>
			<div class="moin-row" data-end>
				@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit"}) {
					Add destination
				}
			</div>
		</form>
	}
}

// alertField is one field of the destination form. forKind telegram shows
// it only for Telegram, url for every other kind.
templ alertField(name, label, placeholder, hint, kind, forKind string) {
	{{ id := "alert-" + strings.ReplaceAll(name, "_", "-") }}
	<div
		data-alert-kind={ forKind }
		if forKind == "url" {
			data-way="first"
		}
		if forKind == "telegram" {
			data-way="other"
		}
	>
		@components.Field(components.FieldProps{Label: label, For: id, Hint: hint}) {
			@components.Input(components.InputProps{Attrs: templ.Attributes{"id": id, "name": name, "type": kind, "placeholder": placeholder, "autocomplete": "off", "spellcheck": "false"}})
		}
	</div>
}

// alertEventsText names the events a destination gets.
func alertEventsText(destination model.AlertDestination) string {
	events := destination.EventList()
	if len(events) == len(model.AlertEvents) {
		return "every alert"
	}
	labels := make([]string, 0, len(events))
	for _, event := range events {
		labels = append(labels, model.AlertEventLabel(event))
	}
	return strings.Join(labels, ", ")
}
