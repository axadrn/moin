package pages

import (
	"context"
	"encoding/json"
	"fmt"
	"net/url"
	"path"
	"slices"
	"strconv"
	"strings"
	"time"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
	"github.com/axadrn/moin/protocol"
)

// DataView is the Data section of an app, at one of three depths: its
// databases (no Database), one database with its tables and backups
// (Database, no Table), or the rows of one table (Table).
type DataView struct {
	App       model.App
	Databases []protocol.Database
	// NoBackup is what looks like a database but moin cannot back up.
	NoBackup []protocol.Database
	// Database is the path of the open database; Table its open table.
	Database  string
	Table     *protocol.DBTable
	Tables    []protocol.DBTable
	Migration *protocol.DBMigration
	Result    protocol.DBResult
	Offset    int
	Limit     int
	// Error says why the server could not answer.
	Error string
	// Status is what the daemon last said about each database's backup, for
	// the list.
	Status []model.BackupStatus
	// Backups is the open database's backup: its bucket, the buckets the
	// app may pick, the ones it left, what the daemon reports and the
	// moments to go back to.
	Backups BackupsView
	Now     time.Time
}

// AppData is the Data section: the databases as a list that drills down,
// a database with its tables, SQL and backups, then a table with its rows.
// Only the list is the app's section with its head and tabs; a database
// and a table are pages of their own, one step under it (DESIGN.md,
// Navigation).
templ AppData(view DataView) {
	@layouts.App(dataTitle(view)) {
		@panelPage(templ.Attributes{"data-app-data": view.App.Name}) {
			switch  {
				case view.Table != nil:
					@dataTablePage(view)
				case view.Database != "":
					@dataDatabasePage(view)
				default:
					@dataListPage(view)
			}
		}
		@dataScripts()
		if view.Table == nil {
			// The app's changes come as the event "apps": the head and a
			// running restore reload on it.
			@components.Live(components.LiveProps{URL: "/api/v1/apps/events?workspace=" + ctxkeys.Workspace(ctx).Link()})
		}
	}
}

func dataTitle(view DataView) string {
	switch {
	case view.Table != nil:
		return view.Table.Name + " · " + view.App.Name
	case view.Database != "":
		return databaseName(view.Database) + " · " + view.App.Name
	}
	return view.App.Name + " data"
}

// dataListPage is the first page of Data: every database of the app, each a
// row with how its backup is, then where the backups of the app go.
templ dataListPage(view DataView) {
	@appHeader(view.App, "data")
	@appSection(view.App.Name, view.App.Link(), "data") {
		if len(view.Databases) == 0 && len(view.NoBackup) == 0 {
			@components.Card(components.CardProps{}) {
				<p class="moin-small moin-muted">
					No SQLite file on a volume and no Postgres service yet.
				</p>
				@components.Command(components.CommandProps{Text: "moin deploy " + view.App.Name})
			}
		} else {
			<section class="moin-section">
				<div class="moin-section-head">
					<h2>Databases</h2>
				</div>
				@components.List() {
					for _, database := range view.Databases {
						@components.Item(components.ItemProps{Href: databaseURL(ctx, view.App.Name, database.Path), Name: shortPath(database.Path), Note: databaseKind(database)}) {
							@databaseBackupValue(view, database.Path)
						}
					}
					for _, database := range view.NoBackup {
						@components.Item(components.ItemProps{Name: database.Service, Note: databaseKind(database)}) {
							@components.Status(components.StatusProps{State: components.StateFailed, Attrs: templ.Attributes{"data-no-backup": true}}) {
								moin can't back this up
							}
						}
					}
				}
			</section>
		}
		@BackupSettings(view.Backups)
	}
}

// databaseBackupValue is the value of a database's row: backed up, or
// that its backup fails and why.
templ databaseBackupValue(view DataView, database string) {
	{{ backup, known := backupStatusOf(view.Status, database) }}
	if view.Backups.Bucket == nil {
		<span class="moin-item-value">No backups</span>
	} else if known && backup.BackupError() != "" {
		@components.Status(components.StatusProps{State: components.StateFailed, Attrs: templ.Attributes{"title": service.BackupProblem(backup.BackupError())}}) {
			Backup fails
		}
	} else if known && backup.CheckError != "" {
		@components.Status(components.StatusProps{State: components.StateFailed, Attrs: templ.Attributes{"title": service.BackupProblem(backup.CheckError)}}) {
			Check failed
		}
	} else if known && backup.CopiedAt != nil {
		<span class="moin-item-value" title={ "Newest copy " + stamp(*backup.CopiedAt) }>Backed up</span>
	}
}

func backupStatusOf(statuses []model.BackupStatus, database string) (model.BackupStatus, bool) {
	for _, backup := range statuses {
		if backup.Database == database {
			return backup, true
		}
	}
	return model.BackupStatus{}, false
}

// dataDatabasePage is one database: its tables, its backup with the
// moments to go back to, and the SQL console.
templ dataDatabasePage(view DataView) {
	@components.Header(components.HeaderProps{Back: components.Back{Label: "Data", Href: dataPath(ctx, view.App.Link())}, Title: databaseName(view.Database)})
	<div class="moin-stack" data-gap="6">
		if view.Error != "" {
			@dataError(view.Error)
		} else {
			<section class="moin-section">
				<div class="moin-section-head">
					<h2>Tables</h2>
				</div>
				if len(view.Tables) == 0 {
					@components.Card(components.CardProps{}) {
						<p class="moin-small moin-muted">
							No tables yet. Your migrations make them on the next deploy.
						</p>
					}
				} else {
					@components.List() {
						for _, table := range view.Tables {
							@components.Item(components.ItemProps{Href: tableURL(ctx, view.App.Name, view.Database, table.Name, 0), Name: table.Name, Note: tableKind(table)}) {
								<span class="moin-item-value" data-table-link={ table.Name }>{ plural(int(table.Rows), "row", "rows") }</span>
							}
						}
						if view.Migration != nil {
							@components.Item(components.ItemProps{}) {
								<span class="moin-fill moin-strong" data-migration>Migrations</span>
								<span class="moin-truncate moin-text moin-muted" title={ view.Migration.AppliedAt }>{ view.Migration.Tool } · <span class="moin-mono">{ view.Migration.Version }</span></span>
							}
						}
					}
				}
			</section>
			@DatabaseBackups(view.Backups, view.Database)
			@dataConsole(view)
		}
	</div>
}

// dataTablePage is one table: its rows on a card to edit in place, then
// how it is built.
templ dataTablePage(view DataView) {
	{{ table := *view.Table }}
	@components.Header(components.HeaderProps{Back: components.Back{Label: databaseName(view.Database), Href: databaseURL(ctx, view.App.Name, view.Database)}, Title: table.Name})
	<div class="moin-stack" data-gap="6">
		if view.Error != "" {
			@dataError(view.Error)
		} else {
			@dataRows(view)
			@dataSchema(table)
		}
	</div>
}

// dataError is why the server could not answer: a state of the page.
templ dataError(message string) {
	<p role="alert" class="moin-row moin-text moin-failed" data-gap="2" data-data-error>
		@components.Dot(components.DotProps{State: components.StateFailed})
		<span class="moin-break">{ message }</span>
	</p>
}

// dataPath is the Data section of the app a link names.
func dataPath(ctx context.Context, app string) string {
	return ctxkeys.AppBasePath(ctx) + "/apps/" + app + "/data"
}

func databaseURL(ctx context.Context, app, database string) string {
	return dataPath(ctx, app) + "?db=" + url.QueryEscape(database)
}

func tableURL(ctx context.Context, app, database, table string, offset int) string {
	query := url.Values{}
	query.Set("db", database)
	query.Set("table", table)
	if offset > 0 {
		query.Set("offset", strconv.Itoa(offset))
	}
	return dataPath(ctx, app) + "?" + query.Encode()
}

// databaseName is what a database is called: a SQLite file by its name, a
// Postgres service by its key in moin, postgres-db.
func databaseName(database string) string {
	if strings.HasPrefix(database, "/") {
		return path.Base(database)
	}
	// Another database of a Postgres service: postgres-db/analytics.
	if _, name, ok := strings.Cut(database, "/"); ok {
		return name
	}
	return database
}

// databaseKind is what a database is, for people.
func databaseKind(database protocol.Database) string {
	switch database.Kind {
	case protocol.DatabasePostgres:
		return "Postgres"
	case "mysql":
		return "MySQL"
	case "mongo":
		return "MongoDB"
	}
	return "SQLite"
}

func tableKind(table protocol.DBTable) string {
	if table.Type == "view" {
		return "View"
	}
	return ""
}

// dataRows is the rows of a table on a card: each cell edits in place,
// each row has one action, Delete. Add row opens a form over the rows.
templ dataRows(view DataView) {
	{{ table := *view.Table }}
	{{ editable := service.Editable(table) }}
	{{ shown := view.Offset + len(view.Result.Rows) }}
	@components.Card(components.CardProps{Title: plural(int(table.Rows), "row", "rows"), Action: addRowAction(table)}) {
		if table.Type == "table" {
			@newRowForm(dataPath(ctx, view.App.Link()), view.Database, table)
		}
		if table.Type == "table" && !editable {
			<p class="moin-small moin-muted">
				No primary key, so a row has no name to edit it by. Change rows with SQL.
			</p>
		}
		if len(view.Result.Rows) == 0 {
			<p class="moin-small moin-muted">
				No rows yet.
			</p>
		} else {
			<div class="moin-bleed moin-scroll" data-both>
				<table class="moin-table" data-sticky data-rows>
					<thead>
						<tr>
							for _, column := range table.Columns {
								<th scope="col" data-num?={ isNumeric(column) }>
									<span class="moin-row" data-gap="2" data-end?={ isNumeric(column) }>
										if column.PrimaryKey {
											<span role="img" aria-label="primary key">
												@components.Icon("key")
											</span>
										}
										<span class="moin-foreground">{ column.Name }</span>
										<span class="moin-mono moin-small">{ strings.ToLower(column.Type) }</span>
									</span>
								</th>
							}
							if editable {
								<th scope="col"><span class="moin-sr-only">Delete</span></th>
							}
						</tr>
					</thead>
					<tbody>
						for _, row := range view.Result.Rows {
							{{ ref := rowRefOf(table, row, table.RowID) }}
							<tr data-row={ ref.RowID + ref.Key }>
								for index, column := range table.Columns {
									{{ value := cellValue(row, index, table.RowID) }}
									if editable && !isBlob(column) {
										<td data-edit>
											@DataCell(dataPath(ctx, view.App.Link()), view.Database, table.Name, ref, column, value, "")
										</td>
									} else {
										<td data-num?={ isNumeric(column) } data-null?={ value == nil }>{ cellText(value) }</td>
									}
								}
								if editable {
									<td>
										@components.Button(components.ButtonProps{Icon: true, Quiet: true, Kind: components.Danger, Attrs: templ.Attributes{
											"aria-label":          "Delete " + strings.ToLower(ref.Label()),
											"title":               "Delete",
											"hx-post":             dataPath(ctx, view.App.Link()) + "/delete",
											"hx-vals":             deleteRowVals(view.Database, table.Name, ref),
											"hx-target":           "closest tr",
											"hx-swap":             "outerHTML",
											"hx-disable":          "this",
											"hx-confirm":          "Delete " + strings.ToLower(ref.Label()) + " of " + table.Name + "? This cannot be undone.",
											"data-confirm-action": "Delete",
										}}) {
											@components.Icon("trash")
										}
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		if view.Offset > 0 || int64(shown) < table.Rows {
			<div class="moin-row" data-between data-gap="2" data-pager>
				<span class="moin-small moin-muted moin-digits">{ fmt.Sprintf("%d–%d of %d", view.Offset+1, shown, table.Rows) }</span>
				<div class="moin-row" data-gap="2">
					if view.Offset > 0 {
						@components.Button(components.ButtonProps{Href: tableURL(ctx, view.App.Name, view.Database, table.Name, max(view.Offset-view.Limit, 0))}) {
							Newer
						}
					}
					if int64(shown) < table.Rows {
						@components.Button(components.ButtonProps{Href: tableURL(ctx, view.App.Name, view.Database, table.Name, view.Offset+view.Limit)}) {
							Older
						}
					}
				</div>
			</div>
		}
	}
}

// addRowAction is the one action of the rows card: Add row, on a table,
// not a view.
func addRowAction(table protocol.DBTable) templ.Component {
	if table.Type != "table" {
		return nil
	}
	return addRowButton()
}

templ addRowButton() {
	@components.Button(components.ButtonProps{Attrs: templ.Attributes{"data-new-row-toggle": true, "aria-controls": "new-row", "aria-expanded": "false"}}) {
		Add row
	}
}

// dataSchema is how a table is built: its columns, then the statement that
// made it and its indexes. The schema changes with the migrations in the
// repo, not here.
templ dataSchema(table protocol.DBTable) {
	<section class="moin-section">
		<div class="moin-section-head">
			<h2>Columns</h2>
		</div>
		@components.List() {
			for _, column := range table.Columns {
				@components.Item(components.ItemProps{Name: column.Name, Note: columnNote(column), Attrs: templ.Attributes{"data-schema-column": column.Name}}) {
					<span class="moin-item-value moin-mono">{ columnType(column) }</span>
				}
			}
		}
	</section>
	<section class="moin-section">
		<div class="moin-section-head">
			<h2>Statement</h2>
		</div>
		<div class="moin-stack" data-gap="2">
			<div class="moin-code" data-wrap>
				<pre data-table-sql>{ table.SQL }</pre>
			</div>
			for _, index := range table.Indexes {
				<div class="moin-code" data-wrap>
					<pre>{ index }</pre>
				</div>
			}
		</div>
	</section>
}

func columnType(column protocol.DBColumn) string {
	if column.Type == "" {
		return "—"
	}
	return strings.ToLower(column.Type)
}

func columnNote(column protocol.DBColumn) string {
	notes := []string{}
	if column.PrimaryKey {
		notes = append(notes, "Primary key")
	}
	if column.NotNull {
		notes = append(notes, "Not null")
	}
	return strings.Join(notes, " · ")
}

// newRowForm adds a row: a field per column. It opens with Add row and
// closes with Cancel.
templ newRowForm(dataPath, database string, table protocol.DBTable) {
	<form id="new-row" hidden class="moin-stack" data-gap="4" hx-post={ dataPath + "/insert" } hx-swap="none" hx-disable="find button[type='submit']" data-new-row>
		@components.CSRF()
		<input type="hidden" name="db" value={ database }/>
		<input type="hidden" name="table" value={ table.Name }/>
		<div class="moin-grid">
			for _, column := range table.Columns {
				@components.Field(components.FieldProps{Label: column.Name, For: "new-row-" + column.Name, Hint: strings.ToLower(column.Type)}) {
					@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "new-row-" + column.Name, "type": "text", "name": "value:" + column.Name, "placeholder": newRowPlaceholder(column), "spellcheck": "false", "autocomplete": "off"}})
				}
			}
		</div>
		<div class="moin-row" data-wrap data-end data-gap="2">
			@components.Button(components.ButtonProps{Attrs: templ.Attributes{"data-new-row-cancel": true}}) {
				Cancel
			}
			@components.Button(components.ButtonProps{Type: "submit"}) {
				Save row
			}
		</div>
	</form>
}

func newRowPlaceholder(column protocol.DBColumn) string {
	switch {
	case column.PrimaryKey && strings.EqualFold(column.Type, "INTEGER"):
		return "automatic"
	case column.NotNull:
		return "required"
	}
	return "NULL"
}

// DataCell is one editable cell: a form that saves on Enter or when it
// loses focus with a changed value. No box until it has the focus.
templ DataCell(dataPath, database, table string, ref DataRowRef, column protocol.DBColumn, value any, state string) {
	<form
		hx-post={ dataPath + "/cell" }
		hx-swap="outerHTML"
		hx-trigger="submit, change"
		data-cell={ state }
	>
		@components.CSRF()
		<input type="hidden" name="db" value={ database }/>
		<input type="hidden" name="table" value={ table }/>
		if ref.Key != "" {
			<input type="hidden" name="key" value={ ref.Key }/>
		} else {
			<input type="hidden" name="rowid" value={ ref.RowID }/>
		}
		<input type="hidden" name="column" value={ column.Name }/>
		if value == nil {
			<input type="hidden" name="was_null" value="1"/>
		}
		@components.Input(components.InputProps{Type: "text", Name: "value", Value: cellInput(value), Attrs: dataCellAttributes(column, value, state)})
	</form>
}

// dataCellAttributes are the attributes of the field of a cell.
func dataCellAttributes(column protocol.DBColumn, value any, state string) templ.Attributes {
	attributes := templ.Attributes{"aria-label": column.Name, "spellcheck": "false", "autocomplete": "off", "data-original": cellInput(value), "data-bare": true, "data-num": isNumeric(column)}
	if value == nil {
		attributes["placeholder"] = "NULL"
	}
	if state != "" {
		attributes["data-state"] = state
	}
	return attributes
}

// dataConsole runs SQL on the database: reads only, unless Allow changes
// is on.
templ dataConsole(view DataView) {
	<section class="moin-section">
		<div class="moin-section-head">
			<h2>SQL</h2>
		</div>
		@components.Card(components.CardProps{}) {
			<form class="moin-stack" data-gap="4" hx-post={ dataPath(ctx, view.App.Link()) + "/query" } hx-target="#sql-result" hx-swap="innerHTML" hx-disable="find button[type='submit']" data-sql-form>
				@components.CSRF()
				<input type="hidden" name="db" value={ view.Database }/>
				<label for="sql" class="moin-sr-only">SQL</label>
				@components.TextArea(components.TextAreaProps{Attrs: templ.Attributes{"id": "sql", "name": "sql", "rows": "4", "placeholder": sqlPlaceholder(view), "spellcheck": "false", "autocomplete": "off", "data-sql": true}})
				<p hidden class="moin-text moin-running" data-sql-schema-hint>This changes the schema. Put it in a migration, or the next deploy will not know about it.</p>
				<div class="moin-row" data-wrap data-between data-gap="3">
					<label class="moin-row" data-gap="3">
						@components.Switch(components.SwitchProps{Attrs: templ.Attributes{"name": "write", "value": "1", "data-sql-write": true}})
						<span class="moin-text moin-strong">Allow changes</span>
					</label>
					@components.Button(components.ButtonProps{Type: "submit"}) {
						Run
					}
				</div>
			</form>
			<div id="sql-result" class="moin-hide-empty"></div>
		}
	</section>
}

// dataScripts is the script of the data pages: the SQL console's keys and
// migration line, the cells' Enter and Esc, and Add row.
templ dataScripts() {
	@dataScript.Once() {
		<script nonce={ templ.GetNonce(ctx) }>
			(() => {
				// SQL that creates, alters or drops gets the line about migrations.
				document.addEventListener("input", (event) => {
					const sql = event.target.closest?.("[data-sql]");
					if (!sql) return;
					sql.form.querySelector("[data-sql-schema-hint]").hidden = !/^\s*(create|alter|drop)\b/i.test(sql.value);
				});
				document.addEventListener("keydown", (event) => {
					// ⌘↵ or ctrl+↵ runs the SQL.
					const sql = event.target.closest?.("[data-sql]");
					if (sql && event.key === "Enter" && (event.metaKey || event.ctrlKey)) {
						event.preventDefault();
						sql.form.requestSubmit();
						return;
					}
					// Enter saves a cell, Esc puts its value back.
					const cell = event.target.closest?.("[data-rows] input[name=value]");
					if (!cell) return;
					if (event.key === "Escape") {
						cell.value = cell.dataset.original;
						cell.blur();
					}
					if (event.key === "Enter") {
						event.preventDefault();
						cell.blur();
					}
				});
				// Add row opens the new row form, Cancel closes it again.
				document.addEventListener("click", (event) => {
					const toggle = event.target.closest("[data-new-row-toggle], [data-new-row-cancel]");
					if (!toggle) return;
					const form = document.querySelector("[data-new-row]");
					const button = document.querySelector("[data-new-row-toggle]");
					if (!form || !button) return;
					const open = toggle.matches("[data-new-row-toggle]") && form.hidden;
					form.hidden = !open;
					button.setAttribute("aria-expanded", String(open));
					if (open) form.querySelector("input[type=text]")?.focus();
					else button.focus();
				});
			})();
		</script>
	}
}

// dataScript puts the script of the data pages on a page once.
var dataScript = templ.NewOnceHandle()

func sqlPlaceholder(view DataView) string {
	if len(view.Tables) == 0 {
		if strings.HasPrefix(view.Database, "/") {
			return "SELECT * FROM sqlite_schema"
		}
		return "SELECT * FROM information_schema.tables"
	}
	return "SELECT * FROM " + view.Tables[0].Name + " LIMIT 20"
}

// DataResult is the answer of the SQL console: an error in red, a change
// the rows it changed, a read the rows it found.
templ DataResult(result protocol.DBResult, write bool, message string) {
	if message != "" {
		<p role="alert" class="moin-mono moin-text moin-break moin-failed" data-sql-error>{ message }</p>
	} else if write {
		<p role="status" class="moin-row moin-text moin-strong" data-gap="2" data-sql-changes>
			@components.Icon("check")
			{ plural(int(result.Changes), "row changed", "rows changed") }
		</p>
	} else {
		<div class="moin-stack" data-gap="2">
			<p role="status" class="moin-small moin-muted moin-digits">
				{ plural(len(result.Rows), "row", "rows") }
				if result.Truncated {
					, more not shown
				}
			</p>
			if len(result.Columns) > 0 {
				{{ numeric := numericColumns(result) }}
				<div class="moin-bleed moin-scroll" data-both>
					<table class="moin-table" data-sticky data-sql-result>
						<thead>
							<tr>
								for index, column := range result.Columns {
									<th scope="col" data-num?={ numeric[index] }>{ column }</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, row := range result.Rows {
								<tr>
									for index, value := range row {
										<td data-num?={ numeric[index] } data-null?={ value == nil }>{ cellText(value) }</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// isNumeric says whether a column holds numbers, by SQLite's type affinity,
// so its values align right.
func isNumeric(column protocol.DBColumn) bool {
	kind := strings.ToUpper(column.Type)
	for _, part := range []string{"INT", "REAL", "FLOA", "DOUB", "NUMERIC", "DECIMAL"} {
		if strings.Contains(kind, part) {
			return true
		}
	}
	return false
}

// numericColumns says per column of a query result whether every value is
// a number or NULL, so the column aligns right, its head too.
func numericColumns(result protocol.DBResult) []bool {
	numeric := make([]bool, len(result.Columns))
	for index := range numeric {
		numeric[index] = slices.ContainsFunc(result.Rows, func(row []any) bool { return index < len(row) && isNumber(row[index]) }) &&
			!slices.ContainsFunc(result.Rows, func(row []any) bool { return index < len(row) && row[index] != nil && !isNumber(row[index]) })
	}
	return numeric
}

// isNumber says whether a value of a query result is a number.
func isNumber(value any) bool {
	_, ok := value.(float64)
	return ok
}

// deleteRowVals are the hx-vals of the delete button of a row.
func deleteRowVals(database, table string, ref DataRowRef) string {
	vals := map[string]string{"db": database, "table": table}
	if ref.Key != "" {
		vals["key"] = ref.Key
	} else {
		vals["rowid"] = ref.RowID
	}
	body, _ := json.Marshal(vals)
	return string(body)
}

// DataRowRef names a row on the data page: by its rowid, or by the values
// of its primary key as JSON, column by column.
type DataRowRef struct {
	RowID string
	Key   string
}

// Label names the row for people: "Row 12", or "The row" by its key.
func (r DataRowRef) Label() string {
	if r.Key == "" {
		return "Row " + r.RowID
	}
	return "The row"
}

// rowRefOf names a row of a page: by its rowid, the first value when the
// page has one, or by the values of the primary key.
func rowRefOf(table protocol.DBTable, row []any, withRowID bool) DataRowRef {
	if withRowID {
		if len(row) == 0 {
			return DataRowRef{}
		}
		return DataRowRef{RowID: cellInput(row[0])}
	}
	key := map[string]string{}
	for index, column := range table.Columns {
		if column.PrimaryKey && index < len(row) {
			key[column.Name] = cellInput(row[index])
		}
	}
	if len(key) == 0 {
		return DataRowRef{}
	}
	body, _ := json.Marshal(key)
	return DataRowRef{Key: string(body)}
}

func cellValue(row []any, index int, withRowID bool) any {
	if withRowID {
		index++
	}
	if index >= len(row) {
		return nil
	}
	return row[index]
}

func cellText(value any) string {
	if value == nil {
		return "NULL"
	}
	return cellInput(value)
}

// cellInput writes a value as the text a cell edits. JSON numbers arrive
// as float64; whole ones print without a decimal point.
func cellInput(value any) string {
	switch value := value.(type) {
	case nil:
		return ""
	case float64:
		if value == float64(int64(value)) {
			return strconv.FormatInt(int64(value), 10)
		}
		return strconv.FormatFloat(value, 'g', -1, 64)
	case string:
		return value
	default:
		return fmt.Sprint(value)
	}
}

func isBlob(column protocol.DBColumn) bool {
	kind := strings.ToUpper(column.Type)
	return strings.Contains(kind, "BLOB") || kind == "BYTEA"
}
