package pages

import (
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/ui/components"
)

// confirmDialogID is the id of the Confirm it's you dialog. passkey.js
// opens it when the hub answers that the person has to confirm first.
const confirmDialogID = "confirm-its-you"

// ConfirmDialog asks the person to confirm it is them, in place, without
// signing out: why says what for, next is the page to come back to. A
// confirmation counts for five minutes (service.ConfirmedFor).
templ ConfirmDialog(why, next string) {
	@components.Dialog(components.DialogProps{ID: confirmDialogID, Title: "Confirm it's you", Note: why}) {
		@confirmWays(next)
		@components.DialogButtons() {
			@components.Button(components.ButtonProps{Attrs: components.CloseDialog()}) {
				Cancel
			}
		}
	}
}

// confirmWays are the ways this person confirms it is them: their passkey,
// the GitHub account they sign in with, or both. Each comes back to next.
templ confirmWays(next string) {
	{{ user := ctxkeys.User(ctx) }}
	{{ passkey := ctxkeys.RenderConfig(ctx).Passkeys && user.Passkeys > 0 }}
	{{ github := ctxkeys.RenderConfig(ctx).GitHubLogin && user.GitHubID != nil }}
	<div class="moin-stack" data-gap="2">
		if passkey {
			<form method="post" action="/auth/confirm/passkey">
				@components.CSRF()
				<input type="hidden" name="next" value={ next }/>
				<input type="hidden" name="passkey" value=""/>
				@components.Button(components.ButtonProps{Kind: components.Primary, Attrs: templ.Attributes{"type": "button", "data-passkey": "confirm", "data-passkey-url": "/auth/confirm/passkey"}}) {
					Use passkey
				}
			</form>
			<p class="moin-message" data-state="failed" role="alert" data-passkey-error hidden></p>
			@passkeyScript()
		}
		if github {
			<form method="post" action="/auth/confirm/github">
				@components.CSRF()
				<input type="hidden" name="next" value={ next }/>
				@components.Button(components.ButtonProps{Kind: githubKind(passkey), Type: "submit"}) {
					Continue with GitHub
				}
			</form>
		}
		if !passkey && !github && ctxkeys.RenderConfig(ctx).GitHubLogin {
			<p class="moin-text moin-muted">Connect GitHub first: Settings, Account, Security.</p>
		} else if !passkey && !github {
			<p class="moin-text moin-muted">Sign in again to confirm.</p>
		}
	</div>
}

// githubKind makes Continue with GitHub the primary button, unless the
// passkey is.
func githubKind(passkey bool) components.Kind {
	if passkey {
		return ""
	}
	return components.Primary
}
