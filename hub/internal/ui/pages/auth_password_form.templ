package pages

import "github.com/axadrn/moin/hub/internal/ui/components"

// AuthPasswordForm keeps the email it was sent, so a wrong password is
// the only thing to type again.
templ AuthPasswordForm(email, errorMsg string) {
	<form
		id="password-form"
		action="/auth/password"
		method="POST"
		class="moin-stack"
		data-gap="4"
		hx-post="/auth/password"
		hx-target="#password-form"
		hx-swap="outerHTML"
		hx-disable="find button[type='submit']"
	>
		@components.CSRF()
		@formField("Email", "email", "", "") {
			@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "email", "aria-describedby": "email-hint", "name": "email", "type": "email", "value": email, "placeholder": "you@example.com", "autocomplete": "email", "autofocus": email == "", "required": true}})
		}
		@formField("Password", "password", "", errorMsg) {
			@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "password", "name": "password", "type": "password", "aria-invalid": ariaInvalid(errorMsg), "aria-describedby": "password-hint", "autocomplete": "current-password", "autofocus": email != "", "required": true}})
		}
		@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit"}) {
			Sign in
		}
		@authLink("/auth/forgot-password") {
			Forgot password?
		}
	</form>
}
