package pages

import (
	"context"

	"github.com/axadrn/moin/hub/internal/brand"
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// Auth is the way in: GitHub where the GitHub App is set up, else the
// recovery key from the terminal, which signs in the first admin, and a
// passkey where the hub offers them. note says why someone is here, like
// after an email change.
templ Auth(note, githubError string) {
	@authScreen(layouts.SEOProps{Title: "Sign in", Description: "Sign in to " + brand.Name + " or create your account"}, authTitle(ctx)) {
		if note != "" {
			@authLine() {
				{ note }
			}
		}
		if ctxkeys.RenderConfig(ctx).GitHubLogin {
			if ctxkeys.RenderConfig(ctx).Billing {
				@authLine() {
					{ layouts.TrialOffer() } No card.
				}
			}
			if githubError != "" {
				<p class="moin-text moin-failed moin-center" role="alert">{ githubError }</p>
			}
			@authStack() {
				@continueWithGitHub()
				@signInWithPasskey()
			}
			@authTerms()
		} else {
			@authStack() {
				@AuthKeyForm("")
				@signInWithPasskey()
			}
		}
	}
}

// AuthGitHubFailed is the way in after a GitHub sign-in did not work, with
// what went wrong.
templ AuthGitHubFailed(message string) {
	@Auth("", message)
}

// continueWithGitHub is the one button that signs in.
templ continueWithGitHub() {
	@components.Button(components.ButtonProps{Kind: components.Primary, Href: "/auth/github"}) {
		@components.Icon("git-hub")
		Continue with GitHub
	}
}

// signInWithPasskey signs in with a passkey of this hub, without an email
// typed: the passkey names the account (passkey.js).
templ signInWithPasskey() {
	if ctxkeys.RenderConfig(ctx).Passkeys {
		@components.Button(components.ButtonProps{Attrs: templ.Attributes{"data-passkey": "sign-in", "data-passkey-url": "/auth/passkey"}}) {
			@components.Icon("key")
			Sign in with a passkey
		}
		@passkeyError()
		@passkeyScript()
	}
}

// passkeyError is the line under a passkey button that says why it did
// not work. passkey.js fills it.
templ passkeyError() {
	<p class="moin-text moin-failed" role="alert" data-passkey-error hidden></p>
}

// passkeyScript is passkey.js, for a page with a passkey button.
templ passkeyScript() {
	<script defer nonce={ templ.GetNonce(ctx) } src={ components.AssetURL("/assets/js/passkey.js") }></script>
}

// AuthKey takes a recovery key from the terminal.
templ AuthKey(errorMsg string) {
	@authScreen(layouts.SEOProps{Title: "Sign in with a key", Description: "Sign in with a recovery key"}, "Sign in with a key") {
		@authStack() {
			@AuthKeyForm(errorMsg)
		}
	}
}

// AuthKeyForm is the one field of a recovery key. The operator makes the
// key with the server command recovery-key; it works once, for an hour.
templ AuthKeyForm(errorMsg string) {
	<form
		id="key-form"
		action="/auth/key"
		method="POST"
		class="moin-stack"
		data-gap="4"
		hx-post="/auth/key"
		hx-target="#key-form"
		hx-swap="outerHTML"
		hx-disable="find button[type='submit']"
	>
		@components.CSRF()
		@formField("Key from the terminal", "key", "From recovery-key on the server. It works once, for an hour.", errorMsg) {
			@components.Input(components.InputProps{Attrs: templ.Attributes{
				"id":               "key",
				"name":             "key",
				"type":             "text",
				"aria-invalid":     ariaInvalid(errorMsg),
				"aria-describedby": "key-hint",
				"autocomplete":     "off",
				"autocapitalize":   "characters",
				"spellcheck":       "false",
				"autofocus":        true,
				"required":         true,
			}})
		}
		@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit"}) {
			Sign in
		}
	</form>
}

// AuthPrivate is what a new account sees while sign-up is closed: only
// admins and invited people get in.
templ AuthPrivate() {
	@authScreen(layouts.SEOProps{Title: "This " + brand.Name + " is private", Description: "Ask its admin for an invitation"}, "This "+brand.Name+" is private") {
		@authLine() {
			Ask its admin for an invitation.
		}
		<div data-private>
			@authLink("/auth") {
				Back to sign in
			}
		</div>
	}
}

// authTitle invites people in: start free on the hosted hub,
// sign in on a self-hosted one.
func authTitle(ctx context.Context) string {
	if ctxkeys.RenderConfig(ctx).Billing {
		return "Start free"
	}
	return "Sign in"
}
