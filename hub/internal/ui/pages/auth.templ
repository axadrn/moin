package pages

import (
	"context"

	"github.com/axadrn/moin/hub/internal/brand"
	"github.com/axadrn/moin/hub/internal/config"
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// Auth is the way in: GitHub first where it is set up, else a link by
// email, and a password for those who set one.
templ Auth(errorMsg string) {
	{{ github := ctxkeys.RenderConfig(ctx).GitHubLogin }}
	@authScreen(layouts.SEOProps{Title: "Sign in", Description: "Sign in to " + brand.Name + " or create your account"}, authTitle(ctx)) {
		if ctxkeys.RenderConfig(ctx).Billing {
			@authLine() {
				30 days free. No card.
			}
		}
		@authStack() {
			if github {
				@components.Button(components.ButtonProps{Kind: components.Primary, Href: "/auth/github"}) {
					@components.Icon("git-hub")
					Continue with GitHub
				}
				@authOr()
			}
			@AuthMagicLinkForm(errorMsg)
			if config.GoogleOAuthEnabled {
				@components.Button(components.ButtonProps{Href: "/auth/google"}) {
					@components.Icon("google")
					Continue with Google
				}
			}
			@authLink("/auth/password") {
				Sign in with a password
			}
		}
		@authTerms()
	}
}

// authTitle invites people in: start free on the hosted hub,
// sign in on a self-hosted one.
func authTitle(ctx context.Context) string {
	if ctxkeys.RenderConfig(ctx).Billing {
		return "Start free"
	}
	return "Sign in"
}
