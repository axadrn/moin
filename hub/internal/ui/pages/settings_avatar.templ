package pages

import (
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/kit"
)

// SettingsAvatarSection is your picture: Upload picks an image and saves it
// at once, Remove shows only while there is one. A change answers both of
// its parts by fragment.
templ SettingsAvatarSection(user *model.User) {
	@kit.Card("Picture", nil) {
		<div class="flex items-center gap-4">
			@SettingsAvatarDisplay(user)
			@SettingsAvatarForm(user.AvatarURL != "")
		</div>
	}
	@pickFileOnce.Once() {
		<script nonce={ templ.GetNonce(ctx) }>
			// A button with data-pick-file opens the file picker of the
			// hidden input it names.
			document.addEventListener("click", (event) => {
				const button = event.target.closest("[data-pick-file]");
				if (button) document.getElementById(button.dataset.pickFile)?.click();
			});
		</script>
	}
}

// SettingsAvatarDisplay is the picture, or the initials.
templ SettingsAvatarDisplay(user *model.User) {
	@templ.Fragment("settings-avatar-display") {
		<div id="settings-avatar" hx-swap-oob="true">
			@kit.Avatar(user.AvatarURL, user.Name, user.Initials(), "size-16")
		</div>
	}
}

// SettingsAvatarForm uploads the image as soon as one is picked.
templ SettingsAvatarForm(hasAvatar bool) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@templ.Fragment("settings-avatar-form") {
		<form
			id="avatar-upload-form"
			enctype="multipart/form-data"
			class="flex flex-wrap items-center gap-2"
			hx-swap-oob="true"
			hx-post={ basePath + "/account/avatar" }
			hx-trigger="change"
			hx-encoding="multipart/form-data"
			hx-swap="none"
			hx-disable="find button"
		>
			@kit.CSRF()
			<input type="file" id="avatar" name="avatar" accept="image/jpeg,image/jpg,image/png,image/webp" class="sr-only" tabindex="-1" aria-label="Picture"/>
			@kit.Button(kit.Secondary, "", templ.Attributes{"type": "button", "data-pick-file": "avatar"}) {
				Upload
			}
			if hasAvatar {
				@kit.Button(kit.Secondary, "", templ.Attributes{
					"type":       "button",
					"hx-delete":  basePath + "/account/avatar",
					"hx-swap":    "none",
					"hx-disable": "this",
					"hx-confirm": "Remove your picture? Your initials show instead.",
				}) {
					Remove
				}
			}
		</form>
	}
}

var pickFileOnce = templ.NewOnceHandle()
