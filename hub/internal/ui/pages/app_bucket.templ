package pages

import (
	"strings"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/kit"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// BucketView is the buckets page: the workspace's own S3-compatible
// buckets, the default first.
type BucketView struct {
	Buckets []service.Bucket
}

// Bucket is where the workspace keeps code and backups: its own
// S3-compatible buckets, each a group of its facts and what to do with it,
// and the way to add one.
templ Bucket(view BucketView) {
	@layouts.App("Bucket") {
		@panelPage(templ.Attributes{"data-bucket-page": true}) {
			@components.Header(components.HeaderProps{Back: components.Back{Label: "Settings", Href: ctxkeys.AppBasePath(ctx) + "/settings"}, Title: "Bucket"})
			<div id="bucket" class="moin-stack" data-gap="6">
				for _, bucket := range view.Buckets {
					@bucketPanel(bucket)
				}
				@bucketAdd(len(view.Buckets) == 0)
			</div>
		}
	}
}

// bucketPanel is one bucket: where it is and which apps use it, then
// changing it, making it the default and removing it.
templ bucketPanel(bucket service.Bucket) {
	{{ bucketPath := ctxkeys.AppBasePath(ctx) + "/bucket/" + bucket.Name }}
	<div data-bucket={ bucket.Name }>
		<section class="moin-section">
			<div class="moin-section-head">
				<h2>{ bucket.Name }</h2>
				@bucketBadge(bucket.Default)
			</div>
			@components.List() {
				@bucketFact("Used by", bucketUsedBy(bucket), false, nil)
				@bucketFact("Bucket", bucket.Bucket, true, templ.Attributes{"data-bucket": true})
				if bucket.Folder != "" {
					@bucketFact("Folder", bucket.Folder, true, templ.Attributes{"data-bucket-folder": true})
				}
				@bucketFact("Endpoint", orAWS(bucket.Endpoint), true, nil)
				@bucketFact("Access key", bucket.AccessKey, true, nil)
				if len(bucket.Older) > 0 {
					@components.Item(components.ItemProps{}) {
						<div class="min-w-0 flex-1" data-bucket-older>
							<div class="moin-strong">Left by</div>
							<div class="moin-small moin-muted">{ strings.Join(bucket.Older, ", ") }: what they had stays here.</div>
						</div>
					}
				}
				@bucketDisclosure("Change") {
					@bucketForm(bucketPath, "bucket-"+bucket.Name+"-", bucket, false)
				}
				if !bucket.Default {
					@components.Item(components.ItemProps{Button: true, Name: "Make default", Attrs: templ.Attributes{
						"hx-post":           bucketPath + "/default",
						"hx-target":         "#bucket",
						"hx-select":         "#bucket",
						"hx-swap":           "outerHTML",
						"hx-disable":        "this",
						"hx-confirm":        "Make " + bucket.Name + " the default bucket? Apps without a bucket of their own upload and back up there from now on; their copies start again there.",
						"data-make-default": bucket.Name,
					}})
				}
				@components.Item(components.ItemProps{Button: true, Danger: true, Name: "Remove", Attrs: templ.Attributes{
					"hx-post":            bucketPath + "/remove",
					"hx-target":          "#bucket",
					"hx-select":          "#bucket",
					"hx-swap":            "outerHTML",
					"hx-disable":         "this",
					"hx-confirm":         "Remove the bucket " + bucket.Name + " from moin? What is in it stays there.",
					"data-confirm-name":  bucket.Name,
					"data-remove-bucket": bucket.Name,
				}})
			}
		</section>
	</div>
}

// bucketFact is one fact of a bucket: its name left, the value right.
templ bucketFact(name, value string, mono bool, attributes templ.Attributes) {
	@kit.RowFact(name, "") {
		<span class={ templ.KV("font-mono", mono) } { attributes... }>{ value }</span>
	}
}

// bucketDisclosure is a row of a List that opens a form under it, in
// place (kit.RowMore).
templ bucketDisclosure(label string) {
	@components.Expand(components.ExpandProps{Name: label}) {
		@kit.RowControl(nil) {
			<div class="min-w-0 flex-1 pt-1 pb-2">
				{ children... }
			</div>
		}
	}
}

// bucketAdd adds a bucket. Without any bucket its form is open.
templ bucketAdd(first bool) {
	<div data-add-bucket>
		if first {
			@components.Card(components.CardProps{Title: "Add your bucket"}) {
				<p class="moin-small moin-muted">
					Deploys from your terminal and backups go there. Its keys need read and write access to this one bucket.
				</p>
				@bucketForm(ctxkeys.AppBasePath(ctx)+"/bucket", "bucket-new-", service.Bucket{Name: "default"}, true)
			}
		} else {
			@components.List() {
				@bucketDisclosure("Another bucket") {
					@bucketForm(ctxkeys.AppBasePath(ctx)+"/bucket", "bucket-new-", service.Bucket{}, true)
				}
			}
		}
	</div>
}

// bucketForm adds a bucket or changes one. The IDs of its fields start
// with prefix, so every form on the page has its own.
templ bucketForm(action, prefix string, bucket service.Bucket, adding bool) {
	<form class="moin-stack" data-gap="4" hx-post={ action } hx-target="#bucket" hx-select="#bucket" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-bucket-form>
		@components.CSRF()
		<div class="grid items-start gap-4 sm:grid-cols-2">
			@bucketField(prefix, "name", "Name", bucket.Name, "like client-a", "Your name for it in moin", "text", false)
			@bucketField(prefix, "region", "Region", bucket.Region, "auto", "auto for R2", "text", false)
			@bucketField(prefix, "endpoint", "Endpoint", bucket.Endpoint, "https://<account>.r2.cloudflarestorage.com", "Empty for AWS S3", "text", true)
			@bucketField(prefix, "bucket", "Bucket", bucket.Bucket, "your bucket's name", "", "text", false)
			@bucketField(prefix, "path", "Folder", bucket.Path, "optional", "Only if the bucket holds other files too", "text", false)
			@bucketField(prefix, "access_key", "Access key", bucket.AccessKey, "", "", "text", false)
			@bucketField(prefix, "secret_key", "Secret key", "", secretPlaceholder(adding), "Stored encrypted", "password", false)
		</div>
		<div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-end">
			<p class="px-1 text-sm text-muted-foreground">moin writes and deletes a test file first.</p>
			if adding {
				@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit"}) {
					Add bucket
				}
			} else {
				@components.Button(components.ButtonProps{Type: "submit"}) {
					Save bucket
				}
			}
		</div>
	</form>
}

// bucketField is one field of a bucket form, with a hint below.
templ bucketField(prefix, name, label, value, placeholder, hint, kind string, wide bool) {
	<div class={ templ.KV("sm:col-span-2", wide) }>
		@components.Field(components.FieldProps{Label: label, For: prefix+name, Hint: hint}) {
			@components.Input(components.InputProps{Attrs: templ.Attributes{"id": prefix + name, "name": name, "type": kind, "value": value, "placeholder": placeholder, "autocomplete": "off", "spellcheck": "false"}})
		}
	</div>
}

templ bucketBadge(isDefault bool) {
	if isDefault {
		<span class="moin-small moin-muted" data-default-bucket>Default</span>
	}
}

// bucketUsedBy says which apps upload and back up to a bucket.
func bucketUsedBy(bucket service.Bucket) string {
	switch {
	case len(bucket.Apps) > 0 && bucket.Default:
		return strings.Join(bucket.Apps, ", ") + " and every new app"
	case len(bucket.Apps) > 0:
		return strings.Join(bucket.Apps, ", ")
	case bucket.Default:
		return "Every new app"
	}
	return "No app yet"
}

func secretPlaceholder(adding bool) string {
	if adding {
		return ""
	}
	return "empty keeps the stored one"
}
