package pages

import (
	"strings"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/kit"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
	"github.com/axadrn/moin/internal/build"
	"github.com/axadrn/moin/protocol"
)

// SecurityView is the security page of a server.
type SecurityView struct {
	Server       model.Server
	Integrations service.Integrations
}

// ServerSecurity is the page of one server: how it is reached, what the
// daemon set up, the keys all servers share, its rules, its name, a new
// install command, and removing it at the end.
templ ServerSecurity(view SecurityView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ server := view.Server }}
	{{ securityPath := basePath + "/servers/" + server.Link() + "/security" }}
	@layouts.App(server.Name + " security") {
		@panelPage(templ.Attributes{"data-server-security": server.Name}) {
			@serverHead(server, "security")
			<div id="server-security" class="flex flex-col gap-6">
				@securityState(view, securityPath)
				@securityKeys(view)
				@serverRules(server)
				@kit.Card("Name", nil) {
					<form
						hx-post={ basePath + "/servers/" + server.Link() + "/name" }
						hx-target="#main"
						hx-select="#main"
						hx-swap="outerHTML"
						hx-disable="find button[type='submit']"
						data-rename-server
					>
						@kit.CSRF()
						<label for="server-rename" class="sr-only">Server name</label>
						@kit.Inline() {
							@kit.Input(templ.Attributes{"id": "server-rename", "name": "name", "type": "text", "value": server.Name, "maxlength": "63", "autocomplete": "off", "spellcheck": "false"})
							@kit.Button(kit.Secondary, "", templ.Attributes{"type": "submit"}) {
								Save
							}
						}
					</form>
				}
				@kit.List() {
					if server.Online && daemonOutdated(server) {
						@kit.RowButton(false, templ.Attributes{"hx-post": basePath + "/servers/" + server.Link() + "/update", "hx-swap": "none", "hx-disable": "this", "data-update-daemon": server.Name}) {
							@kit.RowText("Update daemon", server.DaemonVersion+" → "+build.Version)
						}
					}
					@kit.RowButton(false, templ.Attributes{"hx-post": basePath + "/servers/" + server.Link() + "/install", "hx-swap": "none", "hx-disable": "this", "data-new-install": server.Name}) {
						@kit.RowText("New install command", "The old one stops working")
					}
				}
				// The new command shows here, out of band, until its daemon
				// used it.
				<div id="server-added" class="empty:hidden"></div>
				@kit.List() {
					if view.Integrations.Cloudflare {
						@removeKeyButton(server.ID, "cloudflare", "Remove Cloudflare API token", "Remove the Cloudflare API token? Turn tunnels off first: without the token moin cannot delete them in Cloudflare.")
					}
					if view.Integrations.Tailscale {
						@removeKeyButton(server.ID, "tailscale", "Remove Tailscale auth key", "Remove the Tailscale auth key? The next change of a server's security opens SSH again on every interface.")
					}
					@kit.RowButton(true, templ.Attributes{
						"hx-delete":          basePath + "/servers/" + server.Link(),
						"hx-swap":            "none",
						"hx-disable":         "this",
						"hx-confirm":         ifElse(server.Online, "Remove "+server.Name+"? Remove its apps first. moin disconnects its daemon and its token stops working.", "Remove "+server.Name+" and its apps? It is offline: its apps stay on it with their data if it comes back; remove them there with moin daemon uninstall --apps."),
						"data-confirm-name":  server.Name,
						"data-confirm-action": "Remove server",
						"data-remove-server": server.Name,
					}) {
						<span class="font-medium">Remove server</span>
					}
				}
			</div>
			@kit.Live("/api/v1/servers/events?workspace=" + ctxkeys.Workspace(ctx).Link())
			@securityScript()
		}
	}
}

// securityState is the switches and what the daemon set up. The page
// reloads it when the server changes, unless a switch waits for Apply.
templ securityState(view SecurityView, securityPath string) {
	{{ report := service.SecurityReport(view.Server) }}
	<div id="security-state" class="flex flex-col gap-6" hx-get={ securityPath } hx-trigger="security-changed from:body" hx-select="#security-state" hx-swap="outerHTML">
		<form class="flex flex-col gap-3" hx-post={ securityPath } hx-target="#server-security" hx-select="#server-security" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-security-form>
			@kit.CSRF()
			// What the page showed: Apply changes only the switches flipped here
			// and keeps what changed elsewhere meanwhile.
			<input type="hidden" name="was_tunnel" value={ onValue(view.Server.Tunnel) }/>
			<input type="hidden" name="was_ssh_tailscale" value={ onValue(view.Server.SSHTailscale) }/>
			<input type="hidden" name="was_firewall" value={ onValue(view.Server.Firewall) }/>
			@kit.Section("Access", nil) {
				@kit.List() {
					@securityToggle("tunnel", "Cloudflare Tunnel", "Ports 80 and 443 close, Cloudflare serves HTTPS", view.Server.Tunnel, !view.Integrations.Cloudflare, "Needs a Cloudflare API token, below")
					@securityToggle("ssh_tailscale", "SSH only on Tailscale", "SSH answers only on your tailnet", view.Server.SSHTailscale, !view.Integrations.Tailscale, "Needs a Tailscale auth key, below")
					@securityToggle("firewall", "Firewall", "Drops every connection the server does not need", view.Server.Firewall, false, "")
				}
			}
			<div class="flex justify-end">
				@kit.Button(kit.Primary, "", templ.Attributes{"type": "submit"}) {
					Apply
				}
			</div>
		</form>
		if report != nil {
			@kit.Section("What the daemon set up", nil) {
				<div data-security-report>
					@kit.List() {
						@securityFact("Traffic", "", proxyText(report.Proxy))
						@securityFact("Open to everyone", portsNote(report.Firewall), portsText(*report, view.Server.SSHTailscale))
						@securityFact("Tailnet", tailnetNote(report.TailscaleIP, view.Integrations.Tailscale, view.Server.SSHTailscale), tailnetText(report.TailscaleIP, view.Integrations.Tailscale, view.Server.SSHTailscale))
						for _, problem := range report.Problems {
							@kit.Row("") {
								<div class="min-w-0 flex-1 text-sm text-running">{ problem }</div>
							}
						}
					}
				</div>
			}
		}
	</div>
}

// securityFact is a row of what the daemon set up: the name and a note
// left, the value right.
templ securityFact(name, note, value string) {
	@kit.RowFact(name, note) {
		<span class="font-mono">{ value }</span>
	}
}

// securityToggle is one switch of Access. A switch whose key is missing
// cannot be turned on and says what it needs.
templ securityToggle(name, title, note string, on, locked bool, lockedNote string) {
	{{ id := "security-" + strings.ReplaceAll(name, "_", "-") }}
	@kit.RowControl(nil) {
		@kit.RowLabel(id, title, ifElse(locked && !on, lockedNote, note))
		@kit.Switch(templ.Attributes{"id": id, "name": name, "value": "1", "checked": on, "disabled": locked && !on, "data-toggle": name})
	}
}

// securityKeys are the Cloudflare token and the Tailscale key, for every
// server of the workspace. The fields only add or replace a key; a stored
// key is removed at the end of the page.
templ securityKeys(view SecurityView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@kit.Card("Keys for every server", nil) {
		<form class="flex flex-col gap-4" hx-post={ basePath + "/integrations" } hx-target="#server-security" hx-select="#server-security" hx-swap="outerHTML" hx-disable="find button[type='submit']" hx-vals={ templ.JSONString(map[string]string{"server": view.Server.ID}) } data-integrations-form>
			@kit.CSRF()
			@keyField("cloudflare-token", "cloudflare_token", "Cloudflare API token", "Tunnel Edit, DNS Edit", view.Integrations.Cloudflare, "Stored for account "+view.Integrations.CloudflareAccount, "Tunnel Edit and DNS Edit; Zone Settings Edit for Always Use HTTPS")
			@keyField("tailscale-key", "tailscale_key", "Tailscale auth key", "tskey-auth-…", view.Integrations.Tailscale, "Stored", "A reusable auth key")
			<div class="flex justify-end">
				@kit.Button(kit.Secondary, "", templ.Attributes{"type": "submit"}) {
					Save keys
				}
			</div>
		</form>
	}
}

templ keyField(id, name, label, placeholder string, stored bool, storedText, help string) {
	@kit.Field(label, id, ifElse(stored, "✓ "+storedText, help)) {
		@kit.Input(templ.Attributes{"id": id, "name": name, "type": "password", "placeholder": ifElse(stored, "Paste a new one to replace it", placeholder), "autocomplete": "off"})
	}
}

// securityScriptOnce puts the script on the page once.
var securityScriptOnce = templ.NewOnceHandle()

// securityScript reloads the switches and the report when the server
// changes, like the servers page, but not while a flipped switch waits for
// Apply or the server is being removed.
templ securityScript() {
	@securityScriptOnce.Once() {
		<script nonce={ templ.GetNonce(ctx) }>
			(() => {
				if (window.moinSecurity) return;
				window.moinSecurity = true;
				const waiting = () => {
					if (document.querySelector("[data-remove-server]:disabled")) return true;
					const form = document.querySelector("[data-security-form]");
					if (!form) return false;
					return [...form.querySelectorAll("input[type=checkbox][name]")].some((box) => {
						const was = form.querySelector(`input[name="was_${box.name}"]`);
						return was && box.checked !== (was.value === "1");
					});
				};
				document.addEventListener("servers", () => {
					if (document.querySelector("[data-security-form]") && !waiting()) document.body.dispatchEvent(new Event("security-changed"));
				});
			})();
		</script>
	}
}

// removeKeyButton takes one stored key away; the fields only add or replace.
templ removeKeyButton(server, key, label, question string) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@kit.RowButton(true, templ.Attributes{
		"hx-post":         basePath + "/integrations",
		"hx-vals":         `{"server":"` + server + `","remove":"` + key + `"}`,
		"hx-target":       "#server-security",
		"hx-select":       "#server-security",
		"hx-swap":         "outerHTML",
		"hx-disable":      "this",
		"hx-confirm":      question,
		"data-remove-key": key,
	}) {
		<span class="font-medium">{ label }</span>
	}
}

func proxyText(proxy string) string {
	if proxy == "tunnel" {
		return "Cloudflare Tunnel"
	}
	return "Ports 80, 443"
}

func onValue(on bool) string {
	if on {
		return "1"
	}
	return "0"
}

// portsText is what is open to everyone. Without the firewall it is what
// moin itself listens on; any other service on the server is open too.
func portsText(report protocol.ServerConfigResult, sshOnTailscale bool) string {
	ports := report.OpenPorts
	if !report.Firewall {
		ports = nil
		if !sshOnTailscale || report.TailscaleIP == "" {
			ports = append(ports, "22/tcp")
		}
		if report.Proxy != "tunnel" {
			ports = append(ports, "80/tcp", "443/tcp")
		}
	}
	if len(ports) == 0 {
		return "nothing"
	}
	return strings.Join(ports, ", ")
}

func portsNote(firewall bool) string {
	if firewall {
		return "Everything else is dropped."
	}
	return "Firewall off: every other listening port too."
}

// tailnetText and tailnetNote say where the server stands on the tailnet.
// The daemon joins it only for SSH on Tailscale.
func tailnetText(ip string, key, sshOnTailscale bool) string {
	switch {
	case ip != "":
		return ip
	case key && sshOnTailscale:
		return "not up"
	case key:
		return "not used"
	}
	return "not joined"
}

func tailnetNote(ip string, key, sshOnTailscale bool) string {
	switch {
	case ip != "":
		return "The server's IP on your tailnet."
	case key && sshOnTailscale:
		return "The server could not join your tailnet yet."
	case key:
		return "Turn on SSH only on Tailscale: the server then joins your tailnet."
	}
	return "Add a Tailscale auth key below: the server joins your tailnet, then SSH can answer only there."
}

// serverRules shows /etc/moin/rules of the server as the daemon reported it.
// Only the owner of the server changes them, on the server.
templ serverRules(server model.Server) {
	{{ rules := service.ServerRules(server) }}
	@kit.Section("Rules", nil) {
		<div data-rules-panel>
			if len(rules.Lines()) == 0 {
				@kit.List() {
					@kit.Row("") {
						<div class="min-w-0 flex-1">
							<div class="font-medium">None</div>
							<div class="text-sm text-muted-foreground">moin may do everything here. Write <code class="font-mono text-foreground">/etc/moin/rules</code> on the server to limit it.</div>
						</div>
					}
				}
			} else {
				@kit.Card("", nil) {
					<pre class="overflow-x-auto font-mono text-sm leading-relaxed" data-rules>{ strings.Join(rules.Lines(), "\n") }</pre>
					@kit.Quiet() {
						From <code class="font-mono">/etc/moin/rules</code> on the server. The daemon refuses the rest.
					}
				}
			}
		</div>
	}
}
