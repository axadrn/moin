package pages

import (
	"slices"
	"strings"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
	"github.com/axadrn/moin/internal/build"
	"github.com/axadrn/moin/protocol"
)

// SecurityView is the security page of a server.
type SecurityView struct {
	Server       model.Server
	Integrations service.Integrations
}

// ServerSecurity is the page of one server: how it is reached in three
// lines, its rules, its name, a new install command, and removing it at
// the end.
templ ServerSecurity(view SecurityView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ server := view.Server }}
	{{ securityPath := basePath + "/servers/" + server.Link() + "/security" }}
	@layouts.App(server.Name + " security") {
		@panelPage(templ.Attributes{"data-server-security": server.Name}) {
			@serverHead(server, "security")
			<div id="server-security" class="moin-stack" data-gap="6">
				@securityState(view, securityPath)
				@serverRules(server)
				@components.Card(components.CardProps{Title: "Name"}) {
					<form
						hx-post={ basePath + "/servers/" + server.Link() + "/name" }
						hx-target="#main"
						hx-select="#main"
						hx-swap="outerHTML"
						hx-disable="find button[type='submit']"
						data-rename-server
					>
						@components.CSRF()
						<label for="server-rename" class="moin-sr-only">Server name</label>
						<div class="moin-row" data-gap="2" data-phone="stack">
							@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "server-rename", "name": "name", "type": "text", "value": server.Name, "maxlength": "63", "autocomplete": "off", "spellcheck": "false"}})
							@components.Button(components.ButtonProps{Type: "submit"}) {
								Save
							}
						</div>
					</form>
				}
				@components.Card(components.CardProps{}) {
					@components.List() {
						if server.Online && daemonOutdated(server) {
							@components.Item(components.ItemProps{Button: true, Name: "Update daemon", Note: server.DaemonVersion + " → " + build.Version, Attrs: templ.Attributes{"hx-post": basePath + "/servers/" + server.Link() + "/update", "hx-swap": "none", "hx-disable": "this", "data-update-daemon": server.Name}})
						}
						@components.Item(components.ItemProps{Button: true, Name: "New install command", Note: "The old one stops working", Attrs: templ.Attributes{"hx-post": basePath + "/servers/" + server.Link() + "/install", "hx-swap": "none", "hx-disable": "this", "data-new-install": server.Name}})
					}
				}
				// The new command shows here, out of band, until its daemon
				// used it.
				<div id="server-added" class="moin-hide-empty"></div>
				@components.Card(components.CardProps{}) {
					@components.List() {
						@components.Item(components.ItemProps{Button: true, Danger: true, Name: "Remove server", Attrs: templ.Attributes{
							"hx-delete":           basePath + "/servers/" + server.Link(),
							"hx-swap":             "none",
							"hx-disable":          "this",
							"hx-confirm":          ifElse(server.Online, "Remove "+server.Name+"? Remove its apps first. moin disconnects its daemon and its token stops working.", "Remove "+server.Name+" and its apps? It is offline: its apps stay on it with their data if it comes back; remove them there with moin daemon uninstall --apps."),
							"data-confirm-name":   server.Name,
							"data-confirm-action": "Remove server",
							"data-remove-server":  server.Name,
						}})
					}
				}
				@idLine(server.ID)
			</div>
			@components.Live(components.LiveProps{URL: "/api/v1/servers/events?workspace=" + ctxkeys.Workspace(ctx).Link()})
		}
	}
}

// securityState is the three lines: Web (who reaches the apps), SSH
// (who logs in) and the firewall. Each shows what really is on the server, with a
// dot, and saves itself. It reloads when the server changes. SSH and the
// firewall always work. The tunnel needs Cloudflare and SSH only through
// Tailscale needs Tailscale: without them, the line links to Integrations.
templ securityState(view SecurityView, securityPath string) {
	{{ server := view.Server }}
	{{ report := service.SecurityReport(server) }}
	{{ tailscale := slices.ContainsFunc(view.Integrations.Tailscale.On, func(on service.SecretOn) bool { return on.Server == server.Name }) || (report != nil && report.TailscaleIP != "") }}
	{{ web, ssh, firewall := webLine(server, report), sshLine(server, report), firewallLine(server, report) }}
	<div id="security-state" hx-get={ securityPath } hx-trigger="servers from:body" hx-select="#security-state" hx-swap="outerHTML">
		@components.Card(components.CardProps{}) {
			@components.List() {
				@securityChoice(securityPath, "tunnel", web, ifElse(server.Tunnel, "on", "off"), ifElse(view.Integrations.Cloudflare || server.Tunnel, "", "Connect Cloudflare"), ifElse(server.Tunnel,
					"Open ports 80 and 443 again? moin deletes the tunnel and its DNS records. Point your domains back at the server.",
					"Send visitors through Cloudflare? Ports 80 and 443 close. Cloudflare serves HTTPS."), []components.Option{
					{Value: "off", Label: "Open", Attrs: templ.Attributes{"id": "security-tunnel-off"}},
					{Value: "on", Label: "Cloudflare Tunnel", Attrs: templ.Attributes{"id": "security-tunnel-on", "disabled": !view.Integrations.Cloudflare && !server.Tunnel}},
				})
				@securityChoice(securityPath, "ssh", ssh, server.SSH, ifElse(tailscale, "", "Add a Tailscale key"),
					"Change who reaches SSH on "+server.Name+"? Keep another way in, like your provider's console.", []components.Option{
						{Value: protocol.SSHEveryone, Label: "Everyone", Attrs: templ.Attributes{"id": "security-ssh-everyone"}},
						{Value: protocol.SSHTailscale, Label: "Only through Tailscale", Attrs: templ.Attributes{"id": "security-ssh-tailscale", "disabled": !tailscale && server.SSH != protocol.SSHTailscale}},
						{Value: protocol.SSHOff, Label: "Off", Attrs: templ.Attributes{"id": "security-ssh-off"}},
					})
				@securitySwitch(securityPath, "firewall", firewall, server.Firewall, ifElse(server.Firewall,
					"Turn off the firewall? Every port that listens is open again.",
					"Turn on the firewall? It drops every connection the server does not need."))
				for _, line := range []securityLine{web, ssh, firewall} {
					if line.Problem != "" {
						@components.Item(components.ItemProps{Attrs: templ.Attributes{"data-security-problem": true}}) {
							<div class="moin-fill moin-text moin-failed">{ line.Problem }</div>
						}
					}
				}
				if report != nil {
					for _, problem := range report.Problems {
						@components.Item(components.ItemProps{Attrs: templ.Attributes{"data-security-problem": true}}) {
							<div class="moin-fill moin-text moin-failed">{ problem }</div>
						}
					}
				}
			}
		}
	</div>
}

// securityLine is one line of the Security page: its name, the dot, a
// short note of what is on the server, the sentence of what it is, and
// the problem when the server is not as set.
type securityLine struct {
	Name    string
	State   components.State
	Note    string
	Hint    string
	Problem string
}

// truth is the line for what is (is) against what is set (want): green
// when they match and it is locked down (locked), quiet when they match
// and it is open, red when they differ, with a sentence under the lines
// that says both, waiting before the daemon reported.
func truth(name, hint, is, want string, known, locked bool) securityLine {
	line := securityLine{Name: name, Hint: hint, State: components.StateIdle}
	switch {
	case !known:
		line.State, line.Note = components.StateWaiting, "Waiting for the server"
	case is != want:
		line.State = components.StateFailed
		line.Problem = name + " on the server is " + is + ". " + build.Name + " says " + want + ". Pick the one you want."
	case locked:
		line.State = components.StateLive
	}
	return line
}

// The sentence under each line: what it is in plain words, then the
// technical part in brackets.
const (
	webHint      = "How visitors reach your apps (ports 80 and 443, or a Cloudflare Tunnel)."
	sshHint      = "Who can log in to the server with SSH (port 22)."
	firewallHint = "Blocks every port " + build.Name + " does not need (nftables, the firewall built into Linux)."
)

func webLine(server model.Server, report *protocol.ServerConfigResult) securityLine {
	words := func(tunnel bool) string { return ifElse(tunnel, "Cloudflare Tunnel", "Open") }
	is := false
	if report != nil {
		is = report.Proxy == "tunnel"
	}
	return truth("Web", webHint, words(is), words(server.Tunnel), report != nil, is)
}

func sshLine(server model.Server, report *protocol.ServerConfigResult) securityLine {
	if report == nil {
		return truth("SSH", sshHint, "", sshWords(server.SSH), false, false)
	}
	line := truth("SSH", sshHint, sshWords(report.SSH), sshWords(server.SSH), true, report.SSH != protocol.SSHEveryone)
	if report.SSH == protocol.SSHTailscale && line.Problem == "" {
		line.Note = "Tailnet address: " + report.TailscaleIP
	}
	return line
}

func firewallLine(server model.Server, report *protocol.ServerConfigResult) securityLine {
	words := func(on bool) string { return ifElse(on, "On", "Off") }
	is := report != nil && report.Firewall
	line := truth("Firewall", firewallHint, words(is), words(server.Firewall), report != nil, is)
	if is && line.Problem == "" {
		line.Note = "Open to everyone: " + report.OpenText()
	}
	return line
}

// sshWords says who SSH answers.
func sshWords(ssh string) string {
	switch ssh {
	case protocol.SSHTailscale:
		return "Only through Tailscale"
	case protocol.SSHOff:
		return "Off"
	}
	return "Everyone"
}

func lineDot(line securityLine) templ.Component {
	return components.Dot(components.DotProps{State: line.State})
}

// connectLink is the short link of a line whose option needs an account
// first: it opens Settings, Integrations.
templ connectLink(words string) {
	<a href={ templ.SafeURL(ctxkeys.AppBasePath(ctx) + "/integrations") } class="moin-link moin-small" data-connect>{ words }</a>
}

// securitySwitch is a line with a switch that saves itself after one
// question: the firewall.
templ securitySwitch(securityPath, set string, line securityLine, on bool, question string) {
	{{ id := "security-" + set }}
	{{ attrs := securityForm(securityPath, set, question) }}
	{{ attrs["hx-disable"] = "find input[type='checkbox']" }}
	@components.Item(components.ItemProps{Form: true, For: id, Lead: lineDot(line), Name: line.Name, Note: line.Note, Hint: line.Hint, Attrs: attrs}) {
		@components.CSRF()
		<input type="hidden" name="set" value={ set }/>
		@components.Switch(components.SwitchProps{ID: id, Name: "on", Value: "1", Checked: on})
	}
}

// securityChoice is a line with one of a few options, saved after one
// question: Web (open or a Cloudflare Tunnel) and SSH (everyone, only
// through Tailscale or off). An option that needs an account first can't
// be picked yet, and connect is the short link to Integrations for it.
templ securityChoice(securityPath, set string, line securityLine, checked, connect, question string, options []components.Option) {
	@components.Item(components.ItemProps{Form: true, For: "security-" + set + "-" + checked, Lead: lineDot(line), Name: line.Name, Note: line.Note, Hint: line.Hint, Attrs: securityForm(securityPath, set, question)}) {
		@components.CSRF()
		<input type="hidden" name="set" value={ set }/>
		if connect != "" {
			@connectLink(connect)
		}
		@components.Choice(components.ChoiceProps{Name: set, Label: line.Name, Checked: checked, Options: options})
	}
}

// securityForm makes a line the form that posts its control when it
// changes, after the question, and answers the three lines as stored.
func securityForm(securityPath, set, question string) templ.Attributes {
	return templ.Attributes{
		"hx-post":             securityPath,
		"hx-trigger":          "change",
		"hx-target":           "#security-state",
		"hx-select":           "#security-state",
		"hx-swap":             "outerHTML",
		"hx-confirm":          question,
		"data-confirm-action": "Change",
		"data-security-line":  set,
	}
}

// serverRules shows /etc/moin/rules of the server as the daemon reported it.
// Only the owner of the server changes them, on the server.
templ serverRules(server model.Server) {
	{{ rules := service.ServerRules(server) }}
	<section class="moin-section">
		<div class="moin-section-head">
			<h2>Rules</h2>
		</div>
		<div data-rules-panel>
			if len(rules.Lines()) == 0 {
				@components.Card(components.CardProps{}) {
					@components.List() {
						@components.Item(components.ItemProps{}) {
							<div class="moin-fill">
								<div class="moin-strong">None</div>
								<div class="moin-small moin-muted">moin may do everything here. Edit <code class="moin-mono moin-foreground">/etc/moin/rules</code> on the server to limit it.</div>
							</div>
						}
					}
				}
			} else {
				@components.Card(components.CardProps{}) {
					<pre class="moin-mono moin-text moin-scroll" data-rules>{ strings.Join(rules.Lines(), "\n") }</pre>
					<p class="moin-small moin-muted">
						From <code class="moin-mono">/etc/moin/rules</code> on the server. The daemon refuses the rest.
					</p>
				}
			}
		</div>
	</section>
}
