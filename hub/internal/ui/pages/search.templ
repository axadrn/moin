package pages

import (
	"slices"
	"strconv"
	"strings"

	"github.com/axadrn/moin/internal/find"

	"github.com/axadrn/moin/hub/internal/catalog"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
)

// SearchItem is one answer of the palette: a page to go to, or something to
// do. Where is the way to it, shown small under the title like a path
// ("my-app › Settings"); the palette matches the title and where together.
type SearchItem struct {
	Group string
	Title string
	Where string
	// Key is the key that does the same without the palette.
	Key  string
	Icon string
	Href string
	// External opens Href in a new tab, like the app's own site.
	External bool
	// Post makes the item an action. Confirm, with Accept, asks first; it
	// is empty for what is harmless (DESIGN.md, Asking first).
	Post    string
	Confirm string
	Accept  string
}

// ID is what the palette remembers an item by, for Recent.
func (item SearchItem) ID() string {
	if item.Post != "" {
		return "post " + item.Post
	}
	return item.Href
}

// SearchDoc is a page of the docs the palette can open.
type SearchDoc struct {
	Title string
	Group string
	Href  string
}

// SearchInput is what the palette knows about the workspace.
type SearchInput struct {
	Base string
	// Here is the app the page is about, for "On this page".
	Here      string
	Apps      []model.App
	Servers   []model.Server
	Buckets   []service.Bucket
	Docs      []SearchDoc
	Catalog   []catalog.Entry
	CanChange bool
	IsOwner   bool
	GitHub    bool
}

// The groups of the palette, in the order it shows them.
const (
	groupHere    = "On this page"
	groupRecent  = "Recent"
	groupApps    = "Apps"
	groupServers = "Servers"
	groupPages   = "Pages"
	groupActions = "Actions"
	groupCatalog = "Catalog"
	groupDocs    = "Docs"
)

// SearchItems is everything the palette can find: every page that has its
// own address, every app and server, what you can do with them, and the
// docs.
func SearchItems(in SearchInput) []SearchItem {
	items := []SearchItem{}
	for _, app := range in.Apps {
		items = append(items, SearchItem{Group: groupApps, Title: app.Name, Where: app.ServerName, Icon: "app", Href: in.Base + "/apps/" + app.Link()})
	}
	for _, server := range in.Servers {
		path := in.Base + "/servers/" + server.Link()
		items = append(items,
			SearchItem{Group: groupServers, Title: server.Name, Where: "Servers", Icon: "server", Href: path + "/security"},
			SearchItem{Group: groupPages, Title: "Security", Where: server.Name, Icon: "shield", Href: path + "/security"},
			SearchItem{Group: groupPages, Title: "Metrics", Where: server.Name, Icon: "activity", Href: path + "/metrics"},
		)
	}
	for _, app := range in.Apps {
		path := in.Base + "/apps/" + app.Link()
		for _, section := range appSections[1:] {
			items = append(items, SearchItem{Group: groupPages, Title: section.Label, Where: app.Name, Key: strings.ToUpper(section.Key), Icon: sectionIcon(section.ID), Href: path + section.Path})
		}
		items = append(items, SearchItem{Group: groupPages, Title: "Metrics", Where: app.Name, Icon: "activity", Href: path + "/metrics"})
	}
	places := []SearchItem{
		{Title: "Overview", Key: "G H", Icon: "gauge", Href: in.Base + "/overview"},
		{Title: "Apps", Key: "G A", Icon: "apps", Href: in.Base + "/apps"},
		{Title: "New app", Where: "Apps", Icon: "plus", Href: in.Base + "/new-app"},
		{Title: "Catalog", Where: "Apps › New app", Icon: "catalog", Href: in.Base + "/catalog"},
		{Title: "Servers", Key: "G S", Icon: "server", Href: in.Base + "/servers"},
		{Title: "Settings", Key: "G ,", Icon: "settings", Href: in.Base + "/settings"},
		{Title: "Team", Where: "Settings", Key: "G T", Icon: "users", Href: in.Base + "/workspace"},
		{Title: "Alerts", Where: "Settings", Key: "G L", Icon: "bell", Href: in.Base + "/alerts"},
		{Title: "Bucket", Where: "Settings", Key: "G B", Icon: "bucket", Href: in.Base + "/bucket"},
		{Title: "Activity", Where: "Settings", Key: "G Y", Icon: "activity", Href: in.Base + "/activity"},
		{Title: "Account", Where: "Settings", Icon: "user", Href: in.Base + "/settings/account"},
		{Title: "Security", Where: "Settings › Account", Icon: "shield", Href: in.Base + "/settings/account?tab=security"},
		{Title: "Tokens", Where: "Settings › Account", Icon: "key", Href: in.Base + "/settings/account?tab=tokens"},
	}
	if in.GitHub {
		places = append(places, SearchItem{Title: "GitHub", Where: "Settings", Icon: "git-hub", Href: in.Base + "/settings/github"})
	}
	if in.IsOwner {
		places = append(places, SearchItem{Title: "Billing", Where: "Settings", Icon: "card", Href: in.Base + "/billing"})
	}
	for _, place := range places {
		place.Group = groupPages
		items = append(items, place)
	}
	for _, app := range in.Apps {
		items = append(items, paletteActions(in, app)...)
	}
	// The catalog: an app you can install, on its page in the workspace.
	for _, entry := range in.Catalog {
		items = append(items, SearchItem{Group: groupCatalog, Title: entry.Name, Where: "Catalog › " + entry.Category, Icon: "package", Href: in.Base + "/catalog/" + entry.Slug})
	}
	for _, doc := range in.Docs {
		items = append(items, SearchItem{Group: groupDocs, Title: doc.Title, Where: "Docs › " + doc.Group, Icon: "book", Href: doc.Href})
	}
	return items
}

// paletteActions are what you can do with an app from anywhere. Harmless
// ones run at once; rolling back asks first (DESIGN.md, Asking first).
// Switches and values are not here: the palette cannot show what they are
// now, so they stay on their pages.
func paletteActions(in SearchInput, app model.App) []SearchItem {
	path := in.Base + "/apps/" + app.Link()
	var items []SearchItem
	for _, domain := range appDomains(app) {
		items = append(items, SearchItem{Group: groupActions, Title: "Open " + domain, Where: app.Name, Icon: "external", Href: "https://" + domain, External: true})
		break
	}
	if !in.CanChange {
		return items
	}
	if app.Stopped {
		return append(items, SearchItem{Group: groupActions, Title: "Start " + app.Name, Where: app.Name, Icon: "play", Post: path + "/start"})
	}
	if app.LatestNumber > 0 {
		items = append(items, SearchItem{Group: groupActions, Title: "Deploy " + app.Name, Where: app.Name, Icon: "deploy", Post: path + "/redeploy"})
	}
	if app.LiveNumber > 0 {
		items = append(items, SearchItem{Group: groupActions, Title: "Restart " + app.Name, Where: app.Name, Icon: "restart", Post: path + "/restart"})
	}
	if app.LiveNumber > 1 {
		items = append(items, SearchItem{Group: groupActions, Title: "Roll back " + app.Name, Where: app.Name + " › to v" + strconv.Itoa(app.LiveNumber-1), Icon: "undo", Post: path + "/rollback", Confirm: "Roll back " + app.Name + " to v" + strconv.Itoa(app.LiveNumber-1) + "? It runs that deploy again.", Accept: "Roll back"})
	}
	return items
}

func sectionIcon(id string) string {
	switch id {
	case "deploys":
		return "deploy"
	case "domains":
		return "globe"
	case "logs":
		return "logs"
	case "data":
		return "database"
	}
	return "settings"
}

// HereItems are what goes with the page you are on: the sections and the
// actions of its app, first when nothing is typed.
func HereItems(in SearchInput) []SearchItem {
	for _, app := range in.Apps {
		if app.Name != in.Here {
			continue
		}
		var items []SearchItem
		for _, item := range SearchItems(SearchInput{Base: in.Base, Apps: []model.App{app}, CanChange: in.CanChange}) {
			if item.Group == groupPages || item.Group == groupActions {
				item.Group = groupHere
				items = append(items, item)
			}
		}
		return items
	}
	return nil
}

// MatchSearch is the palette's answer to query, in the order of the
// terminal UI's (find.Rank and find.Start). Typed, it is every item that
// matches, the best first, those picked often and lately (recent, the IDs
// best first) lifted, grouped in the order of their best answer, the docs
// last and at most three of them. Not typed, it is what goes with this
// page (here), the five latest picks, then the apps and the places.
func MatchSearch(items []SearchItem, here []SearchItem, recent []string, query string, limit int) []SearchItem {
	if strings.TrimSpace(query) == "" {
		byID := map[string]SearchItem{}
		for _, item := range items {
			if _, ok := byID[item.ID()]; !ok {
				byID[item.ID()] = item
			}
		}
		var picks []SearchItem
		for _, id := range recent {
			if item, ok := byID[id]; ok && len(picks) < 5 {
				item.Group = groupRecent
				picks = append(picks, item)
			}
		}
		var basics []SearchItem
		for _, item := range items {
			if item.Group == groupApps || (item.Group == groupPages && item.Where == "") {
				basics = append(basics, item)
			}
		}
		out := find.Start(here, picks, basics, SearchItem.ID)
		return out[:min(len(out), limit+len(here))]
	}
	text := func(item SearchItem) string { return item.Title + " " + item.Where }
	picked := func(item SearchItem) int { return slices.Index(recent, item.ID()) }
	hits := find.Rank(query, items, text, picked)
	var order []string
	byGroup := map[string][]SearchItem{}
	docs := 0
	for _, h := range hits {
		if h.Item.Group == groupDocs {
			if docs == 3 {
				continue
			}
			docs++
		}
		if _, ok := byGroup[h.Item.Group]; !ok && h.Item.Group != groupDocs {
			order = append(order, h.Item.Group)
		}
		byGroup[h.Item.Group] = append(byGroup[h.Item.Group], h.Item)
	}
	order = append(order, groupDocs)
	out := []SearchItem{}
	for _, group := range order {
		for _, item := range byGroup[group] {
			if len(out) < limit || group == groupDocs {
				out = append(out, item)
			}
		}
	}
	return out
}

// SearchResults is the list of the palette. The first answer is picked, so
// Enter opens it. Only the picked answer is lit; the mouse picks too (hub.js).
templ SearchResults(items []SearchItem, query string) {
	if len(items) == 0 {
		<p class="moin-empty moin-text moin-muted">Nothing found for “{ query }”.</p>
	}
	for i, item := range items {
		if i == 0 || items[i-1].Group != item.Group {
			<div class="moin-palette-group" role="presentation">{ item.Group }</div>
		}
		if item.Post != "" {
			@components.PaletteAction(components.PaletteActionProps{ID: "search-" + strconv.Itoa(i), Selected: i == 0, Attrs: searchActionAttrs(item)}) {
				@searchOption(item)
			}
		} else {
			<a
				id={ "search-" + strconv.Itoa(i) }
				role="option"
				aria-selected={ strconv.FormatBool(i == 0) }
				href={ templ.SafeURL(item.Href) }
				if item.External {
					target="_blank"
					rel="noopener"
				}
				class="moin-option"
				data-pick={ item.ID() }
			>
				@searchOption(item)
			</a>
		}
	}
}

// searchOption is one answer: its icon, its title with where it is under
// it, and its key.
templ searchOption(item SearchItem) {
	<span class="moin-bubble" data-tile>
		@components.Icon(item.Icon)
	</span>
	<span class="moin-fill moin-stack" style="--gap:0">
		<span class="moin-truncate moin-strong">{ item.Title }</span>
		if item.Where != "" {
			<span class="moin-truncate moin-small moin-muted">{ item.Where }</span>
		}
	</span>
	if item.Key != "" {
		<kbd class="moin-kbd">{ item.Key }</kbd>
	}
}

// searchActionAttrs is what an answer that does something sends.
func searchActionAttrs(item SearchItem) templ.Attributes {
	attrs := templ.Attributes{"hx-post": item.Post, "hx-swap": "none", "data-pick": item.ID()}
	if item.Confirm != "" {
		attrs["hx-confirm"] = item.Confirm
		attrs["data-confirm-action"] = item.Accept
	}
	return attrs
}
