package pages

import (
	"github.com/axadrn/moin/hub/internal/brand"
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// DeviceView is the page where `moin login` is approved in the browser.
// Without a pending login it asks for the code.
type DeviceView struct {
	// Code is the code as the terminal shows it, ABCD-EFGH.
	Code string
	// CodeError says why the code was not taken.
	CodeError string
	// Login is the pending login of Code, nil until a valid code is in.
	Login *model.DeviceLogin
	// Workspaces are the user's workspaces the computer can be let into.
	Workspaces  []WorkspaceChoice
	WorkspaceID string
	// WorkspaceError says why the workspace was not taken.
	WorkspaceError string
	// Rights are the switches as they are, the default ones at first.
	Rights model.Rights
	// Passkey: Allow asks for the passkey. Without one, Fresh says the
	// sign-in is new enough to allow; else Allow signs in again first.
	Passkey bool
	Fresh   bool
	// Passkeys says this hub offers passkeys, to suggest one.
	Passkeys bool
	// AllowError says why Allow did not work.
	AllowError string
}

// WorkspaceChoice is one workspace to pick.
type WorkspaceChoice struct {
	ID   string
	Name string
}

// workspaceOptions are the workspaces to pick from.
func (v DeviceView) workspaceOptions() []components.Option {
	options := make([]components.Option, 0, len(v.Workspaces))
	for _, workspace := range v.Workspaces {
		options = append(options, components.Option{Value: workspace.ID, Label: workspace.Name})
	}
	return options
}

// deviceClientName is the name of the connection a login makes, as the
// computer gave it.
func deviceClientName(login *model.DeviceLogin) string {
	if login == nil {
		return service.DeviceClientName("")
	}
	return service.DeviceClientName(login.Hostname)
}

// Device asks for the code of `moin login`, or, with a pending login,
// whether to connect the computer and with which rights. The computer's
// name is its own word, so it shows in quotes.
templ Device(view DeviceView) {
	if view.Login == nil {
		@authScreen(deviceSEO, "Connect the CLI") {
			<form id="device-code-form" action="/device" method="GET" class="moin-stack" data-gap="4">
				@formField("Code", "code", "Enter the code your terminal shows.", view.CodeError) {
					@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "code", "name": "code", "type": "text", "value": view.Code, "placeholder": "ABCD-EFGH", "aria-invalid": ariaInvalid(view.CodeError), "aria-describedby": "code-hint", "autocomplete": "off", "autocapitalize": "characters", "spellcheck": "false", "maxlength": "16", "autofocus": true, "required": true}})
				}
				@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit"}) {
					Continue
				}
			</form>
		}
	} else {
		@authScreen(deviceSEO, "Connect \u201c"+deviceClientName(view.Login)+"\u201d?") {
			<form id="device-approve-form" action="/device/approve" method="POST" class="moin-stack" data-gap="4">
				@components.CSRF()
				<input type="hidden" name="code" value={ view.Code }/>
				if view.Passkey {
					<input type="hidden" name="passkey" value=""/>
				}
				@components.Card(components.CardProps{}) {
					<div class="moin-stack moin-center" data-gap="2">
						<p class="moin-number moin-mono" data-device-code>{ view.Code }</p>
						<p class="moin-text moin-muted">Allow only if your terminal shows this code.</p>
					</div>
				}
				@components.Card(components.CardProps{}) {
					@components.List() {
						@factRow("You", ctxkeys.User(ctx).Email)
						if len(view.Workspaces) == 1 {
							@factRow("Workspace", view.Workspaces[0].Name)
						}
					}
				}
				if len(view.Workspaces) > 1 {
					@formField("Workspace", "device-workspace", "", view.WorkspaceError) {
						@components.Select(components.SelectProps{ID: "device-workspace", Name: "workspace_id", Label: "Workspace", Options: view.workspaceOptions(), Value: view.WorkspaceID})
					}
				} else {
					<input type="hidden" name="workspace_id" value={ view.WorkspaceID }/>
					if view.WorkspaceError != "" {
						<p class="moin-message" data-state="failed" role="alert">{ view.WorkspaceError }</p>
					}
				}
				@components.Card(components.CardProps{Title: "Rights"}) {
					@components.List() {
						@rightsFields("device-right", view.Rights)
					}
				}
				<p class="moin-message" data-state="failed" role="alert" data-passkey-error hidden?={ view.AllowError == "" }>{ view.AllowError }</p>
				switch  {
					case view.Passkey:
						@components.Button(components.ButtonProps{Kind: components.Primary, Attrs: templ.Attributes{"type": "button", "data-passkey": "confirm", "data-passkey-url": "/device/passkey"}}) {
							Allow with passkey
						}
					case view.Fresh:
						@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit"}) {
							Allow
						}
					default:
						@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit", Attrs: templ.Attributes{"formaction": "/device/reauth", "formnovalidate": true}}) {
							Sign in again to allow
						}
				}
				if !view.Passkey && view.Passkeys {
					<p class="moin-small moin-muted moin-center">Add a passkey to approve faster.</p>
				}
				@components.Button(components.ButtonProps{Type: "submit", Attrs: templ.Attributes{"formaction": "/device/deny", "formnovalidate": true}}) {
					Cancel
				}
			</form>
			if view.Passkey {
				@passkeyScript()
			}
		}
	}
}

// DeviceDone says what became of the login: approved or denied.
templ DeviceDone(login *model.DeviceLogin, approved bool) {
	if approved {
		@authScreen(deviceSEO, "Connected") {
			@authLine() {
				{ deviceClientName(login) } is connected. Go back to your terminal.
			}
			@authLink("/app") {
				{ "Open " + brand.Name }
			}
		}
	} else {
		@authScreen(deviceSEO, "Not connected") {
			@authLine() {
				Nothing got access.
			}
			@authLink("/app") {
				{ "Open " + brand.Name }
			}
		}
	}
}

var deviceSEO = layouts.SEOProps{Title: "Connect the CLI", Description: "Approve a login of the " + brand.Name + " CLI"}
