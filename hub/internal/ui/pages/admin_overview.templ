package pages

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"

	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// AdminOverview is Admin, for whoever runs moin: the numbers at a glance,
// the way to the operator activity and the old domain, and the users, each
// a row that opens its own page with what an operator can do to it.
templ AdminOverview(data *model.AdminOverview) {
	@layouts.Admin("Admin") {
		@panelPage() {
			@components.Header(components.HeaderProps{Title: "Admin"})
			@adminNumbers([]adminNumber{
				{"Users", data.Metrics.Users},
				{"Verified", data.Metrics.VerifiedUsers},
				{"Workspaces", data.Metrics.Workspaces},
				{"Paid", data.Metrics.PaidWorkspaces},
				{"Sessions", data.Metrics.ActiveSessions},
			})
			if n := data.Network; n != nil {
				<section class="moin-section">
					<div class="moin-section-head">
						<h2>Network</h2>
					</div>
					@adminNumbers([]adminNumber{
						{"Deploys", n.Deploys},
						{"Apps", n.Apps},
						{"Servers", n.Servers},
						{"Hosted", n.HostedWorkspaces},
						{"Self-hosted", n.SelfHosted},
					})
				</section>
			}
			@components.List() {
				@components.Item(components.ItemProps{Href: "/admin/activity", Name: "Activity"})
				@components.Item(components.ItemProps{Button: true, Name: "Apply open offers", Attrs: templ.Attributes{
					"hx-post":             "/admin/offers/claim",
					"hx-swap":             "none",
					"hx-disable":          "this",
					"hx-confirm":          "Apply every open offer to the account with that address?",
					"data-confirm-name":   "offers",
					"data-confirm-action": "Apply offers",
				}})
				@components.Item(components.ItemProps{Href: "/admin/old-domain", Name: "Old domain"})
			}
			@adminUsers(data.Users)
		}
	}
}

// adminUsers is the search and one page of users, newest first.
templ adminUsers(users model.AdminUserPage) {
	<section class="moin-section">
		<div class="moin-section-head">
			<h2>Users</h2>
			@adminCount(plural(users.TotalUsers, "user", "users"))
		</div>
		<form method="GET" action="/admin" role="search">
			<div class="moin-row" data-gap="2" data-phone="stack">
				<label for="admin-search" class="moin-sr-only">Name or email</label>
				@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "admin-search", "name": "q", "type": "search", "value": users.Query, "placeholder": "Name or email", "autocomplete": "off", "spellcheck": "false", "data-hotkey-focus": true}})
				@components.Button(components.ButtonProps{Type: "submit"}) {
					Search
				}
			</div>
		</form>
		@components.List() {
			for _, user := range users.Users {
				@components.Item(components.ItemProps{Href: "/admin/users/" + user.ID, Name: adminUserName(user), Note: adminUserNote(user), Value: adminUserValue(user)})
			}
			if len(users.Users) == 0 {
				@components.Item(components.ItemProps{Name: adminNoUsers(users.Query)})
			}
		}
		if users.TotalPages > 1 {
			<div class="moin-row" data-between data-gap="3">
				<span class="moin-text moin-muted moin-digits">{ fmt.Sprintf("Page %d of %d", users.Page, users.TotalPages) }</span>
				<div class="moin-row" data-gap="2">
					if users.Page > 1 {
						@components.Button(components.ButtonProps{Href: adminPageURL(users.Query, users.Page-1)}) {
							Newer
						}
					}
					if users.TotalPages > users.Page {
						@components.Button(components.ButtonProps{Href: adminPageURL(users.Query, users.Page+1)}) {
							Older
						}
					}
				</div>
			</div>
		}
	</section>
}

// AdminActivity is what operators did, newest first.
templ AdminActivity(events []model.AdminActivityEvent) {
	@layouts.Admin("Activity · Admin") {
		@panelPage() {
			@components.Header(components.HeaderProps{Back: components.Back{Label: "Admin", Href: "/admin"}, Title: "Activity"})
			@components.List() {
				for _, event := range events {
					@components.Item(components.ItemProps{Href: adminEventHref(event), Name: model.AdminActivityActionLabel(event.Action), Note: adminEventNote(event)}) {
						<time datetime={ event.CreatedAt.UTC().Format("2006-01-02T15:04:05Z") } title={ event.CreatedAt.UTC().Format("2006-01-02 15:04:05 UTC") } class="moin-text moin-muted moin-digits">
							{ event.CreatedAt.UTC().Format("Jan 2, 15:04:05") }
						</time>
					}
				}
				if len(events) == 0 {
					@components.Item(components.ItemProps{Name: "No operator activity yet"})
				}
			}
			<p class="moin-small moin-muted">
				{ fmt.Sprintf("Kept %d days, in UTC.", int(model.AdminActivityRetention.Hours()/24)) }
			</p>
		}
	}
}

// adminNumber is one count of adminNumbers.
type adminNumber struct {
	Label string
	Value int
}

// adminNumbers are counts side by side on one card: the word, the number
// under it. Three in a row on a phone, all in one row from sm.
templ adminNumbers(numbers []adminNumber) {
	@components.Card(components.CardProps{}) {
		<dl class="moin-grid" data-fit style="--min:5rem">
			for _, number := range numbers {
				<div class="moin-stack" data-gap="1">
					<dt class="moin-text moin-muted moin-truncate">{ number.Label }</dt>
					<dd class="moin-number">{ strconv.Itoa(number.Value) }</dd>
				</div>
			}
		</dl>
	}
}

// adminCount is the quiet count at the end of a section title.
templ adminCount(text string) {
	<span class="moin-text moin-muted moin-digits">{ text }</span>
}

func adminPageURL(query string, page int) string {
	values := url.Values{}
	if query != "" {
		values.Set("q", query)
	}
	values.Set("page", strconv.Itoa(page))
	return "/admin?" + values.Encode()
}

// adminUserName is the name of a user, or the email when it has none.
func adminUserName(user model.AdminUser) string {
	if user.Name != "" {
		return user.Name
	}
	return user.Email
}

// adminUserNote is the line under the name: the email, when the name is
// not already it.
func adminUserNote(user model.AdminUser) string {
	if user.Name == "" {
		return ""
	}
	return user.Email
}

// adminUserValue is the one fact at the end of a user's row: an operator,
// an email not confirmed yet, or the plan.
func adminUserValue(user model.AdminUser) string {
	switch {
	case user.IsAdmin:
		return "Operator"
	case user.EmailVerifiedAt == nil:
		return "Unverified"
	case user.Plan != "":
		return adminPlanLabel(user)
	}
	return ""
}

func adminNoUsers(query string) string {
	if query == "" {
		return "No users yet"
	}
	return "No user matches “" + query + "”"
}

// adminEventNote is who did it and to what.
func adminEventNote(event model.AdminActivityEvent) string {
	actor := event.ActorEmail
	if actor == "" {
		actor = "System"
	}
	return actor + " · " + event.TargetType + " " + event.TargetID
}

// adminEventHref is the page of what an event touched: a user has one.
func adminEventHref(event model.AdminActivityEvent) string {
	if event.TargetType == "user" && event.TargetID != "" {
		return "/admin/users/" + event.TargetID
	}
	return ""
}

// adminPlanLabel is the plan of a user: "Trial until Dec 2, 2026", "Free
// forever", "Paying".
func adminPlanLabel(user model.AdminUser) string {
	if user.Plan == model.AdminPlanTrial && user.TrialEndsAt != nil {
		return "Trial until " + user.TrialEndsAt.Format("Jan 2, 2006")
	}
	if user.Plan == "" {
		return ""
	}
	return strings.ToUpper(user.Plan[:1]) + user.Plan[1:]
}
