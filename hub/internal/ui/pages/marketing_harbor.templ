package pages

// homeHarbor is the still wall of containers under the headline: every
// container is an app, your-app among them in ink. A few stand out of the
// wall; light from the top right gives them shaded sides and a short
// shadow down to the left. Its foot is the foot of the first screen.
templ homeHarbor() {
	<svg
		viewBox={ harborN(harborLeftX) + " " + harborN(harborTopY) + " " + harborN(harborW) + " " + harborN(harborH-harborTopY) }
		preserveAspectRatio="xMidYMax slice"
		class="hub-harbor"
		role="img"
		aria-label="A wall of shipping containers, each an app: postgres, redis, node, python, bun and your-app."
	>
		<defs>
			<clipPath id="harbor-wall">
				for _, b := range harborBoxes {
					if b.Depth == 0 {
						<rect x={ harborN(b.X) } y={ harborN(b.Y) } width={ harborN(harborBoxW) } height={ harborN(harborBoxH) }></rect>
					}
				}
			</clipPath>
			<linearGradient id="harbor-shade" x1="1" y1="0" x2="0" y2="1">
				<stop offset="0" stop-color="#000" class="hub-harbor-shade"></stop>
				<stop offset="1" stop-color="#000" stop-opacity="0"></stop>
			</linearGradient>
		</defs>
		for _, b := range harborBoxes {
			if b.Depth == 0 {
				@harborContainer(b.X, b.Y, b)
			}
		}
		<g clip-path="url(#harbor-wall)" fill="url(#harbor-shade)">
			for _, b := range harborBoxes {
				if b.Depth > 0 {
					<polygon points={ harborShadow(b.X, b.Y, b.Depth) }></polygon>
				}
			}
		</g>
		for _, b := range harborBoxes {
			if b.Depth > 0 {
				@harborSides(b)
				@harborContainer(b.X+b.Depth, b.Y-b.Depth, b)
			}
		}
	</svg>
}

// harborSides are the left and bottom sides of a pulled out container, in
// its own color, shaded.
templ harborSides(b harborCrate) {
	{{ base, over := harborTone(b.Tone) }}
	if b.Ink {
		{{ base, over = "hub-harbor-ink", "" }}
	}
	<polygon points={ harborSideLeft(b.X, b.Y, b.Depth) } class={ base }></polygon>
	if over != "" {
		<polygon points={ harborSideLeft(b.X, b.Y, b.Depth) } class={ over }></polygon>
	}
	<polygon points={ harborSideLeft(b.X, b.Y, b.Depth) } class="hub-harbor-side"></polygon>
	<polygon points={ harborSideBottom(b.X, b.Y, b.Depth) } class={ base }></polygon>
	if over != "" {
		<polygon points={ harborSideBottom(b.X, b.Y, b.Depth) } class={ over }></polygon>
	}
	<polygon points={ harborSideBottom(b.X, b.Y, b.Depth) } class="hub-harbor-foot"></polygon>
}

// harborContainer is one 20-foot container from the side, at x, y: the
// steel face, the markings printed on it (owner code and type code small at
// the top right, the app big at the bottom left), the ribs running through
// the print, and the rails and corner posts around it.
templ harborContainer(x, y int, b harborCrate) {
	{{ base, over := harborTone(b.Tone) }}
	if b.Ink {
		<rect x={ harborN(x) } y={ harborN(y) } width={ harborN(harborBoxW) } height={ harborN(harborBoxH) } class="hub-harbor-ink"></rect>
	} else {
		<rect x={ harborN(x) } y={ harborN(y) } width={ harborN(harborBoxW) } height={ harborN(harborBoxH) } class={ base }></rect>
		if over != "" {
			<rect x={ harborN(x) } y={ harborN(y) } width={ harborN(harborBoxW) } height={ harborN(harborBoxH) } class={ over }></rect>
		}
	}
	if b.Ref != "" {
		<g class={ templ.KV("hub-harbor-on-ink", b.Ink), templ.KV("hub-harbor-on-steel", !b.Ink) }>
			<text x={ harborN(x + harborBoxW - 10) } y={ harborN(y + 20) } text-anchor="end" class="hub-harbor-owner">{ b.Code } 1</text>
			<text x={ harborN(x + harborBoxW - 10) } y={ harborN(y + 34) } text-anchor="end" class="hub-harbor-type">22G1</text>
			<text x={ harborN(x + 10) } y={ harborN(y + harborBoxH - 14) } class="hub-harbor-app" data-ink?={ b.Ink }>{ b.Ref }</text>
		</g>
	}
	<g class={ templ.KV("hub-harbor-rib-ink", b.Ink), templ.KV("hub-harbor-rib", !b.Ink) }>
		for _, r := range harborRibs(x) {
			<rect x={ harborN(r) } y={ harborN(y + 4) } width="3" height={ harborN(harborBoxH - 8) }></rect>
		}
	</g>
	<g class={ templ.KV("hub-harbor-rail-ink", b.Ink), templ.KV("hub-harbor-rail", !b.Ink) }>
		<rect x={ harborN(x) } y={ harborN(y) } width={ harborN(harborBoxW) } height="5"></rect>
		<rect x={ harborN(x) } y={ harborN(y + harborBoxH - 5) } width={ harborN(harborBoxW) } height="5"></rect>
		<rect x={ harborN(x) } y={ harborN(y) } width="4" height={ harborN(harborBoxH) }></rect>
		<rect x={ harborN(x + harborBoxW - 4) } y={ harborN(y) } width="4" height={ harborN(harborBoxH) }></rect>
	</g>
}
