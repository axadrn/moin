package pages

import (
	"github.com/axadrn/moin/hub/internal/brand"
	"github.com/axadrn/moin/hub/internal/ui/kit"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// VerifyEmailSuccess says the new address is in, and goes on to the app
// by itself after a moment.
templ VerifyEmailSuccess() {
	@authScreen(layouts.SEOProps{Title: "Email changed", Description: "Your email has been changed"}, "Email changed") {
		<script nonce={ templ.GetNonce(ctx) }>
			setTimeout(() => { window.location.href = "/app"; }, 3000);
		</script>
		@authStack() {
			@kit.Button(kit.Primary, "/app", nil) {
				{ "Open " + brand.Name }
			}
		}
	}
}

// VerifyEmailError says why the link to the new address did not work.
templ VerifyEmailError(errorMessage string) {
	@authScreen(layouts.SEOProps{Title: "Link not valid", Description: "Email verification failed"}, "Link not valid") {
		@authLine() {
			{ errorMessage }
		}
		@authStack() {
			@kit.Button(kit.Primary, "/auth", nil) {
				Sign in
			}
		}
	}
}
