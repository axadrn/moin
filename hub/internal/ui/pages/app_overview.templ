package pages

import (
	"fmt"
	"strconv"
	"strings"
	"time"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// OverviewView is the workspace at a glance: what needs you, your pinned
// apps and the ones deployed last. The full lists are /apps and /servers.
type OverviewView struct {
	Status  service.WorkspaceStatus
	Servers []model.Server
	Pinned  []model.App
	Recent  []model.App
	Apps    int
}

// Overview answers before it asks: "Everything runs." or what needs you.
// Then what matters to you, and the way to everything else.
templ Overview(view OverviewView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ now := time.Now() }}
	@layouts.App("Overview") {
		@panelPage() {
			@components.Header(components.HeaderProps{Title: overviewHeadline(view), Line: overviewLine(overviewSummary(view.Status))})
			if len(view.Servers) == 0 {
				@overviewStart(basePath)
			} else {
				if !view.Status.OK() {
					<section class="moin-section">
						<div class="moin-section-head">
							<h2>Needs you</h2>
						</div>
						@components.Card(components.CardProps{}) {
							@components.List() {
								for _, issue := range view.Status.Issues {
									@components.Item(components.ItemProps{Href: basePath + issue.Path, Name: issue.Target, Note: issue.Detail, Lead: overviewIssueLead(issue.Kind)})
								}
							}
						}
					</section>
				}
				if len(view.Pinned) > 0 {
					<section class="moin-section">
						<div class="moin-section-head">
							<h2>Pinned</h2>
						</div>
						@appRows(view.Pinned, view.Servers)
					</section>
				}
				if len(view.Recent) > 0 {
					<section class="moin-section">
						<div class="moin-section-head">
							<h2>Deployed last</h2>
						</div>
						@appRows(view.Recent, view.Servers)
					</section>
				}
				if len(view.Status.Updates) > 0 {
					<section class="moin-section">
						<div class="moin-section-head">
							<h2>Updates</h2>
						</div>
						@components.Card(components.CardProps{}) {
							@components.List() {
								for _, update := range view.Status.Updates {
									@components.Item(components.ItemProps{Href: basePath + "/apps/" + update.Link, Name: update.App, Note: update.Name + " " + update.Version + " → " + update.Latest})
								}
							}
						}
					</section>
				}
				@components.Card(components.CardProps{}) {
					@components.List() {
						@components.Item(components.ItemProps{Href: basePath + "/apps", Name: "All apps"}) {
							<span class="moin-muted moin-digits">{ strconv.Itoa(view.Apps) }</span>
						}
						@components.Item(components.ItemProps{Href: basePath + "/servers", Name: "All servers", Note: serversLine(view.Servers, now)}) {
							<span class="moin-muted moin-digits">{ strconv.Itoa(len(view.Servers)) }</span>
						}
					}
				}
			}
		}
	}
}

// appRows are apps as rows of one list: the name, a second line only when
// something is off, and their state mark.
templ appRows(apps []model.App, servers []model.Server) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@components.Card(components.CardProps{}) {
		@components.List() {
			for _, app := range apps {
				@components.Item(components.ItemProps{Href: basePath + "/apps/" + app.Link(), Name: app.Name, Note: appNote(app, serverOnline(servers, app.ServerID))}) {
					@appState(app)
				}
			}
		}
	}
}

// serversLine says the one thing to know about the servers, if any.
func serversLine(servers []model.Server, now time.Time) string {
	offline := 0
	for _, server := range servers {
		if !server.Online {
			offline++
		}
	}
	if offline > 0 {
		return plural(offline, "server", "servers") + " offline"
	}
	return ""
}

// overviewHeadline is the answer to "is everything OK?".
func overviewHeadline(view OverviewView) string {
	switch {
	case len(view.Servers) == 0:
		return "Let's ship your first app."
	case view.Status.OK():
		return "Everything runs."
	case len(view.Status.Issues) == 1:
		return view.Status.Issues[0].Target + " needs you."
	}
	return strconv.Itoa(len(view.Status.Issues)) + " things need you."
}

// overviewSummary is the one line under it.
func overviewSummary(s service.WorkspaceStatus) string {
	parts := []string{plural(s.Apps, "app", "apps"), plural(s.Servers, "server", "servers")}
	switch {
	case s.Databases == 0:
	case s.BackupsChecked == s.Databases:
		parts = append(parts, "every backup checked today")
	default:
		parts = append(parts, strconv.Itoa(s.BackupsChecked)+" of "+plural(s.Databases, "backup", "backups")+" checked today")
	}
	return strings.Join(parts, " · ")
}

// appNote is the second line of an app: only what its state mark does not
// say already.
func appNote(app model.App, serverOnline bool) string {
	switch {
	case !serverOnline:
		return app.ServerName + " is offline"
	case app.LatestStatus == model.DeployFailed && app.LiveNumber > 0 && !app.Stopped:
		return fmt.Sprintf("v%d still runs", app.LiveNumber)
	case app.LatestStatus == model.DeployFailed:
		return "Nothing runs"
	}
	return ""
}

func serverOnline(servers []model.Server, id string) bool {
	for _, server := range servers {
		if server.ID == id {
			return server.Online
		}
	}
	return true
}

// appState is the mark at the end of an app's row: a quiet dot when it
// runs, a word when it does not.
templ appState(app model.App) {
	switch  {
		case app.LatestNumber == 0 || app.Stopped:
			@components.Chip(components.ChipProps{State: components.StateIdle}) {
				{ ifElse(app.Stopped, "Stopped", "New") }
			}
		case app.LatestStatus == model.DeployRunning:
			@components.Chip(components.ChipProps{State: components.StateRunning}) {
				{ fmt.Sprintf("Deploying v%d", app.LatestNumber) }
			}
		case app.LatestStatus == model.DeployFailed:
			@components.Chip(components.ChipProps{State: components.StateFailed}) {
				{ fmt.Sprintf("v%d failed", app.LatestNumber) }
			}
		default:
			@components.Status(components.StatusProps{State: components.StateLive, Attrs: templ.Attributes{"title": "Live", "data-alone": true}}) {
				<span class="moin-sr-only">Live</span>
			}
	}
}

func ifElse(ok bool, yes, no string) string {
	if ok {
		return yes
	}
	return no
}

// overviewNewApp is the action next to the apps: start a new one.
templ overviewNewApp(basePath string) {
	@components.Button(components.ButtonProps{Href: basePath + "/new-app"}) {
		New app
	}
}

// overviewStart is the first visit: no server yet.
templ overviewStart(basePath string) {
	@components.Card(components.CardProps{}) {
		@components.List() {
			@components.Item(components.ItemProps{Href: basePath + "/servers", Name: "Connect your first server", Note: "Any Linux box you own. One command, no open port.", Lead: overviewStartLead()})
		}
	}
}

// overviewStartLead is the icon in front of the first server.
templ overviewStartLead() {
	<span class="moin-bubble" data-ink aria-hidden="true">
		@components.Icon("server")
	</span>
}

// overviewLine is the summary under the title: quiet, it answers nothing.
templ overviewLine(text string) {
	<span class="moin-muted">{ text }</span>
}

// overviewIssueLead is the icon of an issue in its color.
templ overviewIssueLead(kind string) {
	<span class="moin-bubble" style={ overviewIssueTone(kind) } aria-hidden="true">
		@overviewIssueIcon(kind)
	</span>
}

templ overviewIssueIcon(kind string) {
	switch kind {
		case service.IssueServerDown:
			@components.Icon("server-off")
		case service.IssueDeployFailed:
			@components.Icon("failed")
		case service.IssueBackupFailed, service.IssueCheckFailed:
			@components.Icon("shield-off")
		case service.IssueDomainDown:
			@components.Icon("globe")
		case service.IssueDiskFull:
			@components.Icon("disk")
		default:
			@components.Icon("restart")
	}
}

// overviewIssueTone colors an issue: red for what is broken, amber for what
// waits.
func overviewIssueTone(kind string) templ.SafeCSS {
	if kind == service.IssueDaemonBehind {
		return "--tint:var(--running)"
	}
	return ""
}
