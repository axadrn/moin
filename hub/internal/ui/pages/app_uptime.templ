package pages

import (
	"fmt"
	"strconv"
	"time"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
	"github.com/axadrn/moin/internal/human"
)

// UptimeView is the uptime of an app's domains.
type UptimeView struct {
	App    model.App
	Uptime service.AppUptime
	Now    time.Time
}

// AppUptime is the uptime page, one step under the app's domains: per
// domain its state, the uptime over 24 hours, 7 and 30 days, the newest
// visit, the last outages and the settings of its uptime.
templ AppUptime(view UptimeView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Link() }}
	@layouts.App(view.App.Name + " uptime") {
		@panelPage(templ.Attributes{"data-app-uptime": view.App.Name}) {
			@components.Header(components.HeaderProps{Back: components.Back{Label: "Domains", Href: appPath + "/domains"}, Title: "Uptime"})
			<div id="app-uptime" class="moin-stack" data-gap="6">
				@uptimeServerOffline(view)
				if len(view.Uptime.Domains) == 0 {
					@components.Card(components.CardProps{}) {
						<p class="moin-small moin-muted">
							No domain to visit yet.
						</p>
						@components.Command(components.CommandProps{Text: "moin domains add " + view.App.Name + ".example.com"})
					}
				}
				for _, domain := range view.Uptime.Domains {
					@uptimeDomain(view, domain)
				}
			</div>
		}
	}
}

// AppUptimeBody is the uptime of each domain in a row, on the Domains
// section of an app; a row opens the uptime page.
templ AppUptimeBody(view UptimeView) {
	if len(view.Uptime.Domains) > 0 {
		<section class="moin-section">
			<div class="moin-section-head">
				<h2>Uptime</h2>
			</div>
			@uptimeServerOffline(view)
			@components.List() {
				for _, domain := range view.Uptime.Domains {
					@components.Item(components.ItemProps{Href: ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Link() + "/uptime", Name: domain.Domain, Note: uptimeNote(domain)}) {
						@uptimeState(domain)
					}
				}
			}
		</section>
	}
}

// uptimeServerOffline is the line that says the app's server is offline,
// so its uptimes say little.
templ uptimeServerOffline(view UptimeView) {
	if !view.Uptime.ServerOnline && view.App.ServerName != "" {
		<p data-server-offline>
			@components.Status(components.StatusProps{State: components.StateFailed}) {
				{ view.App.ServerName } is offline
			}
		</p>
	}
}

// uptimeDomain is one domain: its numbers and outages, then its uptime.
templ uptimeDomain(view UptimeView, domain service.UptimeDomain) {
	<div data-uptime-domain={ domain.Domain }>
		<section class="moin-section">
			<div class="moin-section-head">
				<h2>{ domain.Domain }</h2>
				@uptimeState(domain)
			</div>
			<div class="moin-stack" data-gap="4">
				@components.List() {
					@uptimeFact("Last 24 hours", orNone(percent(domain.Uptime24h)), averageNote(domain))
					@uptimeFact("Last 7 days", orNone(percent(domain.Uptime7d)), "")
					@uptimeFact("Last 30 days", orNone(percent(domain.Uptime30d)), "")
					@uptimeFact("Last visit", orNone(lastVisit(domain)), lastVisitNote(domain, view.Now))
					@uptimeFact("Certificate", certText(domain, view.Now), certNote(domain))
					if domain.Since != nil {
						@uptimeFact(sinceLabel(domain), sinceText(domain, view.Now), sinceNote(domain))
					}
					if len(domain.Outages) == 0 {
						@uptimeFact("Outages", "None in 90 days", "")
					}
				}
				if len(domain.Outages) > 0 {
					<div data-outages>
						@components.List() {
							for _, outage := range domain.Outages {
								@components.Item(components.ItemProps{Attrs: templ.Attributes{"data-outage": stamp(outage.StartedAt)}}) {
									<div class="moin-fill">
										<div class="moin-strong moin-digits" title={ stamp(outage.StartedAt) }>{ outage.StartedAt.UTC().Format("Jan 2, 15:04 UTC") }</div>
										<div class="moin-small moin-muted">{ outageText(outage, view.Now) }</div>
									</div>
								}
							}
						}
					</div>
				}
				@uptimeSettings(view.App, domain)
			</div>
		</section>
	</div>
}

// uptimeFact is a row with a number on the right and what it means.
templ uptimeFact(label, value, note string) {
	@components.Item(components.ItemProps{Name: label, Note: note, Value: value})
}

// uptimeState is the state of a domain's visit as a status.
templ uptimeState(domain service.UptimeDomain) {
	switch domain.State {
		case model.UptimeUp:
			@components.Status(components.StatusProps{State: components.StateLive, Attrs: templ.Attributes{"data-uptime-state": domain.State}}) {
				Up
			}
		case model.UptimeDown:
			@components.Status(components.StatusProps{State: components.StateFailed, Attrs: templ.Attributes{"data-uptime-state": domain.State}}) {
				Down
			}
		case model.UptimePaused:
			@components.Status(components.StatusProps{State: components.StateIdle, Attrs: templ.Attributes{"data-uptime-state": domain.State}}) {
				Paused
			}
		default:
			@components.Status(components.StatusProps{State: components.StateWaiting, Attrs: templ.Attributes{"data-uptime-state": domain.State}}) {
				Waiting
			}
	}
}

// uptimeSettings is the path of the visit and the switch that pauses it.
templ uptimeSettings(app model.App, domain service.UptimeDomain) {
	{{ action := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Link() + "/uptime/path" }}
	{{ id := "uptime-" + domain.Domain }}
	@components.List() {
		@components.Item(components.ItemProps{Form: true, Attrs: templ.Attributes{"hx-post": action, "hx-target": "#app-uptime", "hx-select": "#app-uptime", "hx-swap": "outerHTML", "hx-disable": "find button[type='submit']", "data-uptime-path-form": domain.Domain}}) {
			@components.CSRF()
			<input type="hidden" name="domain" value={ domain.Domain }/>
			<div class="moin-fill">
				@components.Field(components.FieldProps{Label: "Path", For: id + "-path"}) {
					<div class="moin-row" data-gap="2" data-phone="stack">
						@components.Input(components.InputProps{Attrs: templ.Attributes{"id": id + "-path", "name": "path", "type": "text", "value": customPath(domain), "placeholder": domain.Path, "autocomplete": "off", "autocapitalize": "off", "spellcheck": "false"}})
						@components.Button(components.ButtonProps{Type: "submit"}) {
							Save
						}
					</div>
				}
			</div>
		}
		@UptimeSwitchForm(app, domain)
	}
}

// UptimeSwitchForm is the switch that pauses uptime of a domain, a row
// that saves itself.
templ UptimeSwitchForm(app model.App, domain service.UptimeDomain) {
	{{ id := "uptime-" + domain.Domain }}
	@components.Item(components.ItemProps{Form: true, For: id + "-on", Name: "Visit every minute", Attrs: templ.Attributes{"id": id + "-form", "hx-post": ctxkeys.AppBasePath(ctx) + "/apps/" + app.Link() + "/uptime/on", "hx-trigger": "change", "hx-target": "this", "hx-swap": "outerHTML", "hx-disable": "find input[type='checkbox']"}}) {
		@components.CSRF()
		<input type="hidden" name="domain" value={ domain.Domain }/>
		@components.Switch(components.SwitchProps{Attrs: templ.Attributes{"id": id + "-on", "name": "on", "value": "1", "checked": !domain.Paused}})
	}
}

// uptimeNote is the uptime of a domain in a few words, for its row.
func uptimeNote(domain service.UptimeDomain) string {
	if value := percent(domain.Uptime30d); value != "" {
		return value + " over 30 days"
	}
	return "No visit yet"
}

func orNone(value string) string {
	if value == "" {
		return "None yet"
	}
	return value
}

func sinceLabel(domain service.UptimeDomain) string {
	switch domain.State {
	case model.UptimeUp:
		return "Up since"
	case model.UptimeDown:
		return "Down since"
	}
	return "Since"
}

func customPath(domain service.UptimeDomain) string {
	if domain.CustomPath {
		return domain.Path
	}
	return ""
}

func percent(value *float64) string {
	if value == nil {
		return ""
	}
	if *value == 100 {
		return "100%"
	}
	return strconv.FormatFloat(*value, 'f', 2, 64) + "%"
}

func averageNote(domain service.UptimeDomain) string {
	if domain.Uptime24h == nil {
		return ""
	}
	return fmt.Sprintf("%d ms on average", domain.AverageMS)
}

func lastVisit(domain service.UptimeDomain) string {
	switch {
	case domain.VisitedAt == nil:
		return ""
	case domain.StatusCode == 0:
		return "Failed"
	}
	return fmt.Sprintf("HTTP %d", domain.StatusCode)
}

func lastVisitNote(domain service.UptimeDomain, now time.Time) string {
	if domain.VisitedAt == nil {
		return ""
	}
	note := fmt.Sprintf("%d ms, %s", domain.ResponseMS, human.Ago(*domain.VisitedAt, now))
	if domain.Error != "" {
		note = domain.Error + ", " + human.Ago(*domain.VisitedAt, now)
	}
	return note
}

func certText(domain service.UptimeDomain, now time.Time) string {
	if domain.CertExpiresAt == nil {
		return "Not seen yet"
	}
	days := int(domain.CertExpiresAt.Sub(now).Hours() / 24)
	if days < 0 {
		return "Expired"
	}
	return fmt.Sprintf("Valid for %d days", days)
}

func certNote(domain service.UptimeDomain) string {
	if domain.CertExpiresAt == nil {
		return ""
	}
	return "Until " + domain.CertExpiresAt.UTC().Format("Jan 2, 2006")
}

func sinceText(domain service.UptimeDomain, now time.Time) string {
	if domain.Since == nil {
		return "Not yet"
	}
	return human.Ago(*domain.Since, now)
}

func sinceNote(domain service.UptimeDomain) string {
	if domain.Since == nil {
		return ""
	}
	return stamp(*domain.Since)
}

// outageText is how long an outage lasted, and why.
func outageText(outage model.UptimeOutage, now time.Time) string {
	end := now
	length := "ongoing for "
	if outage.EndedAt != nil {
		end, length = *outage.EndedAt, "down for "
	}
	text := length + human.Duration(end.Sub(outage.StartedAt))
	if outage.Reason != "" {
		text += " · " + outage.Reason
	}
	return text
}
