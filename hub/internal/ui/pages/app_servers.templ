package pages

import (
	"time"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/kit"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
	"github.com/axadrn/moin/internal/build"
	"github.com/axadrn/moin/internal/human"
)

// AddedServer is the one-time install command of a server just added.
type AddedServer struct {
	ID      string
	Name    string
	Command string
}

// RemovedServer is a server just removed and the command that removes its
// daemon on the machine.
type RemovedServer struct {
	Name    string
	Command string
}

// Servers is every server of the workspace, live: the list, adding one,
// and whether daemons update by themselves.
templ Servers(servers []model.Server, canAdd bool, removed *RemovedServer, autoUpdate bool) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@layouts.App("Servers") {
		@panelPage() {
			@kit.Header(kit.Back{Label: "Overview", Href: basePath + "/overview"}, "Servers")
			<div id="server-added" class="empty:hidden">
				if removed != nil {
					@serverRemoved(*removed)
				}
			</div>
			@ServerList(servers)
			if canAdd {
				@kit.Card("Add a server", nil) {
					@ServerAddForm()
				}
			}
			@kit.Section("Daemons", nil) {
				@kit.List() {
					@DaemonUpdatesForm(autoUpdate)
				}
			}
			@kit.Live("/api/v1/servers/events?workspace=" + ctxkeys.Workspace(ctx).Slug)
		}
	}
}

// ServerAddForm is the add form. A request replaces it to reset it after the
// server was added; a wrong name keeps it as it is (DESIGN.md, Feedback).
templ ServerAddForm() {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<form
		id="server-add-form"
		hx-swap-oob="true"
		hx-post={ basePath + "/servers" }
		hx-swap="none"
		hx-disable="find button[type='submit']"
	>
		@kit.CSRF()
		<label for="server-name" class="sr-only">Server name</label>
		@kit.Inline() {
			@kit.Input(templ.Attributes{"id": "server-name", "name": "name", "type": "text", "placeholder": "Name, or empty for a made-up one", "maxlength": "63", "autocomplete": "off", "spellcheck": "false", "data-hotkey-focus": true})
			@kit.Button(kit.Primary, "", templ.Attributes{"type": "submit"}) {
				Add server
			}
		}
	</form>
}

// ServerAdded shows the install command of the server just added. It stays
// until the server's daemon connects: on every change of the servers it asks
// (ServerInstall), and the answer replaces it with ServerConnected.
templ ServerAdded(added AddedServer) {
	<div
		id="server-added"
		hx-swap-oob="true"
		hx-get={ ctxkeys.AppBasePath(ctx) + "/servers/" + added.ID + "/install" }
		hx-trigger="servers from:body"
		hx-swap="outerHTML"
		data-server-added={ added.Name }
	>
		@kit.Card("Install the daemon on "+added.Name, nil) {
			@kit.Quiet() {
				Run it on the server as root. It works once, for an hour.
			}
			<div data-install-command>
				@kit.Command(added.Command)
			</div>
			@kit.Status(kit.StateWaiting, nil) {
				Waiting for the daemon
			}
		}
	</div>
}

// ServerConnected takes the place of the install command once the daemon of
// the server just added has connected.
templ ServerConnected(name string) {
	<div id="server-added" data-server-greeting={ name }>
		@kit.List() {
			@kit.Row(ctxkeys.AppBasePath(ctx) + "/apps/new") {
				@kit.Dot(kit.StateLive)
				@kit.RowText(name+" is online", "Deploy an app to it")
			}
		}
	</div>
}

// ServerGone empties the place of the install command when its server was
// removed meanwhile.
templ ServerGone() {
	<div id="server-added" class="empty:hidden"></div>
}

// serverRemoved tells that the daemon of a server just removed is still
// installed, with the command that removes it there.
templ serverRemoved(removed RemovedServer) {
	<div data-server-removed={ removed.Name }>
		@kit.Card(removed.Name+" is removed", nil) {
			@kit.Quiet() {
				Run this on the server as root to remove its daemon. Its apps keep running; --apps removes them too.
			}
			@kit.Command(removed.Command)
		}
	</div>
}

// ServerList is the list of servers. The page reloads it on every change the
// server event stream reports.
templ ServerList(servers []model.Server) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ now := time.Now() }}
	<div
		id="server-list"
		hx-swap-oob="true"
		hx-get={ basePath + "/servers/list" }
		hx-trigger="servers from:body"
		hx-swap="none"
	>
		@kit.List() {
			if len(servers) == 0 {
				@kit.Row("") {
					@kit.RowText("No servers yet", "Add one, then run its install command on it.")
				}
			}
			for _, server := range servers {
				@kit.Row(basePath + "/servers/" + server.ID + "/security") {
					@kit.RowText(server.Name, serverNote(server, now))
					@serverState(server)
				}
			}
		}
	</div>
}

// serverNote is the second line of a server: only what needs saying.
func serverNote(server model.Server, now time.Time) string {
	switch {
	case server.LastSeenAt == nil:
		return "Its daemon never connected"
	case !server.Online:
		return "Last seen " + serverLastSeen(server, now)
	case daemonOutdated(server):
		return "Its daemon updates to " + build.Version + " by itself"
	}
	return ""
}

// serverState is the mark at the end of a server's row: a dot while it is
// online, a word when it is not.
templ serverState(server model.Server) {
	switch  {
		case server.Online:
			<span class="flex size-8 shrink-0 items-center justify-center" title="Online">
				@kit.Dot(kit.StateLive)
				<span class="sr-only">Online</span>
			</span>
		case server.LastSeenAt == nil:
			@kit.Chip(kit.StateWaiting) {
				Waiting
			}
		default:
			@kit.Chip(kit.StateFailed) {
				Offline
			}
	}
}

// serverStatus is the chip next to a server's name on its pages.
templ serverStatus(server model.Server) {
	switch  {
		case server.Online:
			@kit.Chip(kit.StateLive) {
				Online
			}
		case server.LastSeenAt == nil:
			@kit.Chip(kit.StateWaiting) {
				Waiting
			}
		default:
			@kit.Chip(kit.StateFailed) {
				Offline
			}
	}
}

// serverHead is the head of a server's pages: the way back to Servers, its
// name and status, and its two pages.
templ serverHead(server model.Server, active string) {
	{{ serverPath := ctxkeys.AppBasePath(ctx) + "/servers/" + server.ID }}
	@kit.Header(kit.Back{Label: "Servers", Href: ctxkeys.AppBasePath(ctx) + "/servers"}, server.Name) {
		@serverStatus(server)
	}
	@kit.Segmented("server-sections", "Server", []kit.Segment{
		{Label: "Security", Href: serverPath + "/security", Active: active == "security"},
		{Label: "Metrics", Href: serverPath + "/metrics", Active: active == "metrics"},
	})
}

// daemonOutdated reports whether the daemon runs another version than the
// hub. Development builds never count.
func daemonOutdated(server model.Server) bool {
	return build.Version != "dev" && server.DaemonVersion != "" && server.DaemonVersion != build.Version
}

func serverLastSeen(server model.Server, now time.Time) string {
	if server.Online {
		return "now"
	}
	if server.LastSeenAt == nil {
		return "never"
	}
	return human.Ago(*server.LastSeenAt, now)
}
