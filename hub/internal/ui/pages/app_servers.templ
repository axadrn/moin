package pages

import (
	"time"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
	"github.com/axadrn/moin/internal/build"
	"github.com/axadrn/moin/internal/human"
)

// AddedServer is the one-time install command of a server just added.
type AddedServer struct {
	ID      string
	Name    string
	Command string
}

// RemovedServer is a server just removed and the command that removes its
// daemon on the machine.
type RemovedServer struct {
	Name    string
	Command string
}

// Servers is every server of the workspace, live: the list, adding one,
// and whether daemons update by themselves.
templ Servers(servers []model.Server, canAdd bool, removed *RemovedServer, autoUpdate bool, suggestion string) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@layouts.App("Servers") {
		@panelPage() {
			@components.Header(components.HeaderProps{Back: components.Back{Label: "Overview", Href: basePath + "/overview"}, Title: "Servers"})
			<div id="server-added" class="moin-hide-empty">
				if removed != nil {
					@serverRemoved(*removed)
				}
			</div>
			@ServerList(servers)
			if canAdd {
				@components.Card(components.CardProps{Title: "Add a server"}) {
					@ServerAddForm(suggestion)
				}
			}
			<section class="moin-section">
				<div class="moin-section-head">
					<h2>Daemons</h2>
				</div>
				@components.Card(components.CardProps{}) {
					@components.List() {
						@DaemonUpdatesForm(autoUpdate)
					}
				}
			</section>
			@components.Live(components.LiveProps{URL: "/api/v1/servers/events?workspace=" + ctxkeys.Workspace(ctx).Link()})
		}
	}
}

// ServerAddForm is the add form, its name filled in with the next free
// web-N. A request replaces it to reset it after the
// server was added; a wrong name keeps it as it is (DESIGN.md, Feedback).
templ ServerAddForm(suggestion string) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<form
		id="server-add-form"
		hx-swap-oob="true"
		hx-post={ basePath + "/servers" }
		hx-swap="none"
		hx-disable="find button[type='submit']"
	>
		@components.CSRF()
		<label for="server-name" class="moin-sr-only">Server name</label>
		<div class="moin-row" data-gap="2" data-phone="stack">
			@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "server-name", "name": "name", "type": "text", "value": suggestion, "placeholder": "Name, like web-1", "maxlength": "63", "autocomplete": "off", "spellcheck": "false", "data-hotkey-focus": true}})
			@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit"}) {
				Add server
			}
		</div>
	</form>
}

// ServerAdded shows the install command of the server just added. It stays
// until the server's daemon connects: on every change of the servers it asks
// (ServerInstall), and the answer replaces it with ServerConnected.
templ ServerAdded(added AddedServer) {
	<div
		id="server-added"
		hx-swap-oob="true"
		hx-get={ ctxkeys.AppBasePath(ctx) + "/servers/" + added.Name + "/install" }
		hx-trigger="servers from:body"
		hx-swap="outerHTML"
		data-server-added={ added.Name }
	>
		@components.Card(components.CardProps{Title: "Install the daemon on " + added.Name}) {
			<p class="moin-small moin-muted">
				Run it on the server as root. It works once, for an hour.
			</p>
			<div data-install-command>
				@components.Command(components.CommandProps{Text: added.Command})
			</div>
			@components.Status(components.StatusProps{State: components.StateWaiting}) {
				Waiting for the daemon
			}
		}
	</div>
}

// ServerConnected takes the place of the install command once the daemon of
// the server just added has connected.
templ ServerConnected(name string) {
	<div id="server-added" data-server-greeting={ name }>
		@components.Card(components.CardProps{}) {
			@components.List() {
				@components.Item(components.ItemProps{Href: ctxkeys.AppBasePath(ctx) + "/new-app", Name: name + " is online", Note: "Deploy an app to it", Lead: components.Dot(components.DotProps{State: components.StateLive})})
			}
		}
	</div>
}

// ServerGone empties the place of the install command when its server was
// removed meanwhile.
templ ServerGone() {
	<div id="server-added" class="moin-hide-empty"></div>
}

// serverRemoved tells that the daemon of a server just removed is still
// installed, with the command that removes it there.
templ serverRemoved(removed RemovedServer) {
	<div data-server-removed={ removed.Name }>
		@components.Card(components.CardProps{Title: removed.Name + " is removed"}) {
			<p class="moin-small moin-muted">
				Run this on the server as root to remove its daemon. Its apps keep running; --apps removes them too.
			</p>
			@components.Command(components.CommandProps{Text: removed.Command})
		}
	</div>
}

// ServerList is the list of servers. The page reloads it on every change the
// server event stream reports.
templ ServerList(servers []model.Server) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ now := time.Now() }}
	<div
		id="server-list"
		hx-swap-oob="true"
		hx-get={ basePath + "/server-list" }
		hx-trigger="servers from:body"
		hx-swap="none"
	>
		@components.Card(components.CardProps{}) {
			@components.List() {
				if len(servers) == 0 {
					@components.Item(components.ItemProps{Name: "No servers yet", Note: "Add one, then run its install command on it."})
				}
				for _, server := range servers {
					@components.Item(components.ItemProps{Href: basePath + "/servers/" + server.Link() + "/security", Name: server.Name, Note: serverNote(server, now)}) {
						@serverState(server)
					}
				}
			}
		}
	</div>
}

// serverNote is the second line of a server: only what needs saying.
func serverNote(server model.Server, now time.Time) string {
	switch {
	case server.LastSeenAt == nil:
		return "Its daemon never connected"
	case !server.Online:
		return "Last seen " + serverLastSeen(server, now)
	case daemonOutdated(server):
		return "Its daemon updates to " + build.Version + " by itself"
	}
	return ""
}

// serverState is the mark at the end of a server's row: a dot while it is
// online, a word when it is not.
templ serverState(server model.Server) {
	switch  {
		case server.Online:
			@components.Status(components.StatusProps{State: components.StateLive, Attrs: templ.Attributes{"title": "Online", "data-alone": true}}) {
				<span class="moin-sr-only">Online</span>
			}
		case server.LastSeenAt == nil:
			@components.Chip(components.ChipProps{State: components.StateWaiting}) {
				Waiting
			}
		default:
			@components.Chip(components.ChipProps{State: components.StateFailed}) {
				Offline
			}
	}
}

// serverStatus is the chip next to a server's name on its pages.
templ serverStatus(server model.Server) {
	switch  {
		case server.Online:
			@components.Chip(components.ChipProps{State: components.StateLive}) {
				Online
			}
		case server.LastSeenAt == nil:
			@components.Chip(components.ChipProps{State: components.StateWaiting}) {
				Waiting
			}
		default:
			@components.Chip(components.ChipProps{State: components.StateFailed}) {
				Offline
			}
	}
}

// serverHead is the head of a server's pages: the way back to Servers, its
// name and status, and its two pages.
templ serverHead(server model.Server, active string) {
	{{ serverPath := ctxkeys.AppBasePath(ctx) + "/servers/" + server.Link() }}
	@components.Header(components.HeaderProps{Back: components.Back{Label: "Servers", Href: ctxkeys.AppBasePath(ctx) + "/servers"}, Title: server.Name}) {
		@serverStatus(server)
	}
	@components.Tabs(components.TabsProps{ID: "server-sections", Label: "Server", Tabs: []components.Tab{
		{Label: "Security", Href: serverPath + "/security", Active: active == "security"},
		{Label: "Metrics", Href: serverPath + "/metrics", Active: active == "metrics"},
	}})
}

// daemonOutdated reports whether the daemon runs another version than the
// hub. Development builds never count.
func daemonOutdated(server model.Server) bool {
	return build.Version != "dev" && server.DaemonVersion != "" && server.DaemonVersion != build.Version
}

func serverLastSeen(server model.Server, now time.Time) string {
	if server.Online {
		return "now"
	}
	if server.LastSeenAt == nil {
		return "never"
	}
	return human.Ago(*server.LastSeenAt, now)
}
