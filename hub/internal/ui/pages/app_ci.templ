package pages

import (
	"cmp"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/ui/components"
)

// appCI is the "Deploy from CI" card of the Deploys section. One line on
// top says what runs; under it deploying an image by hand, and the deploy
// hook CI calls. running is the live deploy's image, empty when it was
// built from the repo; live says a deploy is live at all. hookImage is the
// image the hook deploys new tags of.
templ appCI(appName, appLink, running string, live, hook bool, hookImage string) {
	<div data-app-ci>
		@components.Card(components.CardProps{Title: "Deploy from CI"}) {
			<div class="moin-stack" data-gap="6">
				<p class="moin-text" data-running>
					<span class="moin-muted">Running</span>
					if running != "" {
						<code class="moin-mono">{ running }</code>
					} else if live {
						built from the repo
					} else {
						nothing yet
					}
				</p>
				<form
					class="moin-stack"
					data-gap="3"
					hx-post={ ctxkeys.AppBasePath(ctx) + "/apps/" + appLink + "/image" }
					hx-swap="none"
					hx-disable="find button[type='submit']"
				>
					@components.CSRF()
					<p class="moin-text moin-strong">By hand</p>
					@components.Field(components.FieldProps{For: "image-ref"}) {
						<div class="moin-row" data-gap="2" data-phone="stack">
							@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "image-ref", "name": "image", "type": "text", "aria-label": "Image", "placeholder": cmp.Or(running, "ghcr.io/me/"+appName+":3f2a9c1"), "autocomplete": "off", "autocapitalize": "off", "spellcheck": "false", "required": true}})
							@components.Button(components.ButtonProps{Type: "submit", Attrs: templ.Attributes{"data-deploy-image": true}}) {
								Deploy
							}
						</div>
					}
				</form>
				@AppHook(appName, appLink, "", hookImage, hook)
			</div>
		}
	</div>
}

// AppHook is the deploy hook: on or off, the image it deploys new tags of,
// the one running now; and a new hook's URL once, in a box of its own.
templ AppHook(appName, appLink, url, image string, on bool) {
	<div id="app-hook" class="moin-stack" data-gap="3" data-hook-on?={ on }>
		<div class="moin-row" data-wrap data-between data-gap="3">
			<div class="moin-stack" data-gap="1">
				<div class="moin-row" data-gap="2">
					<p class="moin-text moin-strong">Deploy hook</p>
					if on {
						@components.Status(components.StatusProps{State: components.StateLive}) {
							On
						}
					} else {
						@components.Status(components.StatusProps{State: components.StateIdle}) {
							Off
						}
					}
				</div>
				<p class="moin-small moin-muted" data-hook-image>
					if image != "" {
						New tags of <code class="moin-mono moin-foreground">{ image }</code>.
					} else if on {
						Waits for an image. Deploy one by hand.
					} else {
						Lets CI deploy new tags of the running image.
					}
				</p>
			</div>
			<div class="moin-row" data-gap="2">
				if on {
					@components.Button(components.ButtonProps{Quiet: true, Attrs: templ.Attributes{
						"hx-delete":     ctxkeys.AppBasePath(ctx) + "/apps/" + appLink + "/hook",
						"hx-target":     "#app-hook",
						"hx-swap":       "outerHTML",
						"hx-disable":    "this",
						"hx-confirm":    "Turn off the deploy hook? Its URL stops working and CI can no longer deploy " + appName + ".",
						"data-hook-off": true,
					}}) {
						Turn off
					}
				}
				@newHookButton(appLink, on)
			</div>
		</div>
		if url != "" {
			<div class="moin-alert moin-stack" data-gap="3" data-state="running" data-deploy-hook>
				<p class="moin-text moin-strong">Your new deploy hook. Shown once.</p>
				@components.Command(components.CommandProps{Text: url})
				<p class="moin-small" data-hook-secret>
					Keep it secret, like a password. <a href="/docs/guides/ci" class="moin-link moin-foreground">How CI calls it</a>
				</p>
			</div>
		}
	</div>
}

// newHookButton makes a new deploy hook URL. It asks first only when it
// replaces a hook, whose URL then stops working.
templ newHookButton(appLink string, replaces bool) {
	{{
		attributes := templ.Attributes{
			"hx-post":       ctxkeys.AppBasePath(ctx) + "/apps/" + appLink + "/hook",
			"hx-target":     "#app-hook",
			"hx-swap":       "outerHTML",
			"hx-disable":    "this",
			"data-new-hook": true,
		}
		if replaces {
			attributes["hx-confirm"] = "Create a new deploy hook? The old URL stops working."
		}
	}}
	@components.Button(components.ButtonProps{Attrs: attributes}) {
		New hook
	}
}
