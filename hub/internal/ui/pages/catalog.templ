package pages

import (
	"github.com/axadrn/moin/hub/internal/ui/components"
	"strconv"
	"time"

	"github.com/axadrn/moin/hub/internal/brand"
	"github.com/axadrn/moin/hub/internal/catalog"
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// The catalog is one page in two frames: on the site (/catalog) and in a
// workspace (<workspace>/catalog). Both have the same search, category,
// order and rows, and the page of one app the same head, links and
// versions; only the way back and the one action differ.

// ---------------------------------------------------------------- public

// Catalog is the public catalog: open source apps to run on your own
// server.
templ Catalog(view CatalogView) {
	@layouts.Home(layouts.SEOProps{
		Title:       "Self-host open source apps on your own server",
		Description: "Umami, n8n, Grafana, Nextcloud, Vaultwarden and more on your own server in one click. Every version, updates with a backup first.",
		Path:        "/catalog",
	}) {
		<main class="moin-page moin-content">
			@components.Header(components.HeaderProps{Title: "Catalog"})
			@catalogBody(view)
		</main>
	}
}

// CatalogApp is the public page of one catalog app: what it is, the way
// to deploy it, its links and its versions.
templ CatalogApp(view CatalogEntryView, appURL string) {
	@layouts.Home(layouts.SEOProps{
		Title:       "Self-host " + view.Entry.Name + " on your own server",
		Description: view.Entry.Name + ": " + view.Entry.Pitch + " Install it on your own server in one click, with its database backed up to your bucket.",
		Path:        "/catalog/" + view.Entry.Slug,
	}) {
		@templ.Raw(catalogJSONLD(view, appURL+"/catalog/"+view.Entry.Slug))
		<main class="moin-page moin-content">
			@catalogHead(components.Back{Label: "Catalog", Href: "/catalog"}, view.Entry)
			if note := view.Entry.DatabaseNote(); note != "" {
				<p class="moin-small moin-muted">
					<span data-catalog-database-note>{ note }</span>
				</p>
			}
			<div>
				@components.Button(components.ButtonProps{Kind: components.Primary, Href: "/catalog/" + view.Entry.Slug + "/install", Attrs: templ.Attributes{"data-catalog-install": true}}) {
					Deploy with { brand.Name }
				}
			</div>
			@catalogFacts(view)
		</main>
	}
}

// ---------------------------------------------------------------- app

// CatalogInApp is the catalog inside a workspace; its rows open the
// install page.
templ CatalogInApp(view CatalogView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@layouts.App("Catalog") {
		@panelPage() {
			@components.Header(components.HeaderProps{Back: components.Back{Label: "New app", Href: basePath + "/new-app"}, Title: "Catalog"})
			@catalogBody(view)
		}
	}
}

// CatalogInstall is the page of a catalog app in a workspace: its head,
// the install form, its links and its versions.
templ CatalogInstall(view CatalogInstallView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ entry := view.App.Entry }}
	@layouts.App("Install " + entry.Name) {
		@panelPage() {
			@catalogHead(components.Back{Label: "Catalog", Href: basePath + "/catalog"}, entry)
			if len(view.Servers) == 0 {
				@components.List() {
					@components.Item(components.ItemProps{Href: basePath + "/servers", Name: "Connect a server first", Note: "Apps run on your servers"})
				}
			} else {
				@components.Card(components.CardProps{}) {
					<form
						id="catalog-install-form"
						class="moin-stack"
						data-gap="4"
						hx-post={ basePath + "/catalog/" + entry.Slug + "/install" }
						hx-swap="none"
						hx-disable="find button[type='submit']"
					>
						@components.CSRF()
						if note := entry.DatabaseNote(); note != "" {
							<p class="moin-text moin-muted" data-catalog-database-note>{ note }</p>
						}
						<div class="moin-grid">
							@components.Field(components.FieldProps{Label: "Version", For: "catalog-version"}) {
								@components.Select(components.SelectProps{ID: "catalog-version", Name: "version", Label: "Version", Options: versionOptions(view.App.Versions), Disabled: len(view.App.Versions) == 0})
							}
							@components.Field(components.FieldProps{Label: "Server", For: "catalog-server"}) {
								@components.Select(components.SelectProps{ID: "catalog-server", Name: "server", Label: "Server", Options: serverOptions(view.Servers)})
							}
							@components.Field(components.FieldProps{Label: "App name", For: "catalog-name", Hint: "Lowercase letters, digits and dashes"}) {
								@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "catalog-name", "name": "name", "type": "text", "value": entry.Slug, "maxlength": "63", "autocomplete": "off", "spellcheck": "false"}})
							}
							@components.Field(components.FieldProps{Label: ifElse(entry.NeedsURL(), "Domain", "Domain, optional"), For: "catalog-domain", Hint: ifElse(entry.NeedsURL(), entry.Name+" links to it. Point its DNS to the server first", "Point its DNS to the server")}) {
								@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "catalog-domain", "name": "domain", "type": "text", "placeholder": entry.Slug + ".example.com", "autocomplete": "off", "spellcheck": "false"}})
							}
						</div>
						<div class="moin-row" data-end>
							@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit", Attrs: templ.Attributes{"data-catalog-submit": true}}) {
								Install
							}
						</div>
					</form>
				}
			}
			@catalogFacts(view.App)
		}
	}
}

// ---------------------------------------------------------------- parts

// catalogBody is the catalog itself: the category and the order, then
// the apps. A choice asks the server (htmx), which answers the list and
// keeps the address bar in step; without JavaScript the form loads the
// page. No search of its own: the magnifier of the navbar finds apps.
templ catalogBody(view CatalogView) {
	<form
		id="catalog-form"
		method="get"
		action={ templ.SafeURL(view.Base) }
		class="moin-grid moin-narrow"
		data-fit
		data-gap="2"
		style="--min:8rem;--width:24rem"
		hx-get={ view.Base }
		hx-trigger="change, submit"
		hx-target="#catalog-results"
		hx-swap="outerHTML"
		hx-sync="this:replace"
	>
		@components.Select(components.SelectProps{ID: "catalog-category", Name: "category", Label: "Category", Options: categoryOptions(view), Value: categorySlug(view.Category)})
		@components.Select(components.SelectProps{ID: "catalog-sort", Name: "sort", Label: "Order", Options: []components.Option{{Value: SortUpdated, Label: "Updated"}, {Value: SortName, Label: "Name"}}, Value: view.Sort})
	</form>
	@CatalogResults(view)
}

// CatalogResults is the list of apps of the category, also the answer to
// a choice of the category or the order.
templ CatalogResults(view CatalogView) {
	<div id="catalog-results" class="moin-stack" data-gap="2" data-catalog-results>
		if len(view.Apps) > 0 {
			<section class="moin-section">
				<div class="moin-section-head">
					<h2>{ appCount(len(view.Apps)) }</h2>
				</div>
				@components.List() {
					for _, app := range view.Apps {
						@components.Item(components.ItemProps{Href: view.Base + "/" + app.Entry.Slug, Lead: components.AppIcon(components.AppIconProps{Name: app.Entry.Name, Initial: model.Initial(app.Entry.Name), Logo: catalogLogo(app.Entry)}), Name: app.Entry.Name, Note: app.Entry.Pitch})
					}
				}
			</section>
			<p class="moin-text moin-muted">
				Missing one? <a href="/docs/guides/catalog#add-an-app" class="moin-link moin-foreground" data-quiet>Ask for it</a>
			</p>
		}
	</div>
}

func appCount(n int) string {
	if n == 1 {
		return "1 app"
	}
	return strconv.Itoa(n) + " apps"
}

// catalogHead is the head of a catalog app's page: its icon before its
// name, and its one sentence under it.
templ catalogHead(back components.Back, entry catalog.Entry) {
	<div class="moin-stack" data-gap="2">
		@components.Header(components.HeaderProps{Back: back, Icon: components.AppIcon(components.AppIconProps{Name: entry.Name, Initial: model.Initial(entry.Name), Logo: catalogLogo(entry), Large: true}), Title: entry.Name})
		<p class="moin-small moin-muted">
			{ entry.Pitch }
		</p>
	</div>
}

// catalogFacts are what a catalog app's page tells under its action: its
// links, its first sign-in, and its versions.
templ catalogFacts(view CatalogEntryView) {
	{{ entry := view.Entry }}
	<section class="moin-section">
		<div class="moin-section-head">
			<h2>Links</h2>
		</div>
		@components.List() {
			if entry.Website != "" {
				@catalogLink("Website", websiteHost(entry.Website), entry.Website, false)
			}
			if entry.Source != "" {
				@catalogLink("Source", entry.License, "https://"+entry.Source, false)
			}
			if entry.Image != "" {
				@catalogLink("Image", entry.Image, imageURL(entry.Image), true)
			}
		}
	</section>
	if entry.Login != "" {
		<section class="moin-section">
			<div class="moin-section-head">
				<h2>First sign-in</h2>
			</div>
			@components.List() {
				@components.Item(components.ItemProps{}) {
					<p class="moin-fill moin-text" data-catalog-login>{ entry.Login }</p>
				}
			}
		</section>
	}
	@catalogVersions(view.Versions)
}

// catalogLink is a row that opens another site in a new tab: what it is,
// its value, and ↗.
templ catalogLink(label, value, href string, mono bool) {
	@components.Item(components.ItemProps{Href: href, External: true}) {
		<span class="moin-strong" data-catalog-link={ label }>{ label }</span>
		<span class={ "moin-item-value moin-end", templ.KV("moin-mono", mono) }>{ value }</span>
	}
}

// catalogVersions lists the newest releases with when they came out. It
// only tells: any of them can be installed, an older one too.
templ catalogVersions(versions []catalog.Version) {
	{{ now := time.Now() }}
	<section class="moin-section">
		<div class="moin-section-head">
			<h2>Versions</h2>
		</div>
		<div class="moin-stack" data-gap="2" data-catalog-versions>
			@components.List() {
				if len(versions) == 0 {
					@components.Item(components.ItemProps{Name: "Not known yet", Note: "The registry has not answered. Try again in a minute."})
				}
				for _, version := range shownVersions(versions, 8) {
					@components.Item(components.ItemProps{}) {
						<span class="moin-fill moin-truncate moin-mono moin-text">{ version.Tag }</span>
						<span class="moin-text moin-muted">{ released(version, now) }</span>
					}
				}
			}
			if more := len(versions) - 8; more > 0 {
				<p class="moin-text moin-muted">{ strconv.Itoa(more) } older</p>
			}
		</div>
	</section>
}

// CatalogUpdate is the panel of an app from the catalog: the version it
// runs, the newest, and the way to another one.
templ CatalogUpdate(view CatalogUpdateView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<div id="catalog-update" data-catalog-update>
		@components.Card(components.CardProps{}) {
			<div class="moin-row" data-gap="4" data-phone="stack">
				<div class="moin-fill">
					<p class="moin-truncate moin-strong">{ view.Entry.Name }</p>
					<p class="moin-small moin-muted">
						{ catalogUpdateLine(view) }
						if note := view.Entry.DatabaseNote(); note != "" {
							<span data-catalog-database-note>{ note }</span>
						}
					</p>
				</div>
				<form
					class="moin-row"
					data-gap="2"
					data-phone="stack"
					hx-post={ basePath + "/apps/" + view.App.Link() + "/update" }
					hx-swap="none"
					hx-disable="find button[type='submit']"
					hx-confirm={ "Deploy " + view.Entry.Name + " in this version? Going back to an older one may not undo the migrations of a newer one. moin backs it up first." }
				>
					@components.CSRF()
					<div class="moin-width" style="--width:9rem">
						@components.Select(components.SelectProps{ID: "catalog-update-version", Name: "version", Label: "Version", Options: versionOptions(view.Versions), Value: view.Latest.Tag, Disabled: len(view.Versions) == 0})
					</div>
					@components.Button(components.ButtonProps{Kind: catalogUpdateKind(view.Newer), Type: "submit", Attrs: templ.Attributes{"data-catalog-update-submit": true}}) {
						if view.Newer {
							Update
						} else {
							Deploy
						}
					}
				</form>
			</div>
		}
	</div>
}

// catalogUpdateLine says which version runs, and the newer one if there is.
func catalogUpdateLine(view CatalogUpdateView) string {
	switch {
	case view.Version == "":
		return ""
	case view.Newer:
		return view.Latest.Tag + " is out. You run " + view.Version + "."
	}
	return view.Version + ", the newest."
}

// catalogUpdateKind makes Update the primary button: it is the thing to do.
func catalogUpdateKind(newer bool) components.Kind {
	if newer {
		return components.Primary
	}
	return ""
}

func firstVersion(versions []catalog.Version) string {
	if len(versions) == 0 {
		return ""
	}
	return versions[0].Tag
}
