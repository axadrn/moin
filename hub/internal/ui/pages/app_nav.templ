package pages

import (
	"fmt"

	"github.com/axadrn/moin/hub/internal/ui/components"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
)

// appKind is the status symbol of an app: its newest deploy.
func appKind(app model.App) components.State {
	switch {
	case app.LatestNumber == 0:
		return components.StateIdle
	case app.LatestStatus == model.DeployRunning:
		return components.StateRunning
	case app.LatestStatus == model.DeployFailed:
		return components.StateFailed
	}
	return components.StateLive
}

// appSections are the parts of an app, each one question: does it run,
// how does code get in, where is it reached, what happens in it, what is in
// its database, how is it set up. The TUI has the same ones and keys.
var appSections = []struct{ ID, Label, Path, Key string }{
	{"app", "App", "", ""},
	{"deploys", "Deploys", "/deploys", "d"},
	{"domains", "Domains", "/domains", "o"},
	{"logs", "Logs", "/logs", "l"},
	{"data", "Data", "/data", "b"},
	{"settings", "Settings", "/settings", "e"},
}

// appSectionLabel is the name of a section, for the head on a phone.
func appSectionLabel(id string) string {
	for _, s := range appSections {
		if s.ID == id {
			return s.Label
		}
	}
	return "App"
}

// appHeader is the head of every section of an app, the same on each, so
// it stands still while you go through the tabs: the way back, the name,
// its buttons (Restart or Start, Deploy), and under them its state, the one
// answer of the page: under the name, before the buttons on a phone, under
// both from sm. On a phone a section other than App is a page of its
// own: "‹ my-app" and the section's name, like a list that drills down.
templ appHeader(app model.App, section string) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Link() }}
	if section != "app" {
		<div class="moin-only-phone">
			@components.Header(components.HeaderProps{Back: components.Back{Label: app.Name, Href: appPath}, Title: appSectionLabel(section)})
		</div>
	}
	<div
		if section != "app" {
			class="moin-hidden-phone"
		}
	>
		@components.Header(components.HeaderProps{Back: components.Back{Label: "Apps", Href: ctxkeys.AppBasePath(ctx) + "/apps"}, Title: app.Name, Line: appStateLine(app)}) {
			@appActions(app)
		}
	</div>
}

// appActions are the buttons of an app: Start when it is stopped, else
// Restart once it runs, and Deploy once it has a deploy. When saved changes
// wait, Restart is the thing to do, so it is the primary one, and how many
// wait stands quietly next to it, the reason for the button (on a phone
// the Settings row says it). Two equal halves on a phone, next to the
// name from sm.
templ appActions(app model.App) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Link() }}
	<div id="app-actions" hx-swap-oob="true" class="moin-contents">
		if app.ChangesWaiting > 0 && !app.Stopped && app.LiveNumber > 0 {
			<span class="moin-hidden-phone moin-text moin-muted" data-changes-waiting>{ changesWaiting(app.ChangesWaiting) }</span>
		}
		if app.Stopped {
			@components.Button(components.ButtonProps{Kind: components.Primary, Attrs: templ.Attributes{"hx-post": appPath + "/start", "hx-swap": "none", "hx-disable": "this", "data-start": true}}) {
				Start
			}
		} else if app.LiveNumber > 0 {
			@components.Button(components.ButtonProps{Kind: restartKind(app), Attrs: templ.Attributes{"hx-post": appPath + "/restart", "hx-swap": "none", "hx-disable": "this", "data-restart": true}}) {
				Restart
			}
		}
		if app.LatestNumber > 0 && !app.Stopped {
			@components.Button(components.ButtonProps{Kind: deployKind(app), Attrs: templ.Attributes{"hx-post": appPath + "/redeploy", "hx-swap": "none", "hx-disable": "this", "data-redeploy": true}}) {
				Deploy
			}
		}
	</div>
}

func restartKind(app model.App) components.Kind {
	if app.ChangesWaiting > 0 {
		return components.Primary
	}
	return ""
}

func deployKind(app model.App) components.Kind {
	if app.ChangesWaiting > 0 {
		return ""
	}
	return components.Primary
}

// appStateLine is the answer of an app's page in one line: does it run.
templ appStateLine(app model.App) {
	<span id="app-state" hx-swap-oob="true" class="moin-contents" data-status>
		@components.Dot(components.DotProps{State: appStateKind(app)})
		<span>{ appStateWords(app) }</span>
	</span>
}

func appStateKind(app model.App) components.State {
	if app.Stopped {
		return components.StateIdle
	}
	return appKind(app)
}

func appStateWords(app model.App) string {
	switch {
	case app.LatestNumber == 0:
		return "Not deployed yet"
	case app.LatestStatus == model.DeployRunning:
		return fmt.Sprintf("Deploying v%d", app.LatestNumber)
	case app.Stopped:
		return fmt.Sprintf("Stopped · v%d", app.LiveNumber)
	case app.LatestStatus == model.DeployFailed && app.LiveNumber > 0:
		return fmt.Sprintf("v%d failed · v%d still live", app.LatestNumber, app.LiveNumber)
	case app.LatestStatus == model.DeployFailed:
		return fmt.Sprintf("v%d failed", app.LatestNumber)
	}
	return fmt.Sprintf("Live · v%d", app.LiveNumber)
}

func changesWaiting(n int) string {
	if n == 1 {
		return "1 change waiting"
	}
	return fmt.Sprintf("%d changes waiting", n)
}

// appTabs are the sections of an app as a segmented control, each a link
// to its page. Only from sm: a phone gets the list on the App section.
templ appTabs(appName, appLink, active string) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + appLink }}
	{{ tabs := make([]components.Tab, 0, len(appSections)) }}
	for _, s := range appSections {
		{{ tabs = append(tabs, components.Tab{Label: s.Label, Href: appPath + s.Path, Key: s.Key, Active: s.ID == active}) }}
	}
	<div class="moin-hidden-phone">
		@components.Tabs(components.TabsProps{ID: "app-tabs", Label: appName, Tabs: tabs})
	</div>
}

// appSection is the tabs, then what the open section shows. A part that
// reloads on the app's events keeps the head live on every section.
templ appSection(appName, appLink, section string) {
	<div id="app-section" class="moin-stack" data-gap="6">
		@appTabs(appName, appLink, section)
		if section != "deploys" {
			// The Deploys section reloads through its list (appDeploys).
			<div hidden hx-get={ ctxkeys.AppBasePath(ctx) + "/apps/" + appLink + "/detail" } hx-trigger="apps from:body" hx-swap="none"></div>
		}
		{ children... }
	</div>
}

// PinSwitch pins an app above the others that run fine, in every list: a
// switch in the app's settings that saves itself (DESIGN.md, Feedback).
templ PinSwitch(app model.App) {
	@components.Item(components.ItemProps{Form: true, For: "pin-on", Name: "Pin to the top", Attrs: templ.Attributes{"id": "pin-form", "hx-post": ctxkeys.AppBasePath(ctx) + "/apps/" + app.Link() + "/pin", "hx-trigger": "change", "hx-swap": "none"}}) {
		@components.CSRF()
		@components.Switch(components.SwitchProps{Attrs: templ.Attributes{"id": "pin-on", "name": "on", "value": "1", "checked": app.Pinned, "aria-label": "Pin " + app.Name, "data-pin": true}})
	}
}
