package pages

import (
	"fmt"
	"strconv"
	"time"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
	"github.com/axadrn/moin/internal/human"
)

// AppMetricsPage is the metrics of an app, a page under it ("‹ my-app"):
// CPU, memory and network of its containers now and over a range, with its
// deploys marked.
templ AppMetricsPage(view AppMetricsView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Link() }}
	@layouts.App(view.App.Name + " metrics") {
		@panelPage(templ.Attributes{"data-app-metrics": view.App.Name}) {
			@components.Header(components.HeaderProps{Back: components.Back{Label: view.App.Name, Href: appPath}, Title: "Metrics"})
			@appMetricsPanel(view, appPath+"/metrics")
		}
	}
}

// appMetricsPanel is everything under the head; it reloads itself every
// 15 seconds on the last hour, and when another range is picked.
templ appMetricsPanel(view AppMetricsView, path string) {
	{{ m := view.Metrics }}
	{{ times := metricsTimes(m.Points) }}
	{{ marks := deployMarks(m.Points, m.Deploys) }}
	<div id="metrics" class="moin-stack" data-gap="6" data-metrics-range={ m.Range.Name } { metricsRefresh(path+"?range="+m.Range.Name, m.Range.Name)... }>
		if !m.ServerOnline && m.Server != "" {
			<p class="moin-message" data-state="failed" data-server-offline>{ m.Server } is offline: its daemon sends no metrics.</p>
		}
		@serverRangeSelect(path, m.Range.Name)
		<section class="moin-section">
			<div class="moin-section-head">
				<h2>Now</h2>
			</div>
			<div data-metrics-now>
				@components.List() {
					if now := m.Now; now != nil {
						@serverStat("CPU", "of the whole server", percentText(now.CPU))
						@serverStat("Memory", appLimitNote(now), human.Size(float64(now.MemoryUsed)))
						@serverStat("Network", rateText(now.NetTx)+" out", rateText(now.NetRx)+" in")
						@serverStat("Containers", "", strconv.Itoa(now.Containers))
					} else {
						@serverStat("CPU", "No sample in the last two minutes", "")
						@serverStat("Memory", "", "")
						@serverStat("Network", "", "")
					}
				}
			</div>
		</section>
		<section class="moin-section">
			<div class="moin-section-head">
				<h2>{ rangeTitle(m.Range) }</h2>
			</div>
			if len(times) == 0 {
				@components.Card(components.CardProps{}) {
					<p class="moin-small moin-muted">
						No metrics yet. The daemon sends them every 15 seconds while the app runs.
					</p>
					@components.Command(components.CommandProps{Text: "moin metrics " + view.App.Name})
				}
			} else {
				<div class="moin-grid" data-cols="2">
					@serverChart("CPU", metricsChartProps{ID: "app-cpu", Lines: []components.ChartLine{metricsLine("CPU", m.Points, cpuOf)}, Value: percentText, Marks: marks}, times, m.Range)
					@serverChart("Memory", metricsChartProps{ID: "app-memory", Lines: []components.ChartLine{metricsLine("Memory", m.Points, memoryOf)}, Value: human.Size, Marks: marks}, times, m.Range)
					@serverChart("Network", metricsChartProps{ID: "app-network", Lines: []components.ChartLine{metricsLine("In", m.Points, rxOf), metricsLine("Out", m.Points, txOf)}, Value: rateText, Marks: marks}, times, m.Range)
				</div>
			}
		</section>
	</div>
}

func appLimitNote(now *service.MetricsNow) string {
	if now.MemoryLimit == 0 {
		return "no limit"
	}
	return "of " + human.Size(float64(now.MemoryLimit)) + ", " + shareOf(now.MemoryUsed, now.MemoryLimit)
}

func rangeTitle(r service.MetricsRange) string {
	switch r.Name {
	case "24h":
		return "Last 24 hours, 5 minute averages"
	case "7d":
		return "Last 7 days, hourly averages"
	case "30d":
		return "Last 30 days, 4 hour averages"
	}
	return "Last hour, every 15 seconds, live"
}

// ServerMetricsPage is the metrics of a server: CPU, memory, the data
// disk, network and load now and over a range, and its apps by memory.
templ ServerMetricsPage(view ServerMetricsView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ path := basePath + "/servers/" + view.Server.Link() + "/metrics" }}
	@layouts.App(view.Server.Name + " metrics") {
		@panelPage(templ.Attributes{"data-server-metrics": view.Server.Name}) {
			@serverHead(view.Server, "metrics")
			@serverMetricsPanel(view, path)
		}
	}
}

// serverMetricsPanel is everything under the head; it reloads itself every
// 15 seconds on the last hour, and when another range is picked.
templ serverMetricsPanel(view ServerMetricsView, path string) {
	{{ m := view.Metrics }}
	{{ times := metricsTimes(m.Points) }}
	<div id="metrics" class="moin-stack" data-gap="6" data-metrics-range={ m.Range.Name } { metricsRefresh(path+"?range="+m.Range.Name, m.Range.Name)... }>
		if !m.Online {
			<p class="moin-message" data-state="failed" data-server-offline>The server is offline: its daemon sends no metrics.</p>
		}
		@serverRangeSelect(path, m.Range.Name)
		<section class="moin-section">
			<div class="moin-section-head">
				<h2>Now</h2>
			</div>
			<div data-metrics-now>
				@components.List() {
					if now := m.Now; now != nil {
						@serverStat("CPU", cpuNote(now), percentText(now.CPU))
						@serverStat("Memory", shareOf(now.MemoryUsed, now.MemoryTotal), usedOf(now.MemoryUsed, now.MemoryTotal))
						@serverStat("Disk", shareOf(now.DiskUsed, now.DiskTotal), usedOf(now.DiskUsed, now.DiskTotal))
						@serverStat("Network", rateText(now.NetTx)+" out", rateText(now.NetRx)+" in")
					} else {
						@serverStat("CPU", "No sample in the last two minutes", "")
						@serverStat("Memory", "", "")
						@serverStat("Disk", "", "")
						@serverStat("Network", "", "")
					}
				}
			</div>
		</section>
		<section class="moin-section">
			<div class="moin-section-head">
				<h2>{ rangeTitle(m.Range) }</h2>
			</div>
			if len(times) == 0 {
				@components.Card(components.CardProps{}) {
					<p class="moin-small moin-muted">
						No metrics yet. The daemon sends them every 15 seconds.
					</p>
					@components.Command(components.CommandProps{Text: "moin metrics --server " + view.Server.Name})
				}
			} else {
				<div class="moin-grid" data-cols="2">
					@serverChart("CPU", metricsChartProps{ID: "server-cpu", Lines: []components.ChartLine{metricsLine("CPU", m.Points, cpuOf)}, Value: percentText, Top: 100}, times, m.Range)
					@serverChart("Memory", metricsChartProps{ID: "server-memory", Lines: []components.ChartLine{metricsLine("Memory", m.Points, memoryOf)}, Value: human.Size, Top: totalTop(m.Now, false)}, times, m.Range)
					@serverChart("Disk", metricsChartProps{ID: "server-disk", Lines: []components.ChartLine{metricsLine("Disk", m.Points, diskOf)}, Value: human.Size, Top: totalTop(m.Now, true)}, times, m.Range)
					@serverChart("Network", metricsChartProps{ID: "server-network", Lines: []components.ChartLine{metricsLine("In", m.Points, rxOf), metricsLine("Out", m.Points, txOf)}, Value: rateText}, times, m.Range)
				</div>
			}
		</section>
		@serverAppsMetrics(m.Apps)
	</div>
}

// serverRangeSelect picks the range: a change loads the metrics of that
// range in place and puts it in the address.
templ serverRangeSelect(path, active string) {
	<form class="moin-width" data-fixed style="--width:10rem" hx-get={ path } hx-trigger="change" hx-target="#metrics" hx-select="#metrics" hx-swap="outerHTML" hx-push-url="true" data-metrics-ranges>
		@components.Select(components.SelectProps{ID: "metrics-range", Name: "range", Label: "Range", Options: rangeOptions(), Value: active})
	</form>
}

func rangeOptions() []components.Option {
	options := make([]components.Option, 0, len(service.MetricsRanges))
	for _, r := range service.MetricsRanges {
		options = append(options, components.Option{Value: r.Name, Label: rangeLabel(r.Name)})
	}
	return options
}

func rangeLabel(name string) string {
	switch name {
	case "24h":
		return "24 hours"
	case "7d":
		return "7 days"
	case "30d":
		return "30 days"
	}
	return "1 hour"
}

// serverStat is one number of the server now: its name and a note left,
// the value right.
templ serverStat(name, note, value string) {
	@components.Item(components.ItemProps{Name: name, Note: note, Value: ifElse(value != "", value, "—")})
}

// serverChart is a card with one chart.
templ serverChart(title string, p metricsChartProps, times []time.Time, r service.MetricsRange) {
	@components.Card(components.CardProps{Title: title, Attrs: templ.Attributes{"data-metrics-chart": p.ID}}) {
		@components.Chart(metricsChart(p, times, r))
	}
}

func cpuNote(now *service.MetricsNow) string {
	note := "load " + loadText(now.Load)
	if now.Cores > 0 {
		note = fmt.Sprintf("%d cores, %s", now.Cores, note)
	}
	return note
}

// totalTop lets a chart of memory or disk reach up to the total, 0 when
// it is not known.
func totalTop(now *service.MetricsNow, disk bool) float64 {
	if now == nil {
		return 0
	}
	if disk {
		return float64(now.DiskTotal)
	}
	return float64(now.MemoryTotal)
}

// appMetricsNote is the CPU and network of a running app, nothing for one
// that does not run.
func appMetricsNote(app service.AppMetricsNow) string {
	if app.Now == nil {
		return ""
	}
	return "CPU " + percentText(app.Now.CPU) + " · network " + rateText(app.Now.NetRx+app.Now.NetTx)
}

// serverAppsMetrics lists the apps of the server, the one with the most
// memory first.
templ serverAppsMetrics(apps []service.AppMetricsNow) {
	<section class="moin-section">
		<div class="moin-section-head">
			<h2>Apps</h2>
		</div>
		<div data-server-apps-metrics>
			@components.List() {
				if len(apps) == 0 {
					@components.Item(components.ItemProps{Name: "No apps on this server yet"})
				}
				for _, app := range apps {
					@components.Item(components.ItemProps{Href: ctxkeys.AppBasePath(ctx)+"/apps/"+app.Name+"/metrics", Name: app.Name, Note: appMetricsNote(app), Attrs: templ.Attributes{"data-app-metrics-row": app.Name}}) {
						if now := app.Now; now != nil {
							<span class="moin-strong moin-digits">{ human.Size(float64(now.MemoryUsed)) }</span>
						} else {
							<span class="moin-text moin-muted">not running</span>
						}
					}
				}
			}
		</div>
	</section>
}
