package pages

import (
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/kit"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// Legal is the terms or the privacy policy: the title, a tab bar between
// the two, when it changed last and the text.
templ Legal(page *service.LegalPage) {
	@layouts.Home(layouts.SEOProps{
		Title:       page.Title,
		Description: page.Description,
		Path:        "/legal/" + page.Slug,
	}) {
		<main class={ kit.Page, "flex flex-col gap-8 pt-10 pb-20 sm:pt-14" }>
			@kit.Header(kit.Back{}, page.Title)
			<div class="flex flex-col gap-3">
				@kit.Segmented("legal", "Legal", []kit.Segment{
					{Label: "Terms of Service", Href: "/legal/terms", Active: page.Slug == "terms"},
					{Label: "Privacy Policy", Href: "/legal/privacy", Active: page.Slug == "privacy"},
				})
				<p class="px-1 text-xs text-muted-foreground">Last updated { page.LastUpdated }</p>
			</div>
			<article class="max-w-2xl min-w-0 text-base">
				@kit.Typeset(page.Content)
			</article>
		</main>
	}
}
