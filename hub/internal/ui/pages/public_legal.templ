package pages

import (
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// Legal is the terms or the privacy policy: the title, a tab bar between
// the two, when it changed last and the text.
templ Legal(page *service.LegalPage) {
	@layouts.Home(layouts.SEOProps{
		Title:       page.Title,
		Description: page.Description,
		Path:        "/legal/" + page.Slug,
	}) {
		<main class="moin-page moin-content">
			@components.Header(components.HeaderProps{Title: page.Title})
			<div class="moin-stack" data-gap="3">
				@components.Tabs(components.TabsProps{ID: "legal", Label: "Legal", Tabs: []components.Tab{
					{Label: "Terms of Service", Href: "/legal/terms", Active: page.Slug == "terms"},
					{Label: "Privacy Policy", Href: "/legal/privacy", Active: page.Slug == "privacy"},
				}})
				<p class="moin-small moin-muted">Last updated { page.LastUpdated }</p>
			</div>
			<article class="moin-narrow">
				@components.Prose(components.ProseProps{HTML: page.Content})
			</article>
		</main>
	}
}
