package pages

import (
	"fmt"
	"github.com/axadrn/moin/hub/internal/ui/components"

	"github.com/axadrn/moin/hub/internal/brand"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// ---------------------------------------------------------------- home
// HomeCompare is the comparison on the home page: the seven tools, each
// with how many facts moin wins, each a way to its page.
templ HomeCompare() {
	<section id="compare" class="moin-band">
		<h2 class="moin-statement">Look at the score.</h2>
		<p class="moin-lead">None of these seven documents a daily restore check. { brand.Name } runs one.</p>
		<div class="moin-bento">
			for _, competitor := range Competitors {
				@homeFeature(competitor.Name, competitor.ScoreLine(), "/compare/"+competitor.Slug)
			}
		</div>
		<p class="moin-text moin-muted">Fact by fact, from each tool's own docs, read { compareRead }.</p>
	</section>
}

// compareLine is the words of a row: unlike an Item's Name and Note they
// wrap, so a sentence is never cut on a phone.
templ compareLine(name, note string) {
	<div class="moin-stack moin-fill" style="--gap:2px">
		<span class="moin-strong">{ name }</span>
		<span class="moin-text moin-muted">{ note }</span>
	</div>
}

// ---------------------------------------------------------------- page
// Compare is one tool next to this one: what differs, the score, and the
// same facts for both, grouped, each answer with its mark and its source.
templ Compare(competitor Competitor) {
	{{ score := competitor.Score() }}
	@layouts.Home(layouts.SEOProps{
		Title:       brand.Name + " vs " + competitor.Name,
		Description: competitor.Lead,
		Path:        "/compare/" + competitor.Slug,
	}) {
		<main class="moin-page moin-content">
			@components.Header(components.HeaderProps{Title: brand.Name + " or " + competitor.Name + "?"})
			<p class="moin-lead">{ competitor.Lead }</p>
			<p class="moin-title moin-digits">{ competitor.ScoreLine() }</p>
			<div class="moin-stack" data-gap="6">
				@compareHeader(competitor.Name, score)
				for _, group := range compareGroups {
					<section class="moin-section">
						<div class="moin-section-head">
							<h2>{ group }</h2>
						</div>
						@components.List() {
							for i, row := range CompareRows {
								if row.Group == group {
									@compareFact(row, competitor.Name, competitor.Cells[i])
								}
							}
						}
					</section>
				}
			</div>
			<p class="moin-text moin-muted">
				From { competitor.Name }'s own docs, read { compareRead }. A check is the better answer, a dash a part of it, a cross not. "Not documented" means its docs say nothing, not that it cannot be done, and it is not counted.
				<a href="/#compare" class="moin-link moin-foreground">All seven</a>
			</p>
		</main>
	}
}

// compareHeader names the two columns over the table, each with its score,
// in line with the rows. A phone has no columns to name, and every answer
// says whose it is; the score over the table is there for it.
templ compareHeader(name string, score CompareScore) {
	<div aria-hidden="true" class="moin-hidden-phone">
		@components.List(templ.Attributes{"style": "--card:transparent"}) {
			@components.Item(components.ItemProps{}) {
				<div class="moin-grid moin-fill moin-text moin-muted" data-cols="2-3-3">
					<span></span>
					<span class="moin-stack" style="--gap:0"><span class="moin-strong">{ brand.Name }</span><span class="moin-digits">{ fmt.Sprintf("%d of %d", score.Ours, score.Facts) }</span></span>
					<span class="moin-stack" style="--gap:0"><span class="moin-strong">{ name }</span><span class="moin-digits">{ fmt.Sprintf("%d of %d", score.Theirs, score.Facts) }</span></span>
				</div>
			}
		}
	</div>
}

templ compareFact(row CompareRow, name string, cell CompareCell) {
	@components.Item(components.ItemProps{}) {
		<div class="moin-grid moin-fill" data-cols="2-3-3">
			<span class="moin-strong">{ row.Label }</span>
			@compareAnswer(brand.Name, row.Ours)
			@compareAnswer(name, cell)
		</div>
	}
}

// compareAnswer is one side of a fact: its mark, its words, the line under
// them and where it says so.
templ compareAnswer(whose string, cell CompareCell) {
	<div class="moin-row" data-gap="2" data-top>
		@compareMarkIcon(cell.Mark)
		<div class="moin-stack moin-text" style="--gap:2px">
			<span><span class="moin-muted moin-sr-tablet">{ whose }: </span><span class="moin-strong">{ cell.Short }</span></span>
			if cell.Detail != "" {
				<span class="moin-small moin-muted">{ cell.Detail }</span>
			}
			if cell.Source != "" {
				<span class="moin-small moin-muted"><a href={ templ.SafeURL(cell.Source) } target="_blank" rel="noopener" class="moin-link">Source</a></span>
			}
		</div>
	</div>
}

// compareMarkIcon is a mark in the ink of the page: a filled check, a
// dash, a cross, a question mark, or a blank that keeps the words in line.
templ compareMarkIcon(mark compareMark) {
	switch mark {
		case markYes:
			<span role="img" aria-label="Yes" class="moin-mark" data-kind="yes">
				@components.Icon("check")
			</span>
		case markPart:
			<span role="img" aria-label="Partly" class="moin-mark" data-kind="part">
				<svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12"><path d="M3.5 8h9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
			</span>
		case markNo:
			<span role="img" aria-label="No" class="moin-mark" data-kind="no">
				@components.Icon("x")
			</span>
		case markUnknown:
			<span role="img" aria-label="Not documented" class="moin-mark" data-kind="no">?</span>
		default:
			<span aria-hidden="true" class="moin-mark"></span>
	}
}
