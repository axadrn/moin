package pages

import (
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// AuthForgotPassword emails a link that signs you in, so you can set a new
// password.
templ AuthForgotPassword(errorMsg string) {
	@authScreen(layouts.SEOProps{Title: "Reset your password", Description: "Reset your password"}, "Reset your password") {
		@AuthForgotPasswordForm(errorMsg)
	}
}

templ AuthForgotPasswordForm(errorMsg string) {
	<form
		id="forgot-password-form"
		action="/auth/forgot-password"
		method="POST"
		class="moin-stack" data-gap="4"
		hx-post="/auth/forgot-password"
		hx-target="#forgot-password-form"
		hx-swap="outerHTML"
		hx-disable="find button[type='submit']"
	>
		@components.CSRF()
		@formField("Email", "email", "", errorMsg) {
			@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "email", "name": "email", "type": "email", "placeholder": "you@example.com", "aria-invalid": ariaInvalid(errorMsg), "aria-describedby": "email-hint", "autocomplete": "email", "autofocus": true, "required": true}})
		}
		@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit"}) {
			Email me a link
		}
		@authLink("/auth") {
			Back to sign in
		}
	</form>
}

templ AuthForgotPasswordSent(email string) {
	@authScreen(layouts.SEOProps{Title: "Check your email", Description: "Password reset link sent"}, "Check your email") {
		@authLine() {
			We sent a link to <span class="font-medium text-foreground">{ email }</span>.
		}
		<div class="flex flex-col">
			@authLink("/auth") {
				Back to sign in
			}
		</div>
	}
}
