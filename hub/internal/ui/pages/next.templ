package pages

import (
	"github.com/axadrn/moin/hub/internal/brand"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// Next is the story of moin next, built like the home page: the promise
// big in the middle, what moves in as tiles, the honest warning, and the
// way in. What is planned, item by item, is in the roadmap: one list.
templ Next() {
	@layouts.Home(layouts.SEOProps{Title: brand.Name + " next", Description: "One app to build it. Ship it. Run it. Open source. Highly experimental.", Path: "/next"}) {
		<main class="moin-page">
			<section class="moin-band">
				<div class="moin-stack" data-gap="6" data-center>
					<span class="moin-badge">Highly experimental</span>
					<h1 class="moin-display moin-stack moin-center" style="--gap:0">
						<span>One app.</span>
						<span class="moin-muted">Build it. Ship it. Run it.</span>
					</h1>
					<p class="moin-lead moin-center" style="--measure:40ch">Think Linear. Slack. Mail. GitHub boards. All in one app. Open source. On your servers. Ready for your AI agents.</p>
					@nextButtons()
				</div>
			</section>
			<section class="moin-band">
				<h2 class="moin-statement">Moving in.</h2>
				<div class="moin-bento">
					@components.Card(components.CardProps{Attrs: templ.Attributes{"data-wide": true, "data-tall": true, "data-center": true, "style": "--pad:2rem"}}) {
						<p class="moin-statement">Tasks and roadmaps.</p>
						<p class="moin-small moin-muted">Issues. Boards. A roadmap everyone can see. Next to the code they ship.</p>
					}
					@nextTile("Docs", "Written next to the work.")
					@nextTile("Chat", "Your team. Your server.")
					@nextTile("Mail", "Your domain. Your inbox.")
					@nextTile("Analytics", "Your numbers. Your server.")
					@components.Card(components.CardProps{Ink: true, Attrs: templ.Attributes{"data-wide": true, "data-center": true, "style": "--pad:2rem"}}) {
						<p class="moin-statement">Open source. Your servers.</p>
						<p class="moin-small moin-muted">Read every line. Your data stays home. Ready for your AI agents.</p>
					}
					@components.Card(components.CardProps{Href: "/roadmap", Attrs: templ.Attributes{"data-wide": true, "data-center": true, "style": "--pad:2rem"}}) {
						<p class="moin-statement">And many more.</p>
						<p class="moin-small moin-muted">Item by item on the roadmap.</p>
					}
				</div>
			</section>
			<section class="moin-band">
				@components.Card(components.CardProps{Attrs: templ.Attributes{"data-gap": "8", "style": "--pad:clamp(2rem,6vw,3.5rem)"}}) {
					<span class="moin-row"><span class="moin-badge">Highly experimental</span></span>
					<p class="moin-statement">
						It will break. <span class="moin-muted">It can change. It can vanish any day.</span>
					</p>
					<p class="moin-lead" data-large>A few users get in first. Your deploys stay out of it.</p>
				}
			</section>
			<section class="moin-band">
				<div class="moin-stack" data-gap="6" data-center>
					<p class="moin-display moin-stack moin-center" style="--gap:0">
						<span>Nobody builds this for you.</span>
						<span class="moin-muted">We build it together.</span>
					</p>
					<p class="moin-lead moin-center" style="--measure:40ch">In the open. Open an issue today. It can decide what ships tomorrow.</p>
					@nextButtons()
				</div>
			</section>
		</main>
	}
}

// nextButtons are the two ways in, at the top and at the end.
templ nextButtons() {
	<div class="moin-row" data-gap="2" data-center data-wrap>
		@components.Button(components.ButtonProps{Kind: components.Primary, Href: layouts.GitHubURL, Attrs: templ.Attributes{"target": "_blank", "rel": "noopener"}}) {
			Shape it on GitHub
		}
		@components.Button(components.ButtonProps{Href: "/roadmap"}) {
			See the roadmap
		}
	</div>
}

// nextTile is one app that moves in.
templ nextTile(name, note string) {
	@components.Card(components.CardProps{Attrs: templ.Attributes{"data-gap": "1"}}) {
		<span class="moin-strong">{ name }</span>
		<span class="moin-small moin-muted">{ note }</span>
	}
}
