package pages

import (
	"cmp"
	"context"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/components"
)

// AppSource is the "Deploy from" card of the Deploys section: one tab per
// place new versions come from, GitHub or your CI, each with an icon; a
// green dot marks the one in use, none while neither is set up. One at a
// time: a hook turns deploy on push off and keeps the repo linked, whose
// compose file CI deploys take; deploy on push turns the hook off.
// Under a tab only its own part, almost no words; the docs explain. Every
// action in it answers the whole card.
templ AppSource(view RepoView) {
	{{ app := view.App }}
	{{ current := app.DeployFrom() }}
	{{ shown := cmp.Or(view.Show, current, "github") }}
	<div id="app-source">
		@components.Card(components.CardProps{Title: "Deploy from"}) {
			<div class="moin-stack" data-gap="6">
				@components.Tabs(components.TabsProps{ID: "source-tabs", Label: "Deploy from", Tabs: []components.Tab{
					sourceTab(ctx, app, "github", "GitHub", "git-hub", shown, current),
					sourceTab(ctx, app, "ci", "CI", "package", shown, current),
				}})
				if shown == "ci" {
					@appCI(view)
				} else {
					@AppRepo(view)
				}
			</div>
		}
	</div>
}

// sourceTab is one place new versions come from. It only shows its part,
// in place; the green dot says it is in use.
func sourceTab(ctx context.Context, app model.App, value, label, icon, shown, current string) components.Tab {
	href := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Link() + "/deploys?source=" + value
	return components.Tab{Label: label, Icon: icon, Href: href, Active: value == shown, Live: value == current, Attrs: templ.Attributes{
		"hx-get":      href,
		"hx-select":   "#app-source",
		"hx-target":   "#app-source",
		"hx-swap":     "outerHTML",
		"data-source": value,
	}}
}
