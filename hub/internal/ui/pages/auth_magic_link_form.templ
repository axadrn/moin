package pages

import (
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/ui/kit"
)

// AuthMagicLinkForm is the email sign-in. Where GitHub sign-in is set up,
// GitHub is the main way and this form the second one.
templ AuthMagicLinkForm(errorMsg string) {
	{{ second := ctxkeys.RenderConfig(ctx).GitHubLogin }}
	<form
		id="magic-link-form"
		action="/auth/magic-link"
		method="POST"
		class="flex flex-col gap-3"
		hx-post="/auth/magic-link"
		hx-target="#magic-link-form"
		hx-swap="outerHTML"
		hx-disable="find button[type='submit']"
	>
		@kit.CSRF()
		@formField("", "email", "", errorMsg) {
			<label for="email" class="sr-only">Email</label>
			@kit.Input(templ.Attributes{
				"id":               "email",
				"name":             "email",
				"type":             "email",
				"placeholder":      "you@company.com",
				"aria-invalid":     ariaInvalid(errorMsg),
				"aria-describedby": "email-hint",
				"autocomplete":     "email",
				"autofocus":        !second,
				"required":         true,
			})
		}
		@kit.Button(magicLinkKind(second), "", templ.Attributes{"type": "submit"}) {
			Continue with email
		}
	</form>
}

func magicLinkKind(second bool) kit.Kind {
	if second {
		return kit.Secondary
	}
	return kit.Primary
}
