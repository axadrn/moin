package pages

import (
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/ui/components"
)

// AuthMagicLinkForm is the email sign-in. Where GitHub sign-in is set up,
// GitHub is the main way and this form the second one.
templ AuthMagicLinkForm(errorMsg string) {
	{{ second := ctxkeys.RenderConfig(ctx).GitHubLogin }}
	<form
		id="magic-link-form"
		action="/auth/magic-link"
		method="POST"
		class="moin-stack"
		data-gap="3"
		hx-post="/auth/magic-link"
		hx-target="#magic-link-form"
		hx-swap="outerHTML"
		hx-disable="find button[type='submit']"
	>
		@components.CSRF()
		@formField("", "email", "", errorMsg) {
			<label for="email" class="moin-sr-only">Email</label>
			@components.Input(components.InputProps{Attrs: templ.Attributes{
				"id":               "email",
				"name":             "email",
				"type":             "email",
				"placeholder":      "you@example.com",
				"aria-invalid":     ariaInvalid(errorMsg),
				"aria-describedby": "email-hint",
				"autocomplete":     "email",
				"autofocus":        !second,
				"required":         true,
			}})
		}
		@components.Button(components.ButtonProps{Kind: magicLinkKind(second), Type: "submit"}) {
			Continue with email
		}
	</form>
}

func magicLinkKind(second bool) components.Kind {
	if second {
		return ""
	}
	return components.Primary
}
