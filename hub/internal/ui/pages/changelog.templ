package pages

import (
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// Changelog is every version of moin, newest first: its In short, and the
// full notes one click away. The newest starts open.
templ Changelog(releases []service.Release) {
	@layouts.Home(layouts.SEOProps{
		Title:       "Changelog",
		Description: "What changed in moin, newest first.",
		Path:        "/changelog",
	}) {
		<main class="moin-page moin-content">
			@components.Header(components.HeaderProps{Title: "Changelog"}) {
				@components.Button(components.ButtonProps{Href: "/changelog.xml"}) {
					RSS
				}
			}
			@components.Card(components.CardProps{}) {
				<ol class="moin-timeline">
					for i, release := range releases {
						<li id={ release.Anchor() }>
							<span class="moin-strong">{ release.Version }</span>
							<span class="moin-small moin-muted">{ release.Date.Format("January 2, 2006") }</span>
							<div class="moin-text moin-muted">
								@components.Prose(components.ProseProps{HTML: release.InShortHTML})
							</div>
							<div class="moin-text">
								@components.Expand(components.ExpandProps{Name: "Full notes", Quiet: true, Open: i == 0}) {
									<div class="moin-foreground">
										@components.Prose(components.ProseProps{HTML: release.Notes})
									</div>
								}
							</div>
						</li>
					}
				</ol>
			}
		</main>
	}
}
