package pages

import (
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// Changelog is every version of moin, newest first, in the release notes
// format: In short, then New, Changed, Fixed, Removed and Upgrade.
templ Changelog(html string) {
	@layouts.Home(layouts.SEOProps{
		Title:       "Changelog",
		Description: "What changed in moin, newest first.",
		Path:        "/changelog",
	}) {
		<main class={ components.Page, "flex flex-col gap-8 pt-10 pb-20 sm:pt-14" }>
			@components.Header(components.HeaderProps{Title: "Changelog"}) {
				<span class="sm:ml-auto">
					@components.Button(components.ButtonProps{Href: "/changelog.xml"}) {
						RSS
					}
				</span>
			}
			<article class="max-w-2xl min-w-0 text-base">
				@components.Prose(components.ProseProps{HTML: html})
			</article>
		</main>
	}
}
