package pages

import (
	"strconv"
	"strings"

	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// AdminOldDomain shows what still arrives on the old domains of the
// hub, so the operator knows when one can go.
templ AdminOldDomain(report *model.OldDomain) {
	@layouts.Admin("Old domain · Admin") {
		@panelPage() {
			@components.Header(components.HeaderProps{Back: components.Back{Label: "Admin", Href: "/admin"}, Title: "Old domain"})
			if len(report.Hosts) == 0 {
				@components.List() {
					@components.Item(components.ItemProps{Name: "No old domain is set", Note: "Put it in OLD_URLS."})
				}
			} else {
				@components.List() {
					@adminFact("Domain", strings.Join(report.Hosts, ", "))
					@adminFact("Can it go?", oldDomainVerdict(report))
					@adminFact("Requests", strconv.Itoa(report.Total)+" in "+strconv.Itoa(report.Days)+" days")
					@adminFact("Last request", oldDomainLast(report))
				}
				if len(report.Rows) > 0 {
					<section class="moin-section">
						<div class="moin-section-head">
							<h2>By day</h2>
						</div>
						@components.List() {
							for _, row := range report.Rows {
								@components.Item(components.ItemProps{}) {
									<div class="moin-item-text">
										<div class="moin-item-name moin-digits">{ row.Day }</div>
										<div class="moin-item-note"><span class="moin-mono">{ row.Host }</span> · { row.Kind }</div>
									</div>
									<span class="moin-item-value">{ strconv.Itoa(row.Requests) }</span>
								}
							}
						}
					</section>
				}
			}
		}
	}
}

func oldDomainLast(report *model.OldDomain) string {
	if report.LastAt == nil {
		return "None"
	}
	return report.LastAt.UTC().Format("Jan 2, 15:04 UTC")
}

// oldDomainVerdict is whether the old domain can go: after so many quiet
// days.
func oldDomainVerdict(report *model.OldDomain) string {
	if report.Quiet {
		return "Yes"
	}
	return "Not yet, after " + strconv.Itoa(report.QuietDays) + " quiet days"
}
