package pages

import (
	"github.com/axadrn/moin/hub/internal/api"
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/components"
)

// execServices are the services of the live deploy a command can run in:
// the main one first, then the databases.
func execServices(app model.App, deploys []api.Deploy) []string {
	for _, deploy := range deploys {
		if deploy.Number != app.LiveNumber || deploy.Detected == nil || deploy.Detected.Service == "" {
			continue
		}
		services := []string{deploy.Detected.Service}
		for _, database := range deploy.Detected.Databases {
			seen := false
			for _, service := range services {
				seen = seen || service == database.Service
			}
			if database.Service != "" && !seen {
				services = append(services, database.Service)
			}
		}
		return services
	}
	return nil
}

func execServiceOptions(services []string) []components.Option {
	options := make([]components.Option, 0, len(services))
	for _, service := range services {
		options = append(options, components.Option{Value: service, Label: service})
	}
	return options
}

// appExec runs one command in a container of the app, for owners and
// admins: the output streams in as the command writes it. No shell reads
// the command. With one service there is nothing to pick.
templ appExec(app model.App, deploys []api.Deploy) {
	if ctxkeys.WorkspaceMember(ctx).Can(model.WorkspacePermissionManageWorkspace) {
		{{ services := execServices(app, deploys) }}
		if len(services) > 0 {
			@components.Card(components.CardProps{Title: "Run a command"}) {
				<form
					class="moin-stack"
					data-gap="4"
					data-exec-form
					data-exec-url={ "/api/v1/apps/" + app.Link() + "/exec?workspace=" + ctxkeys.Workspace(ctx).Link() }
				>
					<div class="moin-row" data-gap="2" data-phone="stack">
						if len(services) > 1 {
							<div class="moin-width" style="--width:10rem">
								@components.Select(components.SelectProps{ID: "exec-service", Name: "service", Label: "Service", Options: execServiceOptions(services)})
							</div>
						} else {
							<input type="hidden" name="service" value={ services[0] }/>
						}
						<label for="exec-command" class="moin-sr-only">Command</label>
						@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "exec-command", "name": "line", "type": "text", "placeholder": "rails db:migrate", "autocomplete": "off", "autocapitalize": "off", "spellcheck": "false", "required": true, "data-exec-line": true}})
						@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit", Attrs: templ.Attributes{"data-exec-run": true}}) {
							Run
						}
					</div>
					<p class="moin-text moin-muted" data-exec-status hidden></p>
					<div class="moin-bleed moin-tail" data-exec-box hidden>
						<pre class="moin-log moin-inset" data-exec-output></pre>
					</div>
				</form>
				@appExecScript()
			}
		}
	}
}

// appExecScript posts the command to the API and writes the server-sent
// events into the output as they come: output pieces, then done or error.
templ appExecScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const form = document.querySelector("[data-exec-form]");
			if (!form || form.dataset.execBound) return;
			form.dataset.execBound = "true";
			const box = form.querySelector("[data-exec-box]");
			const output = form.querySelector("[data-exec-output]");
			const status = form.querySelector("[data-exec-status]");
			const run = form.querySelector("[data-exec-run]");
			const say = (text, failed) => {
				status.hidden = false;
				status.textContent = text;
				status.classList.toggle("moin-failed", !!failed);
				status.classList.toggle("moin-muted", !failed);
			};
			form.addEventListener("submit", async (event) => {
				event.preventDefault();
				const data = new FormData(form);
				output.textContent = "";
				box.hidden = false;
				run.disabled = true;
				say("Running…", false);
				try {
					const token = document.querySelector('meta[name="csrf-token"]')?.content || "";
					const response = await fetch(form.dataset.execUrl, {
						method: "POST",
						headers: { "Content-Type": "application/json", "X-CSRF-Token": token },
						body: JSON.stringify({ service: data.get("service") || "", line: data.get("line") || "" }),
					});
					if (!response.ok) {
						const body = await response.json().catch(() => ({}));
						const fields = body.error && body.error.fields ? Object.values(body.error.fields).join(" ") : "";
						say(fields || (body.error && body.error.message) || "The command did not run.", true);
						box.hidden = output.textContent === "";
						return;
					}
					const reader = response.body.getReader();
					const decoder = new TextDecoder();
					let buffer = "";
					for (;;) {
						const { value, done } = await reader.read();
						if (done) break;
						buffer += decoder.decode(value, { stream: true });
						let cut;
						while ((cut = buffer.indexOf("\n\n")) >= 0) {
							const block = buffer.slice(0, cut);
							buffer = buffer.slice(cut + 2);
							let name = "message", body = "";
							for (const line of block.split("\n")) {
								if (line.startsWith("event: ")) name = line.slice(7);
								if (line.startsWith("data: ")) body += line.slice(6);
							}
							if (!body) continue;
							const value = JSON.parse(body);
							if (name === "output") {
								// The box keeps the newest line in view while you are at the bottom.
								output.textContent += value.data;
							} else if (name === "done") {
								const notes = [];
								if (value.timed_out) notes.push("stopped waiting after the timeout");
								if (value.truncated) notes.push("output cut at 1 MB");
								const text = (value.timed_out ? "Timed out" : "Exited with " + value.exit_code) + " in " + value.service + (notes.length ? " · " + notes.join(", ") : "");
								say(text, value.timed_out || value.exit_code !== 0);
							} else if (name === "error") {
								say(value.error ? value.error.message : "The command failed.", true);
							}
						}
					}
				} catch (error) {
					say("The connection broke: " + error.message, true);
				} finally {
					run.disabled = false;
					if (output.textContent === "") box.hidden = true;
				}
			});
		})();
	</script>
}
