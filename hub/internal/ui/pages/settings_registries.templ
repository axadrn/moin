package pages

import (
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/kit"
)

// SettingsRegistriesSection is the registry logins your servers pull
// private images built in CI with: the list, each with Remove, and the form
// for another. Saving or removing one answers the whole section.
templ SettingsRegistriesSection(logins []service.RegistryLogin) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<div id="settings-registries" class="flex flex-col gap-6">
		@kit.Section("Registries", nil) {
			@kit.List() {
				if len(logins) == 0 {
					@kit.Row("") {
						<p class="text-sm text-muted-foreground">No registry logins yet.</p>
					}
				}
				for _, login := range logins {
					@kit.RowControl(templ.Attributes{"data-registry": login.Host}) {
						<div class="min-w-0 flex-1">
							<div class="truncate font-mono font-medium">{ login.Host }</div>
							<div class="truncate text-sm text-muted-foreground">{ "as " + login.Username }</div>
						</div>
						@kit.Button(kit.Secondary, "", templ.Attributes{
							"type":       "button",
							"hx-delete":  basePath + "/settings/registries/" + login.Host,
							"hx-target":  "#settings-registries",
							"hx-swap":    "outerHTML",
							"hx-disable": "this",
							"hx-confirm": "Remove the login for " + login.Host + "? Private images from it no longer pull.",
						}) {
							Remove
						}
					}
				}
			}
		}
		@kit.Card("New registry login", nil) {
			<form
				class="flex flex-col gap-4"
				hx-post={ basePath + "/settings/registries" }
				hx-target="#settings-registries"
				hx-swap="outerHTML"
				hx-disable="find button[type='submit']"
			>
				@kit.CSRF()
				<div class="grid items-start gap-4 md:grid-cols-3">
					@formField("Registry", "registry-host", "", "") {
						@kit.Input(templ.Attributes{"id": "registry-host", "aria-describedby": "registry-host-hint", "name": "host", "type": "text", "placeholder": "ghcr.io", "autocomplete": "off", "spellcheck": "false", "autocapitalize": "off", "required": true})
					}
					@formField("Username", "registry-username", "", "") {
						@kit.Input(templ.Attributes{"id": "registry-username", "aria-describedby": "registry-username-hint", "name": "username", "type": "text", "autocomplete": "off", "autocapitalize": "off", "required": true})
					}
					@formField("Password or token", "registry-password", "", "") {
						@kit.Input(templ.Attributes{"id": "registry-password", "aria-describedby": "registry-password-hint", "name": "password", "type": "password", "autocomplete": "new-password", "required": true})
					}
				</div>
				<div class="flex justify-end">
					@kit.Button(kit.Secondary, "", templ.Attributes{"type": "submit"}) {
						Save login
					}
				</div>
			</form>
		}
	</div>
}
