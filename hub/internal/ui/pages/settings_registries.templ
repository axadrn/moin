package pages

import (
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/kit"
	"github.com/axadrn/moin/hub/internal/ui/components"
)

// SettingsRegistriesSection is the registry logins your servers pull
// private images built in CI with: the list, each with Remove, and the form
// for another. Saving or removing one answers the whole section.
templ SettingsRegistriesSection(logins []service.RegistryLogin) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<div id="settings-registries" class="moin-stack" data-gap="6">
		<section class="moin-section">
			<div class="moin-section-head">
				<h2>Registries</h2>
			</div>
			@components.List() {
				if len(logins) == 0 {
					@components.Item(components.ItemProps{}) {
						<p class="moin-small moin-muted">No registry logins yet.</p>
					}
				}
				for _, login := range logins {
					@kit.RowControl(templ.Attributes{"data-registry": login.Host}) {
						<div class="min-w-0 flex-1">
							<div class="truncate font-mono font-medium">{ login.Host }</div>
							<div class="truncate text-sm text-muted-foreground">{ "as " + login.Username }</div>
						</div>
						@components.Button(components.ButtonProps{Attrs: templ.Attributes{
							"type":       "button",
							"hx-delete":  basePath + "/settings/registries/" + login.Host,
							"hx-target":  "#settings-registries",
							"hx-swap":    "outerHTML",
							"hx-disable": "this",
							"hx-confirm": "Remove the login for " + login.Host + "? Private images from it no longer pull.",
						}}) {
							Remove
						}
					}
				}
			}
		</section>
		@components.Card(components.CardProps{Title: "New registry login"}) {
			<form
				class="moin-stack" data-gap="4"
				hx-post={ basePath + "/settings/registries" }
				hx-target="#settings-registries"
				hx-swap="outerHTML"
				hx-disable="find button[type='submit']"
			>
				@components.CSRF()
				<div class="moin-grid" data-cols="3">
					@formField("Registry", "registry-host", "", "") {
						@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "registry-host", "aria-describedby": "registry-host-hint", "name": "host", "type": "text", "placeholder": "ghcr.io", "autocomplete": "off", "spellcheck": "false", "autocapitalize": "off", "required": true}})
					}
					@formField("Username", "registry-username", "", "") {
						@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "registry-username", "aria-describedby": "registry-username-hint", "name": "username", "type": "text", "autocomplete": "off", "autocapitalize": "off", "required": true}})
					}
					@formField("Password or token", "registry-password", "", "") {
						@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "registry-password", "aria-describedby": "registry-password-hint", "name": "password", "type": "password", "autocomplete": "new-password", "required": true}})
					}
				</div>
				<div class="moin-row" data-end>
					@components.Button(components.ButtonProps{Type: "submit"}) {
						Save login
					}
				</div>
			</form>
		}
	</div>
}
