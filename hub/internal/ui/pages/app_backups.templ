package pages

import (
	"net/url"
	"strconv"
	"strings"
	"time"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/internal/human"
	"github.com/axadrn/moin/protocol"
)

// BackupsView is the backups of an app: its bucket, the buckets of the
// workspace to pick from, Older the ones the app left, and what the daemon
// reports about its databases with the moments to go back to.
type BackupsView struct {
	App       model.App
	Bucket    *service.Bucket
	Buckets   []service.Bucket
	Older     []service.Bucket
	Databases []service.DatabaseBackups
	// Restore is the newest restore of the open database of the last day.
	Restore *service.Restore
	// ScheduleInFile says compose.yml sets how often and how long.
	ScheduleInFile bool
	// Error says why the server could not report its backups.
	Error string
	Now   time.Time
}

// backupOf is what the daemon reports about one database.
func (view BackupsView) backupOf(database string) (service.DatabaseBackups, bool) {
	for _, backup := range view.Databases {
		if backup.Database == database {
			return backup, true
		}
	}
	return service.DatabaseBackups{}, false
}

// othersOf are the other databases of a Postgres service, which moin
// backs up too: postgres-db/<name>.
func (view BackupsView) othersOf(database string) []service.DatabaseBackups {
	others := []service.DatabaseBackups{}
	for _, backup := range view.Databases {
		if strings.HasPrefix(backup.Database, database+"/") {
			others = append(others, backup)
		}
	}
	return others
}

// BackupSettings is where the backups of all the app's databases go: the
// bucket. Without a bucket, the way to add one.
templ BackupSettings(view BackupsView) {
	<div id="data-backups">
		<section class="moin-section">
			<div class="moin-section-head">
				<h2>Backups</h2>
			</div>
			@components.List() {
				if view.Bucket == nil {
					@components.Item(components.ItemProps{Href: ctxkeys.AppBasePath(ctx) + "/bucket"}) {
						<span class="moin-fill moin-item-name" data-add-bucket>Add your bucket</span>
					}
				} else {
					@components.Item(components.ItemProps{Href: ctxkeys.AppBasePath(ctx) + "/bucket", Name: "Bucket"}) {
						<span class="moin-item-value" data-bucket={ view.Bucket.Name }>{ view.Bucket.Name }</span>
					}
					@components.Item(components.ItemProps{Name: "Folder"}) {
						<span class="moin-item-value moin-mono" data-bucket-folder>{ view.Bucket.AppFolder(&view.App) }</span>
					}
					if len(view.Older) > 0 {
						@components.Item(components.ItemProps{Name: "Left"}) {
							<span class="moin-item-value" data-bucket-older>{ olderNames(view.Older) }</span>
						}
					}
					if len(view.Buckets) > 1 {
						@bucketDisclosure("Use another bucket") {
							@AppBucketForm(view)
						}
					}
				}
			}
		</section>
	</div>
}

// AppBucketForm picks the bucket of the app. It asks first: the copies
// start again in the other bucket.
templ AppBucketForm(view BackupsView) {
	<form
		id="app-bucket-form"
		class="moin-row"
		data-gap="3"
		data-phone="stack"
		hx-post={ ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Link() + "/bucket" }
		hx-target="#data-backups"
		hx-select="#data-backups"
		hx-swap="outerHTML"
		hx-disable="find button[type='submit']"
		hx-confirm={ "Move the uploads and backups of " + view.App.Name + " to this bucket? Its copies start again there; what is in " + view.Bucket.Name + " stays." }
		data-confirm-action="Move"
	>
		@components.CSRF()
		@components.Select(components.SelectProps{ID: "app-bucket", Name: "bucket", Label: "Bucket", Options: appBucketOptions(view.Buckets), Value: appBucketValue(view.App)})
		@components.Button(components.ButtonProps{Type: "submit"}) {
			Move
		}
	</form>
}

// appBucketDefault is the select's value for "the workspace's default".
// Bucket names never start with a dash, so it is no bucket's name.
const appBucketDefault = "-default"

func appBucketValue(app model.App) string {
	if app.BucketName == "" {
		return appBucketDefault
	}
	return app.BucketName
}

// appBucketOptions are the choices: the default, whichever it is, then
// each bucket by name.
func appBucketOptions(buckets []service.Bucket) []components.Option {
	options := []components.Option{}
	for _, bucket := range buckets {
		if bucket.Default {
			options = append(options, components.Option{Value: appBucketDefault, Label: "The default (" + bucket.Name + ")"})
		}
	}
	for _, bucket := range buckets {
		options = append(options, components.Option{Value: bucket.Name, Label: bucket.Name})
	}
	return options
}

// DatabaseBackups is the backup of one database: one row how it stands,
// how often and how long, Download a copy, then
// the moments to go back to with Restore. A restore shows it runs in the
// first row while it does.
templ DatabaseBackups(view BackupsView, database string) {
	{{ backup, known := view.backupOf(database) }}
	<div id="db-backups" class="moin-stack" data-gap="6" data-busy-scope data-database-backup={ database }>
		if view.Bucket == nil {
			<section class="moin-section">
				<div class="moin-section-head">
					<h2>Backups</h2>
				</div>
				@components.List() {
					@components.Item(components.ItemProps{Href: ctxkeys.AppBasePath(ctx) + "/bucket"}) {
						<span class="moin-fill moin-item-name" data-add-bucket>Add your bucket</span>
					}
				}
			</section>
		} else if view.Error != "" {
			<section class="moin-section">
				<div class="moin-section-head">
					<h2>Backups</h2>
				</div>
				@dataError(view.Error)
			</section>
		} else {
			<section class="moin-section">
				<div class="moin-section-head">
					<h2>Backups</h2>
				</div>
				@components.List() {
					@backupState(backup, known, database, view.Now)
					@backupRestore(view, database)
					if view.ScheduleInFile {
						@scheduleInFile(view, backup)
					} else {
						@backupSchedule(view, backup, database)
					}
					@backupDownload(view, backup, database)
				}
			</section>
			@backupGoBack(view, backup, database, database, "Go back to")
			for _, other := range view.othersOf(database) {
				<section class="moin-section">
					<div class="moin-section-head">
						<h2>{ databaseName(other.Database) }</h2>
					</div>
					@components.List() {
						@backupState(other, true, other.Database, view.Now)
						@backupDownload(view, other, other.Database)
					}
				</section>
				@backupGoBack(view, other, other.Database, database, "Go back to · "+databaseName(other.Database))
			}
		}
	</div>
	@backupScript.Once() {
		<script nonce={ templ.GetNonce(ctx) }>
			// Restore works once a moment is picked.
			document.addEventListener("change", (event) => {
				const form = event.target.closest?.("[data-restore]");
				if (!form || event.target.name !== "moment") return;
				const button = form.querySelector("[data-restore-button]");
				if (button) button.disabled = false;
			});
		</script>
	}
}

var backupScript = templ.NewOnceHandle()

// backupGoBack is the list of moments of one database to go back to,
// with Restore; page is the database the page is about.
templ backupGoBack(view BackupsView, backup service.DatabaseBackups, database, page, title string) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Link() }}
	// When the bucket cannot be reached, nobody knows there is nothing.
	if len(backup.Moments) > 0 || backup.Problem == "" {
		<section class="moin-section">
			<div class="moin-section-head">
				<h2>{ title }</h2>
			</div>
			<form
				class="moin-stack"
				data-gap="2"
				hx-post={ appPath + "/backups/restore" }
				hx-target="#db-backups"
				hx-swap="outerHTML"
				hx-disable="find button[type='submit']"
				hx-confirm={ "Restore " + databaseName(database) + " to the moment you picked? It replaces the data there now. moin keeps the data of now beside it, so you can undo this; the app stops for a moment." }
				data-confirm-name={ view.App.Name }
				data-confirm-action="Restore"
				data-restore
				data-busy-from
			>
				@components.CSRF()
				<input type="hidden" name="database" value={ database }/>
				<input type="hidden" name="page" value={ page }/>
				@components.List() {
					if len(backup.Moments) == 0 {
						@components.Item(components.ItemProps{}) {
							<p class="moin-fill moin-text moin-muted">Nothing to go back to yet.</p>
						}
					}
					for _, moment := range backup.Moments {
						@momentPick(moment, view.Now)
					}
				}
				if len(backup.Moments) > 0 {
					<div class="moin-row" data-end>
						@components.Button(components.ButtonProps{Type: "submit", Attrs: templ.Attributes{"disabled": true, "data-restore-button": true}}) {
							Restore
						}
					</div>
				}
			</form>
		</section>
	}
}

// backupState is the first row of a database's backup: backed up and when
// it was last checked, or why it does not work in one sentence with the
// details under it. While a restore runs, it says so.
templ backupState(backup service.DatabaseBackups, known bool, database string, now time.Time) {
	@components.Item(components.ItemProps{Attrs: templ.Attributes{"data-backup-state": true}}) {
		<div class="moin-row moin-fill" data-gap="3" data-show-busy role="status">
			@components.Dot(components.DotProps{State: components.StateRunning})
			<span class="moin-item-name">Restoring { databaseName(database) }</span>
		</div>
		<div class="moin-row moin-fill" data-gap="3" data-hide-busy>
			switch  {
				case !known:
					@components.Dot(components.DotProps{State: components.StateRunning})
					<span class="moin-fill moin-item-name">Starting</span>
				case backup.Problem != "":
					@components.Dot(components.DotProps{State: components.StateFailed})
					<div class="moin-fill">
						<div class="moin-strong moin-failed" data-backup-problem>{ backup.Problem }</div>
						<details class="moin-details moin-text moin-muted">
							<summary>Show details</summary>
							<p class="moin-mono moin-small moin-break" data-backup-error>{ backup.Error }</p>
						</details>
					</div>
				case backup.CopiedAt != nil:
					@components.Dot(components.DotProps{State: components.StateLive})
					<span class="moin-fill moin-item-name" data-checked?={ backup.CheckedAt != nil } title={ checkedStamp(backup) }>{ "Last copy " + human.Ago(*backup.CopiedAt, now) + " · " + checkedText(backup, now) }</span>
				default:
					@components.Dot(components.DotProps{State: components.StateRunning})
					<span class="moin-fill moin-item-name">Starting</span>
			}
		</div>
	}
}

func checkedText(backup service.DatabaseBackups, now time.Time) string {
	if backup.CheckedAt == nil {
		return "not checked yet"
	}
	return "checked " + human.Ago(*backup.CheckedAt, now)
}

func checkedStamp(backup service.DatabaseBackups) string {
	if backup.CheckedAt == nil {
		return ""
	}
	return "Restored the newest copy into a throwaway database and read it " + stamp(*backup.CheckedAt)
}

// momentPick is one moment to pick for a restore: what it is and when.
templ momentPick(moment service.Moment, now time.Time) {
	@components.Item(components.ItemProps{Pick: true, Attrs: templ.Attributes{"name": "moment", "value": moment.ID, "data-moment": moment.ID}}) {
		<span class="moin-fill moin-strong moin-break">{ moment.Label }</span>
		<span class="moin-item-value" title={ stamp(moment.At) }>{ momentTime(moment.At, now) }</span>
	}
}

// momentTime is when a moment was, in UTC: the time today, else the day.
func momentTime(at, now time.Time) string {
	at, now = at.UTC(), now.UTC()
	if at.YearDay() == now.YearDay() && at.Year() == now.Year() {
		return at.Format("15:04 UTC")
	}
	return at.Format("Jan 2, 15:04 UTC")
}

// backupRestore is how the newest restore stands: running, which follows
// the app's changes until it ends, then failed with why, or done for an
// hour.
templ backupRestore(view BackupsView, database string) {
	{{ restore := view.Restore }}
	if restore != nil && restore.Active() {
		@components.Item(components.ItemProps{Attrs: templ.Attributes{"hx-get": databaseURL(ctx, view.App.Name, database), "hx-trigger": "apps from:body", "hx-select": "#db-backups", "hx-target": "#db-backups", "hx-swap": "outerHTML", "data-restore-running": true}}) {
			@components.Dot(components.DotProps{State: components.StateRunning})
			<div class="moin-fill">
				<div class="moin-item-name">Restoring { databaseName(database) } to { lowerFirst(restore.To) }</div>
				if restore.State == service.RestoreUnknown {
					<div class="moin-small moin-muted" data-restore-unknown>The server is offline; moin asks it how the restore went when it is back.</div>
				}
			</div>
		}
	} else if restore != nil && restore.State == service.RestoreFailed {
		@components.Item(components.ItemProps{Attrs: templ.Attributes{"data-restore-failed": true}}) {
			@components.Dot(components.DotProps{State: components.StateFailed})
			<div class="moin-fill">
				if strings.HasPrefix(restore.Error, service.RestoreNoWord) {
					<div class="moin-strong moin-failed">Unknown how the restore to { lowerFirst(restore.To) } ended: check the app</div>
				} else {
					<div class="moin-strong moin-failed">The restore to { lowerFirst(restore.To) } failed</div>
				}
				<details class="moin-details moin-small moin-muted">
					<summary>Show details</summary>
					<p class="moin-mono moin-small moin-break">{ restore.Error }</p>
				</details>
			</div>
		}
	} else if restore != nil && restore.FinishedAt != nil && view.Now.Sub(*restore.FinishedAt) < time.Hour {
		@components.Item(components.ItemProps{Attrs: templ.Attributes{"data-restore-done": true}}) {
			<span class="moin-fill moin-truncate moin-muted">Restored to { lowerFirst(restore.To) } { human.Ago(*restore.FinishedAt, view.Now) }</span>
		}
	}
}

// lowerFirst starts a label in the middle of a sentence: "At 14:25",
// "before v12".
func lowerFirst(label string) string {
	if label == "" {
		return label
	}
	return strings.ToLower(label[:1]) + label[1:]
}

// backupSchedule are the rows of how often moin copies the app's
// databases and how long it keeps each copy. Each saves itself; they
// hold for every database of the app.
templ backupSchedule(view BackupsView, backup service.DatabaseBackups, database string) {
	{{ path := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Link() + "/backups/schedule" }}
	{{ form := templ.Attributes{"hx-post": path, "hx-trigger": "change", "hx-target": "#db-backups", "hx-swap": "outerHTML", "style": "--select-width:11rem"} }}
	@components.Item(components.ItemProps{Form: true, For: "backup-every", Name: "How often", Attrs: form}) {
		@components.CSRF()
		@scheduleFields(view.App, database, "every")
		@components.Select(components.SelectProps{ID: "backup-every", Name: "every", Label: "How often", Options: everyOptions(), Value: strconv.Itoa(view.App.BackupEvery)})
	}
	@components.Item(components.ItemProps{Form: true, For: "backup-keep", Name: "Keep", Attrs: form}) {
		@components.CSRF()
		@scheduleFields(view.App, database, "keep")
		@components.Select(components.SelectProps{ID: "backup-keep", Name: "keep", Label: "Keep", Options: keepOptions(), Value: strconv.Itoa(view.App.BackupKeep)})
	}
}

// scheduleInFile shows the schedule compose.yml sets. Only the file changes it.
templ scheduleInFile(view BackupsView, backup service.DatabaseBackups) {
	@components.Item(components.ItemProps{Name: "How often", Note: "from compose.yml"}) {
		<span class="moin-item-value" data-schedule-in-file>{ service.EveryText(view.App.BackupEvery) }</span>
	}
	@components.Item(components.ItemProps{Name: "Keep", Note: "from compose.yml"}) {
		<span class="moin-item-value">{ service.KeepText(view.App.BackupKeep) }</span>
	}
}

// scheduleFields are the settings a row does not change, so each row
// sends both.
templ scheduleFields(app model.App, database, except string) {
	<input type="hidden" name="database" value={ database }/>
	if except != "every" {
		<input type="hidden" name="every" value={ strconv.Itoa(app.BackupEvery) }/>
	}
	if except != "keep" {
		<input type="hidden" name="keep" value={ strconv.Itoa(app.BackupKeep) }/>
	}
}

func everyOptions() []components.Option {
	options := []components.Option{}
	for _, every := range protocol.Everies {
		options = append(options, components.Option{Value: strconv.Itoa(every), Label: upperFirst(service.EveryText(every))})
	}
	return options
}

func keepOptions() []components.Option {
	options := []components.Option{}
	for _, keep := range protocol.Keeps {
		options = append(options, components.Option{Value: strconv.Itoa(keep), Label: service.KeepText(keep)})
	}
	return options
}

func upperFirst(text string) string {
	if text == "" {
		return text
	}
	return strings.ToUpper(text[:1]) + text[1:]
}

// backupDownload is the row that downloads the newest copy, straight from
// the user's own bucket through a link that lasts 15 minutes.
templ backupDownload(view BackupsView, backup service.DatabaseBackups, database string) {
	if len(backup.Copies) > 0 {
		@components.Item(components.ItemProps{Button: true, Attrs: templ.Attributes{"id": "db-download", "data-download": true, "hx-get": ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Link() + "/backups/download?database=" + url.QueryEscape(database), "hx-swap": "none", "hx-disable": "this"}}) {
			<span class="moin-fill moin-item-name">Download a copy</span>
			<span class="moin-item-value">{ human.Size(float64(backup.Copies[0].Size)) }</span>
		}
	}
}

func olderNames(buckets []service.Bucket) string {
	names := make([]string, 0, len(buckets))
	for _, bucket := range buckets {
		names = append(names, bucket.Name)
	}
	return strings.Join(names, ", ")
}

func orAWS(endpoint string) string {
	if endpoint == "" {
		return "AWS S3"
	}
	return endpoint
}
