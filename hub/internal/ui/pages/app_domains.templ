package pages

import (
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/protocol"
	"strings"
)

// DomainsView is what the Domains section shows.
type DomainsView struct {
	App model.App
	// Checks are the domains; only one added or checked was looked up
	// (Checked), opening the page looks up none.
	Checks []service.DomainCheck
	// Server runs the app.
	Server  model.Server
	Instant service.Instant
	// File is the x-moin block of the live deploy: what it sets is locked.
	File protocol.Config
}

// AppDomains is where an app is reached: its domains, the instant address
// and the password in front of it. A domain says whether it points at the
// server once it was added or checked; opening the page waits on no DNS.
templ AppDomains(view DomainsView) {
	{{ domainsPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Link() + "/domains" }}
	<div id="app-domains" class="moin-stack" data-gap="6">
		<section class="moin-section">
			<div class="moin-section-head">
				<h2>Domains</h2>
			</div>
			@components.List() {
				for _, check := range view.Checks {
					@domainRow(check, view.App.Name, domainsPath)
				}
				if options := canonicalOptions(view.Checks); len(options) > 2 && !fromCompose(view.Checks) {
					@canonicalRow(options, view.App.Canonical, domainsPath)
				}
				if fromCompose(view.Checks) {
					@components.Item(components.ItemProps{Attrs: templ.Attributes{"data-domains-from-compose": true}}) {
						<p class="moin-fill moin-text moin-muted">Change them in compose.yml (<span class="moin-mono">x-moin.domains</span>) and deploy.</p>
					}
				} else {
					@addDomainRow(domainsPath)
				}
			}
		</section>
		@instantSection(view, domainsPath)
		@passwordSection(view.App, domainsPath, view.File.Protect)
	</div>
}

// canonicalRow picks the domain the others redirect to; it saves itself.
templ canonicalRow(options []components.Option, canonical, domainsPath string) {
	@components.Item(components.ItemProps{Form: true, For: "canonical-domain", Name: "Canonical", Attrs: templ.Attributes{"hx-post": domainsPath + "/canonical", "hx-trigger": "change", "hx-target": "#app-domains", "hx-swap": "outerHTML", "data-canonical": true, "style": "--select-width:min(16rem,50vw)"}}) {
		@components.CSRF()
		@components.Select(components.SelectProps{ID: "canonical-domain", Name: "domain", Label: "Canonical domain", Options: options, Value: canonical})
	}
}

// domainRow is one domain: its name, a quiet word for what it is
// (canonical, a service, from compose.yml), what its DNS says once checked,
// and its actions. On a phone the actions go under the name when they do
// not fit next to it.
templ domainRow(check service.DomainCheck, appName, domainsPath string) {
	@components.Item(components.ItemProps{Attrs: templ.Attributes{"data-domain": check.Domain, "data-control": true}}) {
		<div class="moin-stack moin-fill" data-gap="1" style="--fill-min:9rem">
			<a href={ templ.SafeURL("https://" + check.Domain) } target="_blank" rel="noopener" class="moin-item-name moin-link" data-quiet>{ check.Domain }</a>
			if note := domainNote(check); note != "" {
				<div
					class="moin-item-note"
					if check.Service != "" {
						data-domain-service={ check.Service }
					}
				>{ note }</div>
			}
			if check.Checked {
				<div data-domain-checked>
					if check.Points {
						@components.Status(components.StatusProps{State: components.StateLive}) {
							Points here
						}
					} else {
						@components.Status(components.StatusProps{State: components.StateWaiting}) {
							Set its { check.Advice }
						}
					}
				</div>
			}
		</div>
		<div class="moin-row" data-gap="2">
			@components.Button(components.ButtonProps{Attrs: templ.Attributes{
				"hx-get":     domainsPath + "/detail?check=" + check.Domain,
				"hx-target":  "#app-domains",
				"hx-swap":    "outerHTML",
				"hx-disable": "this",
				"aria-label": "Check the DNS of " + check.Domain,
				"data-check": check.Domain,
			}}) {
				Check
			}
			if !check.FromCompose {
				@components.Button(components.ButtonProps{Icon: true, Kind: components.Danger, Attrs: templ.Attributes{
					"aria-label":          "Remove " + check.Domain,
					"title":               "Remove " + check.Domain,
					"hx-post":             domainsPath + "/remove",
					"hx-vals":             `{"domain": "` + check.Domain + `", "service": "` + check.Service + `"}`,
					"hx-target":           "#app-domains",
					"hx-swap":             "outerHTML",
					"hx-disable":          "this",
					"hx-confirm":          "Remove " + check.Domain + "? " + appName + " stops answering on it at the next restart.",
					"data-confirm-action": "Remove",
				}}) {
					@components.Icon("x")
				}
			}
		</div>
	}
}

// addDomainRow is the field that adds a domain, to the main service or to
// another service of compose.yml.
templ addDomainRow(domainsPath string) {
	@components.Item(components.ItemProps{Form: true, Attrs: templ.Attributes{"hx-post": domainsPath + "/add", "hx-target": "#app-domains", "hx-swap": "outerHTML", "hx-disable": "find button[type='submit']"}}) {
		@components.CSRF()
		<div class="moin-fill">
			@components.Field(components.FieldProps{Label: "Add a domain", For: "domain-name"}) {
				<div class="moin-row" data-gap="2" data-phone="stack">
					@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "domain-name", "name": "domain", "type": "text", "placeholder": "my-app.example.com", "autocomplete": "off", "autocapitalize": "off", "spellcheck": "false", "required": true}})
					<label for="domain-service" class="moin-sr-only">Service, empty for the main one</label>
					<div class="moin-width" style="--width:10rem">
						@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "domain-service", "name": "service", "type": "text", "placeholder": "service", "autocomplete": "off", "autocapitalize": "off", "spellcheck": "false", "title": "A service of compose.yml other than the main one, such as api"}})
					</div>
					@components.Button(components.ButtonProps{Type: "submit", Attrs: templ.Attributes{"data-add-domain": true}}) {
						Add
					}
				</div>
			}
		</div>
	}
}

// instantSection is the instant address: a switch, where it is or why the
// app has none, its provider and its password.
templ instantSection(view DomainsView, domainsPath string) {
	{{ instant := view.Instant }}
	{{ on := instant.Provider != "" && instant.Provider != "off" }}
	<section class="moin-section">
		<div class="moin-section-head">
			<h2>Instant address</h2>
		</div>
		<div data-instant>
			@components.List() {
				@components.Item(components.ItemProps{Form: true, Attrs: templ.Attributes{"hx-post": domainsPath + "/instant", "hx-trigger": "change", "hx-target": "#app-domains", "hx-swap": "outerHTML", "hx-disable": "find input[type='checkbox']"}}) {
					@components.CSRF()
					<input type="hidden" name="switch" value="1"/>
					<div class="moin-fill">
						if instant.URL != "" {
							<a href={ templ.SafeURL(instant.URL) } target="_blank" rel="noopener" class="moin-item-name moin-link" data-quiet data-instant-url>{ instant.Host }</a>
						} else if on {
							<div class="moin-small moin-muted" data-instant-reason>{ instant.Reason }</div>
						} else {
							<div class="moin-strong moin-muted" data-instant-reason>Off</div>
						}
					</div>
					if view.File.Instant == "" {
						@components.Switch(components.SwitchProps{Attrs: templ.Attributes{"id": "instant-on", "name": "on", "value": "1", "checked": on, "aria-label": "Instant address", "data-instant-switch": true}})
					} else {
						<span class="moin-item-value" data-instant-in-file>from compose.yml</span>
					}
				}
				if on {
					if view.File.Instant == "" {
						@components.Item(components.ItemProps{Form: true, For: "instant-provider", Name: "Provider", Attrs: templ.Attributes{"hx-post": domainsPath + "/instant", "hx-trigger": "change", "hx-target": "#app-domains", "hx-swap": "outerHTML", "data-instant-provider": true}}) {
							@components.CSRF()
							@components.Select(components.SelectProps{ID: "instant-provider", Name: "provider", Label: "Provider", Options: instantOptions(), Value: instant.Provider})
						}
					}
					if instant.URL != "" {
						@components.Item(components.ItemProps{Form: true, For: "instant-password-on", Name: "Password", Note: instantSignIn(instant), Attrs: templ.Attributes{"hx-post": domainsPath + "/instant-password", "hx-trigger": "change", "hx-target": "#app-domains", "hx-swap": "outerHTML", "hx-disable": "find input[type='checkbox']"}}) {
							@components.CSRF()
							<input type="hidden" name="password" value="1"/>
							@components.Switch(components.SwitchProps{Attrs: templ.Attributes{"id": "instant-password-on", "name": "on", "value": "1", "checked": !instant.Open}})
						}
						if !instant.Open && !instant.OwnPassword {
							if instant.Password != "" {
								@components.Item(components.ItemProps{}) {
									<span class="moin-fill moin-truncate moin-mono moin-text moin-all" data-instant-password>{ instant.Password }</span>
								}
							} else {
								@components.Item(components.ItemProps{Button: true, Name: "Show password", Attrs: templ.Attributes{"hx-get": domainsPath + "/detail?show=true", "hx-target": "#app-domains", "hx-swap": "outerHTML", "hx-disable": "this", "data-instant-show": true}})
							}
						}
					}
				}
			}
		</div>
	</section>
}

// passwordSection is the password in front of the app: off, a switch
// opens its fields; on, who signs in and Remove.
templ passwordSection(app model.App, domainsPath string, required bool) {
	<section class="moin-section">
		<div class="moin-section-head">
			<h2>Password</h2>
		</div>
		if app.Protect != "" {
			@components.List() {
				@components.Item(components.ItemProps{Name: "Sign in as " + protectUser(app)}) {
					<span class="moin-small moin-muted" data-protected>On</span>
				}
				if required {
					@components.Item(components.ItemProps{}) {
						<p class="moin-fill moin-text moin-muted" data-protect-in-file>Required by compose.yml.</p>
					}
				} else {
					@components.Item(components.ItemProps{Button: true, Danger: true, Name: "Remove password", Attrs: templ.Attributes{
						"hx-post":        domainsPath + "/unprotect",
						"hx-target":      "#app-domains",
						"hx-swap":        "outerHTML",
						"hx-disable":     "this",
						"hx-confirm":     "Remove the password? Anyone with the link can open " + app.Name + " after the next restart.",
						"data-unprotect": true,
					}})
				}
			}
		} else {
			@components.List() {
				@components.Expand(components.ExpandProps{Name: "Ask for a password"}) {
					@components.Item(components.ItemProps{Form: true, Attrs: templ.Attributes{"id": "protect-form", "hx-post": domainsPath + "/protect", "hx-target": "#app-domains", "hx-swap": "outerHTML", "hx-disable": "find button[type='submit']"}}) {
						@components.CSRF()
						<div class="moin-stack moin-fill" data-gap="4">
							<div class="moin-grid">
								@components.Field(components.FieldProps{Label: "Username", For: "protect-user"}) {
									@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "protect-user", "name": "username", "type": "text", "value": "moin", "autocomplete": "off", "autocapitalize": "off", "spellcheck": "false", "required": true}})
								}
								@components.Field(components.FieldProps{Label: "Password", For: "protect-password"}) {
									@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "protect-password", "name": "password", "type": "password", "autocomplete": "new-password", "required": true, "minlength": "8", "maxlength": "72", "placeholder": "8 to 72 characters"}})
								}
							</div>
							<div class="moin-row" data-end>
								@components.Button(components.ButtonProps{Type: "submit", Attrs: templ.Attributes{"data-protect": true}}) {
									Set password
								}
							</div>
						</div>
					}
				}
			}
		}
	</section>
}

// instantOptions are the providers of the instant address.
func instantOptions() []components.Option {
	options := []components.Option{}
	for _, provider := range protocol.InstantProviders {
		options = append(options, components.Option{Value: provider, Label: provider})
	}
	return options
}

// instantSignIn is who signs in on the instant address, and with what.
func instantSignIn(instant service.Instant) string {
	switch {
	case instant.Open:
		return ""
	case instant.OwnPassword:
		return "Sign in as " + instant.User + " with the app's password"
	}
	return "Sign in as " + instant.User
}

// domainNote is the quiet words under a domain: canonical, its service,
// from compose.yml.
func domainNote(check service.DomainCheck) string {
	var words []string
	if check.Canonical {
		words = append(words, "canonical")
	}
	if check.Service != "" {
		words = append(words, "service "+check.Service)
	}
	if check.FromCompose {
		words = append(words, "from compose.yml")
	}
	return strings.Join(words, " · ")
}

// canonicalOptions are the domains of the main service one can be the
// canonical of, and none.
func canonicalOptions(checks []service.DomainCheck) []components.Option {
	options := []components.Option{{Value: "", Label: "None"}}
	for _, check := range checks {
		if check.Service == "" {
			options = append(options, components.Option{Value: check.Domain, Label: check.Domain})
		}
	}
	return options
}

// fromCompose says x-moin.domains in compose.yml sets the domains of the
// main service.
func fromCompose(checks []service.DomainCheck) bool {
	return len(checks) > 0 && checks[0].FromCompose && checks[0].Service == ""
}

func orDash(value string) string {
	if value == "" {
		return "-"
	}
	return value
}

func protectUser(app model.App) string {
	for index, char := range app.Protect {
		if char == ':' {
			return app.Protect[:index]
		}
	}
	return "moin"
}
