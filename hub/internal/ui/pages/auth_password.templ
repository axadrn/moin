package pages

import (
	"github.com/axadrn/moin/hub/internal/config"
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// AuthPassword signs in with email and password, for those who set one.
templ AuthPassword(errorMsg string) {
	@authScreen(layouts.SEOProps{Title: "Sign in", Description: "Sign in with your password"}, "Sign in") {
		@authStack() {
			@AuthPasswordForm("", errorMsg)
			if config.GoogleOAuthEnabled || ctxkeys.RenderConfig(ctx).GitHubLogin {
				@authOr()
				if ctxkeys.RenderConfig(ctx).GitHubLogin {
					@components.Button(components.ButtonProps{Href: "/auth/github"}) {
						@components.Icon("git-hub")
						Continue with GitHub
					}
				}
				if config.GoogleOAuthEnabled {
					@components.Button(components.ButtonProps{Href: "/auth/google"}) {
						@components.Icon("google")
						Continue with Google
					}
				}
			}
			@authLink("/auth") {
				Email me a link instead
			}
		}
		@authTerms()
	}
}
