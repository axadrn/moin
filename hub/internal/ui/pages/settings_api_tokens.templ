package pages

import (
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/ui/parts"
)

// SettingsAPITokensSection is the API tokens of the tokens tab: a new
// token once it is made, the list, and the form for another. Requests
// replace its parts by id.
templ SettingsAPITokensSection(view APITokensView) {
	<div id="api-token-reveal" class="empty:hidden" hx-swap-oob="true"></div>
	<section class="kit-section">
		<div class="kit-section-head">
			<h2>API tokens</h2>
		</div>
		@APITokenList(view)
	</section>
	@APITokenCreate(view)
}

// APITokenCreate is the card that makes a token. A successful create
// replaces it, which empties the form.
templ APITokenCreate(view APITokensView) {
	<div id="api-token-create" hx-swap-oob="true">
		@parts.Card(parts.CardProps{Title: "New token"}) {
			@APITokenCreateForm(view, false)
		}
	</div>
}

// APITokenCreateForm is the create form. With oob it replaces the form on
// the page, to show what is wrong with it.
templ APITokenCreateForm(view APITokensView, oob bool) {
	{{ form := view.Form }}
	<form
		id="api-token-form"
		if oob {
			hx-swap-oob="true"
		}
		class="kit-stack" data-gap="4"
		hx-post={ ctxkeys.AppBasePath(ctx) + "/settings/api-tokens" }
		hx-swap="none"
		hx-disable="find button[type='submit']"
	>
		@parts.CSRF()
		<div class="kit-grid" data-cols="2">
			@formField("Name", "api-token-name", "", form.Errors["name"]) {
				@parts.Input(parts.InputProps{Attrs: templ.Attributes{"id": "api-token-name", "name": "name", "type": "text", "value": form.Name, "placeholder": "Like ci or Claude", "required": true, "maxlength": "64", "autocomplete": "off", "aria-invalid": ariaInvalid(form.Errors["name"]), "aria-describedby": "api-token-name-hint"}})
			}
			@formField("Expires", "api-token-expiry", "", form.Errors["expiry"]) {
				@parts.Select(parts.SelectProps{ID: "api-token-expiry", Name: "expiry", Label: "Expires", Options: apiTokenExpiryOptions, Value: form.Expiry})
			}
			if len(view.Workspaces) > 0 {
				@formField("Workspace", "api-token-workspace", "", form.Errors["workspace_id"]) {
					@parts.Select(parts.SelectProps{ID: "api-token-workspace", Name: "workspace_id", Label: "Workspace", Options: view.workspaceOptions(), Value: form.WorkspaceID})
				}
			}
			@formField("Access", "access-"+form.Access, "", form.Errors["access"]) {
				@parts.Choice(parts.ChoiceProps{Name: "access", Label: "Access", Options: apiTokenAccessOptions, Checked: form.Access})
			}
		</div>
		<div class="kit-row" data-end>
			@parts.Button(parts.ButtonProps{Kind: parts.Primary, Type: "submit"}) {
				Create token
			}
		</div>
	</form>
}

// APITokenList lists the tokens, each with Revoke.
templ APITokenList(view APITokensView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<div id="api-token-list" hx-swap-oob="true">
		@parts.List() {
			if len(view.Tokens) == 0 {
				@parts.Item(parts.ItemProps{}) {
					<p class="kit-small kit-muted">No tokens yet.</p>
				}
			}
			for _, token := range view.Tokens {
				@parts.Item(parts.ItemProps{Name: token.Name, Note: apiTokenNote(token, view), Attrs: templ.Attributes{"data-api-token-row": token.ID}}) {
					if token.IsExpired(view.Now) {
						@parts.Status(parts.StatusProps{State: parts.StateFailed}) {
							expired
						}
					}
					@parts.Button(parts.ButtonProps{Attrs: templ.Attributes{
						"type":       "button",
						"aria-label": "Revoke " + token.Name,
						"hx-delete":  basePath + "/settings/api-tokens/" + token.ID,
						"hx-swap":    "none",
						"hx-disable": "this",
						"hx-confirm": "Revoke " + token.Name + "? Requests with it stop working right away.",
					}}) {
						Revoke
					}
				}
			}
		}
	</div>
}

// APITokenReveal shows a new token once, at the top of the tab, until the
// page is left.
templ APITokenReveal(raw string) {
	<div id="api-token-reveal" class="empty:hidden" hx-swap-oob="true">
		@parts.Card(parts.CardProps{Title: "Copy your new token"}) {
			@parts.Command(parts.CommandProps{Text: raw})
			<p class="kit-small kit-muted">
				It shows only this once.
			</p>
		}
	</div>
}
