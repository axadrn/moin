package pages

import (
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// Registries is where the workspace keeps the logins its servers pull
// private images with, built in CI: the list, each with the servers that
// keep it and Remove, a field for each server without it, and the form for
// another. The password goes to a server, never back. Saving or removing
// one answers the whole page. servers are the workspace's servers.
templ Registries(logins []service.RegistryLogin, servers []string) {
	{{ base := ctxkeys.AppBasePath(ctx) }}
	@layouts.App("Registries") {
		@panelPage() {
			@components.Header(components.HeaderProps{Back: components.Back{Label: "Settings", Href: base + "/settings"}, Title: "Registries"})
			<div id="registries" class="moin-stack" data-gap="6">
				@components.Card(components.CardProps{}) {
					@components.List() {
						if len(logins) == 0 {
							@components.Item(components.ItemProps{}) {
								<p class="moin-small moin-muted">No registry logins yet. Public images need none.</p>
							}
						}
						for _, login := range logins {
							@components.Item(components.ItemProps{Attrs: templ.Attributes{"data-registry": login.Host, "data-control": true}}) {
								<div class="moin-fill">
									<div class="moin-truncate moin-mono moin-strong">{ login.Host }</div>
									<div class="moin-truncate moin-text moin-muted">{ "as " + login.Username + ". " + secretOn(login.Servers) + "." }</div>
								</div>
								@components.Button(components.ButtonProps{Attrs: templ.Attributes{
									"hx-delete":  base + "/registries/" + login.Host,
									"hx-target":  "#registries",
									"hx-select":  "#registries",
									"hx-swap":    "outerHTML",
									"hx-disable": "this",
									"hx-confirm": "Remove the login for " + login.Host + "? Private images from it no longer pull.",
								}}) {
									Remove
								}
							}
							for _, server := range login.Servers.MissingOn {
								@missingSecret(missingSecretProps{
									Server:   server,
									Sentence: server + " has no login for " + login.Host + ".",
									Action:   base + "/registries",
									Target:   "#registries",
									Field:    "password",
									Label:    "Password or token",
									Hidden:   map[string]string{"host": login.Host, "username": login.Username},
								})
							}
						}
					}
				}
				@components.Card(components.CardProps{Title: "New registry login"}) {
					<form
						class="moin-stack"
						data-gap="4"
						hx-post={ base + "/registries" }
						hx-target="#registries"
						hx-select="#registries"
						hx-swap="outerHTML"
						hx-disable="find button[type='submit']"
					>
						@components.CSRF()
						<div class="moin-grid" data-cols="3">
							@formField("Registry", "registry-host", "", "") {
								@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "registry-host", "aria-describedby": "registry-host-hint", "name": "host", "type": "text", "placeholder": "ghcr.io", "autocomplete": "off", "spellcheck": "false", "autocapitalize": "off", "required": true}})
							}
							@formField("Username", "registry-username", "", "") {
								@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "registry-username", "aria-describedby": "registry-username-hint", "name": "username", "type": "text", "autocomplete": "off", "autocapitalize": "off", "required": true}})
							}
							@formField("Password or token", "registry-password", "", "") {
								@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "registry-password", "aria-describedby": "registry-password-hint", "name": "password", "type": "password", "autocomplete": "new-password", "required": true}})
							}
						</div>
						@serverField("registry-server", servers)
						<div class="moin-row" data-end>
							@components.Button(components.ButtonProps{Type: "submit"}) {
								Save login
							}
						</div>
					</form>
				}
			</div>
		}
	}
}
