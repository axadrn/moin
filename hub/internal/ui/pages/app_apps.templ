package pages

import (
	"fmt"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"strconv"
	"strings"
	"time"

	"github.com/axadrn/moin/hub/internal/api"
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
	"github.com/axadrn/moin/internal/human"
	"github.com/axadrn/moin/protocol"
)

// Apps is every app of the workspace, in the one order: what needs you,
// what deploys, pinned apps, then by name.
templ Apps(apps []model.App, servers []model.Server) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@layouts.App("Apps") {
		@panelPage() {
			@components.Header(components.HeaderProps{Back: components.Back{Label: "Overview", Href: basePath + "/overview"}, Title: "Apps"}) {
				@components.Button(components.ButtonProps{Kind: components.Primary, Href: basePath + "/new-app"}) {
					New app
				}
			}
			if len(apps) == 0 {
				@components.List() {
					@components.Item(components.ItemProps{Href: basePath + "/new-app", Name: "No apps yet", Note: "Start one from your folder, GitHub or the catalog."})
				}
			} else {
				@appRows(apps, servers)
			}
		}
	}
}

// NewApp is where an app starts: from your folder, from GitHub, or from
// the catalog. Each is one card; the overview lists the apps.
templ NewApp(servers []model.Server) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@layouts.App("New app") {
		@panelPage() {
			@components.Header(components.HeaderProps{Back: components.Back{Label: "Apps", Href: basePath + "/apps"}, Title: "New app"})
			if len(servers) == 0 {
				@components.List() {
					@components.Item(components.ItemProps{Href: basePath + "/servers", Name: "Connect a server first", Note: "Apps run on your servers. One command, no open port."})
				}
			} else {
				@components.Card(components.CardProps{Title: "From your folder"}) {
					<p class="moin-small moin-muted">
						Run this in the folder of your app. It finds compose.yml, a Dockerfile or a Go module and builds on your server.
					</p>
					@components.Command(components.CommandProps{Text: "moin deploy"})
				}
				@components.Card(components.CardProps{Title: "From GitHub"}) {
					<p class="moin-small moin-muted">
						Name it and pick its server. Then link its repo, and every push deploys.
					</p>
					@AppAddForm(servers)
				}
				@components.Card(components.CardProps{Title: "From the catalog"}) {
					<p class="moin-small moin-muted">
						Umami, n8n, Ghost and 44 more, the newest release in one click.
					</p>
					<div>
						@components.Button(components.ButtonProps{Href: basePath + "/catalog", Attrs: templ.Attributes{"data-catalog-link": true}}) {
							Open the catalog
						}
					</div>
				}
			}
		}
	}
}

// AppAddForm names a new app and picks its server; the new app's page
// opens once it is added.
templ AppAddForm(servers []model.Server) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<form
		id="app-add-form"
		class="moin-row"
		data-gap="2"
		data-phone="stack"
		hx-post={ basePath + "/apps" }
		hx-swap="none"
		hx-disable="find button[type='submit']"
	>
		@components.CSRF()
		<label for="app-name" class="moin-sr-only">App name</label>
		@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "app-name", "name": "name", "type": "text", "placeholder": "Name, like my-app", "maxlength": "63", "autocomplete": "off", "spellcheck": "false", "data-hotkey-focus": true}})
		<div class="moin-row moin-width" data-gap="2" style="--width:16rem">
			@components.Select(components.SelectProps{ID: "app-server", Name: "server", Label: "Server", Options: serverOptions(servers)})
			@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit"}) {
				Add
			}
		</div>
	</form>
}

func serverOptions(servers []model.Server) []components.Option {
	options := make([]components.Option, 0, len(servers))
	for _, server := range servers {
		options = append(options, components.Option{Value: server.Name, Label: server.Name})
	}
	return options
}

func plural(n int, one, many string) string {
	if n == 1 {
		return "1 " + one
	}
	return strconv.Itoa(n) + " " + many
}

// AppPageView is an app and the section of it to show.
type AppPageView struct {
	App     model.App
	Deploys []api.Deploy
	EnvKeys []string
	// Section is app, deploys, domains, logs or settings; data has its
	// own page.
	Section string
	// Catalog is the update card of a catalog app (App section), Uptime the
	// checks of its domains (Domains): filled for the section that shows
	// them, so the page comes whole.
	Catalog *CatalogUpdateView
	Uptime  *UptimeView
	// Domains is the domains, instant address and password.
	Domains *DomainsView
	// Selected is the deploy whose log the Deploys section shows; 0 shows
	// the newest and follows the next one that starts.
	Selected int
	// Repo is the GitHub card of the Deploys section, as far as it is known
	// without asking GitHub.
	Repo *RepoView
	// Logs is the container logs of the Logs section; nil when the daemon
	// did not answer in time, and the section loads them itself.
	Logs *AppLogsView
}

// AppPage is an app: the head stays, the section under it answers one
// question (appSections).
templ AppPage(view AppPageView) {
	{{ app := view.App }}
	@layouts.App(app.Name) {
		@panelPage(templ.Attributes{"data-app-page": app.Name}) {
			@appHeader(app, view.Section)
			@appSection(app.Name, app.Link(), view.Section) {
				switch view.Section {
					case "deploys":
						@appDeploysSection(app, view.Deploys, view.Selected, view.Selected == 0, view.Repo)
					case "domains":
						@appDomainsSection(view)
					case "logs":
						@appLogsSection(app, view.Deploys, view.Logs)
					case "settings":
						@appSettingsSection(app, view.EnvKeys)
					default:
						@appHomeSection(view)
				}
			}
		}
		// The app's changes come as the event "apps"; parts that show them
		// reload on it (hx-trigger "apps from:body").
		@components.Live(components.LiveProps{URL: "/api/v1/apps/events?workspace=" + ctxkeys.Workspace(ctx).Link()})
	}
}

// appHomeSection answers "does it run?": the head says it; under it where
// the app is reached and how it does. On a phone it lists the sections
// first, each with what it holds, like a Settings page that drills down.
templ appHomeSection(view AppPageView) {
	{{ app := view.App }}
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Link() }}
	if view.Catalog != nil {
		@CatalogUpdate(*view.Catalog)
	}
	<div class="moin-only-phone">
		@components.List() {
			for _, section := range appSections[1:] {
				@components.Item(components.ItemProps{Href: appPath + section.Path, Name: section.Label, Value: appSectionValue(app, section.ID)})
			}
		}
	</div>
	<div class="moin-hidden-phone">
		<section class="moin-section">
			<div class="moin-section-head">
				<h2>Domains</h2>
			</div>
			@components.List() {
				for _, domain := range appDomains(app) {
					@components.Item(components.ItemProps{Href: "https://" + domain, External: true, Name: domain})
				}
				if len(appDomains(app)) == 0 {
					@components.Item(components.ItemProps{Name: "No domain yet"}) {
						@components.Button(components.ButtonProps{Href: appPath + "/domains"}) {
							Add a domain
						}
					}
				}
			}
		</section>
	</div>
	@components.List() {
		@components.Item(components.ItemProps{Href: appPath + "/metrics", Name: "Metrics"})
		if app.Catalog != "" {
			// Its page in the catalog: what it is, its links, newer versions.
			@components.Item(components.ItemProps{Href: ctxkeys.AppBasePath(ctx) + "/catalog/" + app.Catalog, Name: "In the catalog", Note: app.Catalog})
		}
	}
}

// appSectionValue is what a section holds, in a word, for the list on a
// phone.
func appSectionValue(app model.App, id string) string {
	switch id {
	case "domains":
		domains := appDomains(app)
		if len(domains) == 0 {
			return "none yet"
		}
		if len(domains) > 1 {
			return fmt.Sprintf("%s +%d", domains[0], len(domains)-1)
		}
		return domains[0]
	case "settings":
		if app.ChangesWaiting > 0 {
			return changesWaiting(app.ChangesWaiting)
		}
	}
	return ""
}

// appDomains are where the app answers: its domains, then its instant
// address.
func appDomains(app model.App) []string {
	domains := app.DomainList()
	if app.InstantHost != "" {
		domains = append(domains, app.InstantHost)
	}
	return domains
}

// appDeploysSection answers "how does code get in?": the versions, the log
// of the one picked, GitHub and CI.
templ appDeploysSection(app model.App, deploys []api.Deploy, selected int, follow bool, repo *RepoView) {
	<div class="moin-grid" data-fit style="--min:30rem">
		@appDeploys(app, deploys, selected, follow)
		@DeployLogPanel(app, selectedDeploy(deploys, selected), follow, false)
	</div>
	if repo != nil {
		@AppRepo(*repo)
	} else {
		@AppRepo(RepoView{App: app, Enabled: true, Connected: true, Loading: app.Repo == ""})
	}
	@appCI(app.Name, app.Link(), app.DeployHookHash != nil)
}

// appDomainsSection answers "where is it reached?": the instant address
// and the domains in one place, with the password and uptime.
templ appDomainsSection(view AppPageView) {
	if view.Domains != nil {
		@AppDomains(*view.Domains)
	}
	if view.Uptime != nil {
		@AppUptimeBody(*view.Uptime)
	}
}

// appLogsSection answers "what happens in it?": the container logs, and a
// command to run in it. The logs come with the page; only when the daemon is
// slow to answer they load into a box that keeps their place.
templ appLogsSection(app model.App, deploys []api.Deploy, logs *AppLogsView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Link() }}
	@components.Card(components.CardProps{Title: "Last 200 lines", Action: loadLogsButton(appPath)}) {
		<div class="moin-bleed">
			if logs != nil {
				@AppLogs(logs.Lines, logs.Message)
			} else {
				<div id="app-logs" hx-get={ appPath + "/logs/lines" } hx-trigger="load" hx-swap="outerHTML" class="moin-tail" data-top data-hold>
					<p class="moin-inset moin-text moin-muted">Reading the logs…</p>
				</div>
			}
		</div>
	}
	@appExec(app, deploys)
}

// AppLogsView is the container logs as the page shows them: the last lines,
// or why they could not be read.
type AppLogsView struct {
	Lines   []string
	Message string
}

// appSettingsSection answers "how is it set up?": its name, its env, the
// pin, and at the end what stops or removes it.
templ appSettingsSection(app model.App, envKeys []string) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Link() }}
	@components.Card(components.CardProps{Title: "Name"}) {
		<form
			hx-post={ appPath + "/name" }
			hx-target="#main"
			hx-select="#main"
			hx-swap="outerHTML"
			hx-disable="find button[type='submit']"
			data-rename-app
		>
			@components.CSRF()
			<label for="app-rename" class="moin-sr-only">App name</label>
			<div class="moin-row" data-gap="2" data-phone="stack">
				@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "app-rename", "name": "name", "type": "text", "value": app.Name, "maxlength": "63", "autocomplete": "off", "spellcheck": "false"}})
				@components.Button(components.ButtonProps{Type: "submit"}) {
					Save
				}
			</div>
		</form>
	}
	@AppEnv(app.Link(), envKeys, nil)
	@components.List() {
		@PinSwitch(app)
	}
	@components.List() {
		if app.LiveNumber > 0 && !app.Stopped {
			@components.Item(components.ItemProps{Button: true, Danger: true, Attrs: templ.Attributes{
				"hx-post":    appPath + "/stop",
				"hx-swap":    "none",
				"hx-disable": "this",
				"hx-confirm": "Stop " + app.Name + "? It is offline until you start it. Its data and settings stay.",
				"data-stop":  true,
			}}) {
				<span class="moin-strong">Stop { app.Name }</span>
			}
		}
		@components.Item(components.ItemProps{Button: true, Danger: true, Attrs: templ.Attributes{
			"hx-delete":         appPath,
			"hx-swap":           "none",
			"hx-disable":        "this",
			"hx-confirm":        "Remove " + app.Name + "? Its containers stop and go. Its data stays on the server.",
			"data-confirm-name": app.Name,
			"data-remove-app":   true,
		}}) {
			<span class="moin-strong">Remove { app.Name }</span>
		}
	}
}

func appLiveLine(app model.App) string {
	switch {
	case app.LiveNumber == 0:
		return "Not deployed yet"
	case app.Stopped:
		return fmt.Sprintf("v%d, stopped", app.LiveNumber)
	}
	return fmt.Sprintf("v%d runs", app.LiveNumber)
}

func appLastDeployLine(deploys []api.Deploy) string {
	if len(deploys) == 0 {
		return "Deploy it with moin deploy"
	}
	return "Last deploy " + human.Ago(deploys[0].CreatedAt, time.Now())
}

templ loadLogsButton(appPath string) {
	@components.Button(components.ButtonProps{Attrs: templ.Attributes{"hx-get": appPath + "/logs/lines", "hx-target": "#app-logs", "hx-swap": "outerHTML", "hx-disable": "this"}}) {
		Reload
	}
}

// AppDetail is the state and the buttons of an app, for the reload on every
// change the app event stream reports. For the Deploys section (withDeploys)
// it brings the deploys too, and follows a running deploy.
templ AppDetail(app model.App, deploys []api.Deploy, selected int, follow bool, shown int, withDeploys bool) {
	@appStateLine(app)
	@appActions(app)
	if withDeploys {
		@appDeploys(app, deploys, selected, follow)
		// Following the newest deploy, a new one takes the log.
		if follow && len(deploys) > 0 && deploys[0].Number != shown {
			@DeployLogPanel(app, &deploys[0], true, true)
		}
	}
}

func failedCount(deploys []api.Deploy) int {
	n := 0
	for _, deploy := range deploys {
		if deploy.Status == model.DeployFailed {
			n++
		}
	}
	return n
}

func deployByNumber(deploys []api.Deploy, number int) (api.Deploy, bool) {
	for _, deploy := range deploys {
		if deploy.Number == number {
			return deploy, true
		}
	}
	return api.Deploy{}, false
}

// lastTook is how long the newest finished deploy took, and its number.
func lastTook(deploys []api.Deploy) (string, int) {
	for _, deploy := range deploys {
		if d := took(deploy.CreatedAt, deploy.FinishedAt); d != "" {
			return d, deploy.Number
		}
	}
	return "", 0
}

// appDeploys is the deploys, newest first: a list on a card, the one whose
// log shows lit. It reloads itself on every change of the app.
templ appDeploys(app model.App, deploys []api.Deploy, selected int, follow bool) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<section
		id="app-detail"
		hx-swap-oob="true"
		hx-get={ detailHref(basePath, app.Link(), selected, follow, deploys) }
		hx-trigger="apps from:body"
		hx-swap="none"
		data-latest-number={ strconv.Itoa(app.LatestNumber) }
		data-latest-status={ app.LatestStatus }
		class="moin-list"
		aria-label="Deploys"
	>
		if len(deploys) == 0 {
			@components.Card(components.CardProps{}) {
				<p class="moin-strong">No deploys yet</p>
				@components.Command(components.CommandProps{Text: "moin deploy " + app.Name})
			}
		} else {
			<div role="list">
				for _, deploy := range deploys[:min(len(deploys), deploysShown)] {
					@deployRow(app, deploys, deploy, selected)
				}
				if len(deploys) > deploysShown {
					@components.Expand(components.ExpandProps{Name: plural(len(deploys)-deploysShown, "older deploy", "older deploys")}) {
						for _, deploy := range deploys[deploysShown:] {
							@deployRow(app, deploys, deploy, selected)
						}
					}
				}
			</div>
		}
	</section>
}

// deployRow is one deploy: its version (a link to its log), state, commit
// and age. Roll back sits by the log of the deploy picked.
templ deployRow(app model.App, deploys []api.Deploy, deploy api.Deploy, selected int) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ now := time.Now() }}
	@components.Item(components.ItemProps{Href: deployHref(basePath, app.Link(), deploys, deploy.Number), Attrs: deployRowAttributes(deploy.Number, deploy.Number == selectedNumber(deploys, selected))}) {
		<div class="moin-stack moin-fill" data-gap="1">
			<span class="moin-row" data-gap="3">
				<span class="moin-strong moin-digits">{ fmt.Sprintf("v%d", deploy.Number) }</span>
				@deployStatus(deploy, app.LiveNumber)
				<span class="moin-end moin-text moin-muted moin-digits" title={ stamp(deploy.CreatedAt) }>
					{ human.Ago(deploy.CreatedAt, now) }
				</span>
			</span>
			if deploy.Commit != "" {
				<span class="moin-truncate moin-text moin-muted" title={ deploy.CommitMessage } data-deploy-commit>
					<span class="moin-mono">{ shortCommit(deploy.Commit) }</span>
					{ deploy.CommitMessage }
				</span>
			}
			if deploy.FromNumber > 0 {
				<span class="moin-small moin-muted">{ fmt.Sprintf("rollback to v%d", deploy.FromNumber) }</span>
			}
			if deploy.Error != "" {
				<span class="moin-truncate moin-text moin-failed" title={ deploy.Error }>{ deploy.Error }</span>
			}
		</div>
	}
}

// deployRowAttributes name a deploy's row; the one whose log shows is the
// current one, lit.
func deployRowAttributes(number int, current bool) templ.Attributes {
	attributes := templ.Attributes{"data-deploy": strconv.Itoa(number)}
	if current {
		attributes["aria-current"] = "true"
		attributes["data-selected"] = true
	}
	return attributes
}

// canRollBack is whether a deploy can run again: it succeeded, is not
// live, and nothing deploys right now.
func canRollBack(app model.App, deploy api.Deploy) bool {
	onServer := deploy.OnServer == nil || *deploy.OnServer
	return deploy.Status == model.DeploySucceeded && deploy.Number != app.LiveNumber && app.LatestStatus != model.DeployRunning && onServer
}

// deploysShown is how many deploys the list shows before "Show older".
const deploysShown = 8

// deployStatus is the state of one deploy, symbol and word.
templ deployStatus(deploy api.Deploy, liveNumber int) {
	switch  {
		case deploy.Status == model.DeployRunning:
			@components.Status(components.StatusProps{State: components.StateRunning}) {
				deploying
			}
		case deploy.Status == model.DeployFailed:
			@components.Status(components.StatusProps{State: components.StateFailed}) {
				failed
			}
		case deploy.Number == liveNumber:
			@components.Status(components.StatusProps{State: components.StateLive}) {
				live
			}
		default:
			@components.Status(components.StatusProps{State: components.StateDone}) {
				succeeded
			}
	}
}

// AppLogs shows the container logs, or why they could not be read, in the
// box the page kept for them.
templ AppLogs(lines []string, message string) {
	<div id="app-logs" class="moin-tail" data-top tabindex="0" aria-label="Container logs">
		if message != "" {
			<p class="moin-row moin-inset moin-text moin-failed" data-gap="2" data-top><span aria-hidden="true">✗</span>{ message }</p>
		} else if len(lines) == 0 {
			<p class="moin-inset moin-text moin-muted">No log lines yet.</p>
		} else {
			<div class="moin-log" data-meta>
				for _, line := range lines {
					{{ entry := parseLogLine(line) }}
					<div>
						<span class="moin-hidden-phone" data-dim title={ entry.Time }>{ entry.Clock }</span>
						<span class="moin-hidden-phone moin-truncate" data-dim>{ entry.Service }</span>
						<span>{ entry.Message }</span>
					</div>
				}
			</div>
		}
	</div>
}

// logLine is one line of docker compose logs --timestamps:
// "web-1  | 2026-10-31T10:31:30.123456789Z message".
type logLine struct {
	Service string
	Time    string
	Clock   string
	Message string
}

func parseLogLine(line string) logLine {
	service, rest, found := strings.Cut(line, " | ")
	service = strings.TrimSpace(service)
	if !found || service == "" || strings.Contains(service, " ") {
		return logLine{Message: line}
	}
	entry := logLine{Service: service, Message: rest}
	if stampText, message, ok := strings.Cut(rest, " "); ok {
		if t, err := time.Parse(time.RFC3339Nano, stampText); err == nil {
			entry.Time = stamp(t)
			entry.Clock = t.UTC().Format("15:04:05")
			entry.Message = message
		}
	}
	return entry
}

// AppEnv is the env vars of an app, one row each, and the row that sets
// one. values holds the shown values; keys without one show as dots. Saving
// never restarts the app: the head then says what waits for Restart.
templ AppEnv(appLink string, keys []string, values map[string]string) {
	{{ envPath := ctxkeys.AppBasePath(ctx) + "/apps/" + appLink + "/env" }}
	<div id="app-env">
		<section class="moin-section">
			<div class="moin-section-head">
				<h2>Environment</h2>
				@envModes(appLink, false)
			</div>
			@components.List() {
				if len(keys) == 0 {
					@components.Item(components.ItemProps{Name: "No env vars yet"})
				}
				for _, key := range keys {
					@components.Item(components.ItemProps{}) {
						<span data-env={ key } class="moin-item-text moin-truncate moin-mono moin-text" title={ key }>{ key }</span>
						<span class="moin-item-value moin-mono">
							if value, ok := values[key]; ok {
								<span data-env-value class="moin-foreground">{ value }</span>
							} else {
								<span aria-label="hidden">••••••</span>
							}
						</span>
						@components.Button(components.ButtonProps{Icon: true, Quiet: true, Attrs: templ.Attributes{
							"aria-label":          "Remove " + key,
							"title":               "Remove " + key,
							"hx-delete":           envPath + "/" + key,
							"hx-target":           "#app-env",
							"hx-swap":             "outerHTML",
							"hx-disable":          "this",
							"hx-confirm":          "Remove " + key + "? The next deploy or restart drops it.",
							"data-confirm-action": "Remove",
						}}) {
							@components.Icon("x")
						}
					}
				}
				if len(keys) > 0 {
					if len(values) == 0 {
						@components.Item(components.ItemProps{Button: true, Name: "Show values", Attrs: templ.Attributes{"hx-get": envPath + "?show=1", "hx-target": "#app-env", "hx-swap": "outerHTML", "data-env-show": true}})
					} else {
						@components.Item(components.ItemProps{Button: true, Name: "Hide values", Attrs: templ.Attributes{"hx-get": envPath, "hx-target": "#app-env", "hx-swap": "outerHTML", "data-env-hide": true}})
					}
				}
				@components.Item(components.ItemProps{Form: true, Attrs: templ.Attributes{"hx-post": envPath, "hx-target": "#app-env", "hx-swap": "outerHTML", "hx-disable": "find button[type='submit']", "data-env-set": true}}) {
					<div class="moin-row moin-fill" data-gap="2" data-phone="stack">
						@components.CSRF()
						<label for="env-key" class="moin-sr-only">Name</label>
						<div class="moin-width" style="--width:14rem">
							@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "env-key", "name": "key", "type": "text", "placeholder": "Name", "autocomplete": "off", "autocapitalize": "characters", "spellcheck": "false", "required": true}})
						</div>
						<label for="env-value" class="moin-sr-only">Value</label>
						@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "env-value", "name": "value", "type": "password", "placeholder": "Value", "autocomplete": "off"}})
						@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit"}) {
							Set
						}
					</div>
				}
			}
		</section>
	</div>
}

// shortPath keeps the last three parts of a long path: …/volumes/data/app.db.
func shortPath(path string) string {
	parts := strings.Split(strings.Trim(path, "/"), "/")
	if len(parts) <= 3 {
		return path
	}
	return "…/" + strings.Join(parts[len(parts)-3:], "/")
}

func liveDetected(deploys []api.Deploy) *protocol.Detected {
	for _, deploy := range deploys {
		if deploy.Status == model.DeploySucceeded && deploy.Detected != nil {
			return deploy.Detected
		}
	}
	return nil
}

func shortCommit(sha string) string {
	if len(sha) > 7 {
		return sha[:7]
	}
	return sha
}
