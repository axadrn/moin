package pages

import (
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
)

// RepoView is the GitHub card of an app.
type RepoView struct {
	App model.App
	// Enabled is whether this hub has the GitHub App; Connected
	// whether the workspace connected an account (Settings, GitHub).
	Enabled   bool
	Connected bool
	Repos     []service.GitHubRepoOf
	// Branches are the branches of the first repo, its default first.
	Branches []string
	// Installations say where on GitHub the workspace gives moin more repos.
	Installations []model.GitHubInstallation
	// Error says why the repos could not be listed.
	Error string
	// Loading is the link form before GitHub answered with the repos: the
	// page renders it without them and asks for them, so the card keeps
	// its place.
	Loading bool
}

// AppRepo is the GitHub card: connect GitHub, link a repo and branch,
// deploy a ref, deploy on push.
templ AppRepo(view RepoView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Link() }}
	<div
		id="app-repo"
		if view.Loading {
			hx-get={ appPath + "/repo" }
			hx-trigger="load"
			hx-swap="outerHTML"
		}
	>
		@components.Card(components.CardProps{Title: "GitHub", Action: repoAction(view)}) {
			if view.Error != "" {
				<p class="moin-text moin-failed" data-repo-error>{ view.Error }</p>
			}
			if !view.Enabled {
				<p class="moin-small moin-muted">
					This hub has no GitHub App.
				</p>
				@components.Command(components.CommandProps{Text: "moin deploy " + view.App.Name})
			} else if !view.Connected {
				<p class="moin-small moin-muted">
					GitHub is not connected.
				</p>
			} else if view.App.Repo == "" {
				@repoLink(view)
			} else {
				@repoLinked(view)
			}
		}
	</div>
}

// repoAction is the one button in the head of the card: Connect GitHub,
// which comes back to the app, or Unlink once a repo is linked.
templ repoAction(view RepoView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Link() }}
	if view.Enabled && !view.Connected {
		@components.Button(components.ButtonProps{Kind: components.Primary, Href: ctxkeys.AppBasePath(ctx) + "/github/install?next=" + appPath + "/deploys", Attrs: templ.Attributes{"data-connect-github": true}}) {
			@components.Icon("git-hub")
			Connect GitHub
		}
	} else if view.Enabled && view.App.Repo != "" {
		@components.Button(components.ButtonProps{Attrs: templ.Attributes{
			"hx-post":          appPath + "/repo/unlink",
			"hx-target":        "#app-repo",
			"hx-swap":          "outerHTML",
			"hx-disable":       "this",
			"hx-confirm":       "Unlink " + view.App.Repo + "? moin stops deploying its pushes. The app keeps running.",
			"data-unlink-repo": true,
		}}) {
			Unlink
		}
	}
}

// repoLink links the app to a repo and a branch and deploys it: choose the
// repo, then one of its branches, keep or drop deploy on push, Deploy.
templ repoLink(view RepoView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Link() }}
	if len(view.Repos) == 0 && !view.Loading {
		<p class="moin-small moin-muted">
			moin can read no repo yet.
		</p>
		<div class="moin-row" data-wrap data-gap="2" data-no-repos>
			@repoAccess(view)
			@components.Button(components.ButtonProps{Attrs: templ.Attributes{"hx-get": appPath + "/repo", "hx-target": "#app-repo", "hx-swap": "outerHTML", "hx-disable": "this", "data-refresh-repos": true}}) {
				Refresh
			}
		</div>
	} else {
		<form class="moin-stack" data-gap="4" hx-post={ appPath + "/repo" } hx-target="#app-repo" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-link-repo>
			@components.CSRF()
			<input type="hidden" name="deploy" value="1"/>
			<div class="moin-grid">
				<div hx-get={ appPath + "/repo/branches" } hx-trigger="change" hx-include="closest form" hx-target="#link-branch-field" hx-swap="outerHTML">
					@components.Field(components.FieldProps{Label: "Repo", For: "link-repo"}) {
						@components.Select(components.SelectProps{ID: "link-repo", Name: "repo", Label: "Repo", Options: repoOptions(view.Repos), Disabled: view.Loading})
					}
				</div>
				@repoBranchField(view.Branches, view.Loading)
			</div>
			<label class="moin-row" data-between data-gap="3">
				<span class="moin-text moin-strong">Deploy every push</span>
				@components.Switch(components.SwitchProps{Attrs: templ.Attributes{"id": "link-auto-deploy", "name": "auto_deploy", "value": "1", "checked": true}})
			</label>
			<div class="moin-row" data-wrap data-gap="2">
				@components.Button(components.ButtonProps{Kind: components.Primary, Type: "submit", Attrs: templ.Attributes{"disabled": view.Loading}}) {
					Deploy
				}
				@repoAccess(view)
			</div>
		</form>
	}
}

// RepoBranchField is the branch select of the link form, for the chosen
// repo; the form asks for it again when the repo changes.
templ RepoBranchField(branches []string) {
	@repoBranchField(branches, false)
}

templ repoBranchField(branches []string, loading bool) {
	<div id="link-branch-field">
		@components.Field(components.FieldProps{Label: "Branch", For: "link-branch"}) {
			@components.Select(components.SelectProps{ID: "link-branch", Name: "branch", Label: "Branch", Options: branchOptions(branches, loading), Disabled: loading})
		}
	</div>
}

// repoAccess links to where on GitHub each connected account picks the
// repos moin may read.
templ repoAccess(view RepoView) {
	{{ install := ctxkeys.AppBasePath(ctx) + "/github/install?next=" + ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Link() + "/deploys" }}
	for _, installation := range view.Installations {
		if installation.SettingsURL != "" {
			@components.Button(components.ButtonProps{Href: installation.SettingsURL, Attrs: templ.Attributes{"target": "_blank", "rel": "noopener", "data-github-settings": installation.Account}}) {
				Repos on { installation.Account } ↗
			}
		} else {
			@components.Button(components.ButtonProps{Href: install, Attrs: templ.Attributes{"data-github-settings": installation.Account}}) {
				Repos on { installation.Account }
			}
		}
	}
}

// repoLinked is a linked repo: deploy a ref, deploy on push.
templ repoLinked(view RepoView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Link() }}
	<a href={ templ.SafeURL("https://github.com/" + view.App.Repo) } target="_blank" rel="noopener" class="moin-link moin-truncate moin-mono moin-text" data-quiet data-linked-repo>
		{ view.App.Repo }<span class="moin-muted">{ "@" + view.App.Branch }</span>
	</a>
	<form hx-post={ appPath + "/repo/deploy" } hx-target="#app-repo" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-deploy-ref>
		@components.CSRF()
		@components.Field(components.FieldProps{Label: "Deploy a branch, tag or commit", For: "deploy-ref"}) {
			<div class="moin-row" data-gap="2" data-phone="stack">
				@components.Input(components.InputProps{Attrs: templ.Attributes{"id": "deploy-ref", "name": "ref", "type": "text", "placeholder": view.App.Branch, "autocomplete": "off", "autocapitalize": "off", "spellcheck": "false"}})
				@components.Button(components.ButtonProps{Type: "submit"}) {
					Deploy
				}
			</div>
		}
	</form>
	@AutoDeployForm(view.App)
}

// AutoDeployForm is the switch for deploy on push. It saves only that, so
// it never waits for GitHub, and answers itself as stored.
templ AutoDeployForm(app model.App) {
	<form id="auto-deploy-form" hx-post={ ctxkeys.AppBasePath(ctx) + "/apps/" + app.Link() + "/repo/auto-deploy" } hx-trigger="change" hx-target="this" hx-swap="outerHTML" hx-disable="find input[type='checkbox']">
		@components.CSRF()
		<label class="moin-row" data-between data-gap="3">
			<span class="moin-text moin-strong">Deploy every push to { app.Branch }</span>
			@components.Switch(components.SwitchProps{Attrs: templ.Attributes{"id": "repo-auto-deploy", "name": "on", "value": "1", "checked": app.AutoDeploy}})
		</label>
	</form>
}

func repoOptions(repos []service.GitHubRepoOf) []components.Option {
	if len(repos) == 0 {
		return []components.Option{{Value: "", Label: "…"}}
	}
	options := make([]components.Option, 0, len(repos))
	for _, repo := range repos {
		options = append(options, components.Option{Value: repo.FullName, Label: repo.FullName})
	}
	return options
}

// branchOptions are the branches to pick; without them the link takes the
// default branch.
func branchOptions(branches []string, loading bool) []components.Option {
	if loading {
		return []components.Option{{Value: "", Label: "…"}}
	}
	if len(branches) == 0 {
		return []components.Option{{Value: "", Label: "Default branch"}}
	}
	options := make([]components.Option, 0, len(branches))
	for _, branch := range branches {
		options = append(options, components.Option{Value: branch, Label: branch})
	}
	return options
}
