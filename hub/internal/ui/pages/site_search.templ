package pages

import (
	"sort"
	"strings"

	"github.com/axadrn/moin/internal/find"

	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/kit"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// SiteHit is what the search of the public site finds: a docs page, a
// section of one (it opens at its heading), or an app of the catalog.
type SiteHit struct {
	Title string
	// Where is the topic of a page, the page of a section, or "Catalog".
	Where string
	Href  string
}

// FindSite is the one search of the public site, behind the magnifier of
// the navbar: an app whose name matches first, then the parts and rooms of
// the kit, then the docs, then the apps found by their category or one sentence. It matches like the
// palette (find.Name), so a typo still finds. Without a query it is the
// first steps and the catalog.
func FindSite(groups []model.DocGroup, apps []CatalogEntryView, kit []SiteHit, query string, limit int) []SiteHit {
	if strings.TrimSpace(query) == "" {
		var out []SiteHit
		if len(groups) > 0 {
			out = FindDocs(groups[:1], "", 0)
		}
		return append(out, SiteHit{Title: "Catalog", Where: "Apps you install in one click", Href: "/catalog"}, SiteHit{Title: "Kit", Where: "The UI kit moin runs on", Href: "/kit"})
	}
	var named, other []SiteHit
	for _, app := range FilterCatalog(apps, "", query, SortName) {
		hit := SiteHit{Title: app.Entry.Name, Where: "Catalog", Href: "/catalog/" + app.Entry.Slug}
		if score, _ := catalogScore(app.Entry, query); score >= 1000 {
			named = append(named, hit)
		} else {
			other = append(other, hit)
		}
	}
	out := named
	for _, hit := range kit {
		if _, ok := find.Name(query, hit.Title); ok {
			out = append(out, hit)
		}
	}
	out = append(out, FindDocs(groups, query, limit)...)
	out = append(out, other...)
	return out[:min(len(out), limit)]
}

// FindDocs is what the search finds in the docs: the pages whose title and
// the sections whose heading match query, the best first and at most
// limit. Without a query it is every page.
func FindDocs(groups []model.DocGroup, query string, limit int) []SiteHit {
	type hit struct {
		SiteHit
		score int
	}
	var hits []hit
	typed := strings.TrimSpace(query) != ""
	for _, group := range groups {
		for _, page := range group.Pages {
			if m, ok := find.Name(query, page.Title); ok {
				// A page wins over a section that matches as well.
				hits = append(hits, hit{SiteHit{page.Title, group.Title, docsPageURL(page)}, m.Score + 5})
			}
			if !typed {
				continue
			}
			for _, heading := range page.Headings {
				if heading.Level != 2 {
					continue
				}
				if m, ok := find.Name(query, heading.Text); ok {
					hits = append(hits, hit{SiteHit{heading.Text, page.Title, docsPageURL(page) + "#" + heading.ID}, m.Score})
				}
			}
		}
	}
	if !typed {
		limit = len(hits)
	}
	sort.SliceStable(hits, func(i, j int) bool { return hits[i].score > hits[j].score })
	out := make([]SiteHit, 0, min(len(hits), limit))
	for _, h := range hits[:min(len(hits), limit)] {
		out = append(out, h.SiteHit)
	}
	return out
}

// SiteSearchOptions are the answers in the palette of the public site
// (layouts.SiteSearch), the first one picked so Enter opens it.
templ SiteSearchOptions(query string, hits []SiteHit) {
	if len(hits) == 0 {
		<p class="px-4 py-3 text-sm text-muted-foreground">Nothing found for “{ query }”.</p>
	}
	for i, hit := range hits {
		<a
			href={ templ.SafeURL(hit.Href) }
			role="option"
			aria-selected={ ifElse(i == 0, "true", "false") }
			class="flex min-h-11 items-center gap-3 rounded-3xl px-4 py-2 text-sm outline-none aria-selected:bg-foreground/6"
		>
			<span class="min-w-0 flex-1 truncate font-medium">{ hit.Title }</span>
			<span class="shrink-0 truncate text-xs text-muted-foreground">{ hit.Where }</span>
		</a>
	}
}

// SearchPage is /search: the search without JavaScript, where the
// magnifier of the navbar leads. With JavaScript the magnifier opens the
// palette instead.
templ SearchPage(query string, hits []SiteHit) {
	@layouts.Home(layouts.SEOProps{
		Title:       "Search",
		Description: "Search the docs and the catalog of moin.",
		Path:        "/search",
		NoIndex:     true,
	}) {
		<main class="mx-auto flex w-full max-w-2xl flex-col gap-8 px-4 pt-10 pb-20 sm:px-6 sm:pt-14">
			@kit.Header(kit.Back{}, "Search")
			<form method="get" action="/search" role="search">
				<label for="search-q" class="sr-only">Search</label>
				@kit.Input(templ.Attributes{"id": "search-q", "name": "q", "type": "search", "value": query, "placeholder": "Search the docs and the catalog", "autocomplete": "off", "spellcheck": "false"})
			</form>
			if strings.TrimSpace(query) != "" && len(hits) == 0 {
				<p class="px-1 text-sm text-muted-foreground">Nothing found for “{ query }”.</p>
			} else {
				@kit.List() {
					for _, hit := range hits {
						@kit.Row(hit.Href) {
							@kit.RowText(hit.Title, hit.Where)
						}
					}
				}
			}
		</main>
	}
}
