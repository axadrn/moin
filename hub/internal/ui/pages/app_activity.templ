package pages

import (
	"net/url"
	"strings"
	"time"

	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/kit"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
	"github.com/axadrn/moin/internal/human"
)

// ActivityView is one page of the workspace activity, newest first. Next is
// the event to continue after, empty on the last page. Filter is what the
// page shows, Choices what it can be filtered by. Admin views see the client
// IP and user agent.
type ActivityView struct {
	Events  []model.ActivityEvent
	Next    string
	Filter  model.ActivityFilter
	Choices model.ActivityChoices
	Admin   bool
}

// query is the filter as URL parameters, after the event after.
func (v ActivityView) query(after string) string {
	values := url.Values{}
	for key, value := range map[string]string{"app": v.Filter.App, "server": v.Filter.Server, "user": v.Filter.User, "after": after} {
		if value != "" {
			values.Set(key, value)
		}
	}
	if len(values) == 0 {
		return ""
	}
	return "?" + values.Encode()
}

// filtered reports whether the view shows only part of the activity.
func (v ActivityView) filtered() bool {
	return v.Filter != model.ActivityFilter{}
}

// Activity is who changed what, to the second, newest first, narrowed to
// an app, a server or a member.
templ Activity(view ActivityView) {
	@layouts.App("Activity") {
		@panelPage() {
			@components.Header(components.HeaderProps{Back: components.Back{Label: "Settings", Href: ctxkeys.AppBasePath(ctx) + "/settings"}, Title: "Activity"})
			if len(view.Choices.Apps)+len(view.Choices.Servers)+len(view.Choices.Users) > 0 {
				@activityFilters(view)
			}
			<div id="activity-list">
				if len(view.Events) == 0 {
					@components.List() {
						@components.Item(components.ItemProps{}) {
							if view.filtered() {
								@kit.RowText("Nothing matches", "No change of the team matches this filter")
							} else {
								@kit.RowText("Nothing happened yet", "Deploys, restores and every other change show up here")
							}
						}
					}
				} else {
					<section class="moin-section">
						<div class="moin-section-head">
							<h2>Newest first, in UTC</h2>
						</div>
						<div class="flex flex-col rounded-4xl bg-card p-1.5" role="list" data-activity>
							@ActivityRows(view)
						</div>
					</section>
				}
			</div>
		}
	}
}

// ActivityRows are the rows of a page and the row that loads the next one
// in its place.
templ ActivityRows(view ActivityView) {
	{{ now := time.Now() }}
	for _, event := range view.Events {
		{{ details := event.Details() }}
		@components.Item(components.ItemProps{Attrs: templ.Attributes{"data-event": event.Action}}) {
			<span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-muted-foreground" aria-hidden="true">
				@activityIcon(event.Action)
			</span>
			<div class="flex min-w-0 flex-1 flex-col gap-0.5">
				<p class="text-sm text-pretty break-words">
					<span class="moin-strong">{ event.Actor() }</span>
					{ " " + event.Summary() }
				</p>
				if details["message"] != "" {
					<p class="truncate text-xs text-muted-foreground">{ details["message"] }</p>
				}
				if details["error"] != "" {
					<p class="truncate text-xs text-muted-foreground">{ details["error"] }</p>
				}
				<p class="flex flex-wrap gap-x-2 text-xs text-muted-foreground">
					<time class="tabular-nums" datetime={ event.CreatedAt.UTC().Format(time.RFC3339Nano) }>{ stamp(event.CreatedAt) }</time>
					if label := event.ViaLabel(); label != "" {
						<span>{ "via " + label }</span>
					}
					if view.Admin && event.ActorName != "" && event.ActorEmail != "" {
						<span class="break-all">{ event.ActorEmail }</span>
					}
					if view.Admin && event.IP != "" {
						<span class="tabular-nums">{ event.IP }</span>
					}
					if view.Admin && event.UserAgent != "" {
						<span class="max-w-64 truncate" title={ event.UserAgent }>{ event.UserAgent }</span>
					}
				</p>
			</div>
			<span class="shrink-0 text-xs text-muted-foreground tabular-nums">{ human.Ago(event.CreatedAt, now) }</span>
		}
	}
	if view.Next != "" {
		@components.Item(components.ItemProps{Button: true, Attrs: templ.Attributes{"id": "activity-more", "hx-get": ctxkeys.AppBasePath(ctx) + "/activity" + view.query(view.Next), "hx-target": "this", "hx-swap": "outerHTML", "hx-disable": "this"}}) {
			<span class="flex-1 text-center font-medium">Show older</span>
		}
	}
}

// activityFilters narrow the activity to one app, server or member: a pick
// loads the matching rows in place and puts the filter in the address.
templ activityFilters(view ActivityView) {
	{{ path := ctxkeys.AppBasePath(ctx) + "/activity" }}
	<form
		method="get"
		action={ templ.SafeURL(path) }
		class="grid gap-2 sm:grid-cols-3"
		hx-get={ path }
		hx-trigger="change"
		hx-target="#activity-list"
		hx-select="#activity-list"
		hx-swap="outerHTML"
		hx-push-url="true"
		data-activity-filters
	>
		@activitySelect("app", "All apps", view.Filter.App, valueOptions(view.Choices.Apps))
		@activitySelect("server", "All servers", view.Filter.Server, valueOptions(view.Choices.Servers))
		@activitySelect("user", "Everyone", view.Filter.User, userOptions(view.Choices.Users))
	</form>
}

// activitySelect picks one of the options, or all of them.
templ activitySelect(name, all, current string, choices []components.Option) {
	{{ options := append([]components.Option{{Value: "", Label: all}}, choices...) }}
	@components.Select(components.SelectProps{ID: "activity-" + name, Name: name, Label: all, Options: options, Value: current})
}

// valueOptions are options that show their value.
func valueOptions(values []string) []components.Option {
	options := []components.Option{}
	for _, value := range values {
		options = append(options, components.Option{Value: value, Label: value})
	}
	return options
}

// userOptions are the people by name, filtered by user ID.
func userOptions(users []model.ActivityUser) []components.Option {
	options := []components.Option{}
	for _, user := range users {
		options = append(options, components.Option{Value: user.Value(), Label: user.Label()})
	}
	return options
}

templ activityIcon(action string) {
	switch  {
		case action == "app.rolled_back":
			@components.Icon("undo")
		case action == "app.deployed" || action == "app.installed" || action == "app.updated" || action == "app.redeployed" || action == "app.restarted" || action == "app.started" || strings.HasPrefix(action, "deploy."):
			@components.Icon("deploy")
		case action == "app.stopped":
			@components.Icon("stop")
		case strings.HasPrefix(action, "data."):
			@components.Icon("database")
		case strings.HasPrefix(action, "backup."):
			@components.Icon("bucket")
		case strings.HasPrefix(action, "server."):
			@components.Icon("server")
		case strings.HasPrefix(action, "env."):
			@components.Icon("key")
		case strings.HasPrefix(action, "workspace."):
			@components.Icon("users")
		default:
			@components.Icon("activity")
	}
}
