package pages

import (
	"strconv"
	"time"

	"github.com/axadrn/moin/hub/internal/brand"
	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// HomeOpen is what the changelog says about how moin ships: how many
// versions since the first, and the newest one. Read from the changelog on
// every visit, so it is always true.
type HomeOpen struct {
	Releases int
	Since    time.Time
	Latest   service.Release
}

// NewHomeOpen counts the versions, newest first as the changelog lists them.
func NewHomeOpen(releases []service.Release) HomeOpen {
	if len(releases) == 0 {
		return HomeOpen{}
	}
	return HomeOpen{Releases: len(releases), Since: releases[len(releases)-1].Date, Latest: releases[0]}
}

// HomeOpenAndAgents is the trust a young product can show without logos:
// the code is open and it ships often, counted from the real changelog.
// Next to it: AI agents use the same CLI you do.
templ HomeOpenAndAgents(open HomeOpen) {
	<section class="moin-band">
		<div class="moin-grid" data-cols="2">
			if open.Releases > 0 {
				@components.Card(components.CardProps{Attrs: templ.Attributes{"id": "open", "data-gap": "6", "style": "--pad:2rem"}}) {
					<h2 class="moin-statement">Built in the open.</h2>
					@components.List() {
						@components.Item(components.ItemProps{Href: layouts.GitHubURL, Name: "Open source", Note: "Every line on GitHub"})
						@components.Item(components.ItemProps{Href: "/changelog", Name: homeVersions(open.Releases), Note: "Since " + open.Since.Format("January 2, 2006")})
						@components.Item(components.ItemProps{Href: "/changelog", Name: open.Latest.Version, Note: open.Latest.Date.Format("January 2")})
					}
				}
			}
			@components.Card(components.CardProps{Href: "/docs/cli#ai-agents", Attrs: templ.Attributes{"id": "agents", "data-gap": "3", "style": "--pad:2rem"}}) {
				<h2 class="moin-statement">AI agents use the CLI.</h2>
				<p class="moin-text moin-muted">Claude Code. Codex. Cursor. They use { brand.Name } like you do. Every reading command takes --json. Every command that deletes needs --yes. So each step shows in the agent's transcript.</p>
			}
		</div>
	</section>
}

func homeVersions(n int) string {
	if n == 1 {
		return "1 version"
	}
	return strconv.Itoa(n) + " versions"
}
