package pages

import (
	"strconv"
	"time"

	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/hub/internal/ui/layouts"
)

// HomeOpen is what the changelog says about how moin ships: how many
// versions since the first, and the newest one. Read from the changelog on
// every visit, so it is always true.
type HomeOpen struct {
	Releases int
	Since    time.Time
	Latest   service.Release
}

// NewHomeOpen counts the versions, newest first as the changelog lists them.
func NewHomeOpen(releases []service.Release) HomeOpen {
	if len(releases) == 0 {
		return HomeOpen{}
	}
	return HomeOpen{Releases: len(releases), Since: releases[len(releases)-1].Date, Latest: releases[0]}
}

// HomeOpenSection is the trust a young product can show without logos: the
// code is open, and it ships often, counted from the real changelog.
templ HomeOpenSection(open HomeOpen) {
	if open.Releases > 0 {
		<section id="open" class="moin-band">
			<h2 class="moin-statement">Built in the open.</h2>
			@components.List() {
				@components.Item(components.ItemProps{Href: layouts.GitHubURL, Name: "Open source", Note: "AGPL-3.0, every line on GitHub"})
				@components.Item(components.ItemProps{Href: "/changelog", Name: homeVersions(open.Releases), Note: "Since " + open.Since.Format("January 2, 2006")})
				@components.Item(components.ItemProps{Href: "/changelog", Name: open.Latest.Version, Note: open.Latest.Date.Format("January 2")})
			}
		</section>
	}
}

func homeVersions(n int) string {
	if n == 1 {
		return "1 version"
	}
	return strconv.Itoa(n) + " versions"
}
