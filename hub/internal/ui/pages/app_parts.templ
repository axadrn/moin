package pages

import (
	"time"

	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/internal/human"
)

// The parts every page of the hub is built from.

// panelPage is the width and the gutters of a page. It stacks its children
// 24 px apart, so sections never bring margins of their own.
templ panelPage(attrs ...templ.Attributes) {
	{{ var a templ.Attributes }}
	if len(attrs) > 0 {
		{{ a = attrs[0] }}
	}
	<div class="moin-page moin-content" { a... }>
		{ children... }
	</div>
}

// panelProps is a card whose body runs from edge to edge: its title and the
// actions next to it.
type panelProps struct {
	// ID is the card's id; Heading the id of its title, for aria-labelledby.
	ID      string
	Heading string
	Title   string
	Action  templ.Component
	Attrs   templ.Attributes
}

// panel is a components.Card for a log: the body runs from edge to edge and
// fills the card, and the title has an id for aria-labelledby.
templ panel(p panelProps) {
	{{ attrs := templ.Attributes{"role": "region"} }}
	for k, v := range p.Attrs {
		{{ attrs[k] = v }}
	}
	if p.Heading != "" {
		{{ attrs["aria-labelledby"] = p.Heading }}
	}
	<section
		if p.ID != "" {
			id={ p.ID }
		}
		class="moin-card moin-fill"
		data-flush
		{ attrs... }
	>
		<div class="moin-card-head">
			<h2
				if p.Heading != "" {
					id={ p.Heading }
				}
				class="moin-heading"
			>{ p.Title }</h2>
			if p.Action != nil {
				<div class="moin-row" data-wrap data-gap="2">
					@p.Action
				</div>
			}
		</div>
		<div class="moin-stack moin-fill">
			{ children... }
		</div>
	</section>
}

// copyButton copies value, or the text of the element target selects: a
// round button whose icon turns into a check for a moment (data-copy, in
// hub.js).
templ copyButton(value, target, label string) {
	{{ attrs := templ.Attributes{"data-copy": value, "aria-label": label, "title": label} }}
	if target != "" {
		{{ attrs["data-copy-target"] = target }}
	}
	@components.Button(components.ButtonProps{Icon: true, Quiet: true, Attrs: attrs}) {
		@components.Icon("copy")
	}
}

// switchForm is a switch that saves itself (DESIGN.md, Feedback), a row of
// a components.List: its words and the switch with the id switchID. A change
// posts the switch, as "on", to action, which saves only that and answers
// this row as stored. The switch is disabled while it saves, so a second
// click cannot overtake the first; its id keeps the focus on it when the
// answer swaps the row.
templ switchForm(id, action, switchID, name, note string, on bool) {
	@components.Item(components.ItemProps{Form: true, For: switchID, Name: name, Note: note, Attrs: templ.Attributes{"id": id, "hx-post": action, "hx-trigger": "change", "hx-target": "this", "hx-swap": "outerHTML", "hx-disable": "find input[type='checkbox']"}}) {
		@components.CSRF()
		@components.Switch(components.SwitchProps{ID: switchID, Name: "on", Value: "1", Checked: on})
	}
}

// took is the length of a deploy, "14s" or "1m 5s", and nothing while it runs.
func took(start time.Time, end *time.Time) string {
	if end == nil {
		return ""
	}
	return human.Duration(end.Sub(start))
}

func stamp(t time.Time) string {
	return t.UTC().Format("Jan 2, 2006 15:04:05 UTC")
}
