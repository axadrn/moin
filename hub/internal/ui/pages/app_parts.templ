package pages

import (
	"maps"
	"slices"
	"strings"
	"time"

	"github.com/axadrn/moin/hub/internal/service"
	"github.com/axadrn/moin/hub/internal/ui/components"
	"github.com/axadrn/moin/internal/human"
)

// The parts every page of the hub is built from.

// panelPage is the width and the gutters of a page. It stacks its children
// 24 px apart, so sections never bring margins of their own.
templ panelPage(attrs ...templ.Attributes) {
	{{ var a templ.Attributes }}
	if len(attrs) > 0 {
		{{ a = attrs[0] }}
	}
	<div class="moin-page moin-content" { a... }>
		{ children... }
	</div>
}

// panelProps is a card whose body runs from edge to edge: its title and the
// actions next to it.
type panelProps struct {
	// ID is the card's id; Heading the id of its title, for aria-labelledby.
	ID      string
	Heading string
	Title   string
	Action  templ.Component
	Attrs   templ.Attributes
}

// panel is a components.Card for a log: the body runs from edge to edge and
// fills the card, and the title has an id for aria-labelledby.
templ panel(p panelProps) {
	{{ attrs := templ.Attributes{"role": "region"} }}
	for k, v := range p.Attrs {
		{{ attrs[k] = v }}
	}
	if p.Heading != "" {
		{{ attrs["aria-labelledby"] = p.Heading }}
	}
	<section
		if p.ID != "" {
			id={ p.ID }
		}
		class="moin-card moin-fill"
		data-flush
		{ attrs... }
	>
		<div class="moin-card-head">
			<h2
				if p.Heading != "" {
					id={ p.Heading }
				}
				class="moin-heading"
			>{ p.Title }</h2>
			if p.Action != nil {
				<div class="moin-row" data-wrap data-gap="2">
					@p.Action
				</div>
			}
		</div>
		<div class="moin-stack moin-fill">
			{ children... }
		</div>
	</section>
}

// copyButton copies value, or the text of the element target selects: a
// round button whose icon turns into a check for a moment (data-copy, in
// hub.js).
templ copyButton(value, target, label string) {
	{{ attrs := templ.Attributes{"data-copy": value, "aria-label": label, "title": label} }}
	if target != "" {
		{{ attrs["data-copy-target"] = target }}
	}
	@components.Button(components.ButtonProps{Icon: true, Quiet: true, Attrs: attrs}) {
		@components.Icon("copy")
	}
}

// switchForm is a switch that saves itself (DESIGN.md, Feedback), a row of
// a components.List: its words and the switch with the id switchID. A change
// posts the switch, as "on", to action, which saves only that and answers
// this row as stored. The switch is disabled while it saves, so a second
// click cannot overtake the first; its id keeps the focus on it when the
// answer swaps the row.
templ switchForm(id, action, switchID, name, note string, on bool) {
	@components.Item(components.ItemProps{Form: true, For: switchID, Name: name, Note: note, Attrs: templ.Attributes{"id": id, "hx-post": action, "hx-trigger": "change", "hx-target": "this", "hx-swap": "outerHTML", "hx-disable": "find input[type='checkbox']"}}) {
		@components.CSRF()
		@components.Switch(components.SwitchProps{ID: switchID, Name: "on", Value: "1", Checked: on})
	}
}

// took is the length of a deploy, "14s" or "1m 5s", and nothing while it runs.
func took(start time.Time, end *time.Time) string {
	if end == nil {
		return ""
	}
	return human.Duration(end.Sub(start))
}

func stamp(t time.Time) string {
	return t.UTC().Format("Jan 2, 2006 15:04:05 UTC")
}

// ---------------------------------------------------------------- secrets on servers

// A bucket key, a registry login and the Tailscale key live only on the
// servers: moin forwards a value once and keeps the name. These parts say
// which server keeps one and take it for a server that does not.

// secretOn is where a secret is, in one quiet line: the servers that keep
// it, or none.
func secretOn(where service.SecretServers) string {
	if len(where.On) == 0 {
		return "On no server yet"
	}
	names := make([]string, 0, len(where.On))
	for _, on := range where.On {
		names = append(names, on.Server)
	}
	return "On " + strings.Join(names, ", ")
}

// secretServerNames are the servers of the workspace, the ones without the
// secret first: every server shows up in one of the two lists.
func secretServerNames(where service.SecretServers) []string {
	names := slices.Clone(where.MissingOn)
	for _, on := range where.On {
		names = append(names, on.Server)
	}
	return names
}

// missingSecretProps is a server that does not keep a secret: Sentence
// says so, Action and Target where the form goes, Field and Label the
// field of the value, Hidden what else the save needs.
type missingSecretProps struct {
	Server   string
	Sentence string
	Action   string
	Target   string
	Field    string
	Label    string
	Hidden   map[string]string
}

// missingSecret takes the secret for one server that does not keep it.
templ missingSecret(p missingSecretProps) {
	{{ id := "secret-" + p.Field + "-" + p.Server }}
	@components.Item(components.ItemProps{Form: true, For: id, Lead: connectedDot(false), Name: p.Server, Note: p.Sentence, Attrs: templ.Attributes{
		"hx-post":             p.Action,
		"hx-target":           p.Target,
		"hx-select":           p.Target,
		"hx-swap":             "outerHTML",
		"hx-disable":          "find button[type='submit']",
		"data-secret-missing": p.Server,
	}}) {
		@components.CSRF()
		<input type="hidden" name="server" value={ p.Server }/>
		for _, key := range slices.Sorted(maps.Keys(p.Hidden)) {
			<input type="hidden" name={ key } value={ p.Hidden[key] }/>
		}
		<div class="moin-row moin-width" data-gap="2" style="--width:20rem">
			@components.Input(components.InputProps{Attrs: templ.Attributes{"id": id, "name": p.Field, "type": "password", "autocomplete": "off", "placeholder": p.Label, "aria-label": p.Label, "required": true}})
			@components.Button(components.ButtonProps{Type: "submit"}) {
				Save
			}
		</div>
	}
}

// serverField picks the server that checks and keeps a new secret, when
// the workspace has more than one; with one, moin takes it.
templ serverField(id string, servers []string) {
	if len(servers) > 1 {
		@formField("Server", id, "Keeps the key. Enter it for the others below once it is saved.", "") {
			@components.Select(components.SelectProps{ID: id, Name: "server", Label: "Server", Options: nameOptions(servers), Value: servers[0]})
		}
	}
}

func nameOptions(names []string) []components.Option {
	options := make([]components.Option, 0, len(names))
	for _, name := range names {
		options = append(options, components.Option{Value: name, Label: name})
	}
	return options
}
