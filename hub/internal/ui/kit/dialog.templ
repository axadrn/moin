package kit

// Dialog is a question that floats over the page: the confirm dialog and
// the account's typed DELETE, nothing else (DESIGN.md, Asking first). A
// native modal dialog, one step lighter than the page, with its title, a
// line under it (both can be filled by a script: data-dialog-title,
// data-dialog-note), the content and DialogButtons at the end. A button
// with OpenDialog opens it; one with data-close-dialog closes it, and so
// do Escape and a click beside it (hub.js). Its controls are one step
// lighter than it, as it is one step lighter than the page.
templ Dialog(id, title, note string) {
	<dialog id={ id } data-dialog aria-labelledby={ id + "-title" } aria-describedby={ id + "-note" } class="m-auto w-[min(28rem,calc(100%-2rem))] rounded-4xl bg-popover p-6 text-popover-foreground shadow-2xl backdrop:bg-black/30 dark:[--muted:#3a3a3c]">
		<div class="flex flex-col gap-5">
			<div class="flex flex-col gap-1">
				<h2 id={ id + "-title" } class="text-base font-medium" data-dialog-title>{ title }</h2>
				<p id={ id + "-note" } class="text-sm text-muted-foreground empty:hidden" data-dialog-note>{ note }</p>
			</div>
			{ children... }
		</div>
	</dialog>
}

// DialogButtons are the buttons at the end of a Dialog: side by side on
// the right, the one that does it last; under each other on a phone, the
// one that does it on top, where the thumb is.
templ DialogButtons() {
	<div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
		{ children... }
	</div>
}

// OpenDialog are the attributes of a button that opens the Dialog id (a
// RowButton, or a Button with "type": "button" added).
func OpenDialog(id string) templ.Attributes {
	return templ.Attributes{"data-open-dialog": id, "aria-haspopup": "dialog"}
}

// CloseDialog are the attributes of a button that closes its Dialog.
func CloseDialog() templ.Attributes {
	return templ.Attributes{"type": "button", "data-close-dialog": true}
}
