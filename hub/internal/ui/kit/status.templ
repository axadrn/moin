package kit

// State is one of the states every status in moin shows as (DESIGN.md,
// Status): live ● (online, the live deploy), running ◐ (deploying), waiting
// ○ in the running color (a daemon that never connected), done ✓ muted (a
// deploy that succeeded but is no longer live), failed ✗ (failed, offline)
// and idle ○ (new, unknown).
type State string

const (
	StateLive    State = "live"
	StateRunning State = "running"
	StateWaiting State = "waiting"
	StateDone    State = "done"
	StateFailed  State = "failed"
	StateIdle    State = "idle"
)

// Status is a state's dot and its word (children), in a line of text: a
// deploy in a row, a line under a head. A long word wraps under itself,
// the dot stays with the first line. Attributes carry data-* for tests.
templ Status(state State, attributes templ.Attributes) {
	<span data-state={ string(stateOf(state)) } class={ "inline-flex items-start gap-2 text-sm font-medium", statusWord(state) } { attributes... }>
		<span class="flex h-5 shrink-0 items-center">
			@Dot(state)
		</span>
		<span>
			{ children... }
		</span>
	</span>
}

// Chip is a state's dot and its word in a soft tinted pill: the state of
// a thing next to its name (a server, an app, the plan).
templ Chip(state State) {
	<span data-state={ string(stateOf(state)) } class={ "inline-flex h-7 shrink-0 items-center gap-2 rounded-full pr-3 pl-2.5 text-sm font-medium whitespace-nowrap", chipColor(state) }>
		@Dot(state)
		<span>
			{ children... }
		</span>
	</span>
}

// Dot is the state alone, 8 px, in its color: live breathes, running
// blinks, waiting and idle are rings, done is a muted check. Next to the
// words that name it, or with a title.
templ Dot(state State) {
	switch stateOf(state) {
		case StateLive:
			<span aria-hidden="true" class="moin-dot-live inline-block size-2 shrink-0 rounded-full bg-live"></span>
		case StateRunning:
			<span aria-hidden="true" class="moin-dot-run inline-block size-2 shrink-0 rounded-full bg-running"></span>
		case StateWaiting:
			<span aria-hidden="true" class="inline-block size-2 shrink-0 rounded-full border-[1.5px] border-running"></span>
		case StateDone:
			<svg aria-hidden="true" viewBox="0 0 10 10" class="size-2.5 shrink-0 text-muted-foreground"><path d="M1.75 5.25 4 7.5l4.25-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		case StateFailed:
			<span aria-hidden="true" class="inline-block size-2 shrink-0 rounded-full bg-failed"></span>
		default:
			<span aria-hidden="true" class="inline-block size-2 shrink-0 rounded-full border-[1.5px] border-muted-foreground"></span>
	}
}

// stateOf is the state, idle for one it does not know.
func stateOf(state State) State {
	switch state {
	case StateLive, StateRunning, StateWaiting, StateDone, StateFailed:
		return state
	}
	return StateIdle
}

// statusWord is the color of a status' word: red when it failed, quiet
// when it is over or unknown, the text color otherwise.
func statusWord(state State) string {
	switch stateOf(state) {
	case StateFailed:
		return "text-failed"
	case StateIdle, StateDone:
		return "text-muted-foreground"
	}
	return "text-foreground"
}

// chipColor tints a chip with its state, the word a little darker (or
// lighter) than the dot, so it reads on the tint in both themes.
func chipColor(state State) string {
	switch stateOf(state) {
	case StateLive:
		return "bg-live/16 text-[color-mix(in_oklab,var(--live),var(--foreground)_18%)]"
	case StateRunning, StateWaiting:
		return "bg-running/16 text-[color-mix(in_oklab,var(--running),var(--foreground)_28%)]"
	case StateFailed:
		return "bg-failed/15 text-[color-mix(in_oklab,var(--failed),var(--foreground)_12%)]"
	}
	return "bg-muted text-muted-foreground"
}
