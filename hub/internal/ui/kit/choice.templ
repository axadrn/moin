package kit

import "github.com/axadrn/moin/hub/internal/ui/parts"

// Option is one answer of a Choice.
type Option = parts.Option

// Choice is "one of these" inside a form: radio buttons drawn like the
// Segmented control. The checked radio is the value the form sends, and
// CSS can show what goes with it (has-[#name-value:checked]), so there is
// no script. Each radio's id is name-value. A div, not a fieldset: a
// fieldset's legend breaks the row.
templ Choice(name, label string, options []Option, checked string) {
	<div role="radiogroup" aria-label={ label } class="flex h-11 w-fit items-center gap-1 rounded-full bg-muted p-1">
		for _, o := range options {
			<label class="flex h-full cursor-pointer items-center rounded-full px-4 text-sm font-medium text-muted-foreground has-checked:bg-background has-checked:text-foreground has-checked:shadow-sm has-focus-visible:ring-3 has-focus-visible:ring-ring/30">
				<input type="radio" id={ name + "-" + o.Value } name={ name } value={ o.Value } checked?={ o.Value == checked } autocomplete="off" class="sr-only"/>
				{ o.Label }
			</label>
		}
	</div>
}

// SurfaceShown goes on what holds a Choice of the surfaces and the parts
// marked data-surface: it shows the part of the checked surface, one rule
// per surface, written out so Tailwind finds them.
const SurfaceShown = "[&:has([value=web]:checked)_[data-surface=web]]:block [&:has([value=cli]:checked)_[data-surface=cli]]:block [&:has([value=tui]:checked)_[data-surface=tui]]:block [&:has([value=api]:checked)_[data-surface=api]]:block [&:has([value=mcp]:checked)_[data-surface=mcp]]:block"
