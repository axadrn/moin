package kit

import "strings"

// The icons of moin, drawn for it: one 24 × 24 grid, one stroke of 1.75
// with round ends, plain lines, circles and arcs, filled only where a
// shape needs it. They draw in currentColor, so they follow the text,
// light and dark, hover and state. 20 px unless class names a size. Only
// the icons moin uses are here; /dev/kit shows them all. The brand marks
// at the end keep their owners' shapes.
templ icon(class string) {
	<svg class={ iconClass(class) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		{ children... }
	</svg>
}

// iconClass is 20 px, or the size the class names.
func iconClass(class string) string {
	if strings.Contains(class, "size-") {
		return "shrink-0 " + class
	}
	return strings.TrimSpace("size-5 shrink-0 " + class)
}

// IconActivity is the pulse: activity, metrics.
templ IconActivity(class string) {
	@icon(class) {
		<path d="M3.5 12h3.5l2.5-6 5 12 2.5-6h3.5"></path>
	}
}

// IconApp is a box: one app.
templ IconApp(class string) {
	@icon(class) {
		<path d="M12 3.5l7.5 4v9l-7.5 4-7.5-4v-9z"></path>
		<path d="M4.5 7.5l7.5 4 7.5-4M12 11.5v9"></path>
	}
}

// IconApps are layers: all the apps.
templ IconApps(class string) {
	@icon(class) {
		<path d="M12 4l8 4-8 4-8-4z"></path>
		<path d="M4 12l8 4 8-4M4 16l8 4 8-4"></path>
	}
}

// IconBell is an alert.
templ IconBell(class string) {
	@icon(class) {
		<path d="M5.75 16.5h12.5l-1.5-2v-4a4.75 4.75 0 0 0-9.5 0v4z"></path>
		<path d="M10.25 19.5a1.75 1.75 0 0 0 3.5 0"></path>
	}
}

// IconBook is an open book: the docs.
templ IconBook(class string) {
	@icon(class) {
		<path d="M12 6.5c-1.8-1.3-4.3-2-7.5-2v13c3.2 0 5.7.7 7.5 2 1.8-1.3 4.3-2 7.5-2v-13c-3.2 0-5.7.7-7.5 2z"></path>
		<path d="M12 6.5v13"></path>
	}
}

// IconBucket is the bucket the backups go to.
templ IconBucket(class string) {
	@icon(class) {
		<ellipse cx="12" cy="6.5" rx="7.5" ry="2.5"></ellipse>
		<path d="M4.5 6.5l1.75 11.75c.25 1.4 2.75 2.25 5.75 2.25s5.5-.85 5.75-2.25L19.5 6.5"></path>
	}
}

// IconCatalog is a grid of tiles: the catalog.
templ IconCatalog(class string) {
	@icon(class) {
		<rect x="4.5" y="4.5" width="6" height="6" rx="1.75"></rect>
		<rect x="13.5" y="4.5" width="6" height="6" rx="1.75"></rect>
		<rect x="4.5" y="13.5" width="6" height="6" rx="1.75"></rect>
		<rect x="13.5" y="13.5" width="6" height="6" rx="1.75"></rect>
	}
}

// IconCheck is done.
templ IconCheck(class string) {
	@icon(class) {
		<path d="M5 12.5l4.5 4.5L19 7.5"></path>
	}
}

