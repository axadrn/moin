package kit

// Command is a terminal command to copy: the command in mono on one line,
// scrolling sideways when long, and a copy button that turns into a check
// for a moment (data-copy, in the panel script).
templ Command(command string) {
	<div class="flex h-11 min-w-0 items-center gap-2 rounded-full bg-muted pr-1.5 pl-5">
		<code class="min-w-0 flex-1 overflow-x-auto font-mono text-sm whitespace-nowrap [scrollbar-width:none]">{ command }</code>
		<button type="button" data-copy={ command } aria-label="Copy the command" class="group/copy flex size-8 shrink-0 items-center justify-center rounded-full text-muted-foreground outline-none hover:bg-foreground/5 hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/30">
			<svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 group-data-copied/copy:hidden"><rect x="5.5" y="5.5" width="8" height="8" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"></rect><path d="M10.5 3.5v-.5a1.5 1.5 0 0 0-1.5-1.5h-5a1.5 1.5 0 0 0-1.5 1.5v5a1.5 1.5 0 0 0 1.5 1.5h.5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
			<svg aria-hidden="true" viewBox="0 0 16 16" class="hidden size-4 text-live group-data-copied/copy:block"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		</button>
	</div>
}
