package kit

import "github.com/axadrn/moin/hub/internal/brand"

// Wordmark is "moin." as a shape, the one in assets/img/logo.svg. Its size
// follows the font size around it.
templ Wordmark(class ...string) {
	<span class={ "inline-flex text-foreground", class }>
		<svg viewBox="0 -850 2509 1000" class="h-[1em] w-[2.509em] fill-current" role="img" aria-label={ brand.Name }>
			<path d="M212 0H58V-500H202L212 -448Q261 -516 358 -516Q462 -516 510 -428Q530 -468 572.0 -492.0Q614 -516 667 -516Q761 -516 810.5 -465.5Q860 -415 860 -327V0H706V-284Q706 -330 684.0 -353.5Q662 -377 624.0 -377.0Q586 -377 561.0 -352.0Q536 -327 536 -268V0H382V-284Q382 -329 360.5 -352.5Q339 -376 301.0 -376.0Q263 -376 237.5 -351.0Q212 -326 212 -268ZM1179.0 -515Q1299.0 -515 1376.5 -442.0Q1454.0 -369 1454.0 -251Q1454.0 -134 1376.5 -61.0Q1299.0 12 1179.0 12Q1058.0 12 980.5 -60.5Q903.0 -133 903.0 -251.0Q903.0 -369 980.5 -442.0Q1058.0 -515 1179.0 -515ZM1058.0 -252Q1058.0 -195 1091.5 -160.5Q1125.0 -126 1179.0 -126Q1232.0 -126 1265.5 -160.5Q1299.0 -195 1299.0 -252Q1299.0 -308 1265.5 -342.5Q1232.0 -377 1179.0 -377Q1125.0 -377 1091.5 -342.5Q1058.0 -308 1058.0 -252ZM1579.0 -578Q1542.0 -578 1516.5 -603.5Q1491.0 -629 1491.0 -666.0Q1491.0 -703 1516.5 -728.0Q1542.0 -753 1579.0 -753Q1615.0 -753 1640.5 -728.0Q1666.0 -703 1666.0 -666.0Q1666.0 -629 1640.5 -603.5Q1615.0 -578 1579.0 -578ZM1503.0 0V-500H1657.0V0ZM1887.0 0H1733.0V-500H1878.0L1888.0 -448Q1937.0 -516 2041.0 -516Q2130.0 -516 2179.5 -461.5Q2229.0 -407 2229.0 -309V0H2075.0V-272Q2075.0 -319 2051.0 -347.5Q2027.0 -376 1987.0 -376Q1941.0 -376 1914.0 -348.5Q1887.0 -321 1887.0 -274ZM2395.0 13Q2357.0 13 2330.0 -13.5Q2303.0 -40 2303.0 -77Q2303.0 -115 2330.0 -141.5Q2357.0 -168 2395.0 -168Q2432.0 -168 2459.5 -141.0Q2487.0 -114 2487.0 -77.0Q2487.0 -40 2459.5 -13.5Q2432.0 13 2395.0 13Z"></path>
		</svg>
	</span>
}

// BetaBadge says moin is in beta, next to the wordmark, centered on it with
// items-center: Wordmark trims its box to its lowercase letters.
templ BetaBadge(class string) {
	<span class={ "rounded-full bg-muted px-2 py-0.5 font-sans text-xs font-medium text-muted-foreground", class }>Beta</span>
}
