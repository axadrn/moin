package layouts

import (
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/ui/kit"
)

// Admin is the shell of the operator pages: the same quiet bar as the
// panel (h-16, the wordmark back into the panel), and the page under it.
// The pages bring their own panelPage, so their titles sit where every
// other title sits.
templ Admin(title string) {
	@Base(SEOProps{Title: title, Description: "Operator administration", Path: ctxkeys.URLPath(ctx), NoIndex: true}) {
		<header id="app-bar" class="hub-bar sticky top-0 z-40 bg-background/85 backdrop-blur-xl">
			<div class={ kit.Page, "flex h-16 items-center gap-1" }>
				<a href="/app" class="mr-3 flex shrink-0 items-center rounded-lg outline-none focus-visible:ring-3 focus-visible:ring-ring/30" aria-label="Overview">
					@kit.Wordmark("text-xl leading-none")
				</a>
			</div>
		</header>
		<div id="main">
			{ children... }
		</div>
	}
}
