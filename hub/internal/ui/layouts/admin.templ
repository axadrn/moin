package layouts

import (
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/ui/components"
)

// Admin is the shell of the operator pages: the same quiet bar as the
// panel (the wordmark back into the panel), and the page under it.
// The pages bring their own panelPage, so their titles sit where every
// other title sits.
templ Admin(title string) {
	@Base(SEOProps{Title: title, Description: "Operator administration", Path: ctxkeys.URLPath(ctx), NoIndex: true}) {
		@components.Bar(components.BarProps{ID: "app-bar"}) {
			<a href="/app" class="moin-row" aria-label="Overview">
				@components.Wordmark(components.WordmarkProps{})
			</a>
		}
		<div id="main">
			{ children... }
		</div>
	}
}
