package layouts

import (
	"strconv"
	"time"

	"github.com/axadrn/moin/hub/internal/brand"
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/ui/components"
)

// footerColumns are the links of the site footer. The maker's other open
// source projects sit next to moin, as one family.
func footerColumns(billing bool) []components.FooterColumn {
	product := []components.FooterLink{
		{Label: "Catalog", Href: "/catalog"},
		{Label: "UI", Href: "/ui"},
	}
	if billing {
		product = append(product, components.FooterLink{Label: "Pricing", Href: "/#pricing"})
	}
	product = append(product,
		components.FooterLink{Label: "Changelog", Href: "/changelog"},
		components.FooterLink{Label: "Roadmap", Href: "/docs/roadmap"},
	)
	return []components.FooterColumn{
		{Title: "Product", Links: product},
		{Title: "Docs", Links: []components.FooterLink{
			{Label: "Get started", Href: "/docs/getting-started"},
			{Label: "Self-hosting", Href: "/docs/self-hosting"},
			{Label: "CLI", Href: "/docs/reference/cli"},
			{Label: "API", Href: "/docs/reference/api"},
		}},
		{Title: "Open source", Links: []components.FooterLink{
			{Label: brand.Name + " on GitHub", Href: GitHubURL, External: true},
			{Label: "UI license", Href: GitHubURL + "/blob/main/ui/LICENSE", External: true},
			{Label: "shadcn-templ", Href: "https://shadcn-templ.com/?ref=moin-footer", External: true},
			{Label: "goilerplate", Href: "https://goilerplate.com/?ref=moin-footer", External: true},
		}},
		{Title: "Company", Links: []components.FooterLink{
			{Label: "Why " + brand.Name, Href: "/docs/why-moin"},
			{Label: "Terms", Href: "/legal/terms"},
			{Label: "Privacy", Href: "/legal/privacy"},
		}},
	}
}

// Footer is the site footer: the wordmark and the promise, the columns, then
// a line with the company and the maker.
templ Footer() {
	@components.Footer(components.FooterProps{Columns: footerColumns(ctxkeys.RenderConfig(ctx).Billing), End: footerEnd()}) {
		<a href="/" aria-label={ brand.Name + " home" }>
			@components.Wordmark(components.WordmarkProps{})
		</a>
		<p>
			Deploy anything.
			<br/>
			Lose nothing.
		</p>
		<a href={ templ.SafeURL("mailto:" + brand.SupportEmail) } class="moin-link">{ brand.SupportEmail }</a>
	}
}

templ footerEnd() {
	<span>© { strconv.Itoa(time.Now().Year()) } { brand.Company }</span>
	<span class="moin-row" data-gap="4">
		<span>Made by <a href="https://x.com/axadrn" target="_blank" rel="me noopener" class="moin-link">Axel Adrian</a></span>
		// The theme lives here only: the navbar keeps the places and the one
		// way in.
		@components.ModeSwitch()
	</span>
}
