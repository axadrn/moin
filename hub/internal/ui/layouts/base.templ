package layouts

import (
	"github.com/axadrn/moin/hub/internal/ui/components"
)

import "github.com/axadrn/moin/hub/internal/brand"
import "github.com/axadrn/moin/hub/internal/ctxkeys"

type SEOProps struct {
	Title        string
	Description  string
	Path         string
	NoIndex      bool
	MarkdownPath string
	// Public pages (home, docs, changelog, catalog, legal) carry the page
	// counter; the app, the admin and sign-in never do.
	Public bool
}

templ Base(props ...SEOProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="csrf-token" content={ ctxkeys.CSRFToken(ctx) }/>
			if len(props) > 0 {
				@seo(props[0])
			} else {
				<title>{ brand.Name }</title>
			}
			<link rel="icon" href="/favicon.ico" sizes="32x32"/>
			<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml"/>
			<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png"/>
			// The text font loads with the stylesheet, not after it, so the
			// first paint is already in Geist.
			<link rel="preload" href="/assets/fonts/geist/geist-variable.woff2" as="font" type="font/woff2" crossorigin/>
			<link href={ components.AssetURL("/assets/css/output.css") } rel="stylesheet"/>
			<link href={ components.AssetURL("/assets/ui/moin.css") } rel="stylesheet"/>
			<link href={ components.AssetURL("/assets/css/hub.css") } rel="stylesheet"/>
			// Scripts in swapped content get the page's nonce, so the CSP lets
			// them run.
			<meta name="htmx-config" content={ `{"history":"reload","inlineScriptNonce":"` + templ.GetNonce(ctx) + `"}` }/>
			<script src="/assets/js/htmx-4.0.0.e484d917.min.js"></script>
			// Server-sent events swap HTML as it streams (hx-sse:connect).
			<script src="/assets/js/hx-sse-4.0.0.min.js"></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ components.AssetURL("/assets/ui/moin.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ components.AssetURL("/assets/js/hub.js") }></script>
			// A link starts loading when the pointer rests on it, so the page
			// is there on the click (Chrome and Edge; others ignore it). Only
			// pages: never sign in or out, GitHub or the API.
			<script type="speculationrules" nonce={ templ.GetNonce(ctx) }>
				{"prefetch":[{"where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":"/auth/*"}},{"not":{"href_matches":"/api/*"}},{"not":{"href_matches":"/*/github/*"}},{"not":{"href_matches":"/*\\?*"}}]},"eagerness":"moderate"}]}
			</script>
			// Site-wide enhancements
			@themeScript()
			if len(props) > 0 && props[0].Public {
				@Analytics()
			}
		</head>
		<body
			hx-headers:inherited={ `{"X-CSRF-Token":"` + ctxkeys.CSRFToken(ctx) + `"}` }
		>
			{{ session := ctxkeys.Session(ctx) }}
			if session.IsImpersonating() {
				<div class="moin-alert moin-text" data-state="running" data-sticky>
					<span>You are viewing the application as another user.</span>
					<form
						action="/admin/impersonation/stop"
						method="POST"
						hx-post="/admin/impersonation/stop"
						hx-swap="none"
						hx-disable="find button[type='submit']"
					>
						@components.CSRF()
						@components.Button(components.ButtonProps{Type: "submit", Quiet: true}) {
							Return to Admin
						}
					</form>
				</div>
			}
			{ children... }
			<div id="feedback" hidden></div>
			@components.ConfirmDialog()
		</body>
	</html>
}

templ seo(props SEOProps) {
	{{ cfg := ctxkeys.RenderConfig(ctx) }}
	{{ baseURL := cfg.AppURL }}
	{{ appName := brand.Name }}
	{{ appTagline := brand.Tagline }}
	{{ fullTitle := props.Title + " · " + appName }}
	@templ.Fragment("seo-title") {
		<title id="page-title" hx-swap-oob="true">{ fullTitle }</title>
	}
	<meta name="description" content={ props.Description }/>
	// Author
	<meta name="author" content={ appName }/>
	// Robots Tags
	if props.NoIndex || cfg.RobotsNoIndex {
		<meta name="robots" content="noindex, nofollow"/>
	} else {
		<meta name="robots" content="index, follow"/>
	}
	// Canonical URL
	<link rel="canonical" href={ baseURL + props.Path }/>
	<link rel="describedby" href="/llms.txt"/>
	if props.MarkdownPath != "" {
		@templ.Fragment("seo-markdown") {
			<link id="seo-markdown" rel="alternate" type="text/markdown" href={ props.MarkdownPath } hx-swap-oob="outerHTML"/>
		}
	}
	// OpenGraph Tags
	<meta property="og:title" content={ fullTitle }/>
	<meta property="og:description" content={ props.Description }/>
	<meta property="og:type" content="website"/>
	<meta property="og:url" content={ baseURL + props.Path }/>
	<meta property="og:site_name" content={ appName }/>
	// OpenGraph Image
	<meta property="og:image" content={ baseURL + components.AssetURL("/assets/img/og.png") }/>
	<meta property="og:image:width" content="1200"/>
	<meta property="og:image:height" content="630"/>
	<meta property="og:image:alt" content={ appName + ": " + appTagline }/>
	// Twitter Card
	<meta name="twitter:card" content="summary_large_image"/>
	<meta name="twitter:title" content={ fullTitle }/>
	<meta name="twitter:description" content={ props.Description }/>
	<meta name="twitter:image" content={ baseURL + components.AssetURL("/assets/img/og.png") }/>
	<meta name="twitter:image:alt" content={ appName + ": " + appTagline }/>
	// Theme Color
	<meta name="theme-color" content="#000000"/>
}

templ themeScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		(function() {
			window.themeUtils = window.themeUtils || {};
			// One choice for all of moin. Browsers that chose before keep it.
			if (localStorage.getItem('theme')) {
				localStorage.setItem('moin-mode', localStorage.getItem('theme'));
				localStorage.removeItem('theme');
			}
			const media = window.matchMedia('(prefers-color-scheme: dark)');
			window.themeUtils.getThemePreference = function() {
				return localStorage.getItem('moin-mode') || 'system';
			};
			window.themeUtils.applyTheme = function() {
				const preference = window.themeUtils.getThemePreference();
				const isDark = preference === 'system' ? media.matches : preference === 'dark';
				const root = document.documentElement;
				root.classList.toggle('dark', isDark);
				root.classList.toggle('light', preference === 'light');
				// moin.js pins the scheme for a stored choice; system follows
				// the rules in the stylesheet again.
				root.style.colorScheme = preference === 'system' ? '' : preference;
				document.dispatchEvent(new CustomEvent('theme-changed'));
			};
			window.themeUtils.applyTheme();
			media.addEventListener('change', function() {
				if (window.themeUtils.getThemePreference() === 'system') window.themeUtils.applyTheme();
			});
		})();
	</script>
}
