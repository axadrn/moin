package layouts

import (
	"strings"

	"github.com/axadrn/moin/hub/internal/brand"
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/githubstars"
	"github.com/axadrn/moin/hub/internal/ui/parts"
)

// GitHubURL is the open source repository of moin.
const GitHubURL = "https://github.com/" + githubstars.Repo


// navLinks are the places of the public site. A self-hosted hub has no
// prices to show.
func navLinks(billing bool, path string) []parts.BarLink {
	links := []parts.BarLink{
		{Label: "Catalog", Href: "/catalog", Current: strings.HasPrefix(path, "/catalog")},
		{Label: "Docs", Href: "/docs", Current: strings.HasPrefix(path, "/docs")},
		{Label: "Kit", Href: "/kit"},
	}
	if billing {
		links = append(links, parts.BarLink{Label: "Pricing", Href: "/#pricing"})
	}
	return links
}

// starsShowAt is how many GitHub stars it takes before the navbar shows
// the count.
const starsShowAt = 1000

// Navbar is the floating pill of the public pages: the wordmark, the
// places, and the one way in. On a phone it keeps the wordmark, Docs and
// the way in; the footer has the rest. No menu: links change pages.
templ Navbar() {
	{{ user := ctxkeys.User(ctx) }}
	@parts.Bar(parts.BarProps{Float: true}) {
		<a href="/" class="kit-row" data-gap="2" aria-label={ brand.Name + " home, beta" }>
			@parts.Wordmark(parts.WordmarkProps{})
			@parts.Badge(parts.BadgeProps{Class: "kit-hidden-phone"}) {
				Beta
			}
		</a>
		@parts.BarLinks(parts.BarLinksProps{Label: "Main", Links: navLinks(ctxkeys.RenderConfig(ctx).Billing, ctxkeys.URLPath(ctx))})
		<span class="kit-fill"></span>
		// The one search of the site, where the app keeps its search: top
		// right, on every public page. Without JavaScript it is the page
		// /search.
		@parts.Button(parts.ButtonProps{Href: "/search", Icon: true, Quiet: true, Attrs: templ.Attributes{"data-site-search-open": true, "aria-label": "Search", "aria-keyshortcuts": "Meta+K /"}}) {
			<i class="kit-icon kit-icon-search"></i>
		}
		// The star count shows from starsShowAt on: a small one says
		// "nobody uses this", like the live numbers of the home page.
		<span class="kit-only-phone">
			@parts.Button(parts.ButtonProps{Href: "/docs", Quiet: true}) {
				Docs
			}
		</span>
		<span class="kit-hidden-phone">
			{{ stars := githubstars.Count() }}
			if stars >= starsShowAt {
				@parts.Button(parts.ButtonProps{Href: GitHubURL, Quiet: true, Attrs: templ.Attributes{"target": "_blank", "rel": "noopener", "aria-label": "GitHub"}}) {
					<i class="kit-icon kit-icon-git-hub"></i>
					{ githubstars.Short(stars) }
				}
			} else {
				@parts.Button(parts.ButtonProps{Href: GitHubURL, Icon: true, Quiet: true, Attrs: templ.Attributes{"target": "_blank", "rel": "noopener", "aria-label": "GitHub"}}) {
					<i class="kit-icon kit-icon-git-hub"></i>
				}
			}
		</span>
		// One way in: /auth signs in and signs up alike.
		{{ href, label := "/auth", "Deploy now" }}
		if user != nil {
			{{ href, label = "/app", "Overview" }}
		}
		@parts.Button(parts.ButtonProps{Kind: parts.Primary, Href: href}) {
			{ label }
		}
	}
}
