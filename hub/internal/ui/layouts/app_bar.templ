package layouts

import (
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/components"
)

// AppBar is the one bar of the hub, quiet: the wordmark home,
// the search and you. Your picture opens Settings, a page, not a menu, where
// the workspaces are (DESIGN.md, Navigation). It shows a line
// under it only once the page scrolls.
templ AppBar() {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ user := ctxkeys.User(ctx) }}
	@components.Bar(components.BarProps{ID: "app-bar", Attrs: templ.Attributes{"data-app-base": basePath}}) {
		<a href={ templ.SafeURL(basePath + "/overview") } class="moin-row" aria-label="Home">
			@components.Wordmark(components.WordmarkProps{})
		</a>
		<span class="moin-fill"></span>
		@components.Button(components.ButtonProps{Icon: true, Quiet: true, Attrs: templ.Attributes{"aria-label": "Search", "aria-keyshortcuts": "Meta+K /", "data-open-palette": true}}) {
			<i class="moin-icon moin-icon-search"></i>
		}
		if user != nil {
			<a href={ templ.SafeURL(basePath + "/settings") } class="moin-row" aria-label="Settings">
				@UserAvatar(user)
			</a>
		}
	}
	@palette(basePath)
}

// palette is the search, in the middle of the screen: ⌘K, ctrl+k, / or the
// search button open it (hub.js). What you type goes to the server, which
// answers the apps, servers, places and actions that match (htmx active
// search); the arrows pick one, Enter opens it, Escape or a click outside
// closes it.
templ palette(basePath string) {
	<dialog id="palette" class="moin-palette" aria-label="Search">
		<div class="moin-palette-box" data-search>
			<div class="moin-input-icon">
				<label for="search" class="moin-sr-only">Search or run a command</label>
				@components.Icon("search")
				@components.Input(components.InputProps{ID: "search", Name: "q", Type: "search", Placeholder: "Search, or type: deploy my-app", Attrs: templ.Attributes{
					"autocomplete":      "off",
					"spellcheck":        "false",
					"role":              "combobox",
					"aria-expanded":     "false",
					"aria-controls":     "search-results",
					"aria-autocomplete": "list",
					"hx-get":            basePath + "/search",
					"hx-include":        "#search-here, #search-recent",
					"hx-trigger":        "input changed delay:80ms, focus",
					"hx-target":         "#search-results",
					"hx-swap":           "innerHTML",
					"hx-sync":           "this:replace",
				}})
				<input type="hidden" id="search-here" name="here" value=""/>
				<input type="hidden" id="search-recent" name="recent" value=""/>
			</div>
			<div
				id="search-results"
				role="listbox"
				aria-label="Results"
				class="moin-palette-list"
			></div>
		</div>
	</dialog>
}

// UserAvatar carries an id, so a changed name or picture swaps it in place
// (IdentityUpdates).
templ UserAvatar(user *model.User) {
	<span id="bar-avatar" class="moin-row">
		@components.Avatar(components.AvatarProps{URL: user.AvatarURL, Name: user.Name, Initials: user.Initials()})
	</span>
}

// IdentityUpdates is what a changed name or picture swaps into the bar.
templ IdentityUpdates(user *model.User) {
	<span id="bar-avatar" class="moin-row" hx-swap-oob="true">
		@components.Avatar(components.AvatarProps{URL: user.AvatarURL, Name: user.Name, Initials: user.Initials()})
	</span>
}
