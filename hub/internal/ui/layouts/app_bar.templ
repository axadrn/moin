package layouts

import (
	"github.com/axadrn/moin/hub/internal/ctxkeys"
	"github.com/axadrn/moin/hub/internal/model"
	"github.com/axadrn/moin/hub/internal/ui/kit"
	"github.com/axadrn/moin/hub/internal/ui/parts"
)

// AppBar is the one bar of the hub, quiet: the wordmark home,
// the search and you. Your picture opens Settings, a page, not a menu, where
// the workspaces are (DESIGN.md, Navigation). It shows a line
// under it only once the page scrolls.
templ AppBar() {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ user := ctxkeys.User(ctx) }}
	<header id="app-bar" class="kit-bar" data-app-base={ basePath }>
		<div class="kit-page kit-bar-inner">
			<a href={ templ.SafeURL(basePath + "/overview") } class="kit-row" aria-label="Home">
				@kit.Wordmark("text-xl leading-none")
			</a>
			<span class="kit-fill"></span>
			@parts.Button(parts.ButtonProps{Icon: true, Quiet: true, Attrs: templ.Attributes{"aria-label": "Search", "aria-keyshortcuts": "Meta+K /", "data-open-palette": true}}) {
				<i class="kit-icon kit-icon-search"></i>
			}
			if user != nil {
				<a href={ templ.SafeURL(basePath + "/settings") } class="kit-row" aria-label="Settings">
					@UserAvatar(user)
				</a>
			}
		</div>
	</header>
	@palette(basePath)
}

// palette is the search, in the middle of the screen: ⌘K, ctrl+k, / or the
// search button open it (moin.js). What you type goes to the server, which
// answers the apps, servers, places and actions that match (htmx active
// search); the arrows pick one, Enter opens it, Escape or a click outside
// closes it.
templ palette(basePath string) {
	<dialog id="palette" class="fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-black/30" aria-label="Search">
		<div class="mx-auto mt-[12vh] flex max-h-[min(70vh,34rem)] w-[min(38rem,calc(100vw-2rem))] flex-col overflow-hidden rounded-4xl bg-popover text-popover-foreground shadow-2xl" data-search>
			<div class="relative shrink-0">
				<label for="search" class="sr-only">Search or run a command</label>
				@kit.IconSearch("pointer-events-none absolute top-1/2 left-5 size-5 -translate-y-1/2 text-muted-foreground")
				<input
					id="search"
					name="q"
					type="search"
					autocomplete="off"
					spellcheck="false"
					placeholder="Search, or type: deploy my-app"
					role="combobox"
					aria-expanded="false"
					aria-controls="search-results"
					aria-autocomplete="list"
					hx-get={ basePath + "/search" }
					hx-include="#search-here, #search-recent"
					hx-trigger="input changed delay:80ms, focus"
					hx-target="#search-results"
					hx-swap="innerHTML"
					hx-sync="this:replace"
					class="h-16 w-full bg-transparent pr-5 pl-14 text-base outline-none placeholder:text-muted-foreground [&::-webkit-search-cancel-button]:hidden"
				/>
				<input type="hidden" id="search-here" name="here" value=""/>
				<input type="hidden" id="search-recent" name="recent" value=""/>
			</div>
			<div
				id="search-results"
				role="listbox"
				aria-label="Results"
				class="flex flex-col gap-0.5 overflow-y-auto border-t border-border p-1.5 empty:hidden"
			></div>
		</div>
	</dialog>
}

// UserAvatar carries an id, so a changed name or picture swaps it in place
// (IdentityUpdates).
templ UserAvatar(user *model.User) {
	<span id="bar-avatar" class="contents">
		@parts.Avatar(parts.AvatarProps{URL: user.AvatarURL, Name: user.Name, Initials: user.Initials()})
	</span>
}

// IdentityUpdates is what a changed name or picture swaps into the bar.
templ IdentityUpdates(user *model.User) {
	<span id="bar-avatar" class="contents" hx-swap-oob="true">
		@parts.Avatar(parts.AvatarProps{URL: user.AvatarURL, Name: user.Name, Initials: user.Initials()})
	</span>
}
