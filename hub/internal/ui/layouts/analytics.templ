package layouts

import "github.com/axadrn/moin/hub/internal/ctxkeys"

// Analytics is the Umami page counter, when UMAMI_WEBSITE_ID and
// UMAMI_HOST are set. It sets no cookies (see the privacy policy).
templ Analytics() {
	{{ cfg := ctxkeys.RenderConfig(ctx) }}
	if cfg.UmamiWebsiteID != "" && cfg.UmamiHost != "" {
		<script nonce={ templ.GetNonce(ctx) } defer src={ "https://" + cfg.UmamiHost + "/script.js" } data-website-id={ cfg.UmamiWebsiteID }></script>
	}
}
