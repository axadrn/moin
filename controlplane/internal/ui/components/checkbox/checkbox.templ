package checkbox

import (
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
	"github.com/axadrn/moin/controlplane/internal/ui/utils"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Name       string
	Value      string
	Checked    bool
	Disabled   bool
	Required   bool
	Form       string
}

// Checkbox is a real checkbox with shadcn's look. The browser holds its
// state, so what you see is what the form sends: no JavaScript. The check
// mark is a span after the checkbox that shows through peer-checked.
// Attributes go on the checkbox, Class on the box around it.
templ Checkbox(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span data-slot="checkbox" class={ utils.CN("relative inline-flex size-4 shrink-0", p.Class) }>
		<input
			type="checkbox"
			autocomplete="off"
			if p.ID != "" {
				id={ p.ID }
			}
			if p.Name != "" {
				name={ p.Name }
			}
			if p.Value != "" {
				value={ p.Value }
			}
			if p.Form != "" {
				form={ p.Form }
			}
			checked?={ p.Checked }
			disabled?={ p.Disabled }
			required?={ p.Required }
			class="peer m-0 size-4 cursor-pointer appearance-none rounded-[5px] border border-transparent bg-input/90 transition-shadow outline-none checked:border-primary checked:bg-primary focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/30 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 aria-invalid:checked:border-primary dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 group-has-disabled/field:opacity-50 group-has-[:focus-visible]/field-label:ring-0 group-has-[:focus-visible]/field-label:not-checked:border-transparent group-has-[:focus-visible]/field-label:checked:border-primary"
			{ p.Attributes... }
		/>
		<span data-slot="checkbox-indicator" aria-hidden="true" class="pointer-events-none absolute inset-0 hidden place-content-center text-primary-foreground peer-checked:grid [&>svg]:size-3.5">
			@icon.Check()
		</span>
	</span>
}
