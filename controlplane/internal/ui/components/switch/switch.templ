package switchcomp

import "github.com/axadrn/moin/controlplane/internal/ui/utils"

type Size string

const (
	SizeDefault Size = "default"
	SizeSm      Size = "sm"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Name       string
	Value      string
	Checked    bool
	Disabled   bool
	Required   bool
	Form       string
	Size       Size
}

// Switch is a real checkbox drawn as a switch. The browser holds its state,
// so what you see is what the form sends, and nothing has to keep a copy in
// sync: no JavaScript. The thumb is a span after the checkbox that follows
// it through peer-checked. Attributes go on the checkbox, Class on the box
// around it.
templ Switch(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Size == "" {
		{{ p.Size = SizeDefault }}
	}
	<span data-slot="switch" data-size={ string(p.Size) } class={ utils.CN("group/switch relative inline-flex shrink-0", p.Class) }>
		<input
			type="checkbox"
			role="switch"
			autocomplete="off"
			if p.ID != "" {
				id={ p.ID }
			}
			if p.Name != "" {
				name={ p.Name }
			}
			if p.Value != "" {
				value={ p.Value }
			}
			if p.Form != "" {
				form={ p.Form }
			}
			checked?={ p.Checked }
			disabled?={ p.Disabled }
			required?={ p.Required }
			class="peer m-0 cursor-pointer appearance-none rounded-full border-2 border-transparent bg-input/90 transition-all outline-none checked:border-primary checked:bg-primary focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/30 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 group-has-[:focus-visible]/field-label:ring-0 group-has-[:focus-visible]/field-label:not-checked:border-transparent group-has-[:focus-visible]/field-label:checked:border-primary group-data-[size=default]/switch:h-5 group-data-[size=default]/switch:w-11 group-data-[size=sm]/switch:h-4 group-data-[size=sm]/switch:w-7"
			{ p.Attributes... }
		/>
		<span
			data-slot="switch-thumb"
			aria-hidden="true"
			class="pointer-events-none absolute top-0.5 left-0.5 block rounded-full bg-background shadow-sm transition-transform not-dark:bg-clip-padding peer-checked:translate-x-[calc(100%-8px)] peer-disabled:opacity-50 dark:bg-foreground dark:peer-checked:bg-primary-foreground group-data-[size=default]/switch:h-4 group-data-[size=default]/switch:w-6 group-data-[size=sm]/switch:h-3 group-data-[size=sm]/switch:w-4"
		></span>
	</span>
}
