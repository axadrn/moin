package status

import "github.com/axadrn/moin/controlplane/internal/ui/utils"

// Kind is one of the states every status in moin shows as (DESIGN.md): live ●
// (online, the live deploy), running ◐ (deploying), waiting ○ in the running
// color (an agent that never connected), done ✓ muted (a deploy that
// succeeded but is no longer live), failed ✗ (failed, offline) and idle ○
// (new, unknown).
type Kind string

const (
	KindLive    Kind = "live"
	KindRunning Kind = "running"
	KindFailed  Kind = "failed"
	KindIdle    Kind = "idle"
	KindWaiting Kind = "waiting"
	KindDone    Kind = "done"
)

type Props struct {
	Kind       Kind
	Class      string
	Attributes templ.Attributes
	// Plain keeps the word in the text color instead of the status color.
	Plain bool
	// Chip shows the symbol and the word in a soft tinted pill.
	Chip bool
}

// Status is the symbol and its word: @status.Status(status.Props{Kind: status.KindLive}) { live v4 }.
templ Status(p Props) {
	<span
		data-slot="status"
		data-kind={ string(kind(p.Kind)) }
		class={ utils.CN("inline-flex items-center gap-2 whitespace-nowrap text-[0.8125rem] leading-none font-medium", wordColor(p), chipClasses(p), p.Class) }
		{ p.Attributes... }
	>
		@Symbol(p.Kind)
		<span>
			{ children... }
		</span>
	</span>
}

// Symbol is the status dot alone, 8 px, in the status color: live breathes,
// running blinks, waiting and idle are rings, done is a muted check.
templ Symbol(k Kind, class ...string) {
	{{ cls := "" }}
	if len(class) > 0 {
		{{ cls = class[0] }}
	}
	switch kind(k) {
		case KindLive:
			<span data-slot="status-symbol" aria-hidden="true" class={ utils.CN("moin-dot-live inline-block size-2 shrink-0 rounded-full bg-live", cls) }></span>
		case KindRunning:
			<span data-slot="status-symbol" aria-hidden="true" class={ utils.CN("moin-dot-run inline-block size-2 shrink-0 rounded-full bg-running", cls) }></span>
		case KindWaiting:
			<span data-slot="status-symbol" aria-hidden="true" class={ utils.CN("inline-block size-2 shrink-0 rounded-full border-[1.5px] border-running", cls) }></span>
		case KindDone:
			<svg data-slot="status-symbol" aria-hidden="true" viewBox="0 0 10 10" class={ utils.CN("size-2.5 shrink-0 text-muted-foreground", cls) }><path d="M1.75 5.25 4 7.5l4.25-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		case KindFailed:
			<span data-slot="status-symbol" aria-hidden="true" class={ utils.CN("inline-block size-2 shrink-0 rounded-full bg-failed", cls) }></span>
		default:
			<span data-slot="status-symbol" aria-hidden="true" class={ utils.CN("inline-block size-2 shrink-0 rounded-full border-[1.5px] border-muted-foreground", cls) }></span>
	}
}

func kind(k Kind) Kind {
	switch k {
	case KindLive, KindRunning, KindFailed, KindWaiting, KindDone:
		return k
	}
	return KindIdle
}

func wordColor(p Props) string {
	if p.Plain {
		return "text-foreground"
	}
	if p.Chip {
		switch kind(p.Kind) {
		case KindLive:
			return "text-[color-mix(in_oklab,var(--live),var(--foreground)_18%)]"
		case KindRunning, KindWaiting:
			return "text-[color-mix(in_oklab,var(--running),var(--foreground)_28%)]"
		case KindFailed:
			return "text-[color-mix(in_oklab,var(--failed),var(--foreground)_12%)]"
		}
		return "text-muted-foreground"
	}
	switch kind(p.Kind) {
	case KindFailed:
		return "text-failed"
	case KindIdle, KindDone:
		return "text-muted-foreground"
	}
	return "text-foreground"
}

func chipClasses(p Props) string {
	if !p.Chip {
		return ""
	}
	base := "h-7 rounded-full pr-3 pl-2.5 text-[0.8125rem] font-semibold"
	switch kind(p.Kind) {
	case KindLive:
		return base + " bg-live/16"
	case KindRunning, KindWaiting:
		return base + " bg-running/16"
	case KindFailed:
		return base + " bg-failed/15"
	}
	return base + " bg-muted"
}
