package pages

import (
	"context"

	"github.com/axadrn/ops/controlplane/internal/ui/components/accordion"
	"github.com/axadrn/ops/controlplane/internal/ui/components/badge"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/card"
	"github.com/axadrn/ops/controlplane/internal/ui/components/tabs"
	"github.com/axadrn/ops/controlplane/internal/ui/utils"

	"github.com/axadrn/ops/controlplane/internal/brand"
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/blocks"
	"github.com/axadrn/ops/controlplane/internal/ui/icons"
	"github.com/axadrn/ops/controlplane/internal/ui/layouts"
)

const (
	homeWrap    = "mx-auto w-full max-w-[1240px] px-4 sm:px-8"
	homeDisplay = "font-display leading-[0.95]"
	homeSurface = "rounded-4xl bg-card"
)

templ Home(network model.Network) {
	@layouts.Home(layouts.SEOProps{
		Title:       "Deploy to servers you own",
		Description: brand.Name + " deploys your apps to servers you own, backs up every change of their SQLite database to your bucket and lets you edit the data live. From the web, the CLI, a terminal UI and MCP.",
		Path:        ctxkeys.URLPath(ctx),
	}) {
		<main>
			@HomeHero()
			if ctxkeys.RenderConfig(ctx).Billing {
				@HomeLive(network)
			}
			@HomeCommands()
			@HomeBackups()
			@HomeData()
			@HomeNoDocker()
			@HomeWaysIn()
			@HomeCompare()
			@HomeGoilerplate()
			if ctxkeys.RenderConfig(ctx).Billing {
				@HomePricing()
			}
			@HomeStatement()
			@HomeMaker()
			@HomeFAQ()
			@HomeStart()
		</main>
	}
}

// homeCTA is the size of the big buttons of the home page.
const homeCTA = "gap-2"

// homePrimary is the one main button of the page: the free trial, the
// waitlist while signups are closed, or sign in on a self-hosted ops.
templ homePrimary() {
	@button.Button(button.Props{Href: "/auth", Variant: button.VariantDefault, Size: button.SizeLg, Class: homeCTA}) {
		{ homeStartLabel(ctx) }
		@icon.ArrowRight(icon.Props{Class: "size-4"})
	}
}

func homeStartLabel(ctx context.Context) string {
	cfg := ctxkeys.RenderConfig(ctx)
	switch {
	case !cfg.Billing:
		return "Get started"
	case cfg.SignupsOpen:
		return "Start free trial"
	default:
		return "Join the waitlist"
	}
}

// homeGoilerplateGuide is the goilerplate guide for deploying with ops.
const homeGoilerplateGuide = blocks.GoilerplateURL + "/docs/guides/deploy-with-ops?ref=ops-landing"

// ---------------------------------------------------------------- hero
templ HomeHero() {
	<section class="pt-16 sm:pt-28">
		<div class={ homeWrap, "grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-16" }>
			<div>
				<h1 class={ homeDisplay, "text-[clamp(2.9rem,8.4vw,6.6rem)]" }>
					<span class="block">Deploy.</span>
					<span class="block">Back up.</span>
					<span class="block">Edit live.</span>
				</h1>
				<p class="mt-7 max-w-[32rem] text-lg leading-8 font-semibold sm:mt-9 sm:text-xl sm:leading-9" data-positioning>
					<span class="block">Made for Go and SQLite.</span>
					<span class="block">Runs any app with a Dockerfile.</span>
				</p>
				<p class="mt-3 max-w-[32rem] text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9">
					{ brand.Name } puts your apps on your own server, backs up every change of your database to your bucket and lets you fix the data live. From the browser, the CLI, a terminal UI or your AI agent.
				</p>
				<div class="mt-9 flex flex-col gap-3 sm:flex-row">
					@homePrimary()
					@button.Button(button.Props{Href: "/docs", Variant: button.VariantSecondary, Size: button.SizeLg, Class: homeCTA}) {
						Read the docs
					}
				</div>
			</div>
			@homeTerminal()
		</div>
		<div class={ homeWrap, "mt-16 sm:mt-24" }>
			@homeStage()
		</div>
	</section>
}

// homeTerminal is a real session: a deploy that snapshots the database
// first, a wrong query, and the restore to the second before it.
templ homeTerminal() {
	<div class="ops-term min-w-0 overflow-hidden rounded-4xl bg-terminal text-[13px] leading-[1.75] text-terminal-foreground sm:text-[14px]" aria-label="A terminal session with ops">
		<div class="flex items-center gap-2 border-b border-terminal-foreground/10 px-5 py-3.5">
			<span class="size-3 rounded-full bg-terminal-foreground/20"></span>
			<span class="size-3 rounded-full bg-terminal-foreground/20"></span>
			<span class="size-3 rounded-full bg-terminal-foreground/20"></span>
			<span class="ml-3 text-xs text-terminal-foreground/50">~/shop</span>
		</div>
		<div class="overflow-x-auto px-5 py-5 whitespace-pre sm:px-6">
			<p><span class="text-terminal-foreground/45">$ </span>ops deploy</p>
			<p class="text-terminal-foreground/60">→ building on web-1</p>
			<p class="text-terminal-foreground/60">→ snapshot of /data/app.db: before-v14</p>
			<p class="text-terminal-foreground/60">→ health check /healthz</p>
			<p class="text-live">✓ v14 of shop is live in 38s</p>
			<p class="mt-4"><span class="text-terminal-foreground/45">$ </span>ops sql --write "DELETE FROM orders"</p>
			<p class="text-running">✓ 282 rows changed</p>
			<p class="mt-4 text-terminal-foreground/45"># oops</p>
			<p><span class="text-terminal-foreground/45">$ </span>ops restore --at "14:01:59"</p>
			<p class="text-terminal-foreground/60">→ snapshot of now first: before-restore</p>
			<p class="text-live">✓ Restored. shop runs again.</p>
			<p class="mt-4"><span class="text-terminal-foreground/45">$ </span><span class="ops-dot-run inline-block h-[1.1em] w-[0.55em] translate-y-[0.2em] bg-terminal-foreground/80"></span></p>
		</div>
	</div>
}

// homeStage is the control panel, big, with a switch between its three
// pages and live states around it.
templ homeStage() {
	@tabs.Tabs(tabs.Props{DefaultValue: "deploys", Class: "relative gap-0", Attributes: templ.Attributes{"data-stage": true}}) {
		<div class="mb-4 flex justify-center">
			@tabs.List(tabs.ListProps{Class: "gap-1 bg-card p-1 text-muted-foreground group-data-horizontal/tabs:h-auto", Attributes: templ.Attributes{"aria-label": "Product"}}) {
				@homeStageTab("deploys", "Deploys")
				@homeStageTab("data", "Data")
				@homeStageTab("backups", "Backups")
			}
		</div>
		@card.Card(card.Props{Class: "block gap-0 py-0 text-base overflow-visible rounded-[22px] bg-card p-1.5 sm:rounded-[32px] sm:p-3"}) {
			<div class="overflow-hidden rounded-[17px] sm:rounded-[22px]">
				@homeShot("deploys", "The app page of a shop: the live release, every deploy, and the deploy log with the snapshot before the deploy", true)
				@homeShot("data", "The data page: the tables of the shop database, and its customers table with rows to edit in place", false)
				@homeShot("backups", "The backups page: continuous backup, restore to any second in the window, and the snapshots", false)
			</div>
		}
		<div class="mt-5 flex flex-wrap items-center justify-center gap-2.5" aria-label="What ops reports">
			@homeChip("blog", "live", "live v6")
			@homeChip("shop.db", "live", "verified by restore")
			@homeChip("api", "failed", "v3 failed · v2 runs again")
		</div>
	}
}

templ homeStageTab(name, label string) {
	@tabs.Trigger(tabs.TriggerProps{
		Value:      name,
		Class:      "h-auto flex-none cursor-pointer px-5 py-2 font-semibold text-muted-foreground hover:text-foreground data-active:bg-foreground data-active:text-background group-data-[variant=default]/tabs-list:data-active:shadow-none dark:text-muted-foreground dark:data-active:bg-foreground dark:data-active:text-background",
		Attributes: templ.Attributes{"data-stage-tab": name},
	}) {
		{ label }
	}
}

// homeShot is the tab panel of one page of the panel, light and dark: the
// theme switch picks the one that shows.
templ homeShot(name, alt string, first bool) {
	@tabs.Content(tabs.ContentProps{Value: name, Attributes: templ.Attributes{"data-stage-shot": name}}) {
		<img
			src={ "/assets/img/product-" + name + "-light.png" }
			alt={ alt }
			width="2880"
			height="1800"
			if !first {
				loading="lazy"
			}
			decoding="async"
			class="block aspect-[4/3] w-full object-cover object-left-top sm:aspect-[1440/900] dark:hidden"
		/>
		<img
			src={ "/assets/img/product-" + name + "-dark.png" }
			alt={ alt }
			width="2880"
			height="1800"
			loading="lazy"
			decoding="async"
			class="hidden aspect-[4/3] w-full object-cover object-left-top sm:aspect-[1440/900] dark:block"
		/>
	}
}

// homeChip is a status pill on a solid backing: the app name and its state.
templ homeChip(app, kind, text string) {
	@badge.Badge(badge.Props{Class: "h-auto leading-normal text-card-foreground text-base font-normal inline-flex items-center gap-3 rounded-full bg-card py-1.5 pr-1.5 pl-5 shadow-[0_10px_30px_-14px_rgb(0_0_0/0.45)]"}) {
		<span class="font-mono text-[13px] font-medium">{ app }</span>
		switch kind {
			case "live":
				@badge.Badge(badge.Props{Class: "h-auto leading-normal inline-flex items-center gap-2 rounded-full bg-live/12 px-3.5 py-1.5 text-[13px] font-medium text-live"}) {
					<span class="lp-pulse size-2 rounded-full bg-live"></span>
					{ text }
				}
			case "running":
				@badge.Badge(badge.Props{Class: "h-auto leading-normal inline-flex items-center gap-2 rounded-full bg-running/14 px-3.5 py-1.5 text-[13px] font-medium text-running"}) {
					<span class="ops-turn inline-block leading-none">◐</span>
					{ text }
				}
			default:
				@badge.Badge(badge.Props{Class: "h-auto leading-normal inline-flex items-center gap-2 rounded-full bg-failed/12 px-3.5 py-1.5 text-[13px] font-medium text-failed"}) {
					<span class="leading-none">✗</span>
					{ text }
				}
		}
	}
}

// ---------------------------------------------------------------- live
// HomeLive is what ops runs right now: the hosted control plane counts
// itself, self-hosted ones report every five minutes. Zero is fine: we say
// what is true.
templ HomeLive(network model.Network) {
	<section id="live" class="scroll-mt-24 pt-24 sm:pt-32" data-live>
		<div class={ homeWrap }>
			<p class="flex items-center gap-2.5 text-sm font-semibold text-muted-foreground">
				<span class="lp-pulse size-2 rounded-full bg-live"></span>
				Running on ops right now
			</p>
			<dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
				@homeLiveNumber(network.SelfHosted, "self-hosted control planes", "self-hosted")
				@homeLiveNumber(network.HostedWorkspaces, "teams on hosted ops", "hosted")
				@homeLiveNumber(network.Servers, "servers", "servers")
				@homeLiveNumber(network.Apps, "apps live", "apps")
				@homeLiveNumber(network.Deploys, "deploys so far", "deploys")
			</dl>
		</div>
	</section>
}

templ homeLiveNumber(count int, label, name string) {
	@card.Card(card.Props{Class: utils.CN("block gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "px-6 py-5")), Attributes: templ.Attributes{"data-live-number": name}}) {
		<dt class="sr-only">{ label }</dt>
		<dd>
			<span class={ homeDisplay, "block text-[clamp(2rem,4vw,2.8rem)] tabular-nums" }>{ liveCount(count) }</span>
			<span class="mt-2 block text-sm text-muted-foreground">{ label }</span>
		</dd>
	}
}

// ---------------------------------------------------------------- commands
templ HomeCommands() {
	<section id="how" class="scroll-mt-24 pt-32 sm:pt-44">
		<div class={ homeWrap }>
			<h2 class={ homeDisplay, "text-[clamp(2.4rem,6.4vw,5rem)]" }>Three commands.</h2>
			<p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9">
				<span class="text-foreground">Getting an app online is the easy part. Keeping its data safe is the hard part.</span>
				{ brand.Name } does both, on a server you rent for $5 a month.
			</p>
			<div class="mt-12 grid gap-3 sm:mt-16">
				@homeCommand("ops servers add web-1", "Prints one install line. Run it on any Linux server. Its agent dials out, so no port stays open.")
				@homeCommand("ops deploy", "Sends your repo. Your server builds it, checks that it is healthy and puts it live.")
				@homeCommand("ops restore --at 14:01", "Deleted the wrong rows at 14:02? Your database goes back to the second before. ops saves the current state first.")
			</div>
		</div>
	</section>
}

templ homeCommand(command, text string) {
	@card.Card(card.Props{Class: utils.CN("gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "grid gap-4 p-7 sm:p-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:items-center lg:gap-12 lg:px-12"))}) {
		<p class="font-mono text-[clamp(1.35rem,5.4vw,2.6rem)] leading-tight font-medium tracking-[-0.04em] break-words">
			<span class="text-muted-foreground/60">$ </span>{ command }
		</p>
		<p class="max-w-md text-[17px] leading-7 text-muted-foreground sm:text-lg sm:leading-8">{ text }</p>
	}
}

// ---------------------------------------------------------------- ways in
// HomeWaysIn is one rollback of shop, done four ways: each frame is what
// that surface really shows.
templ HomeWaysIn() {
	<section id="ways" class="scroll-mt-24 pt-32 sm:pt-44">
		<div class={ homeWrap }>
			<h2 class={ homeDisplay, "max-w-[16ch] text-[clamp(2.4rem,6.4vw,5rem)] text-balance" }>One tool. Four ways in.</h2>
			<p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9">
				<span class="text-foreground">Click it, type it, press a key or ask your agent.</span>
				Every feature works in all four, with the same account and the same activity log. Here is one rollback of shop, four times.
			</p>
			<div class="mt-12 grid gap-3 sm:mt-16 lg:grid-cols-2">
				@homeWay("Browser", "For a look around, and for your team.") {
					@homeWayWeb()
				}
				@homeWay("CLI", "For your repo, scripts and CI.") {
					<div class="ops-term overflow-x-auto rounded-3xl bg-terminal px-6 py-5 text-[13px] leading-6 whitespace-pre text-terminal-foreground sm:text-[14px]">
						<p><span class="text-terminal-foreground/50">$ </span>ops rollback v12</p>
						<p class="text-terminal-foreground/60">→ Rollback v14 of shop to v12 started</p>
						<p class="text-live">✓ v14 of shop is live <span class="text-terminal-foreground/50">in 3s</span></p>
					</div>
				}
				@homeWay("Terminal UI", "Everything live, one key away. Run ops.") {
					@homeWayTUI()
				}
				@homeWay("AI agent", "Claude, Cursor or any MCP client.") {
					<div class="flex flex-col gap-3 rounded-3xl bg-background p-5 text-[15px] leading-6">
						<p class="max-w-[85%] self-end rounded-2xl rounded-br-md bg-foreground px-4 py-2.5 text-background">shop is broken since the last deploy. Roll it back.</p>
						<p class="self-start font-mono text-[12px] text-muted-foreground">rollback_app · shop</p>
						<p class="max-w-[85%] self-start rounded-2xl rounded-bl-md bg-card px-4 py-2.5">Rolled back. v14 of shop runs the release of v12, your data stays as it is.</p>
					</div>
				}
			</div>
			<div class="mt-5 flex flex-wrap items-center justify-center gap-2.5">
				@badge.Badge(badge.Props{Class: "h-auto leading-normal text-card-foreground text-base font-normal inline-flex items-center gap-3 rounded-full bg-card py-1.5 pr-1.5 pl-5"}) {
					<span class="text-[14px] font-semibold">Desktop app</span>
					@badge.Badge(badge.Props{Class: "h-auto leading-normal inline-flex items-center gap-2 rounded-full bg-running/14 px-3.5 py-1.5 text-[13px] font-medium text-running"}) {
						<span class="ops-turn inline-block leading-none">◐</span>
						coming soon
					}
				}
			</div>
		</div>
	</section>
}

templ homeWay(name, text string) {
	@card.Card(card.Props{Class: utils.CN("gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "flex min-w-0 flex-col gap-6 p-5 sm:p-8"))}) {
		<div class="px-2 pt-2 sm:px-0 sm:pt-0">
			<p class="font-display text-[clamp(1.6rem,3vw,2.2rem)]">{ name }</p>
			<p class="mt-2 text-[17px] leading-7 text-muted-foreground">{ text }</p>
		</div>
		<div class="mt-auto min-w-0">
			{ children... }
		</div>
	}
}

// homeWayWeb is the deploy list of the app page, the pointer on v12.
templ homeWayWeb() {
	<div class="rounded-3xl bg-background p-2 text-[14px]" aria-label="The deploy list of shop with a Roll back button on v12">
		@homeWayDeploy("v13", "live", "4m · 5s", false)
		@homeWayDeploy("v12", "succeeded", "5m · 5s", true)
		@homeWayDeploy("v11", "succeeded", "5m · 5s", false)
	</div>
}

templ homeWayDeploy(number, status, when string, hover bool) {
	<div class={ "flex items-center gap-4 rounded-xl px-4 py-3", templ.KV("bg-muted", hover) }>
		if status == "live" {
			<span class="size-2.5 rounded-full bg-live"></span>
		} else {
			<span class="size-2.5 rounded-full border-2 border-muted-foreground/60"></span>
		}
		<span class="w-10 font-mono font-semibold">{ number }</span>
		<span class={ "font-semibold", templ.KV("text-live", status == "live") }>{ status }</span>
		if hover {
			@badge.Badge(badge.Props{Class: "h-auto leading-normal ml-auto rounded-full bg-card px-3 py-1 text-[13px] font-semibold text-card-foreground shadow-[0_6px_18px_-10px_rgb(0_0_0/0.5)]"}) {
				Roll back
			}
		} else {
			<span class="ml-auto text-[13px] text-muted-foreground tabular-nums">{ when }</span>
		}
	</div>
}

// homeWayTUI is the app screen of the terminal UI asking before the
// rollback, as ops draws it.
templ homeWayTUI() {
	<div class="ops-term overflow-x-auto rounded-3xl bg-terminal py-4 text-[12px] leading-[1.65] whitespace-pre text-terminal-foreground sm:text-[13px]" aria-label="The terminal UI asks before it rolls shop back">
		<p class="px-5"><span class="font-semibold">ops</span>{ "   " }<span class="text-terminal-foreground/50">servers 1</span>{ "   apps › shop   " }<span class="text-terminal-foreground/50">activity</span></p>
		<p class="mt-3 px-5">{ "  " }<span class="font-semibold">shop</span>{ "   " }<span class="text-live">● live v13</span></p>
		<p class="mt-2 px-5 text-terminal-foreground/50">{ "  DEPLOY   STATUS        TOOK" }</p>
		<p class="px-5">{ "  v13      " }<span class="text-live">● live</span>{ "         5s" }</p>
		<p class="px-5">{ "  v12      " }<span class="text-live">✓</span>{ " succeeded   5s" }</p>
		<p class="px-5">{ "  v11      " }<span class="text-live">✓</span>{ " succeeded   5s" }</p>
		<p class="mt-3 border-t border-terminal-foreground/10 px-5 pt-3"><span class="text-running">▌</span>{ " Roll shop back to the deploy before v13?" }</p>
		<p class="px-5"><span class="text-running">▌</span>{ " " }<span class="text-terminal-foreground/60">It starts the old images with the env they had.</span></p>
		<p class="px-5">{ "  " }<span class="font-semibold">y</span>{ " " }<span class="text-terminal-foreground/60">{ "roll back   any other key cancels" }</span></p>
	</div>
}

// ---------------------------------------------------------------- backups
templ HomeBackups() {
	<section id="backups" class="scroll-mt-24 pt-32 sm:pt-44">
		<div class={ homeWrap }>
			<h2 class={ homeDisplay, "max-w-[14ch] text-[clamp(2.4rem,6.4vw,5rem)] text-balance" }>Every change, backed up.</h2>
			<p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9">
				Most apps lose data the boring way: a migration that goes wrong, an <code class="font-mono text-foreground">UPDATE</code> without <code class="font-mono text-foreground">WHERE</code>, a disk that dies. { brand.Name } makes all three a click to undo.
			</p>
			<div class="mt-12 grid gap-3 sm:mt-16 lg:grid-cols-2">
				@homeFact("Every second", "Each change of every SQLite database streams to your own bucket with Litestream. Restore to any second of the last week.", "")
				@homeFact("Before every change", "A full snapshot before every deploy, every restore and every edit made through "+brand.Name+". On by default.", "")
				@homeFact("Proven every day", "The agent restores the newest state into a temp file and runs the integrity check. You see “verified by restore”, not “backup job ran”.", "live")
				@homeFact("Your bucket", "R2, S3, B2, Hetzner or MinIO. Backups go from your server to your bucket and never through us. A snapshot is a plain gzipped SQLite file.", "")
			</div>
		</div>
	</section>
}

templ homeFact(title, text, kind string) {
	@card.Card(card.Props{Class: utils.CN("block gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "p-7 sm:p-10"))}) {
		<p class="flex items-center gap-3 font-display text-[clamp(1.6rem,3vw,2.2rem)]">
			if kind == "live" {
				<span class="lp-pulse size-2.5 rounded-full bg-live"></span>
			}
			{ title }
		</p>
		<p class="mt-4 max-w-lg text-[17px] leading-7 text-muted-foreground sm:text-lg sm:leading-8">{ text }</p>
	}
}

// ---------------------------------------------------------------- data
templ HomeData() {
	<section id="data" class="scroll-mt-24 pt-3">
		<div class={ homeWrap }>
			@card.Card(card.Props{Class: utils.CN("gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "grid gap-10 p-7 sm:p-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16 lg:p-16"))}) {
				<div>
					<h2 class={ homeDisplay, "text-[clamp(2.1rem,4.2vw,3.4rem)] text-balance" }>Your data, live.</h2>
					<p class="mt-6 max-w-lg text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9">
						<span class="text-foreground">Browse every table, edit a cell, run SQL.</span>
						Read live from your server, from the browser, the terminal or your AI agent. Reads can never change a row; changes take a snapshot first.
					</p>
					<p class="mt-4 max-w-lg text-[17px] leading-7 text-muted-foreground">
						The schema stays in your code: your migrations run on deploy, and { brand.Name } shows which one ran last.
					</p>
				</div>
				<div class="ops-term self-center overflow-x-auto rounded-3xl bg-terminal px-6 py-5 text-[13px] leading-6 whitespace-pre-wrap text-terminal-foreground sm:text-[14px]">
					<p><span class="text-terminal-foreground/50">$ </span>ops sql "SELECT status, count(*) FROM orders GROUP BY status"</p>
					<p class="mt-2 text-terminal-foreground/50">STATUS      COUNT(*)</p>
					<p>delivered   38</p>
					<p>paid        126</p>
					<p>refunded    39</p>
					<p>shipped     74</p>
					<p class="mt-4"><span class="text-terminal-foreground/50">$ </span>ops sql --write "UPDATE orders SET status = 'shipped' WHERE id = 412"</p>
					<p class="text-live">✓ 1 row changed</p>
				</div>
			}
		</div>
	</section>
}

// ---------------------------------------------------------------- no docker
templ HomeNoDocker() {
	<section class="pt-3">
		<div class={ homeWrap }>
			@card.Card(card.Props{Class: utils.CN("gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "grid gap-10 p-7 sm:p-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-16 lg:p-16"))}) {
				<div>
					<h2 class={ homeDisplay, "text-[clamp(2.1rem,4.2vw,3.4rem)] text-balance" }>Never touched Docker? Fine.</h2>
					<p class="mt-6 max-w-lg text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9">
						<span class="text-foreground">Run ops deploy in your Go repo.</span>
						{ brand.Name } writes the Dockerfile and the compose file, keeps your data and finds your SQLite database.
					</p>
					<p class="mt-4 max-w-lg text-[17px] leading-7 text-muted-foreground">
						Already have a Dockerfile or a compose.yml? It uses yours. Other languages bring their own Dockerfile.
					</p>
				</div>
				<div class="self-center divide-y divide-border rounded-3xl bg-background px-1">
					@homeFile("go.mod", "your code", "")
					@homeFile("Dockerfile", "written by ops", "")
					@homeFile("compose.yml", "written by ops", "")
					@homeFile("/data/app.db", "found and kept", "live")
				</div>
			}
		</div>
	</section>
}

templ homeFile(name, note, kind string) {
	<div class="flex items-center justify-between gap-4 px-5 py-4">
		<span class="font-mono text-[14px] font-medium">{ name }</span>
		if kind == "live" {
			@badge.Badge(badge.Props{Class: "h-auto leading-normal inline-flex items-center gap-2 rounded-full bg-live/12 px-3 py-1 text-[13px] font-medium text-live"}) {
				<span class="size-1.5 rounded-full bg-live"></span>
				{ note }
			}
		} else {
			<span class="text-[14px] text-muted-foreground">{ note }</span>
		}
	</div>
}

// ---------------------------------------------------------------- maker
templ HomeMaker() {
	<section id="maker" class="scroll-mt-24 pt-32 sm:pt-44">
		<div class={ homeWrap, "grid gap-10 md:grid-cols-[auto_minmax(0,1fr)] md:gap-16" }>
			<a href="https://x.com/axadrn" target="_blank" rel="me noopener" aria-label="Axel Adrian on X" class="shrink-0">
				<img src="https://github.com/axadrn.png?size=320" alt="Axel Adrian" width="320" height="320" loading="lazy" class="size-32 rounded-4xl object-cover sm:size-40"/>
			</a>
			<div class="max-w-3xl">
				<h2 class={ homeDisplay, "text-[clamp(2.1rem,4.2vw,3.4rem)] text-balance" }>Built by the maker of shadcn-templ and goilerplate.</h2>
				<p class="mt-5 text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9">I'm Axel. I maintain shadcn-templ, the Go port of shadcn/ui, and goilerplate, the Go SaaS starter. ops is how I deploy and back up my own products, on my own servers.</p>
				@blocks.MakerProjects("mt-8")
				<div class="mt-6 flex items-center gap-1">
					@button.Button(button.Props{Href: "https://x.com/axadrn", Target: "_blank", Variant: button.VariantGhost, Size: button.SizeIcon, Attributes: templ.Attributes{"rel": "me noopener", "aria-label": "Axel Adrian on X"}}) {
						@icons.X(icons.Props{Class: "size-4"})
					}
					@button.Button(button.Props{Href: "https://github.com/axadrn", Target: "_blank", Variant: button.VariantGhost, Size: button.SizeIcon, Attributes: templ.Attributes{"rel": "me noopener", "aria-label": "Axel Adrian on GitHub"}}) {
						@icons.Github(icons.Props{Class: "size-[18px]"})
					}
				</div>
			</div>
		</div>
	</section>
}

// ---------------------------------------------------------------- statement

// homeSecretStep is one step of where secrets live: now, next, then.
templ homeSecretStep(when, title, body string) {
	<li class="flex flex-col gap-2 bg-foreground p-6 sm:p-7">
		@badge.Badge(badge.Props{Class: "h-auto self-start leading-normal rounded-full bg-background/15 px-3 py-0.5 text-[13px] font-semibold text-background"}) {
			{ when }
		}
		<p class="mt-2 text-[17px] font-semibold text-background">{ title }</p>
		<p class="text-[15px] leading-6 text-background/65">{ body }</p>
	</li>
}
templ HomeStatement() {
	<section class="pt-3">
		<div class={ homeWrap }>
			@card.Card(card.Props{Class: "block gap-0 py-0 text-base overflow-visible text-background bg-foreground px-7 py-20 text-background sm:px-14 sm:py-32 lg:px-20"}) {
				<p class={ homeDisplay, "text-[clamp(2.4rem,7.2vw,6rem)]" }>
					<span class="block">Your servers.</span>
					<span class="block">Your data.</span>
					<span class="block">Nothing listens for&nbsp;us.</span>
				</p>
				<p class="mt-10 max-w-xl text-lg leading-8 text-background/65 sm:text-xl sm:leading-9">
					We hold no SSH key to your servers: the agent dials out. Traffic comes through a Cloudflare Tunnel, SSH only over Tailscale, a firewall drops the rest. A rules file on your server decides what ops may do there, and all of it is open source.
				</p>
				<ol class="mt-12 grid gap-px overflow-hidden rounded-3xl bg-background/15 sm:grid-cols-3" data-secrets-roadmap>
					@homeSecretStep("Now", "Encrypted with us", "Env vars and registry logins are sealed with AES-256-GCM in the control plane. Your code and data never pass through it.")
					@homeSecretStep("Next", "Only on your servers", "Secrets move to the agent. Hosted ops keeps your login and nothing else.")
					@homeSecretStep("Then", "End-to-end encrypted", "We can't read your secrets or your data. Not won't, can't.")
				</ol>
			}
		</div>
	</section>
}

// ---------------------------------------------------------------- compare
// HomeCompare puts ops next to what people use instead: one line on what
// each one does, one line on what ops does there. Only facts we can stand
// behind.
templ HomeCompare() {
	<section id="compare" class="scroll-mt-24 pt-32 sm:pt-44">
		<div class={ homeWrap }>
			<h2 class={ homeDisplay, "max-w-[16ch] text-[clamp(2.4rem,6.4vw,5rem)] text-balance" }>Why not Coolify?</h2>
			<p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9">
				<span class="text-foreground">Good tools put your app online. { brand.Name } does that too, and then looks after your data.</span>
				Here is the difference, one line each.
			</p>
			<div class="mt-12 grid items-stretch gap-3 sm:mt-16 lg:grid-cols-2">
				@homeVersus("Coolify and Dokploy",
					"Deploy containers to your own server, from a web panel.",
					"Deploys too, and runs your data: every change backed up, a restore drill every day, restore to any second, tables, SQL and your migrations in view.")
				@homeVersus("Kamal",
					"Deploys from your laptop over SSH.",
					"Needs no SSH. The agent dials out and nothing listens. Plus backups and a data UI, in the browser, the CLI, a terminal UI and MCP.")
				@homeVersus("Heroku, Render and Railway",
					"Run your app on their machines and bill you per resource.",
					"Runs on your own $5 server at any provider. One flat price for every app and server, or free to host yourself.")
				@homeVersus("Fly.io with LiteFS",
					"Replicates SQLite between Fly machines.",
					"Backs up SQLite on any server, from any provider, to your own bucket. Restore to any second.")
			</div>
			<div class="mt-10 flex flex-col gap-3 sm:flex-row">
				@homePrimary()
				if ctxkeys.RenderConfig(ctx).Billing {
					@button.Button(button.Props{Href: "#pricing", Variant: button.VariantSecondary, Size: button.SizeLg, Class: homeCTA}) {
						See pricing
					}
				} else {
					@button.Button(button.Props{Href: "/docs/getting-started", Variant: button.VariantSecondary, Size: button.SizeLg, Class: homeCTA}) {
						Getting started
					}
				}
			</div>
		</div>
	</section>
}

// homeVersus is one other tool: what it does, and what ops does there.
templ homeVersus(name, they, ops string) {
	@card.Card(card.Props{Class: utils.CN("gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "flex h-full flex-col p-5 sm:p-8")), Attributes: templ.Attributes{"data-versus": name}}) {
		<p class="px-2 pt-2 font-display text-[clamp(1.6rem,3vw,2.2rem)] sm:px-0 sm:pt-0">{ name }</p>
		<dl class="mt-6 flex flex-1 flex-col gap-2">
			<div class="rounded-3xl bg-background px-5 py-4">
				<dt class="text-sm text-muted-foreground">They</dt>
				<dd class="mt-1 text-[17px] leading-7 text-muted-foreground">{ they }</dd>
			</div>
			<div class="flex-1 rounded-3xl bg-foreground px-5 py-4 text-background">
				<dt class="text-sm font-semibold text-background/65">{ brand.Name }</dt>
				<dd class="mt-1 text-[17px] leading-7">{ ops }</dd>
			</div>
		</dl>
	}
}

// ---------------------------------------------------------------- goilerplate
// HomeGoilerplate speaks to people who built their app with goilerplate,
// the Go SaaS starter by the same maker.
templ HomeGoilerplate() {
	<section id="goilerplate" class="pt-3">
		<div class={ homeWrap }>
			@card.Card(card.Props{Class: utils.CN("gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "grid gap-10 p-7 sm:p-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-16 lg:p-16")), Attributes: templ.Attributes{"data-goilerplate-box": true}}) {
				<div>
					<h2 class={ homeDisplay, "text-[clamp(2.1rem,4.2vw,3.4rem)] text-balance" }>Built with goilerplate?</h2>
					<p class="mt-6 max-w-lg text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9">
						<span class="text-foreground"><code class="font-mono">ops deploy</code> and it's live. Backups included.</span>
						Your app gets HTTPS on your domain, every change of its SQLite database in your bucket and a data browser.
					</p>
					<div class="mt-9 flex flex-col gap-3 sm:flex-row">
						@button.Button(button.Props{Href: homeGoilerplateGuide, Target: "_blank", Variant: button.VariantDefault, Size: button.SizeLg, Class: homeCTA, Attributes: templ.Attributes{"rel": "noopener"}}) {
							Read the guide
							@icon.ArrowRight(icon.Props{Class: "size-4"})
						}
						@button.Button(button.Props{Href: blocks.RefURL(blocks.GoilerplateURL, "goilerplate-box"), Target: "_blank", Variant: button.VariantSecondary, Size: button.SizeLg, Class: homeCTA, Attributes: templ.Attributes{"rel": "noopener"}}) {
							goilerplate.com
						}
					</div>
				</div>
				<div class="ops-term self-center overflow-x-auto rounded-3xl bg-terminal px-6 py-5 text-[13px] leading-6 whitespace-pre text-terminal-foreground sm:text-[14px]" aria-label="Three commands that put a goilerplate app live">
					<p class="text-terminal-foreground/45"># in your goilerplate project</p>
					<p><span class="text-terminal-foreground/45">$ </span>ops servers add web-1</p>
					<p><span class="text-terminal-foreground/45">$ </span>ops deploy</p>
					<p class="text-live">✓ v1 of acme is live</p>
				</div>
			}
		</div>
	</section>
}

// ---------------------------------------------------------------- start
// HomeStart is the last call to action, after the questions.
templ HomeStart() {
	<section id="start" class="scroll-mt-24 py-32 sm:py-44">
		<div class={ homeWrap }>
			<h2 class={ homeDisplay, "max-w-[16ch] text-[clamp(2.4rem,6.4vw,5rem)] text-balance" }>Deploy your app today.</h2>
			<p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9">
				if ctxkeys.RenderConfig(ctx).Billing {
					<span class="text-foreground">30 days free, no card.</span>
				} else {
					<span class="text-foreground">Free and open source.</span>
				}
				One server, one command, and your data is backed up from the first second.
			</p>
			<div class="mt-9 flex flex-col gap-3 sm:flex-row">
				@homePrimary()
				@button.Button(button.Props{Href: "/docs/getting-started", Variant: button.VariantSecondary, Size: button.SizeLg, Class: homeCTA}) {
					Getting started
				}
			</div>
		</div>
	</section>
}

// ---------------------------------------------------------------- pricing
// HomePricing puts the free self-hosted ops next to the hosted one: the same
// product, so the rows say what running it takes. Both cards have the same
// rows in the same order, short enough to stay on one line.
templ HomePricing() {
	<section id="pricing" class="scroll-mt-24 py-32 sm:py-44">
		<div class={ homeWrap }>
			<h2 class={ homeDisplay, "max-w-[16ch] text-[clamp(2.4rem,6.4vw,5rem)] text-balance" }>Free to run. Or we run it.</h2>
			<p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9">
				<span class="text-foreground">Both get every feature, with unlimited servers, apps and members, all open source.</span>
				The difference is the work around it.
			</p>
			<div class="mt-12 grid gap-3 sm:mt-16 lg:grid-cols-2">
				@card.Card(card.Props{Class: utils.CN("gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "flex flex-col p-7 sm:p-10")), Attributes: templ.Attributes{"data-plan": "self-hosted"}}) {
					<p class="font-display text-[clamp(1.6rem,3vw,2.2rem)]">Self-hosted</p>
					<p class="mt-6 flex flex-wrap items-baseline gap-x-3">
						<span class={ homeDisplay, "text-[clamp(3rem,6vw,4.5rem)]" }>$0</span>
						<span class="text-lg text-muted-foreground">free forever</span>
					</p>
					<dl class="mt-8 divide-y divide-border border-y border-border">
						@homePlanRow("Setup", "About an hour", false)
						@homePlanRow("Control plane", "On your own server", false)
						@homePlanRow("Updates", "You pull and rebuild", false)
						@homePlanRow("GitHub App, email", "You set them up", false)
						@homePlanRow("Control plane backups", "Yours to run", false)
						@homePlanRow("Support", "GitHub issues", false)
						@homePlanRow("goilerplate", "Not included", false)
					</dl>
					<div class="mt-auto pt-10">
						@button.Button(button.Props{Href: "/docs/self-hosting", Variant: button.VariantSecondary, Size: button.SizeLg, Class: homeCTA}) {
							Host it yourself
							@icon.ArrowRight(icon.Props{Class: "size-4"})
						}
					</div>
				}
				@card.Card(card.Props{Class: "gap-0 py-0 text-base overflow-visible text-background flex flex-col bg-foreground p-7 text-background sm:p-10", Attributes: templ.Attributes{"data-plan": "hosted"}}) {
					<p class="flex flex-wrap items-center gap-3 font-display text-[clamp(1.6rem,3vw,2.2rem)]">
						Hosted
						if !ctxkeys.RenderConfig(ctx).SignupsOpen {
							@badge.Badge(badge.Props{Class: "h-auto leading-normal rounded-full bg-background/15 px-3 py-1 font-sans text-[13px] font-semibold text-background", Attributes: templ.Attributes{"data-private-beta": true}}) {
								Private beta
							}
						}
					</p>
					<div class="mt-6 flex flex-wrap items-center gap-2" data-yearly-deal>
						@badge.Badge(badge.Props{Class: "h-auto leading-normal rounded-full bg-background px-3 py-1 font-sans text-[13px] font-semibold text-foreground"}) {
							Best value · Save $99
						}
						@badge.Badge(badge.Props{Class: "h-auto leading-normal rounded-full bg-background/15 px-3 py-1 font-sans text-[13px] font-semibold text-background"}) {
							3+ months free
						}
					</div>
					<p class="mt-4 flex flex-wrap items-baseline gap-x-3">
						<span class={ homeDisplay, "text-[clamp(3rem,6vw,4.5rem)]" }>$249</span>
						<span class="text-lg text-background/65">a year, per workspace</span>
					</p>
					<p class="mt-2 text-base text-background/65">or $29 a month</p>
					<p class="mt-2 text-sm text-background/55">Plus sales tax or VAT where it applies, shown at checkout.</p>
					<div class="mt-6 rounded-lg border border-background/15 bg-background/8 px-4 py-3 text-[15px] leading-6" data-goilerplate-offer>
						<p class="font-semibold">goilerplate buyers: 50% off forever.</p>
						<p class="text-background/65">Your code arrives by email in the next days.</p>
					</div>
					<dl class="mt-8 divide-y divide-background/15 border-y border-background/15">
						@homePlanRow("Free trial", "30 days, no card", true)
						@homePlanRow("Setup", "Two minutes", true)
						@homePlanRow("Control plane", "Ours, nothing to run", true)
						@homePlanRow("Updates", "The day they ship", true)
						@homePlanRow("GitHub App, email", "Ready to use", true)
						@homePlanRow("Control plane backups", "Every day, by us", true)
						@homePlanRow("Support", "Email, from the team", true)
					</dl>
					<div class="mt-auto pt-10">
						@button.Button(button.Props{Href: "/auth", Size: button.SizeLg, Class: homeCTA + " bg-background text-foreground hover:bg-background/85"}) {
							{ homeStartLabel(ctx) }
							@icon.ArrowRight(icon.Props{Class: "size-4"})
						}
					</div>
				}
			</div>
			<p class="mt-5 text-center text-sm text-muted-foreground">Your apps run on your servers either way, and your data never leaves them.</p>
		</div>
	</section>
}

templ homePlanRow(label, value string, dark bool) {
	<div class="flex items-baseline justify-between gap-4 py-3.5">
		<dt class={ "shrink-0 text-[15px]", templ.KV("text-muted-foreground", !dark), templ.KV("text-background/60", dark) }>{ label }</dt>
		<dd class="truncate text-right text-[15px] font-semibold">{ value }</dd>
	</div>
}

// ---------------------------------------------------------------- faq
templ HomeFAQ() {
	<section id="faq" class="scroll-mt-24 pt-32 sm:pt-44">
		<div class={ homeWrap }>
			<h2 class={ homeDisplay, "text-[clamp(2.1rem,4.2vw,3.4rem)]" }>Questions.</h2>
			@accordion.Accordion(accordion.Props{Multiple: true, Class: utils.CN(homeSurface, "mt-10 px-2 sm:px-4")}) {
				@homeQuestion("What can I deploy?") {
					Any repo with a compose.yml, a Dockerfile or a go.mod. ops builds it on your server, checks that it comes up healthy and starts the previous version again when it does not.
				}
				@homeQuestion("Which databases?") {
					SQLite. That is the focus: ops finds your database, backs it up continuously, lets you browse and edit it and runs your migrations. Postgres or Redis still run as services from your compose.yml, without those tools.
				}
				@homeQuestion("Which servers?") {
					Any Linux server you can log in to as root, at any provider. The install script sets up Docker and the agent. The agent only needs outbound HTTPS.
				}
				@homeQuestion("Where does my code go?") {
					Into your own bucket, never to us. ops deploy puts it there through a link ops signs, your server picks it up and deletes it. Deploys from GitHub go from GitHub straight to your server. Your backups live in the same bucket.
				}
				@homeQuestion("Can you see my data?") {
					Only what you ask for: a table you open passes through to your browser and is never stored, and the activity never keeps your SQL or your values. Want even that gone? Write data: off and logs: off into /etc/ops/rules on your server. The agent then refuses every read, and nobody can change that through ops, not even us.
				}
				@homeQuestion("What happens if ops is down?") {
					Your apps keep running. They live on your servers, not on ours. You only cannot deploy or change them through ops until it is back.
				}
				@homeQuestion("Is it open source?") {
					Yes, all of it: the agent, the CLI, the terminal UI and the control plane, under AGPL-3.0. Read exactly what runs on your server and what we run. Self-host it for free, or let us run it for you.
				}
				@homeQuestion("Why AGPL, and can I contribute?") {
					AGPL keeps ops open: whoever runs a changed ops as a service has to share the changes. Pull requests are welcome. On your first one a bot asks you to agree once that it comes in under Apache 2.0, which keeps the license of ops flexible. You keep your copyright.
				}
				@homeQuestion("Can my AI agent use it?") {
					Yes. ops has an MCP server: Claude, Cursor or any MCP client can deploy, roll back, read logs and set env vars with a personal API token.
				}
				@homeQuestion("Where are my env vars?") {
					Today in the control plane, sealed with AES-256-GCM, and handed to your server with each deploy. Next they move to your servers only, so hosted ops keeps your login and nothing else. After that, end-to-end encryption: we can't read them at all.
				}
				@homeQuestion("Will the name change?") {
					Maybe. If it does, your servers, the CLI and the agents move over by themselves, and the old address keeps working for a while. Nothing breaks.
				}
				@homeQuestion("Can my team use it?") {
					Yes, for free. Invite them and everyone deploys to the same servers. The activity shows who deployed, restored or changed what, from the web, the CLI, an agent or GitHub.
				}
				if ctxkeys.RenderConfig(ctx).Billing {
					@homeQuestion("How does the trial work?") {
						Sign up and you get 30 days with everything, no card. Afterwards ops turns read-only until you subscribe: your apps keep running, their backups too, and you can still stop and start them.
					}
					@homeQuestion("What is a workspace?") {
						Your team in ops: its servers, apps, bucket, settings and people. Invite teammates and everyone works on the same servers. The plan, the trial and the activity belong to the workspace.
					}
					@homeQuestion("Do I pay per workspace?") {
						Yes. A plan covers one workspace with unlimited servers, apps and teammates. Most teams need one. A second workspace, say for a client, has its own plan; the free trial comes once, with your first.
					}
					@homeQuestion("Can I cancel?") {
						Any time, in the billing settings. Your plan runs until the end of the period you paid for, and your apps keep running on your servers.
					}
				}
			}
		</div>
	</section>
}

templ homeQuestion(question string) {
	@accordion.Item() {
		@accordion.Trigger(accordion.TriggerProps{Class: "items-center gap-6 rounded-none px-4 py-5 text-[17px] font-semibold hover:no-underline sm:px-5 sm:py-6 sm:text-lg **:data-[slot=accordion-trigger-icon]:hidden"}) {
			{ question }
			@icon.Plus(icon.Props{Class: "ml-auto size-5 shrink-0 text-muted-foreground transition-transform duration-200 group-aria-expanded/accordion-trigger:rotate-45"})
		}
		@accordion.Content(accordion.ContentProps{Class: "pb-0"}) {
			<p class="max-w-2xl px-4 pb-6 text-[16px] leading-7 text-muted-foreground sm:px-5 sm:text-[17px]">
				{ children... }
			</p>
		}
	}
}
