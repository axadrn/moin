package pages

import (
	"context"
	"strings"

	"github.com/axadrn/moin/controlplane/internal/brand"
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/ui/blocks"
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
)

// The type of the home page: the display size only for the hero, one big
// statement per section, the rest the sizes of the app.
const (
	homeStatement = "text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
	homeLead      = "text-lg text-muted-foreground text-balance"
	// homeSection is the one gap between the sections, and the room a
	// section a link jumps to keeps above itself for the floating navbar.
	homeSection = "flex scroll-mt-24 flex-col gap-8 pt-28 sm:pt-36"
)

// Home is the landing page: the promise over the container wall, how to
// start, what makes moin different, what it does, and the way in. Short:
// every row links to the docs for the rest. open is what the changelog
// says about how moin ships.
templ Home(network model.Network, open HomeOpen) {
	@layouts.Home(layouts.SEOProps{
		Title:       "Deploy anything. Lose nothing.",
		Description: brand.Description,
		Path:        ctxkeys.URLPath(ctx),
	}) {
		<main>
			@HomeHero()
			<div class={ kit.Page, "pb-28 sm:pb-36" }>
				if ctxkeys.RenderConfig(ctx).Billing && network.Deploys >= liveShowsAt {
					@HomeLive(network)
				}
				@HomeStart()
				@HomeDifferent()
				@HomeDoes()
				@HomeOpenSection(open)
				if ctxkeys.RenderConfig(ctx).Billing {
					@HomePricing()
				}
				@HomeEnd()
			</div>
		</main>
	}
}

// homePrimary is the one main button of the page: Deploy now, or Sign in
// while sign-up is closed. That it starts free is told on the sign-up page
// and the pricing.
templ homePrimary() {
	@kit.Button(kit.Primary, "/auth", nil) {
		{ homeStartLabel(ctx) }
	}
}

func homeStartLabel(ctx context.Context) string {
	cfg := ctxkeys.RenderConfig(ctx)
	if cfg.Billing && !cfg.SignupsOpen {
		return "Sign in"
	}
	return "Deploy now"
}

// ---------------------------------------------------------------- hero
// HomeHero is the whole first screen, up behind the floating navbar, whose
// height its top padding adds back: the promise and the two buttons on
// top, and the wall of containers across the full width below, every
// container an app.
templ HomeHero() {
	<section class="-mt-[4.25rem] flex min-h-svh flex-col overflow-hidden sm:-mt-[4.75rem]">
		<div class={ kit.Page, "flex flex-1 flex-col items-center justify-center gap-8 pt-[calc(4.25rem+2rem)] pb-8 text-center sm:pt-[calc(4.75rem+2.5rem)] sm:pb-10" }>
			<div class="flex flex-col items-center gap-6">
				<h1 class="font-display text-[12vw] leading-[0.95] tracking-[-0.06em] sm:text-[clamp(3rem,5.4vw,5.75rem)] sm:tracking-[-0.05em]">
					<span class="block">Deploy <br class="sm:hidden"/>anything.</span>
					<span class="block text-muted-foreground/60">Lose nothing.</span>
				</h1>
				<p class={ homeLead, "max-w-[34ch] max-sm:hidden" }>Your apps on your servers. Every change backed up. Every restore checked.</p>
			</div>
			<div class="flex justify-center gap-2">
				@homePrimary()
				<span class="max-[339px]:hidden">
					@kit.Button(kit.Secondary, "/docs", nil) {
						Read the docs
					}
				</span>
			</div>
		</div>
		<div class="h-[42svh] w-full shrink-0 sm:h-[44svh]">
			@homeHarbor()
		</div>
	</section>
}

// ---------------------------------------------------------------- live
// liveShowsAt is how many deploys it takes before the home page shows the
// live numbers: small ones say "nobody uses this". They are counted all the
// same.
const liveShowsAt = 1000

// HomeLive is what moin runs right now: the hosted control plane counts
// itself, self-hosted ones report every five minutes. We say what is true.
templ HomeLive(network model.Network) {
	<section id="live" class={ homeSection } data-live>
		<h2 class="flex items-center gap-2 px-1 text-sm font-medium text-muted-foreground">
			<span class="size-2 rounded-full bg-live"></span>
			Running on { brand.Name } right now
		</h2>
		<dl class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
			@homeLiveNumber(network.SelfHosted, "self-hosted control planes", "self-hosted")
			@homeLiveNumber(network.HostedWorkspaces, "teams on hosted moin", "hosted")
			@homeLiveNumber(network.Servers, "servers", "servers")
			@homeLiveNumber(network.Apps, "apps live", "apps")
			@homeLiveNumber(network.Deploys, "deploys so far", "deploys")
		</dl>
	</section>
}

templ homeLiveNumber(count int, label, name string) {
	<div class="flex flex-col gap-1 rounded-4xl bg-card p-6" data-live-number={ name }>
		<dt class="sr-only">{ label }</dt>
		<dd class="text-2xl font-semibold tracking-tight tabular-nums">{ liveCount(count) }</dd>
		<dd class="text-sm text-muted-foreground">{ label }</dd>
	</div>
}

// ---------------------------------------------------------------- start
// HomeStart is how to begin: the four steps of Get started, each a row
// with its command, and the real output of a first deploy.
templ HomeStart() {
	<section id="how" class={ homeSection }>
		<h2 class={ homeStatement }>Live in four steps.</h2>
		<div class="grid items-start gap-4 lg:grid-cols-2">
			@kit.List() {
				@homeStep("1", "Log in", "moin login")
				@homeStep("2", "Add a server", "moin servers add web-1")
				@homeStep("3", "Add your bucket", "moin buckets add default")
				@homeStep("4", "Deploy", "moin deploy")
			}
			<div class="flex flex-col overflow-x-auto rounded-4xl bg-terminal p-6 font-mono text-sm leading-7 whitespace-pre text-terminal-foreground [scrollbar-width:none]">
				<span><span class="text-terminal-foreground/50">$ </span>moin deploy</span>
				<span class="text-terminal-foreground/60">Created app shop on web-1</span>
				<span class="text-terminal-foreground/60">Deploy v1 of shop started</span>
				<span class="text-terminal-foreground/60">{ "  detected go, service web on port 8080" }</span>
				<span class="text-terminal-foreground/60">{ "  v1 is live" }</span>
				<span><span class="text-live">✓</span> moin. shop is live at https://shop.203-0-113-7.sslip.io</span>
			</div>
		</div>
		<p class={ homeLead }>
			No Dockerfile needed: Node, Bun, Python, Ruby, PHP, Go and more.
			<a href="/docs/getting-started" class="text-foreground underline underline-offset-4">Get started</a>
		</p>
	</section>
}

// homeStep is one step: its number, what you do, and the command.
templ homeStep(number, name, command string) {
	@kit.Row("") {
		<span class="w-4 shrink-0 text-sm text-muted-foreground tabular-nums">{ number }</span>
		<div class="flex min-w-0 flex-1 flex-col sm:flex-row sm:items-center sm:gap-3">
			<span class="flex-1 font-medium">{ name }</span>
			<code class="truncate font-mono text-sm text-muted-foreground">{ command }</code>
		</div>
	}
}

// ---------------------------------------------------------------- different
// HomeDifferent is what makes moin different, one line each, every line a
// way into Why moin.
templ HomeDifferent() {
	<section id="different" class={ homeSection }>
		<h2 class={ homeStatement }>Different where it counts.</h2>
		@kit.List() {
			@homeReason("One binary.", "CLI, terminal UI and agent: one Go binary.", "/docs/why-moin#a-small-stack")
			@homeReason("The agent only dials out.", "Your server keeps no port open for moin.", "/docs/why-moin#the-agent-only-dials-out")
			@homeReason("Restores are checked.", "Every day, from your own bucket.", "/docs/why-moin#backups-whose-restores-are-checked")
		}
	</section>
}

templ homeReason(statement, line, href string) {
	@kit.Row(href) {
		<div class="flex min-w-0 flex-1 flex-col gap-1 py-2">
			<span class="text-2xl font-semibold tracking-tight">{ statement }</span>
			<span class="text-sm text-muted-foreground">{ line }</span>
		</div>
	}
}

// ---------------------------------------------------------------- does
// HomeDoes is everything moin does, as grouped rows like Settings: the
// name, a few words, and the guide.
templ HomeDoes() {
	<section id="product" class={ homeSection }>
		<h2 class={ homeStatement }>Everything an app needs.</h2>
		<div class="grid items-start gap-8 md:grid-cols-2">
			@kit.Section("Ship", nil) {
				@kit.List() {
					@homeFeature("Deploy", "Any repo, a compose.yml or an image", "/docs/guides/deploy")
					@homeFeature("Domains", "HTTPS from the first deploy", "/docs/guides/domains")
					@homeFeature("GitHub", "Every push, or one commit", "/docs/guides/github")
					@homeFeature("Catalog", "n8n, Umami, Open WebUI and more", "/apps")
				}
			}
			@kit.Section("Keep", nil) {
				@kit.List() {
					@homeFeature("Backups", "Every change, in your bucket", "/docs/guides/backups")
					@homeFeature("Data", "Browse, edit, run SQL", "/docs/guides/data")
					@homeFeature("Uptime and alerts", "Mail, Slack, Discord, Telegram", "/docs/guides/alerts")
					@homeFeature("AI agents", "Claude, Cursor, any MCP client", "/docs/guides/mcp")
				}
			}
		</div>
	</section>
}

templ homeFeature(name, note, href string) {
	@kit.Row(href) {
		@kit.RowText(name, note)
	}
}

// ---------------------------------------------------------------- pricing
// HomePricing puts the free self-hosted moin next to the hosted one: the
// same product, so the rows say what running it takes.
templ HomePricing() {
	<section id="pricing" class={ homeSection }>
		<h2 class={ homeStatement }>One price. Every feature.</h2>
		@kit.Grid() {
			<div class="flex flex-col gap-6 rounded-4xl bg-card p-6 sm:p-8" data-plan="hosted">
				<div class="flex flex-col gap-1">
					<span class="text-base font-medium">Hosted</span>
					<span class="flex items-baseline gap-2"><span class="text-3xl font-semibold tracking-tight tabular-nums">$29</span><span class="text-sm text-muted-foreground">a month per workspace</span></span>
					<span class="text-sm text-muted-foreground" data-yearly-deal>Or $249 a year. 30 days free, no card.</span>
				</div>
				@kit.Button(kit.Primary, "/auth", nil) {
					{ homeStartLabel(ctx) }
				}
				@homePlanRows("Ready in minutes", "We run and update it", "GitHub and email set up", "Support by email")
			</div>
			<div class="flex flex-col gap-6 rounded-4xl bg-card p-6 sm:p-8" data-plan="self-hosted">
				<div class="flex flex-col gap-1">
					<span class="text-base font-medium">Self-hosted</span>
					<span class="flex items-baseline gap-2"><span class="text-3xl font-semibold tracking-tight tabular-nums">$0</span><span class="text-sm text-muted-foreground">forever</span></span>
					<span class="text-sm text-muted-foreground">On your own server. Open source.</span>
				</div>
				@kit.Button(kit.Secondary, "/docs/self-hosting", nil) {
					Host it yourself
				}
				@homePlanRows("One command on one server", "Update in one click", "Your GitHub App, email optional", "Help on GitHub")
			</div>
		}
		<p class="px-1 text-sm text-muted-foreground" data-one-price>Unlimited servers, apps and team. No tiers, no per-server fees.</p>
	</section>
}

templ homePlanRows(rows ...string) {
	<ul class="flex flex-col gap-3 text-sm">
		for _, row := range rows {
			<li class="flex items-center gap-3">
				<svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 shrink-0 text-muted-foreground"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				{ row }
			</li>
		}
	</ul>
}

// ---------------------------------------------------------------- end
// HomeEnd is the end of the page: the wordmark, the promise again and the
// way in.
templ HomeEnd() {
	<section id="start" class={ homeSection, "items-start" }>
		<div class="flex w-full flex-col items-start gap-8 rounded-4xl bg-card p-8 sm:p-14">
			@blocks.Wordmark("text-[clamp(4rem,13vw,8rem)] leading-none")
			<p class={ homeStatement }>
				Deploy anything. <span class="text-muted-foreground/60">Lose nothing.</span>
			</p>
			<div class="flex flex-wrap gap-2">
				@homePrimary()
				@kit.Button(kit.Secondary, "/docs/why-moin", nil) {
					Why { brand.Name }
				}
			</div>
			<p class="text-sm text-muted-foreground">
				if ctxkeys.RenderConfig(ctx).Billing {
					30 days free, no card. Or <a href="/docs/self-hosting" class="text-foreground underline underline-offset-4">host it yourself</a>, free forever.
				} else {
					Free and open source.
				}
			</p>
		</div>
	</section>
}

// homeInShort is the In short of a changelog entry without its backticks.
func homeInShort(text string) string {
	return strings.ReplaceAll(text, "`", "")
}
