package pages

import (
	"context"
	"strconv"

	"github.com/axadrn/moin/controlplane/internal/ui/components/accordion"
	"github.com/axadrn/moin/controlplane/internal/ui/components/badge"
	"github.com/axadrn/moin/controlplane/internal/ui/components/button"
	"github.com/axadrn/moin/controlplane/internal/ui/components/card"
	"github.com/axadrn/moin/controlplane/internal/ui/components/table"
	"github.com/axadrn/moin/controlplane/internal/ui/components/tabs"
	"github.com/axadrn/moin/controlplane/internal/ui/utils"

	"github.com/axadrn/moin/controlplane/internal/brand"
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/ui/blocks"
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
)

const (
	homeWrap = "mx-auto w-full max-w-[1240px] px-4 sm:px-8"
	// The type scale of the home page: five sizes, two weights.
	typeH1      = "font-semibold tracking-[-0.045em] leading-[1.02] text-[clamp(2.6rem,6vw,4.5rem)] text-balance"
	typeH2      = "font-semibold tracking-[-0.04em] leading-[1.05] text-[clamp(2rem,4.5vw,3.25rem)] text-balance"
	typeH3      = "text-xl font-semibold tracking-[-0.02em]"
	typeLead    = "text-lg leading-8 text-muted-foreground"
	typeText    = "text-base leading-7 text-muted-foreground"
	typeNumber  = "font-semibold tracking-[-0.04em] text-5xl tabular-nums"
	homeSurface = "rounded-4xl bg-card"
)

templ Home(network model.Network) {
	@layouts.Home(layouts.SEOProps{
		Title:       "Deploy to servers you own",
		Description: brand.Name + " deploys your apps to servers you own, backs up every change of their SQLite database to your bucket, lets you edit the data live and checks every domain every minute. From the web, the CLI, a terminal UI and MCP.",
		Path:        ctxkeys.URLPath(ctx),
	}) {
		<main>
			@HomeHero()
			if ctxkeys.RenderConfig(ctx).Billing && network.Deploys >= liveShowsAt {
				@HomeLive(network)
			}
			@HomeCommands()
			@HomeBackups()
			@HomeData()
			@HomeUptime()
			@HomeWaysIn()
			@HomeCompare()
			if ctxkeys.RenderConfig(ctx).Billing {
				@HomePricing()
			}
			@HomeNext()
			@HomeFAQ()
			@HomeWhy()
			@HomeStart()
		</main>
	}
}

// homeCTA is the size of the big buttons of the home page.
const homeCTA = "gap-2"

// homeAnchor is the room a section a nav link jumps to keeps above itself:
// the sticky navbar (12 px offset plus 56 px, 64 px from sm) and 24 px. The
// space between sections is their top margin, so the jump lands right at
// the heading.
const homeAnchor = "scroll-mt-23 sm:scroll-mt-25"

// homeSection is the one gap between the sections of the home page.
const homeSection = "mt-28 sm:mt-36"

// homePrimary is the one main button of the page: the free trial, or sign
// in while sign-up is closed and on a self-hosted moin.
templ homePrimary() {
	@button.Button(button.Props{Href: "/auth", Variant: button.VariantDefault, Size: button.SizeLg, Class: homeCTA}) {
		{ homeStartLabel(ctx) }
		@icon.ArrowRight(icon.Props{Class: "size-4"})
	}
}

func homeStartLabel(ctx context.Context) string {
	cfg := ctxkeys.RenderConfig(ctx)
	switch {
	case !cfg.Billing:
		return "Get started"
	case cfg.SignupsOpen:
		return "Start free trial"
	default:
		return "Sign in"
	}
}


// ---------------------------------------------------------------- hero
// HomeHero is the promise in two lines, one line under it, two buttons,
// and the product below. Nothing else.
templ HomeHero() {
	<section class="pt-20 sm:pt-32">
		<div class={ homeWrap, "flex flex-col items-center text-center" }>
			<h1 class="text-[clamp(3rem,8.5vw,6.75rem)] leading-[0.98] font-semibold tracking-[-0.055em]">
				<span class="block">Deploy anything.</span>
				<span class="block text-muted-foreground/60">Lose nothing.</span>
			</h1>
			<p class="mt-8 text-xl text-muted-foreground sm:mt-10 sm:text-2xl">Any app. Any server.</p>
			<p class="mt-3 text-base text-muted-foreground/70">Every SQLite and Postgres change backed up, checked every day.</p>
			<div class="mt-10 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
				@homePrimary()
				@button.Button(button.Props{Href: "/docs", Variant: button.VariantSecondary, Size: button.SizeLg, Class: homeCTA}) {
					Read the docs
				}
			</div>
			<p class="mt-6 text-sm text-muted-foreground/70">
				<span class="font-semibold text-muted-foreground">moin</span> /mɔɪn/ · hello, the Hamburg way.
				<a href="#why-moin" class="text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">Read the story →</a>
			</p>
		</div>
		<div class={ homeWrap, "mt-20 sm:mt-28" }>
			@homeStage()
		</div>
		@stageScript()
	</section>
}

// homeStage is the control panel, big, with a switch between its three
// pages and live states around it.
templ homeStage() {
	@tabs.Tabs(tabs.Props{DefaultValue: "deploys", Class: "relative gap-0", Attributes: templ.Attributes{"data-stage": true}}) {
		<div class="mb-4 flex justify-center">
			@tabs.List(tabs.ListProps{Class: "gap-1 bg-card p-1 text-muted-foreground group-data-horizontal/tabs:h-auto", Attributes: templ.Attributes{"aria-label": "Product"}}) {
				@homeStageTab("deploys", "Deploys")
				@homeStageTab("data", "Data")
				@homeStageTab("backups", "Backups")
			}
		</div>
		@card.Card(card.Props{Class: "block gap-0 py-0 text-base overflow-visible rounded-[22px] bg-card p-1.5 sm:rounded-[32px] sm:p-3"}) {
			<div class="grid overflow-hidden rounded-[17px] sm:rounded-[22px]">
				@homeShot("deploys", "The app page of a shop: the live release, every deploy, and the deploy log with the snapshot before the deploy", true)
				@homeShot("data", "The data page: the tables of the shop database, and its customers table with rows to edit in place", false)
				@homeShot("backups", "The backups page: continuous backup, restore to any second in the window, and the snapshots", false)
			</div>
		}
		<div class="mt-5 flex flex-wrap items-center justify-center gap-2.5" aria-label="What moin reports">
			@homeChip("blog", "live", "live v6")
			@homeChip("shop.db", "live", "verified by restore")
			@homeChip("api", "failed", "v3 failed · v2 runs again")
		</div>
	}
}

templ homeStageTab(name, label string) {
	@tabs.Trigger(tabs.TriggerProps{
		Value:      name,
		Class:      "relative h-auto flex-none cursor-pointer px-5 py-2 font-medium",
		Attributes: templ.Attributes{"data-stage-tab": name},
	}) {
		{ label }
		<span data-stage-progress aria-hidden="true" class="pointer-events-none absolute inset-x-4 bottom-1 h-px origin-left scale-x-0 rounded-full bg-foreground/40"></span>
	}
}

// stageScript moves the stage to its next page every few seconds, with a
// thin line filling under the tab. It waits while the pointer is on the
// stage or the stage is off screen, stops for good once someone picks a
// tab, and never runs for reduced motion.
templ stageScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const stage = document.querySelector("[data-stage]");
			if (!stage || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
			const tabs = [...stage.querySelectorAll("[data-stage-tab]")];
			const ms = 6000;
			let timer, stopped = false, paused = false, seen = false;
			const active = () => Math.max(0, tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true"));
			const reset = () => tabs.forEach((tab) => {
				const line = tab.querySelector("[data-stage-progress]");
				line.style.transition = "none";
				line.style.transform = "scaleX(0)";
			});
			const run = () => {
				clearTimeout(timer);
				reset();
				if (stopped || paused || !seen) return;
				const line = tabs[active()].querySelector("[data-stage-progress]");
				line.getBoundingClientRect();
				line.style.transition = "transform " + ms + "ms linear";
				line.style.transform = "scaleX(1)";
				timer = setTimeout(() => {
					tabs[(active() + 1) % tabs.length].click();
					run();
				}, ms);
			};
			tabs.forEach((tab) => tab.addEventListener("click", (event) => {
				if (event.isTrusted) {
					stopped = true;
					run();
				}
			}));
			stage.addEventListener("pointerenter", () => { paused = true; run(); });
			stage.addEventListener("pointerleave", () => { paused = false; run(); });
			new IntersectionObserver(([entry]) => { seen = entry.isIntersecting; run(); }, { threshold: 0.3 }).observe(stage);
		})();
	</script>
}

// homeShot is the tab panel of one page of the panel, light and dark: the
// theme switch picks the one that shows.
templ homeShot(name, alt string, first bool) {
	// All pages share one cell and fade into each other, loaded up front,
	// so a switch never shows an empty frame.
	@tabs.Content(tabs.ContentProps{Value: name, Class: "col-start-1 row-start-1 transition-opacity duration-500 ease-out [&.hidden]:pointer-events-none [&.hidden]:invisible [&.hidden]:block [&.hidden]:opacity-0", Attributes: templ.Attributes{"data-stage-shot": name}}) {
		<img
			src={ "/assets/img/product-" + name + "-light.png" }
			alt={ alt }
			width="2880"
			height="1800"
			decoding="async"
			class="block aspect-[4/3] w-full object-cover object-left-top sm:aspect-[1440/900] dark:hidden"
		/>
		<img
			src={ "/assets/img/product-" + name + "-dark.png" }
			alt={ alt }
			width="2880"
			height="1800"
			loading="lazy"
			decoding="async"
			class="hidden aspect-[4/3] w-full object-cover object-left-top sm:aspect-[1440/900] dark:block"
		/>
	}
}

// homeChip is a status pill on a solid backing: the app name and its state.
templ homeChip(app, kind, text string) {
	@badge.Badge(badge.Props{Class: "h-auto leading-normal text-card-foreground text-base font-normal inline-flex items-center gap-3 rounded-full bg-card py-1.5 pr-1.5 pl-5 shadow-[0_10px_30px_-14px_rgb(0_0_0/0.45)]"}) {
		<span class="font-mono text-sm font-medium">{ app }</span>
		switch kind {
			case "live":
				@badge.Badge(badge.Props{Class: "h-auto leading-normal inline-flex items-center gap-2 rounded-full bg-live/12 px-3.5 py-1.5 text-sm font-medium text-live"}) {
					<span class="lp-pulse size-2 rounded-full bg-live"></span>
					{ text }
				}
			case "running":
				@badge.Badge(badge.Props{Class: "h-auto leading-normal inline-flex items-center gap-2 rounded-full bg-running/14 px-3.5 py-1.5 text-sm font-medium text-running"}) {
					<span class="moin-turn inline-block leading-none">◐</span>
					{ text }
				}
			default:
				@badge.Badge(badge.Props{Class: "h-auto leading-normal inline-flex items-center gap-2 rounded-full bg-failed/12 px-3.5 py-1.5 text-sm font-medium text-failed"}) {
					<span class="leading-none">✗</span>
					{ text }
				}
		}
	}
}

// ---------------------------------------------------------------- live
// liveShowsAt is how many deploys it takes before the home page shows the
// live numbers: small ones say "nobody uses this". They are counted all the
// same.
const liveShowsAt = 1000

// HomeLive is what moin runs right now: the hosted control plane counts
// itself, self-hosted ones report every five minutes. We say what is true.
templ HomeLive(network model.Network) {
	<section id="live" class={ homeAnchor, homeSection } data-live>
		<div class={ homeWrap }>
			<p class="flex items-center gap-2.5 text-sm font-semibold text-muted-foreground">
				<span class="lp-pulse size-2 rounded-full bg-live"></span>
				Running on moin right now
			</p>
			<dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
				@homeLiveNumber(network.SelfHosted, "self-hosted control planes", "self-hosted")
				@homeLiveNumber(network.HostedWorkspaces, "teams on hosted moin", "hosted")
				@homeLiveNumber(network.Servers, "servers", "servers")
				@homeLiveNumber(network.Apps, "apps live", "apps")
				@homeLiveNumber(network.Deploys, "deploys so far", "deploys")
			</dl>
		</div>
	</section>
}

templ homeLiveNumber(count int, label, name string) {
	@card.Card(card.Props{Class: utils.CN("block gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "px-6 py-5")), Attributes: templ.Attributes{"data-live-number": name}}) {
		<dt class="sr-only">{ label }</dt>
		<dd>
			<span class={ typeNumber, "block text-4xl" }>{ liveCount(count) }</span>
			<span class="mt-2 block text-sm text-muted-foreground">{ label }</span>
		</dd>
	}
}

// ---------------------------------------------------------------- commands
templ HomeCommands() {
	<section id="how" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			<h2 class={ typeH2, "" }>Three commands.</h2>
			<p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground">
				<span class="text-foreground">Node, Bun, Python, Ruby, PHP, Go, Rust: push, it runs.</span>
				No Dockerfile? { brand.Name } reads your repo and builds it. <a href="/docs/getting-started" class="text-foreground underline underline-offset-4 hover:text-foreground">Every step</a>
			</p>
			<div class="mt-12 grid grid-cols-1 gap-3 sm:mt-16">
				@homeCommand("moin servers add web-1", "Paste one line on any Linux server. No open port, no SSH key.")
				@homeCommand("moin deploy", "Your server builds the app and puts it live, if it is healthy.")
				@homeCommand("moin restore --at 14:01", "Deleted the wrong rows at 14:02? Go back to 14:01.")
			</div>
		</div>
	</section>
}

templ homeCommand(command, text string) {
	@card.Card(card.Props{Class: utils.CN("gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "grid grid-cols-1 gap-4 p-7 sm:p-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:items-center lg:gap-12 lg:px-12"))}) {
		<p class="font-mono text-2xl leading-tight break-words sm:text-3xl">
			<span class="text-muted-foreground/60">$ </span>{ command }
		</p>
		<p class="max-w-md text-base leading-7 text-muted-foreground">{ text }</p>
	}
}

// ---------------------------------------------------------------- ways in
// HomeWaysIn is one rollback of shop, done four ways: each frame is what
// that surface really shows.
templ HomeWaysIn() {
	<section id="ways" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			<h2 class={ typeH2, "max-w-[16ch]" }>One tool. Four ways in.</h2>
			<p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground">
				<span class="text-foreground">Click, type, press a key or ask your AI.</span>
				Every feature works everywhere.
			</p>
			<p class="mt-4 max-w-2xl text-lg leading-8 text-muted-foreground">
				<a href="/docs/guides/activity" class="text-foreground underline underline-offset-4 hover:text-foreground">Know who changed what, to the second.</a>
				Your secrets and your data never.
			</p>
			<div class="mt-12 grid grid-cols-1 gap-3 sm:mt-16 lg:grid-cols-2">
				@homeWay("Browser", "For you and your team.") {
					@homeWayWeb()
				}
				@homeWay("CLI", "For scripts and CI.") {
					<div class="moin-term overflow-x-auto rounded-3xl bg-terminal px-6 py-5 text-sm leading-6 whitespace-pre text-terminal-foreground sm:text-sm">
						<p><span class="text-terminal-foreground/50">$ </span>moin rollback v12</p>
						<p class="text-terminal-foreground/60">→ Rollback v14 of shop to v12 started</p>
						<p class="text-live">✓ moin. shop is live <span class="text-terminal-foreground/50">v14 in 3s</span></p>
					</div>
				}
				@homeWay("Terminal UI", "Everything live, one key away.") {
					@homeWayTUI()
				}
				@homeWay("AI agent", "Claude, Cursor and more.") {
					<div class="flex flex-col gap-3 rounded-3xl bg-background p-5 text-base leading-6">
						<p class="max-w-[85%] self-end rounded-2xl rounded-br-md bg-foreground px-4 py-2.5 text-background">shop is broken since the last deploy. Roll it back.</p>
						<p class="self-start font-mono text-sm text-muted-foreground">rollback_app · shop</p>
						<p class="max-w-[85%] self-start rounded-2xl rounded-bl-md bg-card px-4 py-2.5">Rolled back. v14 of shop runs the release of v12, your data stays as it is.</p>
					</div>
				}
			</div>
			<div class="mt-5 flex flex-wrap items-center justify-center gap-2.5">
				@badge.Badge(badge.Props{Class: "h-auto leading-normal text-card-foreground text-base font-normal inline-flex items-center gap-3 rounded-full bg-card py-1.5 pr-1.5 pl-5"}) {
					<span class="text-sm font-semibold">Desktop app</span>
					@badge.Badge(badge.Props{Class: "h-auto leading-normal inline-flex items-center gap-2 rounded-full bg-running/14 px-3.5 py-1.5 text-sm font-medium text-running"}) {
						<span class="moin-turn inline-block leading-none">◐</span>
						coming soon
					}
				}
			</div>
		</div>
	</section>
}

templ homeWay(name, text string) {
	@card.Card(card.Props{Class: utils.CN("gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "flex min-w-0 flex-col gap-6 p-5 sm:p-8"))}) {
		<div class="px-2 pt-2 sm:px-0 sm:pt-0">
			<p class={ typeH3 }>{ name }</p>
			<p class="mt-2 text-base leading-7 text-muted-foreground">{ text }</p>
		</div>
		<div class="mt-auto min-w-0">
			{ children... }
		</div>
	}
}

// homeWayWeb is the deploy list of the app page, the pointer on v12.
templ homeWayWeb() {
	<div class="rounded-3xl bg-background p-2 text-sm" aria-label="The deploy list of shop with a Roll back button on v12">
		@homeWayDeploy("v13", "live", "4m · 5s", false)
		@homeWayDeploy("v12", "succeeded", "5m · 5s", true)
		@homeWayDeploy("v11", "succeeded", "5m · 5s", false)
	</div>
}

templ homeWayDeploy(number, status, when string, hover bool) {
	<div class={ "flex items-center gap-4 rounded-xl px-4 py-3", templ.KV("bg-muted", hover) }>
		if status == "live" {
			<span class="size-2.5 rounded-full bg-live"></span>
		} else {
			<span class="size-2.5 rounded-full border-2 border-muted-foreground/60"></span>
		}
		<span class="w-10 font-mono font-semibold">{ number }</span>
		<span class={ "font-semibold", templ.KV("text-live", status == "live") }>{ status }</span>
		if hover {
			@badge.Badge(badge.Props{Class: "h-auto leading-normal ml-auto rounded-full bg-card px-3 py-1 text-sm font-semibold text-card-foreground shadow-[0_6px_18px_-10px_rgb(0_0_0/0.5)]"}) {
				Roll back
			}
		} else {
			<span class="ml-auto text-sm text-muted-foreground tabular-nums">{ when }</span>
		}
	</div>
}

// homeWayTUI is the app screen of the terminal UI asking before the
// rollback, as moin draws it.
templ homeWayTUI() {
	<div class="moin-term overflow-x-auto rounded-3xl bg-terminal py-4 text-sm leading-[1.65] whitespace-pre text-terminal-foreground sm:text-sm" aria-label="The terminal UI asks before it rolls shop back">
		<p class="px-5"><span class="font-semibold">moin</span>{ "   " }<span class="text-terminal-foreground/50">servers 1</span>{ "   apps › shop   " }<span class="text-terminal-foreground/50">activity</span></p>
		<p class="mt-3 px-5">{ "  " }<span class="font-semibold">shop</span>{ "   " }<span class="text-live">● live v13</span></p>
		<p class="mt-2 px-5 text-terminal-foreground/50">{ "  DEPLOY   STATUS        TOOK" }</p>
		<p class="px-5">{ "  v13      " }<span class="text-live">● live</span>{ "         5s" }</p>
		<p class="px-5">{ "  v12      " }<span class="text-live">✓</span>{ " succeeded   5s" }</p>
		<p class="px-5">{ "  v11      " }<span class="text-live">✓</span>{ " succeeded   5s" }</p>
		<p class="mt-3 border-t border-terminal-foreground/10 px-5 pt-3"><span class="text-running">▌</span>{ " Roll shop back to the deploy before v13?" }</p>
		<p class="px-5"><span class="text-running">▌</span>{ " " }<span class="text-terminal-foreground/60">It starts the old images with the env they had.</span></p>
		<p class="px-5">{ "  " }<span class="font-semibold">y</span>{ " " }<span class="text-terminal-foreground/60">{ "roll back   any other key cancels" }</span></p>
	</div>
}

// ---------------------------------------------------------------- backups
templ HomeBackups() {
	<section id="backups" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			<h2 class={ typeH2, "max-w-[14ch]" }>Never lose a row.</h2>
			<p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground">
				<span class="text-foreground">Every change is in your bucket within a second.</span>
				Every day, { brand.Name } restores it and checks it works.
			</p>
			// Sources, read November 4, 2026:
			// AWS: "RDS uploads transaction logs for DB instances to Amazon S3
			// every five minutes." docs.aws.amazon.com/AmazonRDS/latest/UserGuide/USER_PIT.html
			// Coolify: scheduled dumps on a cron; "A successful backup only proves
			// that Coolify created a file", coolify.io/docs/databases/backups
			// Dokploy: "Schedule Cron", docs.dokploy.com/docs/core/databases/backups
			@card.Card(card.Props{Class: "mt-12 gap-0 overflow-hidden rounded-4xl bg-card py-0 text-base shadow-none ring-0 sm:mt-16"}) {
				@table.Table(table.Props{Class: "text-base"}) {
					@table.Header() {
						@table.Row(table.RowProps{Class: "hover:bg-transparent"}) {
							@table.Head(table.HeadProps{Class: "h-14 pl-6 text-sm font-normal text-muted-foreground sm:pl-8"}) {
								How old is your newest backup?
							}
							@table.Head(table.HeadProps{Class: "h-14 text-sm font-normal text-muted-foreground"}) {
								SQLite
							}
							@table.Head(table.HeadProps{Class: "h-14 text-sm font-normal text-muted-foreground"}) {
								Postgres
							}
							@table.Head(table.HeadProps{Class: "h-14 pr-6 text-sm font-normal text-muted-foreground sm:pr-8"}) {
								Restore checked
							}
						}
					}
					@table.Body() {
						@homeBackupRow(brand.Name, "1 second", "1 minute", "Every day", true)
						@homeBackupRow("AWS RDS", "–", "5 minutes", "No", false)
						@homeBackupRow("Coolify, Dokploy", "Your schedule", "Your schedule", "By you", false)
					}
				}
			}
			<ul class="mt-8 flex flex-col gap-3 text-base text-muted-foreground sm:flex-row sm:gap-10">
				<li><span class="text-foreground">A full copy</span> before every deploy and every edit.</li>
				<li><span class="text-foreground">Your bucket:</span> R2, S3, B2 or Hetzner. Never through us.</li>
			</ul>
		</div>
	</section>
}

// homeBackupRow is one line of the backup comparison; ours stands out.
templ homeBackupRow(name, sqlite, postgres, checked string, ours bool) {
	@table.Row(table.RowProps{Class: utils.CN("hover:bg-transparent", utils.IfElse(ours, "bg-live/8", ""))}) {
		@table.Cell(table.CellProps{Class: utils.CN("h-16 pl-6 font-semibold whitespace-nowrap sm:pl-8", utils.IfElse(!ours, "font-normal text-muted-foreground", ""))}) {
			{ name }
		}
		@table.Cell(table.CellProps{Class: utils.CN("whitespace-nowrap tabular-nums", utils.IfElse(ours, "font-semibold text-live", ""), utils.IfElse(!ours, "text-muted-foreground", ""))}) {
			{ sqlite }
		}
		@table.Cell(table.CellProps{Class: utils.CN("whitespace-nowrap tabular-nums", utils.IfElse(ours, "font-semibold text-live", ""), utils.IfElse(!ours, "text-muted-foreground", ""))}) {
			{ postgres }
		}
		@table.Cell(table.CellProps{Class: utils.CN("pr-6 whitespace-nowrap sm:pr-8", utils.IfElse(ours, "font-semibold text-live", ""), utils.IfElse(!ours, "text-muted-foreground", ""))}) {
			{ checked }
		}
	}
}

// ---------------------------------------------------------------- data
templ HomeData() {
	<section id="data" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			@card.Card(card.Props{Class: utils.CN("gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "grid grid-cols-1 gap-10 p-7 sm:p-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16 lg:p-16"))}) {
				<div>
					<h2 class={ typeH2, "" }>Your data, live.</h2>
					<p class="mt-6 max-w-lg text-lg leading-8 text-muted-foreground">
						<span class="text-foreground">Browse every table, edit a cell, run SQL.</span>
						Live from your server. Every change takes a snapshot first.
					</p>
				</div>
				<div class="moin-term self-center overflow-x-auto rounded-3xl bg-terminal px-6 py-5 text-sm leading-6 whitespace-pre-wrap text-terminal-foreground sm:text-sm">
					<p><span class="text-terminal-foreground/50">$ </span>moin sql "SELECT status, count(*) FROM orders GROUP BY status"</p>
					<p class="mt-2 text-terminal-foreground/50">STATUS      COUNT(*)</p>
					<p>delivered   38</p>
					<p>paid        126</p>
					<p>refunded    39</p>
					<p>shipped     74</p>
					<p class="mt-4"><span class="text-terminal-foreground/50">$ </span>moin sql --write "UPDATE orders SET status = 'shipped' WHERE id = 412"</p>
					<p class="text-live">✓ 1 row changed</p>
				</div>
			}
		</div>
	</section>
}

// ---------------------------------------------------------------- uptime
// HomeUptime is the uptime check and its email, in the same card as the
// data above it.
templ HomeUptime() {
	<section id="uptime" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			@card.Card(card.Props{Class: utils.CN("gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "grid grid-cols-1 gap-10 p-7 sm:p-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16 lg:p-16"))}) {
				<div>
					<h2 class={ typeH2, "" }>Know before your customers do.</h2>
					<p class="mt-6 max-w-lg text-lg leading-8 text-muted-foreground">
						<span class="text-foreground">Every domain, checked from outside, every minute.</span>
						Down? You hear it by email, Slack, Discord or Telegram. Nothing to set up, no second tool to pay for.
					</p>
				</div>
				<div class="self-center divide-y divide-border rounded-3xl bg-background px-1" aria-label="Two alert emails from moin">
					@homeAlert("shop.example.com is down", "HTTP 502 · since 14:02", false)
					@homeAlert("shop.example.com is back up", "down for 4 minutes", true)
				</div>
			}
		</div>
	</section>
}

templ homeAlert(subject, detail string, up bool) {
	<div class="flex items-center gap-4 px-5 py-4">
		<span class={ "size-2.5 shrink-0 rounded-full", templ.KV("bg-live", up), templ.KV("bg-destructive", !up) }></span>
		<span class="min-w-0">
			<span class="block text-base font-semibold">{ subject }</span>
			<span class="block text-sm text-muted-foreground">{ detail }</span>
		</span>
		<span class="ml-auto shrink-0 text-sm text-muted-foreground">hello@</span>
	</div>
}

// ---------------------------------------------------------------- compare
// HomeCompare puts moin next to what people use instead, fact by fact, from
// their own docs and pricing pages (compareGroups), in three tabs: hosted
// control planes, tools you run yourself, and platforms. Each cell carries a mark to read
// at a glance; each column says how many facts it wins.
templ HomeCompare() {
	<section id="compare" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			<h2 class={ typeH2, "max-w-[16ch]" }>Why { brand.Name }</h2>
			<p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground">
				<span class="text-foreground">Others put your app online. { brand.Name } also keeps your servers closed and your data safe.</span>
			</p>
			@tabs.Tabs(tabs.Props{DefaultValue: compareTabs[0].Value, Class: "mt-12 gap-6 sm:mt-16", Attributes: templ.Attributes{"data-compare": true}}) {
				@tabs.List(tabs.ListProps{Class: "max-w-full w-fit gap-1 overflow-x-auto bg-card p-1 text-muted-foreground group-data-horizontal/tabs:h-auto", Attributes: templ.Attributes{"aria-label": "Compare with"}}) {
					for _, tab := range compareTabs {
						@tabs.Trigger(tabs.TriggerProps{Value: tab.Value, Class: "h-auto cursor-pointer px-4 py-2 font-medium"}) {
							{ tab.Title }
						}
					}
				}
				for _, tab := range compareTabs {
					@tabs.Content(tabs.ContentProps{Value: tab.Value}) {
						@compareTable(tab)
					}
				}
			}
			<p class="mt-4 text-sm text-muted-foreground">* From their own docs, Nov 2026.</p>
			<div class="mt-10">
				@homePrimary()
			</div>
		</div>
	</section>
}

// compareTable is a tab of the comparison on a wide screen: the facts
// down, moin and the tools across, each with how many facts it wins.
templ compareTable(tab compareTab) {
	<div class={ utils.CN(homeSurface, "max-h-[80svh] overflow-auto overscroll-x-contain ring-1 ring-border") }>
		<table class="w-full border-separate border-spacing-0 text-left">
			<thead>
				<tr>
					<th scope="col" class="sticky top-0 left-0 z-30 w-40 min-w-40 bg-card sm:w-64 sm:min-w-64"><span class="sr-only">Fact</span></th>
					for c, column := range tab.Columns {
						@compareHead(column, c == 0)
					}
				</tr>
			</thead>
			<tbody>
				for g, group := range compareGroups {
					<tr>
						<th scope="colgroup" class={ "sticky left-0 z-10 bg-card px-3 pb-2 sm:px-4 text-left text-xs font-semibold tracking-wide text-muted-foreground uppercase", templ.KV("pt-4", g == 0), templ.KV("pt-8", g > 0) }>{ group.Title }</th>
						<td class="bg-live/10"></td>
						<td colspan={ strconv.Itoa(len(tab.Columns) - 1) }></td>
					</tr>
					for r, row := range group.Rows {
						{{ last := g == len(compareGroups)-1 && r == len(group.Rows)-1 }}
						<tr class="align-top">
							<th scope="row" class="sticky left-0 z-10 border-t border-border bg-card px-3 py-4 text-sm font-medium sm:px-4 sm:text-base">{ row.Label }</th>
							for c, column := range tab.Columns {
								if c == 0 {
									<td class={ "border-t border-live/20 bg-live/10 px-3 py-4 sm:px-4", templ.KV("rounded-b-3xl", last) }>
										@compareCellView(cellFor(row, column), true)
									</td>
								} else {
									<td class="border-t border-border px-3 py-4 sm:px-4">
										@compareCellView(cellFor(row, column), false)
									</td>
								}
							}
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}

// compareHead is a tool's column head: its name and its wins. moin wears
// the tint that runs down its column.
templ compareHead(column compareColumn, moin bool) {
	<th scope="col" class={ "sticky top-0 z-20 min-w-36 px-3 pt-5 pb-4 align-bottom sm:px-4", templ.KV("bg-card", !moin), templ.KV("bg-[color-mix(in_oklab,var(--live)_10%,var(--card))]", moin) }>
		<span class={ "block text-base font-semibold", templ.KV("text-live", moin) }>{ column.Name }</span>
		<span class={ "mt-2 inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-semibold tabular-nums", templ.KV("bg-live text-background", moin), templ.KV("bg-muted text-muted-foreground", !moin) }>
			@icon.Check(icon.Props{Class: "size-3 stroke-3"})
			{ strconv.Itoa(compareWins(column.Tool)) } of { strconv.Itoa(compareFacts(column.Tool)) }
		</span>
	</th>
}

// compareCellView is a cell of the comparison: its mark and its word or
// two, with the detail below in small print.
templ compareCellView(cell compareCell, moin bool) {
	<span class="inline-flex items-start gap-2.5 text-left">
		switch cell.Mark {
			case markYes:
				<span class="mt-px flex size-5 shrink-0 items-center justify-center rounded-full bg-live text-background" aria-label="Yes" role="img">
					@icon.Check(icon.Props{Class: "size-3 stroke-3"})
				</span>
			case markPart:
				<span class="mt-px flex size-5 shrink-0 items-center justify-center rounded-full bg-running/20 text-running" aria-label="Partly" role="img">
					@icon.Minus(icon.Props{Class: "size-3 stroke-3"})
				</span>
			case markNo:
				<span class="mt-px flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-muted-foreground" aria-label="No" role="img">
					@icon.X(icon.Props{Class: "size-3 stroke-3"})
				</span>
			case markUnknown:
				<span class="mt-px flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-semibold text-muted-foreground" aria-label="Not said" role="img">?</span>
		}
		<span class="flex flex-col">
			<span class={ "text-base leading-6 font-semibold whitespace-nowrap", templ.KV("text-foreground", moin), templ.KV("text-foreground", !moin) }>{ cell.Short }</span>
			if cell.Detail != "" {
				<span class="mt-0.5 text-xs leading-4 text-muted-foreground">{ cell.Detail }</span>
			}
		</span>
	</span>
}

// ---------------------------------------------------------------- start
// HomeStart is the last call to action, after the questions.
templ HomeStart() {
	<section id="start" class={ homeAnchor, homeSection, "pb-28 sm:pb-36" }>
		<div class={ homeWrap }>
			<h2 class={ typeH2, "max-w-[16ch]" }>Live in two minutes.</h2>
			<ol class="mt-12 grid grid-cols-1 gap-3 sm:mt-16 lg:grid-cols-3">
				@homeStep("1", "Sign in", "With GitHub or your email.")
				@homeStep("2", "Add a server", "One line on any Linux box.")
				@homeStep("3", "Deploy", "moin deploy. Backed up from the first second.")
			</ol>
			<div class="mt-10 flex flex-col items-start gap-3">
				@homePrimary()
				<p class="text-sm text-muted-foreground">
					if ctxkeys.RenderConfig(ctx).Billing {
						30 days free, no card. Or <a href="/docs/self-hosting" class="text-foreground underline underline-offset-4 hover:text-foreground">host it yourself</a>, free forever.
					} else {
						Free and open source.
					}
				</p>
			</div>
		</div>
	</section>
}

templ homeStep(number, title, text string) {
	@card.Card(card.Props{Class: utils.CN("block gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "p-7 sm:p-8"))}) {
		<span class="flex size-9 items-center justify-center rounded-full bg-foreground text-base font-semibold text-background">{ number }</span>
		<p class={ typeH3, "mt-6" }>{ title }</p>
		<p class="mt-2 text-base leading-7 text-muted-foreground">{ text }</p>
	}
}

// ---------------------------------------------------------------- why moin
// HomeWhy is the story of the name, right before the last call to start: the
// hero links here with "Read the story". It ends on the promise of the hero.
templ HomeWhy() {
	<section id="why-moin" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			<div class={ homeSurface, "px-6 py-14 sm:px-14 sm:py-20" }>
				@blocks.Wordmark("text-[clamp(4rem,13vw,9.5rem)] leading-none")
				<p class="mt-8 text-lg text-muted-foreground sm:text-xl">
					<span class="font-mono">/mɔɪn/</span> · Hamburg for hello. Any hour, one word.
				</p>
				<div class={ typeLead, "mt-10 max-w-2xl space-y-6 text-foreground" }>
					<p>I grew up in Hamburg, next to one of Europe's busiest container ports. Millions of boxes a year, packed once, shipped anywhere, and nothing goes missing.</p>
					<p>Your apps are containers too. moin ships them to your servers and keeps every change to their data.</p>
				</div>
				<p class={ typeH2, "mt-12" }>
					Deploy anything. <span class="text-muted-foreground/60">Lose nothing.</span>
				</p>
			</div>
		</div>
	</section>
}

// ---------------------------------------------------------------- pricing
// HomePricing puts the free self-hosted moin next to the hosted one: the same
// product, so the rows say what running it takes. Both cards have the same
// rows in the same order, short enough to stay on one line.
templ HomePricing() {
	<section id="pricing" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			<h2 class={ typeH2 }>Simple pricing.</h2>
			<p class={ typeLead, "mt-6" }>Every feature in both. Unlimited servers, apps and teammates.</p>
			<div class="mt-12 grid grid-cols-1 gap-3 sm:mt-16 lg:grid-cols-2">
				@card.Card(card.Props{Class: utils.CN("gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "flex flex-col p-8 sm:p-10")), Attributes: templ.Attributes{"data-plan": "hosted"}}) {
					<div class="flex items-center justify-between gap-3">
						<p class={ typeH3 }>Hosted</p>
						@badge.Badge(badge.Props{Class: "h-auto rounded-full bg-live/15 px-3 py-1 text-sm font-medium text-live"}) {
							30 days free · no card
						}
					</div>
					<p class="mt-8 flex items-baseline gap-2">
						<span class={ typeNumber }>$29</span>
						<span class="text-base text-muted-foreground">/ month</span>
					</p>
					<p class={ typeText, "mt-2" } data-yearly-deal>Per workspace. Or $249 a year.</p>
					<div class="mt-8">
						@button.Button(button.Props{Href: "/auth", Size: button.SizeLg, Class: "w-full gap-2"}) {
							{ homeStartLabel(ctx) }
							@icon.ArrowRight(icon.Props{Class: "size-4"})
						}
					</div>
					<ul class="mt-8 flex flex-col gap-3 text-base">
						@homePlanCheck("Ready in two minutes")
						@homePlanCheck("We run and update it")
						@homePlanCheck("GitHub and email set up")
						@homePlanCheck("Support by email")
					</ul>
				}
				@card.Card(card.Props{Class: utils.CN("gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "flex flex-col p-8 sm:p-10")), Attributes: templ.Attributes{"data-plan": "self-hosted"}}) {
					<div class="flex items-center justify-between gap-3">
						<p class={ typeH3 }>Self-hosted</p>
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "h-auto rounded-full px-3 py-1 text-sm font-medium text-muted-foreground"}) {
							Open source
						}
					</div>
					<p class="mt-8 flex items-baseline gap-2">
						<span class={ typeNumber }>$0</span>
						<span class="text-base text-muted-foreground">/ forever</span>
					</p>
					<p class={ typeText, "mt-2" }>On your own server.</p>
					<div class="mt-8">
						@button.Button(button.Props{Href: "/docs/self-hosting", Variant: button.VariantSecondary, Size: button.SizeLg, Class: "w-full gap-2"}) {
							Host it yourself
							@icon.ArrowRight(icon.Props{Class: "size-4"})
						}
					</div>
					<ul class="mt-8 flex flex-col gap-3 text-base">
						@homePlanCheck("Set up in about an hour")
						@homePlanCheck("Update in one click")
						@homePlanCheck("Your GitHub App and email")
						@homePlanCheck("Help on GitHub")
					</ul>
				}
			</div>
			<p class={ typeText, "mt-8 text-center" } data-one-price>No tiers, no per-server fees. Beta price, yours to keep.</p>
		</div>
	</section>
}

// homePlanCheck is one line of a plan, with a check.
templ homePlanCheck(text string) {
	<li class="flex items-center gap-3">
		<span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-live/15 text-live">
			@icon.Check(icon.Props{Class: "size-3 stroke-3"})
		</span>
		{ text }
	</li>
}

// ---------------------------------------------------------------- next
// HomeNext is what comes next, short: the big steps on the roadmap.
templ HomeNext() {
	<section id="next" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			<h2 class={ typeH2 }>This is just the start.</h2>
			<p class={ typeLead, "mt-6 max-w-2xl" }>Every database. Every provider. Nothing anyone else can read.</p>
			<div class="mt-12 grid grid-cols-1 gap-3 sm:mt-16 lg:grid-cols-3">
				@homeNextStep("Servers in one click", "Create them at Hetzner, DigitalOcean and more, right from moin.")
				@homeNextStep("Zero trust", "Secrets only on your servers, end to end encrypted.")
				@homeNextStep("Signed commands", "Your servers only obey changes you signed.")
			</div>
			<p class="mt-6">
				<a href="/docs/roadmap" class="text-base text-muted-foreground underline underline-offset-4 hover:text-foreground">The roadmap</a>
			</p>
		</div>
	</section>
}

templ homeNextStep(title, text string) {
	@card.Card(card.Props{Class: utils.CN("block gap-0 py-0 text-base overflow-visible", utils.CN(homeSurface, "p-7"))}) {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "h-auto rounded-full px-2.5 py-0.5 text-xs font-medium text-muted-foreground"}) {
			Next
		}
		<p class={ typeH3, "mt-5" }>{ title }</p>
		<p class={ typeText, "mt-2" }>{ text }</p>
	}
}

// ---------------------------------------------------------------- faq
templ HomeFAQ() {
	<section id="faq" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			<h2 class={ typeH2, "" }>Questions.</h2>
			@accordion.Accordion(accordion.Props{Multiple: true, Class: utils.CN(homeSurface, "mt-10 px-2 sm:px-4")}) {
				@homeQuestion("Is it secure?") {
					We hold no key to your servers and need no open port. A file on your server decides what { brand.Name } may do there. <a href="/docs/guides/security" class="text-foreground underline underline-offset-4 hover:text-foreground">The security guide</a>
				}
				@homeQuestion("Do I need to know Docker?") {
					No. For a Go app, { brand.Name } sets everything up. Have a Dockerfile already? It uses yours.
				}
				@homeQuestion("What can I deploy?") {
					Any app with a Dockerfile, or any Go app. If a new version fails, the old one keeps running.
				}
				@homeQuestion("Which databases?") {
					SQLite and Postgres get everything: both backups, the daily check, the data browser. MySQL, Redis and the rest run too, without those extras.
				}
				@homeQuestion("Which servers?") {
					Any Linux server, at any provider. One line sets it up.
				}
				@homeQuestion("Where does my code go?") {
					Into your own bucket, then to your server. Never to us. From GitHub it goes straight to your server.
				}
				@homeQuestion("Can you see my data?") {
					Only what you open, and we never store it. Want none at all? One line on your server turns data access off, even for us.
				}
				@homeQuestion("What happens if moin is down?") {
					Your apps keep running. They live on your servers. You just cannot deploy until it is back.
				}
				@homeQuestion("Is it open source?") {
					Yes, all of it, under AGPL-3.0. Host it yourself for free, or let us run it.
				}
				@homeQuestion("Why AGPL, and can I contribute?") {
					AGPL keeps moin open: who runs a changed moin as a service shares the changes. Contributions welcome: open an issue first, then a pull request.
				}
				@homeQuestion("Can my AI agent use it?") {
					Yes. moin has an <a href="/docs/guides/mcp" class="text-foreground underline underline-offset-4 hover:text-foreground">MCP server</a>: Claude, Cursor or any MCP client can deploy, roll back, read logs and set env vars with a personal API token.
				}
				@homeQuestion("Where are my env vars?") {
					Encrypted with us today. Next, only on your servers. Then end-to-end, so we cannot read them at all.
				}
				@homeQuestion("Can my team use it?") {
					Yes, for free. <a href="/docs/guides/team" class="text-foreground underline underline-offset-4 hover:text-foreground">Invite them</a> and everyone deploys to the same servers. The <a href="/docs/guides/activity" class="text-foreground underline underline-offset-4 hover:text-foreground">activity log</a> shows who deployed, restored or changed what, from the web, the CLI, an agent or GitHub.
				}
				if ctxkeys.RenderConfig(ctx).Billing {
					@homeQuestion("How does the trial work?") {
						30 days with everything, no card. After that, moin is read-only until you subscribe. Your apps and backups keep running.
					}
					@homeQuestion("What is a workspace?") {
						Your team in moin: its servers, apps and people. One plan per workspace.
					}
					@homeQuestion("Do I pay per workspace?") {
						Yes, with unlimited servers, apps and teammates. Most teams need one.
					}
					@homeQuestion("Can I cancel?") {
						Any time, in one click. Your apps keep running on your servers.
					}
				}
			}
		</div>
	</section>
}

templ homeQuestion(question string) {
	@accordion.Item() {
		@accordion.Trigger(accordion.TriggerProps{Class: "items-center gap-6 rounded-none px-4 py-5 text-base font-semibold hover:no-underline sm:px-5 sm:py-6 **:data-[slot=accordion-trigger-icon]:hidden"}) {
			{ question }
			@icon.Plus(icon.Props{Class: "ml-auto size-5 shrink-0 text-muted-foreground transition-transform duration-200 group-aria-expanded/accordion-trigger:rotate-45"})
		}
		@accordion.Content(accordion.ContentProps{Class: "pb-0"}) {
			<p class="max-w-2xl px-4 pb-6 text-base leading-7 text-muted-foreground sm:px-5 sm:text-base">
				{ children... }
			</p>
		}
	}
}
