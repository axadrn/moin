package pages

import (
	"fmt"
	"sort"
	"strconv"
	"strings"

	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/service"
	"github.com/axadrn/moin/controlplane/internal/ui/components/status"
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
)

// OverviewView is the workspace at a glance: what needs you, the apps and
// the servers.
type OverviewView struct {
	Status  service.WorkspaceStatus
	Apps    []model.App
	Servers []model.Server
}

// Overview answers before it asks: "Everything runs." or what needs you,
// then every app and server, quiet unless something is wrong.
templ Overview(view OverviewView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@layouts.App("Overview") {
		@panelPage() {
			<header class="flex flex-col gap-1 pt-2">
				<h1 class="text-3xl font-semibold tracking-tight text-balance" data-overview-headline>{ overviewHeadline(view) }</h1>
				<p class="text-muted-foreground">{ overviewSummary(view.Status) }</p>
			</header>
			if len(view.Servers) == 0 {
				@overviewStart(basePath)
			} else {
				if !view.Status.OK() {
					@kit.Section("Needs you", nil) {
						@kit.List() {
							for _, issue := range view.Status.Issues {
								@kit.Row(basePath + issue.Path) {
									<span class={ "flex size-8 shrink-0 items-center justify-center rounded-full", overviewIssueTone(issue.Kind) } aria-hidden="true">
										@overviewIssueIcon(issue.Kind)
									</span>
									@kit.RowText(issue.Target, issue.Detail)
								}
							}
						}
					}
				}
				@kit.Section("Apps", overviewNewApp(basePath)) {
					if len(view.Apps) == 0 {
						@kit.List() {
							@kit.Row("") {
								@kit.RowText("No apps yet", "Deploy one from its folder with moin deploy, or pick one from the catalog.")
							}
						}
					} else {
						@kit.List() {
							for _, app := range overviewOrder(view.Apps) {
								@kit.Row(basePath + "/apps/" + app.Name) {
									@kit.RowText(app.Name, appNote(app))
									@appState(app)
								}
							}
						}
					}
				}
				if len(view.Status.Updates) > 0 {
					@kit.Section("Updates", nil) {
						@kit.List() {
							for _, update := range view.Status.Updates {
								@kit.Row(basePath + "/apps/" + update.App) {
									@kit.RowText(update.App, update.Name+" "+update.Version+" → "+update.Latest)
								}
							}
						}
					}
				}
				@kit.Section("Servers", nil) {
					@kit.List() {
						for _, server := range view.Servers {
							@kit.Row(basePath + "/servers/" + server.ID + "/security") {
								@kit.RowText(server.Name, serverNote(server))
								if !server.Online {
									@status.Status(status.Props{Kind: status.KindFailed, Chip: true}) {
										Offline
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

// overviewHeadline is the answer to "is everything OK?".
func overviewHeadline(view OverviewView) string {
	switch {
	case len(view.Servers) == 0:
		return "Let's ship your first app."
	case view.Status.OK():
		return "Everything runs."
	case len(view.Status.Issues) == 1:
		return view.Status.Issues[0].Target + " needs you."
	}
	return strconv.Itoa(len(view.Status.Issues)) + " things need you."
}

// overviewSummary is the one line under it.
func overviewSummary(s service.WorkspaceStatus) string {
	parts := []string{plural(s.Apps, "app", "apps"), plural(s.Servers, "server", "servers")}
	switch {
	case s.Databases == 0:
	case s.BackupsChecked == s.Databases:
		parts = append(parts, "every backup checked today")
	default:
		parts = append(parts, strconv.Itoa(s.BackupsChecked)+" of "+plural(s.Databases, "backup", "backups")+" checked today")
	}
	return strings.Join(parts, " · ")
}

// overviewOrder puts what needs you first, then what is deploying, then
// the rest by name.
func overviewOrder(apps []model.App) []model.App {
	rank := func(app model.App) int {
		switch {
		case app.LatestStatus == model.DeployFailed:
			return 0
		case app.LatestStatus == model.DeployRunning:
			return 1
		}
		return 2
	}
	ordered := append([]model.App(nil), apps...)
	sort.SliceStable(ordered, func(i, j int) bool {
		if rank(ordered[i]) != rank(ordered[j]) {
			return rank(ordered[i]) < rank(ordered[j])
		}
		return ordered[i].Name < ordered[j].Name
	})
	return ordered
}

// appNote is the second line of an app, only when there is something to say.
func appNote(app model.App) string {
	switch {
	case app.LatestNumber == 0:
		return "Not deployed yet"
	case app.LatestStatus == model.DeployRunning:
		return fmt.Sprintf("Deploying v%d", app.LatestNumber)
	case app.Stopped:
		return "Stopped"
	case app.LatestStatus == model.DeployFailed && app.LiveNumber > 0:
		return fmt.Sprintf("v%d failed, v%d still runs", app.LatestNumber, app.LiveNumber)
	case app.LatestStatus == model.DeployFailed:
		return fmt.Sprintf("v%d failed", app.LatestNumber)
	}
	return ""
}

// appState is the mark at the end of an app's row: a quiet dot when it
// runs, a word when it does not.
templ appState(app model.App) {
	switch {
		case app.LatestNumber == 0 || app.Stopped:
			@status.Status(status.Props{Kind: status.KindIdle, Chip: true}) {
				{ ifElse(app.Stopped, "Stopped", "New") }
			}
		case app.LatestStatus == model.DeployRunning:
			@status.Status(status.Props{Kind: status.KindRunning, Chip: true}) {
				Deploying
			}
		case app.LatestStatus == model.DeployFailed:
			@status.Status(status.Props{Kind: status.KindFailed, Chip: true}) {
				Failed
			}
		default:
			<span class="flex size-8 shrink-0 items-center justify-center" title="Live">
				@status.Symbol(status.KindLive)
				<span class="sr-only">Live</span>
			</span>
	}
}

func serverNote(server model.Server) string {
	if server.Online {
		return ""
	}
	return "Its apps may be down"
}

func ifElse(ok bool, yes, no string) string {
	if ok {
		return yes
	}
	return no
}

// overviewNewApp is the action next to the apps: start a new one.
templ overviewNewApp(basePath string) {
	<a href={ templ.SafeURL(basePath + "/apps") } class="rounded-full bg-muted px-3 py-1.5 text-sm font-medium hover:bg-muted/70">New app</a>
}

// overviewStart is the first visit: no server yet.
templ overviewStart(basePath string) {
	@kit.List() {
		@kit.Row(basePath + "/servers") {
			<span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-foreground text-background" aria-hidden="true">
				@icon.Server(icon.Props{Class: "size-5"})
			</span>
			@kit.RowText("Connect your first server", "Any Linux box you own. One command, no open port.")
		}
	}
}

templ overviewIssueIcon(kind string) {
	switch kind {
		case service.IssueServerDown:
			@icon.ServerOff(icon.Props{Class: "size-4"})
		case service.IssueDeployFailed:
			@icon.CircleX(icon.Props{Class: "size-4"})
		case service.IssueBackupFailed, service.IssueDrillFailed:
			@icon.ShieldOff(icon.Props{Class: "size-4"})
		case service.IssueDomainDown:
			@icon.Globe(icon.Props{Class: "size-4"})
		case service.IssueDiskFull:
			@icon.HardDrive(icon.Props{Class: "size-4"})
		default:
			@icon.RefreshCw(icon.Props{Class: "size-4"})
	}
}

// overviewIssueTone colors an issue: red for what is broken, amber for what
// waits.
func overviewIssueTone(kind string) string {
	if kind == service.IssueAgentBehind {
		return "bg-amber-500/15 text-amber-600 dark:text-amber-400"
	}
	return "bg-failed/12 text-failed"
}



