package pages

import (
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/ui/components/status"
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
)

// DevKit is the gallery: every part of the kit in every state, on one
// page, for development only (/app/{workspace}/dev/kit with APP_ENV=
// development). Check a part here once, in light and dark, at phone and
// desktop width, instead of on every page (DESIGN.md, Geometry).
templ DevKit() {
	{{ base := ctxkeys.AppBasePath(ctx) }}
	@layouts.App("Kit") {
		@panelPage() {
			@kit.Header(kit.Back{Label: "Settings", Href: base + "/settings"}, "Kit") {
				<div class="flex flex-wrap items-center gap-2 sm:ml-auto">
					@kit.Button(kit.Secondary, "", nil) {
						Secondary
					}
					@kit.Button(kit.Primary, "", nil) {
						Primary
					}
				</div>
			}
			@kit.Section("Buttons", nil) {
				@kit.Card("", nil) {
					<div class="flex flex-wrap items-center gap-2">
						@kit.Button(kit.Primary, "", nil) {
							Deploy
						}
						@kit.Button(kit.Secondary, "", nil) {
							Restart
						}
						@kit.Button(kit.Danger, "", nil) {
							Remove
						}
						@kit.Button(kit.Secondary, "", templ.Attributes{"disabled": true}) {
							Disabled
						}
						@kit.Button(kit.Primary, "", templ.Attributes{"data-done": true}) {
							Saved
						}
						@kit.Button(kit.Secondary, "", templ.Attributes{"data-done": true}) {
							Saved
						}
					</div>
				}
			}
			@kit.Section("Fields", nil) {
				@kit.Card("Domain", nil) {
					@kit.Field("Domain", "kit-domain", "") {
						@kit.Inline() {
							@kit.Input(templ.Attributes{"id": "kit-domain", "placeholder": "shop.example.com"})
							@kit.Button(kit.Primary, "", nil) {
								Add
							}
						}
					}
					@kit.Field("Wrong", "kit-wrong", "Not a domain.") {
						@kit.Input(templ.Attributes{"id": "kit-wrong", "value": "shop", "aria-invalid": "true"})
					}
					@kit.Field("Branch", "kit-branch", "") {
						@kit.Select(kit.SelectProps{ID: "kit-branch", Name: "branch", Label: "Branch", Options: []kit.Option{{Value: "main", Label: "main"}, {Value: "next", Label: "next"}}, Value: "main"})
					}
					@kit.Choice("kit-mode", "Mode", []kit.Option{{Value: "fields", Label: "Fields"}, {Value: "text", Label: "Text"}}, "fields")
					@kit.TextArea(templ.Attributes{"rows": "3", "placeholder": "KEY=value"})
				}
			}
			@kit.Section("Tabs", nil) {
				@kit.Segmented("kit-tabs", "Sections", []kit.Segment{{Label: "App", Href: "#", Active: true}, {Label: "Deploys", Href: "#", Key: "d"}, {Label: "Domains", Href: "#", Key: "o"}, {Label: "Logs", Href: "#", Key: "l"}})
			}
			@kit.Section("Rows that open", nil) {
				@kit.List() {
					@kit.Row("#") {
						@kit.RowText("A row that opens a page", "")
					}
					@kit.Row("#") {
						@kit.RowText("With a second line", "Only when there is something to say")
						<span class="text-sm text-muted-foreground">value</span>
					}
					@kit.RowExternal("https://example.com") {
						@kit.RowText("Another site", "In a new tab")
					}
					@kit.RowMore("2 more") {
						@kit.Row("") {
							@kit.RowText("Opened in place", "")
						}
						@kit.Row("#") {
							@kit.RowText("A row in it that opens", "")
						}
					}
				}
			}
			@kit.Section("Rows that do", nil) {
				@kit.List() {
					@kit.RowButton(false, nil) {
						<span class="font-medium">Back up now</span>
					}
					@kit.RowButton(true, nil) {
						<span class="font-medium">Remove</span>
					}
				}
			}
			@kit.Section("Rows that are picked", nil) {
				<form>
					@kit.List() {
						@kit.RowPick(templ.Attributes{"name": "kit-pick", "value": "a"}) {
							@kit.RowText("Nov 7, 09:00 UTC", "Hourly · 2.1 MB")
						}
						@kit.RowPick(templ.Attributes{"name": "kit-pick", "value": "b", "checked": true}) {
							@kit.RowText("Nov 7, 08:00 UTC", "Hourly · 2.0 MB")
						}
						@kit.RowPick(templ.Attributes{"name": "kit-pick", "value": "c"}) {
							@kit.RowText("Nov 6, 23:12 UTC", "By hand · 1.9 MB")
						}
					}
				</form>
			}
			@kit.Section("Rows that tell", nil) {
				@kit.List() {
					@kit.RowFact("Version", "") {
						v1.0.0
					}
					@kit.RowFact("Last 24 hours", "182 ms on average") {
						99.98%
					}
					@kit.Row("") {
						@kit.RowText("A row with its own parts", "Still, its lines stay")
					}
				}
			}
			@kit.Section("Rows that hold a control", nil) {
				@kit.List() {
					@kit.RowControl(nil) {
						@kit.RowLabel("kit-switch", "A switch", "")
						@kit.Switch(templ.Attributes{"id": "kit-switch", "checked": true})
					}
					@kit.RowControl(nil) {
						@kit.RowLabel("kit-switch-off", "Off, and one that cannot change", "")
						@kit.Switch(templ.Attributes{"id": "kit-switch-off"})
						@kit.Switch(templ.Attributes{"disabled": true, "aria-label": "Cannot change"})
					}
					@kit.RowForm(nil) {
						@kit.RowLabel("kit-provider", "Provider", "")
						<div class="w-36 shrink-0">
							@kit.Select(kit.SelectProps{ID: "kit-provider", Name: "provider", Label: "Provider", Options: []kit.Option{{Value: "nip.io", Label: "nip.io"}, {Value: "sslip.io", Label: "sslip.io"}}, Value: "nip.io"})
						</div>
					}
					@kit.RowForm(nil) {
						<div class="min-w-0 flex-1">
							@kit.Field("Add a domain", "kit-row-domain", "") {
								@kit.Inline() {
									@kit.Input(templ.Attributes{"id": "kit-row-domain", "placeholder": "shop.example.com"})
									@kit.Button(kit.Secondary, "", templ.Attributes{"type": "button"}) {
										Add
									}
								}
							}
						</div>
					}
				}
			}
			@kit.Section("Status", nil) {
				@kit.Card("", nil) {
					<div class="flex flex-wrap items-center gap-4">
						@status.Status(status.Props{Kind: status.KindLive, Chip: true}) {
							live v12
						}
						@status.Status(status.Props{Kind: status.KindRunning, Chip: true}) {
							deploying v13
						}
						@status.Status(status.Props{Kind: status.KindFailed, Chip: true}) {
							failed
						}
						@status.Status(status.Props{Kind: status.KindLive}) {
							online
						}
						@status.Status(status.Props{Kind: status.KindWaiting}) {
							waiting
						}
						@status.Status(status.Props{Kind: status.KindDone}) {
							v11
						}
						@status.Status(status.Props{Kind: status.KindIdle}) {
							not deployed yet
						}
					</div>
				}
			}
			@kit.Grid() {
				@kit.Card("A card", nil) {
					@kit.Quiet() {
						A fact, never a sentence about the UI.
					}
				}
				@kit.Card("With an action", devKitAction()) {
					@kit.Command("moin deploy shop")
				}
			}
			@kit.Section("Feedback", nil) {
				@kit.Card("", nil) {
					<div class="relative flex flex-wrap items-center gap-2 pb-14">
						@kit.Button(kit.Primary, "", nil) {
							Deploy
						}
						<p data-said="failed" style="top: 52px; left: 0">Deploy not started. The server is offline.</p>
					</div>
				}
			}
		}
	}
}

templ devKitAction() {
	@kit.Button(kit.Secondary, "", nil) {
		Edit
	}
}
