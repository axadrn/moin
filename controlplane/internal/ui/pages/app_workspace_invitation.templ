package pages

import (
	"github.com/axadrn/ops/controlplane/internal/brand"
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/ui/components/alert"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/card"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
	"github.com/axadrn/ops/controlplane/internal/ui/layouts"
)

templ WorkspaceInvitation(invitation *model.WorkspaceInvitation, errorMessage string) {
	{{ user := ctxkeys.User(ctx) }}
	@layouts.Auth(layouts.SEOProps{
		Title:       "Workspace invitation",
		Description: "Accept a workspace invitation",
		Path:        ctxkeys.URLPath(ctx),
	}) {
		<div class="flex min-h-screen items-center justify-center p-4">
			@card.Card(card.Props{Class: "w-full max-w-md"}) {
				@card.Header() {
					@card.Title(card.TitleProps{Class: "text-base font-semibold"}) {
						if invitation != nil {
							Join { invitation.WorkspaceName }
						} else {
							Invitation not available
						}
					}
					@card.Description() {
						if invitation != nil {
							{ invitation.InviterName } invited you as { model.WorkspaceRoleLabel(invitation.Role) }.
						} else {
							It expired, was revoked or was used already. Ask for a new one.
						}
					}
				}
				@card.Content(card.ContentProps{Class: "flex flex-col gap-6"}) {
					if errorMessage != "" {
						@alert.Alert(alert.Props{Class: "border-0 bg-failed/12 text-failed"}) {
							@icon.CircleAlert()
							@alert.Title(alert.TitleProps{Class: "font-normal"}) {
								{ errorMessage }
							}
						}
					}
					if invitation != nil && user != nil {
						<p class="text-sm text-muted-foreground">
							You are signed in as <span class="font-medium text-foreground">{ user.Email }</span>. The invitation is for <span class="font-medium text-foreground">{ invitation.Email }</span>; the two must match.
						</p>
						<form
							action={ templ.SafeURL(ctxkeys.URLPath(ctx)) }
							method="POST"
						>
							@csrf.Token()
							@button.Button(button.Props{Type: button.TypeSubmit, Class: "w-full"}) {
								Join { invitation.WorkspaceName }
							}
						</form>
					}
					@button.Button(button.Props{Href: "/", Variant: button.VariantGhost, Class: "w-full"}) {
						Back to { brand.Name }
					}
				}
			}
		</div>
	}
}
