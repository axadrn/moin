package pages

import (
	"strconv"

	"github.com/axadrn/ops/controlplane/internal/brand"
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/ui/blocks"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/field"
	"github.com/axadrn/ops/controlplane/internal/ui/components/input"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
	"github.com/axadrn/ops/controlplane/internal/ui/layouts"
)

templ AuthOnboarding(errorMsg string) {
	@layouts.Auth(layouts.SEOProps{Title: "Complete Your Profile", Description: "Tell us your name", Path: ctxkeys.URLPath(ctx)}) {
		@blocks.AuthShell(brand.Name) {
			@blocks.AuthCard("One last thing", "What should we call you?") {
				@field.Group() {
					@AuthOnboardingForm(errorMsg)
					@field.Separator() {
						Not you? 
					}
					<form
						action="/auth/logout"
						method="POST"
						hx-post="/auth/logout"
						hx-swap="none"
						hx-disable="find button[type='submit']"
					>
						@csrf.Token()
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Class: blocks.AuthSecondary}) {
							Sign out 
						}
					</form>
				}
			}
		}
	}
}

templ AuthOnboardingForm(errorMsg string) {
	{{ user := ctxkeys.User(ctx) }}
	<form
		id="onboarding-form"
		action="/auth/onboarding"
		method="POST"
		hx-post="/auth/onboarding"
		hx-target="#onboarding-form"
		hx-swap="outerHTML"
		hx-disable="find button[type='submit']"
	>
		@csrf.Token()
		@field.Group() {
			@field.Field() {
				@field.Label(field.LabelProps{For: "name"}) {
					Your name 
				}
				@input.Input(input.Props{ID: "name", Name: "name", Type: "text", Placeholder: "Ada Lovelace", Attributes: templ.Attributes{"aria-invalid": strconv.FormatBool(errorMsg != ""), "aria-describedby": "name-hint", "autocomplete": "name", "autofocus": ""}})
				@fieldHint("name", errorMsg) {
					if user != nil {
						Continue as <strong>{ user.Email }</strong>.
					}
				}
			}
			@button.Button(button.Props{Type: button.TypeSubmit, Class: blocks.AuthPrimary}) {
				Continue 
			}
		}
	</form>
}
