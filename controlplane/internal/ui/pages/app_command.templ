package pages

import (
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/service"
	commandmenu "github.com/axadrn/moin/controlplane/internal/ui/components/command"
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
)

// CommandItemsView is what ⌘K lists past the pages: the workspace's apps,
// servers and buckets.
type CommandItemsView struct {
	Apps    []model.App
	Servers []model.Server
	Buckets []service.Bucket
	// CanChange says the member may deploy, restart and roll back.
	CanChange bool
}

// CommandItems are the groups ⌘K loads on its first open: each app to jump
// to, with its actions, then the servers and the buckets.
templ CommandItems(view CommandItemsView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	if len(view.Apps) > 0 {
		@commandmenu.Group(commandmenu.GroupProps{Heading: "Apps"}) {
			for _, app := range view.Apps {
				@commandmenu.Item(commandmenu.ItemProps{Value: "app " + app.Name, Attributes: templ.Attributes{"data-href": basePath + "/apps/" + app.Name}}) {
					@icon.Box()
					<span class="truncate">{ app.Name }</span>
					<span class="ml-auto truncate text-xs text-muted-foreground">{ app.ServerName }</span>
				}
			}
		}
		if view.CanChange {
			@commandmenu.Group(commandmenu.GroupProps{Heading: "Actions"}) {
				for _, app := range view.Apps {
					if app.LatestNumber > 0 {
						@commandAction(basePath+"/apps/"+app.Name+"/redeploy", "Deploy "+app.Name, "Build the newest source of "+app.Name+" again and release it?", "Deploy", icon.Rocket)
						@commandAction(basePath+"/apps/"+app.Name+"/restart", "Restart "+app.Name, "Start the live release of "+app.Name+" again? No build, the env and domains as they are now.", "Restart", icon.RotateCw)
					}
					if app.LiveNumber > 1 {
						@commandAction(basePath+"/apps/"+app.Name+"/rollback", "Roll back "+app.Name, "Release the version of "+app.Name+" before the live one again?", "Roll back", icon.Undo2)
					}
				}
			}
		}
	}
	if len(view.Servers) > 0 {
		@commandmenu.Group(commandmenu.GroupProps{Heading: "Servers"}) {
			for _, server := range view.Servers {
				@commandmenu.Item(commandmenu.ItemProps{Value: "server " + server.Name, Attributes: templ.Attributes{"data-href": basePath + "/servers/" + server.ID + "/security"}}) {
					@icon.Server()
					<span class="truncate">{ server.Name }</span>
				}
			}
		}
	}
	if len(view.Buckets) > 0 {
		@commandmenu.Group(commandmenu.GroupProps{Heading: "Buckets"}) {
			for _, bucket := range view.Buckets {
				@commandmenu.Item(commandmenu.ItemProps{Value: "bucket " + bucket.Name, Attributes: templ.Attributes{"data-href": basePath + "/bucket"}}) {
					@icon.Archive()
					<span class="truncate">{ bucket.Name }</span>
				}
			}
		}
	}
}

// commandAction is an action on an app: picking it asks with the confirm
// dialog, then posts like the button on the app page.
templ commandAction(path, label, question, accept string, glyph func(...icon.Props) templ.Component) {
	@commandmenu.Item(commandmenu.ItemProps{Value: label, Attributes: templ.Attributes{"data-command-action": true}}) {
		@glyph()
		<span class="truncate">{ label }</span>
		<button type="button" class="hidden" data-command-run data-confirm-action={ accept } hx-post={ path } hx-swap="none" hx-confirm={ question } tabindex="-1" aria-hidden="true"></button>
	}
}
