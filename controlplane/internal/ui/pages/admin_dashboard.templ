package pages

import (
	"fmt"
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/ui/components/badge"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/components/inputgroup"
	"github.com/axadrn/ops/controlplane/internal/ui/components/item"
	"github.com/axadrn/ops/controlplane/internal/ui/components/pagination"
	"github.com/axadrn/ops/controlplane/internal/ui/components/table"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
	"github.com/axadrn/ops/controlplane/internal/ui/layouts"
	"net/url"
	"strconv"
)

templ AdminDashboard(data *model.AdminDashboard) {
	@layouts.Admin("Admin") {
		@AdminDashboardContent(data)
	}
}

templ AdminDashboardContent(data *model.AdminDashboard) {
	{{ currentUser := ctxkeys.User(ctx) }}
	<div id="admin-content" class="flex flex-col gap-6" hx-swap-oob="true">
		@pageHeader("Admin", "Users, workspaces, sessions and operator activity.") {
			@button.Button(button.Props{Href: "/admin/waitlist", Variant: button.VariantSecondary}) {
				Waitlist
			}
		}
		<dl class="grid grid-cols-2 items-stretch gap-4 lg:grid-cols-5">
			@statCard("Users", strconv.Itoa(data.Metrics.Users), "")
			@statCard("Verified", strconv.Itoa(data.Metrics.VerifiedUsers), "")
			@statCard("Workspaces", strconv.Itoa(data.Metrics.Workspaces), "")
			@statCard("Paid", strconv.Itoa(data.Metrics.PaidWorkspaces), "")
			@statCard("Sessions", strconv.Itoa(data.Metrics.ActiveSessions), "")
		</dl>
		@panel(panelProps{Title: "Users", Description: "Search accounts, revoke access, or inspect the product as a user."}) {
			<div class="flex flex-col gap-6">
				<form
					method="GET"
					action="/admin"
					class="flex gap-2"
				>
					@inputgroup.InputGroup(inputgroup.Props{Class: "max-w-md flex-1"}) {
						@inputgroup.Addon() {
							@icon.Search()
						}
						@inputgroup.Input(inputgroup.InputProps{Name: "q", Value: data.Users.Query, Placeholder: "Search name or email"})
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
						Search
					}
				</form>
				<div class="-mx-6">
					@table.Table() {
						@table.Header() {
							@table.Row() {
								@table.Head(table.HeadProps{Class: "px-4 first:pl-6"}) {
									User 
								}
								@table.Head(table.HeadProps{Class: "px-4 first:pl-6"}) {
									Status 
								}
								@table.Head(table.HeadProps{Class: "px-4 first:pl-6"}) {
									Workspaces 
								}
								@table.Head(table.HeadProps{Class: "px-4 first:pl-6"}) {
									Sessions 
								}
								@table.Head(table.HeadProps{Class: "px-4 pr-6 text-right"}) {
									Actions 
								}
							}
						}
						@table.Body() {
							for _, user := range data.Users.Users {
								@table.Row() {
									@table.Cell(table.CellProps{Class: "px-4 py-3 first:pl-6 last:pr-6"}) {
										<div class="font-medium">{ user.Name }</div>
										<div class="text-muted-foreground">{ user.Email }</div>
									}
									@table.Cell(table.CellProps{Class: "px-4 py-3 first:pl-6 last:pr-6"}) {
										<div class="flex flex-wrap gap-1.5">
											if user.EmailVerifiedAt != nil {
												@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
													Verified 
												}
											} else {
												@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
													Unverified 
												}
											}
											if user.IsAdmin {
												@badge.Badge() {
													Operator 
												}
											}
										</div>
									}
									@table.Cell(table.CellProps{Class: "px-4 py-3 first:pl-6 last:pr-6"}) {
										{ strconv.Itoa(user.WorkspaceCount) }
									}
									@table.Cell(table.CellProps{Class: "px-4 py-3 first:pl-6 last:pr-6"}) {
										{ strconv.Itoa(user.ActiveSessionCount) }
									}
									@table.Cell(table.CellProps{Class: "px-4 py-3 first:pl-6 last:pr-6"}) {
										<div class="flex justify-end gap-2">
											if currentUser.ID != user.ID {
												<form
													method="POST"
													action={ templ.SafeURL("/admin/users/" + user.ID + "/sessions/revoke") }
													hx-post={ "/admin/users/" + user.ID + "/sessions/revoke" }
													hx-swap="none"
													hx-confirm="Revoke every active session for this user?"
													hx-disable="find button[type='submit']"
												>
													@csrf.Token()
													<input type="hidden" name="q" value={ data.Users.Query }/>
													<input type="hidden" name="page" value={ strconv.Itoa(data.Users.Page) }/>
													@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Size: button.SizeSm}) {
														Revoke sessions 
													}
												</form>
											}
											if currentUser.ID != user.ID && !user.IsAdmin {
												<form
													method="POST"
													action={ templ.SafeURL("/admin/users/" + user.ID + "/impersonate") }
													hx-post={ "/admin/users/" + user.ID + "/impersonate" }
													hx-swap="none"
													hx-disable="find button[type='submit']"
												>
													@csrf.Token()
													@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
														@icon.Eye(icon.Props{Class: "size-4"})
														View as user
													}
												</form>
											}
										</div>
									}
								}
							}
						}
					}
				</div>
				<div class="flex items-center justify-between text-sm text-muted-foreground">
					<span>{ plural(data.Users.TotalUsers, "user", "users") }</span>
					@pagination.Pagination(pagination.Props{Class: "mx-0 w-auto"}) {
						@pagination.Content() {
							@pagination.Item() {
								@pagination.Previous(pagination.PreviousProps{Href: adminPageURL(data.Users.Query, data.Users.Page-1), Disabled: data.Users.Page <= 1})
							}
							@pagination.Item(pagination.ItemProps{Class: "px-2"}) {
								{ fmt.Sprintf("Page %d of %d", data.Users.Page, data.Users.TotalPages) }
							}
							@pagination.Item() {
								@pagination.Next(pagination.NextProps{Href: adminPageURL(data.Users.Query, data.Users.Page+1), Disabled: data.Users.Page >= data.Users.TotalPages})
							}
						}
					}
				</div>
			</div>
		}
		@panel(panelProps{Title: "Operator activity", Description: "Security, workspace deletion, and subscription events, kept for 180 days."}) {
				if len(data.Events) == 0 {
					@emptyHint("Nothing yet. Security and administrative events show up here.", "")
				} else {
					@item.Group(item.GroupProps{Class: "gap-2"}) {
						for _, event := range data.Events {
							@item.Item(item.Props{Size: item.SizeSm}) {
								@item.Content() {
									@item.Title() {
										{ model.AdminAuditActionLabel(event.Action) }
									}
									@item.Description() {
										if event.ActorEmail != "" {
											{ event.ActorEmail }
										} else {
											System
										}
										<span>· { event.TargetType } { event.TargetID }</span>
									}
								}
								@item.Actions() {
									<time class="text-sm text-muted-foreground">{ event.CreatedAt.Local().Format("Jan 2, 2006 at 15:04") }</time>
								}
							}
						}
					}
				}
		}
	</div>
}

func adminPageURL(query string, page int) string {
	values := url.Values{}
	if query != "" {
		values.Set("q", query)
	}
	values.Set("page", strconv.Itoa(page))
	return "/admin?" + values.Encode()
}
