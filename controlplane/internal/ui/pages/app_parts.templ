package pages

import (
	"fmt"
	"github.com/axadrn/moin/controlplane/internal/ui/components/alert"
	"github.com/axadrn/moin/controlplane/internal/ui/components/card"
	"github.com/axadrn/moin/controlplane/internal/ui/components/empty"
	"github.com/axadrn/moin/controlplane/internal/ui/components/field"
	"github.com/axadrn/moin/controlplane/internal/ui/utils"
	"time"

	"github.com/axadrn/moin/controlplane/internal/ui/components/button"
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
)

// The parts every page of the control panel is built from.

// panelPage is the width and the gutters of a page. It stacks its children
// 24 px apart, so sections never bring margins of their own.
templ panelPage(attrs ...templ.Attributes) {
	{{ var a templ.Attributes }}
	if len(attrs) > 0 {
		{{ a = attrs[0] }}
	}
	<div class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 pt-6 pb-20 sm:px-6 lg:px-8" { a... }>
		{ children... }
	</div>
}

// pageHeader is the title of a page, its one line, and its actions
// (children) right aligned, below on phones.
templ pageHeader(title, description string) {
	@statusHeader(title, nil, description) {
		{ children... }
	}
}

// statusHeader is the header of a page about one thing, a server or an
// app: its name with its status chip, one line and the actions (children).
templ statusHeader(title string, chip templ.Component, description string) {
	<header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
		<div class="min-w-0">
			<div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-2">
				<h1 class="truncate text-3xl font-bold tracking-tight">{ title }</h1>
				if chip != nil {
					@chip
				}
			</div>
			if description != "" {
				<p class="mt-1 max-w-2xl text-sm text-pretty text-muted-foreground">{ description }</p>
			}
		</div>
		<div class="flex flex-wrap items-center gap-2 empty:hidden">
			{ children... }
		</div>
	</header>
}

// tabNav is a row of tabs, a segmented control of plain links (tabLink),
// one per page.
templ tabNav(label string) {
	<nav class="flex h-9 w-full max-w-full items-center gap-1 overflow-x-auto rounded-full bg-muted p-1 [scrollbar-width:none] sm:w-fit" aria-label={ label }>
		{ children... }
	</nav>
}

// tabLink is one tab of a tabNav; the active one is the current page.
templ tabLink(href, label string, active bool, attrs templ.Attributes) {
	<a
		href={ templ.SafeURL(href) }
		class={ "flex h-full flex-1 shrink-0 items-center justify-center rounded-full px-3 text-sm sm:px-4 font-medium whitespace-nowrap transition-colors outline-none focus-visible:ring-2 focus-visible:ring-ring sm:flex-none",
			templ.KV("bg-background text-foreground shadow-sm", active),
			templ.KV("text-muted-foreground hover:text-foreground", !active) }
		if active {
			aria-current="page"
		}
		{ attrs... }
	>{ label }</a>
}

// sectionTitle heads a block of a page outside a card.
templ sectionTitle(title string) {
	<h2 class="text-base font-semibold">{ title }</h2>
}

// panelBody is how the body of a panel sits in its card.
type panelBody string

const (
	// panelBodyText pads text and forms like the header.
	panelBodyText panelBody = ""
	// panelBodyRows leaves 12 px; rows bring px-3, so their text lines up
	// with the title.
	panelBodyRows panelBody = "rows"
	// panelBodyFlush runs logs and tables from edge to edge.
	panelBodyFlush panelBody = "flush"
)

// panelProps is a card of a page: its title, one line, one action and how
// its body sits.
type panelProps struct {
	// ID is the card's id; Heading the id of its title, for aria-labelledby.
	ID          string
	Heading     string
	Title       string
	Description string
	// Action is the one small control right of the title.
	Action templ.Component
	// Docs is the docs page, with its anchor, that explains the panel: a
	// "How it works" link right of the title, before the Action.
	Docs  string
	Body   panelBody
	Class  string
	Attrs  templ.Attributes
}

// panel is a card with a title: one topic of a page.
templ panel(p panelProps) {
	{{ attrs := templ.Attributes{"role": "region"} }}
	for k, v := range p.Attrs {
		{{ attrs[k] = v }}
	}
	if p.Heading != "" {
		{{ attrs["aria-labelledby"] = p.Heading }}
	}
	@card.Card(card.Props{ID: p.ID, Class: utils.CN("h-full min-w-0", p.Class), Attributes: attrs}) {
		@card.Header(card.HeaderProps{Class: panelHeaderStack}) {
			@card.Title(card.TitleProps{ID: p.Heading, Class: "flex min-w-0 items-center gap-2 text-base font-semibold", Attributes: templ.Attributes{"role": "heading", "aria-level": "2"}}) {
				{ p.Title }
			}
			if p.Description != "" {
				@card.Description() {
					{ p.Description }
				}
			}
			if p.Action != nil || p.Docs != "" {
				@card.Action(card.ActionProps{Class: utils.CN("flex flex-wrap items-center gap-1", panelActionStack)}) {
					if p.Docs != "" {
						@docsLink(p.Docs, "How it works")
					}
					if p.Action != nil {
						@p.Action
					}
				}
			}
		}
		@card.Content(card.ContentProps{Class: panelBodyClass(p.Body)}) {
			{ children... }
		}
	}
}

func panelBodyClass(body panelBody) string {
	switch body {
	case panelBodyRows:
		return "min-w-0 px-3"
	case panelBodyFlush:
		return "flex min-h-0 min-w-0 flex-1 flex-col px-0"
	}
	return "min-w-0"
}

// statGrid is a row of up to four statCards of the same height.
templ statGrid(attrs ...templ.Attributes) {
	{{ var a templ.Attributes }}
	if len(attrs) > 0 {
		{{ a = attrs[0] }}
	}
	<dl class="grid grid-cols-2 items-stretch gap-4 lg:grid-cols-4" { a... }>
		{ children... }
	</dl>
}

// statCard is a number with its label and a small note. An empty value
// shows as a muted dash. Children add lines below the note.
templ statCard(label, value, note string, attrs ...templ.Attributes) {
	{{ var a templ.Attributes }}
	if len(attrs) > 0 {
		{{ a = attrs[0] }}
	}
	@card.Card(card.Props{Class: "h-full min-w-0 gap-1 px-6", Attributes: a}) {
		<dt class="truncate text-sm text-muted-foreground">{ label }</dt>
		<dd class="min-w-0">
			if value != "" {
				<span class="block truncate text-2xl font-semibold tracking-tight tabular-nums">{ value }</span>
			} else {
				<span class="block text-2xl font-semibold tracking-tight text-muted-foreground">—</span>
			}
			if note != "" {
				<span class="mt-1 block text-xs text-muted-foreground">{ note }</span>
			}
			{ children... }
		</dd>
	}
}

// panelActionStack puts a card's actions under its title and description on
// phones, so the description keeps the full width.
const panelHeaderStack = "max-sm:has-data-[slot=card-action]:grid-cols-1"

const panelActionStack = "max-sm:col-start-1 max-sm:row-span-1 max-sm:row-start-auto max-sm:justify-self-start max-sm:pt-2"

// dangerPanel is the last card of a page: one destructive action (children),
// what it does and the docs section, with its anchor, that explains it.
templ dangerPanel(title, body, docs string) {
	@card.Card(card.Props{Class: "min-w-0"}) {
		@card.Header(card.HeaderProps{Class: panelHeaderStack}) {
			@card.Title(card.TitleProps{Class: "text-base font-semibold", Attributes: templ.Attributes{"role": "heading", "aria-level": "2"}}) {
				{ title }
			}
			@card.Description() {
				{ body }
			}
			@card.Action(card.ActionProps{Class: utils.CN("flex flex-wrap items-center gap-2", panelActionStack)}) {
				@docsLink(docs, "How it works")
				{ children... }
			}
		}
	}
}

// command is a command to copy: a prompt, the command, a copy button.
templ command(cmd string) {
	<div class="group/cmd flex h-10 max-w-full min-w-0 items-center gap-2.5 rounded-full bg-muted pr-1 pl-4 text-left font-mono text-xs">
		<span class="text-muted-foreground select-none" aria-hidden="true">$</span>
		<code class="min-w-0 flex-1 truncate">{ cmd }</code>
		@copyButton(cmd, "", "Copy command")
	</div>
}

// copyButton copies value, or the text of the element target selects.
templ copyButton(value, target, label string) {
	{{ attrs := templ.Attributes{"data-copy": value, "aria-label": label, "title": label} }}
	if target != "" {
		{{ attrs["data-copy-target"] = target }}
	}
	@button.Button(button.Props{
		Variant:    button.VariantGhost,
		Size:       button.SizeIconSm,
		Class:      "group/copy text-muted-foreground hover:bg-foreground/10 hover:text-foreground focus-visible:ring-ring focus-visible:ring-offset-0",
		Attributes: attrs,
	}) {
		@icon.Copy(icon.Props{Class: "size-3.5 group-data-copied/copy:hidden"})
		@icon.Check(icon.Props{Class: "hidden size-3.5 text-live group-data-copied/copy:block"})
	}
}

// fieldHint is the line under a field of a form with labels above its
// fields: the hint (children, may be empty), or the message when the field
// is wrong (DESIGN.md, Feedback). The line is there from the start, so a
// message only swaps text; err shows one the page renders with, the
// moin:invalid event of a handler one it answers with. The field points at
// it with aria-describedby id-hint.
templ fieldHint(id, err string) {
	@field.Description(field.DescriptionProps{
		ID:         id + "-hint",
		Class:      "group/hint min-h-4 text-xs leading-4",
		Attributes: templ.Attributes{"data-field-hint": id, "data-invalid": err != "", "aria-live": "polite"},
	}) {
		<span class="group-data-invalid/hint:hidden">
			{ children... }
		</span>
		<span data-hint-error class="hidden text-failed group-data-invalid/hint:inline">{ err }</span>
	}
}

// stateAlert is a state that lasts while the page is open, like data that
// could not be read (DESIGN.md, Feedback). It renders with the page or the
// panel it is about, never as the answer to a click.
templ stateAlert(attrs templ.Attributes) {
	@alert.Alert(alert.Props{Class: "border-0 bg-failed/12 text-failed", Attributes: attrs}) {
		@icon.CircleAlert()
		@alert.Title(alert.TitleProps{Class: "font-medium"}) {
			{ children... }
		}
	}
}

// docsLink is the quiet link from a card to its guide.
templ docsLink(href, label string) {
	@button.Button(button.Props{Href: href, Variant: button.VariantSecondary, Size: button.SizeSm}) {
		@icon.BookOpen(icon.Props{Class: "size-3.5"})
		{ label }
	}
}

// emptyState is a card that says what is missing, what makes it appear
// and the command that adds it.
templ emptyState(title, body, cmd string) {
	{{ var bodyText templ.Component }}
	if body != "" {
		{{ bodyText = plainText(body) }}
	}
	@emptyStateWith(title, bodyText, cmd) {
		{ children... }
	}
}

templ plainText(text string) {
	{ text }
}

// emptyStateWith is emptyState with a body that has markup, like a path.
templ emptyStateWith(title string, body templ.Component, cmd string) {
	@card.Card(card.Props{Class: "min-w-0"}) {
		@empty.Empty(empty.Props{Class: "gap-4 p-6 sm:p-10"}) {
			@empty.Header(empty.HeaderProps{Class: "max-w-md gap-1"}) {
				@empty.Title(empty.TitleProps{Class: "text-base font-semibold"}) {
					{ title }
				}
				if body != nil {
					@empty.Description(empty.DescriptionProps{Class: "text-sm text-pretty"}) {
						@body
					}
				}
			}
			if cmd != "" {
				@empty.Content(empty.ContentProps{Class: "max-w-xs items-stretch"}) {
					@command(cmd)
				}
			}
			{ children... }
		}
	}
}

// emptyHint is the empty state inside a card that already has a title: one
// muted sentence and the command that fills it.
templ emptyHint(text, cmd string) {
	<div class="flex flex-col items-start gap-3">
		<p class="text-sm text-muted-foreground">{ text }</p>
		if cmd != "" {
			<div class="w-full max-w-sm">
				@command(cmd)
			</div>
		}
	</div>
}

// panelClasses turn a card into a panel of the control panel: the card's
// look without its padding, the content brings its own. Kept for pages not
// yet on panel; new code uses panel.
const panelClasses = "block gap-0 py-0 text-base"

// ago is how long ago t was, short: "now", "4m ago", "3h ago", "12d ago".
func ago(t time.Time, now time.Time) string {
	age := now.Sub(t)
	switch {
	case age < 45*time.Second:
		return "just now"
	case age < time.Hour:
		return fmt.Sprintf("%dm ago", max(1, int(age.Minutes()+0.5)))
	case age < 48*time.Hour:
		return fmt.Sprintf("%dh ago", int(age.Hours()))
	case age < 60*24*time.Hour:
		return fmt.Sprintf("%dd ago", int(age.Hours()/24))
	}
	return t.Format("Jan 2, 2006")
}

// took is the length of a deploy: "14s", "1m 05s".
func took(start time.Time, end *time.Time) string {
	if end == nil {
		return ""
	}
	d := end.Sub(start).Round(time.Second)
	if d < time.Minute {
		return fmt.Sprintf("%ds", max(0, int(d.Seconds())))
	}
	return fmt.Sprintf("%dm %02ds", int(d.Minutes()), int(d.Seconds())%60)
}

func stamp(t time.Time) string {
	return t.UTC().Format("Jan 2, 2006 15:04:05 UTC")
}
