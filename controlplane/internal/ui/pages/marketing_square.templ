package pages

// homeSquare is the still wall of containers under the headline: every
// container is an app, your-app among them in ink. Some containers are
// pulled out of the wall by one of three steps; light from the top right
// gives them shaded sides and a shadow down to the left, as long as they
// stand out.
templ homeSquare() {
	<svg
		viewBox={ "0 0 " + squareN(squareW) + " " + squareN(squareH) }
		preserveAspectRatio="xMidYMax slice"
		class="block h-full w-full select-none"
		role="img"
		aria-label="A wall of shipping containers, each an app: postgres, redis, node, python and your-app. Some stand out of the wall."
	>
		<defs>
			<clipPath id="square-wall">
				for _, b := range squareBoxes {
					if b.Depth == 0 {
						<rect x={ squareN(b.X) } y={ squareN(b.Y) } width={ squareN(squareBox) } height={ squareN(squareBox) }></rect>
					}
				}
			</clipPath>
			<linearGradient id="square-shade" x1="1" y1="0" x2="0" y2="1">
				<stop offset="0" stop-color="#000" class="[stop-opacity:0.28] dark:[stop-opacity:0.7]"></stop>
				<stop offset="1" stop-color="#000" stop-opacity="0"></stop>
			</linearGradient>
		</defs>
		for _, b := range squareBoxes {
			if b.Depth == 0 {
				@squareContainer(b.X, b.Y, b.Tone, b.Ink)
				@squareLabel(b.X, b.Y, b.Ref, b.Ink)
			}
		}
		<g clip-path="url(#square-wall)" fill="url(#square-shade)">
			for _, b := range squareBoxes {
				if b.Depth > 0 {
					<polygon points={ squareShadow(b.X, b.Y, b.Depth) }></polygon>
				}
			}
		</g>
		for _, b := range squareBoxes {
			if b.Depth > 0 {
				<polygon points={ squareSideLeft(b.X, b.Y, b.Depth) } class={ squareTone(b.Tone) }></polygon>
				<polygon points={ squareSideLeft(b.X, b.Y, b.Depth) } class="fill-black/25 dark:fill-black/55"></polygon>
				<polygon points={ squareSideBottom(b.X, b.Y, b.Depth) } class={ squareTone(b.Tone) }></polygon>
				<polygon points={ squareSideBottom(b.X, b.Y, b.Depth) } class="fill-black/40 dark:fill-black/70"></polygon>
				@squareContainer(b.X+b.Depth, b.Y-b.Depth, b.Tone, b.Ink)
				@squareLabel(b.X+b.Depth, b.Y-b.Depth, b.Ref, b.Ink)
			}
		}
	</svg>
}

// squareContainer is one container, kept simple: a steel face and its
// ribs. ink draws it in the foreground color.
templ squareContainer(x, y int, tone string, ink bool) {
	if ink {
		<rect x={ squareN(x) } y={ squareN(y) } width={ squareN(squareBox) } height={ squareN(squareBox) } class="fill-foreground"></rect>
	} else {
		<rect x={ squareN(x) } y={ squareN(y) } width={ squareN(squareBox) } height={ squareN(squareBox) } class={ squareTone(tone) }></rect>
		if tone == "c" {
			<rect x={ squareN(x) } y={ squareN(y) } width={ squareN(squareBox) } height={ squareN(squareBox) } class="fill-foreground/[0.08]"></rect>
		}
	}
	<g class={ templ.KV("fill-background/[0.16]", ink), templ.KV("fill-foreground/[0.09]", !ink) }>
		for _, r := range squareRibs(x) {
			<rect x={ squareN(r) } y={ squareN(y + 4) } width="3" height={ squareN(squareBox - 8) }></rect>
		}
	</g>
}

// squareLabel is the app stencilled on a container, if it carries one.
templ squareLabel(x, y int, ref string, ink bool) {
	if ref != "" {
		<text x={ squareN(x + 8) } y={ squareN(y + squareBox - 12) } class={ "font-mono text-[18px] font-bold tracking-[-0.02em]", templ.KV("fill-background", ink), templ.KV("fill-foreground/80", !ink) }>{ ref }</text>
	}
}
