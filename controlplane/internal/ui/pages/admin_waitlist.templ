package pages

import (
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/checkbox"
	"github.com/axadrn/ops/controlplane/internal/ui/components/input"
	"github.com/axadrn/ops/controlplane/internal/ui/components/status"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
	"github.com/axadrn/ops/controlplane/internal/ui/layouts"
)

// AdminWaitlist lists who waits for hosted ops and who is in. Letting
// someone in sends them a sign-in email; their first workspace gets
// everything without a payment.
templ AdminWaitlist(entries []model.WaitlistEntry) {
	@layouts.Admin("Waitlist") {
		<div class="flex flex-col gap-6" data-waitlist-page>
			@pageHeader("Waitlist", "Who waits for the private beta, and who is in.") {
				@button.Button(button.Props{Href: "/admin", Variant: button.VariantSecondary}) {
					Admin
				}
			}
			@panel(panelProps{Title: "Let someone in", Description: "Anyone, on the list or not. They get an email with the sign-in link."}) {
					<form method="POST" action="/admin/waitlist" class="flex flex-wrap items-center gap-3" hx-post="/admin/waitlist" hx-target="[data-waitlist-page]" hx-select="[data-waitlist-page]" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-let-in-form>
						@csrf.Token()
						<label for="let-in-email" class="sr-only">Email</label>
						@input.Input(input.Props{ID: "let-in-email", Name: "email", Type: "email", Placeholder: "name@example.com", Class: "max-w-sm", Attributes: templ.Attributes{"required": true}})
						<label class="flex cursor-pointer items-center gap-2 text-sm">
							@checkbox.Checkbox(checkbox.Props{Name: "forever_free", Value: "true"})
							Free forever
						</label>
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							Let in
						}
					</form>
			}
			@panel(panelProps{Title: "People", Description: plural(len(entries), "person", "people") + ". Waiting first, then who is in.", Body: panelBodyRows}) {
					<ul class="flex flex-col gap-1" role="list">
						for _, entry := range entries {
							<li data-waitlist-entry={ entry.Email } class="flex flex-wrap items-center justify-between gap-3 rounded-xl px-3 py-2.5 hover:bg-muted/60">
									<div class="min-w-0">
										<p class="truncate text-sm font-medium">{ entry.Email }</p>
										<p class="text-xs text-muted-foreground">
											joined { entry.CreatedAt.Format("2006-01-02") }
											if entry.LetInAt != nil {
												· in since { entry.LetInAt.Format("2006-01-02") }
											}
											if entry.ForeverFree {
												· free forever
											}
										</p>
									</div>
									if entry.LetInAt == nil {
										<form method="POST" action="/admin/waitlist" class="flex items-center gap-3" hx-post="/admin/waitlist" hx-target="[data-waitlist-page]" hx-select="[data-waitlist-page]" hx-swap="outerHTML" hx-disable="find button[type='submit']">
											@csrf.Token()
											<input type="hidden" name="email" value={ entry.Email }/>
											<label class="flex cursor-pointer items-center gap-2 text-xs text-muted-foreground">
												@checkbox.Checkbox(checkbox.Props{Name: "forever_free", Value: "true"})
												Free forever
											</label>
											@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Size: button.SizeSm}) {
												Let in
											}
										</form>
									} else {
										@status.Status(status.Props{Kind: status.KindLive}) {
											in
										}
									}
							</li>
						}
						if len(entries) == 0 {
							<li class="px-3 py-2.5 text-sm text-muted-foreground">Nobody waits yet.</li>
						}
					</ul>
			}
		</div>
	}
}
