package pages

import (
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/card"
	"github.com/axadrn/ops/controlplane/internal/ui/components/input"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
	"github.com/axadrn/ops/controlplane/internal/ui/layouts"
)

// AdminWaitlist lists who waits for hosted ops and who is in. Letting
// someone in sends them a sign-in email; their first workspace gets
// everything without a payment.
templ AdminWaitlist(entries []model.WaitlistEntry, notice string) {
	@layouts.Admin("Waitlist") {
		<div class="space-y-8" data-waitlist-page>
			<div>
				<h1 class="text-2xl font-bold tracking-tight sm:text-[1.75rem] sm:leading-9">Waitlist</h1>
				<p class="mt-1 text-sm text-muted-foreground">Who waits for the private beta, and who is in. <a href="/admin" class="underline-offset-4 hover:underline">Back to admin</a></p>
			</div>
			if notice != "" {
				<p class="rounded-2xl bg-live/12 px-5 py-3.5 text-sm font-medium text-live" role="status" data-waitlist-notice>{ notice }</p>
			}
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Let someone in
					}
					@card.Description() {
						Anyone, on the list or not. They get an email with the sign-in link.
					}
				}
				@card.Content() {
					<form method="POST" action="/admin/waitlist" class="flex flex-wrap items-center gap-3" data-let-in-form>
						@csrf.Token()
						@input.Input(input.Props{Name: "email", Type: "email", Placeholder: "name@example.com", Class: "max-w-sm", Attributes: templ.Attributes{"required": true}})
						<label class="flex items-center gap-2 text-sm">
							<input type="checkbox" name="forever_free" value="true"/>
							Free forever
						</label>
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							Let in
						}
					</form>
				}
			}
			@card.Card() {
				@card.Content() {
					<ul class="divide-y divide-border" role="list">
						for _, entry := range entries {
							<li class="flex flex-wrap items-center justify-between gap-3 py-3" data-waitlist-entry={ entry.Email }>
								<div class="min-w-0">
									<p class="truncate font-medium">{ entry.Email }</p>
									<p class="text-xs text-muted-foreground">
										joined { entry.CreatedAt.Format("2006-01-02") }
										if entry.LetInAt != nil {
											· in since { entry.LetInAt.Format("2006-01-02") }
										}
										if entry.ForeverFree {
											· free forever
										}
									</p>
								</div>
								if entry.LetInAt == nil {
									<form method="POST" action="/admin/waitlist" class="flex items-center gap-3">
										@csrf.Token()
										<input type="hidden" name="email" value={ entry.Email }/>
										<label class="flex items-center gap-2 text-xs text-muted-foreground">
											<input type="checkbox" name="forever_free" value="true"/>
											Free forever
										</label>
										@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Size: button.SizeSm}) {
											Let in
										}
									</form>
								} else {
									<span class="text-xs font-semibold text-live">in</span>
								}
							</li>
						}
						if len(entries) == 0 {
							<li class="py-3 text-sm text-muted-foreground">Nobody waits yet.</li>
						}
					</ul>
				}
			}
		</div>
	}
}
