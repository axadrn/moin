package pages

import (
	"strings"
	"time"

	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/ui/csrf"
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
)

// AlertsView is the alerts page: where the alerts of the workspace go.
// Created is the destination just added, SigningSecret its secret, shown
// this once.
type AlertsView struct {
	Destinations  []model.AlertDestination
	Created       *model.AlertDestination
	SigningSecret string
}

// alertKinds give the kind select its labels.
var alertKinds = []kit.Option{
	{Value: model.AlertSlack, Label: "Slack"},
	{Value: model.AlertDiscord, Label: "Discord"},
	{Value: model.AlertTelegram, Label: "Telegram"},
	{Value: model.AlertWebhook, Label: "Webhook"},
}

// Alerts is where the alerts of the workspace go: by mail to owners and
// admins, and to the destinations listed here.
templ Alerts(view AlertsView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@layouts.App("Alerts") {
		@panelPage(templ.Attributes{"data-alerts-page": true}) {
			@kit.Header(kit.Back{Label: "Settings", Href: basePath + "/settings"}, "Alerts")
			<div id="alerts" class="flex flex-col gap-6">
				if view.SigningSecret != "" && view.Created != nil {
					<div data-signing-secret>
						@kit.Card("Signing secret of "+view.Created.Name, nil) {
							@kit.Quiet() {
								Shown this once. Every post carries <code class="font-mono text-foreground">X-Moin-Signature: sha256=…</code>, the HMAC-SHA256 of the body with this secret.
							}
							@kit.Command(view.SigningSecret)
						}
					</div>
				}
				@alertDestinations(view)
				if ctxkeys.WorkspaceMember(ctx).Can(model.WorkspacePermissionManageWorkspace) {
					@alertDestinationForm()
				}
				@kit.Section("Email", nil) {
					@kit.List() {
						@kit.Row(basePath + "/settings/account") {
							@kit.RowText("Owners and admins", "Each turns it off for themselves")
						}
					}
				}
			</div>
		}
	}
}

// alertDestinations lists the destinations, with a test and a remove for
// owners and admins.
templ alertDestinations(view AlertsView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ manage := ctxkeys.WorkspaceMember(ctx).Can(model.WorkspacePermissionManageWorkspace) }}
	{{ now := time.Now() }}
	@kit.Section("Destinations", nil) {
		<div data-alert-destinations>
			@kit.List() {
				if len(view.Destinations) == 0 {
					@kit.Row("") {
						@kit.RowText("None yet", "Alerts go by mail only")
					}
				}
				for _, destination := range view.Destinations {
					@kit.RowControl(templ.Attributes{"data-alert-destination": destination.Name}) {
						<div class="min-w-0 flex-1">
							<div class="flex min-w-0 items-center gap-2">
								<span class="truncate font-medium">{ destination.Name }</span>
								<span class="shrink-0 text-sm text-muted-foreground">{ model.AlertKindLabel(destination.Kind) }</span>
							</div>
							<div class="truncate text-sm text-muted-foreground">
								<span class="font-mono">{ destination.Hint }</span>
								{ " · " + alertEventsText(destination) }
								if destination.FailingSince == nil && destination.LastSentAt != nil {
									<span title={ stamp(*destination.LastSentAt) }>{ " · sent " + ago(*destination.LastSentAt, now) }</span>
								}
							</div>
							if destination.FailingSince != nil {
								<div class="flex min-w-0 items-center gap-2 pt-1 text-sm text-failed" data-alert-failing>
									@kit.Dot(kit.StateFailed)
									<span class="truncate">{ "Failing since " + ago(*destination.FailingSince, now) + ": " + destination.LastError }</span>
								</div>
							}
						</div>
						if manage {
							<div class="flex w-full items-center gap-2 sm:w-auto">
								@kit.Button(kit.Secondary, "", templ.Attributes{
									"hx-post":    basePath + "/alerts/destinations/" + destination.Name + "/test",
									"hx-target":  "#alerts",
									"hx-select":  "#alerts",
									"hx-swap":    "outerHTML",
									"hx-disable": "this",
								}) {
									Send test
								}
								@kit.Button(kit.Danger, "", templ.Attributes{
									"hx-delete":  basePath + "/alerts/destinations/" + destination.Name,
									"hx-target":  "#alerts",
									"hx-select":  "#alerts",
									"hx-swap":    "outerHTML",
									"hx-disable": "this",
									"hx-confirm": "Remove " + destination.Name + "? Its alerts stop.",
								}) {
									Remove
								}
							</div>
						}
					}
				}
			}
		</div>
	}
}

// alertDestinationForm adds a destination. Telegram has a bot token and a
// chat ID instead of a URL: CSS shows the fields of the picked kind.
templ alertDestinationForm() {
	@kit.Card("Add a destination", nil) {
		<form
			class="group/alert flex flex-col gap-4"
			hx-post={ ctxkeys.AppBasePath(ctx) + "/alerts/destinations" }
			hx-target="#alerts"
			hx-select="#alerts"
			hx-swap="outerHTML"
			hx-disable="find button[type='submit']"
			data-alert-form
		>
			@csrf.Token()
			<div class="grid items-start gap-4 sm:grid-cols-2">
				@kit.Field("Kind", "alert-kind", "") {
					@kit.Select(kit.SelectProps{ID: "alert-kind", Name: "kind", Label: "Kind", Options: alertKinds, Value: model.AlertSlack})
				}
				@alertField("name", "Name", "team-chat", "Lowercase letters, digits and dashes", "text", "")
			</div>
			@alertField("url", "Webhook URL", "https://hooks.slack.com/services/…", "Stored encrypted, never shown again", "password", "url")
			@alertField("bot_token", "Bot token", "123456:ABC-DEF…", "From @BotFather; add the bot to the chat first", "password", "telegram")
			@alertField("chat_id", "Chat ID", "-1001234567890", "The chat, group or channel, or @channelname", "text", "telegram")
			<div class="flex flex-col gap-2">
				<span class="px-1 text-sm font-medium">Events</span>
				<div class="grid gap-x-6 sm:grid-cols-2">
					for _, event := range model.AlertEvents {
						{{ id := "alert-event-" + strings.ReplaceAll(event, ".", "-") }}
						<label for={ id } class="flex min-h-12 cursor-pointer items-center justify-between gap-3 px-1">
							<span class="text-sm">{ model.AlertEventLabel(event) }</span>
							@kit.Switch(templ.Attributes{"id": id, "name": "events", "value": event, "checked": true})
						</label>
					}
				</div>
			</div>
			<div class="flex justify-end">
				@kit.Button(kit.Primary, "", templ.Attributes{"type": "submit"}) {
					Add destination
				}
			</div>
		</form>
	}
}

// alertField is one field of the destination form. forKind telegram shows
// it only for Telegram, url for every other kind.
templ alertField(name, label, placeholder, hint, kind, forKind string) {
	{{ id := "alert-" + strings.ReplaceAll(name, "_", "-") }}
	<div
		data-alert-kind={ forKind }
		class={ templ.KV("group-has-[input[value=telegram]:checked]/alert:hidden", forKind == "url"), templ.KV("hidden group-has-[input[value=telegram]:checked]/alert:block", forKind == "telegram") }
	>
		@kit.Field(label, id, hint) {
			@kit.Input(templ.Attributes{"id": id, "name": name, "type": kind, "placeholder": placeholder, "autocomplete": "off", "spellcheck": "false"})
		}
	</div>
}

// alertEventsText names the events a destination gets.
func alertEventsText(destination model.AlertDestination) string {
	events := destination.EventList()
	if len(events) == len(model.AlertEvents) {
		return "every alert"
	}
	labels := make([]string, 0, len(events))
	for _, event := range events {
		labels = append(labels, model.AlertEventLabel(event))
	}
	return strings.Join(labels, ", ")
}
