package pages

import (
	"github.com/axadrn/ops/controlplane/internal/ui/components/badge"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	selectcomp "github.com/axadrn/ops/controlplane/internal/ui/components/select"
	"github.com/axadrn/ops/controlplane/internal/ui/utils"
	"net/url"
	"strings"
	"time"

	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/layouts"
)

// ActivityView is one page of the workspace activity, newest first. Next is
// the event to continue after, empty on the last page. Filter is what the
// page shows, Choices what it can be filtered by. Admin views see the client
// IP and user agent.
type ActivityView struct {
	Events  []model.WorkspaceAuditEvent
	Next    string
	Filter  model.ActivityFilter
	Choices model.ActivityChoices
	Admin   bool
}

// query is the filter as URL parameters, after the event after.
func (v ActivityView) query(after string) string {
	values := url.Values{}
	for key, value := range map[string]string{"app": v.Filter.App, "server": v.Filter.Server, "user": v.Filter.User, "after": after} {
		if value != "" {
			values.Set(key, value)
		}
	}
	if len(values) == 0 {
		return ""
	}
	return "?" + values.Encode()
}

// filtered reports whether the view shows only part of the activity.
func (v ActivityView) filtered() bool {
	return v.Filter != model.ActivityFilter{}
}

templ Activity(view ActivityView) {
	@layouts.App("Activity") {
		@panelPage() {
			@pageHeader("Activity", "Who changed what, to the second: from the web, the CLI, the TUI, the API, an agent over MCP, a deploy hook or GitHub.")
			if len(view.Choices.Apps)+len(view.Choices.Servers)+len(view.Choices.Users) > 0 {
				@activityFilters(view)
			}
			if len(view.Events) == 0 && view.filtered() {
				@emptyState("Nothing matches", "No change of the team matches this filter.", "ops activity")
			} else if len(view.Events) == 0 {
				@emptyState("Nothing happened yet", "Deploys, restores, SQL writes and every other change of the team show up here.", "ops activity")
			} else {
				@panel(panelProps{Title: "Changes", Docs: "/docs/guides/activity", Description: "Newest first, times in UTC. The same list is in ops activity.", Body: panelBodyRows}) {
					<ol class="flex flex-col gap-1" data-activity>
						@ActivityRows(view)
					</ol>
				}
			}
		}
	}
}

// ActivityRows are the rows of a page and the button that loads the next one
// in its place.
templ ActivityRows(view ActivityView) {
	{{ now := time.Now() }}
	for _, event := range view.Events {
		{{ details := event.Details() }}
		<li data-event={ event.Action } class="flex items-start gap-3 rounded-xl px-3 py-2.5 hover:bg-muted/60">
			<span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-muted-foreground" aria-hidden="true">
				@activityIcon(event.Action)
			</span>
			<div class="flex min-w-0 flex-1 flex-col gap-1 pt-1.5">
				<p class="text-sm text-pretty break-words">
					<span class="font-medium">{ event.Actor() }</span>
					{ " " + event.Summary() }
				</p>
				if details["message"] != "" {
					<p class="truncate text-xs text-muted-foreground">{ details["message"] }</p>
				}
				if details["error"] != "" {
					<p class="truncate text-xs text-muted-foreground">{ details["error"] }</p>
				}
				<p class="flex flex-wrap gap-x-2 text-xs text-muted-foreground">
					<time class="tabular-nums" datetime={ event.CreatedAt.UTC().Format(time.RFC3339Nano) }>{ stamp(event.CreatedAt) }</time>
					if view.Admin && event.IP != "" {
						<span class="tabular-nums">{ event.IP }</span>
					}
					if view.Admin && event.UserAgent != "" {
						<span class="max-w-64 truncate" title={ event.UserAgent }>{ event.UserAgent }</span>
					}
				</p>
			</div>
			<div class="mt-1.5 flex h-5 shrink-0 items-center gap-2">
				if label := event.ViaLabel(); label != "" {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "hidden sm:inline-flex"}) {
						{ label }
					}
				}
				<span class="w-14 text-right text-xs text-muted-foreground tabular-nums">{ ago(event.CreatedAt, now) }</span>
			</div>
		</li>
	}
	if view.Next != "" {
		<li class="px-3 pt-2" id="activity-more">
			@button.Button(button.Props{
				Variant:    button.VariantSecondary,
				Size:       button.SizeSm,
				Attributes: templ.Attributes{"hx-get": ctxkeys.AppBasePath(ctx) + "/activity" + view.query(view.Next), "hx-target": "#activity-more", "hx-swap": "outerHTML"},
			}) {
				Show older
			}
		</li>
	}
}

// activityFilters narrow the activity to one app, server or member.
templ activityFilters(view ActivityView) {
	<form method="get" action={ templ.SafeURL(ctxkeys.AppBasePath(ctx) + "/activity") } class="flex flex-wrap items-center gap-2" data-activity-filters>
		@activitySelect("app", "All apps", view.Filter.App, view.Choices.Apps)
		@activitySelect("server", "All servers", view.Filter.Server, view.Choices.Servers)
		@activitySelect("user", "Everyone", view.Filter.User, view.Choices.Users)
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Size: button.SizeSm}) {
			Filter
		}
		if view.filtered() {
			@button.Button(button.Props{Href: ctxkeys.AppBasePath(ctx) + "/activity", Variant: button.VariantGhost, Size: button.SizeSm}) {
				Show all
			}
		}
	</form>
}

// activitySelect picks one of values, or all of them.
templ activitySelect(name, all, current string, values []string) {
	@selectcomp.Select(selectcomp.Props{Name: name, DefaultValue: current}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{Size: selectcomp.SizeSm, Class: "min-w-32", Attributes: templ.Attributes{"aria-label": all}}) {
			@selectcomp.Value(selectcomp.ValueProps{Placeholder: all})
		}
		@selectcomp.Content(selectcomp.ContentProps{AlignItemWithTrigger: utils.Ptr(false), Align: selectcomp.AlignStart, Class: "w-auto min-w-(--anchor-width) max-w-[min(24rem,var(--available-width))]"}) {
			@selectcomp.Group() {
				@selectcomp.Item(selectcomp.ItemProps{Value: ""}) {
					{ all }
				}
				for _, value := range values {
					@selectcomp.Item(selectcomp.ItemProps{Value: value}) {
						{ value }
					}
				}
			}
		}
	}
}

templ activityIcon(action string) {
	switch  {
		case action == "app.rolled_back":
			@icon.Undo2(icon.Props{Class: "size-4"})
		case action == "app.deployed" || action == "app.redeployed" || action == "app.restarted" || action == "app.started" || strings.HasPrefix(action, "deploy."):
			@icon.Rocket(icon.Props{Class: "size-4"})
		case action == "app.stopped":
			@icon.Square(icon.Props{Class: "size-4"})
		case strings.HasPrefix(action, "data."):
			@icon.Database(icon.Props{Class: "size-4"})
		case strings.HasPrefix(action, "backup."):
			@icon.Archive(icon.Props{Class: "size-4"})
		case strings.HasPrefix(action, "server."):
			@icon.Server(icon.Props{Class: "size-4"})
		case strings.HasPrefix(action, "env."):
			@icon.KeyRound(icon.Props{Class: "size-4"})
		case strings.HasPrefix(action, "workspace."):
			@icon.Users(icon.Props{Class: "size-4"})
		default:
			@icon.Activity(icon.Props{Class: "size-4"})
	}
}
