package pages

import (
	"github.com/axadrn/ops/controlplane/internal/ui/components/badge"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"strings"
	"time"

	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/layouts"
)

// ActivityView is one page of the workspace activity, newest first. Next is
// the event to continue after, empty on the last page.
type ActivityView struct {
	Events []model.WorkspaceAuditEvent
	Next   string
}

templ Activity(view ActivityView) {
	@layouts.App("Activity") {
		@panelPage() {
			@pageHeader("Activity", "Who deployed, rolled back, restored or changed what, from the web, the CLI, an agent or GitHub.")
			if len(view.Events) == 0 {
				@emptyState("Nothing happened yet", "Deploys, restores, SQL writes and every other change of the team show up here.", "ops activity")
			} else {
				@panel(panelProps{Title: "Changes", Description: "Newest first. The same list is in ops activity.", Body: panelBodyRows}) {
					<ol class="flex flex-col gap-1" data-activity>
						@ActivityRows(view)
					</ol>
				}
			}
		}
	}
}

// ActivityRows are the rows of a page and the button that loads the next one
// in its place.
templ ActivityRows(view ActivityView) {
	{{ now := time.Now() }}
	for _, event := range view.Events {
		{{ details := event.Details() }}
		<li data-event={ event.Action } class="flex items-start gap-3 rounded-xl px-3 py-2.5 hover:bg-muted/60">
			<span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-muted-foreground" aria-hidden="true">
				@activityIcon(event.Action)
			</span>
			<div class="flex min-w-0 flex-1 flex-col gap-1 pt-1.5">
				<p class="text-sm text-pretty">
					<span class="font-medium">{ event.Actor() }</span>
					{ " " + event.Summary() }
				</p>
				if details["message"] != "" {
					<p class="truncate text-xs text-muted-foreground">{ details["message"] }</p>
				}
			</div>
			<div class="mt-1.5 flex h-5 shrink-0 items-center gap-2">
				if label := viaLabel(event.Via()); label != "" {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "hidden sm:inline-flex"}) {
						{ label }
					}
				}
				<time class="w-14 text-right text-xs text-muted-foreground tabular-nums" datetime={ event.CreatedAt.UTC().Format(time.RFC3339) } title={ stamp(event.CreatedAt) }>{ ago(event.CreatedAt, now) }</time>
			</div>
		</li>
	}
	if view.Next != "" {
		<li class="px-3 pt-2" id="activity-more">
			@button.Button(button.Props{
				Variant:    button.VariantSecondary,
				Size:       button.SizeSm,
				Attributes: templ.Attributes{"hx-get": ctxkeys.AppBasePath(ctx) + "/activity?after=" + view.Next, "hx-target": "#activity-more", "hx-swap": "outerHTML"},
			}) {
				Show older
			}
		</li>
	}
}

// viaLabel names how a change came in.
func viaLabel(via string) string {
	switch via {
	case "web":
		return "Web"
	case "api":
		return "CLI"
	case "mcp":
		return "Agent"
	case "hook":
		return "Deploy hook"
	case "github":
		return "GitHub"
	}
	return ""
}

templ activityIcon(action string) {
	switch  {
		case action == "app.rolled_back":
			@icon.Undo2(icon.Props{Class: "size-4"})
		case action == "app.deployed" || action == "app.redeployed" || action == "app.restarted" || action == "app.started":
			@icon.Rocket(icon.Props{Class: "size-4"})
		case action == "app.stopped":
			@icon.Square(icon.Props{Class: "size-4"})
		case strings.HasPrefix(action, "data."):
			@icon.Database(icon.Props{Class: "size-4"})
		case strings.HasPrefix(action, "backup."):
			@icon.Archive(icon.Props{Class: "size-4"})
		case strings.HasPrefix(action, "server."):
			@icon.Server(icon.Props{Class: "size-4"})
		case strings.HasPrefix(action, "env."):
			@icon.KeyRound(icon.Props{Class: "size-4"})
		case strings.HasPrefix(action, "workspace."):
			@icon.Users(icon.Props{Class: "size-4"})
		default:
			@icon.Activity(icon.Props{Class: "size-4"})
	}
}
