package pages

import (
	"encoding/json"
	"fmt"
	"github.com/axadrn/ops/controlplane/internal/ui/components/alert"
	"github.com/axadrn/ops/controlplane/internal/ui/components/badge"
	"github.com/axadrn/ops/controlplane/internal/ui/components/checkbox"
	"github.com/axadrn/ops/controlplane/internal/ui/components/input"
	"github.com/axadrn/ops/controlplane/internal/ui/components/kbd"
	tablecomp "github.com/axadrn/ops/controlplane/internal/ui/components/table"
	"github.com/axadrn/ops/controlplane/internal/ui/components/textarea"
	"github.com/axadrn/ops/controlplane/internal/ui/utils"
	"net/url"
	"slices"
	"strconv"
	"strings"

	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
	"github.com/axadrn/ops/controlplane/internal/ui/layouts"
	"github.com/axadrn/ops/protocol"
)

// DataView is the data page of an app: its databases, the tables of one,
// and a page of rows of one table.
type DataView struct {
	App       model.App
	Databases []protocol.Database
	Database  string
	Tables    []protocol.DBTable
	Table     *protocol.DBTable
	Result    protocol.DBResult
	Offset    int
	Limit     int
	// Schema shows the table's CREATE statements instead of its rows.
	Schema    bool
	Migration *protocol.DBMigration
	// Error says why the server could not answer.
	Error string
}

// AppData is the data page of an app: the tables of its database next to
// the rows or the schema of one, then the SQL console.
templ AppData(view DataView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@layouts.AppShell(layouts.AppProps{Title: view.App.Name + " data", Crumbs: []layouts.Crumb{{Label: "Apps", Href: basePath + "/apps"}, {Label: view.App.Name, Href: basePath + "/apps/" + view.App.Name}, {Label: "Data"}}}) {
		@panelPage(templ.Attributes{"data-app-data": view.App.Name}) {
			@appHeader(view.App, "data", "The SQLite database on "+view.App.ServerName+", read live. Edits write straight to it.")
			if view.Error != "" {
				<div role="alert">
					@emptyState("The data could not be read", view.Error, "")
				</div>
			} else if len(view.Databases) == 0 {
				@emptyState("No SQLite database yet", "ops finds SQLite files on the volumes of the live release. Deploy an app that keeps its database on a volume, like /data/app.db.", "ops deploy "+view.App.Name)
			} else {
				<div class="grid items-stretch gap-4 lg:grid-cols-[16rem_minmax(0,1fr)]">
					@dataSidebar(view)
					if view.Table != nil {
						@dataTable(view)
					} else {
						@panel(panelProps{Title: "No tables yet", Description: "Tables come from the migrations in your repo and show up here after the next deploy."}) {
							@emptyHint("Or create one with SQL below.", "")
						}
					}
				</div>
				@dataConsole(view)
			}
		}
	}
}

func dataURL(view DataView, table string, offset int) string {
	query := url.Values{}
	if len(view.Databases) > 1 {
		query.Set("db", view.Database)
	}
	query.Set("table", table)
	if offset > 0 {
		query.Set("offset", strconv.Itoa(offset))
	}
	return "?" + query.Encode()
}

func schemaURL(view DataView, table string) string {
	return dataURL(view, table, 0) + "&view=schema"
}

// dataSidebar lists the databases and tables, and says how the schema
// changes.
templ dataSidebar(view DataView) {
	@panel(panelProps{Title: "Tables", Description: tablesLine(view), Body: panelBodyRows}) {
		if len(view.Databases) > 1 {
			<nav aria-label="Databases" class="mb-6">
				<p class="px-3 pb-1 text-xs text-muted-foreground">Database</p>
				<ul class="flex flex-col gap-1" role="list">
					for _, database := range view.Databases {
						<li>
							@dataNavItem("?db="+url.QueryEscape(database.Path), database.Path == view.Database, templ.Attributes{"title": database.Path}) {
								@icon.Database(icon.Props{Class: "size-4 shrink-0 text-muted-foreground"})
								<span class="min-w-0 flex-1 truncate font-mono">{ shortPath(database.Path) }</span>
							}
						</li>
					}
				</ul>
			</nav>
		}
		<nav aria-label="Tables">
			<ul class="flex flex-col gap-1" role="list">
				for _, table := range view.Tables {
					<li>
						@dataNavItem(dataURL(view, table.Name, 0), view.Table != nil && view.Table.Name == table.Name, templ.Attributes{"data-table-link": table.Name}) {
							if table.Type == "view" {
								@icon.Eye(icon.Props{Class: "size-4 shrink-0 text-muted-foreground"})
							} else {
								@icon.Table(icon.Props{Class: "size-4 shrink-0 text-muted-foreground"})
							}
							<span class="min-w-0 flex-1 truncate">{ table.Name }</span>
							<span class="shrink-0 text-xs text-muted-foreground tabular-nums">{ fmt.Sprint(table.Rows) }</span>
						}
					</li>
				}
			</ul>
		</nav>
		<div class="flex flex-col gap-1 px-3 pt-6 text-xs text-muted-foreground" data-migration>
			<p class="text-sm font-medium text-foreground">Migrations</p>
			if view.Migration != nil {
				<p><span class="text-foreground">{ view.Migration.Tool }</span> at <span class="font-mono text-foreground">{ view.Migration.Version }</span></p>
				if view.Migration.AppliedAt != "" {
					<p class="tabular-nums">applied { view.Migration.AppliedAt }</p>
				}
			} else {
				<p>No migration tool found.</p>
			}
			<p>The schema changes with the migrations in your repo, on deploy.</p>
		</div>
	}
}

// tablesLine is the line under the Tables title: how many, in which file.
func tablesLine(view DataView) string {
	return plural(len(view.Tables), "table", "tables") + " in " + shortPath(view.Database)
}

// dataNavItem is one row of the sidebar lists, soft gray when selected.
templ dataNavItem(href string, active bool, attrs templ.Attributes) {
	<a
		href={ templ.SafeURL(href) }
		class={ "flex h-9 items-center gap-2.5 rounded-xl px-3 text-sm transition-colors",
			templ.KV("bg-muted font-medium", active),
			templ.KV("hover:bg-muted/60", !active) }
		if active {
			aria-current="page"
		}
		{ attrs... }
	>
		{ children... }
	</a>
}

templ dataTable(view DataView) {
	{{ dataPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name + "/data" }}
	{{ table := *view.Table }}
	{{ withRowID := table.RowID }}
	@panel(panelProps{Heading: "data-table-heading", Title: table.Name, Description: tableLine(view), Body: panelBodyFlush, Action: addRowAction(view)}) {
		@dataToolbar(view)
		if view.Schema {
			@dataSchema(table)
		} else {
			if table.Type == "table" {
				@newRowForm(dataPath, view.Database, table)
			}
			<div class={ dataScrollClasses + " max-h-[32rem]" }>
				@tablecomp.Table(tablecomp.Props{Attributes: templ.Attributes{"data-rows": true}}) {
					@tablecomp.Header() {
						@tablecomp.Row(tablecomp.RowProps{Class: "hover:bg-transparent"}) {
							for _, column := range table.Columns {
								@tablecomp.Head(tablecomp.HeadProps{Class: utils.CN(dataHeadClasses, map[string]bool{"text-right": isNumeric(column)})}) {
									<span class="inline-flex items-center gap-1.5">
										if column.PrimaryKey {
											@icon.KeyRound(icon.Props{Class: "size-3.5 text-muted-foreground", Attributes: templ.Attributes{"aria-label": "primary key"}})
										}
										<span>{ column.Name }</span>
										<span class="font-mono text-xs font-normal text-muted-foreground">{ strings.ToLower(column.Type) }</span>
									</span>
								}
							}
							if withRowID {
								@tablecomp.Head(tablecomp.HeadProps{Class: dataHeadClasses + " w-12"}) {
									<span class="sr-only">Delete</span>
								}
							}
						}
					}
					@tablecomp.Body() {
						for _, row := range view.Result.Rows {
							{{ rowID := rowIDOf(row, withRowID) }}
							@tablecomp.Row(tablecomp.RowProps{Class: "group/row", Attributes: templ.Attributes{"data-row": rowID}}) {
								for index, column := range table.Columns {
									{{ value := cellValue(row, index, withRowID) }}
									if withRowID && !isBlob(column) {
										@tablecomp.Cell(tablecomp.CellProps{Class: dataEditCellClasses}) {
											@DataCell(dataPath, view.Database, table.Name, rowID, column, value, "")
										}
									} else {
										@tablecomp.Cell(tablecomp.CellProps{Class: utils.CN(dataCellClasses, map[string]bool{"text-right": isNumeric(column), "text-muted-foreground italic": value == nil})}) {
											{ cellText(value) }
										}
									}
								}
								if withRowID {
									@tablecomp.Cell(tablecomp.CellProps{Class: "py-0 pr-4 text-right"}) {
										@button.Button(button.Props{
											Variant: button.VariantGhost,
											Size:    button.SizeIconSm,
											Class:   "text-muted-foreground focus-visible:opacity-100 sm:opacity-0 sm:group-hover/row:opacity-100",
											Attributes: templ.Attributes{
												"aria-label": "Delete row " + rowID,
												"title":      "Delete this row",
												"hx-post":    dataPath + "/delete",
												"hx-vals":    deleteRowVals(view.Database, table.Name, rowID),
												"hx-target":  "closest tr",
												"hx-swap":    "outerHTML",
												"hx-confirm": "Delete row " + rowID + " of " + table.Name + "? This cannot be undone.",
											},
										}) {
											@icon.Trash2()
										}
									}
								}
							}
						}
					}
				}
				if len(view.Result.Rows) == 0 {
					<div class="px-6 pt-6">
						if table.Type == "table" {
							@emptyHint("No rows yet. Add the first one with Add row, or with SQL below.", "")
						} else {
							@emptyHint("This view returns no rows right now.", "")
						}
					</div>
				}
			</div>
		}
	}
}

// tableLine is the line under the table's name: its size and how to work
// with what is shown.
func tableLine(view DataView) string {
	table := *view.Table
	rows := plural(int(table.Rows), "row", "rows")
	switch {
	case view.Schema:
		return rows + ". Its columns, indexes and the statement that created it."
	case table.Type == "view":
		return rows + ". A view, read only."
	case table.RowID:
		return rows + ". Click a cell to edit, Enter saves, Esc cancels."
	}
	return rows + ". A WITHOUT ROWID table: add rows here, change them with SQL below."
}

// addRowAction is the one action of the table card: Add row, on the rows
// of a table (not a view, not the schema).
func addRowAction(view DataView) templ.Component {
	if view.Schema || view.Table.Type != "table" {
		return nil
	}
	return addRowButton()
}

templ addRowButton() {
	@button.Button(button.Props{
		Size:       button.SizeSm,
		Attributes: templ.Attributes{"data-new-row-toggle": true, "aria-controls": "new-row", "aria-expanded": "false"},
	}) {
		@icon.Plus(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
		Add row
	}
}

// dataToolbar switches between the rows and the schema of a table, and
// pages through the rows.
templ dataToolbar(view DataView) {
	{{ table := *view.Table }}
	{{ shown := view.Offset + len(view.Result.Rows) }}
	<div class="flex flex-wrap items-center justify-between gap-2 px-6 pb-4">
		<nav class="flex gap-1" aria-label="Table view">
			@dataViewLink(dataURL(view, table.Name, 0), "Rows", !view.Schema, nil)
			@dataViewLink(schemaURL(view, table.Name), "Schema", view.Schema, templ.Attributes{"data-schema-link": true})
		</nav>
		if !view.Schema && (view.Offset > 0 || int64(shown) < table.Rows) {
			<div class="flex items-center gap-2" data-pager>
				<span class="text-xs text-muted-foreground tabular-nums">{ fmt.Sprintf("%d–%d of %d", view.Offset+1, shown, table.Rows) }</span>
				@button.Button(button.Props{Variant: button.VariantSecondary, Size: button.SizeSm, Disabled: view.Offset == 0, Href: dataURL(view, table.Name, max(view.Offset-view.Limit, 0))}) {
					Newer
				}
				@button.Button(button.Props{Variant: button.VariantSecondary, Size: button.SizeSm, Disabled: int64(shown) >= table.Rows, Href: dataURL(view, table.Name, view.Offset+view.Limit)}) {
					Older
				}
			</div>
		}
	</div>
}

// dataViewLink is the Rows or the Schema link of a table.
templ dataViewLink(href, label string, active bool, attrs templ.Attributes) {
	{{ all := templ.Attributes{} }}
	for k, v := range attrs {
		{{ all[k] = v }}
	}
	if active {
		{{ all["aria-current"] = "page" }}
	}
	@button.Button(button.Props{
		Href:       href,
		Size:       button.SizeSm,
		Variant:    utils.IfElse(active, button.VariantSecondary, button.VariantGhost),
		Attributes: all,
	}) {
		{ label }
	}
}

templ dataSchema(table protocol.DBTable) {
	<div class={ dataScrollClasses }>
		@tablecomp.Table(tablecomp.Props{Attributes: templ.Attributes{"data-schema-columns": true}}) {
			@tablecomp.Header() {
				@tablecomp.Row(tablecomp.RowProps{Class: "hover:bg-transparent"}) {
					@tablecomp.Head(tablecomp.HeadProps{Class: dataHeadClasses}) {
						Column
					}
					@tablecomp.Head(tablecomp.HeadProps{Class: dataHeadClasses}) {
						Type
					}
					@tablecomp.Head(tablecomp.HeadProps{Class: dataHeadClasses + " w-full"}) {
						Constraints
					}
				}
			}
			@tablecomp.Body() {
				for _, column := range table.Columns {
					@tablecomp.Row() {
						@tablecomp.Cell(tablecomp.CellProps{Class: dataCellClasses + " font-sans font-medium"}) {
							{ column.Name }
						}
						@tablecomp.Cell(tablecomp.CellProps{Class: utils.CN(dataCellClasses, map[string]bool{"text-muted-foreground": column.Type == ""})}) {
							{ strings.ToLower(orDash(column.Type)) }
						}
						@tablecomp.Cell(tablecomp.CellProps{Class: "first:pl-6 last:pr-6"}) {
							<span class="flex gap-1.5">
								if column.PrimaryKey {
									@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
										primary key
									}
								}
								if column.NotNull {
									@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
										not null
									}
								}
							</span>
						}
					}
				}
			}
		}
	</div>
	<div class="flex flex-col gap-3 px-6 pt-6">
		<p class="text-sm font-medium">Statement</p>
		<pre class={ dataTermClasses } data-table-sql>{ table.SQL }</pre>
		if len(table.Indexes) > 0 {
			<p class="pt-3 text-sm font-medium">Indexes</p>
			for _, index := range table.Indexes {
				<pre class={ dataTermClasses }>{ index }</pre>
			}
		}
		<p class="text-xs text-muted-foreground">To change the schema, add a migration to your repo and deploy. ops takes a snapshot before every deploy.</p>
	</div>
}

templ newRowForm(dataPath, database string, table protocol.DBTable) {
	<form id="new-row" hidden class="px-6 pb-6" hx-post={ dataPath + "/insert" } hx-swap="none" data-new-row>
		@csrf.Token()
		<input type="hidden" name="db" value={ database }/>
		<input type="hidden" name="table" value={ table.Name }/>
		<div class="rounded-2xl bg-muted/60 p-4">
			<div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
				for _, column := range table.Columns {
					<label class="flex min-w-0 flex-col gap-1">
						<span class="flex items-baseline gap-1.5 text-sm font-medium">
							{ column.Name }
							<span class="font-mono text-xs font-normal text-muted-foreground">{ strings.ToLower(column.Type) }</span>
						</span>
						@input.Input(input.Props{
							Type:        "text",
							Name:        "value:" + column.Name,
							Placeholder: newRowPlaceholder(column),
							Class:       "font-mono",
							Attributes:  templ.Attributes{"spellcheck": "false", "autocomplete": "off"},
						})
					</label>
				}
			</div>
			<div class="mt-4 flex flex-wrap items-center justify-between gap-3">
				<span class="text-xs text-muted-foreground">Empty fields get the column's default.</span>
				<div class="flex gap-2">
					@button.Button(button.Props{Variant: button.VariantSecondary, Attributes: templ.Attributes{"data-new-row-cancel": true}}) {
						Cancel
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Save row
					}
				</div>
			</div>
		</div>
	</form>
}

func newRowPlaceholder(column protocol.DBColumn) string {
	switch {
	case column.PrimaryKey && strings.EqualFold(column.Type, "INTEGER"):
		return "automatic"
	case column.NotNull:
		return "required"
	}
	return "NULL"
}

// DataCell is one editable cell: a form that saves on Enter or when it
// loses focus with a changed value.
templ DataCell(dataPath, database, table, rowID string, column protocol.DBColumn, value any, state string) {
	<form
		class="m-0"
		hx-post={ dataPath + "/cell" }
		hx-swap="outerHTML"
		hx-trigger="submit, change"
		data-cell={ state }
	>
		@csrf.Token()
		<input type="hidden" name="db" value={ database }/>
		<input type="hidden" name="table" value={ table }/>
		<input type="hidden" name="rowid" value={ rowID }/>
		<input type="hidden" name="column" value={ column.Name }/>
		if value == nil {
			<input type="hidden" name="was_null" value="1"/>
		}
		@input.Input(input.Props{
			Type:        "text",
			Name:        "value",
			Value:       cellInput(value),
			Placeholder: utils.IfElse(value == nil, "NULL", ""),
			Class: utils.CN(
				// A cell of the table: no box until it has focus.
				"field-sizing-content w-full min-w-24 max-w-[22rem] truncate rounded-xl bg-transparent px-3 font-mono placeholder:italic focus-visible:bg-background dark:bg-transparent",
				map[string]bool{"text-right": isNumeric(column), "text-live": state == "saved", "text-failed": state == "failed"},
			),
			Attributes: templ.Attributes{"aria-label": column.Name, "spellcheck": "false", "autocomplete": "off", "data-original": cellInput(value)},
		})
	</form>
}

templ dataConsole(view DataView) {
	{{ dataPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name + "/data" }}
	@panel(panelProps{Heading: "sql-heading", Title: "SQL", Description: "Reads only, until you allow changes. The same as ops sql " + view.App.Name + " in your terminal.", Body: panelBodyFlush}) {
		<form class="flex flex-col gap-3 px-6" hx-post={ dataPath + "/query" } hx-target="#sql-result" hx-swap="innerHTML">
			@csrf.Token()
			<input type="hidden" name="db" value={ view.Database }/>
			<label for="sql" class="sr-only">SQL</label>
			@textarea.Textarea(textarea.Props{
				ID:          "sql",
				Name:        "sql",
				Rows:        4,
				Placeholder: sqlPlaceholder(view),
				Class:       "ops-term field-sizing-fixed min-h-0 w-full resize-y border-0 bg-terminal font-mono text-terminal-foreground dark:bg-terminal",
				Attributes:  templ.Attributes{"spellcheck": "false", "data-sql": true},
			})
			<p hidden class="flex items-center gap-2 text-xs text-running" data-sql-schema-hint>
				@icon.TriangleAlert(icon.Props{Class: "size-3.5 shrink-0"})
				This changes the schema. Put it in a migration in your repo, or the next deploy will not know about it.
			</p>
			<div class="flex flex-wrap items-center justify-between gap-3">
				<label class="flex cursor-pointer items-center gap-2 text-sm">
					@checkbox.Checkbox(checkbox.Props{Name: "write", Value: "1"})
					Allow changes
					<span class="text-xs text-muted-foreground">INSERT, UPDATE, DELETE</span>
				</label>
				<div class="flex items-center gap-2">
					@kbd.Kbd(kbd.Props{Class: "hidden sm:inline-flex"}) {
						⌘↵
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						@icon.Play(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
						Run
					}
				</div>
			</div>
		</form>
		<div id="sql-result" class="min-w-0"></div>
	}
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const page = document.currentScript.closest('[data-app-data]') || document;
			const sql = page.querySelector('[data-sql]');
			const hint = page.querySelector('[data-sql-schema-hint]');
			sql?.addEventListener('input', () => {
				hint.hidden = !/^\s*(create|alter|drop)\b/i.test(sql.value);
			});
			// Add row opens the new row form, Cancel closes it again.
			const toggle = page.querySelector('[data-new-row-toggle]');
			const form = page.querySelector('[data-new-row]');
			const showForm = open => {
				form.hidden = !open;
				toggle.setAttribute('aria-expanded', String(open));
				if (open) form.querySelector('input[type=text]')?.focus();
				else toggle.focus();
			};
			toggle?.addEventListener('click', () => showForm(form.hidden));
			page.querySelector('[data-new-row-cancel]')?.addEventListener('click', () => showForm(false));
			sql?.addEventListener('keydown', event => {
				if (event.key === 'Enter' && (event.metaKey || event.ctrlKey)) {
					event.preventDefault();
					sql.form.requestSubmit();
				}
			});
			// Enter saves a cell, Esc puts its value back.
			page.addEventListener('keydown', event => {
				const input = event.target.closest?.('[data-rows] input[name=value]');
				if (!input) return;
				if (event.key === 'Escape') {
					input.value = input.dataset.original;
					input.blur();
				}
				if (event.key === 'Enter') {
					event.preventDefault();
					input.blur();
				}
			});
		})();
	</script>
}

func sqlPlaceholder(view DataView) string {
	if view.Table == nil {
		return "SELECT * FROM sqlite_schema"
	}
	return "SELECT * FROM " + view.Table.Name + " LIMIT 20"
}

// DataResult is the answer of the SQL console: an error is an alert, a
// change a status line, a read the rows it found.
templ DataResult(result protocol.DBResult, write bool, message string) {
	if message != "" {
		<div class="px-6 pt-6">
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Attributes: templ.Attributes{"data-sql-error": true}}) {
				@icon.CircleAlert()
				@alert.Title(alert.TitleProps{Class: "font-mono font-normal"}) {
					{ message }
				}
			}
		</div>
	} else if write {
		<p role="status" class="flex items-center gap-2 px-6 pt-6 text-sm font-medium" data-sql-changes>
			@icon.Check(icon.Props{Class: "size-4 shrink-0 text-live"})
			{ plural(int(result.Changes), "row changed", "rows changed") }
		</p>
	} else {
		<div class="flex flex-col gap-3 pt-6">
			<p role="status" class="px-6 text-xs text-muted-foreground tabular-nums">
				{ plural(len(result.Rows), "row", "rows") }
				if result.Truncated {
					, more not shown
				}
			</p>
			if len(result.Columns) > 0 {
				{{ numeric := numericColumns(result) }}
				<div class={ dataScrollClasses + " max-h-[24rem]" }>
					@tablecomp.Table(tablecomp.Props{Attributes: templ.Attributes{"data-sql-result": true}}) {
						@tablecomp.Header() {
							@tablecomp.Row(tablecomp.RowProps{Class: "hover:bg-transparent"}) {
								for index, column := range result.Columns {
									@tablecomp.Head(tablecomp.HeadProps{Class: utils.CN(dataHeadClasses, map[string]bool{"text-right": numeric[index]})}) {
										{ column }
									}
								}
							}
						}
						@tablecomp.Body() {
							for _, row := range result.Rows {
								@tablecomp.Row() {
									for index, value := range row {
										@tablecomp.Cell(tablecomp.CellProps{Class: utils.CN(dataCellClasses, map[string]bool{"text-right": numeric[index], "text-muted-foreground italic": value == nil})}) {
											{ cellText(value) }
										}
									}
								}
							}
						}
					}
				</div>
			}
		</div>
	}
}

// The tables of the data page run edge to edge in their card with the
// table's own row lines; the first and the last column sit on the card's
// 24 px, so values line up with the title.
const (
	dataScrollClasses   = "overflow-auto overscroll-contain [&>[data-slot=table-container]]:overflow-visible"
	dataHeadClasses     = "sticky top-0 z-10 bg-card text-muted-foreground first:pl-6 last:pr-6"
	dataCellClasses     = "max-w-[22rem] truncate font-mono first:pl-6 last:pr-6"
	dataEditCellClasses = "max-w-[22rem] py-1 px-0 first:pl-3 whitespace-normal"
	dataTermClasses     = "ops-term overflow-x-auto rounded-2xl bg-terminal px-4 py-3 font-mono text-sm whitespace-pre-wrap text-terminal-foreground"
)

// isNumeric says whether a column holds numbers, by SQLite's type affinity,
// so its values align right.
func isNumeric(column protocol.DBColumn) bool {
	kind := strings.ToUpper(column.Type)
	for _, part := range []string{"INT", "REAL", "FLOA", "DOUB", "NUMERIC", "DECIMAL"} {
		if strings.Contains(kind, part) {
			return true
		}
	}
	return false
}

// numericColumns says per column of a query result whether every value is
// a number or NULL, so the column aligns right, its head too.
func numericColumns(result protocol.DBResult) []bool {
	numeric := make([]bool, len(result.Columns))
	for index := range numeric {
		numeric[index] = slices.ContainsFunc(result.Rows, func(row []any) bool { return index < len(row) && isNumber(row[index]) }) &&
			!slices.ContainsFunc(result.Rows, func(row []any) bool { return index < len(row) && row[index] != nil && !isNumber(row[index]) })
	}
	return numeric
}

// isNumber says whether a value of a query result is a number.
func isNumber(value any) bool {
	_, ok := value.(float64)
	return ok
}

// deleteRowVals are the hx-vals of the delete button of a row.
func deleteRowVals(database, table, rowID string) string {
	vals, _ := json.Marshal(map[string]string{"db": database, "table": table, "rowid": rowID})
	return string(vals)
}


func rowIDOf(row []any, withRowID bool) string {
	if !withRowID || len(row) == 0 {
		return ""
	}
	return cellInput(row[0])
}

func cellValue(row []any, index int, withRowID bool) any {
	if withRowID {
		index++
	}
	if index >= len(row) {
		return nil
	}
	return row[index]
}

func cellText(value any) string {
	if value == nil {
		return "NULL"
	}
	return cellInput(value)
}

// cellInput writes a value as the text a cell edits. JSON numbers arrive
// as float64; whole ones print without a decimal point.
func cellInput(value any) string {
	switch value := value.(type) {
	case nil:
		return ""
	case float64:
		if value == float64(int64(value)) {
			return strconv.FormatInt(int64(value), 10)
		}
		return strconv.FormatFloat(value, 'g', -1, 64)
	case string:
		return value
	default:
		return fmt.Sprint(value)
	}
}

func isBlob(column protocol.DBColumn) bool {
	return strings.Contains(strings.ToUpper(column.Type), "BLOB")
}
