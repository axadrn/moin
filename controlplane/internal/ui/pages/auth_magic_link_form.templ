package pages

import (
	"strconv"

	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/ui/blocks"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/field"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/components/input"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
)

// AuthMagicLinkForm is the email sign-in. Where GitHub sign-in is set up,
// GitHub is the main way and this form the second one.
templ AuthMagicLinkForm(errorMsg string) {
	{{ second := ctxkeys.RenderConfig(ctx).GitHubLogin }}
	<form
		id="magic-link-form"
		action="/auth/magic-link"
		method="POST"
		hx-post="/auth/magic-link"
		hx-target="#magic-link-form"
		hx-swap="outerHTML"
		hx-disable="find button[type='submit']"
	>
		@csrf.Token()
		@field.Group(field.GroupProps{Class: "gap-3"}) {
			@field.Field(field.Props{Class: "gap-2"}) {
				@field.Label(field.LabelProps{For: "email", Class: "sr-only"}) {
					Email
				}
				@input.Input(input.Props{
					ID:          "email",
					Name:        "email",
					Type:        "email",
					Placeholder: "you@company.com",
					Class:       "h-11 text-base",
					Attributes: templ.Attributes{
						"aria-invalid":     strconv.FormatBool(errorMsg != ""),
						"aria-describedby": "email-hint",
						"autocomplete":     "email",
						"autofocus":        !second,
						"required":         "",
					},
				})
				@fieldHint("email", errorMsg)
			}
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: magicLinkVariant(second), Size: button.SizeLg, Class: blocks.AuthPrimary}) {
				Continue with email
				@icon.ArrowRight(icon.Props{Class: "size-4"})
			}
		}
	</form>
}

func magicLinkVariant(second bool) button.Variant {
	if second {
		return button.VariantSecondary
	}
	return button.VariantDefault
}
