package pages

import (
	"fmt"
	"strconv"

	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/service"
	"github.com/axadrn/moin/controlplane/internal/ui/components/chart"
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
)

// AppMetricsPage is the metrics of an app, a page under it ("‹ shop"):
// CPU, memory and network of its containers now and over a range, with its
// deploys marked.
templ AppMetricsPage(view AppMetricsView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name }}
	@layouts.App(view.App.Name + " metrics") {
		@panelPage(templ.Attributes{"data-app-metrics": view.App.Name}) {
			@kit.Header(kit.Back{Label: view.App.Name, Href: appPath}, "Metrics")
			@appMetricsPanel(view, appPath+"/metrics")
		}
	}
}

// appMetricsPanel is everything under the head; it reloads itself every
// 15 seconds on the last hour, and when another range is picked.
templ appMetricsPanel(view AppMetricsView, path string) {
	{{ m := view.Metrics }}
	{{ rows := metricsRows(m.Points, m.Deploys, true) }}
	<div id="metrics" class="flex flex-col gap-6" data-metrics-range={ m.Range.Name } { metricsRefresh(path+"?range="+m.Range.Name, m.Range.Name)... }>
		if !m.ServerOnline && m.Server != "" {
			<p class="px-1 text-sm text-failed" data-server-offline>{ m.Server } is offline: its agent sends no metrics.</p>
		}
		@serverRangeSelect(path, m.Range.Name)
		@kit.Section("Now", nil) {
			<div data-metrics-now>
				@kit.List() {
					if now := m.Now; now != nil {
						@serverStat("CPU", "of the whole server", percentText(now.CPU))
						@serverStat("Memory", appLimitNote(now), bytesText(float64(now.MemoryUsed)))
						@serverStat("Network", rateText(now.NetTx)+" out", rateText(now.NetRx)+" in")
						@serverStat("Containers", "", strconv.Itoa(now.Containers))
					} else {
						@serverStat("CPU", "No sample in the last two minutes", "")
						@serverStat("Memory", "", "")
						@serverStat("Network", "", "")
					}
				}
			</div>
		}
		@kit.Section(rangeTitle(m.Range), nil) {
			if len(rows) == 0 {
				@kit.Card("", nil) {
					@kit.Quiet() {
						No metrics yet. The agent sends them every 15 seconds while the app runs.
					}
					@kit.Command("moin metrics " + view.App.Name)
				}
			} else {
				@kit.Grid() {
					@serverChart("CPU", metricsChartProps{ID: "app-cpu", Config: cpuConfig, Rows: rows, Range: m.Range.Name, Value: percentText, Deploys: true})
					@serverChart("Memory", metricsChartProps{ID: "app-memory", Config: memoryConfig, Rows: rows, Range: m.Range.Name, Value: bytesText, Deploys: true})
					@serverChart("Network", metricsChartProps{ID: "app-network", Config: networkConfig, Rows: rows, Range: m.Range.Name, Value: rateText, Deploys: true})
				}
			}
		}
	</div>
}

func appLimitNote(now *service.MetricsNow) string {
	if now.MemoryLimit == 0 {
		return "no limit"
	}
	return "of " + bytesText(float64(now.MemoryLimit)) + ", " + shareOf(now.MemoryUsed, now.MemoryLimit)
}

func rangeTitle(r service.MetricsRange) string {
	switch r.Name {
	case "24h":
		return "Last 24 hours, 5 minute averages"
	case "7d":
		return "Last 7 days, hourly averages"
	case "30d":
		return "Last 30 days, 4 hour averages"
	}
	return "Last hour, every 15 seconds, live"
}

templ metricsChart(p metricsChartProps) {
	@chart.Container(chart.ContainerProps{ID: p.ID, Config: p.Config, Class: "aspect-auto h-[200px] w-full"}) {
		@chart.LineChart(chart.LineChartProps{AccessibilityLayer: true, Data: p.Rows, Margin: &chart.Margin{Top: 12, Right: 12, Bottom: 0, Left: 0}}) {
			@chart.CartesianGrid(chart.CartesianGridProps{Vertical: chart.Bool(false)})
			@chart.XAxis(chart.XAxisProps{DataKey: "t", TickMargin: 8, MinTickGap: 32, TickFormatter: metricsTick(p.Range)})
			@chart.YAxis(chart.YAxisProps{Width: 64, TickCount: 4, TickFormatter: axisValue(p.Value), Domain: p.Domain})
			@chart.Tooltip(chart.TooltipProps{Content: chart.TooltipContentProps{Indicator: "line", LabelFormatter: metricsLabel, Formatter: metricsTooltip(p.Config, p.Value)}})
			for index, series := range p.Config {
				@chart.Line(chart.LineProps{DataKey: series.Key, Type: chart.CurveMonotone, Stroke: "var(--color-" + series.Key + ")", StrokeWidth: 2, Dot: deployDot(p.Deploys && index == 0, series.Key)})
			}
		}
	}
}

// deployDot marks the points where a deploy went live, nil for none.
func deployDot(on bool, key string) *chart.DotProps {
	if !on {
		return nil
	}
	return &chart.DotProps{
		Icon: icon.GitCommitVertical(icon.Props{Class: "fill-background stroke-(--color-" + key + ")"}),
		Size: 20,
		Show: func(_ int, row chart.Datum) bool {
			_, ok := row["deploy"]
			return ok
		},
	}
}

templ metricsTooltipRow(label, value, deploy string) {
	<div class="flex min-w-[140px] flex-col gap-1 text-xs">
		<div class="flex items-center gap-2 text-muted-foreground">
			{ label }
			<span class="ml-auto font-mono font-medium text-foreground tabular-nums">{ value }</span>
		</div>
		if deploy != "" {
			<div class="flex items-center gap-1 font-medium text-foreground">
				@icon.GitCommitVertical(icon.Props{Class: "size-3.5"})
				{ deploy } went live
			</div>
		}
	</div>
}

// ServerMetricsPage is the metrics of a server: CPU, memory, the data
// disk, network and load now and over a range, and its apps by memory.
templ ServerMetricsPage(view ServerMetricsView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ path := basePath + "/servers/" + view.Server.ID + "/metrics" }}
	@layouts.App(view.Server.Name + " metrics") {
		@panelPage(templ.Attributes{"data-server-metrics": view.Server.Name}) {
			@serverHead(view.Server, "metrics")
			@serverMetricsPanel(view, path)
		}
	}
}

// serverMetricsPanel is everything under the head; it reloads itself every
// 15 seconds on the last hour, and when another range is picked.
templ serverMetricsPanel(view ServerMetricsView, path string) {
	{{ m := view.Metrics }}
	{{ rows := metricsRows(m.Points, nil, false) }}
	<div id="metrics" class="flex flex-col gap-6" data-metrics-range={ m.Range.Name } { metricsRefresh(path+"?range="+m.Range.Name, m.Range.Name)... }>
		if !m.Online {
			<p class="px-1 text-sm text-failed" data-server-offline>The server is offline: its agent sends no metrics.</p>
		}
		@serverRangeSelect(path, m.Range.Name)
		@kit.Section("Now", nil) {
			<div data-metrics-now>
				@kit.List() {
					if now := m.Now; now != nil {
						@serverStat("CPU", cpuNote(now), percentText(now.CPU))
						@serverStat("Memory", shareOf(now.MemoryUsed, now.MemoryTotal), usedOf(now.MemoryUsed, now.MemoryTotal))
						@serverStat("Disk", shareOf(now.DiskUsed, now.DiskTotal), usedOf(now.DiskUsed, now.DiskTotal))
						@serverStat("Network", rateText(now.NetTx)+" out", rateText(now.NetRx)+" in")
					} else {
						@serverStat("CPU", "No sample in the last two minutes", "")
						@serverStat("Memory", "", "")
						@serverStat("Disk", "", "")
						@serverStat("Network", "", "")
					}
				}
			</div>
		}
		@kit.Section(rangeTitle(m.Range), nil) {
			if len(rows) == 0 {
				@kit.Card("", nil) {
					@kit.Quiet() {
						No metrics yet. The agent sends them every 15 seconds.
					}
					@kit.Command("moin metrics --server " + view.Server.Name)
				}
			} else {
				@kit.Grid() {
					@serverChart("CPU", metricsChartProps{ID: "server-cpu", Config: cpuConfig, Rows: rows, Range: m.Range.Name, Value: percentText, Domain: []any{0, 100}})
					@serverChart("Memory", metricsChartProps{ID: "server-memory", Config: memoryConfig, Rows: rows, Range: m.Range.Name, Value: bytesText, Domain: totalDomain(m.Now, false)})
					@serverChart("Disk", metricsChartProps{ID: "server-disk", Config: diskConfig, Rows: rows, Range: m.Range.Name, Value: bytesText, Domain: totalDomain(m.Now, true)})
					@serverChart("Network", metricsChartProps{ID: "server-network", Config: networkConfig, Rows: rows, Range: m.Range.Name, Value: rateText})
				}
			}
		}
		@serverAppsMetrics(m.Apps)
	</div>
}

// serverRangeSelect picks the range: a change loads the metrics of that
// range in place and puts it in the address.
templ serverRangeSelect(path, active string) {
	<form class="w-40" hx-get={ path } hx-trigger="change" hx-target="#metrics" hx-select="#metrics" hx-swap="outerHTML" hx-push-url="true" data-metrics-ranges>
		@kit.Select(kit.SelectProps{ID: "metrics-range", Name: "range", Label: "Range", Options: rangeOptions(), Value: active})
	</form>
}

func rangeOptions() []kit.Option {
	options := make([]kit.Option, 0, len(service.MetricsRanges))
	for _, r := range service.MetricsRanges {
		options = append(options, kit.Option{Value: r.Name, Label: rangeLabel(r.Name)})
	}
	return options
}

func rangeLabel(name string) string {
	switch name {
	case "24h":
		return "24 hours"
	case "7d":
		return "7 days"
	case "30d":
		return "30 days"
	}
	return "1 hour"
}

// serverStat is one number of the server now: its name and a note left,
// the value right.
templ serverStat(name, note, value string) {
	@kit.Row("") {
		@kit.RowText(name, note)
		if value != "" {
			<span class="shrink-0 font-medium tabular-nums">{ value }</span>
		} else {
			<span class="shrink-0 text-muted-foreground">—</span>
		}
	}
}

// serverChart is a card with one chart.
templ serverChart(title string, p metricsChartProps) {
	<div class="grid min-w-0" data-metrics-chart={ p.ID }>
		@kit.Card(title, nil) {
			@metricsChart(p)
		}
	</div>
}

func cpuNote(now *service.MetricsNow) string {
	note := "load " + loadText(now.Load)
	if now.Cores > 0 {
		note = fmt.Sprintf("%d cores, %s", now.Cores, note)
	}
	return note
}

// totalDomain lets a chart of memory or disk reach up to the total.
func totalDomain(now *service.MetricsNow, disk bool) []any {
	if now == nil {
		return nil
	}
	total := now.MemoryTotal
	if disk {
		total = now.DiskTotal
	}
	if total == 0 {
		return nil
	}
	return []any{0, float64(total)}
}

// serverAppsMetrics lists the apps of the server, the one with the most
// memory first.
templ serverAppsMetrics(apps []service.AppMetricsNow) {
	@kit.Section("Apps", nil) {
		<div data-server-apps-metrics>
			@kit.List() {
				if len(apps) == 0 {
					@kit.Row("") {
						@kit.RowText("No apps on this server yet", "")
					}
				}
				for _, app := range apps {
					<a href={ templ.SafeURL(ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name + "/metrics") } role="listitem" class="relative flex min-h-16 w-full items-center gap-3 rounded-3xl px-5 py-3 outline-none before:absolute before:inset-x-5 before:top-0 before:h-px before:bg-border first:before:hidden hover:bg-foreground/4 hover:before:opacity-0 focus-visible:bg-foreground/4 [&:hover+*]:before:opacity-0" data-app-metrics-row={ app.Name }>
						if now := app.Now; now != nil {
							@kit.RowText(app.Name, "CPU "+percentText(now.CPU)+" · network "+rateText(now.NetRx+now.NetTx))
							<span class="shrink-0 font-medium tabular-nums">{ bytesText(float64(now.MemoryUsed)) }</span>
						} else {
							@kit.RowText(app.Name, "")
							<span class="shrink-0 text-sm text-muted-foreground">not running</span>
						}
						<svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 shrink-0 text-muted-foreground"><path d="m6 3.5 4.5 4.5L6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					</a>
				}
			}
		</div>
	}
}
