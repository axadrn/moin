package pages

import (
	"fmt"
	"github.com/axadrn/ops/controlplane/internal/access"
	"github.com/axadrn/ops/controlplane/internal/ui/utils"
	"github.com/axadrn/ops/controlplane/internal/ui/components/badge"
	"github.com/axadrn/ops/controlplane/internal/ui/components/card"
	"github.com/axadrn/ops/controlplane/internal/ui/components/field"
	"time"

	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/components/input"
	"github.com/axadrn/ops/controlplane/internal/ui/components/status"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
	"github.com/axadrn/ops/controlplane/internal/ui/layouts"
	"github.com/axadrn/ops/internal/build"
)

// AddedServer is the one-time install command of a server just added.
type AddedServer struct {
	Name    string
	Command string
}

templ Servers(servers []model.Server, canAdd bool) {
	@layouts.App("Servers") {
		@panelPage() {
			@pageHeader("Servers", "Every server runs the ops agent. It dials out to ops, so nothing on your server listens for us.") {
				if canAdd {
					@ServerAddForm("", "")
				}
			}
			if !canAdd {
				@subscribeCard()
			}
			<div id="server-added" class="empty:hidden"></div>
			<div data-server-list-wrap>
				@ServerList(servers)
			</div>
		}
		@serversScript()
	}
}

// ServerAddForm is the add form. A request replaces it to show an error or
// to reset it.
templ ServerAddForm(name, nameError string) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<form
		id="server-add-form"
		hx-swap-oob="true"
		class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:items-start"
		hx-post={ basePath + "/servers" }
		hx-swap="none"
		hx-disable="find button[type='submit']"
	>
		@csrf.Token()
		<div class="flex min-w-0 flex-1 flex-col gap-1 sm:w-60 sm:flex-none">
			<label for="server-name" class="sr-only">Server name</label>
			@input.Input(input.Props{
				ID:          "server-name",
				Name:        "name",
				Type:        "text",
				Value:       name,
				Placeholder: "Server name, e.g. web-1",
				Attributes:  templ.Attributes{"maxlength": "64", "autocomplete": "off", "spellcheck": "false", "aria-invalid": apiTokenInvalid(nameError), "aria-describedby": "server-name-error", "data-hotkey-focus": true},
			})
			if nameError != "" {
				@field.Error(field.ErrorProps{ID: "server-name-error", Class: "px-3 text-xs"}) {
					{ nameError }
				}
			}
		</div>
		@button.Button(button.Props{Type: button.TypeSubmit}) {
			@icon.Plus()
			Add server
		}
	</form>
}

// ServerAdded shows the install command of the server just added: what to
// do, the command, and that the page notices the agent by itself.
templ ServerAdded(added AddedServer) {
	<div id="server-added" hx-swap-oob="true" data-server-added={ added.Name }>
		@panel(panelProps{
			Heading:     "server-added-heading",
			Title:       "Install the agent on " + added.Name,
			Description: "Run this command on the server as root. It works once, within the next hour.",
		}) {
			<div class="flex flex-col gap-4">
				<div class="flex items-start gap-2 rounded-2xl bg-muted py-2 pr-2 pl-4 font-mono text-xs">
					<span class="pt-2 text-muted-foreground select-none" aria-hidden="true">$</span>
					<code id="install-command" class="min-w-0 flex-1 py-2 leading-relaxed break-all whitespace-pre-wrap" data-install-command>{ added.Command }</code>
					@button.Button(button.Props{
						Size:       button.SizeSm,
						Class:      "group/copy font-sans",
						Attributes: templ.Attributes{"data-copy-target": "#install-command", "data-copy": ""},
					}) {
						@icon.Copy(icon.Props{Class: "group-data-copied/copy:hidden"})
						@icon.Check(icon.Props{Class: "hidden group-data-copied/copy:block"})
						<span data-copy-label>Copy</span>
					}
				</div>
				@status.Status(status.Props{Kind: status.KindWaiting}) {
					Waiting for the agent. This page shows the server online when it connects.
				}
			</div>
		}
	</div>
}

// ServerList is the list of servers. The page reloads it on every change the
// server event stream reports.
templ ServerList(servers []model.Server) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ now := time.Now() }}
	<div
		id="server-list"
		hx-swap-oob="true"
		hx-get={ basePath + "/servers/list" }
		hx-trigger="servers-changed from:body"
		hx-swap="none"
		class="flex flex-col gap-4"
	>
		if len(servers) == 0 {
			@emptyState("No servers yet", "Add a server, then run the install command ops gives you on it. Or add one from your terminal:", "ops servers add web-1")
		} else {
			<div class="flex items-baseline justify-between gap-3">
				@sectionTitle("Your servers")
				<p class="text-xs text-muted-foreground tabular-nums">{ serversSummary(servers) }</p>
			</div>
			<ul class="grid items-stretch gap-4 md:grid-cols-2 xl:grid-cols-3" role="list">
				for _, server := range servers {
					<li data-server={ server.Name } data-online?={ server.Online } class="min-w-0">
						@serverCard(server, basePath, now)
					</li>
				}
			</ul>
		}
	</div>
}

// serverCard is one server: its name and state, three facts, how it is
// reached, and the way to its page.
templ serverCard(server model.Server, basePath string, now time.Time) {
	{{ serverPath := basePath + "/servers/" + server.ID + "/security" }}
	@card.Card(card.Props{Class: "h-full min-w-0"}) {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "min-w-0 truncate text-base font-semibold", Attributes: templ.Attributes{"role": "heading", "aria-level": "3"}}) {
				<a href={ templ.SafeURL(serverPath) } class="hover:underline hover:underline-offset-4">{ server.Name }</a>
			}
			@card.Action() {
				@serverStatus(server)
			}
		}
		@card.Content(card.ContentProps{Class: "flex flex-1 flex-col gap-4"}) {
			<dl class="flex flex-wrap gap-x-8 gap-y-3">
				@serverFact("System", serverSystem(server), serverSystem(server))
				@serverFact("Agent", server.AgentVersion, server.AgentVersion)
				@serverFact("Last seen", serverLastSeen(server, now), serverLastSeenTitle(server))
			</dl>
			@serverAccess(server)
			if server.LastSeenAt == nil {
				<p class="text-xs text-muted-foreground">Its agent never connected. Run the install command on the server. Lost it? Remove the server on its page and add it again.</p>
			}
			if server.Online && agentOutdated(server) {
				<p class="text-xs text-muted-foreground" data-agent-outdated>The control plane runs { build.Version }.</p>
			}
		}
		@card.Footer(card.FooterProps{Class: "mt-auto gap-2"}) {
			@button.Button(button.Props{
				Href:       serverPath,
				Variant:    button.VariantSecondary,
				Size:       button.SizeSm,
				Attributes: templ.Attributes{"data-security-link": true},
			}) {
				@icon.Shield()
				Security
			}
			if server.Online && agentOutdated(server) {
				@button.Button(button.Props{
					Variant: button.VariantSecondary,
					Size:    button.SizeSm,
					Attributes: templ.Attributes{
						"hx-post":    basePath + "/servers/" + server.ID + "/update",
						"hx-swap":    "none",
						"hx-disable": "this",
					},
				}) {
					Update agent
				}
			}
		}
	}
}

// serverFact is a label with its value on a server card. No value is a
// muted dash.
templ serverFact(label, value, title string) {
	<div class="flex min-w-0 flex-col gap-1">
		<dt class="text-xs text-muted-foreground">{ label }</dt>
		if value != "" {
			<dd class="truncate text-sm font-medium tabular-nums" title={ title }>{ value }</dd>
		} else {
			<dd class="text-sm text-muted-foreground">—</dd>
		}
	</div>
}

templ serverStatus(server model.Server) {
	switch  {
		case server.Online:
			@status.Status(status.Props{Kind: status.KindLive, Chip: true}) {
				online
			}
		case server.LastSeenAt == nil:
			@status.Status(status.Props{Kind: status.KindWaiting, Chip: true}) {
				waiting
			}
		default:
			@status.Status(status.Props{Kind: status.KindFailed, Chip: true}) {
				offline
			}
	}
}

// serversScript reloads the list whenever the event stream reports a change.
// EventSource reconnects on its own.
templ serversScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const events = new EventSource("/api/v1/servers/events");
			events.addEventListener("servers", () => document.body.dispatchEvent(new Event("servers-changed")));
			document.addEventListener("htmx:before:history:update", () => events.close(), { once: true });
			// The install command works once: it goes when its agent is online.
			const hideUsedCommand = () => {
				const added = document.querySelector("[data-server-added]");
				if (added && document.querySelector(`[data-server="${CSS.escape(added.dataset.serverAdded)}"][data-online]`)) {
					added.replaceWith(Object.assign(document.createElement("div"), { id: "server-added", className: "empty:hidden" }));
				}
			};
			const wrap = document.querySelector("[data-server-list-wrap]");
			if (wrap) {
				new MutationObserver(hideUsedCommand).observe(wrap, { childList: true });
			}
		})();
	</script>
}

func serversSummary(servers []model.Server) string {
	online := 0
	for _, server := range servers {
		if server.Online {
			online++
		}
	}
	return fmt.Sprintf("%s · %d online", plural(len(servers), "server", "servers"), online)
}

func serverSystem(server model.Server) string {
	if server.OS == "" {
		return ""
	}
	return server.OS + "/" + server.Arch
}

// agentOutdated reports whether the agent runs another version than the
// control plane. Development builds never count.
func agentOutdated(server model.Server) bool {
	return build.Version != "dev" && server.AgentVersion != "" && server.AgentVersion != build.Version
}

func serverLastSeenTitle(server model.Server) string {
	if server.LastSeenAt == nil {
		return "Never connected"
	}
	return stamp(*server.LastSeenAt)
}

func serverLastSeen(server model.Server, now time.Time) string {
	if server.Online {
		return "now"
	}
	if server.LastSeenAt == nil {
		return "never"
	}
	age := now.Sub(*server.LastSeenAt)
	switch {
	case age < time.Minute:
		return "just now"
	case age < time.Hour:
		return fmt.Sprintf("%dm ago", int(age.Minutes()))
	case age < 48*time.Hour:
		return fmt.Sprintf("%dh ago", int(age.Hours()))
	}
	return fmt.Sprintf("%dd ago", int(age.Hours()/24))
}

// subscribeCard is what a read-only workspace sees above its servers: that
// it is read-only, the plan to buy and the way to Stripe Checkout. It has the
// shape of the offer on the billing page.
templ subscribeCard() {
	for _, plan := range access.Product.Plans {
		if plan.Purchasable {
			@subscribeOffer(plan)
		}
	}
}

templ subscribeOffer(plan access.Plan) {
	{{ checkout := ctxkeys.AppBasePath(ctx) + "/billing/checkout" }}
	@panel(panelProps{
		Title:       "This workspace is read-only",
		Description: "Your apps keep running. Subscribe to " + plan.Name + " to add servers and deploy again.",
		Attrs:       templ.Attributes{"data-subscribe": true},
	}) {
		<div class="flex flex-col gap-6">
			<div class="flex flex-col gap-2">
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "self-start"}) {
					Save { model.FormatPlanPrice(12*plan.MonthlyPrice - plan.YearlyPrice) } a year
				}
				@planPrice(model.FormatPlanPrice(plan.YearlyPrice), "a year, per workspace")
			</div>
			<div class="flex flex-col items-start gap-2">
				<div class="flex flex-col gap-2 sm:flex-row sm:items-center">
					@subscribeButton(checkout, plan.ID, "yearly", true) {
						Subscribe for { model.FormatPlanPrice(plan.YearlyPrice) } a year
					}
					@subscribeButton(checkout, plan.ID, "monthly", false) {
						or { model.FormatPlanPrice(plan.MonthlyPrice) } a month
					}
				</div>
				<p class="text-xs text-muted-foreground">Plus sales tax or VAT where it applies, shown at checkout. Cancel any time.</p>
			</div>
			@planBenefits(plan)
		</div>
	}
}

// subscribeButton starts Stripe Checkout for one interval. The yearly one is
// the primary action.
templ subscribeButton(checkout, planID, interval string, primary bool) {
	<form action={ templ.SafeURL(checkout) } method="POST" hx-post={ checkout } hx-swap="none" hx-disable="find button[type='submit']">
		@csrf.Token()
		<input type="hidden" name="plan_id" value={ planID }/>
		<input type="hidden" name="interval" value={ interval }/>
		@button.Button(button.Props{
			Type:       button.TypeSubmit,
			Variant:    utils.IfElse(primary, button.VariantDefault, button.VariantGhost),
			Class:      "w-full sm:w-auto",
			Attributes: templ.Attributes{"data-subscribe-" + interval: true},
		}) {
			{ children... }
		}
	</form>
}
