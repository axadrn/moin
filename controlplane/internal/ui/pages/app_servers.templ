package pages

import (
	"fmt"
	"github.com/axadrn/moin/controlplane/internal/access"
	"github.com/axadrn/moin/controlplane/internal/ui/components/badge"
	"github.com/axadrn/moin/controlplane/internal/ui/components/card"
	"github.com/axadrn/moin/controlplane/internal/ui/utils"
	"time"

	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/ui/components/button"
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
	"github.com/axadrn/moin/controlplane/internal/ui/components/input"
	"github.com/axadrn/moin/controlplane/internal/ui/components/item"
	"github.com/axadrn/moin/controlplane/internal/ui/components/status"
	"github.com/axadrn/moin/controlplane/internal/ui/csrf"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
	"github.com/axadrn/moin/internal/build"
)

// AddedServer is the one-time install command of a server just added.
type AddedServer struct {
	Name    string
	Command string
}

// RemovedServer is a server just removed and the command that removes its
// agent on the machine.
type RemovedServer struct {
	Name    string
	Command string
}

templ Servers(servers []model.Server, canAdd bool, removed *RemovedServer, autoUpdate bool) {
	@layouts.App("Servers") {
		@panelPage() {
			@pageHeader("Servers", "Every server runs the moin agent. It dials out to moin, so nothing on your server listens for us.") {
				if canAdd {
					@ServerAddForm()
				}
			}
			if !canAdd {
				@subscribeCard()
			}
			<div id="server-added" class="empty:hidden">
				if removed != nil {
					@serverRemoved(*removed)
				}
			</div>
			<div data-server-list-wrap>
				@ServerList(servers)
			</div>
			@panel(panelProps{Title: "Agent updates", Docs: "/docs/guides/servers#updates"}) {
				@AgentUpdatesForm(autoUpdate)
			}
		}
		@serversScript()
	}
}

// ServerAddForm is the add form. A request replaces it to reset it after the
// server was added; a wrong name keeps it as it is (DESIGN.md, Feedback).
templ ServerAddForm() {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<form
		id="server-add-form"
		hx-swap-oob="true"
		class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row"
		hx-post={ basePath + "/servers" }
		hx-swap="none"
		hx-disable="find button[type='submit']"
	>
		@csrf.Token()
		<label for="server-name" class="sr-only">Server name</label>
		@input.Input(input.Props{
			ID:          "server-name",
			Name:        "name",
			Type:        "text",
			Placeholder: "Leave empty for a name like brave-otter",
			Class:       "min-w-0 sm:w-72",
			Attributes:  templ.Attributes{"maxlength": "63", "autocomplete": "off", "spellcheck": "false", "data-hotkey-focus": true},
		})
		@button.Button(button.Props{Type: button.TypeSubmit}) {
			@icon.Plus()
			Add server
		}
	</form>
}

// ServerAdded shows the install command of the server just added: what to
// do, the command, and that the page notices the agent by itself.
templ ServerAdded(added AddedServer) {
	<div id="server-added" hx-swap-oob="true" data-server-added={ added.Name }>
		<div data-server-greeting hidden>
			@status.Status(status.Props{Kind: status.KindLive}) {
				moin from { added.Name }. It is online; deploy an app to it.
			}
		</div>
		<div data-server-install>
			@panel(panelProps{
				Heading:     "server-added-heading",
				Title:       "Install the agent on " + added.Name,
				Description: "Run this command on the server as root, or put sudo before sh. It works once, within the next hour. It shows only now: moin stores just a fingerprint of it.",
				Docs:        "/docs/guides/servers#add-a-server",
			}) {
				<div class="flex flex-col gap-4">
					<div class="flex items-start gap-2 rounded-2xl bg-muted py-2 pr-2 pl-4 font-mono text-xs">
						<span class="pt-2 text-muted-foreground select-none" aria-hidden="true">$</span>
						<code id="install-command" class="min-w-0 flex-1 py-2 leading-relaxed break-all whitespace-pre-wrap" data-install-command>{ added.Command }</code>
						@button.Button(button.Props{
							Size:       button.SizeSm,
							Class:      "group/copy font-sans",
							Attributes: templ.Attributes{"data-copy-target": "#install-command", "data-copy": ""},
						}) {
							@icon.Copy(icon.Props{Class: "group-data-copied/copy:hidden"})
							@icon.Check(icon.Props{Class: "hidden group-data-copied/copy:block"})
							Copy
						}
					</div>
					@status.Status(status.Props{Kind: status.KindWaiting}) {
						Waiting for the agent. This page shows the server online when it connects.
					}
				</div>
			}
		</div>
	</div>
}

// serverRemoved tells that the agent of a server just removed is still
// installed, with the command that removes it there.
templ serverRemoved(removed RemovedServer) {
	@panel(panelProps{
		Heading:     "server-removed-heading",
		Title:       removed.Name + " is removed",
		Docs:        "/docs/guides/servers#remove-a-server",
		Description: "Its agent is disconnected but still installed. Run this on the server as root, or put sudo in front, to remove it. The apps there keep running with their data; add --apps to remove them too.",
		Attrs:       templ.Attributes{"data-server-removed": removed.Name},
	}) {
		@command(removed.Command)
	}
}

// ServerList is the list of servers. The page reloads it on every change the
// server event stream reports.
templ ServerList(servers []model.Server) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ now := time.Now() }}
	<div
		id="server-list"
		hx-swap-oob="true"
		hx-get={ basePath + "/servers/list" }
		hx-trigger="servers-changed from:body"
		hx-swap="none"
		class="flex flex-col gap-4"
	>
		if len(servers) == 0 {
			@emptyState("No servers yet", "Add a server, then run the install command moin gives you on it. Or add one from your terminal:", "moin servers add web-1") {
				@docsLink("/docs/getting-started", "Getting started")
			}
		} else {
			<div class="flex flex-wrap items-center justify-between gap-3">
				<h2 id="servers-heading" class="text-base font-semibold">Your servers</h2>
				<div class="flex items-center gap-3">
					<p class="text-xs text-muted-foreground tabular-nums">{ serversSummary(servers) }</p>
					@viewSwitch("servers")
				</div>
			</div>
			@orderForm("servers") {
				if pageView(ctx, "servers") == model.ViewList {
					<ul class="flex flex-col gap-2" role="list" aria-labelledby="servers-heading" data-sortable-list>
						for _, server := range servers {
							<li data-server={ server.Name } data-online?={ server.Online } class="min-w-0">
								@card.Card(card.Props{Class: listCard}) {
									@orderHandle(server.Name)
									@serverRow(server, basePath, now)
								}
							</li>
						}
					</ul>
				} else {
					<ul class="grid items-stretch gap-4 md:grid-cols-2 xl:grid-cols-3" role="list" aria-labelledby="servers-heading" data-sortable-list>
						for _, server := range servers {
							<li data-server={ server.Name } data-online?={ server.Online } class="min-w-0">
								@serverCard(server, basePath, now)
							</li>
						}
					</ul>
				}
			}
		}
	</div>
}

// agentPending marks an agent behind the control plane; it updates itself
// on its next connect.
templ agentPending() {
	@badge.Badge(badge.Props{Class: "h-auto rounded-full bg-amber-500/15 px-2 py-0 text-[11px] font-medium text-amber-600 dark:text-amber-400", Attributes: templ.Attributes{"data-agent-outdated": true, "title": "Updates to " + build.Version + " by itself"}}) {
		update pending
	}
}

// serverRow is a server in the list: its name, system and agent, when it
// was last seen and its state, linking to its page.
templ serverRow(server model.Server, basePath string, now time.Time) {
	@item.Item(item.Props{Href: basePath + "/servers/" + server.ID + "/security", Size: item.SizeSm, Class: "group/server grid min-w-0 flex-1 grid-cols-[minmax(0,1fr)_auto] gap-4 px-2.75 md:grid-cols-[minmax(0,1fr)_8rem_7rem_1rem]"}) {
		@item.Content(item.ContentProps{Class: "min-w-0 gap-0.5"}) {
			@item.Title(item.TitleProps{Class: "max-w-full truncate"}) {
				{ server.Name }
			}
			@item.Description(item.DescriptionProps{Class: "line-clamp-1 text-xs"}) {
				if system := serverSystem(server); system != "" {
					{ system }
					<span aria-hidden="true">·</span>
				}
				if server.AgentVersion != "" {
					agent { server.AgentVersion }
					if server.Online && agentOutdated(server) {
						@agentPending()
					}
					<span aria-hidden="true">·</span>
				}
				{ serverReach(server) }
			}
		}
		<span class="flex min-w-0 justify-end md:justify-start">
			@serverStatus(server)
		</span>
		<span class="hidden text-xs text-muted-foreground tabular-nums md:block" title={ serverLastSeenTitle(server) }>{ serverLastSeen(server, now) }</span>
		@icon.ChevronRight(icon.Props{Class: "hidden size-4 text-muted-foreground transition-transform group-hover/server:translate-x-0.5 group-hover/server:text-foreground md:block"})
	}
}

// serverCard is one server: its name and state, three facts, how it is
// reached, and the way to its page. Its grip drags it.
templ serverCard(server model.Server, basePath string, now time.Time) {
	{{ serverPath := basePath + "/servers/" + server.ID + "/security" }}
	@card.Card(card.Props{Class: "h-full min-w-0"}) {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "-ml-2 flex min-w-0 items-center gap-1 text-base font-semibold", Attributes: templ.Attributes{"role": "heading", "aria-level": "3"}}) {
				@orderHandle(server.Name)
				<a href={ templ.SafeURL(serverPath) } class="truncate hover:underline hover:underline-offset-4">{ server.Name }</a>
			}
			@card.Action() {
				@serverStatus(server)
			}
		}
		@card.Content(card.ContentProps{Class: "flex flex-1 flex-col gap-4"}) {
			<dl class="flex flex-wrap gap-x-8 gap-y-3">
				@serverFact("System", serverSystem(server), serverSystem(server))
				@serverFact("Agent", server.AgentVersion, server.AgentVersion)
				@serverFact("Last seen", serverLastSeen(server, now), serverLastSeenTitle(server))
			</dl>
			@serverAccess(server)
			if server.LastSeenAt == nil {
				<p class="text-xs text-muted-foreground">Its agent never connected. Run the install command on the server. Lost it? Remove the server on its page and add it again.</p>
			}
			if server.Online && agentOutdated(server) {
				<p class="flex items-center gap-2 text-xs text-muted-foreground">
					@agentPending()
					The control plane runs { build.Version }.
				</p>
			}
		}
		@card.Footer(card.FooterProps{Class: "mt-auto gap-2"}) {
			@button.Button(button.Props{
				Href:       basePath + "/servers/" + server.ID + "/metrics",
				Variant:    button.VariantSecondary,
				Size:       button.SizeSm,
				Attributes: templ.Attributes{"data-metrics-link": true},
			}) {
				@icon.ChartLine()
				Metrics
			}
			@button.Button(button.Props{
				Href:       serverPath,
				Variant:    button.VariantSecondary,
				Size:       button.SizeSm,
				Attributes: templ.Attributes{"data-security-link": true},
			}) {
				@icon.Shield()
				Security
			}
			if server.Online && agentOutdated(server) {
				@button.Button(button.Props{
					Variant: button.VariantSecondary,
					Size:    button.SizeSm,
					Attributes: templ.Attributes{
						"hx-post":    basePath + "/servers/" + server.ID + "/update",
						"hx-swap":    "none",
						"hx-disable": "this",
					},
				}) {
					Update agent
				}
			}
		}
	}
}

// serverFact is a label with its value on a server card. No value is a
// muted dash.
templ serverFact(label, value, title string) {
	<div class="flex min-w-0 flex-col gap-1">
		<dt class="text-xs text-muted-foreground">{ label }</dt>
		if value != "" {
			<dd class="truncate text-sm font-medium tabular-nums" title={ title }>{ value }</dd>
		} else {
			<dd class="text-sm text-muted-foreground">—</dd>
		}
	</div>
}

templ serverStatus(server model.Server) {
	switch  {
		case server.Online:
			@status.Status(status.Props{Kind: status.KindLive, Chip: true}) {
				online
			}
		case server.LastSeenAt == nil:
			@status.Status(status.Props{Kind: status.KindWaiting, Chip: true}) {
				waiting
			}
		default:
			@status.Status(status.Props{Kind: status.KindFailed, Chip: true}) {
				offline
			}
	}
}

// serversScript reloads the list whenever the event stream reports a change.
// EventSource reconnects on its own.
templ serversScript() {
	<script nonce={ templ.GetNonce(ctx) } data-workspace={ ctxkeys.Workspace(ctx).Slug }>
		(() => {
			const events = new EventSource(`/api/v1/servers/events?workspace=${encodeURIComponent(document.currentScript.dataset.workspace)}`);
			events.addEventListener("servers", () => document.body.dispatchEvent(new Event("servers-changed")));
			document.addEventListener("htmx:before:history:update", () => events.close(), { once: true });
			// The install command works once: when its agent is online it
			// goes, the server says moin, and after a while that goes too.
			const hideUsedCommand = () => {
				const added = document.querySelector("[data-server-added]");
				const install = added?.querySelector("[data-server-install]");
				if (install && document.querySelector(`[data-server="${CSS.escape(added.dataset.serverAdded)}"][data-online]`)) {
					install.remove();
					added.querySelector("[data-server-greeting]").hidden = false;
					setTimeout(() => added.isConnected && added.replaceWith(Object.assign(document.createElement("div"), { id: "server-added", className: "empty:hidden" })), 15000);
				}
			};
			const wrap = document.querySelector("[data-server-list-wrap]");
			if (wrap) {
				new MutationObserver(hideUsedCommand).observe(wrap, { childList: true });
			}
		})();
	</script>
}

func serversSummary(servers []model.Server) string {
	online := 0
	for _, server := range servers {
		if server.Online {
			online++
		}
	}
	return fmt.Sprintf("%s · %d online", plural(len(servers), "server", "servers"), online)
}

// serverReach says in a few words how apps on the server are reached.
func serverReach(server model.Server) string {
	reach := "ports 80, 443"
	if server.Tunnel {
		reach = "Cloudflare Tunnel"
	}
	if server.Firewall {
		reach += ", firewall"
	}
	if server.SSHTailscale {
		reach += ", SSH on Tailscale"
	}
	return reach
}

func serverSystem(server model.Server) string {
	if server.OS == "" {
		return ""
	}
	return server.OS + "/" + server.Arch
}

// agentOutdated reports whether the agent runs another version than the
// control plane. Development builds never count.
func agentOutdated(server model.Server) bool {
	return build.Version != "dev" && server.AgentVersion != "" && server.AgentVersion != build.Version
}

func serverLastSeenTitle(server model.Server) string {
	if server.LastSeenAt == nil {
		return "Never connected"
	}
	return stamp(*server.LastSeenAt)
}

func serverLastSeen(server model.Server, now time.Time) string {
	if server.Online {
		return "now"
	}
	if server.LastSeenAt == nil {
		return "never"
	}
	age := now.Sub(*server.LastSeenAt)
	switch {
	case age < time.Minute:
		return "just now"
	case age < time.Hour:
		return fmt.Sprintf("%dm ago", int(age.Minutes()))
	case age < 48*time.Hour:
		return fmt.Sprintf("%dh ago", int(age.Hours()))
	}
	return fmt.Sprintf("%dd ago", int(age.Hours()/24))
}

// subscribeCard is what a read-only workspace sees above its servers: that
// it is read-only, the plan to buy and the way to Stripe Checkout. It has the
// shape of the offer on the billing page.
templ subscribeCard() {
	for _, plan := range access.Product.Plans {
		if plan.Purchasable {
			@subscribeOffer(plan)
		}
	}
}

templ subscribeOffer(plan access.Plan) {
	{{ checkout := ctxkeys.AppBasePath(ctx) + "/billing/checkout" }}
	@panel(panelProps{
		Title:       "This workspace is read-only",
		Docs:        "/docs/faq#how-does-the-hosted-trial-work",
		Description: "Your apps keep running. Subscribe to " + plan.Name + " to add servers and deploy again.",
		Attrs:       templ.Attributes{"data-subscribe": true},
	}) {
		<div class="flex flex-col gap-6">
			<div class="flex flex-col gap-2">
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "self-start"}) {
					Save { model.FormatPlanPrice(12*plan.MonthlyPrice - plan.YearlyPrice) } a year
				}
				@planPrice(model.FormatPlanPrice(plan.YearlyPrice), "a year, per workspace")
			</div>
			<div class="flex flex-col items-start gap-2">
				<div class="flex flex-col gap-2 sm:flex-row sm:items-center">
					@subscribeButton(checkout, plan.ID, "yearly", true) {
						Subscribe for { model.FormatPlanPrice(plan.YearlyPrice) } a year
					}
					@subscribeButton(checkout, plan.ID, "monthly", false) {
						or { model.FormatPlanPrice(plan.MonthlyPrice) } a month
					}
				</div>
				<p class="text-xs text-muted-foreground">Plus sales tax or VAT where it applies, shown at checkout. Cancel any time.</p>
			</div>
			@planBenefits(plan)
		</div>
	}
}

// subscribeButton starts Stripe Checkout for one interval. The yearly one is
// the primary action.
templ subscribeButton(checkout, planID, interval string, primary bool) {
	<form action={ templ.SafeURL(checkout) } method="POST" hx-post={ checkout } hx-swap="none" hx-disable="find button[type='submit']">
		@csrf.Token()
		<input type="hidden" name="plan_id" value={ planID }/>
		<input type="hidden" name="interval" value={ interval }/>
		@button.Button(button.Props{
			Type:       button.TypeSubmit,
			Variant:    utils.IfElse(primary, button.VariantDefault, button.VariantGhost),
			Class:      "w-full sm:w-auto",
			Attributes: templ.Attributes{"data-subscribe-" + interval: true},
		}) {
			{ children... }
		}
	</form>
}
