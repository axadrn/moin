package pages

import (
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/components/sidebar"
	"github.com/axadrn/ops/controlplane/internal/ui/components/status"
)

// appsNavLimit is how many apps the sidebar lists; View all opens the rest.
const appsNavLimit = 8

// AppsNav is the apps in the sidebar, each with its status, as nav-projects
// in shadcn's sidebar-07. at is the page the sidebar is on, so the app shown
// there is marked. Collapsed to icons, the group hides.
templ AppsNav(apps []model.App, at string) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	if len(apps) > 0 {
		@sidebar.Group(sidebar.GroupProps{Class: "group-data-[collapsible=icon]:hidden"}) {
			@sidebar.GroupLabel() {
				Apps
			}
			@sidebar.Menu() {
				for _, app := range apps[:min(len(apps), appsNavLimit)] {
					{{ href := basePath + "/apps/" + app.Name }}
					{{ current := templ.Attributes{} }}
					if at == href {
						{{ current["aria-current"] = "page" }}
					}
					@sidebar.MenuItem() {
						@sidebar.MenuButton(sidebar.MenuButtonProps{
							Href:       href,
							IsActive:   at == href,
							Attributes: current,
						}) {
							<span class="flex size-4 shrink-0 items-center justify-center">
								@status.Symbol(appKind(app))
							</span>
							<span>{ app.Name }</span>
						}
					}
				}
				@sidebar.MenuItem() {
					@sidebar.MenuButton(sidebar.MenuButtonProps{Href: basePath + "/apps", Class: "text-sidebar-foreground/70"}) {
						@icon.Ellipsis(icon.Props{Class: "text-sidebar-foreground/70"})
						<span>View all</span>
					}
				}
			}
		}
	}
}

// appKind is the status symbol of an app: its newest deploy.
func appKind(app model.App) status.Kind {
	switch {
	case app.LatestNumber == 0:
		return status.KindIdle
	case app.LatestStatus == model.DeployRunning:
		return status.KindRunning
	case app.LatestStatus == model.DeployFailed:
		return status.KindFailed
	}
	return status.KindLive
}

// appHeader is the head of every page of an app: its name, the status chip,
// one line, the actions (children) and the tabs.
templ appHeader(app model.App, tab, description string) {
	<header class="flex flex-col gap-6">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div class="min-w-0">
				<div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-2">
					<h1 class="truncate text-3xl font-bold tracking-tight">{ app.Name }</h1>
					if tab == "overview" {
						@appSummary(app)
					} else {
						@appStatus(app)
					}
				</div>
				if description != "" {
					<p class="mt-1 text-sm text-pretty text-muted-foreground">{ description }</p>
				}
			</div>
			<div class="flex shrink-0 flex-wrap items-center gap-2 empty:hidden">
				{ children... }
			</div>
		</div>
		@appTabs(app.Name, tab)
	</header>
}

// appTabs switches between the pages of an app: plain links the boost
// swaps into #main, as a segmented control.
templ appTabs(appName, active string) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + appName }}
	<nav class="flex h-9 w-full items-center gap-1 rounded-full bg-muted p-1 sm:w-fit" aria-label="App">
		@appTab(appPath, "Overview", active == "overview")
		@appTab(appPath+"/data", "Data", active == "data")
		@appTab(appPath+"/backups", "Backups", active == "backups")
	</nav>
}

templ appTab(href, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		class={ "flex h-full flex-1 items-center justify-center rounded-full px-4 text-sm font-medium whitespace-nowrap transition-colors outline-none focus-visible:ring-2 focus-visible:ring-ring sm:flex-none",
			templ.KV("bg-background text-foreground shadow-sm", active),
			templ.KV("text-muted-foreground hover:text-foreground", !active) }
		if active {
			aria-current="page"
		}
	>{ label }</a>
}
