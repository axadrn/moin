package pages

import (
	"github.com/axadrn/moin/controlplane/internal/ui/kit"

	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/ui/components/status"
	"github.com/axadrn/moin/controlplane/internal/ui/csrf"
)

// appKind is the status symbol of an app: its newest deploy.
func appKind(app model.App) status.Kind {
	switch {
	case app.LatestNumber == 0:
		return status.KindIdle
	case app.LatestStatus == model.DeployRunning:
		return status.KindRunning
	case app.LatestStatus == model.DeployFailed:
		return status.KindFailed
	}
	return status.KindLive
}

// appSections are the parts of an app, each one question: does it run,
// how does code get in, where is it reached, what happens in it, what is in
// its database, how is it set up. The TUI has the same ones and keys.
var appSections = []struct{ ID, Label, Path, Key string }{
	{"app", "App", "", ""},
	{"deploys", "Deploys", "/deploys", "d"},
	{"addresses", "Addresses", "/addresses", "o"},
	{"logs", "Logs", "/logs", "l"},
	{"data", "Data", "/data", "b"},
	{"settings", "Settings", "/settings", "e"},
}

// appHeader is the head of every section of an app, the same on each, so
// it stands still while you go through the tabs: its name, the pin, its
// state as plain words, and its buttons, all of one height: pin, stop or
// start, deploy.
templ appHeader(app model.App, section string) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name }}
	@kit.Header(kit.Back{Label: "Apps", Href: ctxkeys.AppBasePath(ctx) + "/apps"}, app.Name) {
		@appSummary(app)
		<div class="flex flex-wrap items-center gap-2 sm:ml-auto">
			@PinButton(app)
			@appPower(app)
			@kit.Button(kit.Primary, "", templ.Attributes{"hx-post": appPath + "/redeploy", "hx-swap": "none", "hx-disable": "this", "data-redeploy": true, "title": "Build the newest source again"}) {
				Deploy
			}
		</div>
	}
}

// appTabs are the sections of an app as a segmented control, each a link
// to its page.
templ appTabs(appName, active string) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + appName }}
	{{ segments := make([]kit.Segment, 0, len(appSections)) }}
	for _, s := range appSections {
		{{ segments = append(segments, kit.Segment{Label: s.Label, Href: appPath + s.Path, Key: s.Key, Active: s.ID == active}) }}
	}
	@kit.Segmented("app-tabs", appName, segments)
}

// appSection is the tabs, then what the open section shows.
templ appSection(appName, section string) {
	<div id="app-section" class="flex flex-col gap-6">
		@appTabs(appName, section)
		{ children... }
	</div>
}

// PinButton pins an app above the others that run fine, in every list:
// a real checkbox drawn as a kit button that says Pin, and Pinned once
// checked. Both words sit in one grid cell, so it keeps its size. htmx
// saves it without swapping anything (DESIGN.md, Feedback).
templ PinButton(app model.App) {
	<form id="pin-form" class="contents" hx-post={ ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name + "/pin" } hx-trigger="change" hx-swap="none">
		@csrf.Token()
		<label class="relative grid h-11 shrink-0 cursor-pointer place-items-center rounded-full bg-muted px-5 text-sm font-medium whitespace-nowrap text-foreground hover:bg-muted/70 has-focus-visible:ring-3 has-focus-visible:ring-ring/30">
			<input type="checkbox" name="on" value="1" checked?={ app.Pinned } autocomplete="off" class="peer sr-only" aria-label={ "Pin " + app.Name } data-pin/>
			<span class="col-start-1 row-start-1 peer-checked:invisible">Pin</span>
			<span class="invisible col-start-1 row-start-1 peer-checked:visible">Pinned</span>
		</label>
	</form>
}

// dataNav switches the Data section between its tables and its backups.
templ dataNav(appName, active string) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + appName }}
	@kit.Segmented("data-tabs", "Data", []kit.Segment{
		{Label: "Browse", Href: appPath + "/data", Active: active == "browse"},
		{Label: "Backups", Href: appPath + "/backups", Active: active == "backups"},
	})
}
