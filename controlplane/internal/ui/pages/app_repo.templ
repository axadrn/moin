package pages

import (
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/service"
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
)

// RepoView is the GitHub card of an app.
type RepoView struct {
	App model.App
	// Enabled is whether this control plane has the GitHub App; Connected
	// whether the workspace connected an account (Settings, GitHub).
	Enabled   bool
	Connected bool
	Repos     []service.GitHubRepoOf
	// Branches are the branches of the first repo, its default first.
	Branches []string
	// Installations say where on GitHub the workspace gives moin more repos.
	Installations []model.GitHubInstallation
	// Error says why the repos could not be listed.
	Error string
	// Loading is the link form before GitHub answered with the repos: the
	// page renders it without them and asks for them, so the card keeps
	// its place.
	Loading bool
}

// AppRepo is the GitHub card: connect GitHub, link a repo and branch,
// deploy a ref, deploy on push.
templ AppRepo(view RepoView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name }}
	<div
		id="app-repo"
		class="grid"
		if view.Loading {
			hx-get={ appPath + "/repo" }
			hx-trigger="load"
			hx-swap="outerHTML"
		}
	>
		@kit.Card("GitHub", repoAction(view)) {
			if view.Error != "" {
				<p class="px-1 text-sm text-failed" data-repo-error>{ view.Error }</p>
			}
			if !view.Enabled {
				@kit.Quiet() {
					This control plane has no GitHub App.
				}
				@kit.Command("moin deploy " + view.App.Name)
			} else if !view.Connected {
				@kit.Quiet() {
					GitHub is not connected.
				}
			} else if view.App.Repo == "" {
				@repoLink(view)
			} else {
				@repoLinked(view)
			}
		}
	</div>
}

// repoAction is the one button in the head of the card: Connect GitHub,
// which comes back to the app, or Unlink once a repo is linked.
templ repoAction(view RepoView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name }}
	if view.Enabled && !view.Connected {
		@kit.Button(kit.Primary, ctxkeys.AppBasePath(ctx)+"/github/install?next="+appPath+"/deploys", templ.Attributes{"data-connect-github": true}) {
			@kit.IconGitHub("size-4")
			Connect GitHub
		}
	} else if view.Enabled && view.App.Repo != "" {
		@kit.Button(kit.Secondary, "", templ.Attributes{
			"hx-post":          appPath + "/repo/unlink",
			"hx-target":        "#app-repo",
			"hx-swap":          "outerHTML",
			"hx-disable":       "this",
			"hx-confirm":       "Unlink " + view.App.Repo + "? moin stops deploying its pushes. The app keeps running.",
			"data-unlink-repo": true,
		}) {
			Unlink
		}
	}
}

// repoLink links the app to a repo and a branch and deploys it: choose the
// repo, then one of its branches, keep or drop deploy on push, Deploy.
templ repoLink(view RepoView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name }}
	if len(view.Repos) == 0 && !view.Loading {
		@kit.Quiet() {
			moin can read no repo yet.
		}
		<div class="flex flex-wrap gap-2" data-no-repos>
			@repoAccess(view)
			@kit.Button(kit.Secondary, "", templ.Attributes{"hx-get": appPath + "/repo", "hx-target": "#app-repo", "hx-swap": "outerHTML", "hx-disable": "this", "data-refresh-repos": true}) {
				Refresh
			}
		</div>
	} else {
		<form class="flex flex-col gap-4" hx-post={ appPath + "/repo" } hx-target="#app-repo" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-link-repo>
			@kit.CSRF()
			<input type="hidden" name="deploy" value="1"/>
			<div class="grid gap-4 sm:grid-cols-2">
				<div class="min-w-0" hx-get={ appPath + "/repo/branches" } hx-trigger="change" hx-include="closest form" hx-target="#link-branch-field" hx-swap="outerHTML">
					@kit.Field("Repo", "link-repo", "") {
						@kit.Select(kit.SelectProps{ID: "link-repo", Name: "repo", Label: "Repo", Options: repoOptions(view.Repos), Disabled: view.Loading})
					}
				</div>
				@repoBranchField(view.Branches, view.Loading)
			</div>
			<label class="flex min-h-11 cursor-pointer items-center justify-between gap-3 px-1">
				<span class="text-sm font-medium">Deploy every push</span>
				@kit.Switch(templ.Attributes{"id": "link-auto-deploy", "name": "auto_deploy", "value": "1", "checked": true})
			</label>
			<div class="flex flex-wrap items-center gap-2">
				@kit.Button(kit.Primary, "", templ.Attributes{"type": "submit", "disabled": view.Loading}) {
					Deploy
				}
				@repoAccess(view)
			</div>
		</form>
	}
}

// RepoBranchField is the branch select of the link form, for the chosen
// repo; the form asks for it again when the repo changes.
templ RepoBranchField(branches []string) {
	@repoBranchField(branches, false)
}

templ repoBranchField(branches []string, loading bool) {
	<div id="link-branch-field" class="min-w-0">
		@kit.Field("Branch", "link-branch", "") {
			@kit.Select(kit.SelectProps{ID: "link-branch", Name: "branch", Label: "Branch", Options: branchOptions(branches, loading), Disabled: loading})
		}
	</div>
}

// repoAccess links to where on GitHub each connected account picks the
// repos moin may read.
templ repoAccess(view RepoView) {
	{{ install := ctxkeys.AppBasePath(ctx) + "/github/install?next=" + ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name + "/deploys" }}
	for _, installation := range view.Installations {
		if installation.SettingsURL != "" {
			@kit.Button(kit.Secondary, installation.SettingsURL, templ.Attributes{"target": "_blank", "rel": "noopener", "data-github-settings": installation.Account}) {
				Repos on { installation.Account } ↗
			}
		} else {
			@kit.Button(kit.Secondary, install, templ.Attributes{"data-github-settings": installation.Account}) {
				Repos on { installation.Account }
			}
		}
	}
}

// repoLinked is a linked repo: deploy a ref, deploy on push.
templ repoLinked(view RepoView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name }}
	<a href={ templ.SafeURL("https://github.com/" + view.App.Repo) } target="_blank" rel="noopener" class="w-fit max-w-full truncate px-1 font-mono text-sm hover:underline hover:underline-offset-4" data-linked-repo>
		{ view.App.Repo }<span class="text-muted-foreground">{ "@" + view.App.Branch }</span>
	</a>
	<form hx-post={ appPath + "/repo/deploy" } hx-target="#app-repo" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-deploy-ref>
		@kit.CSRF()
		@kit.Field("Deploy a branch, tag or commit", "deploy-ref", "") {
			@kit.Inline() {
				@kit.Input(templ.Attributes{"id": "deploy-ref", "name": "ref", "type": "text", "placeholder": view.App.Branch, "autocomplete": "off", "autocapitalize": "off", "spellcheck": "false"})
				@kit.Button(kit.Secondary, "", templ.Attributes{"type": "submit"}) {
					Deploy
				}
			}
		}
	</form>
	@AutoDeployForm(view.App)
}

// AutoDeployForm is the switch for deploy on push. It saves only that, so
// it never waits for GitHub, and answers itself as stored.
templ AutoDeployForm(app model.App) {
	<form id="auto-deploy-form" hx-post={ ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name + "/repo/auto-deploy" } hx-trigger="change" hx-target="this" hx-swap="outerHTML" hx-disable="find input[type='checkbox']">
		@kit.CSRF()
		<label class="flex min-h-11 cursor-pointer items-center justify-between gap-3 px-1">
			<span class="text-sm font-medium">Deploy every push to { app.Branch }</span>
			@kit.Switch(templ.Attributes{"id": "repo-auto-deploy", "name": "on", "value": "1", "checked": app.AutoDeploy})
		</label>
	</form>
}

func repoOptions(repos []service.GitHubRepoOf) []kit.Option {
	if len(repos) == 0 {
		return []kit.Option{{Value: "", Label: "…"}}
	}
	options := make([]kit.Option, 0, len(repos))
	for _, repo := range repos {
		options = append(options, kit.Option{Value: repo.FullName, Label: repo.FullName})
	}
	return options
}

// branchOptions are the branches to pick; without them the link takes the
// default branch.
func branchOptions(branches []string, loading bool) []kit.Option {
	if loading {
		return []kit.Option{{Value: "", Label: "…"}}
	}
	if len(branches) == 0 {
		return []kit.Option{{Value: "", Label: "Default branch"}}
	}
	options := make([]kit.Option, 0, len(branches))
	for _, branch := range branches {
		options = append(options, kit.Option{Value: branch, Label: branch})
	}
	return options
}
