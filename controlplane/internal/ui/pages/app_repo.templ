package pages

import (
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/service"
	"github.com/axadrn/ops/controlplane/internal/ui/components/alert"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/field"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/components/switch"
	"github.com/axadrn/ops/controlplane/internal/ui/components/checkbox"
	"github.com/axadrn/ops/controlplane/internal/ui/components/input"
	selectcomp "github.com/axadrn/ops/controlplane/internal/ui/components/select"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
	"github.com/axadrn/ops/controlplane/internal/ui/icons"
	"github.com/axadrn/ops/controlplane/internal/ui/utils"
)

// RepoView is the repository panel of an app.
type RepoView struct {
	App model.App
	// Enabled is whether this control plane has the GitHub App; Connected
	// whether the user installed it anywhere.
	Enabled   bool
	Connected bool
	Repos     []service.GitHubRepoOf
	Notice    string
	Error     string
}

// AppRepo is the repository panel: connect GitHub, link a repo and branch,
// deploy a ref, auto deploy on push.
templ AppRepo(view RepoView) {
	@panel(panelProps{
		ID:          "app-repo",
		Heading:     "app-repo-heading",
		Title:       "GitHub",
		Description: "Deploy a branch, tag or commit straight from GitHub, and every push if you like. ops reports the result back as a commit status.",
		Action:      docsLink("/docs/guides/github", "How it works"),
	}) {
		<div class="flex flex-col gap-6">
			if view.Notice != "" {
				@alert.Alert(alert.Props{Attributes: templ.Attributes{"data-repo-notice": true}}) {
					@icon.CircleCheck()
					@alert.Title() {
						{ view.Notice }
					}
				}
			}
			if view.Error != "" {
				@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Attributes: templ.Attributes{"data-repo-error": true}}) {
					@icon.CircleAlert()
					@alert.Title() {
						{ view.Error }
					}
				}
			}
			if !view.Enabled {
				@emptyHint("This control plane has no GitHub App. Deploy from your checkout or from CI instead.", "ops deploy "+view.App.Name)
			} else if !view.Connected {
				@repoConnect(view)
			} else if view.App.Repo == "" {
				@repoLink(view)
			} else {
				@repoLinked(view)
			}
		</div>
	}
}

// repoConnect sends the user to GitHub to install the ops GitHub App.
templ repoConnect(view RepoView) {
	<div class="flex flex-col items-start gap-3">
		<p class="text-sm text-muted-foreground">First connect GitHub and choose the repos ops may read.</p>
		@button.Button(button.Props{Href: ctxkeys.AppBasePath(ctx) + "/github/install?next=" + ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name, Attributes: templ.Attributes{"data-connect-github": true}}) {
			@icons.Github(icons.Props{Class: "size-4"})
			Connect GitHub
		}
	</div>
}

// repoLink links the app to a repo and a branch.
templ repoLink(view RepoView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name }}
	<form class="flex flex-col gap-3" hx-post={ appPath + "/repo" } hx-target="#app-repo" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-link-repo>
		@csrf.Token()
		<div class="grid gap-3 sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
			@field.Field(field.Props{Class: "gap-1 min-w-0"}) {
				@field.Label(field.LabelProps{For: "link-repo"}) {
					Repo
				}
				@selectcomp.Select(selectcomp.Props{Name: "repo", Required: true, DefaultValue: firstRepo(view.Repos), Items: repoItems(view.Repos)}) {
					@selectcomp.Trigger(selectcomp.TriggerProps{ID: "link-repo", Class: "w-full min-w-0 font-mono"}) {
						@selectcomp.Value(selectcomp.ValueProps{Placeholder: "No repo"})
					}
					@selectcomp.Content(selectcomp.ContentProps{AlignItemWithTrigger: utils.Ptr(false), Align: selectcomp.AlignStart}) {
						@selectcomp.Group() {
							for _, repo := range view.Repos {
								@selectcomp.Item(selectcomp.ItemProps{Value: repo.FullName, Class: "font-mono"}) {
									{ repo.FullName }
								}
							}
						}
					}
				}
			}
			@field.Field(field.Props{Class: "gap-1 min-w-0"}) {
				@field.Label(field.LabelProps{For: "link-branch"}) {
					Branch
				}
				@input.Input(input.Props{ID: "link-branch", Name: "branch", Placeholder: "default branch", Class: "font-mono", Attributes: templ.Attributes{"spellcheck": "false", "autocomplete": "off"}})
			}
		</div>
		if len(view.Repos) == 0 {
			<p class="text-sm text-muted-foreground">The ops GitHub App sees no repo yet. <a class="font-medium text-foreground underline underline-offset-4" href={ templ.SafeURL(ctxkeys.AppBasePath(ctx) + "/github/install?next=" + appPath) }>Choose repos on GitHub</a>.</p>
		}
		@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
			@checkbox.Checkbox(checkbox.Props{ID: "link-auto-deploy", Name: "auto_deploy", Value: "1", DefaultChecked: true})
			@field.Label(field.LabelProps{For: "link-auto-deploy", Class: "font-normal"}) {
				Deploy every push to the branch
			}
		}
		<div>
			@button.Button(button.Props{Type: button.TypeSubmit}) {
				Link repo
			}
		</div>
	</form>
}

// repoLinked is a linked repo: deploy a ref, deploy on push, unlink.
templ repoLinked(view RepoView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name }}
	<div class="flex items-center justify-between gap-3">
		<div class="flex min-w-0 flex-col gap-1">
			<p class="text-sm text-muted-foreground">Linked repo</p>
			<p class="truncate font-mono text-sm font-medium" data-linked-repo>{ view.App.Repo }<span class="font-normal text-muted-foreground">{ "@" + view.App.Branch }</span></p>
		</div>
		@button.Button(button.Props{
			Variant:    button.VariantSecondary,
			Size:       button.SizeSm,
			Attributes: templ.Attributes{"hx-post": appPath + "/repo/unlink", "hx-target": "#app-repo", "hx-swap": "outerHTML", "hx-disable": "this", "hx-confirm": "Unlink " + view.App.Repo + "? ops stops deploying its pushes. The app keeps running."},
		}) {
			Unlink
		}
	</div>
	<form class="flex flex-col gap-1" hx-post={ appPath + "/repo/deploy" } hx-target="#app-repo" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-deploy-ref>
		@csrf.Token()
		<label for="deploy-ref" class="text-sm font-medium">Deploy a branch, tag or commit</label>
		<div class="flex flex-col gap-2 sm:flex-row">
			@input.Input(input.Props{ID: "deploy-ref", Name: "ref", Placeholder: view.App.Branch, Class: "min-w-0 font-mono sm:max-w-xs", Attributes: templ.Attributes{"spellcheck": "false", "autocomplete": "off"}})
			@button.Button(button.Props{Type: button.TypeSubmit, Class: "shrink-0"}) {
				Deploy
			}
		</div>
		<p class="text-xs text-muted-foreground">Empty deploys the newest commit on { view.App.Branch }.</p>
	</form>
	<form hx-post={ appPath + "/repo" } hx-trigger="change" hx-target="#app-repo" hx-swap="outerHTML">
		@csrf.Token()
		<input type="hidden" name="repo" value={ view.App.Repo }/>
		<input type="hidden" name="branch" value={ view.App.Branch }/>
		@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
			@field.Content() {
				@field.Label(field.LabelProps{For: "repo-auto-deploy"}) {
					Deploy every push
				}
				@field.Description() {
					A push to { view.App.Branch } deploys it right away.
				}
			}
			@switchcomp.Switch(switchcomp.Props{ID: "repo-auto-deploy", Name: "auto_deploy", Value: "1", DefaultChecked: view.App.AutoDeploy, Attributes: templ.Attributes{"data-auto-deploy": true}})
		}
	</form>
}

// firstRepo is the repo the link form selects first, like a native select.
func firstRepo(repos []service.GitHubRepoOf) string {
	if len(repos) == 0 {
		return ""
	}
	return repos[0].FullName
}

func repoItems(repos []service.GitHubRepoOf) []selectcomp.ItemData {
	items := make([]selectcomp.ItemData, 0, len(repos))
	for _, repo := range repos {
		items = append(items, selectcomp.ItemData{Value: repo.FullName, Label: repo.FullName})
	}
	return items
}
