package pages

import (
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/service"
	"github.com/axadrn/moin/controlplane/internal/ui/components/button"
	"github.com/axadrn/moin/controlplane/internal/ui/components/field"
	"github.com/axadrn/moin/controlplane/internal/ui/components/switch"
	"github.com/axadrn/moin/controlplane/internal/ui/components/checkbox"
	"github.com/axadrn/moin/controlplane/internal/ui/components/input"
	selectcomp "github.com/axadrn/moin/controlplane/internal/ui/components/select"
	"github.com/axadrn/moin/controlplane/internal/ui/csrf"
	"github.com/axadrn/moin/controlplane/internal/ui/icons"
	"github.com/axadrn/moin/controlplane/internal/ui/utils"
)

// RepoView is the repository panel of an app.
type RepoView struct {
	App model.App
	// Enabled is whether this control plane has the GitHub App; Connected
	// whether the user installed it anywhere.
	Enabled   bool
	Connected bool
	Repos     []service.GitHubRepoOf
	// Branches are the branches of the first repo, its default first.
	Branches []string
	// Installations say where on GitHub the user gives moin more repos.
	Installations []model.GitHubInstallation
	// Error says why the repos could not be listed.
	Error string
}

// AppRepo is the repository panel: connect GitHub, link a repo and branch,
// deploy a ref, auto deploy on push.
templ AppRepo(view RepoView) {
	@panel(panelProps{
		ID:          "app-repo",
		Heading:     "app-repo-heading",
		Title:       "GitHub",
		Description: "Deploy a branch, tag or commit straight from GitHub, and every push if you like. moin reports the result back as a commit status.",
		Action:      docsLink("/docs/guides/github", "How it works"),
	}) {
		<div class="flex flex-col gap-6">
			if view.Error != "" {
				@stateAlert(templ.Attributes{"data-repo-error": true}) {
					{ view.Error }
				}
			}
			if !view.Enabled {
				@emptyHint("This control plane has no GitHub App. Deploy from your checkout or from CI instead.", "moin deploy "+view.App.Name)
			} else if !view.Connected {
				@repoConnect(view)
			} else if view.App.Repo == "" {
				@repoLink(view)
			} else {
				@repoLinked(view)
			}
		</div>
	}
}

// repoConnect sends the user to GitHub to install the moin GitHub App.
templ repoConnect(view RepoView) {
	<div class="flex flex-col items-start gap-3">
		<p class="text-sm text-muted-foreground">First connect GitHub and choose the repos moin may read.</p>
		@button.Button(button.Props{Href: ctxkeys.AppBasePath(ctx) + "/github/install?next=" + ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name, Attributes: templ.Attributes{"data-connect-github": true, "hx-boost": "false"}}) {
			@icons.Github(icons.Props{Class: "size-4"})
			Connect GitHub
		}
	</div>
}

// repoLink links the app to a repo and a branch and deploys it: choose the
// repo, then one of its branches, keep or drop deploy on push, Deploy.
templ repoLink(view RepoView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name }}
	if len(view.Repos) == 0 {
		<div class="flex flex-col items-start gap-3" data-no-repos>
			<p class="text-sm text-muted-foreground">The moin GitHub App sees no repo yet. Give it access to the repo you want to deploy, then come back here.</p>
			@repoAccess(view, true)
		</div>
	} else {
		<form class="flex flex-col gap-4" hx-post={ appPath + "/repo" } hx-target="#app-repo" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-link-repo>
			@csrf.Token()
			<input type="hidden" name="deploy" value="1"/>
			<div class="grid gap-3 sm:grid-cols-2">
				@field.Field(field.Props{Class: "gap-1 min-w-0", Attributes: templ.Attributes{"hx-get": appPath + "/repo/branches", "hx-trigger": "change", "hx-include": "closest form", "hx-target": "#link-branch-field", "hx-swap": "outerHTML"}}) {
					@field.Label(field.LabelProps{For: "link-repo"}) {
						Repo
					}
					@selectcomp.Select(selectcomp.Props{Name: "repo", Required: true, DefaultValue: firstRepo(view.Repos), Items: repoItems(view.Repos)}) {
						@selectcomp.Trigger(selectcomp.TriggerProps{ID: "link-repo", Class: "w-full min-w-0 font-mono", Attributes: templ.Attributes{"aria-describedby": "link-repo-hint"}}) {
							@selectcomp.Value(selectcomp.ValueProps{Placeholder: "No repo"})
						}
						@selectcomp.Content(selectcomp.ContentProps{AlignItemWithTrigger: utils.Ptr(false), Align: selectcomp.AlignStart}) {
							@selectcomp.Group() {
								for _, repo := range view.Repos {
									@selectcomp.Item(selectcomp.ItemProps{Value: repo.FullName, Class: "font-mono"}) {
										{ repo.FullName }
									}
								}
							}
						}
					}
					@fieldHint("link-repo", "") {
						The repos the moin GitHub App may read.
					}
				}
				@RepoBranchField(view.Branches)
			</div>
			@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
				@checkbox.Checkbox(checkbox.Props{ID: "link-auto-deploy", Name: "auto_deploy", Value: "1", DefaultChecked: true})
				@field.Label(field.LabelProps{For: "link-auto-deploy", Class: "font-normal"}) {
					Deploy every push to the branch
				}
			}
			<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "self-start"}) {
					Deploy
				}
				@repoAccess(view, false)
			</div>
		</form>
	}
}

// RepoBranchField is the branch select of the link form, for the chosen
// repo; the form asks for it again when the repo changes.
templ RepoBranchField(branches []string) {
	@field.Field(field.Props{ID: "link-branch-field", Class: "gap-1 min-w-0"}) {
		@field.Label(field.LabelProps{For: "link-branch"}) {
			Branch
		}
		@selectcomp.Select(selectcomp.Props{Name: "branch", DefaultValue: firstOf(branches), Items: branchItems(branches)}) {
			@selectcomp.Trigger(selectcomp.TriggerProps{ID: "link-branch", Class: "w-full min-w-0 font-mono", Attributes: templ.Attributes{"aria-describedby": "link-branch-hint"}}) {
				@selectcomp.Value(selectcomp.ValueProps{Placeholder: "default branch"})
			}
			@selectcomp.Content(selectcomp.ContentProps{AlignItemWithTrigger: utils.Ptr(false), Align: selectcomp.AlignStart}) {
				@selectcomp.Group() {
					for _, branch := range branches {
						@selectcomp.Item(selectcomp.ItemProps{Value: branch, Class: "font-mono"}) {
							{ branch }
						}
					}
				}
			}
		}
		@fieldHint("link-branch", "") {
			The first one is the default branch.
		}
	}
}

// repoAccess links to where on GitHub the user gives moin another repo, and
// reloads the panel to see it. primary makes the link the main action, for
// a panel with no repo yet.
templ repoAccess(view RepoView, primary bool) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name }}
	{{ install := ctxkeys.AppBasePath(ctx) + "/github/install?next=" + appPath }}
	<div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm" data-repo-access>
		if !primary {
			<span class="text-muted-foreground">Don't see your repo?</span>
		}
		for _, installation := range view.Installations {
			@button.Button(button.Props{
				Href:       utils.IfElse(installation.SettingsURL != "", installation.SettingsURL, install),
				Variant:    utils.IfElse(primary, button.VariantDefault, button.VariantLink),
				Size:       utils.IfElse(primary, button.SizeDefault, button.SizeSm),
				Class:      utils.IfElse(primary, "", "h-auto px-0"),
				Attributes: templ.Attributes{"target": "_blank", "rel": "noopener", "hx-boost": "false", "data-github-settings": installation.Account},
			}) {
				@icons.Github(icons.Props{Class: "size-4"})
				Give moin access on { installation.Account }
			}
		}
		@button.Button(button.Props{
			Variant:    button.VariantSecondary,
			Size:       utils.IfElse(primary, button.SizeDefault, button.SizeSm),
			Attributes: templ.Attributes{"hx-get": appPath + "/repo", "hx-target": "#app-repo", "hx-swap": "outerHTML", "hx-disable": "this", "data-refresh-repos": true},
		}) {
			Refresh
		}
	</div>
}

// repoLinked is a linked repo: deploy a ref, deploy on push, unlink.
templ repoLinked(view RepoView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name }}
	<div class="flex items-center justify-between gap-3">
		<div class="flex min-w-0 flex-col gap-1">
			<p class="text-sm text-muted-foreground">Linked repo</p>
			<p class="truncate font-mono text-sm font-medium" data-linked-repo>{ view.App.Repo }<span class="font-normal text-muted-foreground">{ "@" + view.App.Branch }</span></p>
		</div>
		@button.Button(button.Props{
			Variant:    button.VariantSecondary,
			Size:       button.SizeSm,
			Attributes: templ.Attributes{"hx-post": appPath + "/repo/unlink", "hx-target": "#app-repo", "hx-swap": "outerHTML", "hx-disable": "this", "hx-confirm": "Unlink " + view.App.Repo + "? moin stops deploying its pushes. The app keeps running."},
		}) {
			Unlink
		}
	</div>
	<form class="flex flex-col gap-1" hx-post={ appPath + "/repo/deploy" } hx-target="#app-repo" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-deploy-ref>
		@csrf.Token()
		<label for="deploy-ref" class="text-sm font-medium">Deploy a branch, tag or commit</label>
		<div class="flex flex-col gap-2 sm:flex-row">
			@input.Input(input.Props{ID: "deploy-ref", Name: "ref", Placeholder: view.App.Branch, Class: "min-w-0 font-mono sm:max-w-xs", Attributes: templ.Attributes{"spellcheck": "false", "autocomplete": "off", "aria-describedby": "deploy-ref-hint"}})
			@button.Button(button.Props{Type: button.TypeSubmit, Class: "shrink-0"}) {
				Deploy
			}
		</div>
		@fieldHint("deploy-ref", "") {
			Empty deploys the newest commit on { view.App.Branch }.
		}
	</form>
	<form hx-post={ appPath + "/repo" } hx-trigger="change" hx-target="#app-repo" hx-swap="outerHTML">
		@csrf.Token()
		<input type="hidden" name="repo" value={ view.App.Repo }/>
		<input type="hidden" name="branch" value={ view.App.Branch }/>
		@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
			@field.Content() {
				@field.Label(field.LabelProps{For: "repo-auto-deploy"}) {
					Deploy every push
				}
				@field.Description() {
					A push to { view.App.Branch } deploys it right away.
				}
			}
			@switchcomp.Switch(switchcomp.Props{ID: "repo-auto-deploy", Name: "auto_deploy", Value: "1", DefaultChecked: view.App.AutoDeploy, Attributes: templ.Attributes{"data-auto-deploy": true}})
		}
	</form>
}

// firstRepo is the repo the link form selects first, like a native select.
func firstRepo(repos []service.GitHubRepoOf) string {
	if len(repos) == 0 {
		return ""
	}
	return repos[0].FullName
}

func firstOf(values []string) string {
	if len(values) == 0 {
		return ""
	}
	return values[0]
}

func branchItems(branches []string) []selectcomp.ItemData {
	items := make([]selectcomp.ItemData, 0, len(branches))
	for _, branch := range branches {
		items = append(items, selectcomp.ItemData{Value: branch, Label: branch})
	}
	return items
}

func repoItems(repos []service.GitHubRepoOf) []selectcomp.ItemData {
	items := make([]selectcomp.ItemData, 0, len(repos))
	for _, repo := range repos {
		items = append(items, selectcomp.ItemData{Value: repo.FullName, Label: repo.FullName})
	}
	return items
}
