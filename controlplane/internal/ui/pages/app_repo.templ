package pages

import (
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/service"
	"github.com/axadrn/ops/controlplane/internal/ui/components/alert"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/card"
	"github.com/axadrn/ops/controlplane/internal/ui/components/checkbox"
	"github.com/axadrn/ops/controlplane/internal/ui/components/input"
	selectcomp "github.com/axadrn/ops/controlplane/internal/ui/components/select"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
	"github.com/axadrn/ops/controlplane/internal/ui/icons"
	"github.com/axadrn/ops/controlplane/internal/ui/utils"
)

// RepoView is the repository panel of an app.
type RepoView struct {
	App model.App
	// Enabled is whether this control plane has the GitHub App; Connected
	// whether the user installed it anywhere.
	Enabled   bool
	Connected bool
	Repos     []service.GitHubRepoOf
	Notice    string
	Error     string
}

// AppRepo is the repository panel: connect GitHub, link a repo and branch,
// deploy a ref, auto deploy on push.
templ AppRepo(view RepoView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name }}
	{{ swap := templ.Attributes{"hx-target": "#app-repo", "hx-swap": "outerHTML"} }}
	@card.Card(card.Props{ID: "app-repo", Class: "block gap-0 py-0 text-base mt-4 min-w-0 overflow-hidden", Attributes: templ.Attributes{"aria-labelledby": "app-repo-heading", "role": "region"}}) {
		@card.Header(card.HeaderProps{Class: panelHeadClasses}) {
			@card.Title(card.TitleProps{ID: "app-repo-heading", Class: "flex items-center gap-2.5", Attributes: templ.Attributes{"role": "heading", "aria-level": "2"}}) {
				@icons.Github(icons.Props{Class: "size-5"})
				Repository
			}
			<a class="text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline" href="/docs/guides/github">How it works</a>
		}
		<div class="px-5 pb-5">
			if view.Notice != "" {
				@alert.Alert(alert.Props{Class: "border-0 mb-3 rounded-2xl bg-live/12 px-4 py-3 text-sm font-medium text-live", Attributes: templ.Attributes{"data-repo-notice": true}}) {
					{ view.Notice }
				}
			}
			if view.Error != "" {
				@alert.Alert(alert.Props{Class: "border-0 mb-3 rounded-2xl bg-failed/12 px-4 py-3 text-sm font-medium text-failed", Attributes: templ.Attributes{"data-repo-error": true}}) {
					{ view.Error }
				}
			}
			if !view.Enabled {
				<p class="text-sm text-muted-foreground">This control plane has no GitHub App. Deploy with <code class="font-mono text-foreground">ops deploy</code> or from CI.</p>
			} else if !view.Connected {
				<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
					<p class="max-w-xl text-sm text-muted-foreground">Connect GitHub to deploy a branch or commit from here, without a checkout, and on every push. ops writes the result as a commit status.</p>
					@button.Button(button.Props{Href: ctxkeys.AppBasePath(ctx) + "/github/install?next=" + appPath, Variant: button.VariantBrand, Size: button.SizeLg, Attributes: templ.Attributes{"data-connect-github": true}}) {
						@icons.Github(icons.Props{Class: "size-4"})
						Connect GitHub
					}
				</div>
			} else if view.App.Repo == "" {
				<form class="grid gap-3 sm:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)_auto]" hx-post={ appPath + "/repo" } { swap... } data-link-repo>
					@csrf.Token()
					<div class="flex min-w-0 flex-col gap-1">
						<label for="link-repo" class="text-xs font-semibold">Repo</label>
						@selectcomp.Select(selectcomp.Props{Name: "repo", Required: true, DefaultValue: firstRepo(view.Repos), Items: repoItems(view.Repos)}) {
							@selectcomp.Trigger(selectcomp.TriggerProps{ID: "link-repo", Class: "w-full min-w-0 rounded-xl font-mono text-[0.8125rem] data-[size=default]:h-10"}) {
								@selectcomp.Value(selectcomp.ValueProps{Placeholder: "No repo"})
							}
							@selectcomp.Content(selectcomp.ContentProps{AlignItemWithTrigger: utils.Ptr(false), Align: selectcomp.AlignStart}) {
								for _, repo := range view.Repos {
									@selectcomp.Item(selectcomp.ItemProps{Value: repo.FullName, Class: "font-mono text-[0.8125rem]"}) {
										{ repo.FullName }
									}
								}
							}
						}
					</div>
					<label class="flex min-w-0 flex-col gap-1">
						<span class="text-xs font-semibold">Branch</span>
						@input.Input(input.Props{Name: "branch", Placeholder: "default branch", Class: "font-mono text-[0.8125rem] md:text-[0.8125rem]", Attributes: templ.Attributes{"spellcheck": "false", "autocomplete": "off"}})
					</label>
					<div class="flex items-end">
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantBrand, Size: button.SizeLg, Class: "w-full"}) {
							Link
						}
					</div>
					<label class="flex cursor-pointer items-center gap-2 text-sm text-muted-foreground sm:col-span-3">
						@checkbox.Checkbox(checkbox.Props{Name: "auto_deploy", Value: "1", DefaultChecked: true})
						Deploy every push to the branch
					</label>
					if len(view.Repos) == 0 {
						<p class="text-sm text-muted-foreground sm:col-span-3">The ops GitHub App sees no repo yet. <a class="font-semibold text-foreground underline underline-offset-4" href={ templ.SafeURL(ctxkeys.AppBasePath(ctx) + "/github/install?next=" + appPath) }>Choose repos on GitHub</a>.</p>
					}
				</form>
			} else {
				<div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
					<div class="min-w-0">
						<p class="truncate font-mono text-[0.9375rem]" data-linked-repo>{ view.App.Repo }<span class="text-muted-foreground">{ "@" + view.App.Branch }</span></p>
						<form class="mt-2 flex items-center gap-2 text-sm text-muted-foreground" hx-post={ appPath + "/repo" } hx-trigger="change" { swap... }>
							@csrf.Token()
							<input type="hidden" name="repo" value={ view.App.Repo }/>
							<input type="hidden" name="branch" value={ view.App.Branch }/>
							<label class="flex cursor-pointer items-center gap-2">
								@checkbox.Checkbox(checkbox.Props{Name: "auto_deploy", Value: "1", DefaultChecked: view.App.AutoDeploy, Attributes: templ.Attributes{"data-auto-deploy": true}})
								Deploy every push to { view.App.Branch }
							</label>
						</form>
					</div>
					<div class="flex flex-wrap items-center gap-2">
						<form class="flex gap-2" hx-post={ appPath + "/repo/deploy" } { swap... } data-deploy-ref>
							@csrf.Token()
							<label for="deploy-ref" class="sr-only">Branch, tag or commit</label>
							@input.Input(input.Props{ID: "deploy-ref", Name: "ref", Placeholder: view.App.Branch, Class: "w-40 font-mono text-[0.8125rem] md:text-[0.8125rem]", Attributes: templ.Attributes{"spellcheck": "false", "autocomplete": "off"}})
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantBrand, Size: button.SizeLg}) {
								Deploy
							}
						</form>
						@button.Button(button.Props{
							Variant:    button.VariantGhost,
							Size:       button.SizeLg,
							Class:      "px-3 text-muted-foreground hover:bg-transparent hover:text-failed",
							Attributes: utils.MergeAttributes(swap, templ.Attributes{"hx-post": appPath + "/repo/unlink", "hx-confirm": "Stop following " + view.App.Repo + "?"}),
						}) {
							Unlink
						}
					</div>
				</div>
			}
		</div>
	}
}

// firstRepo is the repo the link form selects first, like a native select.
func firstRepo(repos []service.GitHubRepoOf) string {
	if len(repos) == 0 {
		return ""
	}
	return repos[0].FullName
}

func repoItems(repos []service.GitHubRepoOf) []selectcomp.ItemData {
	items := make([]selectcomp.ItemData, 0, len(repos))
	for _, repo := range repos {
		items = append(items, selectcomp.ItemData{Value: repo.FullName, Label: repo.FullName})
	}
	return items
}
