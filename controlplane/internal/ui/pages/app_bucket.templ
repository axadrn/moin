package pages

import (
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/service"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/card"
	"github.com/axadrn/ops/controlplane/internal/ui/components/collapsible"
	"github.com/axadrn/ops/controlplane/internal/ui/components/field"
	"github.com/axadrn/ops/controlplane/internal/ui/components/input"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
	"github.com/axadrn/ops/controlplane/internal/ui/layouts"
)

// BucketView is the bucket page: the account's own S3-compatible bucket.
type BucketView struct {
	Storage *service.BackupStorage
	Notice  string
	Error   string
}

templ Bucket(view BucketView) {
	@layouts.App("Bucket") {
		@panelPage(templ.Attributes{"data-bucket-page": true}) {
			@pageHeader("Bucket", "Your own S3-compatible bucket, one for all your servers: Cloudflare R2, AWS S3, Backblaze B2, Hetzner, Exoscale or MinIO.")
			<div id="bucket" class="flex max-w-3xl flex-col gap-6">
				if view.Notice != "" {
					@pageNotice(false, templ.Attributes{"data-bucket-notice": true}) {
						{ view.Notice }
					}
				}
				@bucketForm(view)
				<div class="grid items-stretch gap-4 md:grid-cols-3" role="region" aria-label="What goes in the bucket">
					@bucketUse("Your code", "ops deploy puts it there, your server picks it up and deletes it. Code from GitHub goes straight to your server.")
					@bucketUse("Your backups", "Every change of every SQLite database, and a snapshot before every change. Restore any second of the last week.")
					@bucketUse("Nothing of ours", "ops keeps the key encrypted and only signs short links. Your data never passes through ops.")
				</div>
				if view.Storage != nil {
					@dangerPanel("Remove the bucket", "Backups stop and ops deploy needs a bucket again. What is in the bucket stays there.") {
						@button.Button(button.Props{
							Variant: button.VariantDestructive,
							Attributes: templ.Attributes{
								"hx-post":    ctxkeys.AppBasePath(ctx) + "/bucket/remove",
								"hx-target":  "#bucket",
								"hx-select":  "#bucket",
								"hx-swap":    "outerHTML",
								"hx-confirm": "Remove the bucket? Backups stop and ops deploy needs a bucket again. What is in it stays.",
							},
						}) {
							Remove bucket
						}
					}
				}
			</div>
		}
	}
}

templ bucketUse(title, text string) {
	@card.Card(card.Props{Class: "h-full min-w-0"}) {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "text-base font-semibold"}) {
				{ title }
			}
			@card.Description(card.DescriptionProps{Class: "text-pretty"}) {
				{ text }
			}
		}
	}
}

// bucketForm is the bucket: what is stored, and the form that adds or
// changes it. Without a bucket the form is open.
templ bucketForm(view BucketView) {
	{{ bucketPath := ctxkeys.AppBasePath(ctx) + "/bucket" }}
	@panel(panelProps{
		Title:       bucketTitle(view.Storage != nil),
		Description: bucketDescription(view.Storage != nil),
		Action:      docsLink("/docs/guides/bucket", "How it works"),
		Attrs:       templ.Attributes{"data-backup-storage": true},
	}) {
		<div class="flex flex-col gap-6">
			if view.Storage != nil {
				<dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-6 gap-y-3 text-sm">
					<dt class="text-muted-foreground">Bucket</dt>
					<dd class="truncate font-mono" data-bucket>{ view.Storage.Bucket }{ storagePathText(view.Storage.Path) }</dd>
					<dt class="text-muted-foreground">Endpoint</dt>
					<dd class="truncate font-mono">{ orAWS(view.Storage.Endpoint) }</dd>
					<dt class="text-muted-foreground">Access key</dt>
					<dd class="truncate font-mono">{ view.Storage.AccessKey }</dd>
				</dl>
			}
			@collapsible.Collapsible(collapsible.Props{DefaultOpen: view.Storage == nil || view.Error != "", Class: "flex flex-col gap-6"}) {
				if view.Storage != nil {
					<div>
						@button.Button(button.Props{Variant: button.VariantSecondary, Size: button.SizeSm, Attributes: collapsible.Trigger(ctx)}) {
							Change the bucket
						}
					</div>
				}
				@collapsible.Content() {
					<form class="flex flex-col gap-6" hx-post={ bucketPath } hx-target="#bucket" hx-select="#bucket" hx-swap="outerHTML" data-storage-form>
						@csrf.Token()
						<div class="grid gap-3 sm:grid-cols-2">
							@bucketField("endpoint", "Endpoint", "https://<account>.r2.cloudflarestorage.com", "Empty for AWS S3.", "text", true)
							@bucketField("bucket", "Bucket", "my-ops", "", "text", false)
							@bucketField("path", "Folder", "optional", "A folder inside the bucket.", "text", false)
							@bucketField("access_key", "Access key", "", "", "text", false)
							@bucketField("secret_key", "Secret key", "", "Stored encrypted.", "password", false)
							@bucketField("region", "Region", "auto", "auto for R2.", "text", false)
						</div>
						if view.Error != "" {
							@field.Error(field.ErrorProps{Attributes: templ.Attributes{"data-storage-error": true}}) {
								{ view.Error }
							}
						}
						<div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between">
							<p class="text-xs text-muted-foreground">ops writes and deletes a test file first.</p>
							@button.Button(button.Props{Type: button.TypeSubmit}) {
								Save bucket
							}
						</div>
					</form>
				}
			}
		</div>
	}
}

// bucketField is one field of the bucket form, with a hint below.
templ bucketField(name, label, placeholder, hint, kind string, wide bool) {
	@field.Field(field.Props{Class: "gap-1" + bucketWide(wide)}) {
		@field.Label(field.LabelProps{For: "bucket-" + name}) {
			{ label }
		}
		@input.Input(input.Props{ID: "bucket-" + name, Name: name, Type: kind, Placeholder: placeholder, Attributes: templ.Attributes{"autocomplete": "off", "spellcheck": "false"}})
		if hint != "" {
			<p class="text-xs text-muted-foreground">{ hint }</p>
		}
	}
}

func bucketWide(wide bool) string {
	if wide {
		return " sm:col-span-2"
	}
	return ""
}

func bucketTitle(stored bool) string {
	if stored {
		return "Your bucket"
	}
	return "Add your bucket"
}

func bucketDescription(stored bool) string {
	if stored {
		return "ops deploy and the backups of every server use it."
	}
	return "Deploys from your terminal and backups need it. The keys need read and write access to this one bucket."
}
