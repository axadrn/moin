package pages

import (
	"strconv"

	"github.com/axadrn/moin/controlplane/internal/access"
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
)

templ Billing() {
	{{ subscription := ctxkeys.Subscription(ctx) }}
	{{ workspace := ctxkeys.Workspace(ctx) }}
	{{ basePath := "/app/" + workspace.Slug }}
	@layouts.App("Billing") {
		@panelPage() {
			@kit.Header(kit.Back{Label: "Settings", Href: basePath + "/settings"}, "Billing")
			@billingCurrent(subscription, basePath)
			// The offer shows while there is something to buy: in the trial
			// and when the workspace is read-only, not on a plan it has.
			if billingOffers(subscription) {
				for _, plan := range access.Product.Plans {
					if plan.Purchasable {
						@billingOffer(plan, basePath)
					}
				}
			}
		}
	}
}

// billingCurrent is the plan the workspace has now, in one row: its name and
// state, what it costs and the date that matters, and Manage when Stripe
// keeps the details.
templ billingCurrent(subscription *model.Subscription, basePath string) {
	@kit.List() {
		@kit.Row("") {
			@kit.RowText(planName(subscription.PlanID), billingLine(subscription))
			@billingStatus(subscription)
			if subscription.ProviderCustomerID != nil {
				@kit.Button(kit.Secondary, basePath+"/billing/manage", nil) {
					Manage
				}
			}
		}
	}
}

// billingStatus is the state of the subscription as a status chip.
templ billingStatus(subscription *model.Subscription) {
	{{ kind, word := billingState(subscription) }}
	@kit.Chip(kind) {
		{ word }
	}
}

func billingState(subscription *model.Subscription) (kit.State, string) {
	switch subscription.Status {
	case model.SubscriptionStatusActive:
		if subscription.PlanID == model.SubscriptionPlanFree {
			return kit.StateIdle, "Read-only"
		}
		return kit.StateLive, "Active"
	case model.SubscriptionStatusTrialing:
		return kit.StateRunning, "Trial"
	case model.SubscriptionStatusPastDue:
		return kit.StateWaiting, "Payment due"
	case model.SubscriptionStatusIncomplete:
		return kit.StateIdle, "Payment pending"
	case model.SubscriptionStatusCancelled:
		return kit.StateFailed, "Cancelled"
	}
	return kit.StateFailed, "Ended"
}

// billingLine says what the plan costs and the date that matters next.
func billingLine(subscription *model.Subscription) string {
	date := func() string { return subscription.CurrentPeriodEnd.Format("Jan 2, 2006") }
	switch {
	case subscription.Status == model.SubscriptionStatusTrialing && subscription.CurrentPeriodEnd != nil:
		return "Everything works until " + date() + ". Then moin turns read-only until you subscribe."
	case subscription.PlanID == model.SubscriptionPlanFree:
		return "Your apps keep running. Subscribe to deploy again."
	case subscription.Status == model.SubscriptionStatusCancelled && subscription.CurrentPeriodEnd != nil:
		return subscription.FormatPrice() + ", cancelled. Works until " + date() + "."
	case subscription.CurrentPeriodEnd != nil:
		return subscription.FormatPrice() + ". Next invoice " + date() + "."
	}
	return subscription.FormatPrice()
}

// billingOffer is the plan to buy, like a subscription sheet: the interval,
// one price, one line of what it includes, one button. The interval is a
// pair of radio buttons; CSS shows the price that goes with the checked one.
templ billingOffer(plan access.Plan, basePath string) {
	<form
		action={ templ.SafeURL(basePath + "/billing/checkout") }
		method="POST"
		hx-post={ basePath + "/billing/checkout" }
		hx-swap="none"
		hx-disable="find button[type='submit']"
		class="group/offer flex flex-col items-start gap-6 rounded-4xl bg-card p-6 sm:p-8"
		data-offer
	>
		@kit.CSRF()
		<input type="hidden" name="plan_id" value={ plan.ID }/>
		<div class="flex w-full flex-wrap items-center justify-between gap-4">
			<h2 class="text-base font-medium">{ plan.Name }</h2>
			@kit.Choice("interval", "Pay", []kit.Option{{Value: "yearly", Label: "Yearly"}, {Value: "monthly", Label: "Monthly"}}, "yearly")
		</div>
		<div class="flex flex-col gap-1">
			<p class="flex items-baseline gap-3 group-has-[#interval-monthly:checked]/offer:hidden">
				<span class="text-2xl font-semibold tracking-tight tabular-nums">{ model.FormatPlanPrice(plan.YearlyPrice) }</span>
				<span class="text-muted-foreground">a year</span>
				<span class="text-sm font-medium">Save { yearlySaving(plan) }</span>
			</p>
			<p class="hidden items-baseline gap-3 group-has-[#interval-monthly:checked]/offer:flex">
				<span class="text-2xl font-semibold tracking-tight tabular-nums">{ model.FormatPlanPrice(plan.MonthlyPrice) }</span>
				<span class="text-muted-foreground">a month</span>
			</p>
			<p class="text-muted-foreground">Unlimited servers, apps and teammates.</p>
		</div>
		<div class="flex flex-col items-start gap-3">
			@kit.Button(kit.Primary, "", templ.Attributes{"type": "submit", "data-subscribe": true}) {
				Subscribe
			}
			<p class="text-sm text-muted-foreground">Plus tax where it applies. Cancel any time.</p>
		</div>
	</form>
}

// yearlySaving is how much less a year costs than twelve months, in percent.
func yearlySaving(plan access.Plan) string {
	months := 12 * plan.MonthlyPrice
	if months == 0 {
		return ""
	}
	return strconv.Itoa((months-plan.YearlyPrice)*100/months) + " %"
}

// billingOffers says whether to show the plan to buy: not while a paid,
// granted or provider subscription gives the workspace its plan.
func billingOffers(subscription *model.Subscription) bool {
	if subscription.HasProviderSubscription() {
		return false
	}
	current := subscription.Access()
	return current.State == access.StateTrial || !current.Has(access.FeatureChanges)
}

func planName(planID string) string {
	if plan, ok := access.PlanByID(planID); ok {
		return plan.Name
	}
	return planID
}
