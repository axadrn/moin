package pages

import (
	"github.com/axadrn/moin/controlplane/internal/access"
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/ui/components/badge"
	"github.com/axadrn/moin/controlplane/internal/ui/components/button"
	"github.com/axadrn/moin/controlplane/internal/ui/components/card"
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
	"github.com/axadrn/moin/controlplane/internal/ui/components/status"
	"github.com/axadrn/moin/controlplane/internal/ui/components/tabs"
	"github.com/axadrn/moin/controlplane/internal/ui/csrf"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
)

templ Billing() {
	{{ subscription := ctxkeys.Subscription(ctx) }}
	{{ workspace := ctxkeys.Workspace(ctx) }}
	{{ basePath := "/app/" + workspace.Slug }}
	@layouts.App("Billing") {
		@panelPage() {
			@pageHeader("Billing", "The plan of "+workspace.Name+", the next invoice and the payment details.")
			@billingCurrent(subscription, basePath)
			// The offer shows while there is something to buy: in the trial
			// and when the workspace is read-only, not on a plan it has.
			if billingOffers(subscription) {
				for _, plan := range access.Product.Plans {
					if plan.Purchasable {
						@billingOffer(plan, basePath)
					}
				}
			}
		}
	}
}

// billingCurrent is the plan the workspace has now: its status, what it
// costs, the next date that matters and the way to the Stripe portal.
templ billingCurrent(subscription *model.Subscription, basePath string) {
	@card.Card(card.Props{Class: "min-w-0"}) {
		@card.Header(card.HeaderProps{Class: panelHeaderStack}) {
			@card.Title(card.TitleProps{Class: "flex min-w-0 flex-wrap items-center gap-2 text-base font-semibold", Attributes: templ.Attributes{"role": "heading", "aria-level": "2"}}) {
				{ planName(subscription.PlanID) }
				@billingStatus(subscription)
			}
			if line := billingLine(subscription); line != "" {
				@card.Description() {
					{ line }
				}
			}
			if subscription.ProviderCustomerID != nil {
				@card.Action(card.ActionProps{Class: panelActionStack}) {
					@button.Button(button.Props{Href: basePath + "/billing/manage", Variant: button.VariantSecondary, Size: button.SizeSm, Attributes: templ.Attributes{"hx-boost": "false"}}) {
						Manage subscription
					}
				}
			}
		}
	}
}

// billingStatus is the state of the subscription as a status chip.
templ billingStatus(subscription *model.Subscription) {
	{{ kind, word := billingState(subscription) }}
	@status.Status(status.Props{Kind: kind, Chip: true}) {
		{ word }
	}
}

func billingState(subscription *model.Subscription) (status.Kind, string) {
	switch subscription.Status {
	case model.SubscriptionStatusActive:
		if subscription.PlanID == model.SubscriptionPlanFree {
			return status.KindIdle, "read-only"
		}
		return status.KindLive, "active"
	case model.SubscriptionStatusTrialing:
		return status.KindRunning, "trial"
	case model.SubscriptionStatusPastDue:
		return status.KindWaiting, "payment due"
	case model.SubscriptionStatusIncomplete:
		return status.KindIdle, "payment pending"
	case model.SubscriptionStatusCancelled:
		return status.KindFailed, "cancelled"
	}
	return status.KindFailed, "ended"
}

// billingLine says what the plan costs and the date that matters next.
func billingLine(subscription *model.Subscription) string {
	date := func() string { return subscription.CurrentPeriodEnd.Format("January 2, 2006") }
	switch {
	case subscription.Status == model.SubscriptionStatusTrialing && subscription.CurrentPeriodEnd != nil:
		return "Everything is unlocked until " + date() + ". After that the workspace turns read-only until you subscribe."
	case subscription.PlanID == model.SubscriptionPlanFree:
		return "Read-only: your apps keep running and you can stop and start them. Subscribe to deploy and change things again."
	case subscription.Status == model.SubscriptionStatusCancelled && subscription.CurrentPeriodEnd != nil:
		return subscription.FormatPrice() + ", cancelled. Everything works until " + date() + "."
	case subscription.CurrentPeriodEnd != nil:
		return subscription.FormatPrice() + ", per workspace. Next invoice on " + date() + "."
	}
	return subscription.FormatPrice()
}

// billingOffer is the plan to buy: yearly first, the price, one button to
// Stripe Checkout and what it includes.
templ billingOffer(plan access.Plan, basePath string) {
	@panel(panelProps{
		Title:       plan.Name,
		Description: "One price per workspace, for the whole team.",
		Docs:        "/docs/guides/account#billing",
		Action:      billingInterval(),
		Class:       "pricing-card",
	}) {
		<div class="flex flex-col gap-6">
			<div class="price-yearly flex flex-col gap-2">
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "self-start"}) {
					Save { model.FormatPlanPrice(12*plan.MonthlyPrice - plan.YearlyPrice) } a year
				}
				@planPrice(model.FormatPlanPrice(plan.YearlyPrice), "a year, per workspace")
			</div>
			<div class="price-monthly hidden">
				@planPrice(model.FormatPlanPrice(plan.MonthlyPrice), "a month, per workspace")
			</div>
			<form
				action={ templ.SafeURL(basePath + "/billing/checkout") }
				method="POST"
				class="flex flex-col items-start gap-2"
				hx-post={ basePath + "/billing/checkout" }
				hx-swap="none"
				hx-disable="find button[type='submit']"
			>
				@csrf.Token()
				<input type="hidden" name="plan_id" value={ plan.ID }/>
				<input type="hidden" name="interval" value="yearly"/>
				@button.Button(button.Props{Type: button.TypeSubmit, Attributes: templ.Attributes{"data-subscribe": true}}) {
					<span class="price-yearly">Subscribe for { model.FormatPlanPrice(plan.YearlyPrice) } a year</span>
					<span class="price-monthly hidden">Subscribe for { model.FormatPlanPrice(plan.MonthlyPrice) } a month</span>
				}
				<p class="text-xs text-muted-foreground">Plus sales tax or VAT where it applies, shown at checkout. Cancel any time.</p>
			</form>
			@planBenefits(plan)
			<p class="text-sm text-muted-foreground">
				<span class="font-medium text-foreground">goilerplate buyers:</span> 50% off forever. Your code arrives by email in the next days.
			</p>
		</div>
		<script nonce={ templ.GetNonce(ctx) }>
			(function() {
				const card = document.currentScript.closest('.pricing-card');
				card.addEventListener('click', function(event) {
					const trigger = event.target.closest('[data-billing-interval]');
					if (!trigger) return;
					const interval = trigger.getAttribute('data-billing-interval');
					card.querySelectorAll('.price-monthly').forEach(function(el) { el.classList.toggle('hidden', interval !== 'monthly'); });
					card.querySelectorAll('.price-yearly').forEach(function(el) { el.classList.toggle('hidden', interval !== 'yearly'); });
					card.querySelector('input[name="interval"]').value = interval;
				});
			})();
		</script>
	}
}

// billingInterval switches the offer between the yearly and the monthly
// price.
templ billingInterval() {
	@tabs.Tabs(tabs.Props{DefaultValue: "yearly"}) {
		@tabs.List() {
			@tabs.Trigger(tabs.TriggerProps{Value: "yearly", Attributes: templ.Attributes{"data-billing-interval": "yearly"}}) {
				Yearly
			}
			@tabs.Trigger(tabs.TriggerProps{Value: "monthly", Attributes: templ.Attributes{"data-billing-interval": "monthly"}}) {
				Monthly
			}
		}
	}
}

// planPrice is a price in the number size with what it buys.
templ planPrice(price, per string) {
	<p class="flex flex-wrap items-baseline gap-x-2">
		<span class="text-2xl font-semibold tracking-tight tabular-nums">{ price }</span>
		<span class="text-sm text-muted-foreground">{ per }</span>
	</p>
}

// planBenefits is what a plan includes, two columns from phones up.
templ planBenefits(plan access.Plan) {
	<ul class="grid gap-3 sm:grid-cols-2">
		for _, benefit := range plan.Benefits {
			<li class="flex items-start gap-2 text-sm">
				@icon.Check(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-live"})
				<span>{ benefit }</span>
			</li>
		}
	</ul>
}

// billingOffers says whether to show the plan to buy: not while a paid,
// granted or provider subscription gives the workspace its plan.
func billingOffers(subscription *model.Subscription) bool {
	if subscription.HasProviderSubscription() {
		return false
	}
	current := subscription.Access()
	return current.State == access.StateTrial || !current.Has(access.FeatureChanges)
}

func planName(planID string) string {
	if plan, ok := access.PlanByID(planID); ok {
		return plan.Name
	}
	return planID
}
