package pages

import (
	"github.com/axadrn/moin/controlplane/internal/ui/components/button"
	"github.com/axadrn/moin/controlplane/internal/ui/components/dialog"
	field "github.com/axadrn/moin/controlplane/internal/ui/components/field"
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
	"github.com/axadrn/moin/controlplane/internal/ui/components/input"
)

templ SettingsAvatarFields() {
	@field.Field(field.Props{Class: "gap-1"}) {
		@field.Label(field.LabelProps{For: "avatar"}) {
			Choose an image
		}
		@input.Input(input.Props{Type: "file", ID: "avatar", Name: "avatar", Attributes: templ.Attributes{"accept": "image/jpeg,image/jpg,image/png,image/webp"}})
		<p class="text-xs text-muted-foreground">JPEG, PNG or WebP, up to 5 MB.</p>
	}
}

templ SettingsAvatarUploadButton() {
	@button.Button(button.Props{Type: "submit", Class: "w-full sm:w-auto"}) {
		@icon.Upload()
		Upload picture
	}
}

templ SettingsAvatarDeleteTrigger() {
	@button.Button(button.Props{Type: "button", Variant: button.VariantGhost, Class: "w-full sm:w-auto", Attributes: dialog.Trigger(ctx)}) {
		Remove picture
	}
}

templ SettingsAvatarDeleteDialog() {
	@dialog.Header() {
		@dialog.Title() {
			Remove your picture?
		}
		@dialog.Description() {
			Your initial shows in its place. You can upload a new picture any time.
		}
	}
}

templ SettingsAvatarDeleteCancel() {
	@button.Button(button.Props{Variant: button.VariantSecondary, Attributes: dialog.Close(ctx)}) {
		Cancel
	}
}
