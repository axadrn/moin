package pages

import (
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/dialog"
	field "github.com/axadrn/ops/controlplane/internal/ui/components/field"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/components/input"
)

templ SettingsAvatarFields() {
	<div class="space-y-2">
		@field.Label(field.LabelProps{For: "avatar"}) {
			Choose an image
		}
		@input.Input(input.Props{Type: "file", ID: "avatar", Name: "avatar", Attributes: templ.Attributes{"accept": "image/jpeg,image/jpg,image/png,image/webp"}})
		<p class="text-sm text-muted-foreground">JPEG, PNG or WebP. Max file size 5MB.</p>
	</div>
}

templ SettingsAvatarUploadButton() {
	@button.Button(button.Props{Type: "submit", Class: "w-full sm:w-auto"}) {
		@icon.Upload(icon.Props{Class: "mr-2 size-4"})
		Upload avatar
	}
}

templ SettingsAvatarDeleteTrigger() {
	@button.Button(button.Props{Type: "button", Variant: button.VariantOutline, Class: "w-full sm:w-auto", Attributes: dialog.Trigger(ctx)}) {
		@icon.Trash2(icon.Props{Class: "mr-2 size-4"})
		Remove avatar
	}
}

templ SettingsAvatarDeleteDialog() {
	@dialog.Header() {
		@dialog.Title() {
			Remove avatar
		}
		@dialog.Description() {
			Are you sure you want to remove your avatar? This action cannot be undone.
		}
	}
}

templ SettingsAvatarDeleteCancel() {
	@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) {
		Cancel
	}
}
