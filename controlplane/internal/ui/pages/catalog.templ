package pages

import (
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
	"strconv"
	"strings"
	"time"

	"github.com/axadrn/moin/controlplane/internal/brand"
	"github.com/axadrn/moin/controlplane/internal/catalog"
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/ui/blocks"
	"github.com/axadrn/moin/controlplane/internal/ui/components/button"
	"github.com/axadrn/moin/controlplane/internal/ui/components/card"
	"github.com/axadrn/moin/controlplane/internal/ui/components/field"
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
	"github.com/axadrn/moin/controlplane/internal/ui/components/input"
	"github.com/axadrn/moin/controlplane/internal/ui/csrf"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
	"github.com/axadrn/moin/controlplane/internal/ui/utils"
)

// ---------------------------------------------------------------- public

// Catalog is the public catalog: open source apps to run on your own
// server, each with its newest release.
templ Catalog(view CatalogView) {
	@layouts.Home(layouts.SEOProps{
		Title:       "Self-host open source apps on your own server",
		Description: "Umami, n8n, Grafana, Nextcloud, Vaultwarden and more on your own server in one click. Every version, updates with a backup first.",
		Path:        "/apps",
	}) {
		<main class={ homeWrap, "pt-12 pb-28 sm:pt-20 sm:pb-36" }>
			@catalogBody(view, catalogHeading())
		</main>
	}
}

// catalogHeading is the title of the public catalog.
templ catalogHeading() {
	<h1 class={ typeH2 }>Apps, one click away.</h1>
	<p class={ typeLead, "mt-4 max-w-xl" }>Install open-source apps on your server. Every version, updates with a backup first.</p>
}

// catalogBody lays the catalog out like an index: on large screens the
// search and the categories with their counts in a sticky column at the
// left, the heading, the order and the grid at the right; on small ones
// the heading, the search, a select of the categories, the order and the
// grid. Category, search and order live in the URL, so the page renders
// the same from a shared link, and the search filters as you type.
templ catalogBody(view CatalogView, heading templ.Component) {
	{{ now := time.Now() }}
	{{ shown := 0 }}
	<div class="flex min-w-0 flex-col gap-6 lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-x-12 lg:gap-y-8" data-catalog data-base={ view.Base } data-category={ categorySlug(view.Category) } data-sort={ view.Sort }>
		if heading != nil {
			<header class="min-w-0 lg:col-start-2 lg:row-start-1">
				@heading
			</header>
		}
		// On every screen the search docks under the navbar: on large ones with
		// the categories at the left, on small ones as a bar with the
		// category select, on the page's own background so nothing shows
		// through.
		<aside class="sticky top-[4.25rem] z-40 -mx-4 flex min-w-0 flex-col gap-2 bg-background/95 px-4 py-2 backdrop-blur sm:top-[4.75rem] lg:top-24 lg:z-auto lg:col-start-1 lg:row-span-2 lg:row-start-1 lg:mx-0 lg:gap-6 lg:self-start lg:bg-transparent lg:p-0 lg:backdrop-blur-none">
			<form method="get" action={ templ.SafeURL(view.Base) } role="search">
				if view.Category != "" {
					<input type="hidden" name="category" value={ categorySlug(view.Category) }/>
				}
				if view.Sort == SortName {
					<input type="hidden" name="sort" value={ SortName }/>
				}
				<label for="catalog-search" class="sr-only">Search apps</label>
				@input.Input(input.Props{ID: "catalog-search", Name: "q", Type: "search", Value: view.Query, Placeholder: "Search apps", Class: "w-full", Attributes: templ.Attributes{"autocomplete": "off", "spellcheck": "false", "data-catalog-search": true}})
			</form>
			<nav class="hidden flex-col gap-0.5 lg:flex" aria-label="Categories" data-catalog-categories>
				@catalogCategory(catalogURL(view.Base, "", view.Query, view.Sort), "", "All", view.Total, view.Category == "")
				for _, category := range view.Categories {
					@catalogCategory(catalogURL(view.Base, category, view.Query, view.Sort), categorySlug(category), category, view.Counts[category], view.Category == category)
				}
			</nav>
			<div class="lg:hidden" data-catalog-category-select>
				@kit.Select(kit.SelectProps{ID: "catalog-category", Name: "category-select", Label: "Category", Options: categoryOptions(view), Value: categorySlug(view.Category)})
			</div>
		</aside>
		<section class="flex min-w-0 flex-col gap-4 lg:col-start-2 lg:row-start-2" aria-label="Apps">
			<div class="flex items-center justify-between gap-3">
				<p class="text-sm text-muted-foreground" data-catalog-count>{ strconv.Itoa(len(view.Apps)) } apps</p>
				<nav class="flex shrink-0 gap-0.5 rounded-full bg-muted p-0.5" aria-label="Order">
					@catalogSort(catalogURL(view.Base, view.Category, view.Query, SortUpdated), SortUpdated, "Recently updated", view.Sort != SortName)
					@catalogSort(catalogURL(view.Base, view.Category, view.Query, SortName), SortName, "Name A–Z", view.Sort == SortName)
				</nav>
			</div>
			<ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3" role="list" data-catalog-grid>
				for _, app := range view.Apps {
					{{ hit := catalogMatches(app, view.Query) }}
					if hit {
						{{ shown++ }}
					}
					<li class="min-w-0" hidden?={ !hit } data-search={ catalogSearchText(app) } data-name={ strings.ToLower(app.Entry.Name) } data-released={ releaseUnix(app) }>
						@catalogCard(view.Base, app, now)
					</li>
				}
			</ul>
			<p class={ typeText, "py-8 text-center" } hidden?={ shown > 0 } data-catalog-empty>
				No app called “<span class="text-foreground" data-catalog-query>{ view.Query }</span>” yet.
				<a href="/docs/guides/catalog#add-an-app" class="text-foreground underline underline-offset-4">Ask for it</a>
			</p>
			<p class={ typeText, "mt-6" } data-catalog-missing>
				Missing one? Each app is one folder:
				<a href="/docs/guides/catalog#add-an-app" class="text-foreground underline underline-offset-4">add it with a pull request, or ask us</a>.
			</p>
		</section>
	</div>
	@catalogScript()
}

// catalogCategory is one category of the list on large screens, with its
// count; the picked one stands out.
templ catalogCategory(href, slug, label string, count int, active bool) {
	<a
		href={ templ.SafeURL(href) }
		class={ "flex items-center justify-between gap-3 rounded-lg px-3 py-1.5 text-sm transition-colors outline-none focus-visible:ring-2 focus-visible:ring-ring",
			templ.KV("bg-secondary font-medium text-foreground", active),
			templ.KV("text-muted-foreground hover:bg-muted hover:text-foreground", !active) }
		aria-current={ utils.IfElse(active, "page", "false") }
		data-catalog-category={ slug }
	>
		<span class="truncate">{ label }</span>
		<span class="text-xs tabular-nums text-muted-foreground">{ strconv.Itoa(count) }</span>
	</a>
}

// catalogSort is one order of the small segmented control.
templ catalogSort(href, sort, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		class={ "rounded-full px-3 py-1 text-xs font-medium transition-colors outline-none focus-visible:ring-2 focus-visible:ring-ring",
			templ.KV("bg-background text-foreground shadow-sm", active),
			templ.KV("text-muted-foreground hover:text-foreground", !active) }
		aria-current={ utils.IfElse(active, "true", "false") }
		data-catalog-sort={ sort }
	>{ label }</a>
}

// catalogScript filters the grid as you type and keeps the search in the
// URL and in the links of the categories and orders.
templ catalogScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const root = document.querySelector("[data-catalog]");
			const search = root && root.querySelector("[data-catalog-search]");
			if (!search) return;
			const grid = root.querySelector("[data-catalog-grid]");
			const empty = root.querySelector("[data-catalog-empty]");
			const link = (category, sort, q) => {
				const params = new URLSearchParams();
				if (category) params.set("category", category);
				if (q) params.set("q", q);
				if (sort === "name") params.set("sort", "name");
				const query = params.toString();
				return root.dataset.base + (query ? "?" + query : "");
			};
			search.addEventListener("input", () => {
				const q = search.value.trim();
				const needle = q.toLowerCase();
				let shown = 0;
				for (const item of grid.children) {
					item.hidden = needle !== "" && !item.dataset.search.includes(needle);
					if (!item.hidden) shown++;
				}
				empty.hidden = shown > 0;
				root.querySelector("[data-catalog-count]").textContent = shown + " apps";
				root.querySelector("[data-catalog-query]").textContent = q;
				history.replaceState(null, "", link(root.dataset.category, root.dataset.sort, q));
				for (const a of root.querySelectorAll("[data-catalog-category]")) a.href = link(a.dataset.catalogCategory, root.dataset.sort, q);
				for (const a of root.querySelectorAll("[data-catalog-sort]")) a.href = link(root.dataset.category, a.dataset.catalogSort, q);
			});
			search.closest("form").addEventListener("submit", (event) => event.preventDefault());
			// The category select on small screens goes to its category.
			root.addEventListener("change", (event) => {
				if (event.target.name !== "category-select") return;
				location.href = link(event.target.value, root.dataset.sort, search.value.trim());
			});
		})();
	</script>
}

// catalogCard is one app in the grid, the same shape for every app: tile,
// name and category; a pitch of two lines; and at the bottom one line with
// the newest release and what moin backs up, which never wraps.
templ catalogCard(base string, app CatalogEntryView, now time.Time) {
	<a href={ templ.SafeURL(base + "/" + app.Entry.Slug) } class="group block h-full rounded-4xl outline-none focus-visible:ring-2 focus-visible:ring-ring" data-catalog-app={ app.Entry.Slug }>
		@card.Card(card.Props{Class: "flex h-full flex-col gap-0 rounded-4xl p-6 shadow-none ring-1 ring-foreground/5 transition-colors group-hover:bg-muted/60 sm:p-7"}) {
			<div class="flex items-center gap-4">
				@catalogTile(app.Entry, "size-11 text-lg")
				<div class="min-w-0">
					<h2 class="truncate text-base font-semibold tracking-[-0.01em]">{ app.Entry.Name }</h2>
					<p class="truncate text-sm text-muted-foreground">{ app.Entry.Category }</p>
				</div>
			</div>
			<p class="mt-4 line-clamp-2 min-h-[3rem] text-[15px] leading-6 text-muted-foreground">{ app.Entry.Pitch }</p>
			<div class="mt-auto flex h-7 items-center gap-3 pt-5 text-sm" data-catalog-footer>
				<span class="min-w-0 truncate text-muted-foreground">
					if latest, ok := app.Latest(); ok {
						<span class="font-mono text-foreground">{ latest.Tag }</span>
						if note := releasedShort(latest, now); note != "" {
							{ " · " + note }
						}
					}
				</span>
				@catalogDatabase(app.Entry)
			</div>
		}
	</a>
}

// catalogDatabase is the app's database in the card footer, at a glance:
// a green shield when moin backs it up, a grey crossed one when it does not
// yet. The sentence lives in the tooltip and for screen readers.
templ catalogDatabase(entry catalog.Entry) {
	if entry.Database != "" {
		{{ backed := entry.BackedUp() }}
		<span class={ "ml-auto flex shrink-0 items-center gap-1.5 font-medium", templ.KV("text-foreground", backed), templ.KV("text-muted-foreground", !backed) } title={ databaseSentence(entry) } data-catalog-database={ entry.Database }>
			if backed {
				@icon.ShieldCheck(icon.Props{Class: "size-4 text-live"})
			} else {
				@icon.ShieldOff(icon.Props{Class: "size-4"})
			}
			{ entry.DatabaseName() }
			<span class="sr-only">{ ": " + databaseSentence(entry) }</span>
		</span>
	}
}

// catalogTile is the app's icon, like on a phone's home screen: its logo
// on a white rounded square in both themes, since logos are drawn for a
// white page, or its first letter on the same shape.
templ catalogTile(entry catalog.Entry, class string) {
	if len(entry.Logo) > 0 {
		<span class={ utils.CN("flex shrink-0 items-center justify-center rounded-[28%] bg-white p-2 shadow-sm ring-1 ring-black/5 dark:ring-white/15", class) } aria-hidden="true">
			<img src={ "/apps/" + entry.Slug + "/logo" } alt="" class="size-full object-contain" loading="lazy" decoding="async"/>
		</span>
	} else {
		<span class={ utils.CN("flex shrink-0 items-center justify-center rounded-[28%] bg-foreground font-semibold text-background shadow-sm", class) } aria-hidden="true">
			{ monogram(entry.Name) }
		</span>
	}
}

// CatalogApp is the page of one catalog app: what it is, what moin adds,
// every release, and the way to install it.
templ CatalogApp(view CatalogEntryView, appURL string) {
	@layouts.Home(layouts.SEOProps{
		Title:       "Self-host " + view.Entry.Name + " on your own server",
		Description: view.Entry.Name + ": " + view.Entry.Pitch + " Install it on your own server in one click, with its database backed up, every change.",
		Path:        "/apps/" + view.Entry.Slug,
	}) {
		@templ.Raw(catalogJSONLD(view, appURL+"/apps/"+view.Entry.Slug))
		<main class="pb-28 sm:pb-36">
			<div class={ homeWrap, "pt-12 sm:pt-20" }>
				<a href="/apps" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground">
					@icon.ArrowLeft(icon.Props{Class: "size-4"})
					All apps
				</a>
				<header class="mt-8 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
					<div class="flex min-w-0 items-start gap-5">
						@catalogTile(view.Entry, "size-16 p-3 text-2xl sm:size-20 sm:p-4 sm:text-3xl")
						<div class="min-w-0">
							<h1 class={ typeH2 }>{ view.Entry.Name }</h1>
							<p class={ typeLead, "mt-3 max-w-xl" }>{ view.Entry.Pitch }</p>
						</div>
					</div>
					<div class="flex flex-col gap-3 sm:flex-row">
						@button.Button(button.Props{Href: "/apps/" + view.Entry.Slug + "/install", Size: button.SizeLg, Class: "gap-2", Attributes: templ.Attributes{"data-catalog-install": true}}) {
							Install on your server
							@icon.ArrowRight(icon.Props{Class: "size-4"})
						}
						@button.Button(button.Props{Href: view.Entry.Website, Target: "_blank", Variant: button.VariantSecondary, Size: button.SizeLg, Class: "gap-2", Attributes: templ.Attributes{"rel": "noopener"}}) {
							Website
							@icon.ArrowUpRight(icon.Props{Class: "size-4"})
						}
					</div>
				</header>
				<div class="mt-14 grid grid-cols-1 gap-3 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
					<div class="flex min-w-0 flex-col gap-3">
						@card.Card(card.Props{Class: "gap-0 rounded-4xl p-7 shadow-none ring-0 sm:p-9"}) {
							<div class="min-w-0 text-base leading-7">
								@blocks.Typeset(string(view.Entry.Body))
							</div>
							if view.Entry.Login != "" {
								<p class="mt-5 rounded-2xl bg-muted px-4 py-3 text-sm">{ view.Entry.Login }</p>
							}
						}
						@card.Card(card.Props{Class: "gap-0 rounded-4xl p-7 shadow-none ring-0 sm:p-9"}) {
							<h2 class={ typeH3 }>What { brand.Name } adds</h2>
							<ul class="mt-6 grid gap-4">
								if view.Entry.Database == "postgres" {
									@catalogAdds("Every change of its Postgres in your bucket within a minute, and restored to check it, every day.")
								} else if view.Entry.Database == "sqlite" {
									@catalogAdds("Every change of its SQLite in your bucket within a second, and restored to check it, every day.")
								}
								if note := view.Entry.DatabaseNote(); note != "" {
									@catalogNote(note, view.Entry.BackupRequestURL())
								}
								@catalogAdds("HTTPS on your domain, checked every minute, with an alert when it goes down.")
								@catalogAdds("New releases the hour they ship. Update in one click, with a snapshot first.")
								@catalogAdds("Secrets made for you, encrypted, never in a file.")
							</ul>
						}
					</div>
					<div class="flex min-w-0 flex-col gap-3">
						@catalogVersions(view, 12)
						@card.Card(card.Props{Class: "gap-0 rounded-4xl p-7 shadow-none ring-0"}) {
							<dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-6 gap-y-3 text-sm">
								<dt class="text-muted-foreground">License</dt>
								<dd>{ view.Entry.License }</dd>
								<dt class="text-muted-foreground">Image</dt>
								<dd class="truncate font-mono">{ view.Entry.Image }</dd>
								if view.Entry.Source != "" {
									<dt class="text-muted-foreground">Source</dt>
									<dd class="truncate"><a href={ templ.SafeURL("https://" + view.Entry.Source) } target="_blank" rel="noopener" class="underline-offset-4 hover:underline">{ view.Entry.Source }</a></dd>
								}
							</dl>
						}
					</div>
				</div>
			</div>
		</main>
	}
}

// catalogNote is a plain fact moin cannot promise yet, in the same calm
// form as what it adds.
// catalogNote says what moin does not do for the app's database yet; for a
// database not planned yet, a link asks for it.
templ catalogNote(text, ask string) {
	<li class="flex gap-3 text-base leading-7" data-catalog-database-note>
		<span class="mt-1.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-muted-foreground">
			@icon.Minus(icon.Props{Class: "size-3 stroke-3"})
		</span>
		<span class="text-muted-foreground">
			{ text }
			if ask != "" {
				<a href={ templ.SafeURL(ask) } target="_blank" rel="noopener" class="text-foreground underline underline-offset-4">Want it? Tell us</a>.
			}
		</span>
	</li>
}

templ catalogAdds(text string) {
	<li class="flex gap-3 text-base leading-7">
		<span class="mt-1.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-live text-background">
			@icon.Check(icon.Props{Class: "size-3 stroke-3"})
		</span>
		<span class="text-muted-foreground">{ text }</span>
	</li>
}

// catalogVersions lists the newest releases with when they came out.
templ catalogVersions(view CatalogEntryView, limit int) {
	{{ now := time.Now() }}
	@card.Card(card.Props{Class: "gap-0 rounded-4xl p-7 shadow-none ring-0", Attributes: templ.Attributes{"data-catalog-versions": true}}) {
		<h2 class={ typeH3 }>Versions</h2>
		if len(view.Versions) == 0 {
			<p class={ typeText, "mt-4" }>The releases show once the registry answered. Try again in a minute.</p>
		} else {
			<ul class="mt-5 divide-y divide-border">
				for _, version := range shownVersions(view.Versions, limit) {
					<li class="flex items-center justify-between gap-4 py-2.5 text-sm">
						<span class="font-mono">{ version.Tag }</span>
						<span class="text-muted-foreground">{ released(version, now) }</span>
					</li>
				}
			</ul>
			if more := len(view.Versions) - limit; more > 0 {
				<p class="mt-3 text-sm text-muted-foreground">and { strconv.Itoa(more) } older, every one installable</p>
			}
		}
	}
}

// ---------------------------------------------------------------- app

// CatalogInApp is the catalog inside a workspace.
templ CatalogInApp(view CatalogView) {
	@layouts.App("Catalog") {
		@panelPage() {
			@pageHeader("Catalog", "Open source apps to install in one click. Their databases backed up, every change.")
			@catalogBody(view, nil)
		}
	}
}

// CatalogInstall is the install form of a catalog app in a workspace.
templ CatalogInstall(view CatalogInstallView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ entry := view.App.Entry }}
	@layouts.App("Install " + entry.Name) {
		@panelPage() {
			<div class="flex min-w-0 items-start gap-4">
				@catalogTile(entry, "size-14 p-3 text-2xl")
				<div class="min-w-0">
					<h1 class="text-2xl font-semibold tracking-[-0.02em]">{ entry.Name }</h1>
					<p class="mt-1 text-muted-foreground">{ entry.Pitch }</p>
					if note := entry.DatabaseNote(); note != "" {
						<p class="mt-2 text-sm text-muted-foreground" data-catalog-database-note>{ note }</p>
					}
				</div>
			</div>
			<div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]">
				@panel(panelProps{Heading: "catalog-install-heading", Title: "Install", Description: "moin makes the app on the server, generates its secrets as env vars and deploys it. Every deploy snapshots its database first.", Docs: "/docs/guides/catalog"}) {
					if len(view.Servers) == 0 {
						<p class="text-sm text-muted-foreground">Add a server first. <a class="underline underline-offset-4" href={ templ.SafeURL(basePath + "/servers") }>Servers</a></p>
					} else {
						<form
							id="catalog-install-form"
							class="flex flex-col gap-4"
							hx-post={ basePath + "/catalog/" + entry.Slug + "/install" }
							hx-swap="none"
							hx-disable="find button[type='submit']"
						>
							@csrf.Token()
							@field.Field(field.Props{Class: "gap-1.5"}) {
								@field.Label(field.LabelProps{For: "catalog-version"}) {
									Version
								}
								@kit.Select(kit.SelectProps{ID: "catalog-version", Name: "version", Label: "Version", Options: versionOptions(view.App.Versions), Disabled: len(view.App.Versions) == 0})
							}
							@field.Field(field.Props{Class: "gap-1.5"}) {
								@field.Label(field.LabelProps{For: "catalog-server"}) {
									Server
								}
								@kit.Select(kit.SelectProps{ID: "catalog-server", Name: "server", Label: "Server", Options: serverOptions(view.Servers)})
							}
							@field.Field(field.Props{Class: "gap-1.5"}) {
								@field.Label(field.LabelProps{For: "catalog-name"}) {
									App name
								}
								@input.Input(input.Props{ID: "catalog-name", Name: "name", Type: "text", Value: entry.Slug, Class: "font-mono", Attributes: templ.Attributes{"maxlength": "63", "autocomplete": "off", "spellcheck": "false", "aria-describedby": "catalog-name-hint"}})
								@fieldHint("catalog-name", "") {
									Lowercase letters, digits and dashes.
								}
							}
							@field.Field(field.Props{Class: "gap-1.5"}) {
								@field.Label(field.LabelProps{For: "catalog-domain"}) {
									if entry.NeedsURL() {
										Domain
									} else {
										Domain, optional
									}
								}
								@input.Input(input.Props{ID: "catalog-domain", Name: "domain", Type: "text", Placeholder: entry.Slug + ".example.com", Class: "font-mono placeholder:font-sans", Attributes: templ.Attributes{"autocomplete": "off", "spellcheck": "false", "aria-describedby": "catalog-domain-hint"}})
								@fieldHint("catalog-domain", "") {
									if entry.NeedsURL() {
										{ entry.Name } needs one: its links and sign-in point to it. Point its DNS to the server first.
									} else {
										Point its DNS to the server. Add or change it later on the app page.
									}
								}
							}
							<div>
								@button.Button(button.Props{Type: button.TypeSubmit, Class: "gap-2", Attributes: templ.Attributes{"data-catalog-submit": true}}) {
									@icon.Download(icon.Props{Class: "size-4"})
									Install { entry.Name }
								}
							</div>
						</form>
					}
				}
				@catalogVersions(view.App, 8)
			</div>
		}
	}
}

// CatalogUpdate is the panel of an app from the catalog: the version it
// runs, the newest, and the way to another one.
templ CatalogUpdate(view CatalogUpdateView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<div id="catalog-update" data-catalog-update>
		@card.Card(card.Props{Class: utils.CN("min-w-0 gap-0 p-5 sm:p-6", utils.IfElse(view.Newer, "ring-live/40", ""))}) {
			<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="flex min-w-0 items-center gap-4">
					@catalogTile(view.Entry, "size-11 text-lg")
					<div class="min-w-0">
						if view.Newer {
							<p class="font-medium">{ view.Entry.Name } { view.Latest.Tag } is out</p>
						} else {
							<p class="font-medium">{ view.Entry.Name } { view.Version }</p>
						}
						<p class="text-sm text-muted-foreground">
							if note := view.Entry.DatabaseNote(); note != "" {
								You run { view.Version }. <span data-catalog-database-note>{ note }</span>
							} else {
								You run { view.Version }. A snapshot comes first.
							}
						</p>
					</div>
				</div>
				<form
					class="flex flex-col gap-2 sm:flex-row sm:items-center"
					hx-post={ basePath + "/apps/" + view.App.Name + "/update" }
					hx-swap="none"
					hx-disable="find button[type='submit']"
					hx-confirm={ "Deploy " + view.Entry.Name + " in this version? Going back to an older one may not undo the migrations of a newer one; moin takes a snapshot first." }
				>
					@csrf.Token()
					<label for="catalog-update-version" class="sr-only">Version</label>
					@kit.Select(kit.SelectProps{ID: "catalog-update-version", Name: "version", Label: "Version", Options: versionOptions(view.Versions), Disabled: len(view.Versions) == 0})
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: utils.IfElse(view.Newer, button.VariantDefault, button.VariantSecondary), Attributes: templ.Attributes{"data-catalog-update-submit": true}}) {
						if view.Newer {
							Update
						} else {
							Deploy version
						}
					}
				</form>
			</div>
		}
	</div>
}

func firstVersion(versions []catalog.Version) string {
	if len(versions) == 0 {
		return ""
	}
	return versions[0].Tag
}
