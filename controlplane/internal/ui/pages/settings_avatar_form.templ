package pages

import (
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/dialog"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
	"github.com/axadrn/ops/controlplane/internal/ui/utils"
)

templ SettingsAvatarForm() {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@templ.Fragment("settings-avatar-form") {
		<form
			id="avatar-upload-form"
			enctype="multipart/form-data"
			class="flex flex-col gap-6"
			hx-swap-oob="true"
			hx-post={ basePath + "/account/avatar" }
			hx-encoding="multipart/form-data"
			hx-swap="none"
			hx-disable="find button[type='submit']"
		>
			@csrf.Token()
			@SettingsAvatarFields()
			<div class="flex flex-col gap-2 sm:flex-row-reverse">
				@SettingsAvatarUploadButton()
				@dialog.Dialog(dialog.Props{ID: "delete-avatar-dialog"}) {
					@SettingsAvatarDeleteTrigger()
					@dialog.Content() {
						@SettingsAvatarDeleteDialog()
						@dialog.Footer() {
							@SettingsAvatarDeleteCancel()
							@button.Button(button.Props{Attributes: utils.MergeAttributes(dialog.Close(ctx), templ.Attributes{
								"hx-delete":  basePath + "/account/avatar",
								"hx-swap":    "none",
								"hx-disable": "this",
							})}) {
								Remove
							}
						}
					}
				}
			</div>
		</form>
	}
}
