package pages

import (
	"fmt"
	"strings"
	"unicode/utf8"
	"github.com/axadrn/ops/controlplane/internal/access"
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/ui/components/badge"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	field "github.com/axadrn/ops/controlplane/internal/ui/components/field"
	"github.com/axadrn/ops/controlplane/internal/ui/components/input"
	selectcomp "github.com/axadrn/ops/controlplane/internal/ui/components/select"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
	"github.com/axadrn/ops/controlplane/internal/ui/layouts"
	"github.com/axadrn/ops/controlplane/internal/ui/utils"
)

// workspaceRoleItems gives the role selects their labels, so the trigger
// shows "Admin" instead of the raw value.
var workspaceRoleItems = []selectcomp.ItemData{
	{Value: model.WorkspaceRoleOwner, Label: "Owner"},
	{Value: model.WorkspaceRoleAdmin, Label: "Admin"},
	{Value: model.WorkspaceRoleMember, Label: "Member"},
}

templ Workspace(members []model.WorkspaceMember, invitations []model.WorkspaceInvitation) {
	@layouts.App("Team") {
		@WorkspaceContent(members, invitations)
	}
}

templ WorkspaceContent(members []model.WorkspaceMember, invitations []model.WorkspaceInvitation) {
	{{ workspace := ctxkeys.Workspace(ctx) }}
	{{ viewer := ctxkeys.WorkspaceMember(ctx) }}
	{{ subscription := ctxkeys.Subscription(ctx) }}
	{{ seatLimit := subscription.Access().Limit(access.LimitMembers) }}
	{{ basePath := "/app/" + workspace.Slug }}
	@panelPage(templ.Attributes{"id": "workspace-content", "hx-swap-oob": "true"}) {
		@pageHeader("Team", "Everyone in "+workspace.Name+" works on the same servers and apps. Owners handle billing, admins invite. Teams are free.")
		if viewer.Can(model.WorkspacePermissionManageMembers) {
			@panel(panelProps{Title: "Invite a teammate", Docs: "/docs/guides/team#invite-someone", Description: "They get an email with a link to join. Invitations expire after seven days."}) {
				<form
					action={ templ.SafeURL(basePath + "/workspace/invitations") }
					method="POST"
					class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_10rem_auto] sm:items-end"
					hx-post={ basePath + "/workspace/invitations" }
					hx-swap="none"
					hx-disable="find button[type='submit']"
				>
					@csrf.Token()
					@field.Field(field.Props{Class: "gap-1"}) {
						@field.Label(field.LabelProps{For: "invite-email"}) {
							Email
						}
						@input.Input(input.Props{ID: "invite-email", Name: "email", Type: "email", Placeholder: "teammate@example.com"})
					}
					@field.Field(field.Props{Class: "gap-1"}) {
						@field.Label(field.LabelProps{For: "invite-role"}) {
							Role
						}
						@selectcomp.Select(selectcomp.Props{Name: "role", DefaultValue: model.WorkspaceRoleMember, Items: workspaceRoleItems}) {
							@selectcomp.Trigger(selectcomp.TriggerProps{ID: "invite-role", Class: "w-full"}) {
								@selectcomp.Value()
							}
							@selectcomp.Content(selectcomp.ContentProps{AlignItemWithTrigger: utils.Ptr(false), Align: selectcomp.AlignStart}) {
								@selectcomp.Group() {
									@selectcomp.Item(selectcomp.ItemProps{Value: model.WorkspaceRoleMember}) {
										Member
									}
									@selectcomp.Item(selectcomp.ItemProps{Value: model.WorkspaceRoleAdmin}) {
										Admin
									}
								}
							}
						}
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Send invite
					}
				</form>
			}
		}
		@panel(panelProps{Title: "Members", Docs: "/docs/guides/team#roles", Description: seatText(len(members), seatLimit) + ". Roles apply only inside this workspace.", Body: panelBodyRows}) {
			<ul class="flex flex-col gap-1" role="list">
				for _, member := range members {
					<li class="flex flex-col gap-3 rounded-xl px-3 py-2.5 hover:bg-muted/60 sm:flex-row sm:items-center sm:justify-between" data-member={ member.ID }>
						@personLine(member.Name, member.Email)
						<div class="flex flex-wrap items-center gap-2">
							if viewer.Can(model.WorkspacePermissionManageMembers) && (member.Role != model.WorkspaceRoleOwner || viewer.Can(model.WorkspacePermissionManageOwners)) {
								<form
									action={ templ.SafeURL(basePath + "/workspace/members/" + member.ID + "/role") }
									method="POST"
									class="flex items-center gap-2"
									hx-post={ basePath + "/workspace/members/" + member.ID + "/role" }
									hx-swap="none"
									hx-disable="find button[type='submit']"
								>
									@csrf.Token()
									@selectcomp.Select(selectcomp.Props{Name: "role", DefaultValue: member.Role, Items: workspaceRoleItems}) {
										@selectcomp.Trigger(selectcomp.TriggerProps{Class: "w-32", Attributes: templ.Attributes{"aria-label": "Role of " + member.Name}}) {
											@selectcomp.Value()
										}
										@selectcomp.Content(selectcomp.ContentProps{AlignItemWithTrigger: utils.Ptr(false), Align: selectcomp.AlignStart}) {
											@selectcomp.Group() {
												@selectcomp.Label() {
													Role
												}
												if viewer.Can(model.WorkspacePermissionManageOwners) {
													@selectcomp.Item(selectcomp.ItemProps{Value: model.WorkspaceRoleOwner}) {
														Owner
													}
												}
												@selectcomp.Item(selectcomp.ItemProps{Value: model.WorkspaceRoleAdmin}) {
													Admin
												}
												@selectcomp.Item(selectcomp.ItemProps{Value: model.WorkspaceRoleMember}) {
													Member
												}
											}
										}
									}
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
										Save
									}
								</form>
								<form
									action={ templ.SafeURL(basePath + "/workspace/members/" + member.ID + "/remove") }
									method="POST"
									hx-post={ basePath + "/workspace/members/" + member.ID + "/remove" }
									hx-swap="none"
									hx-disable="find button[type='submit']"
									hx-confirm={ "Remove " + member.Name + " from " + workspace.Name + "?" }
								>
									@csrf.Token()
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost}) {
										Remove
									}
								</form>
							} else {
								@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
									{ model.WorkspaceRoleLabel(member.Role) }
								}
							}
						</div>
					</li>
				}
			</ul>
		}
		if viewer.Can(model.WorkspacePermissionManageMembers) && len(invitations) > 0 {
			@panel(panelProps{Title: "Pending invitations", Docs: "/docs/guides/team#send-an-invitation-again", Description: "Sent, not accepted yet.", Body: panelBodyRows}) {
				<ul class="flex flex-col gap-1" role="list">
					for _, invitation := range invitations {
						<li class="flex flex-col gap-3 rounded-xl px-3 py-2.5 hover:bg-muted/60 sm:flex-row sm:items-center sm:justify-between" data-invitation={ invitation.Email }>
							<div class="flex min-w-0 flex-col gap-1">
								<p class="truncate text-sm font-medium">{ invitation.Email }</p>
								<p class="text-xs text-muted-foreground">{ model.WorkspaceRoleLabel(invitation.Role) } · expires { invitation.ExpiresAt.Local().Format("Jan 2, 2006") }</p>
							</div>
							<div class="flex gap-2">
								<form
									action={ templ.SafeURL(basePath + "/workspace/invitations/" + invitation.ID + "/resend") }
									method="POST"
									hx-post={ basePath + "/workspace/invitations/" + invitation.ID + "/resend" }
									hx-swap="none"
									hx-disable="find button[type='submit']"
								>
									@csrf.Token()
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Size: button.SizeSm}) {
										Resend
									}
								</form>
								<form
									action={ templ.SafeURL(basePath + "/workspace/invitations/" + invitation.ID + "/revoke") }
									method="POST"
									hx-post={ basePath + "/workspace/invitations/" + invitation.ID + "/revoke" }
									hx-swap="none"
									hx-disable="find button[type='submit']"
									hx-confirm={ "Revoke the invitation of " + invitation.Email + "? The link in the email stops working." }
								>
									@csrf.Token()
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
										Revoke
									}
								</form>
							</div>
						</li>
					}
				</ul>
			}
		}
		if viewer.Can(model.WorkspacePermissionManageWorkspace) {
			@panel(panelProps{Title: "Workspace name", Docs: "/docs/guides/team#rename-the-workspace", Description: "Shown in the sidebar and in emails. The address /app/" + workspace.Slug + " stays the same."}) {
				<form
					action={ templ.SafeURL(basePath + "/workspace/name") }
					method="POST"
					class="flex flex-col gap-2 sm:flex-row sm:items-end"
					hx-post={ basePath + "/workspace/name" }
					hx-swap="none"
					hx-disable="find button[type='submit']"
				>
					@csrf.Token()
					<label for="workspace-name" class="sr-only">Workspace name</label>
					@input.Input(input.Props{ID: "workspace-name", Name: "name", Value: workspace.Name, Class: "sm:max-w-sm"})
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
						Save
					}
				</form>
			}
		}
		@dangerPanel("Leave or delete the workspace", "The last Owner must hand ownership to someone else or delete the workspace.", "/docs/guides/team#leave-or-delete-a-workspace") {
			<div class="flex flex-wrap gap-2">
				<form
					action={ templ.SafeURL(basePath + "/workspace/leave") }
					method="POST"
					hx-post={ basePath + "/workspace/leave" }
					hx-swap="none"
					hx-disable="find button[type='submit']"
					hx-confirm={ "Leave " + workspace.Name + "? You lose access to this workspace. A sole Owner must hand ownership to someone else first." }
					data-confirm-action="Leave workspace"
				>
					@csrf.Token()
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
						Leave
					}
				</form>
				if viewer.Can(model.WorkspacePermissionDeleteWorkspace) {
					<form
						action={ templ.SafeURL(basePath + "/workspace/delete") }
						method="POST"
						hx-post={ basePath + "/workspace/delete" }
						hx-swap="none"
						hx-disable="find button[type='submit']"
						hx-confirm={ "Permanently delete " + workspace.Name + "? This deletes the workspace, its members, invitations and activity. A paid subscription must be cancelled and run out first. This cannot be undone." }
						data-confirm-name={ workspace.Name }
						data-confirm-action="Delete permanently"
					>
						@csrf.Token()
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
							Delete workspace
						}
					</form>
				}
			</div>
		}
	}
}

// personLine is a name with the email below, the start of a member row.
templ personLine(name, email string) {
	<div class="flex min-w-0 items-center gap-3">
		<span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium text-muted-foreground" aria-hidden="true">{ initial(name, email) }</span>
		<div class="flex min-w-0 flex-col gap-0.5">
			<p class="truncate text-sm font-medium">{ name }</p>
			if email != "" {
				<p class="truncate text-xs text-muted-foreground">{ email }</p>
			}
		</div>
	</div>
}

// initial is the first letter of a name, or of the email without one.
func initial(name, email string) string {
	r, _ := utf8.DecodeRuneInString(strings.TrimSpace(name + email))
	if r == utf8.RuneError {
		return "?"
	}
	return strings.ToUpper(string(r))
}

// seatText counts the members, and the seats when the plan limits them.
func seatText(members, limit int) string {
	if limit == access.Unlimited {
		if members == 1 {
			return "1 member"
		}
		return fmt.Sprintf("%d members", members)
	}
	return fmt.Sprintf("%d of %d seats", members, limit)
}
