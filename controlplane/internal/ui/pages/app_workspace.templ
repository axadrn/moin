package pages

import (
	"fmt"

	"github.com/axadrn/moin/controlplane/internal/access"
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/ui/csrf"
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
)

templ Workspace(members []model.WorkspaceMember, invitations []model.WorkspaceInvitation) {
	@layouts.App("Team") {
		@WorkspaceContent(members, invitations)
	}
}

// WorkspaceContent is the team: inviting someone, the members with their
// roles, the invitations not accepted yet, the workspace's name, and
// leaving or deleting the workspace at the end. Every action answers it
// whole.
templ WorkspaceContent(members []model.WorkspaceMember, invitations []model.WorkspaceInvitation) {
	{{ workspace := ctxkeys.Workspace(ctx) }}
	{{ viewer := ctxkeys.WorkspaceMember(ctx) }}
	{{ subscription := ctxkeys.Subscription(ctx) }}
	{{ seatLimit := subscription.Access().Limit(access.LimitMembers) }}
	{{ basePath := "/app/" + workspace.Slug }}
	@panelPage(templ.Attributes{"id": "workspace-content", "hx-swap-oob": "true"}) {
		@kit.Header(kit.Back{Label: "Settings", Href: basePath + "/settings"}, "Team")
		if viewer.Can(model.WorkspacePermissionManageMembers) {
			@kit.Card("Invite a teammate", nil) {
				<form
					action={ templ.SafeURL(basePath + "/workspace/invitations") }
					method="POST"
					class="flex flex-col gap-2 sm:flex-row sm:items-center"
					hx-post={ basePath + "/workspace/invitations" }
					hx-swap="none"
					hx-disable="find button[type='submit']"
				>
					@csrf.Token()
					<label for="invite-email" class="sr-only">Email</label>
					@kit.Input(templ.Attributes{"id": "invite-email", "name": "email", "type": "email", "placeholder": "teammate@example.com", "autocomplete": "off"})
					<div class="flex gap-2">
						<div class="w-36 shrink-0">
							@kit.Select(kit.SelectProps{ID: "invite-role", Name: "role", Label: "Role", Options: []kit.Option{{Value: model.WorkspaceRoleMember, Label: "Member"}, {Value: model.WorkspaceRoleAdmin, Label: "Admin"}}, Value: model.WorkspaceRoleMember})
						</div>
						<div class="flex-1 sm:flex-none [&>button]:w-full">
							@kit.Button(kit.Primary, "", templ.Attributes{"type": "submit"}) {
								Send invite
							}
						</div>
					</div>
				</form>
			}
		}
		@kit.Section("In the team", seatCount(seatText(len(members), seatLimit))) {
			@kit.List() {
				for _, member := range members {
					@kit.RowControl(templ.Attributes{"data-member": member.ID}) {
						@kit.Avatar("", member.Name, model.Initial(member.Name+member.Email), "size-9")
						@kit.RowText(member.Name, member.Email)
						if viewer.Can(model.WorkspacePermissionManageMembers) && (member.Role != model.WorkspaceRoleOwner || viewer.Can(model.WorkspacePermissionManageOwners)) {
							<div class="flex w-full items-center gap-2 sm:w-auto">
								<form
									action={ templ.SafeURL(basePath + "/workspace/members/" + member.ID + "/role") }
									method="POST"
									class="w-36 shrink-0"
									hx-post={ basePath + "/workspace/members/" + member.ID + "/role" }
									hx-trigger="change"
									hx-swap="none"
								>
									@csrf.Token()
									@kit.Select(kit.SelectProps{ID: "role-" + member.ID, Name: "role", Label: "Role of " + member.Name, Options: roleOptions(viewer.Can(model.WorkspacePermissionManageOwners)), Value: member.Role})
								</form>
								@kit.Button(kit.Danger, "", templ.Attributes{
									"hx-post":    basePath + "/workspace/members/" + member.ID + "/remove",
									"hx-swap":    "none",
									"hx-disable": "this",
									"hx-confirm": "Remove " + member.Name + " from " + workspace.Name + "?",
								}) {
									Remove
								}
							</div>
						} else {
							<span class="shrink-0 text-sm text-muted-foreground">{ model.WorkspaceRoleLabel(member.Role) }</span>
						}
					}
				}
			}
		}
		if viewer.Can(model.WorkspacePermissionManageMembers) && len(invitations) > 0 {
			@kit.Section("Invitations", nil) {
				@kit.List() {
					for _, invitation := range invitations {
						@kit.RowControl(templ.Attributes{"data-invitation": invitation.Email}) {
							@kit.RowText(invitation.Email, model.WorkspaceRoleLabel(invitation.Role)+" · expires "+invitation.ExpiresAt.Local().Format("Jan 2, 2006"))
							<div class="flex w-full items-center gap-2 sm:w-auto">
								@kit.Button(kit.Secondary, "", templ.Attributes{
									"hx-post":    basePath + "/workspace/invitations/" + invitation.ID + "/resend",
									"hx-swap":    "none",
									"hx-disable": "this",
								}) {
									Resend
								}
								@kit.Button(kit.Danger, "", templ.Attributes{
									"hx-post":    basePath + "/workspace/invitations/" + invitation.ID + "/revoke",
									"hx-swap":    "none",
									"hx-disable": "this",
									"hx-confirm": "Revoke the invitation of " + invitation.Email + "? The link in the email stops working.",
								}) {
									Revoke
								}
							</div>
						}
					}
				}
			}
		}
		if viewer.Can(model.WorkspacePermissionManageWorkspace) {
			@kit.Card("Workspace name", nil) {
				<form
					action={ templ.SafeURL(basePath + "/workspace/name") }
					method="POST"
					hx-post={ basePath + "/workspace/name" }
					hx-swap="none"
					hx-disable="find button[type='submit']"
				>
					@csrf.Token()
					<label for="workspace-name" class="sr-only">Workspace name</label>
					@kit.Inline() {
						@kit.Input(templ.Attributes{"id": "workspace-name", "name": "name", "value": workspace.Name, "autocomplete": "off"})
						@kit.Button(kit.Secondary, "", templ.Attributes{"type": "submit"}) {
							Save
						}
					}
				</form>
			}
		}
		@kit.List() {
			@kit.RowButton(true, templ.Attributes{
				"hx-post":             basePath + "/workspace/leave",
				"hx-swap":             "none",
				"hx-disable":          "this",
				"hx-confirm":          "Leave " + workspace.Name + "? You lose access to it. A sole Owner hands ownership to someone else first.",
				"data-confirm-action": "Leave workspace",
			}) {
				<span class="font-medium">Leave workspace</span>
			}
			if viewer.Can(model.WorkspacePermissionDeleteWorkspace) {
				@kit.RowButton(true, templ.Attributes{
					"hx-post":             basePath + "/workspace/delete",
					"hx-swap":             "none",
					"hx-disable":          "this",
					"hx-confirm":          "Delete " + workspace.Name + " for good? Its team, invitations and activity go with it. A paid subscription must be cancelled and run out first.",
					"data-confirm-name":   workspace.Name,
					"data-confirm-action": "Delete permanently",
				}) {
					<span class="font-medium">Delete workspace</span>
				}
			}
		}
	}
}

// seatCount is the count at the end of the members' title.
templ seatCount(text string) {
	<span class="text-sm text-muted-foreground tabular-nums">{ text }</span>
}

// roleOptions are the roles a viewer may give; only owners make owners.
func roleOptions(owners bool) []kit.Option {
	options := []kit.Option{{Value: model.WorkspaceRoleAdmin, Label: "Admin"}, {Value: model.WorkspaceRoleMember, Label: "Member"}}
	if owners {
		options = append([]kit.Option{{Value: model.WorkspaceRoleOwner, Label: "Owner"}}, options...)
	}
	return options
}

// seatText counts the members, and the seats when the plan limits them.
func seatText(members, limit int) string {
	if limit == access.Unlimited {
		if members == 1 {
			return "1 person"
		}
		return fmt.Sprintf("%d people", members)
	}
	return fmt.Sprintf("%d of %d seats", members, limit)
}
