package pages

import (
	"github.com/axadrn/moin/controlplane/internal/ui/components/alert"
	"github.com/axadrn/moin/controlplane/internal/ui/components/badge"
	switchcomp "github.com/axadrn/moin/controlplane/internal/ui/components/switch"
	"strings"

	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/service"
	"github.com/axadrn/moin/controlplane/internal/ui/components/button"
	"github.com/axadrn/moin/controlplane/internal/ui/components/field"
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
	"github.com/axadrn/moin/controlplane/internal/ui/components/input"
	"github.com/axadrn/moin/controlplane/internal/ui/utils"
	"github.com/axadrn/moin/controlplane/internal/ui/csrf"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
	"github.com/axadrn/moin/protocol"
)

// SecurityView is the security page of a server.
type SecurityView struct {
	Server       model.Server
	Integrations service.Integrations
}

// serverAccess is the row on a server card that says how it is reached and
// what protects it. A check marks a protection that is on.
templ serverAccess(server model.Server) {
	<div class="flex flex-wrap items-center gap-1.5" data-server-access>
		if server.Tunnel {
			@accessBadge("Cloudflare Tunnel", true, nil)
		} else {
			@accessBadge("Ports 80, 443", false, nil)
		}
		if server.Firewall {
			@accessBadge("Firewall", true, nil)
		}
		if server.SSHTailscale {
			@accessBadge("SSH on Tailscale", true, nil)
		}
		if rules := service.ServerRules(server); rules != nil {
			@accessBadge("Rules", true, templ.Attributes{"title": strings.Join(rules.Lines(), "\n"), "data-server-rules": true})
		}
	</div>
}

templ accessBadge(label string, on bool, attrs templ.Attributes) {
	@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-muted-foreground", Attributes: attrs}) {
		if on {
			@icon.Check(icon.Props{Class: "text-live"})
		}
		{ label }
	}
}

// ServerSecurity is the page of one server: its facts, how it is reached,
// what the agent set up, its rules, the keys all servers share, and the way
// to remove it.
templ ServerSecurity(view SecurityView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ securityPath := basePath + "/servers/" + view.Server.ID + "/security" }}
	@layouts.AppShell(layouts.AppProps{Title: view.Server.Name + " security", Crumbs: []layouts.Crumb{{Label: "Servers", Href: basePath + "/servers"}, {Label: view.Server.Name}, {Label: "Security"}}}) {
		@panelPage(templ.Attributes{"data-server-security": view.Server.Name}) {
			<div class="flex flex-col gap-6">
				@statusHeader(view.Server.Name, serverStatus(view.Server), "Close the ports, keep SSH on your tailnet, drop the rest. Flip the switches, then press Apply.")
				@serverTabs(view.Server, "security")
			</div>
			<div id="server-added" class="empty:hidden"></div>
			<div id="server-security" class="flex flex-col gap-6">
				@securityState(view, securityPath)
				@securityKeys(view)
				@serverRules(view.Server)
			</div>
			@panel(panelProps{
				Title:       "Install command",
				Docs:        "/docs/guides/servers#a-new-install-command",
				Description: "A new one-time command. The old one stops working.",
			}) {
				<div>
					@button.Button(button.Props{
						Variant:    button.VariantSecondary,
						Attributes: templ.Attributes{"hx-post": basePath + "/servers/" + view.Server.ID + "/install", "hx-swap": "none", "hx-disable": "this", "data-new-install": view.Server.Name},
					}) {
						New install command
					}
				</div>
			}
			@panel(panelProps{Title: "Name", Docs: "/docs/guides/servers#rename-a-server", Description: "Lowercase letters, digits and dashes."}) {
				<form
					class="flex flex-col gap-2 sm:flex-row"
					hx-post={ basePath + "/servers/" + view.Server.ID + "/name" }
					hx-target="#main"
					hx-select="#main"
					hx-swap="outerHTML"
					hx-disable="find button[type='submit']"
					data-rename-server
				>
					@csrf.Token()
					<label for="server-rename" class="sr-only">Server name</label>
					@input.Input(input.Props{ID: "server-rename", Name: "name", Type: "text", Value: view.Server.Name, Class: "min-w-0 sm:max-w-sm", Attributes: templ.Attributes{"maxlength": "63", "autocomplete": "off", "spellcheck": "false"}})
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
						Save
					}
				</form>
			}
			@dangerPanel("Remove this server", utils.IfElse(view.Server.Online, "Remove its apps first. Then moin disconnects its agent, and the agent's token stops working. The next page shows the command that removes the agent there.", "It is offline, so its apps go with it. They stay on the server with their data if it comes back; remove them there with moin agent uninstall --apps. The agent's token stops working."), "/docs/guides/servers#remove-a-server") {
				@button.Button(button.Props{
					Variant: button.VariantDestructive,
					Attributes: templ.Attributes{
						"hx-delete":          basePath + "/servers/" + view.Server.ID,
						"hx-swap":            "none",
						"hx-disable":         "this",
						"hx-confirm":         utils.IfElse(view.Server.Online, "Remove "+view.Server.Name+"? Its agent is disconnected.", "Remove "+view.Server.Name+" and its apps? It is offline: the apps stay on the server if it comes back."),
						"data-confirm-name":  view.Server.Name,
						"data-remove-server": view.Server.Name,
					},
				}) {
					Remove server
				}
			}
		}
		@securityScript()
	}
}

// securityKeys are the Cloudflare token and the Tailscale key. The fields
// only add or replace a key; a stored key has its own remove button.
templ securityKeys(view SecurityView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@panel(panelProps{Title: "Integrations", Docs: "/docs/guides/security#keys", Description: "For every server of this workspace, stored encrypted."}) {
		<form class="flex flex-col gap-6" hx-post={ basePath + "/integrations" } hx-target="#server-security" hx-select="#server-security" hx-swap="outerHTML" hx-disable="find button[type='submit']" hx-vals={ templ.JSONString(map[string]string{"server": view.Server.ID}) } data-integrations-form>
			@csrf.Token()
			<div class="grid items-start gap-3 lg:grid-cols-2">
				@keyField("cloudflare-token", "cloudflare_token", "Cloudflare API token", "Tunnel Edit, DNS Edit", view.Integrations.Cloudflare, "Stored for account "+view.Integrations.CloudflareAccount+".", "For the tunnel: Tunnel Edit and DNS Edit. Zone Settings Edit is optional, for Always Use HTTPS.")
				@keyField("tailscale-key", "tailscale_key", "Tailscale auth key", "tskey-auth-…", view.Integrations.Tailscale, "Stored.", "For SSH on Tailscale: a reusable auth key.")
			</div>
			<div class="flex flex-wrap justify-end gap-2">
				if view.Integrations.Cloudflare {
					@removeKeyButton(view.Server.ID, "cloudflare", "Remove Cloudflare token", "Remove the Cloudflare API token? Turn tunnels off first: without the token moin cannot delete them in Cloudflare.")
				}
				if view.Integrations.Tailscale {
					@removeKeyButton(view.Server.ID, "tailscale", "Remove Tailscale key", "Remove the Tailscale auth key? The next change of a server's security opens SSH again on every interface.")
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
					Save keys
				}
			</div>
		</form>
	}
}

templ keyField(id, name, label, placeholder string, stored bool, storedText, help string) {
	@field.Field(field.Props{Class: "gap-1"}) {
		@field.Label(field.LabelProps{For: id}) {
			{ label }
		}
		@input.Input(input.Props{ID: id, Name: name, Type: "password", Placeholder: utils.IfElse(stored, "Paste a new one to replace it", placeholder), Attributes: templ.Attributes{"autocomplete": "off", "aria-describedby": id + "-hint"}})
		@fieldHint(id, "") {
			if stored {
				<span class="inline-flex items-center gap-1 text-live">
					@icon.Check(icon.Props{Class: "size-3.5"})
					{ storedText }
				</span>
			} else {
				{ help }
			}
		}
	}
}

// securityScript reloads the switches and the report when the server
// changes, like the servers page, but not while a flipped switch waits for
// Apply or the server is being removed.
templ securityScript() {
	<script nonce={ templ.GetNonce(ctx) } data-workspace={ ctxkeys.Workspace(ctx).Slug }>
		(() => {
			const events = new EventSource(`/api/v1/servers/events?workspace=${encodeURIComponent(document.currentScript.dataset.workspace)}`);
			const waiting = () => {
				if (document.querySelector("[data-remove-server]:disabled")) return true;
				const form = document.querySelector("[data-security-form]");
				if (!form) return false;
				return [...form.querySelectorAll("input[type=checkbox][name]")].some((box) => {
					const was = form.querySelector(`input[name="was_${box.name}"]`);
					return was && box.checked !== (was.value === "1");
				});
			};
			events.addEventListener("servers", () => {
				if (!waiting()) document.body.dispatchEvent(new Event("security-changed"));
			});
			document.addEventListener("htmx:before:history:update", () => events.close(), { once: true });
		})();
	</script>
}

// securityState is the switches and what the agent set up. The page
// reloads it when the server changes, unless a switch waits for Apply.
templ securityState(view SecurityView, securityPath string) {
	{{ report := service.SecurityReport(view.Server) }}
	<div id="security-state" class="flex flex-col gap-6" hx-get={ securityPath } hx-trigger="security-changed from:body" hx-select="#security-state" hx-swap="outerHTML">
		@panel(panelProps{Title: "Access", Description: "How the internet reaches this server.", Docs: "/docs/guides/security"}) {
			<form class="flex flex-col gap-6" hx-post={ securityPath } hx-target="#server-security" hx-select="#server-security" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-security-form>
				@csrf.Token()
				// What the page showed: Apply changes only the switches flipped here
				// and keeps what changed elsewhere meanwhile.
				<input type="hidden" name="was_tunnel" value={ onValue(view.Server.Tunnel) }/>
				<input type="hidden" name="was_ssh_tailscale" value={ onValue(view.Server.SSHTailscale) }/>
				<input type="hidden" name="was_firewall" value={ onValue(view.Server.Firewall) }/>
				<div class="flex flex-col gap-6">
					@securityToggle("tunnel", "Cloudflare Tunnel", "App traffic comes in through a tunnel from Cloudflare. Ports 80 and 443 close and Cloudflare serves HTTPS.", view.Server.Tunnel, !view.Integrations.Cloudflare, "Add a Cloudflare API token under Integrations first.")
					@securityToggle("ssh_tailscale", "SSH only on Tailscale", "The server joins your tailnet and SSH answers only there, once Tailscale is up.", view.Server.SSHTailscale, !view.Integrations.Tailscale, "Add a Tailscale auth key under Integrations first.")
					@securityToggle("firewall", "Firewall", "Drops every inbound connection the server does not need.", view.Server.Firewall, false, "")
				</div>
				<div class="flex justify-end">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Apply
					}
				</div>
			</form>
		}
		if report != nil {
			@panel(panelProps{Title: "What the agent set up", Docs: "/docs/guides/security#see-what-is-open", Description: "As the agent last reported it.", Attrs: templ.Attributes{"data-security-report": true}}) {
				<div class="flex flex-col gap-6">
					<dl class="grid gap-4 sm:grid-cols-3">
						@backupFact("Traffic", proxyText(report.Proxy), "")
						@backupFact("Open to everyone", portsText(*report, view.Server.SSHTailscale), portsNote(report.Firewall))
						@backupFact("Tailnet", tailnetText(report.TailscaleIP, view.Integrations.Tailscale, view.Server.SSHTailscale), tailnetNote(report.TailscaleIP, view.Integrations.Tailscale, view.Server.SSHTailscale))
					</dl>
					for _, problem := range report.Problems {
						@alert.Alert(alert.Props{Class: "border-0 bg-running/12 text-running"}) {
							@icon.TriangleAlert()
							@alert.Title(alert.TitleProps{Class: "font-normal"}) {
								{ problem }
							}
						}
					}
				</div>
			}
		}
	</div>
}

// removeKeyButton takes one stored key away; the fields only add or replace.
templ removeKeyButton(server, key, label, question string) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@button.Button(button.Props{
		Variant: button.VariantGhost,
		Attributes: templ.Attributes{
			"hx-post":         basePath + "/integrations",
			"hx-vals":         `{"server":"` + server + `","remove":"` + key + `"}`,
			"hx-target":       "#server-security",
			"hx-select":       "#server-security",
			"hx-swap":         "outerHTML",
			"hx-disable":      "this",
			"hx-confirm":      question,
			"data-remove-key": key,
		},
	}) {
		{ label }
	}
}

templ securityToggle(name, title, text string, on, locked bool, lockedText string) {
	<label class="flex cursor-pointer items-start justify-between gap-6" data-toggle={ name }>
		<span class="flex min-w-0 flex-col gap-1">
			<span class="text-sm font-medium">{ title }</span>
			<span class="text-sm text-pretty text-muted-foreground">{ text }</span>
			if locked && !on {
				<span class="text-xs text-running">{ lockedText }</span>
			}
		</span>
		@switchcomp.Switch(switchcomp.Props{Name: name, Value: "1", Checked: on, Disabled: locked && !on, Class: "mt-0.5"})
	</label>
}

func proxyText(proxy string) string {
	if proxy == "tunnel" {
		return "Cloudflare Tunnel"
	}
	return "Ports 80, 443"
}

func onValue(on bool) string {
	if on {
		return "1"
	}
	return "0"
}

// portsText is what is open to everyone. Without the firewall it is what
// moin itself listens on; any other service on the server is open too.
func portsText(report protocol.ServerConfigResult, sshOnTailscale bool) string {
	ports := report.OpenPorts
	if !report.Firewall {
		ports = nil
		if !sshOnTailscale || report.TailscaleIP == "" {
			ports = append(ports, "22/tcp")
		}
		if report.Proxy != "tunnel" {
			ports = append(ports, "80/tcp", "443/tcp")
		}
	}
	if len(ports) == 0 {
		return "nothing"
	}
	return strings.Join(ports, ", ")
}

func portsNote(firewall bool) string {
	if firewall {
		return "Everything else is dropped."
	}
	return "Firewall off: every other listening port too."
}

// tailnetText and tailnetNote say where the server stands on the tailnet.
// The agent joins it only for SSH on Tailscale.
func tailnetText(ip string, key, sshOnTailscale bool) string {
	switch {
	case ip != "":
		return ip
	case key && sshOnTailscale:
		return "not up"
	case key:
		return "not used"
	}
	return "not joined"
}

func tailnetNote(ip string, key, sshOnTailscale bool) string {
	switch {
	case ip != "":
		return "The server's address on your tailnet."
	case key && sshOnTailscale:
		return "The server could not join your tailnet yet."
	case key:
		return "Turn on SSH only on Tailscale: the server then joins your tailnet."
	}
	return "Add a Tailscale auth key below: the server joins your tailnet, then SSH can answer only there."
}

// serverRules shows /etc/moin/rules of the server as the agent reported it.
// Only the owner of the server changes them, on the server.
templ serverRules(server model.Server) {
	{{ rules := service.ServerRules(server) }}
	@panel(panelProps{Title: "Rules", Description: rulesDescription(len(rules.Lines()) > 0), Docs: "/docs/guides/security#rules", Attrs: templ.Attributes{"data-rules-panel": true}}) {
		if len(rules.Lines()) == 0 {
			<p class="text-sm text-pretty text-muted-foreground">
				To turn off data or logs, or to allow deploys only from your own repos, write <code class="font-mono text-foreground">/etc/moin/rules</code> on the server.
			</p>
		} else {
			<div class="flex flex-col gap-1">
				<p class="text-xs text-muted-foreground">From <code class="font-mono">/etc/moin/rules</code> on the server</p>
				<pre class="overflow-x-auto rounded-2xl bg-muted px-4 py-3 font-mono text-xs leading-relaxed" data-rules>{ strings.Join(rules.Lines(), "\n") }</pre>
			</div>
		}
	}
}

func rulesDescription(set bool) string {
	if set {
		return "The agent refuses everything these rules do not allow. Nobody can change them through moin."
	}
	return "No rules: moin may do everything on this server."
}
