package pages

import (
	"github.com/axadrn/ops/controlplane/internal/ui/components/alert"
	"github.com/axadrn/ops/controlplane/internal/ui/components/badge"
	"github.com/axadrn/ops/controlplane/internal/ui/components/card"
	switchcomp "github.com/axadrn/ops/controlplane/internal/ui/components/switch"
	"strings"

	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/service"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/input"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
	"github.com/axadrn/ops/controlplane/internal/ui/layouts"
	"github.com/axadrn/ops/protocol"
)

// SecurityView is the security page of a server.
type SecurityView struct {
	Server       model.Server
	Integrations service.Integrations
	Notice       string
	Error        string
}

// serverAccess is the line on a server card that says how it is reached.
templ serverAccess(server model.Server) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<div class="mt-4 flex flex-wrap items-center gap-1.5 border-t pt-4" data-server-access>
		if server.Tunnel {
			@badge.Badge(badge.Props{Class: "h-auto leading-4 rounded-full bg-live/12 px-2.5 py-1 text-xs font-semibold text-live"}) {
				Cloudflare Tunnel
			}
		} else {
			@badge.Badge(badge.Props{Class: "h-auto leading-4 rounded-full bg-secondary px-2.5 py-1 text-xs font-semibold text-muted-foreground"}) {
				Ports 80, 443
			}
		}
		if server.Firewall {
			@badge.Badge(badge.Props{Class: "h-auto leading-4 rounded-full bg-live/12 px-2.5 py-1 text-xs font-semibold text-live"}) {
				Firewall
			}
		}
		if server.SSHTailscale {
			@badge.Badge(badge.Props{Class: "h-auto leading-4 rounded-full bg-live/12 px-2.5 py-1 text-xs font-semibold text-live"}) {
				SSH on Tailscale
			}
		}
		if rules := service.ServerRules(server); rules != nil {
			@badge.Badge(badge.Props{Class: "h-auto leading-4 rounded-full bg-live/12 px-2.5 py-1 text-xs font-semibold text-live", Attributes: templ.Attributes{"title": strings.Join(rules.Lines(), "\n"), "data-server-rules": true}}) {
				Rules
			}
		}
		<a href={ templ.SafeURL(basePath + "/servers/" + server.ID + "/security") } class="ml-auto text-xs font-semibold text-muted-foreground hover:text-foreground" data-security-link>Security</a>
	</div>
}

templ ServerSecurity(view SecurityView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ securityPath := basePath + "/servers/" + view.Server.ID + "/security" }}
	@layouts.AppShell(layouts.AppProps{Title: view.Server.Name + " security", Crumbs: []layouts.Crumb{{Label: "Servers", Href: basePath + "/servers"}, {Label: view.Server.Name}, {Label: "Security"}}}) {
		@panelPage(templ.Attributes{"data-server-security": view.Server.Name}) {
			@pageTitle(view.Server.Name, "No open port, SSH only on your tailnet, everything else dropped. Flip the switches and press Apply.")
			<div id="server-security" class="mt-6 flex flex-col gap-4">
				if view.Notice != "" {
					@alert.Alert(alert.Props{Class: "border-0 rounded-2xl bg-live/12 px-5 py-3.5 text-sm font-medium text-live", Attributes: templ.Attributes{"data-security-notice": true}}) {
						{ view.Notice }
					}
				}
				if view.Error != "" {
					@alert.Alert(alert.Props{Class: "border-0 rounded-2xl bg-failed/12 px-5 py-3.5 text-sm font-medium text-failed", Attributes: templ.Attributes{"data-security-error": true}}) {
						{ view.Error }
					}
				}
				@securityState(view, securityPath)
				@serverRules(view.Server)
				@card.Card(card.Props{Class: "block gap-0 py-0 text-base min-w-0 overflow-hidden"}) {
					@card.Header(card.HeaderProps{Class: panelHeadClasses}) {
						@card.Title(card.TitleProps{Attributes: templ.Attributes{"role": "heading", "aria-level": "2"}}) {
							Keys
						}
						<span class="text-xs text-muted-foreground">Used by all your servers, stored encrypted</span>
					}
					<form class="grid gap-3 px-5 pb-5 sm:grid-cols-2" hx-post={ basePath + "/integrations" } hx-target="#server-security" hx-select="#server-security" hx-swap="outerHTML" hx-vals={ templ.JSONString(map[string]string{"server": view.Server.ID}) } data-integrations-form>
						@csrf.Token()
						<label class="flex min-w-0 flex-col gap-1">
							<span class="text-xs font-semibold">
								Cloudflare API token
								if view.Integrations.Cloudflare {
									<span class="font-normal text-live">stored · account { view.Integrations.CloudflareAccount }</span>
								}
							</span>
							@input.Input(input.Props{Name: "cloudflare_token", Type: "password", Placeholder: "Tunnel Edit, DNS Edit, Zone Settings Edit", Class: "font-mono", Attributes: templ.Attributes{"autocomplete": "off"}})
						</label>
						<label class="flex min-w-0 flex-col gap-1">
							<span class="text-xs font-semibold">
								Tailscale auth key
								if view.Integrations.Tailscale {
									<span class="font-normal text-live">stored</span>
								}
							</span>
							@input.Input(input.Props{Name: "tailscale_key", Type: "password", Placeholder: "tskey-auth-…, reusable", Class: "font-mono", Attributes: templ.Attributes{"autocomplete": "off"}})
						</label>
						<div class="flex flex-wrap justify-end gap-2.5 sm:col-span-2">
							if view.Integrations.Cloudflare {
								@removeKeyButton(view.Server.ID, "cloudflare", "Remove Cloudflare token", "Remove the Cloudflare API token? Turn tunnels off first: without the token ops cannot delete them in Cloudflare.")
							}
							if view.Integrations.Tailscale {
								@removeKeyButton(view.Server.ID, "tailscale", "Remove Tailscale key", "Remove the Tailscale auth key? The next change of a server's security opens SSH again on every interface.")
							}
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
								Save keys
							}
						</div>
					</form>
				}
			</div>
		}
		@securityScript()
	}
}

// securityScript reloads the switches and the report when the server
// changes, like the servers page, but not while a flipped switch waits for
// Apply.
templ securityScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			const events = new EventSource("/api/v1/servers/events");
			const waiting = () => {
				const form = document.querySelector("[data-security-form]");
				if (!form) return false;
				return [...form.querySelectorAll("input[type=checkbox][name]")].some((box) => {
					const was = form.querySelector(`input[name="was_${box.name}"]`);
					return was && box.checked !== (was.value === "1");
				});
			};
			events.addEventListener("servers", () => {
				if (!waiting()) document.body.dispatchEvent(new Event("security-changed"));
			});
			document.addEventListener("htmx:before:history:update", () => events.close(), { once: true });
		})();
	</script>
}

// securityState is the switches and what the agent set up. The page
// reloads it when the server changes, unless a switch waits for Apply.
templ securityState(view SecurityView, securityPath string) {
	{{ report := service.SecurityReport(view.Server) }}
	<div id="security-state" class="flex flex-col gap-4" hx-get={ securityPath } hx-trigger="security-changed from:body" hx-select="#security-state" hx-swap="outerHTML">
				@card.Card(card.Props{Class: "block gap-0 py-0 text-base min-w-0 overflow-hidden"}) {
					@card.Header(card.HeaderProps{Class: panelHeadClasses}) {
						@card.Title(card.TitleProps{Attributes: templ.Attributes{"role": "heading", "aria-level": "2"}}) {
							Access
						}
						<a class="text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline" href="/docs/guides/security">How it works</a>
					}
					<form class="flex flex-col divide-y divide-border px-5 pb-2" hx-post={ securityPath } hx-target="#server-security" hx-select="#server-security" hx-swap="outerHTML" data-security-form>
						@csrf.Token()
						// What the page showed: Apply changes only the switches flipped here
						// and keeps what changed elsewhere meanwhile.
						<input type="hidden" name="was_tunnel" value={ onValue(view.Server.Tunnel) }/>
						<input type="hidden" name="was_ssh_tailscale" value={ onValue(view.Server.SSHTailscale) }/>
						<input type="hidden" name="was_firewall" value={ onValue(view.Server.Firewall) }/>
						@securityToggle("tunnel", "Cloudflare Tunnel", "All app traffic comes through a tunnel from Cloudflare. Ports 80 and 443 close, ops points your domains at the tunnel and Cloudflare serves HTTPS.", view.Server.Tunnel, !view.Integrations.Cloudflare, "Add a Cloudflare API token below first.")
						@securityToggle("ssh_tailscale", "SSH only on Tailscale", "The server joins your tailnet; SSH answers there and nowhere else. It only closes once Tailscale is up.", view.Server.SSHTailscale, !view.Integrations.Tailscale, "Add a Tailscale auth key below first.")
						@securityToggle("firewall", "Firewall", "Drops every inbound connection the server does not need. Open stays only what the switches above leave open.", view.Server.Firewall, false, "")
						<div class="flex justify-end py-4">
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDefault}) {
								Apply
							}
						</div>
					</form>
				}
				if report != nil {
					@card.Card(card.Props{Class: "block gap-0 py-0 text-base min-w-0 overflow-hidden", Attributes: templ.Attributes{"data-security-report": true}}) {
						@card.Header(card.HeaderProps{Class: panelHeadClasses}) {
							@card.Title(card.TitleProps{Attributes: templ.Attributes{"role": "heading", "aria-level": "2"}}) {
								What the agent set up
							}
						}
						<dl class="grid gap-3 px-4 pb-4 sm:grid-cols-3">
							@backupFact("Traffic", proxyText(report.Proxy), "")
							@backupFact("Open to everyone", portsText(*report, view.Server.SSHTailscale), portsNote(report.Firewall))
							@backupFact("Tailnet", tailnetText(report.TailscaleIP, view.Integrations.Tailscale), tailnetNote(report.TailscaleIP, view.Integrations.Tailscale))
						</dl>
						for _, problem := range report.Problems {
							@alert.Alert(alert.Props{Class: "border-0 w-auto mx-4 mb-3 rounded-2xl bg-running/12 px-4 py-3 text-sm text-running"}) {
								{ problem }
							}
						}
					}
				}
	</div>
}

// removeKeyButton takes one stored key away; the fields only add or replace.
templ removeKeyButton(server, key, label, question string) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@button.Button(button.Props{
		Variant: button.VariantSecondary,
		Class:   "hover:bg-failed/15 hover:text-failed",
		Attributes: templ.Attributes{
			"hx-post":         basePath + "/integrations",
			"hx-vals":         `{"server":"` + server + `","remove":"` + key + `"}`,
			"hx-target":       "#server-security",
			"hx-select":       "#server-security",
			"hx-swap":         "outerHTML",
			"hx-confirm":      question,
			"data-remove-key": key,
		},
	}) {
		{ label }
	}
}

templ securityToggle(name, title, text string, on, locked bool, lockedText string) {
	<label class="flex cursor-pointer items-start justify-between gap-6 py-4" data-toggle={ name }>
		<span class="min-w-0 text-sm text-muted-foreground">
			<span class="block font-semibold text-foreground">{ title }</span>
			{ text }
			if locked && !on {
				<span class="mt-1 block text-running">{ lockedText }</span>
			}
		</span>
		@switchcomp.Switch(switchcomp.Props{Name: name, Value: "1", DefaultChecked: on, Disabled: locked && !on, Class: "mt-1"})
	</label>
}

func proxyText(proxy string) string {
	if proxy == "tunnel" {
		return "Cloudflare Tunnel"
	}
	return "Ports 80, 443"
}

func onValue(on bool) string {
	if on {
		return "1"
	}
	return "0"
}

// portsText is what is open to everyone. Without the firewall it is what
// ops itself listens on; any other service on the server is open too.
func portsText(report protocol.ServerConfigResult, sshOnTailscale bool) string {
	ports := report.OpenPorts
	if !report.Firewall {
		ports = nil
		if !sshOnTailscale || report.TailscaleIP == "" {
			ports = append(ports, "22/tcp")
		}
		if report.Proxy != "tunnel" {
			ports = append(ports, "80/tcp", "443/tcp")
		}
	}
	if len(ports) == 0 {
		return "nothing"
	}
	return strings.Join(ports, ", ")
}

func portsNote(firewall bool) string {
	if firewall {
		return "Everything else is dropped."
	}
	return "Firewall off: every other listening port too."
}

func tailnetText(ip string, key bool) string {
	switch {
	case ip != "":
		return ip
	case key:
		return "not up"
	}
	return "not joined"
}

func tailnetNote(ip string, key bool) string {
	switch {
	case ip != "":
		return "The server's address on your tailnet."
	case key:
		return "The server could not join your tailnet yet."
	}
	return "Add a Tailscale auth key below: the server joins your tailnet, then SSH can answer only there."
}

// serverRules shows /etc/ops/rules of the server as the agent reported it.
// Only the owner of the server changes them, on the server.
templ serverRules(server model.Server) {
	{{ rules := service.ServerRules(server) }}
	@card.Card(card.Props{Class: "block gap-0 py-0 text-base min-w-0 overflow-hidden", Attributes: templ.Attributes{"data-rules-panel": true}}) {
		@card.Header(card.HeaderProps{Class: panelHeadClasses}) {
			@card.Title(card.TitleProps{Attributes: templ.Attributes{"role": "heading", "aria-level": "2"}}) {
				Rules
			}
			<a class="text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline" href="/docs/guides/security#rules">How they work</a>
		}
		<div class="flex flex-col gap-3 px-5 pb-5">
			if len(rules.Lines()) == 0 {
				<p class="text-sm text-muted-foreground">
					No rules: ops may do everything on this server. Write <code class="font-mono text-foreground">/etc/ops/rules</code> on the server to turn off data or logs, or to allow deploys only from your own repos.
				</p>
			} else {
				<p class="text-sm text-muted-foreground">
					Set in <code class="font-mono text-foreground">/etc/ops/rules</code> on the server. The agent refuses everything they do not allow, and nobody can change them through ops.
				</p>
				<pre class="ops-term overflow-x-auto rounded-xl bg-muted px-4 py-3 text-xs" data-rules>{ strings.Join(rules.Lines(), "\n") }</pre>
			}
		</div>
	}
}
