package pages

import (
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/service"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/components/input"
	"github.com/axadrn/ops/controlplane/internal/ui/components/status"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
)

// RoutingView is what the domains and access panel shows.
type RoutingView struct {
	App    model.App
	Checks []service.DomainCheck
	// Notice says what happened to the last change; Error why it failed.
	Notice string
	Error  string
}

// AppRouting is the domains and access panel of an app. It loads its DNS
// checks after the page, because they wait on DNS lookups.
templ AppRouting(view RoutingView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ routingPath := basePath + "/apps/" + view.App.Name + "/routing" }}
	<section id="app-routing" aria-labelledby="app-routing-heading" class="ops-panel mt-4 min-w-0 overflow-hidden">
		<div class={ panelHeadClasses }>
			<h2 id="app-routing-heading" class="ops-panel-title">Domains and access</h2>
			<a class="text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline" href="/docs/guides/domains">How it works</a>
		</div>
		<div class="grid gap-6 px-5 pt-2 pb-5 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
			<div class="min-w-0 space-y-3">
				if len(view.Checks) == 0 {
					<p class="text-sm text-muted-foreground">No domains yet. Add one and point its A record at { serverAddress(view) }. HTTPS is always on.</p>
				} else {
					<ul class="divide-y rounded-2xl bg-muted/60" role="list">
						for _, check := range view.Checks {
							<li data-domain={ check.Domain } class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
								<span class="min-w-0 truncate font-mono text-sm font-medium">{ check.Domain }</span>
								if check.Canonical {
									<span class="rounded-full bg-background px-2 py-0.5 text-[11px] font-medium text-muted-foreground">canonical</span>
								}
								<span class="ml-auto flex items-center gap-1">
									if check.Points {
										@status.Status(status.Props{Kind: status.KindLive, Chip: true}) {
											points here
										}
									} else {
										@status.Status(status.Props{Kind: status.KindWaiting, Chip: true}) {
											set A record to { orDash(check.Address) }
										}
									}
									if !check.Canonical {
										<button
											type="button"
											class="rounded-full px-2.5 py-1 text-xs text-muted-foreground transition-colors hover:bg-background hover:text-foreground"
											hx-post={ routingPath + "/canonical" }
											hx-vals={ `{"domain": "` + check.Domain + `"}` }
											hx-target="#app-routing"
											hx-swap="outerHTML"
										>Make canonical</button>
									}
									<button
										type="button"
										class="inline-flex size-7 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-failed/10 hover:text-failed"
										aria-label={ "Remove " + check.Domain }
										hx-post={ routingPath + "/remove" }
										hx-vals={ `{"domain": "` + check.Domain + `"}` }
										hx-target="#app-routing"
										hx-swap="outerHTML"
										hx-confirm={ "Remove " + check.Domain + "? It stops answering for this app." }
									>
										@icon.X(icon.Props{Class: "size-3.5"})
									</button>
								</span>
							</li>
						}
					</ul>
				}
				<form class="flex flex-col gap-2 sm:flex-row" hx-post={ routingPath + "/add" } hx-target="#app-routing" hx-swap="outerHTML">
					@csrf.Token()
					<label for="domain-name" class="sr-only">Domain</label>
					@input.Input(input.Props{ID: "domain-name", Name: "domain", Type: "text", Placeholder: "blog.de", Class: "min-w-0 font-mono text-sm", Attributes: templ.Attributes{"autocomplete": "off", "spellcheck": "false", "required": true}})
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Class: "shrink-0", Attributes: templ.Attributes{"data-add-domain": true}}) {
						Add domain
					}
				</form>
			</div>
			<div class="min-w-0 space-y-3">
				<div class="flex items-center justify-between gap-3">
					<div>
						<p class="text-sm font-semibold">Password</p>
						<p class="text-xs text-muted-foreground">
							if view.App.Protect != "" {
								Visitors sign in as { protectUser(view.App) }.
							} else {
								Anyone with the link can open it.
							}
						</p>
					</div>
					if view.App.Protect != "" {
						@status.Status(status.Props{Kind: status.KindLive, Chip: true}) {
							on
						}
					} else {
						@status.Status(status.Props{Kind: status.KindIdle, Chip: true}) {
							off
						}
					}
				</div>
				if view.App.Protect != "" {
					@button.Button(button.Props{
						Variant: button.VariantSecondary,
						Attributes: templ.Attributes{
							"hx-post":        routingPath + "/unprotect",
							"hx-target":      "#app-routing",
							"hx-swap":        "outerHTML",
							"hx-confirm":     "Remove the password? The app becomes public.",
							"data-unprotect": true,
						},
					}) {
						Remove password
					}
				} else {
					<form class="grid gap-2 sm:grid-cols-[8rem_minmax(0,1fr)_auto]" hx-post={ routingPath + "/protect" } hx-target="#app-routing" hx-swap="outerHTML">
						@csrf.Token()
						<label for="protect-user" class="sr-only">Username</label>
						@input.Input(input.Props{ID: "protect-user", Name: "username", Type: "text", Value: "ops", Class: "text-sm", Attributes: templ.Attributes{"autocomplete": "off", "required": true}})
						<label for="protect-password" class="sr-only">Password</label>
						@input.Input(input.Props{ID: "protect-password", Name: "password", Type: "password", Placeholder: "8+ characters", Class: "min-w-0 text-sm", Attributes: templ.Attributes{"autocomplete": "new-password", "required": true, "minlength": "8"}})
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Attributes: templ.Attributes{"data-protect": true}}) {
							Protect
						}
					</form>
				}
			</div>
		</div>
		if view.Notice != "" || view.Error != "" {
			<div class="border-t px-5 py-3 text-xs">
				if view.Error != "" {
					<p class="text-failed" role="alert" data-routing-error>{ view.Error }</p>
				} else {
					<p class="text-muted-foreground" data-routing-notice>{ view.Notice }</p>
				}
			</div>
		}
	</section>
}

func serverAddress(view RoutingView) string {
	for _, check := range view.Checks {
		if check.Address != "" {
			return check.Address
		}
	}
	return "your server"
}

func orDash(value string) string {
	if value == "" {
		return "the server"
	}
	return value
}

func protectUser(app model.App) string {
	for index, char := range app.Protect {
		if char == ':' {
			return app.Protect[:index]
		}
	}
	return "ops"
}
