package pages

import (
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/service"
	"github.com/axadrn/ops/controlplane/internal/ui/components/badge"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/alert"
	"github.com/axadrn/ops/controlplane/internal/ui/components/field"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/components/input"
	"github.com/axadrn/ops/controlplane/internal/ui/components/item"
	"github.com/axadrn/ops/controlplane/internal/ui/components/status"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
)

// RoutingView is what the domains and access panel shows.
type RoutingView struct {
	App    model.App
	Checks []service.DomainCheck
	// Server runs the app; its addresses tell a new domain where to point.
	Server model.Server
	// Notice says what happened to the last change; Error why it failed.
	Notice string
	Error  string
}

// AppRouting is the domains and access panel of an app: the domains with
// their DNS check, and the password. It loads its DNS checks after the
// page, because they wait on DNS lookups; until then the domains show as
// being checked.
templ AppRouting(view RoutingView) {
	{{ routingPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name + "/routing" }}
	<div id="app-routing" class="grid items-stretch gap-4 lg:grid-cols-2">
		if view.Error != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Class: "lg:col-span-2", Attributes: templ.Attributes{"data-routing-error": true}}) {
				@icon.CircleAlert()
				@alert.Title() {
					{ view.Error }
				}
			}
		} else if view.Notice != "" {
			@alert.Alert(alert.Props{Class: "lg:col-span-2", Attributes: templ.Attributes{"data-routing-notice": true}}) {
				@icon.CircleCheck()
				@alert.Title() {
					{ view.Notice }
				}
			}
		}
		@panel(panelProps{
			Heading:     "app-domains-heading",
			Title:       "Domains",
			Description: "The addresses the app answers on, with HTTPS. Other domains redirect to the canonical one.",
			Action:      docsLink("/docs/guides/domains", "How it works"),
		}) {
			<div class="flex flex-col gap-6">
				if checks := domainRows(view); len(checks) > 0 {
					@item.Group(item.GroupProps{Class: "-mx-3 w-auto gap-1"}) {
						for _, check := range checks {
							@domainRow(check, routingPath, len(view.Checks) > 0)
						}
					}
				} else {
					<p class="text-sm text-muted-foreground">No domain yet. { serverAdvice(view) }</p>
				}
				<form class="flex flex-col gap-2 sm:flex-row" hx-post={ routingPath + "/add" } hx-target="#app-routing" hx-swap="outerHTML" hx-disable="find button[type='submit']">
					@csrf.Token()
					<label for="domain-name" class="sr-only">Domain</label>
					@input.Input(input.Props{ID: "domain-name", Name: "domain", Type: "text", Placeholder: "blog.example.com", Class: "min-w-0 font-mono", Attributes: templ.Attributes{"autocomplete": "off", "spellcheck": "false", "required": true}})
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Class: "shrink-0", Attributes: templ.Attributes{"data-add-domain": true}}) {
						Add domain
					}
				</form>
			</div>
		}
		@panel(panelProps{
			Heading:     "app-password-heading",
			Title:       "Password",
			Description: "Ask visitors for a username and password before they see the app. Good for staging and previews.",
			Action:      protectStatus(view.App),
		}) {
			if view.App.Protect != "" {
				<div class="flex flex-col items-start gap-3">
					<p class="text-sm text-muted-foreground">Visitors sign in as <span class="font-medium text-foreground">{ protectUser(view.App) }</span>. Only a hash of the password is stored.</p>
					@button.Button(button.Props{
						Variant: button.VariantSecondary,
						Attributes: templ.Attributes{
							"hx-post":        routingPath + "/unprotect",
							"hx-target":      "#app-routing",
							"hx-swap":        "outerHTML",
							"hx-disable":     "this",
							"hx-confirm":     "Remove the password? Anyone with the link can open the app again.",
							"data-unprotect": true,
						},
					}) {
						Remove password
					}
				</div>
			} else {
				<form class="flex flex-col gap-3" hx-post={ routingPath + "/protect" } hx-target="#app-routing" hx-swap="outerHTML" hx-disable="find button[type='submit']">
					@csrf.Token()
					<div class="grid gap-3 sm:grid-cols-2">
						@field.Field(field.Props{Class: "gap-1"}) {
							@field.Label(field.LabelProps{For: "protect-user"}) {
								Username
							}
							@input.Input(input.Props{ID: "protect-user", Name: "username", Type: "text", Value: "ops", Attributes: templ.Attributes{"autocomplete": "off", "required": true}})
						}
						@field.Field(field.Props{Class: "gap-1"}) {
							@field.Label(field.LabelProps{For: "protect-password"}) {
								Password
							}
							@input.Input(input.Props{ID: "protect-password", Name: "password", Type: "password", Placeholder: "8 characters or more", Attributes: templ.Attributes{"autocomplete": "new-password", "required": true, "minlength": "8"}})
						}
					</div>
					<div>
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Attributes: templ.Attributes{"data-protect": true}}) {
							Protect with password
						}
					</div>
				</form>
			}
		}
	</div>
}

// domainRow is one domain: its name, whether its DNS points at the server
// (or the record to set), and its actions. Before the DNS check it says
// the check runs.
templ domainRow(check service.DomainCheck, routingPath string, checked bool) {
	@item.Item(item.Props{Size: item.SizeXs, Class: "rounded-xl hover:bg-muted/60", Attributes: templ.Attributes{"role": "listitem", "data-domain": check.Domain}}) {
		@item.Content(item.ContentProps{Class: "min-w-0"}) {
			@item.Title(item.TitleProps{Class: "max-w-full"}) {
				<span class="truncate font-mono">{ check.Domain }</span>
				if check.Canonical {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						canonical
					}
				}
			}
			@item.Description(item.DescriptionProps{Class: "text-xs"}) {
				if !checked {
					@status.Status(status.Props{Kind: status.KindIdle, Plain: true, Class: "text-xs font-normal text-muted-foreground"}) {
						Checking DNS
					}
				} else if check.Points {
					@status.Status(status.Props{Kind: status.KindLive, Class: "text-xs font-normal"}) {
						Points here
					}
				} else {
					@status.Status(status.Props{Kind: status.KindWaiting, Class: "text-xs font-normal whitespace-normal"}) {
						Set { check.Advice }
					}
				}
			}
		}
		@item.Actions() {
			if !check.Canonical {
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeSm,
					Attributes: templ.Attributes{"hx-post": routingPath + "/canonical", "hx-vals": `{"domain": "` + check.Domain + `"}`, "hx-target": "#app-routing", "hx-swap": "outerHTML", "hx-disable": "this", "title": "Redirect the other domains here"},
				}) {
					Make canonical
				}
			}
			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Size:    button.SizeIconSm,
				Attributes: templ.Attributes{
					"aria-label": "Remove " + check.Domain,
					"title":      "Remove " + check.Domain,
					"hx-post":    routingPath + "/remove",
					"hx-vals":    `{"domain": "` + check.Domain + `"}`,
					"hx-target":  "#app-routing",
					"hx-swap":    "outerHTML",
					"hx-disable": "this",
					"hx-confirm": "Remove " + check.Domain + "? It stops answering for this app.",
				},
			}) {
				@icon.X()
			}
		}
	}
}

// protectStatus says whether a password protects the app.
templ protectStatus(app model.App) {
	if app.Protect != "" {
		@status.Status(status.Props{Kind: status.KindLive, Chip: true}) {
			on
		}
	} else {
		@status.Status(status.Props{Kind: status.KindIdle, Chip: true}) {
			off
		}
	}
}

// domainRows are the checked domains, or before the check the app's
// domains with no answer yet.
func domainRows(view RoutingView) []service.DomainCheck {
	if len(view.Checks) > 0 {
		return view.Checks
	}
	var rows []service.DomainCheck
	for _, domain := range view.App.DomainList() {
		rows = append(rows, service.DomainCheck{Domain: domain, Canonical: domain == view.App.Canonical})
	}
	return rows
}

// serverAdvice is the DNS record a new domain needs.
func serverAdvice(view RoutingView) string {
	if view.Server.Tunnel {
		return "Add one below; ops points its DNS at the Cloudflare Tunnel."
	}
	if view.Server.ID == "" {
		return "Add one below, then point its DNS at the server."
	}
	return "Add one below, then set its " + service.DNSAdvice(service.ServerAddresses(view.Server)) + "."
}

func orDash(value string) string {
	if value == "" {
		return "-"
	}
	return value
}

func protectUser(app model.App) string {
	for index, char := range app.Protect {
		if char == ':' {
			return app.Protect[:index]
		}
	}
	return "ops"
}
