package pages

import (
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/service"
	"github.com/axadrn/moin/controlplane/internal/ui/components/badge"
	"github.com/axadrn/moin/controlplane/internal/ui/components/button"
	"github.com/axadrn/moin/controlplane/internal/ui/components/field"
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
	"github.com/axadrn/moin/controlplane/internal/ui/components/input"
	"github.com/axadrn/moin/controlplane/internal/ui/components/item"
	"github.com/axadrn/moin/controlplane/internal/ui/components/select"
	"github.com/axadrn/moin/controlplane/internal/ui/components/status"
	"github.com/axadrn/moin/controlplane/internal/ui/components/switch"
	"github.com/axadrn/moin/controlplane/internal/ui/csrf"
	"github.com/axadrn/moin/controlplane/internal/ui/utils"
	"github.com/axadrn/moin/protocol"
)

// RoutingView is what the domains and access panel shows.
type RoutingView struct {
	App    model.App
	Checks []service.DomainCheck
	// Server runs the app; its addresses tell a new domain where to point.
	Server model.Server
	// Instant is the instant address; its Provider is empty until the
	// panel loaded.
	Instant service.Instant
}

// AppRouting is the domains and access panel of an app: the domains with
// their DNS check, and the password. It loads its DNS checks after the
// page, because they wait on DNS lookups; until then the domains show as
// being checked.
templ AppRouting(view RoutingView) {
	{{ routingPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name + "/routing" }}
	<div id="app-routing" class="grid items-stretch gap-4 lg:grid-cols-2">
		@instantPanel(view, routingPath)
		@panel(panelProps{
			Heading:     "app-domains-heading",
			Title:       "Domains",
			Description: "The addresses the app answers on, with HTTPS. Other domains redirect to the canonical one.",
			Action:      docsLink("/docs/guides/domains", "How it works"),
		}) {
			<div class="flex flex-col gap-6">
				if checks := domainRows(view); len(checks) > 0 {
					@item.Group(item.GroupProps{Class: "-mx-3 w-auto gap-1"}) {
						for _, check := range checks {
							@domainRow(check, routingPath, len(view.Checks) > 0)
						}
					}
				} else {
					<p class="text-sm text-muted-foreground">No domain yet. { serverAdvice(view) }</p>
				}
				if fromCompose(view.Checks) {
					<p class="text-sm text-muted-foreground" data-domains-from-compose>
						<span class="font-mono text-foreground">x-ops.domains</span> in compose.yml sets these domains. Change them there and deploy; ops cannot add or remove them while compose.yml sets them.
					</p>
				} else {
					<form class="flex flex-col gap-2 sm:flex-row" hx-post={ routingPath + "/add" } hx-target="#app-routing" hx-swap="outerHTML" hx-disable="find button[type='submit']">
						@csrf.Token()
						<label for="domain-name" class="sr-only">Domain</label>
						@input.Input(input.Props{ID: "domain-name", Name: "domain", Type: "text", Placeholder: "blog.example.com", Class: "min-w-0 font-mono", Attributes: templ.Attributes{"autocomplete": "off", "spellcheck": "false", "required": true}})
						<label for="domain-service" class="sr-only">Service of compose.yml, empty for the main one</label>
						@input.Input(input.Props{ID: "domain-service", Name: "service", Type: "text", Placeholder: "service (optional)", Class: "min-w-0 font-mono sm:w-40", Attributes: templ.Attributes{"autocomplete": "off", "spellcheck": "false", "title": "A service of compose.yml other than the main one, such as api"}})
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Class: "shrink-0", Attributes: templ.Attributes{"data-add-domain": true}}) {
							Add domain
						}
					</form>
				}
			</div>
		}
		@panel(panelProps{
			Heading:     "app-password-heading",
			Title:       "Password",
			Docs:        "/docs/guides/domains#protect-with-a-password",
			Description: "Ask visitors for a username and password before they see the app. Good for staging and previews.",
			Action:      protectStatus(view.App),
		}) {
			if view.App.Protect != "" {
				<div class="flex flex-col items-start gap-3">
					<p class="text-sm text-muted-foreground">Visitors sign in as <span class="font-medium text-foreground">{ protectUser(view.App) }</span>. Only a hash of the password is stored.</p>
					@button.Button(button.Props{
						Variant: button.VariantSecondary,
						Attributes: templ.Attributes{
							"hx-post":        routingPath + "/unprotect",
							"hx-target":      "#app-routing",
							"hx-swap":        "outerHTML",
							"hx-disable":     "this",
							"hx-confirm":     "Remove the password? Anyone with the link can open the app again.",
							"data-unprotect": true,
						},
					}) {
						Remove password
					}
				</div>
			} else {
				<form class="flex flex-col gap-3" hx-post={ routingPath + "/protect" } hx-target="#app-routing" hx-swap="outerHTML" hx-disable="find button[type='submit']">
					@csrf.Token()
					<div class="grid gap-3 sm:grid-cols-2">
						@field.Field(field.Props{Class: "gap-1"}) {
							@field.Label(field.LabelProps{For: "protect-user"}) {
								Username
							}
							@input.Input(input.Props{ID: "protect-user", Name: "username", Type: "text", Value: "ops", Attributes: templ.Attributes{"autocomplete": "off", "required": true, "aria-describedby": "protect-user-hint"}})
							@fieldHint("protect-user", "") {
								No spaces or colons.
							}
						}
						@field.Field(field.Props{Class: "gap-1"}) {
							@field.Label(field.LabelProps{For: "protect-password"}) {
								Password
							}
							@input.Input(input.Props{ID: "protect-password", Name: "password", Type: "password", Attributes: templ.Attributes{"autocomplete": "new-password", "required": true, "minlength": "8", "aria-describedby": "protect-password-hint"}})
							@fieldHint("protect-password", "") {
								8 to 72 characters.
							}
						}
					</div>
					<div class="flex justify-end">
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Attributes: templ.Attributes{"data-protect": true}}) {
							Protect with password
						}
					</div>
				</form>
			}
		}
	</div>
}

// domainRow is one domain: its name, whether its DNS points at the server
// (or the record to set), and its actions. Before the DNS check it says
// the check runs.
templ domainRow(check service.DomainCheck, routingPath string, checked bool) {
	@item.Item(item.Props{Size: item.SizeXs, Class: "rounded-xl hover:bg-muted/60", Attributes: templ.Attributes{"role": "listitem", "data-domain": check.Domain}}) {
		@item.Content(item.ContentProps{Class: "min-w-0"}) {
			@item.Title(item.TitleProps{Class: "max-w-full"}) {
				<span class="truncate font-mono">{ check.Domain }</span>
				if check.Service != "" {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Attributes: templ.Attributes{"data-domain-service": check.Service}}) {
						{ check.Service }
					}
				}
				if check.Canonical {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						canonical
					}
				}
				if check.FromCompose {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
						from compose.yml
					}
				}
			}
			@item.Description(item.DescriptionProps{Class: "text-xs"}) {
				if !checked {
					@status.Status(status.Props{Kind: status.KindIdle, Plain: true, Class: "text-xs font-normal text-muted-foreground"}) {
						Checking DNS
					}
				} else if check.Points {
					@status.Status(status.Props{Kind: status.KindLive, Class: "text-xs font-normal"}) {
						Points here
					}
				} else {
					@status.Status(status.Props{Kind: status.KindWaiting, Class: "text-xs font-normal whitespace-normal"}) {
						Set { check.Advice }
					}
				}
			}
		}
		if !check.FromCompose {
			@item.Actions() {
				if !check.Canonical && check.Service == "" {
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Size:       button.SizeSm,
						Attributes: templ.Attributes{"hx-post": routingPath + "/canonical", "hx-vals": `{"domain": "` + check.Domain + `"}`, "hx-target": "#app-routing", "hx-swap": "outerHTML", "hx-disable": "this", "title": "Redirect the other domains here"},
					}) {
						Make canonical
					}
				}
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeIconSm,
					Attributes: templ.Attributes{
						"aria-label": "Remove " + check.Domain,
						"title":      "Remove " + check.Domain,
						"hx-post":    routingPath + "/remove",
						"hx-vals":    `{"domain": "` + check.Domain + `", "service": "` + check.Service + `"}`,
						"hx-target":  "#app-routing",
						"hx-swap":    "outerHTML",
						"hx-disable": "this",
						"hx-confirm": "Remove " + check.Domain + "? It stops answering for this app.",
					},
				}) {
					@icon.X()
				}
			}
		}
	}
}

// instantPanel is the instant address: where it is, or why the app has
// none, its provider and its password.
templ instantPanel(view RoutingView, routingPath string) {
	@panel(panelProps{
		Heading:     "app-instant-heading",
		Title:       "Instant address",
		Docs:        "/docs/guides/domains#instant-address",
		Description: "An address with HTTPS made from the server's IP, so the app answers before it has a domain.",
		Class:       "lg:col-span-2",
	}) {
		if view.Instant.Provider == "" {
			<p class="text-sm text-muted-foreground">Looking it up.</p>
		} else {
			<div class="flex flex-col gap-4" data-instant>
				if view.Instant.URL != "" {
					<div class="flex flex-col gap-1">
						<a href={ templ.SafeURL(view.Instant.URL) } target="_blank" rel="noopener" class="font-mono text-sm break-all underline-offset-4 hover:underline" data-instant-url>{ view.Instant.URL }</a>
						<p class="text-sm text-muted-foreground">
							switch {
								case view.Instant.Open:
									Open to everyone.
								case view.Instant.OwnPassword:
									The app's password guards it: sign in as <span class="font-medium text-foreground">{ view.Instant.User }</span>.
								case view.Instant.Password != "":
									Sign in as <span class="font-medium text-foreground">{ view.Instant.User }</span> with <span class="font-mono text-foreground" data-instant-password>{ view.Instant.Password }</span>.
								default:
									A password ops made guards it: sign in as <span class="font-medium text-foreground">{ view.Instant.User }</span>.
							}
						</p>
					</div>
				} else {
					<p class="text-sm text-muted-foreground" data-instant-reason>{ view.Instant.Reason }</p>
				}
				<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
					<form class="flex items-end gap-2" hx-post={ routingPath + "/instant" } hx-target="#app-routing" hx-swap="outerHTML" hx-disable="find button[type='submit']">
						@csrf.Token()
						@field.Field(field.Props{Class: "gap-1"}) {
							@field.Label(field.LabelProps{For: "instant-provider"}) {
								Provider
							}
							@selectcomp.Select(selectcomp.Props{Name: "provider", DefaultValue: view.Instant.Provider, Items: instantItems()}) {
								@selectcomp.Trigger(selectcomp.TriggerProps{ID: "instant-provider", Class: "w-40"}) {
									@selectcomp.Value()
								}
								@selectcomp.Content(selectcomp.ContentProps{AlignItemWithTrigger: utils.Ptr(false), Align: selectcomp.AlignStart}) {
									@selectcomp.Group() {
										for _, item := range instantItems() {
											@selectcomp.Item(selectcomp.ItemProps{Value: item.Value}) {
												{ item.Label.(string) }
											}
										}
									}
								}
							}
						}
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Attributes: templ.Attributes{"data-instant-provider": true}}) {
							Save
						}
					</form>
					if view.Instant.URL != "" {
						<div class="flex items-center gap-4">
							if !view.Instant.Open && !view.Instant.OwnPassword && view.Instant.Password == "" {
								@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Attributes: templ.Attributes{"hx-get": routingPath + "?show=true", "hx-target": "#app-routing", "hx-swap": "outerHTML", "hx-disable": "this", "data-instant-show": true}}) {
									Show password
								}
							}
							<form hx-post={ routingPath + "/instant-password" } hx-trigger="change" hx-target="#app-routing" hx-swap="outerHTML">
								@csrf.Token()
								<input type="hidden" name="password" value="1"/>
								@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
									@field.Label(field.LabelProps{For: "instant-password-on"}) {
										Password
									}
									@switchcomp.Switch(switchcomp.Props{ID: "instant-password-on", Name: "on", Value: "1", DefaultChecked: !view.Instant.Open})
								}
							</form>
						</div>
					}
				</div>
			</div>
		}
	}
}

// instantItems are the providers of the instant address, and off.
func instantItems() []selectcomp.ItemData {
	items := []selectcomp.ItemData{}
	for _, provider := range protocol.InstantProviders {
		items = append(items, selectcomp.ItemData{Value: provider, Label: provider})
	}
	return append(items, selectcomp.ItemData{Value: "off", Label: "Off"})
}

// protectStatus says whether a password protects the app.
templ protectStatus(app model.App) {
	if app.Protect != "" {
		@status.Status(status.Props{Kind: status.KindLive, Chip: true}) {
			on
		}
	} else {
		@status.Status(status.Props{Kind: status.KindIdle, Chip: true}) {
			off
		}
	}
}

// domainRows are the checked domains, or before the check the app's
// domains with no answer yet.
func domainRows(view RoutingView) []service.DomainCheck {
	if len(view.Checks) > 0 {
		return view.Checks
	}
	var rows []service.DomainCheck
	for _, domain := range view.App.DomainList() {
		rows = append(rows, service.DomainCheck{Domain: domain, Canonical: domain == view.App.Canonical})
	}
	return rows
}

// fromCompose says x-ops.domains in compose.yml sets the domains of the
// main service.
func fromCompose(checks []service.DomainCheck) bool {
	return len(checks) > 0 && checks[0].FromCompose && checks[0].Service == ""
}

// serverAdvice is the DNS record a new domain needs.
func serverAdvice(view RoutingView) string {
	if view.Server.Tunnel {
		return "Add one below; ops points its DNS at the Cloudflare Tunnel."
	}
	if view.Server.ID == "" {
		return "Add one below, then point its DNS at the server."
	}
	return "Add one below, then set its " + service.DNSAdvice(service.ServerAddresses(view.Server)) + "."
}

func orDash(value string) string {
	if value == "" {
		return "-"
	}
	return value
}

func protectUser(app model.App) string {
	for index, char := range app.Protect {
		if char == ':' {
			return app.Protect[:index]
		}
	}
	return "ops"
}
