package pages

import (
	"github.com/axadrn/ops/controlplane/internal/brand"
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/ui/blocks"
	"github.com/axadrn/ops/controlplane/internal/ui/components/alert"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/field"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
	"github.com/axadrn/ops/controlplane/internal/ui/layouts"
)

templ AuthMagicLinkSent(email string) {
	@layouts.Auth(layouts.SEOProps{
		Title:       "Check Your Email",
		Description: "Magic link sent to your email",
		Path:        ctxkeys.URLPath(ctx),
	}) {
		@blocks.AuthShell(brand.Name) {
			@blocks.AuthCard("Check your email", "We sent a sign-in link to "+email+". It works once and expires soon.") {
				@field.Group() {
					@field.Field() {
						@AuthMagicLinkResend(email, false)
						@field.Description(field.DescriptionProps{Class: "text-center"}) {
							<a href="/auth">Use another email</a>
						}
					}
				}
			}
		}
	}
}

templ AuthMagicLinkResend(email string, sent bool) {
	<div id="magic-link-resend" class="space-y-2">
		<form
			id="magic-link-resend-form"
			hx-post="/auth/magic-link?resend=true"
			hx-target="#magic-link-resend"
			hx-swap="outerHTML"
			hx-disable="find button[type='submit']"
		>
			@csrf.Token()
			<input type="hidden" name="email" value={ email }/>
			@button.Button(button.Props{Variant: button.VariantSecondary, Class: blocks.AuthSecondary, Type: button.TypeSubmit}) {
				if sent {
					Resend again
				} else {
					Resend email
				}
			}
		</form>
		if sent {
			<p role="status" class="flex items-center justify-center gap-1.5 text-center text-sm text-live">
				@icon.Check(icon.Props{Class: "size-4"})
				Sent. A new link is on its way.
			</p>
		}
	</div>
}

// AuthWaitlisted is what a new address sees while sign-up is closed: it is
// on the waitlist now.
templ AuthWaitlisted(email string) {
	@layouts.Auth(layouts.SEOProps{
		Title:       "You're on the waitlist",
		Description: brand.Name + " Hosted is in private beta",
		Path:        ctxkeys.URLPath(ctx),
	}) {
		@blocks.AuthShell(brand.Name) {
			@blocks.AuthCard("You're on the waitlist", brand.Name+" Hosted is in private beta. We let people in step by step and write to "+email+" when it is your turn.") {
				@field.Group() {
					@field.Field() {
						@alert.Alert(alert.Props{Class: "border-0 block rounded-xl bg-muted px-4 py-3 text-sm text-muted-foreground", Attributes: templ.Attributes{"data-waitlisted": true}}) {
							Can't wait? { brand.Name } is open source: <a class="font-semibold text-foreground underline-offset-4 hover:underline" href="/docs/self-hosting">host it yourself</a>, free forever.
						}
						@field.Description(field.DescriptionProps{Class: "text-center"}) {
							<a href="/auth">Use another email</a>
						}
					}
				}
			}
		}
	}
}
