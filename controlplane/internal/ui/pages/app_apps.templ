package pages

import (
	"fmt"
	"github.com/axadrn/moin/controlplane/internal/ui/components/item"
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
	"strconv"
	"strings"
	"time"

	"github.com/axadrn/moin/controlplane/internal/api"
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/ui/components/button"
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
	"github.com/axadrn/moin/controlplane/internal/ui/components/input"
	"github.com/axadrn/moin/controlplane/internal/ui/components/status"
	"github.com/axadrn/moin/controlplane/internal/ui/csrf"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
	"github.com/axadrn/moin/protocol"
)

// NewApp is where an app starts: from your folder, from GitHub, or from
// the catalog. Each is one card; the overview lists the apps.
templ NewApp(servers []model.Server) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@layouts.App("New app") {
		@panelPage() {
			<header class="flex flex-col gap-1 pt-2">
				<h1 class="text-3xl font-semibold tracking-tight">New app</h1>
				<p class="text-muted-foreground">Three ways to start. Pick the one that fits.</p>
			</header>
			if len(servers) == 0 {
				@kit.List() {
					@kit.Row(basePath + "/servers") {
						@kit.RowText("Connect a server first", "Apps run on your servers. One command, no open port.")
					}
				}
			} else {
				@kit.Card("From your folder", nil) {
					@kit.Quiet() {
						Run this in the folder of your app. It finds compose.yml, a Dockerfile or a Go module and builds on your server.
					}
					@kit.Command("moin deploy")
				}
				@kit.Card("From GitHub", nil) {
					@kit.Quiet() {
						Name it and pick its server. Then link its repo, and every push deploys.
					}
					@AppAddForm(servers)
				}
				@kit.Card("From the catalog", nil) {
					@kit.Quiet() {
						Umami, n8n, Ghost and 44 more, the newest release in one click.
					}
					<div>
						@kit.Button(kit.Secondary, basePath+"/catalog", templ.Attributes{"data-catalog-link": true}) {
							Open the catalog
						}
					</div>
				}
			}
		}
	}
}

// AppAddForm names a new app and picks its server; the new app's page
// opens once it is added.
templ AppAddForm(servers []model.Server) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<form
		id="app-add-form"
		class="flex flex-col gap-2 sm:flex-row"
		hx-post={ basePath + "/apps" }
		hx-swap="none"
		hx-disable="find button[type='submit']"
	>
		@csrf.Token()
		<label for="app-name" class="sr-only">App name</label>
		@kit.Input(templ.Attributes{"id": "app-name", "name": "name", "type": "text", "placeholder": "Name, like blog", "maxlength": "63", "autocomplete": "off", "spellcheck": "false", "data-hotkey-focus": true})
		<div class="flex gap-2 sm:w-64">
			@kit.Select(kit.SelectProps{ID: "app-server", Name: "server", Label: "Server", Options: serverOptions(servers)})
			@kit.Button(kit.Primary, "", templ.Attributes{"type": "submit"}) {
				Add
			}
		</div>
	</form>
}

func serverOptions(servers []model.Server) []kit.Option {
	options := make([]kit.Option, 0, len(servers))
	for _, server := range servers {
		options = append(options, kit.Option{Value: server.Name, Label: server.Name})
	}
	return options
}

// appStatus is the chip of an app: its newest deploy, and the live one when
// the newest failed.
templ appStatus(app model.App) {
	<span data-status class="inline-flex min-w-0 flex-wrap items-center gap-2">
		switch  {
			case app.LatestNumber == 0:
				@status.Status(status.Props{Kind: status.KindIdle, Chip: true}) {
					new
				}
			case app.LatestStatus == model.DeployRunning:
				@status.Status(status.Props{Kind: status.KindRunning, Chip: true}) {
					{ fmt.Sprintf("deploying v%d", app.LatestNumber) }
				}
			case app.Stopped:
				@status.Status(status.Props{Kind: status.KindIdle, Chip: true}) {
					{ fmt.Sprintf("stopped v%d", app.LiveNumber) }
				}
			case app.LatestStatus == model.DeployFailed && app.LiveNumber > 0:
				@status.Status(status.Props{Kind: status.KindFailed, Chip: true}) {
					{ fmt.Sprintf("v%d failed", app.LatestNumber) }
				}
				<span class="text-xs text-muted-foreground tabular-nums">{ fmt.Sprintf("v%d live", app.LiveNumber) }</span>
			case app.LatestStatus == model.DeployFailed:
				@status.Status(status.Props{Kind: status.KindFailed, Chip: true}) {
					{ fmt.Sprintf("v%d failed", app.LatestNumber) }
				}
			default:
				@status.Status(status.Props{Kind: status.KindLive, Chip: true}) {
					{ fmt.Sprintf("live v%d", app.LiveNumber) }
				}
		}
	</span>
}

func plural(n int, one, many string) string {
	if n == 1 {
		return "1 " + one
	}
	return strconv.Itoa(n) + " " + many
}

// panelHeadClasses is the head of a card on pages not yet on panel.
const panelHeadClasses = "flex min-h-14 items-center justify-between gap-3 px-5 pt-4 pb-1.5"

// AppPageView is an app and the section of it to show.
type AppPageView struct {
	App     model.App
	Deploys []api.Deploy
	EnvKeys []string
	// Section is app, deploys, addresses, logs or settings; data has its
	// own page.
	Section string
}

// AppPage is an app: the head stays, the section under it answers one
// question (appSections).
templ AppPage(view AppPageView) {
	{{ app := view.App }}
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name }}
	@layouts.App(app.Name) {
		@panelPage(templ.Attributes{"data-app-page": app.Name}) {
			@appHeader(app, view.Section) {
				@appPower(app)
				@kit.Button(kit.Primary, "", templ.Attributes{"hx-post": appPath + "/redeploy", "hx-swap": "none", "hx-disable": "this", "data-redeploy": true, "title": "Build the newest source again"}) {
					Deploy
				}
			}
			@appSection() {
				switch view.Section {
					case "deploys":
						@appDeploysSection(app, view.Deploys)
					case "addresses":
						@appAddressesSection(app)
					case "logs":
						@appLogsSection(app, view.Deploys)
					case "settings":
						@appSettingsSection(app, view.EnvKeys)
					default:
						@appHomeSection(app, view.Deploys)
				}
			}
		}
		@appsScript()
	}
}

// appHomeSection answers "does it run?": the live version, where it is
// reached, and the way to each part.
templ appHomeSection(app model.App, deploys []api.Deploy) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name }}
	if app.Catalog != "" {
		<div hx-get={ appPath + "/catalog" } hx-trigger="load" hx-swap="outerHTML"></div>
	}
	@kit.List() {
		@kit.Row(appPath + "/deploys") {
			@kit.RowText(appLiveLine(app), appLastDeployLine(deploys))
		}
		@kit.Row(appPath + "/addresses") {
			@kit.RowText(appAddressLine(app), "Addresses")
		}
		@kit.Row(appPath + "/metrics") {
			@kit.RowText("Metrics", "CPU, memory and network")
		}
		@kit.Row(appPath + "/data") {
			@kit.RowText("Data", "Tables, SQL and backups")
		}
	}
}

// appDeploysSection answers "how does code get in?": the versions, the log
// of the one picked, GitHub and CI.
templ appDeploysSection(app model.App, deploys []api.Deploy) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name }}
	@appFacts(app, deploys)
	<div class="grid items-stretch gap-4 lg:grid-cols-2">
		@appDeploys(app, deploys)
		@panel(panelProps{Heading: "deploy-log-heading", Title: "Log", Action: deployLogActions(), Body: panelBodyFlush}) {
			<div
				id="deploy-log"
				class="moin-term moin-term-lines max-h-[32rem] flex-1 overflow-auto overscroll-contain outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset lg:min-h-72"
				data-deploy-log
				tabindex="0"
				aria-label="Deploy log"
			>
				<p class="px-6 font-sans text-sm text-muted-foreground">No deploy yet.</p>
			</div>
		}
	</div>
	<div hx-get={ appPath + "/repo" } hx-trigger="load" hx-swap="outerHTML">
		@AppRepo(RepoView{App: app})
	</div>
	@appCI(app.Name, app.DeployHookHash != nil)
	@appScript(app.Name)
}

// appAddressesSection answers "where is it reached?": the instant address
// and the domains in one place, with the password and the uptime checks.
templ appAddressesSection(app model.App) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name }}
	<div hx-get={ appPath + "/routing" } hx-trigger="load" hx-swap="outerHTML">
		@AppRouting(RoutingView{App: app})
	</div>
	<div hx-get={ appPath + "/uptime" } hx-trigger="load" hx-select="#app-uptime" hx-swap="outerHTML"></div>
}

// appLogsSection answers "what happens in it?": the container logs, and a
// command to run in it.
templ appLogsSection(app model.App, deploys []api.Deploy) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name }}
	@panel(panelProps{Heading: "app-logs-heading", Title: "Logs", Action: loadLogsButton(appPath), Body: panelBodyFlush}) {
		<div id="app-logs" hx-get={ appPath + "/logs/lines" } hx-trigger="load" hx-swap="outerHTML" class="px-6 text-sm text-muted-foreground">Loading…</div>
	}
	@appExec(app, deploys)
}

// appSettingsSection answers "how is it set up?": its env and the way out.
templ appSettingsSection(app model.App, envKeys []string) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name }}
	@panel(panelProps{Heading: "app-env-heading", Title: "Environment", Body: panelBodyRows}) {
		@AppEnv(app.Name, envKeys, nil)
	}
	@kit.Card("Remove "+app.Name, nil) {
		@kit.Quiet() {
			Its containers stop and go. Its data stays on the server.
		}
		<div>
			@kit.Button(kit.Danger, "", templ.Attributes{
				"hx-delete":         appPath,
				"hx-swap":           "none",
				"hx-disable":        "this",
				"hx-confirm":        "Remove " + app.Name + "? Its containers stop and go. Its data stays on the server.",
				"data-confirm-name": app.Name,
				"data-remove-app":   true,
			}) {
				Remove app
			}
		</div>
	}
}

func appLiveLine(app model.App) string {
	switch {
	case app.LiveNumber == 0:
		return "Not deployed yet"
	case app.Stopped:
		return fmt.Sprintf("v%d, stopped", app.LiveNumber)
	}
	return fmt.Sprintf("v%d runs", app.LiveNumber)
}

func appLastDeployLine(deploys []api.Deploy) string {
	if len(deploys) == 0 {
		return "Deploy it with moin deploy"
	}
	return "Last deploy " + ago(deploys[0].CreatedAt, time.Now())
}

func appAddressLine(app model.App) string {
	if domains := app.DomainList(); len(domains) > 0 {
		return domains[0]
	}
	if app.InstantHost != "" {
		return app.InstantHost
	}
	return "No address yet"
}

// deployLogActions is the version the log shows, its state and the copy button.
templ deployLogActions() {
	<span id="deploy-log-version" class="text-xs text-muted-foreground tabular-nums"></span>
	<span id="deploy-log-state" class="flex"></span>
	<span data-deploy-log-copy class="contents">
		@copyButton("", "", "Copy the log")
	</span>
}

templ loadLogsButton(appPath string) {
	@kit.Button(kit.Secondary, "", templ.Attributes{"hx-get": appPath + "/logs/lines", "hx-target": "#app-logs", "hx-swap": "outerHTML", "hx-disable": "this"}) {
		Reload
	}
}

// AppDetail is the status, the facts and the deploys of an app. The page
// reloads it on every change the app event stream reports, and follows a
// running deploy.
templ AppDetail(app model.App, deploys []api.Deploy) {
	@appSummary(app)
	@appPower(app)
	@appFacts(app, deploys)
	@appDeploys(app, deploys)
}

// appPower stops a running app or starts a stopped one.
templ appPower(app model.App) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<span id="app-power" hx-swap-oob="true" class="contents">
		if app.Stopped {
			@button.Button(button.Props{
				Variant: button.VariantSecondary,
				Attributes: templ.Attributes{
					"hx-post":    basePath + "/apps/" + app.Name + "/start",
					"hx-swap":    "none",
					"hx-disable": "this",
					"title":      "Run the app again with the env and domains as they are now",
				},
			}) {
				Start
			}
		} else if app.LiveNumber > 0 {
			@button.Button(button.Props{
				Variant: button.VariantSecondary,
				Attributes: templ.Attributes{
					"hx-post":    basePath + "/apps/" + app.Name + "/stop",
					"hx-swap":    "none",
					"hx-disable": "this",
					"hx-confirm": "Stop " + app.Name + "? It is offline until you start it. Its data and settings stay.",
				},
			}) {
				Stop
			}
		}
	</span>
}

// appSummary is the status chip next to the app name.
templ appSummary(app model.App) {
	<div id="app-summary" hx-swap-oob="true" class="flex items-center">
		@appStatus(app)
	</div>
}

// appFacts is what runs, in numbers: the live version, how long the last
// deploy took, the deploys, the service and its databases.
templ appFacts(app model.App, deploys []api.Deploy) {
	{{ detected := liveDetected(deploys) }}
	{{ now := time.Now() }}
	{{ live, hasLive := deployByNumber(deploys, app.LiveNumber) }}
	@statGrid(templ.Attributes{"id": "app-facts", "hx-swap-oob": "true"}) {
		if app.LiveNumber == 0 {
			@statCard("Live", "", "nothing deployed yet")
		} else if hasLive {
			@statCard("Live", fmt.Sprintf("v%d", app.LiveNumber), "since "+ago(live.CreatedAt, now))
		} else {
			@statCard("Live", fmt.Sprintf("v%d", app.LiveNumber), "")
		}
		if d, number := lastTook(deploys); d != "" {
			@statCard("Last deploy took", d, fmt.Sprintf("v%d", number))
		} else {
			@statCard("Last deploy took", "", "no deploy finished yet")
		}
		if n := failedCount(deploys); n > 0 {
			@statCard("Deploys", strconv.Itoa(app.LatestNumber), strconv.Itoa(n)+" failed")
		} else if len(deploys) > 0 {
			@statCard("Deploys", strconv.Itoa(app.LatestNumber), "newest "+ago(deploys[0].CreatedAt, now))
		} else {
			@statCard("Deploys", "0", "")
		}
		if detected != nil {
			@statCard("Port", strconv.Itoa(detected.Port), detected.Service+" · "+detected.Built(), templ.Attributes{"data-detected": true}) {
				for _, database := range detected.Databases {
					<span class="mt-1 block truncate text-xs text-muted-foreground" title={ "On the server: " + database.HostPath }>database <span class="font-mono text-foreground">{ database.Path }</span></span>
				}
			}
		} else {
			@statCard("Port", "", "found on the first deploy", templ.Attributes{"data-detected": false})
		}
	}
}

func failedCount(deploys []api.Deploy) int {
	n := 0
	for _, deploy := range deploys {
		if deploy.Status == model.DeployFailed {
			n++
		}
	}
	return n
}

func deployByNumber(deploys []api.Deploy, number int) (api.Deploy, bool) {
	for _, deploy := range deploys {
		if deploy.Number == number {
			return deploy, true
		}
	}
	return api.Deploy{}, false
}

// lastTook is how long the newest finished deploy took, and its number.
func lastTook(deploys []api.Deploy) (string, int) {
	for _, deploy := range deploys {
		if d := took(deploy.CreatedAt, deploy.FinishedAt); d != "" {
			return d, deploy.Number
		}
	}
	return "", 0
}

// appDeploys is the deploys, newest first. A row shows its log on click.
templ appDeploys(app model.App, deploys []api.Deploy) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ now := time.Now() }}
	@panel(panelProps{
		ID:          "app-detail",
		Heading:     "deploys-heading",
		Title:       "Deploys",
		Description: "Newest first. The live one serves the app.",
		Docs:        "/docs/guides/deploy#what-a-deploy-does",
		Body:        panelBodyRows,
		Attrs: templ.Attributes{
			"hx-swap-oob":        "true",
			"hx-get":             basePath + "/apps/" + app.Name + "/detail",
			"hx-trigger":         "apps-changed from:body",
			"hx-swap":            "none",
			"data-latest-number": strconv.Itoa(app.LatestNumber),
			"data-latest-status": app.LatestStatus,
		},
	}) {
		if len(deploys) == 0 {
			<div class="px-3">
				@emptyHint("No deploys yet. Deploy from GitHub below, or run this in the repo of "+app.Name+":", "moin deploy "+app.Name)
			</div>
		} else {
			<ol class="flex flex-col gap-1" role="list">
				for i, deploy := range deploys {
					<li
						data-deploy={ strconv.Itoa(deploy.Number) }
						data-extra?={ i >= deploysShown }
						class="group/deploy"
					>
						@item.Item(item.Props{Size: item.SizeSm, Class: "relative flex-nowrap items-start hover:bg-muted/60 group-data-selected/deploy:bg-muted"}) {
							@item.Content(item.ContentProps{Class: "min-w-0 gap-0.5"}) {
								<span class="flex min-w-0 items-center gap-3">
									@button.Button(button.Props{
										Variant: button.VariantLink,
										// The version opens the log; its ::after covers the row.
										Class:      "h-auto p-0 font-semibold text-foreground tabular-nums after:absolute after:inset-0 after:rounded-2xl hover:no-underline",
										Attributes: templ.Attributes{"data-follow-deploy": strconv.Itoa(deploy.Number), "aria-label": fmt.Sprintf("Show the log of v%d", deploy.Number)},
									}) {
										{ fmt.Sprintf("v%d", deploy.Number) }
									}
									@deployStatus(deploy, app.LiveNumber)
								</span>
								if deploy.Commit != "" {
									@item.Description(item.DescriptionProps{Class: "line-clamp-1 text-xs", Attributes: templ.Attributes{"title": deploy.CommitMessage, "data-deploy-commit": true}}) {
										<span class="font-mono text-foreground">{ shortCommit(deploy.Commit) }</span>
										{ deploy.CommitMessage }
									}
								}
								if deploy.FromNumber > 0 {
									@item.Description(item.DescriptionProps{Class: "text-xs"}) {
										{ fmt.Sprintf("rollback to v%d", deploy.FromNumber) }
									}
								}
								if deploy.Error != "" {
									@item.Description(item.DescriptionProps{Class: "text-xs text-failed", Attributes: templ.Attributes{"title": deploy.Error}}) {
										{ deploy.Error }
									}
								}
							}
							@item.Actions(item.ActionsProps{Class: "relative h-5 shrink-0"}) {
								<span class={ "text-xs whitespace-nowrap text-muted-foreground tabular-nums", templ.KV("sm:group-hover/deploy:invisible sm:group-data-selected/deploy:invisible sm:group-has-[button:focus-visible]/deploy:invisible", canRollBack(app, deploy)) } title={ stamp(deploy.CreatedAt) }>
									{ ago(deploy.CreatedAt, now) }
									if d := took(deploy.CreatedAt, deploy.FinishedAt); d != "" {
										· { d }
									}
								</span>
								if canRollBack(app, deploy) {
									@button.Button(button.Props{
										Variant: button.VariantSecondary,
										Size:    button.SizeXs,
										Class:   "z-10 max-sm:relative sm:absolute sm:top-1/2 sm:right-0 sm:-translate-y-1/2 sm:invisible sm:group-hover/deploy:visible sm:group-data-selected/deploy:visible sm:focus-visible:visible",
										Attributes: templ.Attributes{
											"hx-post":    basePath + "/apps/" + app.Name + "/rollback",
											"hx-vals":    fmt.Sprintf(`{"number": "%d"}`, deploy.Number),
											"hx-swap":    "none",
											"hx-disable": "this",
											"hx-confirm": fmt.Sprintf("Start the release of v%d again?", deploy.Number),
											"title":      fmt.Sprintf("Release v%d again", deploy.Number),
										},
									}) {
										Roll back
									}
								}
							}
						}
					</li>
				}
			</ol>
			if len(deploys) > deploysShown {
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeSm,
					Class:      "mt-1 w-full text-muted-foreground",
					Attributes: templ.Attributes{"data-show-all": true},
				}) {
					{ fmt.Sprintf("Show %d older", len(deploys)-deploysShown) }
				}
			}
		}
	}
}

// canRollBack is whether a deploy can be released again: it succeeded, is not
// live, and nothing deploys right now.
func canRollBack(app model.App, deploy api.Deploy) bool {
	onServer := deploy.OnServer == nil || *deploy.OnServer
	return deploy.Status == model.DeploySucceeded && deploy.Number != app.LiveNumber && app.LatestStatus != model.DeployRunning && onServer
}

// deploysShown is how many deploys the list shows before "Show older".
const deploysShown = 8

// deployStatus is the state of one deploy, symbol and word.
templ deployStatus(deploy api.Deploy, liveNumber int) {
	switch  {
		case deploy.Status == model.DeployRunning:
			@status.Status(status.Props{Kind: status.KindRunning}) {
				deploying
			}
		case deploy.Status == model.DeployFailed:
			@status.Status(status.Props{Kind: status.KindFailed}) {
				failed
			}
		case deploy.Number == liveNumber:
			@status.Status(status.Props{Kind: status.KindLive}) {
				live
			}
		default:
			@status.Status(status.Props{Kind: status.KindDone}) {
				succeeded
			}
	}
}

// AppLogs shows the container logs, or why they could not be read.
templ AppLogs(lines []string, message string) {
	if message != "" {
		<div id="app-logs" class="flex items-center gap-2 px-6 text-sm text-failed">
			<span aria-hidden="true">✗</span>
			<span>{ message }</span>
		</div>
	} else if len(lines) == 0 {
		<div id="app-logs" class="px-6 text-sm text-muted-foreground">No log lines yet.</div>
	} else {
		<div id="app-logs" class="moin-term moin-term-lines max-h-[30rem] overflow-auto overscroll-contain outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset" data-app-logs tabindex="0" aria-label="Container logs">
			for _, line := range lines {
				{{ entry := parseLogLine(line) }}
				<div class="moin-term-line moin-term-log">
					if entry.Service != "" {
						<span class="moin-term-dim hidden sm:block" title={ entry.Time }>{ entry.Clock }</span>
						<span class="moin-term-dim hidden truncate pr-3 sm:block">{ entry.Service }</span>
					}
					<span class={ templ.KV("sm:col-span-3", entry.Service == "") }>{ entry.Message }</span>
				</div>
			}
		</div>
	}
}

// logLine is one line of docker compose logs --timestamps:
// "web-1  | 2026-10-31T10:31:30.123456789Z message".
type logLine struct {
	Service string
	Time    string
	Clock   string
	Message string
}

func parseLogLine(line string) logLine {
	service, rest, found := strings.Cut(line, " | ")
	service = strings.TrimSpace(service)
	if !found || service == "" || strings.Contains(service, " ") {
		return logLine{Message: line}
	}
	entry := logLine{Service: service, Message: rest}
	if stampText, message, ok := strings.Cut(rest, " "); ok {
		if t, err := time.Parse(time.RFC3339Nano, stampText); err == nil {
			entry.Time = stamp(t)
			entry.Clock = t.UTC().Format("15:04:05")
			entry.Message = message
		}
	}
	return entry
}

// AppEnv is the env list with its add form. values holds the shown values;
// keys without one show as dots.
templ AppEnv(appName string, keys []string, values map[string]string) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ envPath := basePath + "/apps/" + appName + "/env" }}
	<div id="app-env" class="flex flex-col gap-3">
		<div class="flex items-center justify-between gap-2 pl-3">
			<span class="text-xs text-muted-foreground tabular-nums">{ plural(len(keys), "variable", "variables") }</span>
			<div class="flex items-center gap-2">
				if len(keys) > 0 && len(values) == 0 {
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Size:       button.SizeXs,
						Attributes: templ.Attributes{"hx-get": envPath + "?show=1", "hx-target": "#app-env", "hx-swap": "outerHTML"},
					}) {
						@icon.Eye()
						Show values
					}
				} else if len(keys) > 0 {
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Size:       button.SizeXs,
						Attributes: templ.Attributes{"hx-get": envPath, "hx-target": "#app-env", "hx-swap": "outerHTML"},
					}) {
						@icon.EyeOff()
						Hide values
					}
				}
				@envModes(appName, false)
			</div>
		</div>
		if len(keys) > 0 {
			<ul class="flex flex-col" role="list">
				for _, key := range keys {
					<li data-env={ key }>
						@item.Item(item.Props{Size: item.SizeSm, Class: "group/env flex-nowrap py-1.5 pr-1.5 hover:bg-muted/60"}) {
							<span class="max-w-[55%] shrink-0 truncate font-mono text-sm" title={ key }>{ key }</span>
							<span class="min-w-0 flex-1 truncate text-right font-mono text-sm text-muted-foreground">
								if value, ok := values[key]; ok {
									<span data-env-value class="text-foreground">{ value }</span>
								} else {
									<span aria-label="hidden">••••••</span>
								}
							</span>
							@button.Button(button.Props{
								Variant: button.VariantGhost,
								Size:    button.SizeIconSm,
								Class:   "text-muted-foreground focus-visible:opacity-100 sm:opacity-0 sm:group-hover/env:opacity-100",
								Attributes: templ.Attributes{
									"aria-label": "Remove " + key,
									"title":      "Remove " + key,
									"hx-delete":  envPath + "/" + key,
									"hx-target":  "#app-env",
									"hx-swap":    "outerHTML",
									"hx-disable": "this",
									"hx-confirm": "Remove " + key + "? The next deploy drops it.",
								},
							}) {
								@icon.X()
							}
						}
					</li>
				}
			</ul>
		} else {
			<p class="px-3 text-sm text-muted-foreground">No variables yet. Add the first one below.</p>
		}
		<form
			class="flex flex-col gap-2 px-3 sm:flex-row"
			hx-post={ envPath }
			hx-target="#app-env"
			hx-swap="outerHTML"
			hx-disable="find button[type='submit']"
		>
			@csrf.Token()
			<label for="env-key" class="sr-only">Key</label>
			@input.Input(input.Props{ID: "env-key", Name: "key", Type: "text", Placeholder: "KEY", Class: "font-mono sm:w-36 sm:shrink-0", Attributes: templ.Attributes{"autocomplete": "off", "spellcheck": "false", "required": true}})
			<label for="env-value" class="sr-only">Value</label>
			@input.Input(input.Props{ID: "env-value", Name: "value", Type: "password", Placeholder: "value", Class: "min-w-0 font-mono", Attributes: templ.Attributes{"autocomplete": "off"}})
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Class: "shrink-0"}) {
				Set
			}
		</form>
	</div>
}

// appsScript reloads apps whenever the event stream reports a change.
templ appsScript() {
	<script nonce={ templ.GetNonce(ctx) } data-workspace={ ctxkeys.Workspace(ctx).Slug }>
		(() => {
			const events = new EventSource(`/api/v1/apps/events?workspace=${encodeURIComponent(document.currentScript.dataset.workspace)}`);
			events.addEventListener("apps", () => document.body.dispatchEvent(new Event("apps-changed")));
			document.addEventListener("htmx:before:history:update", () => events.close(), { once: true });
		})();
	</script>
}

// appScript follows deploy logs: the newest deploy on load, a running one as
// soon as it shows up, and the one whose row was clicked. Lines show as they
// come; the log keeps to the bottom unless you scroll up. The agent's steps
// show; the tool output between two steps folds into one line that opens on
// click, and errors in it stay visible.
templ appScript(appName string) {
	<script nonce={ templ.GetNonce(ctx) } data-app={ appName } data-workspace={ ctxkeys.Workspace(ctx).Slug }>
		(() => {
			const app = document.currentScript.dataset.app;
			const workspace = document.currentScript.dataset.workspace;
			const log = document.getElementById("deploy-log");
			const version = document.getElementById("deploy-log-version");
			const state = document.getElementById("deploy-log-state");
			const copy = document.querySelector("[data-deploy-log-copy] [data-copy]");
			// Everything bound to document stops when the page goes (DESIGN.md, Navigation).
			// A run of this script on a new swap ends the one before.
			if (window.moinAppPage) window.moinAppPage.abort();
			const gone = new AbortController();
			window.moinAppPage = gone;
			const on = { signal: gone.signal };
			let stream = null;
			let followed = 0;
			let queue = [];
			let frame = 0;
			let raw = [];
			let fold = null;
			let step = "";
			let showAll = false;
			const isOutput = (line) => !line.trim() || /^\s|^#\d|^\[/.test(line);
			const isError = (line) => /\b(error|failed|fatal)\b/i.test(line);
			const kindOf = (line) => {
				if (isOutput(line)) return isError(line) ? "err" : "out";
				if (/^v\d+ is live$/.test(line)) return "ok";
				if (isError(line)) return "err";
				return "step";
			};
			const shorten = (path) => {
				const parts = path.split("/").filter(Boolean);
				return parts.length > 3 ? "…/" + parts.slice(-3).join("/") : path;
			};
			const row = (text, kind, number) => {
				const div = document.createElement("div");
				div.className = "moin-term-line";
				div.dataset.kind = kind;
				div.dataset.n = number;
				const span = document.createElement("span");
				const path = kind === "step" && text.match(/^(.*\S)\s+\((\/[^)\s]{24,})\)$/);
				if (path) {
					const host = document.createElement("span");
					host.className = "moin-term-dim";
					host.title = path[2];
					host.textContent = ` (${shorten(path[2])})`;
					span.append(path[1], host);
				} else {
					span.textContent = text;
				}
				div.appendChild(span);
				return div;
			};
			const label = (group) => {
				const count = group.querySelectorAll(".moin-term-line").length;
				const what = { building: "build", starting: "compose", pulling: "pull" }[group.dataset.step] || "output";
				group.firstChild.lastChild.textContent = `${count} ${what} ${count === 1 ? "line" : "lines"}`;
			};
			const newFold = () => {
				const group = document.createElement("div");
				group.className = "moin-term-fold";
				group.dataset.step = step;
				const toggle = document.createElement("button");
				toggle.type = "button";
				toggle.className = "moin-term-toggle";
				toggle.setAttribute("aria-expanded", "false");
				const arrow = document.createElement("span");
				arrow.className = "moin-term-arrow";
				arrow.setAttribute("aria-hidden", "true");
				arrow.textContent = "▸";
				toggle.append(arrow, document.createElement("span"));
				group.appendChild(toggle);
				return group;
			};
			const flush = () => {
				frame = 0;
				if (!queue.length) return;
				const stick = log.scrollHeight - log.scrollTop - log.clientHeight < 48;
				const touched = new Set();
				for (const [text, forced] of queue) {
					raw.push(text);
					const kind = forced || kindOf(text);
					if (!forced && isOutput(text)) {
						if (!fold) {
							fold = newFold();
							log.appendChild(fold);
						}
						if (text.trim()) fold.appendChild(row(text, kind, raw.length));
						touched.add(fold);
					} else {
						fold = null;
						step = text.trim().split(/\s+/)[0];
						log.appendChild(row(text, kind, raw.length));
					}
				}
				queue = [];
				touched.forEach(label);
				if (copy) copy.dataset.copy = raw.join("\n");
				if (stick) log.scrollTop = log.scrollHeight;
			};
			const add = (text, kind) => {
				queue.push([text, kind]);
				if (!frame) frame = requestAnimationFrame(flush);
			};
			const chips = {
				running: ["bg-running/16 text-[color-mix(in_oklab,var(--running),var(--foreground)_28%)]", "moin-dot-run bg-running"],
				live: ["bg-live/16 text-[color-mix(in_oklab,var(--live),var(--foreground)_18%)]", "moin-dot-live bg-live"],
				failed: ["bg-failed/15 text-[color-mix(in_oklab,var(--failed),var(--foreground)_12%)]", "bg-failed"],
			};
			const show = (text, kind) => {
				const [chip, dot] = chips[kind] || ["bg-muted text-muted-foreground", "bg-muted-foreground"];
				state.className = "inline-flex h-7 items-center gap-2 rounded-full pr-3 pl-2.5 text-[0.8125rem] font-semibold " + chip;
				const mark = document.createElement("span");
				mark.className = "inline-block size-2 rounded-full " + dot;
				state.replaceChildren(mark, document.createTextNode(text));
			};
			const select = () => {
				const detail = document.getElementById("app-detail");
				if (detail && showAll) detail.dataset.all = "";
				document.querySelectorAll("[data-deploy]").forEach((item) => {
					if (Number(item.dataset.deploy) === followed) item.dataset.selected = "true";
					else delete item.dataset.selected;
				});
			};
			const follow = (number) => {
				if (stream) stream.close();
				if (frame) cancelAnimationFrame(frame);
				frame = 0;
				followed = number;
				queue = [];
				raw = [];
				fold = null;
				step = "";
				log.replaceChildren();
				log.scrollTop = 0;
				log.dataset.following = number;
				delete log.dataset.done;
				version.textContent = `v${number}`;
				show("following", "running");
				select();
				stream = new EventSource(`/api/v1/apps/${encodeURIComponent(app)}/deploys/${number}/events?workspace=${encodeURIComponent(workspace)}`);
				stream.addEventListener("line", (event) => add(JSON.parse(event.data).line));
				stream.addEventListener("done", (event) => {
					const deploy = JSON.parse(event.data);
					if (frame) cancelAnimationFrame(frame);
					flush();
					const end = deploy.status === "succeeded" ? `v${deploy.number} is live` : deploy.status === "failed" ? `v${deploy.number} failed: ${deploy.error}` : "";
					if (end && raw[raw.length - 1] !== end) {
						add(end, deploy.status === "succeeded" ? "ok" : "err");
						flush();
					}
					log.dataset.done = deploy.status;
					show(deploy.status === "running" ? "stopped following" : deploy.status, { succeeded: "live", failed: "failed" }[deploy.status]);
					stream.close();
					stream = null;
				});
			};
			const check = () => {
				const detail = document.getElementById("app-detail");
				if (!detail) return;
				const number = Number(detail.dataset.latestNumber);
				if (number > 0 && (followed === 0 || (detail.dataset.latestStatus === "running" && number !== followed))) follow(number);
				else select();
			};
			document.addEventListener("click", (event) => {
				const toggle = event.target.closest(".moin-term-toggle");
				if (toggle) {
					const group = toggle.parentElement;
					const open = !group.hasAttribute("data-open");
					group.toggleAttribute("data-open", open);
					toggle.setAttribute("aria-expanded", String(open));
					return;
				}
				const more = event.target.closest("[data-show-all]");
				if (more) {
					showAll = true;
					select();
					return;
				}
				const button = event.target.closest("[data-follow-deploy]");
				if (button) follow(Number(button.dataset.followDeploy));
			}, on);
			document.addEventListener("htmx:after:swap", () => {
				check();
				const logs = document.querySelector("[data-app-logs]:not([data-scrolled])");
				if (logs) {
					logs.scrollTop = logs.scrollHeight;
					logs.dataset.scrolled = "";
				}
			}, on);
			check();
			document.addEventListener("htmx:before:history:update", () => gone.abort(), { once: true });
			gone.signal.addEventListener("abort", () => {
				if (stream) stream.close();
				if (frame) cancelAnimationFrame(frame);
			});
		})();
	</script>
}

// shortPath keeps the last three parts of a long path: …/volumes/data/app.db.
func shortPath(path string) string {
	parts := strings.Split(strings.Trim(path, "/"), "/")
	if len(parts) <= 3 {
		return path
	}
	return "…/" + strings.Join(parts[len(parts)-3:], "/")
}

func liveDetected(deploys []api.Deploy) *protocol.Detected {
	for _, deploy := range deploys {
		if deploy.Status == model.DeploySucceeded && deploy.Detected != nil {
			return deploy.Detected
		}
	}
	return nil
}

func shortCommit(sha string) string {
	if len(sha) > 7 {
		return sha[:7]
	}
	return sha
}
