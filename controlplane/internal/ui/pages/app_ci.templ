package pages

import (
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/service"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/card"
	"github.com/axadrn/ops/controlplane/internal/ui/components/field"
	"github.com/axadrn/ops/controlplane/internal/ui/components/input"
	"github.com/axadrn/ops/controlplane/internal/ui/components/item"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
)

// appCI is the "Build in CI" part of the app page: deploy an image built
// elsewhere, and the deploy hook CI calls.
templ appCI(appName string) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<div class="grid items-stretch gap-4 lg:grid-cols-2">
		@panel(panelProps{
			Heading:     "app-image-heading",
			Title:       "Deploy an image",
			Description: "Ship an image built in CI or anywhere else. The server keeps the compose file of the live release and only pulls the new image.",
			Action:      docsLink("/docs/guides/ci", "How it works"),
		}) {
			<form
				class="flex flex-col gap-3"
				hx-post={ basePath + "/apps/" + appName + "/image" }
				hx-swap="none"
				hx-disable="find button[type='submit']"
			>
				@csrf.Token()
				@field.Field(field.Props{Class: "gap-1"}) {
					@field.Label(field.LabelProps{For: "image-ref"}) {
						Image
					}
					<div class="flex flex-col gap-2 sm:flex-row">
						@input.Input(input.Props{ID: "image-ref", Name: "image", Type: "text", Placeholder: "ghcr.io/me/" + appName + ":3f2a9c1", Class: "min-w-0 font-mono", Attributes: templ.Attributes{"autocomplete": "off", "spellcheck": "false", "required": true, "aria-describedby": "image-ref-hint"}})
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Class: "shrink-0", Attributes: templ.Attributes{"data-deploy-image": true}}) {
							Deploy image
						}
					</div>
					@fieldHint("image-ref", "") {
						Same as <code class="font-mono">ops deploy --image</code>. A private registry needs a login in <a href={ templ.SafeURL(basePath + "/settings?tab=tokens") }>Settings</a>.
					}
				}
			</form>
		}
		@panel(panelProps{
			Heading:     "app-hook-heading",
			Title:       "Deploy hook",
			Description: "A secret URL your CI calls after it pushed the image. ops then deploys that image.",
			Action:      newHookButton(appName),
		}) {
			@AppHook(appName, "")
		}
	</div>
}

// newHookButton makes a new deploy hook URL; the old URL stops working.
templ newHookButton(appName string) {
	@button.Button(button.Props{
		Variant: button.VariantSecondary,
		Size:    button.SizeSm,
		Attributes: templ.Attributes{
			"hx-post":       ctxkeys.AppBasePath(ctx) + "/apps/" + appName + "/hook",
			"hx-target":     "#app-hook",
			"hx-swap":       "outerHTML",
			"hx-disable":    "this",
			"hx-confirm":    "Create a new deploy hook? The old URL stops working.",
			"data-new-hook": true,
		},
	}) {
		New deploy hook
	}
}

// AppHook shows a new deploy hook URL once, with the curl CI runs.
templ AppHook(appName, url string) {
	<div id="app-hook" class="flex flex-col gap-3">
		if url == "" {
			<p class="text-sm text-muted-foreground">ops shows the URL once, when you create it. Store it as the CI secret <code class="font-mono text-foreground">OPS_DEPLOY_HOOK</code>. A new hook replaces the old one.</p>
		} else {
			<p class="text-sm font-medium">Copy it now: ops shows it only this once. Store it as the CI secret <code class="font-mono">OPS_DEPLOY_HOOK</code>.</p>
			<div data-deploy-hook>
				@command(url)
			</div>
			<p class="text-sm text-muted-foreground">Then let CI call it after pushing the image:</p>
			@command(`curl -fsS -X POST "$OPS_DEPLOY_HOOK?image=ghcr.io/me/` + appName + `:$GITHUB_SHA"`)
		}
	</div>
}

// SettingsRegistriesSection lists the registry logins agents pull private images with.
templ SettingsRegistriesSection(logins []service.RegistryLogin) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<div id="settings-registries">
		@card.Card() {
			@card.Header() {
				@card.Title(card.TitleProps{Class: "text-base font-semibold"}) {
					Registries
				}
				@card.Description() {
					Logins your servers use to pull private images built in CI. Passwords and tokens are stored encrypted and only handed to the agent for the pull.
				}
			}
			@card.Content(card.ContentProps{Class: "flex flex-col gap-6"}) {
				if len(logins) > 0 {
					@item.Group(item.GroupProps{Class: "-mx-3 w-auto gap-1"}) {
						for _, login := range logins {
							@item.Item(item.Props{Size: item.SizeXs, Class: "rounded-xl hover:bg-muted/60", Attributes: templ.Attributes{"role": "listitem", "data-registry": login.Host}}) {
								@item.Content(item.ContentProps{Class: "min-w-0"}) {
									@item.Title() {
										<span class="truncate font-mono">{ login.Host }</span>
									}
									@item.Description(item.DescriptionProps{Class: "text-xs"}) {
										as { login.Username }
									}
								}
								@item.Actions() {
									@button.Button(button.Props{
										Variant: button.VariantGhost,
										Size:    button.SizeSm,
										Attributes: templ.Attributes{
											"hx-delete":  basePath + "/settings/registries/" + login.Host,
											"hx-target":  "#settings-registries",
											"hx-swap":    "outerHTML",
											"hx-disable": "this",
											"hx-confirm": "Remove the login for " + login.Host + "? Private images from it no longer pull.",
										},
									}) {
										Remove
									}
								}
							}
						}
					}
				}
				<form
					class="flex flex-col gap-3"
					hx-post={ basePath + "/settings/registries" }
					hx-target="#settings-registries"
					hx-swap="outerHTML"
					hx-disable="find button[type='submit']"
				>
					@csrf.Token()
					<div class="grid gap-3 sm:grid-cols-3">
						@field.Field(field.Props{Class: "gap-1"}) {
							@field.Label(field.LabelProps{For: "registry-host"}) {
								Registry
							}
							@input.Input(input.Props{ID: "registry-host", Name: "host", Type: "text", Placeholder: "ghcr.io", Class: "font-mono", Attributes: templ.Attributes{"autocomplete": "off", "spellcheck": "false", "required": true, "aria-describedby": "registry-host-hint"}})
							@fieldHint("registry-host", "") {
								The host name, like ghcr.io.
							}
						}
						@field.Field(field.Props{Class: "gap-1"}) {
							@field.Label(field.LabelProps{For: "registry-username"}) {
								Username
							}
							@input.Input(input.Props{ID: "registry-username", Name: "username", Type: "text", Attributes: templ.Attributes{"autocomplete": "off", "required": true, "aria-describedby": "registry-username-hint"}})
							@fieldHint("registry-username", "")
						}
						@field.Field(field.Props{Class: "gap-1"}) {
							@field.Label(field.LabelProps{For: "registry-password"}) {
								Password or token
							}
							@input.Input(input.Props{ID: "registry-password", Name: "password", Type: "password", Attributes: templ.Attributes{"autocomplete": "new-password", "required": true, "aria-describedby": "registry-password-hint"}})
							@fieldHint("registry-password", "") {
								Stored encrypted.
							}
						}
					</div>
					<div class="flex justify-end">
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
							Save login
						}
					</div>
				</form>
			}
		}
	</div>
}
