package pages

import (
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/ui/csrf"
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
)

// appCI is the "Deploy from CI" card of the Deploys section: deploy an
// image built elsewhere, and the deploy hook CI calls; hook says the app
// has one.
templ appCI(appName string, hook bool) {
	<div class="grid" data-app-ci>
		@kit.Card("Deploy from CI", nil) {
			<form
				hx-post={ ctxkeys.AppBasePath(ctx) + "/apps/" + appName + "/image" }
				hx-swap="none"
				hx-disable="find button[type='submit']"
			>
				@csrf.Token()
				@kit.Field("Deploy an image", "image-ref", "") {
					@kit.Inline() {
						@kit.Input(templ.Attributes{"id": "image-ref", "name": "image", "type": "text", "placeholder": "ghcr.io/me/" + appName + ":3f2a9c1", "autocomplete": "off", "autocapitalize": "off", "spellcheck": "false", "required": true})
						@kit.Button(kit.Secondary, "", templ.Attributes{"type": "submit", "data-deploy-image": true}) {
							Deploy image
						}
					}
				}
			</form>
			@AppHook(appName, "", hook)
		}
	</div>
}

// AppHook is the deploy hook: whether the app has one, the buttons, and a
// new hook's URL once, with the curl CI runs.
templ AppHook(appName, url string, on bool) {
	<div id="app-hook" class="flex flex-col gap-3" data-hook-on?={ on }>
		<div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
			<div class="min-w-0 px-1">
				<p class="text-sm font-medium">Deploy hook</p>
				<p class="text-sm text-muted-foreground">
					if on {
						On
					} else {
						Off
					}
				</p>
			</div>
			<div class="flex flex-wrap gap-2">
				if on {
					@kit.Button(kit.Secondary, "", templ.Attributes{
						"hx-delete":     ctxkeys.AppBasePath(ctx) + "/apps/" + appName + "/hook",
						"hx-target":     "#app-hook",
						"hx-swap":       "outerHTML",
						"hx-disable":    "this",
						"hx-confirm":    "Turn off the deploy hook? Its URL stops working and CI can no longer deploy " + appName + ".",
						"data-hook-off": true,
					}) {
						Turn off
					}
				}
				@newHookButton(appName, on)
			</div>
		</div>
		if url != "" {
			@kit.Quiet() {
				Copy it now, it shows only once. Store it in CI as the secret <code class="font-mono text-foreground">MOIN_DEPLOY_HOOK</code>.
			}
			<div data-deploy-hook>
				@kit.Command(url)
			</div>
			@kit.Quiet() {
				CI calls it after pushing the image:
			}
			@kit.Command(`curl -fsS -X POST "$MOIN_DEPLOY_HOOK?image=ghcr.io/me/` + appName + `:$GITHUB_SHA"`)
		}
	</div>
}

// newHookButton makes a new deploy hook URL. It asks first only when it
// replaces a hook, whose URL then stops working.
templ newHookButton(appName string, replaces bool) {
	{{
		attributes := templ.Attributes{
			"hx-post":       ctxkeys.AppBasePath(ctx) + "/apps/" + appName + "/hook",
			"hx-target":     "#app-hook",
			"hx-swap":       "outerHTML",
			"hx-disable":    "this",
			"data-new-hook": true,
		}
		if replaces {
			attributes["hx-confirm"] = "Create a new deploy hook? The old URL stops working."
		}
	}}
	@kit.Button(kit.Secondary, "", attributes) {
		New deploy hook
	}
}
