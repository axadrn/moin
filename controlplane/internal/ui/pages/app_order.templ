package pages

import (
	"context"

	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
	"github.com/axadrn/ops/controlplane/internal/ui/utils"
)

// The Apps and Servers pages show their items as a list or a grid, as each
// member likes, in the order of the workspace. Sortable.js, started by the
// panel layout (layouts.sortableScript), drags them into a new order: its
// end event sends the form, whose hidden inputs carry the names in their
// new order. The arrow buttons move one item up or down without a drag,
// for the keyboard and screen readers.

// pageView is how the signed-in member sees the "apps" or "servers" page.
func pageView(ctx context.Context, page string) string {
	user := ctxkeys.User(ctx)
	if user == nil {
		return (&model.User{}).View(page)
	}
	return user.View(page)
}

// orderForm is the form around a list or grid of page ("apps" or
// "servers") that saves a new order.
templ orderForm(page string) {
	<form
		id={ page + "-order" }
		hx-post={ ctxkeys.AppBasePath(ctx) + "/" + page + "/order" }
		hx-trigger="end, submit"
		hx-swap="none"
		data-order-form
	>
		@csrf.Token()
		{ children... }
	</form>
}

// orderControls is what an item of an ordered list carries: its name as a hidden
// input, so the form sends the order of the page, and the handle and arrows
// that move it. kind names it for screen readers: "app" or "server".
templ orderControls(kind, name string, first, last bool, class string) {
	<input type="hidden" name="order" value={ name }/>
	<div class={ utils.CN("flex shrink-0 items-center gap-0.5 text-muted-foreground", class) } data-order-controls>
		<span
			class="flex size-7 cursor-grab touch-none items-center justify-center rounded-md hover:bg-muted hover:text-foreground active:cursor-grabbing"
			title="Drag to reorder"
			aria-hidden="true"
			data-drag-handle
		>
			@icon.GripVertical(icon.Props{Class: "size-4"})
		</span>
		@orderButton("up", kind, name, first) {
			@icon.ArrowUp(icon.Props{Class: "size-4"})
		}
		@orderButton("down", kind, name, last) {
			@icon.ArrowDown(icon.Props{Class: "size-4"})
		}
	</div>
}

templ orderButton(direction, kind, name string, disabled bool) {
	<button
		type="submit"
		name={ direction }
		value={ name }
		class="flex size-7 items-center justify-center rounded-md outline-none hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-30"
		aria-label={ "Move " + kind + " " + name + " " + direction }
		title={ "Move " + direction }
		disabled?={ disabled }
	>
		{ children... }
	</button>
}

// viewSwitch picks a list or a grid for page, remembered for the member.
templ viewSwitch(page string) {
	{{ view := pageView(ctx, page) }}
	<form
		hx-post={ ctxkeys.AppBasePath(ctx) + "/" + page + "/view" }
		hx-swap="none"
		class="inline-flex items-center gap-0.5 rounded-lg bg-muted p-0.5"
		role="group"
		aria-label="View"
		data-view-switch={ view }
	>
		@csrf.Token()
		@viewButton(view == model.ViewList, model.ViewList, "List") {
			@icon.LayoutList(icon.Props{Class: "size-4"})
		}
		@viewButton(view == model.ViewGrid, model.ViewGrid, "Grid") {
			@icon.LayoutGrid(icon.Props{Class: "size-4"})
		}
	</form>
}

templ viewButton(pressed bool, value, label string) {
	<button
		type="submit"
		name="view"
		value={ value }
		aria-pressed={ boolString(pressed) }
		class="flex h-7 items-center gap-1.5 rounded-md px-2 text-xs font-medium text-muted-foreground outline-none hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring aria-pressed:bg-background aria-pressed:text-foreground aria-pressed:shadow-sm"
	>
		{ children... }
		{ label }
	</button>
}
