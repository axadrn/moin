package pages

import (
	"context"

	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
)

// The Apps and Servers pages show their items as a list or a grid, as each
// member likes, in the order of the workspace. Sortable.js, started by the
// panel layout (layouts.sortableScript), drags them into a new order: its
// end event sends the form, whose hidden inputs carry the names in their
// new order. On the keyboard, Alt and an arrow key move the focused item.

// pageView is how the signed-in member sees the "apps" or "servers" page.
func pageView(ctx context.Context, page string) string {
	user := ctxkeys.User(ctx)
	if user == nil {
		return (&model.User{}).View(page)
	}
	return user.View(page)
}

// orderForm is the form around a list or grid of page ("apps" or
// "servers") that saves a new order.
templ orderForm(page string) {
	<form
		id={ page + "-order" }
		hx-post={ ctxkeys.AppBasePath(ctx) + "/" + page + "/order" }
		hx-trigger="end, submit"
		hx-swap="none"
		data-order-form
	>
		@csrf.Token()
		{ children... }
	</form>
}

// listCard is one item of a list of apps or servers: a slim card of its
// own, the grip on its left, so it lifts as a whole when dragged.
const listCard = "min-w-0 flex-row items-center gap-1 rounded-3xl py-1.5 pr-1.5 pl-2"

// orderHandle is what an item of an ordered list carries: its name as a
// hidden input, so the form sends the order of the page, and a grip at its
// left that shows it can be dragged. With a mouse the whole item drags; on a touch
// screen the grip does, so the page still scrolls.
templ orderHandle(name string) {
	<input type="hidden" name="order" value={ name }/>
	<span
		class="flex size-7 shrink-0 cursor-grab touch-none items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground active:cursor-grabbing"
		title="Drag to reorder"
		aria-hidden="true"
		data-drag-handle
	>
		@icon.GripVertical(icon.Props{Class: "size-4"})
	</span>
}

// viewSwitch picks a list or a grid for page, remembered for the member.
templ viewSwitch(page string) {
	{{ view := pageView(ctx, page) }}
	<form
		hx-post={ ctxkeys.AppBasePath(ctx) + "/" + page + "/view" }
		hx-swap="none"
		class="inline-flex items-center gap-0.5 rounded-lg bg-muted p-0.5"
		role="group"
		aria-label="View"
		data-view-switch={ view }
	>
		@csrf.Token()
		@viewButton(view == model.ViewList, model.ViewList, "List") {
			@icon.LayoutList(icon.Props{Class: "size-4"})
		}
		@viewButton(view == model.ViewGrid, model.ViewGrid, "Grid") {
			@icon.LayoutGrid(icon.Props{Class: "size-4"})
		}
	</form>
}

// viewButton is one icon of the view switch; label names it for screen
// readers and on hover.
templ viewButton(pressed bool, value, label string) {
	<button
		type="submit"
		name="view"
		value={ value }
		aria-pressed={ boolString(pressed) }
		aria-label={ label }
		title={ label }
		class="flex size-7 items-center justify-center rounded-md text-muted-foreground outline-none hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring aria-pressed:bg-background aria-pressed:text-foreground aria-pressed:shadow-sm"
	>
		{ children... }
	</button>
}
