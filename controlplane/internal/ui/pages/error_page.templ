package pages

import (
	"strconv"
	"strings"

	"github.com/axadrn/moin/controlplane/internal/ui/components/button"
	"github.com/axadrn/moin/controlplane/internal/ui/components/empty"

	"github.com/axadrn/moin/controlplane/internal/ui/blocks"
	"github.com/axadrn/moin/controlplane/internal/ui/components"
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
)

templ ErrorPage(status int, title, description string) {
	<!DOCTYPE html>
	<html lang="en" data-nonce={ templ.GetNonce(ctx) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="robots" content="noindex, nofollow"/>
			<title>{ title }</title>
			<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml"/>
			<script nonce={ templ.GetNonce(ctx) }>
				const theme = localStorage.getItem('theme') || 'system';
				const dark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
				document.documentElement.classList.toggle('dark', dark);
			</script>
			<link href="/assets/css/output.css" rel="stylesheet"/>
			@components.Scripts()
		</head>
		<body class="style-nova min-h-screen">
			@StatusScreen(title, description, strconv.Itoa(status)+" "+title)
		</body>
	</html>
}

// StatusScreen is the full page for 404s and errors, built from the empty
// component: an icon, what happened in words, the code as a log line, and
// the way back.
templ StatusScreen(title, description, line string) {
	<div class="flex min-h-svh flex-col bg-background">
		<header class="mx-auto flex h-20 w-full max-w-6xl items-center px-5 sm:px-8">
			<a href="/" class="text-[22px] leading-none">
				@blocks.Wordmark()
			</a>
		</header>
		<main class="flex flex-1 items-center justify-center px-5 pb-24 sm:px-8">
			@empty.Empty() {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						if strings.HasPrefix(line, "404") {
							@icon.SearchX()
						} else {
							@icon.TriangleAlert()
						}
					}
					@empty.Title() {
						{ title }
					}
					@empty.Description() {
						{ description }
					}
				}
				@empty.Content(empty.ContentProps{Class: "flex-row flex-wrap justify-center gap-2"}) {
					@button.Button(button.Props{Href: "/"}) {
						Back to home
					}
					@button.Button(button.Props{Href: "/docs", Variant: button.VariantOutline}) {
						Read the docs
					}
				}
				<p class="font-mono text-xs text-muted-foreground">{ line }</p>
			}
		</main>
	</div>
}
