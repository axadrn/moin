package pages

import (
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"strconv"

	"github.com/axadrn/ops/controlplane/internal/ui/blocks"
	"github.com/axadrn/ops/controlplane/internal/ui/components"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
)

templ ErrorPage(status int, title, description string) {
	<!DOCTYPE html>
	<html lang="en" data-nonce={ templ.GetNonce(ctx) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="robots" content="noindex, nofollow"/>
			<title>{ title }</title>
			<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml"/>
			<script nonce={ templ.GetNonce(ctx) }>
				const theme = localStorage.getItem('theme') || 'system';
				const dark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
				document.documentElement.classList.toggle('dark', dark);
			</script>
			<link href="/assets/css/output.css" rel="stylesheet"/>
			@components.Scripts()
		</head>
		<body class="style-nova min-h-screen">
			@StatusScreen(title, description, strconv.Itoa(status)+" "+title)
		</body>
	</html>
}

// StatusScreen is the full page for 404s and errors: what happened in
// words, the code as a log line, and the way back.
templ StatusScreen(title, description, line string) {
	<div class="flex min-h-svh flex-col bg-background">
		<header class="mx-auto flex h-20 w-full max-w-6xl items-center px-5 sm:px-8">
			<a href="/" class="text-[22px] leading-none">
				@blocks.Wordmark()
			</a>
		</header>
		<main class="mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-5 pb-24 sm:px-8">
			<h1 class="max-w-2xl text-3xl font-bold tracking-tight text-balance">{ title }</h1>
			<p class="mt-2 max-w-lg text-sm text-pretty text-muted-foreground">{ description }</p>
			<p class="mt-6 inline-flex max-w-full items-center gap-2 self-start overflow-hidden rounded-full bg-terminal px-4 py-2 font-mono text-xs text-terminal-foreground">
				<span class="text-failed">✗</span>
				<span class="truncate">{ line }</span>
			</p>
			<div class="mt-6 flex flex-wrap gap-2">
				@button.Button(button.Props{Href: "/"}) {
					@icon.ArrowLeft(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
					Back to home
				}
				@button.Button(button.Props{Href: "/docs", Variant: button.VariantSecondary}) {
					Read the docs
				}
			</div>
		</main>
	</div>
}
