package pages

import (
	"strconv"

	"github.com/axadrn/moin/controlplane/internal/ui/kit"
)

templ ErrorPage(status int, title, description string) {
	<!DOCTYPE html>
	<html lang="en" data-nonce={ templ.GetNonce(ctx) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="robots" content="noindex, nofollow"/>
			<title>{ title }</title>
			<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml"/>
			<script nonce={ templ.GetNonce(ctx) }>
				const theme = localStorage.getItem('theme') || 'system';
				const dark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
				document.documentElement.classList.toggle('dark', dark);
			</script>
			<link href="/assets/css/output.css" rel="stylesheet"/>
		</head>
		<body class="style-nova min-h-screen">
			@StatusScreen(title, description, strconv.Itoa(status)+" "+title)
		</body>
	</html>
}

// StatusScreen is the full page for 404s and errors: what happened, the
// way back, and the code as a log line.
templ StatusScreen(title, description, line string) {
	@authFrame(title) {
		@authLine() {
			{ description }
		}
		@authStack() {
			@kit.Button(kit.Primary, "/", nil) {
				Back to home
			}
		}
		<p class="text-center font-mono text-xs break-all text-muted-foreground">{ line }</p>
	}
}
