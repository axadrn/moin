package pages

import (
	"strconv"

	"github.com/axadrn/moin/controlplane/internal/ui/blocks"
	"github.com/axadrn/moin/controlplane/internal/ui/components/button"
	"github.com/axadrn/moin/controlplane/internal/ui/components/field"
	"github.com/axadrn/moin/controlplane/internal/ui/components/input"
	"github.com/axadrn/moin/controlplane/internal/ui/csrf"
)

// AuthPasswordForm keeps the email it was sent, so a wrong password is
// the only thing to type again.
templ AuthPasswordForm(email, errorMsg string) {
	<form
		id="password-form"
		action="/auth/password"
		method="POST"
		hx-post="/auth/password"
		hx-target="#password-form"
		hx-swap="outerHTML"
		hx-disable="find button[type='submit']"
	>
		@csrf.Token()
		@field.Group() {
			@field.Field() {
				@field.Label(field.LabelProps{For: "email"}) {
					Email 
				}
				@input.Input(input.Props{
					Class: "h-11 text-base", ID: "email", Name: "email", Type: "email", Value: email, Placeholder: "you@company.com", Attributes: templ.Attributes{"aria-describedby": "email-hint", "autocomplete": "email", "autofocus": ""}})
				@fieldHint("email", "")
			}
			@field.Field() {
				<div class="flex items-center">
					@field.Label(field.LabelProps{For: "password"}) {
						Password 
					}
					<a href="/auth/forgot-password" class="ml-auto text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">Forgot password?</a>
				</div>
				@input.Input(input.Props{
					Class: "h-11 text-base", ID: "password", Name: "password", Type: "password", Placeholder: "••••••••", Attributes: templ.Attributes{"aria-invalid": strconv.FormatBool(errorMsg != ""), "aria-describedby": "password-hint", "autocomplete": "current-password"}})
				@fieldHint("password", errorMsg)
			}
			@button.Button(button.Props{Size: button.SizeLg, Type: button.TypeSubmit, Class: blocks.AuthPrimary}) {
				Sign in 
			}
		}
	</form>
}
