package pages

import (
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
)

// AuthPasswordForm keeps the email it was sent, so a wrong password is
// the only thing to type again.
templ AuthPasswordForm(email, errorMsg string) {
	<form
		id="password-form"
		action="/auth/password"
		method="POST"
		class="flex flex-col gap-4"
		hx-post="/auth/password"
		hx-target="#password-form"
		hx-swap="outerHTML"
		hx-disable="find button[type='submit']"
	>
		@kit.CSRF()
		@formField("Email", "email", "", "") {
			@kit.Input(templ.Attributes{"id": "email", "aria-describedby": "email-hint", "name": "email", "type": "email", "value": email, "placeholder": "you@company.com", "autocomplete": "email", "autofocus": email == "", "required": true})
		}
		@formField("Password", "password", "", errorMsg) {
			@kit.Input(templ.Attributes{"id": "password", "name": "password", "type": "password", "aria-invalid": ariaInvalid(errorMsg), "aria-describedby": "password-hint", "autocomplete": "current-password", "autofocus": email != "", "required": true})
		}
		@kit.Button(kit.Primary, "", templ.Attributes{"type": "submit"}) {
			Sign in
		}
		@authLink("/auth/forgot-password") {
			Forgot password?
		}
	</form>
}
