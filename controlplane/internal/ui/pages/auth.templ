package pages

import (
	"github.com/axadrn/ops/controlplane/internal/brand"
	"github.com/axadrn/ops/controlplane/internal/config"
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/ui/blocks"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/field"
	"github.com/axadrn/ops/controlplane/internal/ui/layouts"
)

templ Auth(errorMsg string) {
	@layouts.Auth(layouts.SEOProps{
		Title:       "Sign in",
		Description: "Sign in to " + brand.Name + " or create your account",
		Path:        ctxkeys.URLPath(ctx),
	}) {
		@blocks.AuthShell(brand.Name) {
			@blocks.AuthCard("Sign in or sign up", "Enter your email. We send you a link, no password needed.") {
				@field.Group() {
					@AuthMagicLinkForm(errorMsg)
					if config.GoogleOAuthEnabled || ctxkeys.RenderConfig(ctx).GitHubLogin {
						@blocks.AuthOr()
						@blocks.OAuthButtons(config.GoogleOAuthEnabled, ctxkeys.RenderConfig(ctx).GitHubLogin)
					}
					@blocks.AuthOr()
					@button.Button(button.Props{Href: "/auth/password", Variant: button.VariantSecondary, Class: blocks.AuthSecondary}) {
						Sign in with a password
					}
				}
			}
		}
	}
}
