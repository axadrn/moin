package pages

import (
	"strings"

	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
	"github.com/axadrn/moin/internal/build"
)

// SettingsHomeView is what Settings shows beyond the request: GitHub.
type SettingsHomeView struct {
	// GitHub is whether this control plane has the GitHub App, GitHubAccounts
	// the accounts this workspace connected.
	GitHub         bool
	GitHubAccounts []string
}

// SettingsHome is Settings of the workspace: what belongs to it first, then
// your workspaces (a tap switches), you, moin itself, and signing out at
// the end. Your picture in the bar opens it.
templ SettingsHome(view SettingsHomeView) {
	{{ user := ctxkeys.User(ctx) }}
	{{ workspace := ctxkeys.Workspace(ctx) }}
	{{ member := ctxkeys.WorkspaceMember(ctx) }}
	{{ base := ctxkeys.AppBasePath(ctx) }}
	{{ cfg := ctxkeys.RenderConfig(ctx) }}
	@layouts.App("Settings") {
		@panelPage() {
			@kit.Header(kit.Back{}, "Settings")
			@kit.Section(workspace.Name, nil) {
				@kit.List() {
					@kit.Row(base + "/workspace") {
						@kit.RowText("Team", "")
					}
					if view.GitHub {
						@kit.Row(base + "/settings/github") {
							@kit.RowText("GitHub", "")
							<span class="truncate text-sm text-muted-foreground">{ gitHubValue(view.GitHubAccounts) }</span>
						}
					}
					@kit.Row(base + "/alerts") {
						@kit.RowText("Alerts", "")
					}
					@kit.Row(base + "/bucket") {
						@kit.RowText("Bucket", "")
					}
					@kit.Row(base + "/activity") {
						@kit.RowText("Activity", "")
					}
					if member != nil && member.Can(model.WorkspacePermissionManageBilling) && cfg.Billing {
						@kit.Row(base + "/billing") {
							@kit.RowText("Billing", "")
						}
					}
				}
			}
			@kit.Section("Workspaces", nil) {
				@kit.List() {
					for _, item := range ctxkeys.Workspaces(ctx) {
						if item.ID == workspace.ID {
							// The open one is no place to go: a check where
							// the others have their chevron.
							@kit.Row("") {
								@workspaceRowText(item)
								<svg aria-label="Open now" viewBox="0 0 16 16" class="size-4 shrink-0"><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
							}
						} else {
							@kit.Row("/app/" + item.Slug + "/settings") {
								@workspaceRowText(item)
							}
						}
					}
					@kit.Row("/workspaces/new") {
						@kit.RowText("New workspace", "")
					}
				}
			}
			@kit.Section("You", nil) {
				@kit.List() {
					@kit.Row(base + "/settings/account") {
						@kit.Avatar(user.AvatarURL, user.Name, user.Initials(), "size-9")
						@kit.RowText(user.Name, user.Email)
					}
				}
			}
			@kit.Section("moin", nil) {
				@kit.List() {
					@kit.RowControl(nil) {
						<span class="flex-1 font-medium">Appearance</span>
						<div class="flex h-11 items-center gap-1 rounded-full bg-muted p-1" role="group" aria-label="Appearance">
							for _, theme := range []string{"system", "light", "dark"} {
								<button type="button" data-theme-set={ theme } aria-pressed="false" class="h-full rounded-full px-4 text-sm font-medium text-muted-foreground outline-none hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/30 aria-pressed:bg-background aria-pressed:text-foreground aria-pressed:shadow-sm">
									{ strings.ToUpper(theme[:1]) + theme[1:] }
								</button>
							}
						</div>
					}
					@kit.Row("/docs") {
						@kit.RowText("Docs", "")
					}
					@kit.Row("/changelog") {
						<div class="min-w-0 flex-1 font-medium" data-changelog={ build.Version }>Changelog</div>
						<span data-changelog-dot hidden class="size-2 rounded-full bg-foreground" aria-label="New"></span>
						<span class="font-mono text-sm text-muted-foreground">{ build.Version }</span>
					}
					@kit.RowFact("Support", "") {
						<span class="select-all">{ cfg.SupportEmail }</span>
					}
				}
			}
			if ctxkeys.IsAdmin(ctx) {
				@kit.List() {
					@kit.Row("/admin") {
						@kit.RowText("Admin", "")
					}
				}
			}
			@kit.List() {
				@kit.RowButton(true, templ.Attributes{"hx-post": "/auth/logout", "hx-swap": "none", "data-logout": "true"}) {
					<span class="font-medium">Sign out</span>
				}
			}
		}
	}
}

// workspaceRowText is a workspace in the list: its initial, its name, and
// your role in it under the name.
templ workspaceRowText(item model.WorkspaceMembership) {
	<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-foreground text-sm font-semibold text-background">{ model.Initial(item.Name) }</span>
	@kit.RowText(item.Name, model.WorkspaceRoleLabel(item.Role))
}

// gitHubValue is what the GitHub row says: the accounts, or Connect.
func gitHubValue(accounts []string) string {
	if len(accounts) == 0 {
		return "Connect"
	}
	return strings.Join(accounts, ", ")
}

// SettingsGitHub is the GitHub connection of the workspace, once for every
// app: the accounts it reaches, each with the page on GitHub where its owner
// picks the repos moin may read (and can remove moin), and Connect.
templ SettingsGitHub(installations []model.GitHubInstallation) {
	{{ base := ctxkeys.AppBasePath(ctx) }}
	@layouts.App("GitHub · Settings") {
		@panelPage() {
			@kit.Header(kit.Back{Label: "Settings", Href: base + "/settings"}, "GitHub")
			@kit.List() {
				for _, installation := range installations {
					if installation.SettingsURL != "" {
						@kit.RowExternal(installation.SettingsURL) {
							@kit.RowText(installation.Account, "")
							<span class="text-sm text-muted-foreground">Repos on GitHub</span>
						}
					} else {
						@kit.Row("") {
							@kit.RowText(installation.Account, "")
						}
					}
				}
				@kit.Row(base + "/github/install?next=" + base + "/settings/github") {
					@kit.RowText(gitHubConnectLabel(installations), "")
				}
			}
		}
	}
}

func gitHubConnectLabel(installations []model.GitHubInstallation) string {
	if len(installations) == 0 {
		return "Connect GitHub"
	}
	return "Connect another account"
}
