package pages

import (
	"fmt"
	"strings"
	"time"

	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/service"
	"github.com/axadrn/moin/controlplane/internal/ui/components/status"
	"github.com/axadrn/moin/controlplane/internal/ui/csrf"
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
	"github.com/axadrn/moin/protocol"
)

// BackupsView is the backups of an app: its bucket, the buckets of the
// workspace to pick from, Older the ones the app left, which keep its
// older backups, and what the agent reports about its databases.
type BackupsView struct {
	App     model.App
	Storage *service.Bucket
	Buckets []service.Bucket
	Older   []service.Bucket
	Backups protocol.Backups
	// Error says why the server could not report its backups.
	Error string
	Now   time.Time
}

// backupOf is what the agent reports about one database.
func (view BackupsView) backupOf(database string) (protocol.DatabaseBackup, bool) {
	for _, backup := range view.Backups.Databases {
		if backup.Database == database {
			return backup, true
		}
	}
	return protocol.DatabaseBackup{}, false
}

// BackupSettings is how an app is backed up, for all its databases: the
// backup before every change and the bucket. Without a bucket, the way to
// add one.
templ BackupSettings(view BackupsView) {
	<div id="data-backups">
		@kit.Section("Backups", nil) {
			@kit.List() {
				if view.Storage == nil {
					@kit.Row(ctxkeys.AppBasePath(ctx) + "/bucket") {
						<span class="flex-1 font-medium" data-add-bucket>Add your bucket</span>
					}
				} else {
					@BackupSettingsForm(view.App)
					@kit.Row(ctxkeys.AppBasePath(ctx) + "/bucket") {
						<span class="shrink-0 font-medium">Bucket</span>
						<span class="min-w-0 flex-1 truncate text-right text-sm text-muted-foreground" data-backup-storage={ view.Storage.Name }>{ view.Storage.Name }</span>
					}
					@kit.RowFact("Folder", "") {
						<span class="font-mono" data-bucket-folder>{ view.Storage.AppFolder(&view.App) }</span>
					}
					if len(view.Older) > 0 {
						@kit.RowFact("Older backups", "") {
							<span data-bucket-older>{ olderNames(view.Older) }</span>
						}
					}
					if len(view.Buckets) > 1 {
						@bucketDisclosure("Use another bucket") {
							@AppBucketForm(view)
						}
					}
				}
			}
		}
	</div>
}

// BackupSettingsForm is the switch for the backup before every change, the
// first row of the backups list. It saves itself.
templ BackupSettingsForm(app model.App) {
	@switchForm("backup-settings-form", ctxkeys.AppBasePath(ctx)+"/apps/"+app.Name+"/backups/settings", "snapshot-before-changes", "Back up before every change", "", app.SnapshotBeforeChanges)
}

// AppBucketForm picks the bucket of the app. It asks first, because new
// backups start in the other bucket and the older ones stay where they
// are.
templ AppBucketForm(view BackupsView) {
	<form
		id="app-bucket-form"
		class="flex flex-col gap-3 sm:flex-row sm:items-center"
		hx-post={ ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name + "/bucket" }
		hx-target="#data-backups"
		hx-select="#data-backups"
		hx-swap="outerHTML"
		hx-disable="find button[type='submit']"
		hx-confirm={ "Move the uploads and new backups of " + view.App.Name + " to this bucket? Its older backups stay in " + view.Storage.Name + "; restores of them read from there." }
		data-confirm-action="Move"
	>
		@csrf.Token()
		@kit.Select(kit.SelectProps{ID: "app-bucket", Name: "bucket", Label: "Bucket", Options: appBucketOptions(view.Buckets), Value: appBucketValue(view.App)})
		@kit.Button(kit.Secondary, "", templ.Attributes{"type": "submit"}) {
			Move
		}
	</form>
}

// appBucketDefault is the select's value for "the workspace's default".
// Bucket names never start with a dash, so it is no bucket's name.
const appBucketDefault = "-default"

func appBucketValue(app model.App) string {
	if app.BucketName == "" {
		return appBucketDefault
	}
	return app.BucketName
}

// appBucketOptions are the choices: the default, whichever it is, then
// each bucket by name.
func appBucketOptions(buckets []service.Bucket) []kit.Option {
	options := []kit.Option{}
	for _, bucket := range buckets {
		if bucket.Default {
			options = append(options, kit.Option{Value: appBucketDefault, Label: "The default (" + bucket.Name + ")"})
		}
	}
	for _, bucket := range buckets {
		options = append(options, kit.Option{Value: bucket.Name, Label: bucket.Name})
	}
	return options
}

// DatabaseBackups is the backups of one database: how its continuous
// backup is, then its backups, newest first. Pick one, then Restore. Back
// up now and a restore show they run in the first row while they do.
templ DatabaseBackups(view BackupsView, database string) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name }}
	{{ backup, known := view.backupOf(database) }}
	<div id="db-backups" class="group/backups" data-database-backup={ database }>
		@kit.Section("Backups", backUpNow(view, database)) {
			if view.Storage == nil {
				@kit.List() {
					@kit.Row(ctxkeys.AppBasePath(ctx) + "/bucket") {
						<span class="flex-1 font-medium" data-add-bucket>Add your bucket</span>
					}
				}
			} else if view.Error != "" {
				@dataError(view.Error)
			} else {
				<form
					class="flex flex-col gap-2"
					hx-post={ appPath + "/backups/restore" }
					hx-target="#db-backups"
					hx-swap="outerHTML"
					hx-disable="find button[type='submit']"
					hx-confirm={ "Restore " + databaseName(database) + " from the backup you picked? It replaces the data there now; moin backs it up first, and the app stops for a moment." }
					data-confirm-name={ view.App.Name }
					data-confirm-action="Restore"
					data-restore
				>
					@csrf.Token()
					<input type="hidden" name="database" value={ database }/>
					@kit.List() {
						@backupState(backup, known, database, view.Now)
						if backup.Note != "" {
							@kit.RowAttrs("", templ.Attributes{"data-backup-note": true}) {
								<p class="min-w-0 flex-1 text-sm break-words text-muted-foreground">{ backup.Note }</p>
							}
						}
						if known && len(backup.Snapshots) == 0 {
							@kit.Row("") {
								<p class="flex-1 text-sm text-muted-foreground">No backup yet.</p>
							}
						}
						for index, snapshot := range backup.Snapshots {
							if index < backupsShown {
								@backupPick(view, snapshot)
							}
						}
						if len(backup.Snapshots) > backupsShown {
							@kit.RowMore(plural(len(backup.Snapshots)-backupsShown, "older backup", "older backups")) {
								for _, snapshot := range backup.Snapshots[backupsShown:] {
									@backupPick(view, snapshot)
								}
							}
						}
					}
					if len(backup.Snapshots) > 0 {
						<div class="flex justify-end">
							@kit.Button(kit.Secondary, "", templ.Attributes{"type": "submit", "disabled": true, "data-restore-button": true}) {
								Restore
							}
						</div>
					}
				</form>
			}
		}
	</div>
	@backupScript.Once() {
		<script nonce={ templ.GetNonce(ctx) }>
			// Restore works once a backup is picked.
			document.addEventListener("change", (event) => {
				const form = event.target.closest?.("[data-restore]");
				if (!form || event.target.name !== "snapshot") return;
				const button = form.querySelector("[data-restore-button]");
				if (button) button.disabled = false;
			});
		</script>
	}
}

// backupsShown is how many backups the list shows before "older backups".
const backupsShown = 8

var backupScript = templ.NewOnceHandle()

// backUpNow is the one primary button of a database: a backup now, of every
// database of the app.
func backUpNow(view BackupsView, database string) templ.Component {
	if view.Storage == nil {
		return nil
	}
	return backUpNowForm(view.App.Name, database)
}

templ backUpNowForm(app, database string) {
	<form hx-post={ ctxkeys.AppBasePath(ctx) + "/apps/" + app + "/backups/now" } hx-target="#db-backups" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-back-up-form>
		@csrf.Token()
		<input type="hidden" name="database" value={ database }/>
		@kit.Button(kit.Primary, "", templ.Attributes{"type": "submit", "data-back-up": true}) {
			Back up now
		}
	</form>
}

// backupState is the first row of the backups: how the continuous backup
// of the database is. While Back up now or a restore runs, it says so.
templ backupState(backup protocol.DatabaseBackup, known bool, database string, now time.Time) {
	@kit.RowAttrs("", templ.Attributes{"data-backup-state": true}) {
		<div class="hidden min-w-0 flex-1 items-center gap-3 group-has-[[data-back-up-form].htmx-request]/backups:flex" role="status">
			@status.Symbol(status.KindRunning)
			<span class="font-medium">Backing up</span>
		</div>
		<div class="hidden min-w-0 flex-1 items-center gap-3 group-has-[[data-restore].htmx-request]/backups:flex" role="status">
			@status.Symbol(status.KindRunning)
			<span class="truncate font-medium">Restoring { databaseName(database) }</span>
		</div>
		<div class="flex min-w-0 flex-1 items-center gap-3 group-has-[.htmx-request]/backups:hidden">
			switch  {
				case !known:
					@status.Symbol(status.KindRunning)
					@kit.RowText("Starting", "")
				case backup.Error != "":
					@status.Symbol(status.KindFailed)
					<div class="min-w-0 flex-1">
						<div class="font-medium text-failed">Backup fails</div>
						<div class="text-sm break-words text-muted-foreground">{ backup.Error }</div>
					</div>
				case backup.ReplicatedAt != nil:
					@status.Symbol(status.KindLive)
					@kit.RowText("Every change", "Backed up "+ago(*backup.ReplicatedAt, now))
					<span class="shrink-0 text-sm text-muted-foreground tabular-nums" data-verified?={ backup.VerifiedAt != nil } title={ verifiedStamp(backup) }>{ verifiedText(backup, now) }</span>
				default:
					@status.Symbol(status.KindRunning)
					@kit.RowText("Starting", "")
			}
		</div>
	}
}

func verifiedText(backup protocol.DatabaseBackup, now time.Time) string {
	if backup.VerifiedAt == nil {
		return "Not checked yet"
	}
	return "Checked " + ago(*backup.VerifiedAt, now)
}

func verifiedStamp(backup protocol.DatabaseBackup) string {
	if backup.VerifiedAt == nil {
		return ""
	}
	return "Restored and checked " + stamp(*backup.VerifiedAt)
}

// backupPick is one backup to pick for a restore: when, why and how big.
// One in a bucket the app left says which, and its restore reads from
// there.
templ backupPick(view BackupsView, snapshot protocol.Snapshot) {
	@kit.RowPick(templ.Attributes{"name": "snapshot", "value": snapshot.ID, "data-snapshot": snapshot.ID}) {
		if olderSnapshot(view, snapshot) {
			<input type="hidden" name={ "bucket:" + snapshot.ID } value={ snapshot.Bucket }/>
		}
		<div class="min-w-0 flex-1">
			<div class="truncate font-medium tabular-nums" title={ stamp(snapshot.CreatedAt) }>{ snapshot.CreatedAt.UTC().Format("Jan 2, 15:04 UTC") }</div>
			<div class="truncate text-sm text-muted-foreground">
				{ reasonText(snapshot.Reason) } · { size(snapshot.Size) }
				if olderSnapshot(view, snapshot) {
					· <span data-snapshot-bucket={ snapshot.Bucket }>in { snapshot.Bucket }</span>
				}
			</div>
		</div>
		<span class="shrink-0 text-sm text-muted-foreground tabular-nums">{ ago(snapshot.CreatedAt, view.Now) }</span>
	}
}

func olderNames(buckets []service.Bucket) string {
	names := make([]string, 0, len(buckets))
	for _, bucket := range buckets {
		names = append(names, bucket.Name)
	}
	return strings.Join(names, ", ")
}

// olderSnapshot says a backup is in a bucket the app left.
func olderSnapshot(view BackupsView, snapshot protocol.Snapshot) bool {
	return snapshot.Bucket != "" && view.Storage != nil && snapshot.Bucket != view.Storage.Name
}

// backupFact is a fact with its label over it and a note under it.
templ backupFact(label, value, note string) {
	<div class="flex min-w-0 flex-col gap-1">
		<dt class="text-sm text-muted-foreground">{ label }</dt>
		<dd class="text-sm font-medium tabular-nums">{ value }</dd>
		<dd class="text-xs text-muted-foreground">{ note }</dd>
	</div>
}

func orAWS(endpoint string) string {
	if endpoint == "" {
		return "AWS S3"
	}
	return endpoint
}

// reasonText says why moin took a backup.
func reasonText(reason string) string {
	switch {
	case reason == "manual":
		return "By hand"
	case reason == "hourly":
		return "Hourly"
	case strings.HasPrefix(reason, "before-sql"):
		return "Before a change"
	case strings.HasPrefix(reason, "before-restore"):
		return "Before a restore"
	case strings.HasPrefix(reason, "before-v"):
		return "Before deploy " + strings.TrimPrefix(reason, "before-")
	}
	return reason
}

func size(bytes int64) string {
	switch {
	case bytes < 1<<10:
		return fmt.Sprintf("%d B", bytes)
	case bytes < 1<<20:
		return fmt.Sprintf("%.1f KB", float64(bytes)/(1<<10))
	case bytes < 1<<30:
		return fmt.Sprintf("%.1f MB", float64(bytes)/(1<<20))
	}
	return fmt.Sprintf("%.1f GB", float64(bytes)/(1<<30))
}
