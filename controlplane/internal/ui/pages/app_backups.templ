package pages

import (
	"fmt"
	"github.com/axadrn/ops/controlplane/internal/ui/components/alert"
	"github.com/axadrn/ops/controlplane/internal/ui/components/badge"
	"github.com/axadrn/ops/controlplane/internal/ui/components/card"
	"github.com/axadrn/ops/controlplane/internal/ui/components/empty"
	"github.com/axadrn/ops/controlplane/internal/ui/components/item"
	"github.com/axadrn/ops/controlplane/internal/ui/utils"
	"time"

	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/service"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/input"
	"github.com/axadrn/ops/controlplane/internal/ui/components/switch"
	"github.com/axadrn/ops/controlplane/internal/ui/csrf"
	"github.com/axadrn/ops/controlplane/internal/ui/layouts"
	"github.com/axadrn/ops/protocol"
)

// BackupsView is the backups page of an app.
type BackupsView struct {
	App     model.App
	Storage *service.BackupStorage
	Backups protocol.Backups
	// Notice says what just happened; Error why the server could not answer
	// or a change failed.
	Notice string
	Error  string
	Now    time.Time
}

templ AppBackups(view BackupsView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@layouts.AppShell(layouts.AppProps{Title: view.App.Name + " backups", Crumbs: []layouts.Crumb{{Label: "Apps", Href: basePath + "/apps"}, {Label: view.App.Name, Href: basePath + "/apps/" + view.App.Name}, {Label: "Backups"}}}) {
		@panelPage(templ.Attributes{"data-app-backups": view.App.Name}) {
			<div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
				<div class="min-w-0">
					<h1 class="truncate font-display text-[2.5rem] leading-none sm:text-[2.875rem]">{ view.App.Name }</h1>
					<p class="mt-2.5 text-sm text-muted-foreground">
						Every change replicated, a snapshot before every change, a restore drill every day.
					</p>
				</div>
				if view.Storage != nil && len(view.Backups.Databases) > 0 {
					<form hx-post={ basePath + "/apps/" + view.App.Name + "/backups/now" } hx-target="#app-backups" hx-select="#app-backups" hx-swap="outerHTML">
						@csrf.Token()
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantBrand, Size: button.SizeLg, Attributes: templ.Attributes{"data-back-up": true}}) {
							Back up now
						}
					</form>
				}
			</div>
			@appTabs(view.App.Name, "backups")
			<div id="app-backups" class="mt-4 flex flex-col gap-4">
				if view.Notice != "" {
					@alert.Alert(alert.Props{Class: "border-0 rounded-2xl bg-live/12 px-5 py-3.5 text-sm font-medium text-live", Attributes: templ.Attributes{"data-backup-notice": true}}) {
						{ view.Notice }
					}
				}
				if view.Error != "" {
					@alert.Alert(alert.Props{Class: "border-0 rounded-2xl bg-failed/12 px-5 py-3.5 text-sm font-medium text-failed", Attributes: templ.Attributes{"data-backup-error": true}}) {
						{ view.Error }
					}
				}
				if view.Storage == nil {
					@card.Card(card.Props{Class: panelClasses}) {
						@empty.Empty(empty.Props{Class: "items-start gap-0 rounded-none px-6 py-10 text-left"}) {
							@empty.Title(empty.TitleProps{Class: "font-sans text-lg font-semibold"}) {
								Backups go to your own bucket
							}
							@empty.Description(empty.DescriptionProps{Class: "mt-1.5 max-w-xl text-sm"}) {
								Add one S3-compatible bucket for all your apps, and every SQLite database is backed up from then on. The same bucket carries your code on ops deploy.
							}
							@button.Button(button.Props{Href: ctxkeys.AppBasePath(ctx) + "/bucket", Variant: button.VariantBrand, Size: button.SizeLg, Class: "mt-5 h-11 px-6", Attributes: templ.Attributes{"data-add-bucket": true}}) {
								Add your bucket
							}
						}
					}
				} else {
					for _, database := range view.Backups.Databases {
						@databaseBackup(view, database)
					}
					if len(view.Backups.Databases) == 0 && view.Error == "" {
						@emptyState("No SQLite database yet", "Backups start as soon as the live release keeps a SQLite database on a volume.", "ops deploy "+view.App.Name)
					}
					<div class="grid items-start gap-4 lg:grid-cols-2">
						@backupSettings(view)
						@bucketSummary(view)
					</div>
				}
			</div>
		}
	}
}

templ databaseBackup(view BackupsView, database protocol.DatabaseBackup) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name }}
	@card.Card(card.Props{Class: "block gap-0 py-0 text-base min-w-0 overflow-hidden", Attributes: templ.Attributes{"data-database-backup": database.Database}}) {
		@card.Header(card.HeaderProps{Class: panelHeadClasses}) {
			@card.Title(card.TitleProps{Class: "font-mono text-[17px]", Attributes: templ.Attributes{"role": "heading", "aria-level": "2"}}) {
				{ database.Database }
			}
			if database.Error != "" {
				@badge.Badge(badge.Props{Class: "h-auto leading-4 inline-flex items-center gap-2 rounded-full bg-failed/12 px-3 py-1 text-xs font-semibold text-failed"}) {
					<span class="size-1.5 rounded-full bg-failed"></span>
					Needs attention
				}
			} else if database.VerifiedAt != nil {
				@badge.Badge(badge.Props{Class: "h-auto leading-4 inline-flex items-center gap-2 rounded-full bg-live/12 px-3 py-1 text-xs font-semibold text-live", Attributes: templ.Attributes{"data-verified": true}}) {
					<span class="lp-pulse size-1.5 rounded-full bg-live"></span>
					Verified by restore { ago(*database.VerifiedAt, view.Now) }
				}
			} else if database.ReplicatedAt != nil {
				@badge.Badge(badge.Props{Class: "h-auto leading-4 inline-flex items-center gap-2 rounded-full bg-live/12 px-3 py-1 text-xs font-semibold text-live"}) {
					<span class="lp-pulse size-1.5 rounded-full bg-live"></span>
					Replicating
				}
			} else {
				@badge.Badge(badge.Props{Class: "h-auto leading-4 inline-flex items-center gap-2 rounded-full bg-running/12 px-3 py-1 text-xs font-semibold text-running"}) {
					<span class="size-1.5 rounded-full bg-running"></span>
					Starting
				}
			}
		}
		if database.Error != "" {
			<p class="px-5 pb-2 text-sm text-failed">{ database.Error }</p>
		}
		<div class="grid gap-3 px-4 pb-4 sm:grid-cols-3">
			@backupFact("Continuous", replicatedText(database, view.Now), "every change, about once a second")
			@backupFact("Point in time", windowText(database), "restore to any second in it")
			@backupFact("Snapshots", fmt.Sprint(len(database.Snapshots)), latestSnapshot(database, view.Now))
		</div>
		<div class="grid gap-4 border-t border-border px-4 pt-4 pb-4 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
			<div class="min-w-0">
				<h3 class="px-1 text-sm font-semibold">Snapshots</h3>
				if len(database.Snapshots) == 0 {
					<p class="px-1 pt-2 text-sm text-muted-foreground">None yet. ops takes one before every deploy and change, or now with Back up now.</p>
				} else {
					<ul class="mt-2 flex max-h-[22rem] flex-col gap-0.5 overflow-y-auto" role="list" data-snapshots>
						for _, snapshot := range database.Snapshots {
							<li data-snapshot={ snapshot.ID }>
								@item.Item(item.Props{Class: "flex-nowrap gap-0 p-0 text-base border-0 rounded-none group/snap flex h-12 items-center gap-3 rounded-xl px-3 transition-colors hover:bg-muted/60"}) {
									<span class="w-28 shrink-0 text-sm tabular-nums">{ ago(snapshot.CreatedAt, view.Now) }</span>
									@badge.Badge(badge.Props{Class: utils.CN("h-auto leading-4", utils.CN("shrink-0 rounded-full px-2.5 py-0.5 text-xs font-semibold", reasonClass(snapshot.Reason)))}) {
										{ reasonText(snapshot.Reason) }
									}
									<span class="min-w-0 flex-1 truncate text-right font-mono text-xs text-muted-foreground" title={ snapshot.CreatedAt.Format(time.RFC3339) }>{ size(snapshot.Size) }</span>
									<form
										hx-post={ appPath + "/backups/restore" }
										hx-target="#app-backups"
										hx-select="#app-backups"
										hx-swap="outerHTML"
										hx-confirm={ "Restore " + database.Database + " from the snapshot of " + snapshot.CreatedAt.Format("Jan 2, 15:04") + " UTC? ops takes a snapshot of the current state first. The app stops for a moment." }
									>
										@csrf.Token()
										<input type="hidden" name="database" value={ database.Database }/>
										<input type="hidden" name="snapshot" value={ snapshot.ID }/>
										@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Size: button.SizeSm, Class: "text-xs focus-visible:opacity-100 sm:opacity-0 sm:group-hover/snap:opacity-100"}) {
											Restore
										}
									</form>
								}
							</li>
						}
					</ul>
				}
			</div>
			<form
				class="flex flex-col gap-3 rounded-2xl bg-muted/60 p-4"
				hx-post={ appPath + "/backups/restore" }
				hx-target="#app-backups"
				hx-select="#app-backups"
				hx-swap="outerHTML"
				hx-confirm={ "Restore " + database.Database + " to this point in time? ops takes a snapshot of the current state first. The app stops for a moment." }
			>
				@csrf.Token()
				<input type="hidden" name="database" value={ database.Database }/>
				<h3 class="text-sm font-semibold">Back to a point in time</h3>
				<p class="text-xs text-muted-foreground">Any second in the window, in UTC. Deleted the wrong rows at 14:02? Restore to 14:01.</p>
				@input.Input(input.Props{
					Type:       "datetime-local",
					Name:       "at",
					Value:      pointInTimeValue(database.ReplicatedAt),
					Required:   true,
					Class:      "font-mono text-[0.8125rem] md:text-[0.8125rem]",
					Attributes: pointInTimeAttrs(database.Since, database.ReplicatedAt),
				})
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Size: button.SizeLg, Disabled: database.Since == nil}) {
					Restore to this time
				}
			</form>
		</div>
	}
}

templ backupFact(label, value, note string) {
	@card.Card(card.Props{Class: "block gap-0 py-0 text-base overflow-visible rounded-2xl bg-muted/60 px-4 py-3.5"}) {
		<p class="text-xs text-muted-foreground">{ label }</p>
		<p class="mt-1 text-lg font-semibold tabular-nums">{ value }</p>
		<p class="text-xs text-muted-foreground">{ note }</p>
	}
}

templ backupSettings(view BackupsView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name }}
	{{ on := view.App.SnapshotBeforeChanges }}
	@card.Card(card.Props{Class: "block gap-0 py-0 text-base min-w-0 overflow-hidden"}) {
		@card.Header(card.HeaderProps{Class: panelHeadClasses}) {
			@card.Title(card.TitleProps{Attributes: templ.Attributes{"role": "heading", "aria-level": "2"}}) {
				Before every change
			}
		}
		<form class="flex items-start justify-between gap-4 px-5 pt-1 pb-5" hx-post={ appPath + "/backups/settings" } hx-trigger="change" hx-swap="none">
			@csrf.Token()
			<label for="snapshot-before-changes" class="text-sm text-muted-foreground">
				<span class="block font-semibold text-foreground">Take a snapshot first</span>
				Before every deploy, restore, cell edit and SQL change made through ops. One click undoes a bad migration or a wrong UPDATE.
			</label>
			@switchcomp.Switch(switchcomp.Props{ID: "snapshot-before-changes", Name: "on", Value: "1", DefaultChecked: on})
		</form>
	}
}

templ bucketSummary(view BackupsView) {
	@card.Card(card.Props{Class: "block gap-0 py-0 text-base min-w-0 overflow-hidden", Attributes: templ.Attributes{"data-backup-storage": true}}) {
		@card.Header(card.HeaderProps{Class: panelHeadClasses}) {
			@card.Title(card.TitleProps{Attributes: templ.Attributes{"role": "heading", "aria-level": "2"}}) {
				Bucket
			}
			<a class="text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline" href={ templ.SafeURL(ctxkeys.AppBasePath(ctx) + "/bucket") }>Change</a>
		}
		<dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1.5 px-5 pb-5 text-sm">
			<dt class="text-muted-foreground">Bucket</dt>
			<dd class="truncate font-mono text-[0.8125rem]" data-bucket>{ view.Storage.Bucket }{ storagePathText(view.Storage.Path) }</dd>
			<dt class="text-muted-foreground">Endpoint</dt>
			<dd class="truncate font-mono text-[0.8125rem]">{ orAWS(view.Storage.Endpoint) }</dd>
		</dl>
	}
}

templ storageField(name, label, placeholder, note, kind string, wide bool) {
	<label class={ "flex min-w-0 flex-col gap-1", templ.KV("sm:col-span-2", wide) }>
		<span class="flex items-baseline gap-2 text-xs font-semibold">
			{ label }
			if note != "" {
				<span class="font-normal text-muted-foreground">{ note }</span>
			}
		</span>
		@input.Input(input.Props{Name: name, Type: kind, Placeholder: placeholder, Class: "font-mono text-[0.8125rem]", Attributes: templ.Attributes{"autocomplete": "off", "spellcheck": "false"}})
	</label>
}

// pointInTimeValue is the newest second the point in time form restores to.
func pointInTimeValue(replicatedAt *time.Time) string {
	if replicatedAt == nil {
		return ""
	}
	return replicatedAt.UTC().Format("2006-01-02T15:04:05")
}

// pointInTimeAttrs bounds the point in time input by the backup window.
func pointInTimeAttrs(since, replicatedAt *time.Time) templ.Attributes {
	attrs := templ.Attributes{"step": "1"}
	if since != nil {
		attrs["min"] = since.UTC().Format("2006-01-02T15:04:05")
	}
	if replicatedAt != nil {
		attrs["max"] = replicatedAt.UTC().Format("2006-01-02T15:04:05")
	}
	return attrs
}

func storagePathText(path string) string {
	if path == "" {
		return ""
	}
	return "/" + path
}

func orAWS(endpoint string) string {
	if endpoint == "" {
		return "AWS S3"
	}
	return endpoint
}

func replicatedText(database protocol.DatabaseBackup, now time.Time) string {
	if database.ReplicatedAt == nil {
		return "starting"
	}
	return ago(*database.ReplicatedAt, now)
}

func windowText(database protocol.DatabaseBackup) string {
	if database.Since == nil || database.ReplicatedAt == nil {
		return "–"
	}
	span := database.ReplicatedAt.Sub(*database.Since)
	switch {
	case span < time.Hour:
		return fmt.Sprintf("%d min", max(int(span.Minutes()), 1))
	case span < 48*time.Hour:
		return fmt.Sprintf("%d h", int(span.Hours()))
	}
	return fmt.Sprintf("%d days", int(span.Hours()/24))
}

func latestSnapshot(database protocol.DatabaseBackup, now time.Time) string {
	if len(database.Snapshots) == 0 {
		return "none yet"
	}
	return "newest " + ago(database.Snapshots[0].CreatedAt, now)
}

func reasonText(reason string) string {
	switch reason {
	case "manual":
		return "by hand"
	case "before-sql":
		return "before a change"
	case "before-restore":
		return "before a restore"
	}
	if len(reason) > 7 && reason[:7] == "before-" {
		return "before " + reason[7:]
	}
	return reason
}

func reasonClass(reason string) string {
	if reason == "manual" {
		return "bg-foreground text-background"
	}
	return "bg-secondary text-muted-foreground"
}

func size(bytes int64) string {
	switch {
	case bytes < 1<<10:
		return fmt.Sprintf("%d B", bytes)
	case bytes < 1<<20:
		return fmt.Sprintf("%.1f KB", float64(bytes)/(1<<10))
	case bytes < 1<<30:
		return fmt.Sprintf("%.1f MB", float64(bytes)/(1<<20))
	}
	return fmt.Sprintf("%.1f GB", float64(bytes)/(1<<30))
}
