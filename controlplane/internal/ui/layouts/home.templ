package layouts

import "github.com/axadrn/ops/controlplane/internal/ui/blocks"

templ Home(seo SEOProps) {
	@Base(seo) {
		<div class="min-h-svh bg-background">
			@blocks.Navbar()
			{ children... }
			@blocks.Footer()
		</div>
		@blocks.FloatingNews("goilerplate-4", blocks.GoilerplateURL, "goilerplate is free and open source")
	}
}
