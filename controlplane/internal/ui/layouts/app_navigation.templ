package layouts

import (
	"strings"

	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/components/kbd"
	"github.com/axadrn/ops/controlplane/internal/ui/components/sidebar"
)

// navItem is one place of the panel: its icon, its label, and the go-to
// key (g, then the key) when it has one.
type navItem struct {
	Title  string
	URL    string
	Icon   func(...icon.Props) templ.Component
	Active bool
	Key    string
}

// AppSidebarNavigation is the places of the panel, grouped as in nav-main of
// shadcn's sidebar-07. Collapsed to icons, each names itself in a tooltip.
templ AppSidebarNavigation() {
	{{ member := ctxkeys.WorkspaceMember(ctx) }}
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ path := ctxkeys.URLPath(ctx) }}
	@navGroup("Platform", []navItem{
		{Title: "Apps", URL: basePath + "/apps", Icon: icon.Boxes, Active: path == basePath+"/apps", Key: "A"},
		{Title: "Servers", URL: basePath + "/servers", Icon: icon.Server, Active: strings.HasPrefix(path, basePath+"/servers"), Key: "S"},
		{Title: "Bucket", URL: basePath + "/bucket", Icon: icon.Archive, Active: strings.HasPrefix(path, basePath+"/bucket"), Key: "B"},
		{Title: "Activity", URL: basePath + "/activity", Icon: icon.Activity, Active: strings.HasPrefix(path, basePath+"/activity"), Key: "Y"},
	})
	{{ manage := []navItem{
		{Title: "Team", URL: basePath + "/workspace", Icon: icon.Users, Active: path == basePath+"/workspace", Key: "T"},
		{Title: "Alerts", URL: basePath + "/alerts", Icon: icon.Bell, Active: strings.HasPrefix(path, basePath+"/alerts"), Key: "L"},
		{Title: "Settings", URL: basePath + "/settings", Icon: icon.Settings, Active: strings.HasPrefix(path, basePath+"/settings"), Key: ","},
	} }}
	if member.Can(model.WorkspacePermissionManageBilling) && ctxkeys.RenderConfig(ctx).Billing {
		{{ manage = append(manage, navItem{Title: "Billing", URL: basePath + "/billing", Icon: icon.CreditCard, Active: strings.HasPrefix(path, basePath+"/billing")}) }}
	}
	@navGroup("Workspace", manage)
}

templ navGroup(label string, items []navItem) {
	@sidebar.Group() {
		@sidebar.GroupLabel() {
			{ label }
		}
		@sidebar.Menu() {
			for _, item := range items {
				@sidebar.MenuItem() {
					@sidebar.MenuButton(sidebar.MenuButtonProps{Href: item.URL, IsActive: item.Active, Tooltip: item.Title}) {
						@item.Icon()
						<span class="truncate">{ item.Title }</span>
						if item.Key != "" {
							@navKey(item.Key)
						}
					}
				}
			}
		}
	}
}

// navKey is the go-to hint: g, then the key. It shows on hover.
templ navKey(key string) {
	@kbd.Group(kbd.GroupProps{Class: "ml-auto hidden gap-0.5 opacity-0 transition-opacity group-hover/menu-button:opacity-100 group-focus-visible/menu-button:opacity-100 group-data-active/menu-button:hidden group-data-[collapsible=icon]:hidden md:flex", Attributes: templ.Attributes{"aria-hidden": "true"}}) {
		@kbd.Kbd() {
			G
		}
		@kbd.Kbd() {
			{ key }
		}
	}
}
