package layouts

import (
	"github.com/axadrn/ops/internal/build"
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	dropdown "github.com/axadrn/ops/controlplane/internal/ui/components/dropdownmenu"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
)

// AppSidebarHelpItems are the docs, support and the version of the control
// plane in the account menu: there when needed, out of the way otherwise.
templ AppSidebarHelpItems() {
	@dropdown.Item(dropdown.ItemProps{Href: "/docs", Attributes: templ.Attributes{"target": "_blank", "rel": "noopener"}}) {
		@icon.BookOpen()
		Docs
	}
	@dropdown.Item(dropdown.ItemProps{Href: "mailto:" + ctxkeys.RenderConfig(ctx).SupportEmail}) {
		@icon.LifeBuoy()
		Support
	}
	@dropdown.Item(dropdown.ItemProps{Href: "/changelog", Attributes: templ.Attributes{"target": "_blank", "rel": "noopener", "data-version": build.Version}}) {
		@icon.Tag()
		Changelog
		<span class="ml-auto font-mono text-xs text-muted-foreground">{ build.Version }</span>
	}
}
