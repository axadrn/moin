package layouts

import (
	"github.com/axadrn/moin/internal/build"
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	dropdown "github.com/axadrn/moin/controlplane/internal/ui/components/dropdownmenu"
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
)

// AppSidebarHelpItems are the docs, support and the version of the control
// plane in the account menu: there when needed, out of the way otherwise.
templ AppSidebarHelpItems() {
	@dropdown.Item(dropdown.ItemProps{Href: "/docs", Attributes: templ.Attributes{"target": "_blank", "rel": "noopener"}}) {
		@icon.BookOpen()
		Docs
	}
	@dropdown.Item(dropdown.ItemProps{Href: "mailto:" + ctxkeys.RenderConfig(ctx).SupportEmail}) {
		@icon.LifeBuoy()
		Support
	}
	// A dot marks a version the member has not opened the changelog for
	// yet; the shell script shows it and clears it on click.
	@dropdown.Item(dropdown.ItemProps{Href: "/changelog", Attributes: templ.Attributes{"target": "_blank", "rel": "noopener", "data-version": build.Version, "data-changelog": build.Version}}) {
		@icon.Tag()
		Changelog
		<span data-changelog-dot hidden class="size-1.5 rounded-full bg-live"></span>
		<span class="ml-auto font-mono text-xs text-muted-foreground">{ build.Version }</span>
	}
}
