package layouts

import (
	dropdown "github.com/axadrn/ops/controlplane/internal/ui/components/dropdownmenu"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
)

// AppSidebarLogout signs out. htmx posts it with the CSRF header the body
// sets for every request.
templ AppSidebarLogout() {
	@dropdown.Item(dropdown.ItemProps{
		Attributes: templ.Attributes{
			"hx-post":     "/auth/logout",
			"hx-swap":     "none",
			"data-logout": "true",
		},
	}) {
		@icon.LogOut()
		Sign out
	}
}
