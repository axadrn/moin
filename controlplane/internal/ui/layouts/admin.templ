package layouts

import (
	"github.com/axadrn/ops/controlplane/internal/brand"
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/ui/blocks"
	"github.com/axadrn/ops/controlplane/internal/ui/components/button"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
)

templ Admin(title string) {
	@Base(SEOProps{Title: title, Description: "Operator administration", Path: ctxkeys.URLPath(ctx), NoIndex: true}) {
		<div class="min-h-screen bg-background">
			<header class="sticky top-0 z-20 border-b bg-background">
				<div class="mx-auto flex h-12 w-full max-w-7xl items-center gap-3 px-4 sm:px-6 lg:px-8">
					<a href="/admin" class="flex items-center gap-2 rounded-md outline-none focus-visible:ring-2 focus-visible:ring-ring/60">
						@OpsMark("size-5")
						<span class="text-[0.9375rem] font-bold tracking-tighter">{ brand.Name + " Admin" }</span>
					</a>
					<div class="ml-auto flex items-center gap-2">
						@blocks.ThemeSwitcher()
						@button.Button(button.Props{Href: "/app", Variant: button.VariantOutline, Size: button.SizeSm}) {
							@icon.ArrowLeft(icon.Props{Class: "size-4"})
							Back to the panel
						}
					</div>
				</div>
			</header>
			<main class="mx-auto w-full max-w-7xl px-4 pt-6 pb-16 sm:px-6 lg:px-8 lg:pt-8">
				{ children... }
			</main>
		</div>
	}
}
