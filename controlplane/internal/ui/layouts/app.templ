package layouts

import (
	"net/url"

	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	"github.com/axadrn/ops/controlplane/internal/ui/blocks"
	dropdown "github.com/axadrn/ops/controlplane/internal/ui/components/dropdownmenu"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/components/sidebar"
)

// Crumb is one step of the path in the top bar. The last one has no link.
type Crumb struct {
	Label string
	Href  string
}

// AppProps is the shell of a control panel page.
type AppProps struct {
	Title  string
	Crumbs []Crumb
}

// App is the control panel shell with the page title as the only crumb.
templ App(title string) {
	@AppShell(AppProps{Title: title}) {
		{ children... }
	}
}

// AppShell is the control panel: the sidebar with the places, the top bar
// with the path, and the page.
templ AppShell(p AppProps) {
	{{ cfg := ctxkeys.RenderConfig(ctx) }}
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@Base(SEOProps{
		Title:       p.Title,
		Description: "The ops control panel",
		Path:        ctxkeys.URLPath(ctx),
	}) {
		@sidebar.Provider(sidebar.ProviderProps{
			Class:      "bg-background",
			Attributes: templ.Attributes{"style": "--sidebar-width: 15.5rem; --sidebar-width-icon: 3rem; --header-height: 3.5rem;"},
		}) {
			@sidebar.Sidebar(sidebar.Props{Collapsible: sidebar.CollapsibleOffcanvas, Variant: sidebar.VariantSidebar, Class: "border-r-0"}) {
				@sidebar.Header(sidebar.HeaderProps{Class: "shrink-0 flex-row items-center px-3.5 pt-5 pb-0"}) {
					@AppSidebarIdentity()
				}
				@sidebar.Content(sidebar.ContentProps{Class: "gap-0 pt-5"}) {
					@sidebar.Group(sidebar.GroupProps{Class: "px-3.5 py-0"}) {
						@sidebar.Menu(sidebar.MenuProps{Class: "gap-1"}) {
							@AppSidebarNavigation()
						}
					}
					<div
						id="sidebar-apps"
						class="mt-6 px-3.5"
						hx-get={ basePath + "/apps/nav?at=" + url.QueryEscape(ctxkeys.URLPath(ctx)) }
						hx-trigger="load, apps-changed from:body"
						hx-swap="innerHTML"
					></div>
				}
				@sidebar.Footer(sidebar.FooterProps{Class: "gap-2 px-3.5 pb-4"}) {
					@AppTrialCard()
					@sidebar.Menu(sidebar.MenuProps{Class: "gap-0.5"}) {
						@sidebar.MenuItem() {
							@sidebar.MenuButton(sidebar.MenuButtonProps{
								Href:       "/docs",
								Size:       sidebar.MenuButtonSizeSm,
								Class:      navQuietClasses,
								Attributes: templ.Attributes{"target": "_blank", "rel": "noopener"},
							}) {
								@icon.BookOpen(icon.Props{Class: "size-4"})
								<span>Documentation</span>
							}
						}
						@sidebar.MenuItem() {
							@sidebar.MenuButton(sidebar.MenuButtonProps{
								Href:  "mailto:" + cfg.SupportEmail,
								Size:  sidebar.MenuButtonSizeSm,
								Class: navQuietClasses,
							}) {
								@icon.LifeBuoy(icon.Props{Class: "size-4"})
								<span>Support</span>
							}
						}
					}
					@sidebar.Menu() {
						@sidebar.MenuItem() {
							{{ user := ctxkeys.User(ctx) }}
							if user != nil {
								@AppSidebarDropdown(user)
							}
						}
					}
				}
			}
			@sidebar.Inset(sidebar.InsetProps{Class: "min-w-0 bg-background"}) {
				@blocks.AppHeader(blocks.AppHeaderProps{Title: p.Title, Crumbs: appCrumbs(p)})
				<div id="main" class="flex-1">
					{ children... }
				</div>
			}
		}
		@appShellScript()
	}
}

// navQuietClasses is a secondary place in the sidebar: docs, support.
const navQuietClasses = "h-9 gap-3 rounded-xl px-3 text-[0.8125rem] text-muted-foreground hover:bg-sidebar-accent hover:text-foreground"

func appCrumbs(p AppProps) []blocks.Crumb {
	crumbs := make([]blocks.Crumb, 0, len(p.Crumbs)+1)
	for _, crumb := range p.Crumbs {
		crumbs = append(crumbs, blocks.Crumb{Label: crumb.Label, Href: crumb.Href})
	}
	if len(crumbs) == 0 {
		crumbs = append(crumbs, blocks.Crumb{Label: p.Title})
	}
	return crumbs
}

templ AppSidebarDropdown(user *model.User) {
	@dropdown.DropdownMenu() {
		@sidebar.MenuButton(sidebar.MenuButtonProps{
			Size:       sidebar.MenuButtonSizeLg,
			Class:      "h-13 gap-3 rounded-2xl px-2.5 hover:bg-sidebar-accent data-popup-open:bg-sidebar-accent",
			Attributes: dropdown.Trigger(ctx),
		}) {
			@AppSidebarAvatar(user)
			@AppSidebarUserSummary(user)
			@icon.ChevronsUpDown(icon.Props{Class: "ml-auto size-3.5 text-muted-foreground"})
		}
		@dropdown.Content(dropdown.ContentProps{
			Class: "w-60",
			Side:  dropdown.SideTop,
			Align: dropdown.AlignStart,
		}) {
			@AppSidebarUserLabel(user)
			@dropdown.Separator()
			@dropdown.Group() {
				@AppSidebarAccountLinks()
			}
			@dropdown.Separator()
			@dropdown.Group() {
				@AppSidebarLogout()
			}
		}
	}
}

// appShellScript adds what every page of the panel shares: copy buttons
// ([data-copy] copies its value, or the text of the element its
// data-copy-target selects), the go-to keys (g then a, s, b, y, t or ,) and / or n to
// focus the page's main field ([data-hotkey-focus]).
templ appShellScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			if (window.opsShell) return;
			window.opsShell = true;
			const copy = async (text) => {
				try {
					await navigator.clipboard.writeText(text);
					return true;
				} catch {
					const area = document.createElement("textarea");
					area.value = text;
					area.style.position = "fixed";
					area.style.opacity = "0";
					document.body.appendChild(area);
					area.select();
					const done = document.execCommand("copy");
					area.remove();
					return done;
				}
			};
			document.addEventListener("click", async (event) => {
				const button = event.target.closest("[data-copy]");
				if (!button) return;
				event.preventDefault();
				const target = button.dataset.copyTarget && document.querySelector(button.dataset.copyTarget);
				const text = target ? target.textContent.trim() : button.dataset.copy;
				if (!text || !(await copy(text))) return;
				button.dataset.copied = "";
				const label = button.querySelector("[data-copy-label]");
				if (label && !label.dataset.before) label.dataset.before = label.textContent;
				if (label) label.textContent = "Copied";
				clearTimeout(button.copyTimer);
				button.copyTimer = setTimeout(() => {
					delete button.dataset.copied;
					if (label) label.textContent = label.dataset.before;
				}, 1400);
			});
			const places = { a: "/apps", s: "/servers", b: "/bucket", y: "/activity", t: "/workspace", ",": "/settings" };
			let leader = 0;
			document.addEventListener("keydown", (event) => {
				if (event.metaKey || event.ctrlKey || event.altKey || event.defaultPrevented) return;
				const target = event.target;
				if (target.closest && target.closest("input, textarea, select, [contenteditable], [role=combobox], [role=listbox]")) {
					if (event.key === "Escape") target.blur();
					return;
				}
				if (event.key === "g") {
					leader = Date.now();
					return;
				}
				if (leader && Date.now() - leader < 1200 && places[event.key]) {
					leader = 0;
					event.preventDefault();
					const base = document.querySelector("[data-app-base]");
					if (base) location.assign(base.dataset.appBase + places[event.key]);
					return;
				}
				leader = 0;
				if (event.key === "/" || event.key === "n") {
					const field = document.querySelector("[data-hotkey-focus]");
					if (field) {
						event.preventDefault();
						field.focus();
					}
				}
			});
		})();
	</script>
}
