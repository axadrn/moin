package layouts

import (
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/ui/blocks"
	"github.com/axadrn/ops/controlplane/internal/ui/components/sidebar"
)

// Crumb is one step of the path in the top bar. The last one has no link.
type Crumb struct {
	Label string
	Href  string
}

// AppProps is the shell of a control panel page.
type AppProps struct {
	Title  string
	Crumbs []Crumb
}

// App is the control panel shell with the page title as the only crumb.
templ App(title string) {
	@AppShell(AppProps{Title: title}) {
		{ children... }
	}
}

// AppShell is the control panel: the sidebar with the places, the top bar
// with the path, and the page.
templ AppShell(p AppProps) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@Base(SEOProps{
		Title:       p.Title,
		Description: "The ops control panel",
		Path:        ctxkeys.URLPath(ctx),
		Boost:       appBoost,
	}) {
		@sidebar.Provider(sidebar.ProviderProps{
			ID:                 "app-sidebar",
			Class:              "bg-background",
			DisableDefaultOpen: ctxkeys.SidebarCollapsed(ctx),
			Attributes:         templ.Attributes{"style": "--sidebar-width: 16rem; --sidebar-width-icon: 3rem; --header-height: 3.5rem;"},
		}) {
			@sidebar.Sidebar(sidebar.Props{Collapsible: sidebar.CollapsibleIcon}) {
				@sidebar.Header() {
					@AppSidebarIdentity()
				}
				@sidebar.Content() {
					<div id="sidebar-nav" class="contents">
						@AppSidebarNavigation()
					</div>
					// The apps load after the page and again after every boosted
					// swap, which pushes the new URL, so the open app stays marked.
					<div
						id="sidebar-apps"
						class="contents"
						hx-get={ basePath + "/apps/nav" }
						hx-trigger="load, apps-changed from:body, htmx:after:history:push from:document"
						hx-swap="innerHTML"
					></div>
				}
				@sidebar.Footer() {
					@AppSidebarHelp()
					@AppTrialCard()
					{{ user := ctxkeys.User(ctx) }}
					if user != nil {
						@AppSidebarUser(user)
					}
				}
				@sidebar.Rail()
			}
			@sidebar.Inset(sidebar.InsetProps{Class: "min-w-0 bg-background"}) {
				@blocks.AppHeader(blocks.AppHeaderProps{Title: p.Title, Crumbs: appCrumbs(p)})
				<div id="main" class="flex-1">
					{ children... }
				</div>
			}
		}
		@appShellScript()
		@sortableScript()
		@sidebarMenuSides()
	}
}

// sortableScript lets [data-sortable-list] be ordered by drag and drop, as
// in the htmx drag-to-reorder pattern: Sortable.js moves the items, and its
// end event, which bubbles, sends the form around the list, whose hidden
// inputs carry the new order. The list waits while the form is out and
// starts again on the list the answer swaps in. After an arrow button moved
// an item, the focus stays on that button of the item.
templ sortableScript() {
	<script src="/assets/js/sortable-1.15.6.6d0a831f.min.js"></script>
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			if (window.opsSortable) return;
			window.opsSortable = true;
			const start = (root) => {
				if (!root.querySelectorAll) return;
				const lists = [...root.querySelectorAll("[data-sortable-list]")];
				if (root.matches?.("[data-sortable-list]")) lists.push(root);
				for (const list of lists) {
					if (Sortable.get(list)) continue;
					new Sortable(list, {
						animation: 150,
						handle: "[data-drag-handle]",
						ghostClass: "opacity-40",
						onEnd() {
							this.option("disabled", true);
						},
					});
				}
			};
			start(document);
			document.addEventListener("htmx:after:process", (event) => start(event.target));
			let moved = null;
			document.addEventListener("htmx:before:request", (event) => {
				const active = document.activeElement;
				moved = event.target.matches?.("[data-order-form]") && active?.form === event.target && (active.name === "up" || active.name === "down") ? { name: active.name, value: active.value } : null;
			});
			const refocus = () => {
				if (!moved) return;
				const buttons = [...document.querySelectorAll("[data-order-form] button")].filter((button) => button.value === moved.value);
				const button = buttons.find((button) => button.name === moved.name && !button.disabled) || buttons.find((button) => !button.disabled);
				moved = null;
				button?.focus();
			};
			document.addEventListener("htmx:after:settle", refocus);
			document.addEventListener("htmx:finally:request", (event) => {
				// A list the answer did not replace takes drags again.
				const list = event.target.querySelector?.("[data-sortable-list]");
				if (list?.isConnected) Sortable.get(list)?.option("disabled", false);
				refocus();
			});
		})();
	</script>
}

// sidebarMenuSides is the pendant of useSidebar().isMobile in shadcn's
// sidebar-07: the workspace and user menus open to the right of the
// sidebar, and below their button on phones. A menu reads its side when it
// opens; the menus are looked up each time, as the workspace one is swapped
// in place after a rename.
templ sidebarMenuSides() {
	<script type="module" nonce={ templ.GetNonce(ctx) }>
		window.templ.sidebar.onMobileChange((isMobile) => {
			for (const id of ["sidebar-workspace-menu", "sidebar-user-menu"]) {
				// The id names the menu popup, its positioner holds the side.
				document.getElementById(id)?.parentElement?.setAttribute("data-templ-side", isMobile ? "bottom" : "right");
			}
		});
	</script>
}

func appCrumbs(p AppProps) []blocks.Crumb {
	crumbs := make([]blocks.Crumb, 0, len(p.Crumbs)+1)
	for _, crumb := range p.Crumbs {
		crumbs = append(crumbs, blocks.Crumb{Label: crumb.Label, Href: crumb.Href})
	}
	if len(crumbs) == 0 {
		crumbs = append(crumbs, blocks.Crumb{Label: p.Title})
	}
	return crumbs
}

// appBoost makes every link and form of the panel swap only #main, and
// brings the sidebar places and the top bar of the new page along, so the
// active place and the path stay right. Links that change the context opt
// out with hx-boost="false" (DESIGN.md, Navigation).
const appBoost = `{"target":"#main","select":"#main","swap":"outerHTML","selectOOB":"#sidebar-nav,#app-header"}`

// appShellScript adds what every page of the panel shares: copy buttons
// ([data-copy] copies its value, or the value or text of the element its
// data-copy-target selects, and is marked data-copied for a moment, so its
// icon turns into a check without changing its size), the go-to keys (g then a, s, b, y, t or ,) and / or n to
// focus the page's main field ([data-hotkey-focus]).
templ appShellScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			if (window.opsShell) return;
			window.opsShell = true;
			const copy = async (text) => {
				try {
					await navigator.clipboard.writeText(text);
					return true;
				} catch {
					const area = document.createElement("textarea");
					area.value = text;
					area.style.position = "fixed";
					area.style.opacity = "0";
					document.body.appendChild(area);
					area.select();
					const done = document.execCommand("copy");
					area.remove();
					return done;
				}
			};
			document.addEventListener("click", async (event) => {
				const button = event.target.closest("[data-copy]");
				if (!button) return;
				event.preventDefault();
				const target = button.dataset.copyTarget && document.querySelector(button.dataset.copyTarget);
				const text = target ? ("value" in target ? target.value : target.textContent).trim() : button.dataset.copy;
				if (!text || !(await copy(text))) return;
				button.dataset.copied = "";
				clearTimeout(button.copyTimer);
				button.copyTimer = setTimeout(() => delete button.dataset.copied, 1400);
			});
			// A boosted answer is a whole page: its parts marked hx-swap-oob
			// for their own fragment answers stay in place in #main instead of
			// being pulled out of it.
			document.addEventListener("htmx:after:request", (event) => {
				const ctx = event.detail.ctx;
				if (ctx.request.headers["HX-Boosted"] === "true") ctx.text = ctx.text.replaceAll(/ hx-swap-oob="[^"]*"/g, "");
			});
			// A boosted link to a page outside the panel (no #main) loads as
			// a full page instead of swapping in nothing.
			document.addEventListener("htmx:before:swap", (event) => {
				const ctx = event.detail.ctx;
				if (ctx.request.headers["HX-Boosted"] !== "true" || ctx.text.includes('id="main"')) return;
				event.preventDefault();
				location.replace(ctx.response?.raw?.url || ctx.request.action);
			});
			// On phones the sidebar sheet closes once the new page is in.
			document.addEventListener("htmx:after:swap", (event) => {
				if (event.detail.ctx.request.headers["HX-Boosted"] === "true") window.templ.sidebar.setOpenMobile(false);
			});
			const places = { a: "/apps", s: "/servers", b: "/bucket", y: "/activity", t: "/workspace", ",": "/settings" };
			let leader = 0;
			document.addEventListener("keydown", (event) => {
				if (event.metaKey || event.ctrlKey || event.altKey || event.defaultPrevented) return;
				const target = event.target;
				if (target.closest && target.closest("input, textarea, select, [contenteditable], [role=combobox], [role=listbox]")) {
					if (event.key === "Escape") target.blur();
					return;
				}
				if (event.key === "g") {
					leader = Date.now();
					return;
				}
				if (leader && Date.now() - leader < 1200 && places[event.key]) {
					leader = 0;
					event.preventDefault();
					const base = document.querySelector("[data-app-base]");
					if (!base) return;
					// The sidebar link swaps the page like a click on it.
					const url = base.dataset.appBase + places[event.key];
					const link = document.querySelector(`#sidebar-nav a[href="${url}"]`);
					if (link) link.click();
					else location.assign(url);
					return;
				}
				leader = 0;
				if (event.key === "/" || event.key === "n") {
					const field = document.querySelector("[data-hotkey-focus]");
					if (field) {
						event.preventDefault();
						field.focus();
					}
				}
			});
		})();
	</script>
}
