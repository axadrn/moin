package layouts

import (
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
)

// Crumb is one step of the path in the top bar. The last one has no link.
type Crumb struct {
	Label string
	Href  string
}

// AppProps is the shell of a control panel page.
type AppProps struct {
	Title  string
	Crumbs []Crumb
}

// App is the control panel shell with the page title as the only crumb.
templ App(title string) {
	@AppShell(AppProps{Title: title}) {
		{ children... }
	}
}

// AppShell is the control panel: the bar on top, the page under it. No
// sidebar: the search in the bar goes everywhere (DESIGN.md, Navigation).
templ AppShell(p AppProps) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@Base(SEOProps{
		Title:       p.Title,
		Description: "The moin control panel",
		Path:        ctxkeys.URLPath(ctx),
		Boost:       appBoost,
	}) {
		@AppBar()
		// A new release of a self-hosted control plane, for its admins.
		// It loads once per page and stays through boosted swaps.
		if ctxkeys.Workspace(ctx) != nil && !ctxkeys.RenderConfig(ctx).Billing {
			<div id="update-notice" hx-get={ basePath + "/update" } hx-trigger="load" hx-swap="outerHTML"></div>
		}
		<div id="main">
			<div class={ kit.Page, "pt-4 empty:hidden" }>
				@AppTrialCard()
			</div>
			{ children... }
		</div>
		@AppShortcuts()
		@appShellScript()
	}
}

// appBoost makes every link and form of the panel swap only #main; the bar
// stays. Links that change the context opt out with hx-boost="false"
// (DESIGN.md, Navigation).
const appBoost = `{"target":"#main","select":"#main","swap":"outerHTML"}`

// appShellScript adds what every page of the panel shares: copy buttons
// ([data-copy] copies its value, or the value or text of the element its
// data-copy-target selects, and is marked data-copied for a moment, so its
// icon turns into a check without changing its size), the go-to keys (g then h, s, b, y, t, l or ,) and n to
// focus the page's main field ([data-hotkey-focus]). / is the search (moin.js).
templ appShellScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			if (window.moinShell) return;
			window.moinShell = true;
			// The changelog dot: a version the member has not opened the
			// changelog for yet shows a dot on the account menu and its
			// Changelog item; opening it clears both, in this browser.
			const seenKey = "moin-changelog-seen";
			const markChangelog = () => {
				const item = document.querySelector("[data-changelog]");
				if (!item) return;
				let seen = "";
				try { seen = localStorage.getItem(seenKey) || ""; } catch {}
				const fresh = item.dataset.changelog !== seen;
				document.querySelectorAll("[data-changelog-dot]").forEach((dot) => { dot.hidden = !fresh; });
			};
			document.addEventListener("click", (event) => {
				const item = event.target.closest("[data-changelog]");
				if (!item) return;
				try { localStorage.setItem(seenKey, item.dataset.changelog); } catch {}
				markChangelog();
			});
			markChangelog();
			const copy = async (text) => {
				try {
					await navigator.clipboard.writeText(text);
					return true;
				} catch {
					const area = document.createElement("textarea");
					area.value = text;
					area.style.position = "fixed";
					area.style.opacity = "0";
					document.body.appendChild(area);
					area.select();
					const done = document.execCommand("copy");
					area.remove();
					return done;
				}
			};
			document.addEventListener("click", async (event) => {
				const button = event.target.closest("[data-copy]");
				if (!button) return;
				event.preventDefault();
				const target = button.dataset.copyTarget && document.querySelector(button.dataset.copyTarget);
				const text = target ? ("value" in target ? target.value : target.textContent).trim() : button.dataset.copy;
				if (!text || !(await copy(text))) return;
				button.dataset.copied = "";
				clearTimeout(button.copyTimer);
				button.copyTimer = setTimeout(() => delete button.dataset.copied, 1400);
			});
			// A boosted answer is a whole page: its parts marked hx-swap-oob
			// for their own fragment answers stay in place in #main instead of
			// being pulled out of it.
			document.addEventListener("htmx:after:request", (event) => {
				const ctx = event.detail.ctx;
				if (ctx.request.headers["HX-Boosted"] === "true") ctx.text = ctx.text.replaceAll(/ hx-swap-oob="[^"]*"/g, "");
			});
			// A boosted link to a page outside the panel (no #main) loads as
			// a full page instead of swapping in nothing.
			document.addEventListener("htmx:before:swap", (event) => {
				const ctx = event.detail.ctx;
				if (ctx.request.headers["HX-Boosted"] !== "true" || ctx.text.includes('id="main"')) return;
				event.preventDefault();
				location.replace(ctx.response?.raw?.url || ctx.request.action);
			});
			const places = { h: "/overview", o: "/overview", s: "/servers", b: "/bucket", y: "/activity", t: "/workspace", l: "/alerts", ",": "/settings" };
			let leader = 0;
			document.addEventListener("keydown", (event) => {
				if (event.metaKey || event.ctrlKey || event.altKey || event.defaultPrevented) return;
				const target = event.target;
				if (target.closest && target.closest("input, textarea, select, [contenteditable], [role=combobox], [role=listbox]")) {
					if (event.key === "Escape") target.blur();
					return;
				}
				if (event.key === "g") {
					leader = Date.now();
					return;
				}
				if (leader && Date.now() - leader < 1200 && places[event.key]) {
					leader = 0;
					event.preventDefault();
					const base = document.querySelector("[data-app-base]");
					if (!base) return;
					location.assign(base.dataset.appBase + places[event.key]);
					return;
				}
				leader = 0;
				// A section key of the page (data-key on its tab) opens it.
				const section = document.querySelector(`[data-key="${CSS.escape(event.key)}"]`);
				if (section) {
					event.preventDefault();
					section.click();
					return;
				}
				if (event.key === "n") {
					const field = document.querySelector("[data-hotkey-focus]");
					if (field) {
						event.preventDefault();
						field.focus();
					}
				}
			});
		})();
	</script>
}
