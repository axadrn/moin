package layouts

import (
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/model"
	dropdown "github.com/axadrn/ops/controlplane/internal/ui/components/dropdownmenu"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
)

templ AppSidebarAccountLinks() {
	{{ member := ctxkeys.WorkspaceMember(ctx) }}
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@dropdown.Item(dropdown.ItemProps{Href: basePath + "/settings"}) {
		@icon.Settings()
		Settings
	}
	if ctxkeys.IsAdmin(ctx) {
		@dropdown.Item(dropdown.ItemProps{Href: "/admin", Attributes: fullLoad}) {
			@icon.Shield()
			Admin
		}
	}
	if member.Can(model.WorkspacePermissionManageBilling) && ctxkeys.RenderConfig(ctx).Billing {
		@dropdown.Item(dropdown.ItemProps{Href: basePath + "/billing"}) {
			@icon.CreditCard()
			Billing
		}
	}
}
