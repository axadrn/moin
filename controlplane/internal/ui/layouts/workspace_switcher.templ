package layouts

import (
	"strings"
	"unicode/utf8"

	"github.com/axadrn/ops/controlplane/internal/model"
	dropdown "github.com/axadrn/ops/controlplane/internal/ui/components/dropdownmenu"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/components/sidebar"
)

// WorkspaceSwitcher is the team switcher of shadcn's sidebar-07: the
// current workspace on a tile with its initial, and a menu with every
// workspace of the user.
templ WorkspaceSwitcher(current *model.Workspace, workspaces []model.WorkspaceMembership) {
	@dropdown.DropdownMenu(dropdown.Props{ID: "sidebar-workspace-menu"}) {
		@sidebar.MenuButton(sidebar.MenuButtonProps{
			Size:       sidebar.MenuButtonSizeLg,
			Class:      "data-popup-open:bg-sidebar-accent data-popup-open:text-sidebar-accent-foreground",
			Attributes: dropdown.Trigger(ctx),
		}) {
			<div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sm font-medium text-sidebar-primary-foreground">
				{ workspaceInitial(current.Name) }
			</div>
			<div class="grid flex-1 text-left text-sm leading-tight">
				<span class="truncate font-medium">{ current.Name }</span>
				<span class="truncate text-xs text-muted-foreground">Switch workspace</span>
			</div>
			@icon.ChevronsUpDown(icon.Props{Class: "ml-auto"})
		}
		@dropdown.Content(dropdown.ContentProps{
			Class:      "w-fit min-w-60",
			Align:      dropdown.AlignStart,
			Side:       dropdown.SideRight,
			SideOffset: 4,
		}) {
			@dropdown.Group() {
				@dropdown.Label(dropdown.LabelProps{Class: "text-xs text-muted-foreground"}) {
					Workspaces
				}
				for _, item := range workspaces {
					@dropdown.Item(dropdown.ItemProps{Href: "/app/" + item.Slug + "/dashboard", Class: "gap-2 p-2", Attributes: fullLoad}) {
						<div class="flex size-6 shrink-0 items-center justify-center rounded-md border text-xs font-medium">
							{ workspaceInitial(item.Name) }
						</div>
						<span class="min-w-0 flex-1 truncate">{ item.Name }</span>
						@dropdown.Shortcut(dropdown.ShortcutProps{Class: "tracking-normal"}) {
							{ model.WorkspaceRoleLabel(item.Role) }
						}
						if item.ID == current.ID {
							@icon.Check(icon.Props{Class: "size-4"})
							<span class="sr-only">Current workspace</span>
						}
					}
				}
			}
			@dropdown.Separator()
			@dropdown.Group() {
				@dropdown.Item(dropdown.ItemProps{Href: "/app/" + current.Slug + "/workspace", Class: "gap-2 p-2"}) {
					<div class="flex size-6 items-center justify-center rounded-md border bg-transparent">
						@icon.Users(icon.Props{Class: "size-4"})
					</div>
					<div class="font-medium text-muted-foreground">Team</div>
				}
				@dropdown.Item(dropdown.ItemProps{Href: "/workspaces/new", Class: "gap-2 p-2", Attributes: fullLoad}) {
					<div class="flex size-6 items-center justify-center rounded-md border bg-transparent">
						@icon.Plus(icon.Props{Class: "size-4"})
					</div>
					<div class="font-medium text-muted-foreground">New workspace</div>
				}
			}
		}
	}
}

// fullLoad opts a link out of the boosted navigation: it changes the
// context, so the whole page loads (DESIGN.md, Navigation).
var fullLoad = templ.Attributes{"hx-boost": "false"}

// workspaceInitial is the first letter of a name, also when it is not ASCII.
func workspaceInitial(name string) string {
	first, _ := utf8.DecodeRuneInString(name)
	return strings.ToUpper(string(first))
}
