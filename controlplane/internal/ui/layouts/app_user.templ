package layouts

import (
	"github.com/axadrn/ops/controlplane/internal/model"
	dropdown "github.com/axadrn/ops/controlplane/internal/ui/components/dropdownmenu"
)

templ AppSidebarUserSummary(user *model.User) {
	<div id="sidebar-user-name" class="grid flex-1 text-left text-sm leading-tight" hx-swap-oob="true">
		<span class="truncate text-[0.8125rem] font-medium">{ user.Name }</span>
		<span class="truncate text-[0.6875rem] text-muted-foreground">{ user.Email }</span>
	</div>
}

templ AppSidebarUserLabel(user *model.User) {
	<div id="dropdown-user-label" hx-swap-oob="true">
		@dropdown.Label() {
			<div class="flex flex-col">
				<span class="font-medium">{ user.Name }</span>
				<span class="text-xs text-muted-foreground">{ user.Email }</span>
			</div>
		}
	</div>
}
