package layouts

import (
	"github.com/axadrn/ops/controlplane/internal/model"
	dropdown "github.com/axadrn/ops/controlplane/internal/ui/components/dropdownmenu"
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/components/sidebar"
)

// AppSidebarUser is nav-user of shadcn's sidebar-07: the signed-in user
// with a menu for the account, the theme, help and signing out.
templ AppSidebarUser(user *model.User) {
	@sidebar.Menu() {
		@sidebar.MenuItem() {
			@dropdown.DropdownMenu(dropdown.Props{ID: "sidebar-user-menu"}) {
				@sidebar.MenuButton(sidebar.MenuButtonProps{
					Size:       sidebar.MenuButtonSizeLg,
					Class:      "data-popup-open:bg-sidebar-accent data-popup-open:text-sidebar-accent-foreground",
					Attributes: dropdown.Trigger(ctx),
				}) {
					<span class="relative flex">
						@AppSidebarAvatar(user)
						<span data-changelog-dot hidden class="absolute -top-0.5 -right-0.5 size-2 rounded-full bg-live ring-2 ring-sidebar"></span>
					</span>
					@AppSidebarUserSummary(user)
					@icon.ChevronsUpDown(icon.Props{Class: "ml-auto size-4"})
				}
				@dropdown.Content(dropdown.ContentProps{
					Class:      "w-fit min-w-60",
					Side:       dropdown.SideRight,
					Align:      dropdown.AlignEnd,
					SideOffset: 4,
				}) {
					@dropdown.Group() {
						@AppSidebarUserLabel(user)
					}
					@dropdown.Separator()
					@dropdown.Group() {
						@AppSidebarAccountLinks()
						@dropdown.Item(dropdown.ItemProps{
							CloseOnClick: new(false),
							Attributes:   templ.Attributes{"data-theme-switcher": "true"},
						}) {
							@icon.SunMoon()
							Theme
						}
					}
					@dropdown.Separator()
					@dropdown.Group() {
						@AppSidebarHelpItems()
					}
					@dropdown.Separator()
					@dropdown.Group() {
						@AppSidebarLogout()
					}
				}
			}
		}
	}
}

templ AppSidebarUserSummary(user *model.User) {
	<div id="sidebar-user-name" class="grid flex-1 text-left text-sm leading-tight" hx-swap-oob="true">
		<span class="truncate font-medium">{ user.Name }</span>
		<span class="truncate text-xs text-muted-foreground">{ user.Email }</span>
	</div>
}

templ AppSidebarUserLabel(user *model.User) {
	<div id="dropdown-user-label" hx-swap-oob="true">
		@dropdown.Label(dropdown.LabelProps{Class: "p-0 font-normal"}) {
			<div class="flex items-center gap-2 px-1 py-1.5 text-left text-sm">
				@AppSidebarAvatarContent(user)
				<div class="grid flex-1 text-left text-sm leading-tight">
					<span class="truncate font-medium text-foreground">{ user.Name }</span>
					<span class="truncate text-xs">{ user.Email }</span>
				</div>
			</div>
		}
	</div>
}
