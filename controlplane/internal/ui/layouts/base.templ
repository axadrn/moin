package layouts

import "github.com/axadrn/moin/controlplane/internal/brand"
import "github.com/axadrn/moin/controlplane/internal/ctxkeys"
import "github.com/axadrn/moin/controlplane/internal/ui/blocks"
import "github.com/axadrn/moin/controlplane/internal/ui/components"
import "github.com/axadrn/moin/controlplane/internal/ui/components/button"
import "github.com/axadrn/moin/controlplane/internal/ui/csrf"
import "github.com/axadrn/moin/controlplane/internal/ui/components/toast"
import tuiutils "github.com/axadrn/moin/controlplane/internal/ui/utils"

type SEOProps struct {
	Title        string
	Description  string
	Path         string
	NoIndex      bool
	MarkdownPath string
	// Boost is the hx-boost config the body passes to every link and form
	// of the page: the control panel swaps only its content (DESIGN.md,
	// Navigation).
	Boost string
	// Public pages (home, docs, changelog, catalog, legal) carry the page
	// counter; the app, the admin and sign-in never do.
	Public bool
}

templ Base(props ...SEOProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="csrf-token" content={ ctxkeys.CSRFToken(ctx) }/>
			if len(props) > 0 {
				@seo(props[0])
			} else {
				<title>{ brand.Name }</title>
			}
			<link rel="icon" href="/favicon.ico" sizes="32x32"/>
			<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml"/>
			<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png"/>
			// The text font loads with the stylesheet, not after it, so the
			// first paint is already in Geist.
			<link rel="preload" href="/assets/fonts/geist/geist-variable.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/assets/fonts/satoshi/satoshi-black.woff2" as="font" type="font/woff2" crossorigin/>
			<link href={ tuiutils.ScriptURL("/assets/css/output.css") } rel="stylesheet"/>
			// Back and forward reload the page. A history restore swaps in a body
			// whose inline scripts carry a new nonce the page's CSP rejects.
			// Scripts in swapped content get the page's nonce, so the scripts of a
			// page run after a boosted swap too.
			<meta name="htmx-config" content={ `{"history":"reload","inlineScriptNonce":"` + templ.GetNonce(ctx) + `"}` }/>
			<script src="/assets/js/htmx-4.0.0.e484d917.min.js"></script>
			@components.Scripts()
			<script defer nonce={ templ.GetNonce(ctx) } src={ tuiutils.ScriptURL("/assets/js/moin.js") }></script>
			// Site-wide enhancements
			@themeScript()
			@feedbackScript()
			if len(props) > 0 && props[0].Public {
				@Analytics()
			}
		</head>
		<body
			class="style-nova min-h-screen"
			hx-headers:inherited={ `{"X-CSRF-Token":"` + ctxkeys.CSRFToken(ctx) + `"}` }
			if len(props) > 0 && props[0].Boost != "" {
				hx-boost:inherited={ props[0].Boost }
			}
		>
			{{ session := ctxkeys.Session(ctx) }}
			if session.IsImpersonating() {
				<div class="sticky top-0 z-50 flex items-center justify-center gap-3 border-b border-amber-500/30 bg-amber-50 px-4 py-2 text-sm text-amber-950 dark:bg-amber-950 dark:text-amber-100">
					<span>You are viewing the application as another user.</span>
					<form
						action="/admin/impersonation/stop"
						method="POST"
						hx-post="/admin/impersonation/stop"
						hx-swap="none"
						hx-disable="find button[type='submit']"
					>
						@csrf.Token()
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantLink, Size: button.SizeSm, Class: "h-auto p-0 text-amber-950 dark:text-amber-100"}) {
							Return to Admin
						}
					</form>
				</div>
			}
			{ children... }
			@toast.Toaster()
			<div id="toast-container"></div>
			@blocks.ConfirmDialog()
		</body>
	</html>
}

templ seo(props SEOProps) {
	{{ cfg := ctxkeys.RenderConfig(ctx) }}
	{{ baseURL := cfg.AppURL }}
	{{ appName := brand.Name }}
	{{ appTagline := brand.Tagline }}
	{{ fullTitle := props.Title + " · " + appName }}
	@templ.Fragment("seo-title") {
		<title id="page-title" hx-swap-oob="true">{ fullTitle }</title>
	}
	<meta name="description" content={ props.Description }/>
	// Author
	<meta name="author" content={ appName }/>
	// Robots Tags
	if props.NoIndex || cfg.RobotsNoIndex {
		<meta name="robots" content="noindex, nofollow"/>
	} else {
		<meta name="robots" content="index, follow"/>
	}
	// Canonical URL
	<link rel="canonical" href={ baseURL + props.Path }/>
	<link rel="describedby" href="/llms.txt"/>
	if props.MarkdownPath != "" {
		@templ.Fragment("seo-markdown") {
			<link id="seo-markdown" rel="alternate" type="text/markdown" href={ props.MarkdownPath } hx-swap-oob="outerHTML"/>
		}
	}
	// OpenGraph Tags
	<meta property="og:title" content={ fullTitle }/>
	<meta property="og:description" content={ props.Description }/>
	<meta property="og:type" content="website"/>
	<meta property="og:url" content={ baseURL + props.Path }/>
	<meta property="og:site_name" content={ appName }/>
	// OpenGraph Image
	<meta property="og:image" content={ baseURL + tuiutils.ScriptURL("/assets/img/og.png") }/>
	<meta property="og:image:width" content="1200"/>
	<meta property="og:image:height" content="630"/>
	<meta property="og:image:alt" content={ appName + ": " + appTagline }/>
	// Twitter Card
	<meta name="twitter:card" content="summary_large_image"/>
	<meta name="twitter:title" content={ fullTitle }/>
	<meta name="twitter:description" content={ props.Description }/>
	<meta name="twitter:image" content={ baseURL + tuiutils.ScriptURL("/assets/img/og.png") }/>
	<meta name="twitter:image:alt" content={ appName + ": " + appTagline }/>
	// Theme Color
	<meta name="theme-color" content="#000000"/>
}

// feedbackScript marks the field a request failed on (DESIGN.md, Feedback):
// the handler sends the moin:invalid event with the field's ID, and the field
// turns red and takes the focus. The message replaces the hint of its hint
// line (@fieldHint), or shows as a toast when the field has none. The line
// keeps its height, so nothing moves. Changing the field clears it again.
templ feedbackScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		document.addEventListener("moin:invalid", (event) => {
			const { field: id, title, message } = event.detail;
			const field = document.getElementById(id);
			if (!field) return;
			const hint = document.querySelector(`[data-field-hint="${CSS.escape(id)}"]`);
			const error = hint && hint.querySelector("[data-hint-error]");
			field.setAttribute("aria-invalid", "true");
			if (message && error) {
				hint.style.minHeight = `${hint.offsetHeight}px`;
				error.textContent = message;
				hint.dataset.invalid = "";
			} else if (message) {
				window.templ.toast.add({ title, description: message, type: "error" });
			}
			field.focus();
			// A select's trigger changes through its hidden input next to it.
			const select = field.matches("[role=combobox]");
			(select ? field.parentElement : field).addEventListener(select ? "change" : "input", () => {
				field.removeAttribute("aria-invalid");
				if (!hint) return;
				delete hint.dataset.invalid;
				hint.style.minHeight = "";
			}, { once: true });
		});
	</script>
}

templ themeScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		(function() {
			window.themeUtils = window.themeUtils || {};
			const media = window.matchMedia('(prefers-color-scheme: dark)');
			window.themeUtils.getThemePreference = function() {
				return localStorage.getItem('theme') || 'system';
			};
			window.themeUtils.applyTheme = function() {
				const preference = window.themeUtils.getThemePreference();
				const isDark = preference === 'system' ? media.matches : preference === 'dark';
				document.documentElement.classList.toggle('dark', isDark);
				document.dispatchEvent(new CustomEvent('theme-changed'));
			};
			window.themeUtils.cycleTheme = function() {
				const current = window.themeUtils.getThemePreference();
				const next = current === 'system' ? (media.matches ? 'light' : 'dark') : (current === 'light' ? 'dark' : 'light');
				localStorage.setItem('theme', next);
				window.themeUtils.applyTheme();
			};
			window.themeUtils.applyTheme();
			media.addEventListener('change', function() {
				if (window.themeUtils.getThemePreference() === 'system') window.themeUtils.applyTheme();
			});
			document.addEventListener('click', function(event) {
				const switcher = event.target.closest('[data-theme-switcher]');
				if (!switcher) return;
				event.preventDefault();
				window.themeUtils.cycleTheme();
			});
		})();
	</script>
}
