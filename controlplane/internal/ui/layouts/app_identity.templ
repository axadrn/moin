package layouts

import (
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/brand"
	"github.com/axadrn/ops/controlplane/internal/ui/blocks"
	"github.com/axadrn/ops/controlplane/internal/ui/components/sidebar"
)

// AppSidebarIdentity is the brand mark, which leads to the apps, and the
// workspace switcher under it, as in the team switcher of shadcn's
// sidebar-07. Collapsed to icons, the mark shrinks to fit the rail.
templ AppSidebarIdentity() {
	<div class="flex flex-col gap-2" data-app-base={ ctxkeys.AppBasePath(ctx) }>
		<a
			href={ templ.SafeURL(ctxkeys.AppBasePath(ctx) + "/apps") }
			aria-label={ brand.Name + " apps" }
			class="flex h-8 items-center gap-2 rounded-lg px-2 ring-sidebar-ring outline-hidden transition-[padding] focus-visible:ring-2 group-data-[collapsible=icon]:justify-center group-data-[collapsible=icon]:px-0"
		>
			@blocks.Wordmark("text-xl leading-none transition-[font-size] duration-200 ease-linear group-data-[collapsible=icon]:text-base")
			@blocks.BetaBadge("group-data-[collapsible=icon]:hidden")
		</a>
		@sidebar.Menu() {
			@sidebar.MenuItem() {
				@WorkspaceIdentity(ctxkeys.Workspace(ctx), ctxkeys.Workspaces(ctx))
			}
		}
	</div>
}
