package layouts

import (
	"github.com/axadrn/ops/controlplane/internal/ctxkeys"
	"github.com/axadrn/ops/controlplane/internal/ui/blocks"
)

// AppSidebarIdentity is the brand mark, which leads to the apps, and the
// workspace switcher under it.
templ AppSidebarIdentity() {
	<div class="flex flex-col gap-3" data-app-base={ ctxkeys.AppBasePath(ctx) }>
		<a
			href={ templ.SafeURL(ctxkeys.AppBasePath(ctx) + "/apps") }
			class="flex items-center gap-2.5 rounded-xl px-2.5 py-1 outline-none focus-visible:ring-2 focus-visible:ring-ring"
		>
			@blocks.Wordmark("text-[1.375rem] leading-none")
		</a>
		@WorkspaceIdentity(ctxkeys.Workspace(ctx), ctxkeys.Workspaces(ctx))
	</div>
}
