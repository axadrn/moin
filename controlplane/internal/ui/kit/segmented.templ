package kit

// Segment is one choice of a Segmented: a link, so the address says which
// one is open and the back button works.
type Segment struct {
	Label  string
	Href   string
	Key    string
	Active bool
	// Attrs swap a part of a card instead (hx-get, hx-target), when the
	// address should stay.
	Attrs templ.Attributes
}

// Segmented is the one control for "one of these": the sections of an
// app, Fields or Text, a time range. Pills in a pill, the open one lifted.
// Target names the part of the page a choice swaps, and the control itself
// (its id) comes along, so the open choice is lit; empty swaps the page.
templ Segmented(id, label, target string, segments []Segment) {
	<nav id={ id } class="flex h-11 w-full max-w-full items-center gap-1 overflow-x-auto rounded-full bg-muted p-1 [scrollbar-width:none] sm:w-fit" aria-label={ label }>
		for _, s := range segments {
			<a
				href={ templ.SafeURL(s.Href) }
				class={ "flex h-full shrink-0 items-center gap-2 rounded-full px-4 text-sm font-medium whitespace-nowrap outline-none focus-visible:ring-3 focus-visible:ring-ring/30", templ.KV("bg-background text-foreground shadow-sm", s.Active), templ.KV("text-muted-foreground hover:text-foreground", !s.Active) }
				if s.Active {
					aria-current="page"
				}
				{ s.Attrs... }
				if target != "" {
					hx-target={ target }
					hx-select={ target }
					hx-select-oob={ "#" + id }
					hx-swap="outerHTML"
					hx-push-url="true"
				}
			>
				{ s.Label }
				if s.Key != "" {
					<kbd class="hidden font-sans text-xs text-muted-foreground sm:inline">{ s.Key }</kbd>
				}
			</a>
		}
	</nav>
}
