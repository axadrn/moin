package kit

// Section is a block of a page: a quiet title, an action at its end, and
// what is under it.
templ Section(title string, action templ.Component) {
	<section class="flex flex-col gap-2">
		<div class="flex min-h-8 items-end justify-between gap-3 px-1">
			<h2 class="text-sm font-medium text-muted-foreground">{ title }</h2>
			if action != nil {
				@action
			}
		</div>
		{ children... }
	</section>
}

// List is a group of rows on one card, a thin line between two rows, inset
// like iOS; a hovered row lights up inside the card.
templ List() {
	<div class="flex flex-col rounded-4xl bg-card p-1.5" role="list">
		{ children... }
	</div>
}

// Row is one line of a List. With an href the whole row is a link and ends
// in a chevron. The first child is the main part; status and actions go
// after it.
templ Row(href string) {
	if href != "" {
		<a href={ templ.SafeURL(href) } role="listitem" class={ rowClass + " outline-none hover:bg-foreground/4 focus-visible:bg-foreground/4 active:bg-foreground/7" }>
			{ children... }
			<svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 shrink-0 text-muted-foreground"><path d="m6 3.5 4.5 4.5L6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		</a>
	} else {
		<div role="listitem" class={ rowClass }>
			{ children... }
		</div>
	}
}

const rowClass = "relative flex min-h-16 w-full items-center gap-3 rounded-3xl px-5 py-3 text-left before:absolute before:inset-x-5 before:top-0 before:h-px before:bg-border first:before:hidden hover:before:opacity-0 [&:hover+*]:before:opacity-0"

// RowButton is a Row that does something on the page instead of opening
// one: Attributes carry hx-post and the like. Danger makes its words red.
templ RowButton(danger bool, attributes templ.Attributes) {
	<button type="button" role="listitem" class={ rowClass, "outline-none hover:bg-foreground/4 focus-visible:bg-foreground/4 active:bg-foreground/7", templ.KV("text-failed", danger) } { attributes... }>
		{ children... }
	</button>
}

// RowText is the main part of a Row: a name, and a second line only when
// there is something to say.
templ RowText(name, note string) {
	<div class="min-w-0 flex-1">
		<div class="truncate font-medium">{ name }</div>
		if note != "" {
			<div class="truncate text-sm text-muted-foreground">{ note }</div>
		}
	</div>
}
