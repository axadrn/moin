package kit

// Live keeps the page live: it holds the server-sent event stream at url
// (hx-sse) and lets every named event bubble up the page, where an
// element reloads itself with hx-trigger="<event> from:body". It is the
// only way a page opens a stream; the plugin closes it when the page is
// left, so no page carries code for that.
templ Live(url string) {
	<div hx-sse:connect={ url } hidden></div>
}
