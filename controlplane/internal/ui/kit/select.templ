package kit

// SelectProps is a Select: its id, the form field name, what it picks (for
// screen readers), the options and the one picked.
type SelectProps struct {
	ID       string
	Name     string
	Label    string
	Options  []Option
	Value    string
	Disabled bool
}

// Select picks one of a list inside a form, the same on every device: the
// button shows the choice and opens a native popover of radio buttons under
// it, drawn like our menus. The checked radio is the value the form sends;
// a change on it is a change of the form (hx-trigger "change" works).
// Escape and a click outside close it natively; its script writes the
// picked label into the button and closes the list on a pick.
templ Select(p SelectProps) {
	@selectOnce.Once() {
		<script nonce={ templ.GetNonce(ctx) }>
			document.addEventListener("change", (event) => {
				const select = event.target.closest("[data-select]");
				if (!select || event.target.type !== "radio") return;
				select.querySelector("[data-select-label]").textContent = event.target.closest("label").textContent.trim();
				select.querySelector("[popover]").hidePopover();
			});
		</script>
	}
	<div class="relative w-full min-w-0" data-select>
		<button
			type="button"
			id={ p.ID }
			popovertarget={ p.ID + "-list" }
			aria-haspopup="listbox"
			aria-label={ p.Label }
			disabled?={ p.Disabled }
			class={ inputClass + " flex items-center justify-between gap-2 text-left" }
			style={ templ.SafeCSS("anchor-name: --" + p.ID) }
		>
			<span class="truncate" data-select-label>{ selectLabel(p) }</span>
			<svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 shrink-0 text-muted-foreground"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		</button>
		<div
			popover
			id={ p.ID + "-list" }
			role="listbox"
			aria-label={ p.Label }
			class="m-0 max-h-72 flex-col gap-0.5 overflow-y-auto rounded-3xl bg-popover p-1.5 text-popover-foreground shadow-2xl ring-1 ring-foreground/10 open:flex"
			style={ templ.SafeCSS("inset: auto; position-anchor: --" + p.ID + "; top: anchor(bottom); left: anchor(left); width: anchor-size(width); min-width: 12rem; margin-top: 8px") }
		>
			for _, o := range p.Options {
				<label class="flex cursor-pointer items-center gap-3 rounded-2xl px-3 py-2.5 text-sm has-checked:font-medium has-focus:bg-muted">
					<input type="radio" name={ p.Name } value={ o.Value } checked?={ o.Value == selectValue(p) } autocomplete="off" class="peer sr-only"/>
					<span class="min-w-0 flex-1 truncate">{ o.Label }</span>
					<svg aria-hidden="true" viewBox="0 0 16 16" class="hidden size-4 shrink-0 peer-checked:block"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</label>
			}
		</div>
	</div>
}

// selectOnce puts the script of Select on a page once, however many it has.
var selectOnce = templ.NewOnceHandle()

// selectValue is the option picked: the given value, or the first option,
// so the form always sends one.
func selectValue(p SelectProps) string {
	for _, o := range p.Options {
		if o.Value == p.Value {
			return o.Value
		}
	}
	if len(p.Options) > 0 {
		return p.Options[0].Value
	}
	return ""
}

func selectLabel(p SelectProps) string {
	for _, o := range p.Options {
		if o.Value == selectValue(p) {
			return o.Label
		}
	}
	return ""
}
