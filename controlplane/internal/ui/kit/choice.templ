package kit

// Option is one answer of a Choice.
type Option struct {
	Value string
	Label string
}

// Choice is "one of these" inside a form: radio buttons drawn like the
// Segmented control. The checked radio is the value the form sends, and
// CSS can show what goes with it (has-[#name-value:checked]), so there is
// no script. Each radio's id is name-value.
templ Choice(name, label string, options []Option, checked string) {
	<fieldset class="flex h-11 w-fit items-center gap-1 rounded-full bg-muted p-1">
		<legend class="sr-only">{ label }</legend>
		for _, o := range options {
			<label class="flex h-full cursor-pointer items-center rounded-full px-4 text-sm font-medium text-muted-foreground has-checked:bg-background has-checked:text-foreground has-checked:shadow-sm has-focus-visible:ring-3 has-focus-visible:ring-ring/30">
				<input type="radio" id={ name + "-" + o.Value } name={ name } value={ o.Value } checked?={ o.Value == checked } autocomplete="off" class="sr-only"/>
				{ o.Label }
			</label>
		}
	</fieldset>
}
