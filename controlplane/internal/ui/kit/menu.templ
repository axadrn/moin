package kit

// Menu is a button that opens a list under it. The list is a native
// popover: a click outside or Escape closes it, with no script. CSS anchor
// positioning puts it under the button, lined up with its start or end.
type MenuProps struct {
	// ID names the popover; the button points to it.
	ID string
	// Label says what the button opens, for screen readers.
	Label string
	// End lines the list up with the end of the button instead of its start.
	End bool
	// Class is for the button.
	Class string
}

templ Menu(p MenuProps, button templ.Component) {
	<button
		type="button"
		popovertarget={ p.ID }
		aria-label={ p.Label }
		class={ "inline-flex items-center gap-2 rounded-full outline-none focus-visible:ring-3 focus-visible:ring-ring/30", p.Class }
		style={ templ.SafeCSS("anchor-name: --" + p.ID) }
	>
		@button
	</button>
	<div
		popover
		id={ p.ID }
		role="menu"
		aria-label={ p.Label }
		class="m-0 min-w-60 rounded-3xl bg-popover p-1.5 text-sm text-popover-foreground shadow-2xl ring-1 ring-foreground/10"
		style={ templ.SafeCSS(menuPlace(p)) }
	>
		{ children... }
	</div>
}

func menuPlace(p MenuProps) string {
	side := "left: anchor(left)"
	if p.End {
		side = "right: anchor(right)"
	}
	return "inset: auto; position-anchor: --" + p.ID + "; top: anchor(bottom); " + side + "; margin-top: 8px"
}

// MenuItem is one line of a menu: a link, or with hx-post in Attributes an
// action. Choosing it closes the menu (moin.js).
templ MenuItem(href string, attributes templ.Attributes) {
	if href != "" {
		<a role="menuitem" href={ templ.SafeURL(href) } class={ menuItemClass } { attributes... }>
			{ children... }
		</a>
	} else {
		<button type="button" role="menuitem" class={ menuItemClass + " w-full text-left" } { attributes... }>
			{ children... }
		</button>
	}
}

const menuItemClass = "flex items-center gap-3 rounded-2xl px-3 py-2.5 outline-none hover:bg-muted focus-visible:bg-muted [&_svg]:size-4 [&_svg]:shrink-0 [&_svg]:text-muted-foreground"

// MenuLabel is a quiet heading over a few items.
templ MenuLabel() {
	<div class="px-3 pt-2 pb-1 text-xs font-medium text-muted-foreground">
		{ children... }
	</div>
}

// MenuLine separates groups of items.
templ MenuLine() {
	<div role="separator" class="mx-3 my-1.5 h-px bg-border"></div>
}
