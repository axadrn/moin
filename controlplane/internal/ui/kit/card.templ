package kit

// Card is a block with one topic. Its title sits top left, at most one
// action top right on the same line, and the content under them. Every
// card has the same inner edge, so text in cards next to each other lines
// up.
templ Card(title string, action templ.Component) {
	<section class="flex min-w-0 flex-col gap-4 rounded-4xl bg-card p-6">
		if title != "" || action != nil {
			<div class="flex min-h-11 items-center justify-between gap-3">
				<h2 class="text-base font-medium">{ title }</h2>
				if action != nil {
					@action
				}
			</div>
		}
		{ children... }
	</section>
}

// Grid lays cards next to each other, as high as the highest, and under
// each other on a phone.
templ Grid() {
	<div class="grid items-stretch gap-4 md:grid-cols-2">
		{ children... }
	</div>
}

// Quiet is a line of secondary text: a fact, never a sentence about the UI.
templ Quiet() {
	<p class="text-sm text-muted-foreground">
		{ children... }
	</p>
}
