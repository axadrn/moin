package kit

import (
	"strings"
	"unicode/utf8"
)

// AppIcon is the icon of a catalog app, like on a phone's home screen: its
// logo on a white tile in both themes (logos are drawn for a white page),
// or its first letter on an ink tile. Only the catalog shows icons: there
// they help you pick; your own apps go by their names (DESIGN.md, Pages).
// head makes it as high as a title (44 px); else it fits a row.
templ AppIcon(name, logo string, head bool) {
	if logo != "" {
		<span class={ appIconClass(head), "bg-white p-1.5 ring-1 ring-black/5 dark:ring-white/15" } aria-hidden="true">
			<img src={ logo } alt="" class="size-full object-contain" loading="lazy" decoding="async"/>
		</span>
	} else {
		<span class={ appIconClass(head), "bg-foreground font-semibold text-background" } aria-hidden="true">
			{ appInitial(name) }
		</span>
	}
}

func appIconClass(head bool) string {
	if head {
		return "flex size-11 shrink-0 items-center justify-center rounded-[28%] text-lg"
	}
	return "flex size-9 shrink-0 items-center justify-center rounded-[28%] text-sm"
}

func appInitial(name string) string {
	first, _ := utf8.DecodeRuneInString(name)
	return strings.ToUpper(string(first))
}
