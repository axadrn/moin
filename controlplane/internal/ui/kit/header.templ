package kit

// Back is the page one step up: its name and where it is. A page at the top
// (Overview, Settings) has none.
type Back struct {
	Label string
	Href  string
}

// Header is the head of every page, the same on every page so a title
// never moves: a line for the way back ("‹ Settings"), kept empty at the
// top, then the title, big. Children go next to the title: a status, the
// actions (put them in a group with sm:ml-auto to push them right).
templ Header(back Back, title string) {
	<header class="flex flex-col gap-1">
		<div class="flex h-6 items-center">
			if back.Href != "" {
				<a href={ templ.SafeURL(back.Href) } class="-ml-1.5 flex h-8 items-center gap-0.5 rounded-full pr-2 pl-1 text-sm font-medium text-muted-foreground outline-none hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/30">
					<svg aria-hidden="true" viewBox="0 0 16 16" class="size-4"><path d="M10 3.5 5.5 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					{ back.Label }
				</a>
			}
		</div>
		<div class="flex min-h-11 flex-wrap items-center gap-x-2 gap-y-3">
			<h1 class="mr-2 py-1 text-3xl font-semibold tracking-tight text-balance">{ title }</h1>
			{ children... }
		</div>
	</header>
}
