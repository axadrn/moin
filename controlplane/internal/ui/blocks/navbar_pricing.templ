package blocks

import "github.com/axadrn/moin/controlplane/internal/ctxkeys"

// A self-hosted control plane has no prices to show.
templ NavbarPricingDesktop() {
	if ctxkeys.RenderConfig(ctx).Billing {
		@navLink("/#pricing", "Pricing")
	}
}

templ NavbarPricingMobile() {
	if ctxkeys.RenderConfig(ctx).Billing {
		@MobileLink("/#pricing", "Pricing")
	}
}
