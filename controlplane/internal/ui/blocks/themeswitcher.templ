package blocks

import "github.com/axadrn/moin/controlplane/internal/ui/kit"

// ThemeSwitcher is the round button that switches between light and dark;
// the layout's script (data-theme-switcher) does the switching.
templ ThemeSwitcher() {
	@kit.IconButton("Switch the theme", templ.Attributes{"type": "button", "data-theme-switcher": true}) {
		@kit.IconTheme("")
	}
}
