package blocks

import (
	"github.com/axadrn/ops/controlplane/internal/ui/components/icon"
	"github.com/axadrn/ops/controlplane/internal/ui/components/item"
)

// ShadcnTemplURL is the component library by the same maker.
const ShadcnTemplURL = "https://shadcn-templ.com"

// OpsURL is the public home of ops.
const OpsURL = "https://ops.goilerplate.com"

// RefURL links another product of the same maker and tells it where on ops
// the link sits, such as RefURL(GoilerplateURL, "nav").
func RefURL(url, placement string) string {
	return url + "/?ref=ops-" + placement
}

// makerProject is one of the three projects by the same maker.
type makerProject struct {
	Name, Text, Href string
}

var makerProjects = []makerProject{
	{"shadcn-templ", "The Go port of shadcn/ui", RefURL(ShadcnTemplURL, "maker")},
	{"goilerplate", "The Go SaaS starter, free and open source", RefURL(GoilerplateURL, "maker")},
	{"ops", "Deploys and backups on your own server", OpsURL},
}

// MakerProjects links shadcn-templ, goilerplate and ops side by side.
templ MakerProjects(class string) {
	@item.Group(item.GroupProps{Class: "grid gap-3 sm:grid-cols-3 " + class}) {
		for _, p := range makerProjects {
			@item.Item(item.Props{Href: p.Href, Variant: item.VariantOutline, Class: "items-start"}) {
				@item.Content() {
					@item.Title() {
						{ p.Name }
					}
					@item.Description() {
						{ p.Text }
					}
				}
				@item.Actions() {
					@icon.ArrowUpRight(icon.Props{Class: "size-4 text-muted-foreground"})
				}
			}
		}
	}
}
