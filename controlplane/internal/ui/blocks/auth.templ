package blocks

import (
	"github.com/axadrn/moin/controlplane/internal/ui/components/card"
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
	"github.com/axadrn/moin/controlplane/internal/ui/components/separator"

	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/ui/components/button"
	"github.com/axadrn/moin/controlplane/internal/ui/components/field"
	"github.com/axadrn/moin/controlplane/internal/ui/icons"
)

// AuthPrimary is the class of the main button on auth pages: full width,
// the shape and height come from the theme.
const AuthPrimary = "w-full"

// AuthSecondary is the class of the other buttons on auth pages.
const AuthSecondary = "w-full"

// AuthShell is the auth screen: the form in a quiet column on the left,
// and on a wide screen what ops promises on the right.
templ AuthShell(appName string) {
	<div class="grid min-h-svh bg-background lg:grid-cols-2">
		<div class="flex min-h-svh flex-col px-5 sm:px-10">
			<header class="flex h-20 items-center justify-between">
				<a href="/" class="text-[22px] leading-none" aria-label={ appName + " home" }>
					@Wordmark()
				</a>
				@ThemeSwitcher(ThemeSwitcherProps{Class: "size-10 rounded-full text-muted-foreground hover:bg-secondary hover:text-foreground"})
			</header>
			<main class="flex flex-1 items-center justify-center py-12">
				<div class="w-full max-w-sm">
					{ children... }
				</div>
			</main>
			<footer class="flex h-16 items-center justify-center gap-6 text-sm text-muted-foreground">
				<a href="/docs" class="transition-colors hover:text-foreground">Docs</a>
				if ctxkeys.RenderConfig(ctx).Billing {
					<a href="/legal/terms" class="transition-colors hover:text-foreground">Terms</a>
					<a href="/legal/privacy" class="transition-colors hover:text-foreground">Privacy</a>
				}
			</footer>
		</div>
		@authAside()
	</div>
}

// authAside is the promise of ops, as on the home page.
templ authAside() {
	<aside class="hidden p-3 lg:flex">
		@card.Card(card.Props{Class: "min-w-0 flex-1 justify-center gap-0 rounded-4xl py-0"}) {
			<div class="mx-auto w-full max-w-md px-12 py-16">
				<p class="text-[3.25rem] leading-[1.03] font-semibold tracking-[-0.045em]">
					<span class="block">Your servers.</span>
					<span class="block text-live">Zero data loss.</span>
				</p>
				<p class="mt-6 text-lg leading-8 text-muted-foreground">Deploy any app to servers you own. Every site checked every minute.</p>
				<ul class="mt-10 flex flex-col gap-4 text-base font-medium">
					@authProof("No SSH keys, no open ports")
					@authProof("Every change backed up")
					@authProof("Uptime checks built in")
				</ul>
			</div>
		}
	</aside>
}

// authProof is one promise of ops, with a check.
templ authProof(text string) {
	<li class="flex items-center gap-3">
		<span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-live text-background">
			@icon.Check(icon.Props{Class: "size-3.5 stroke-3"})
		</span>
		{ text }
	</li>
}

// AuthCard is the title, the description and the form of an auth page.
templ AuthCard(title, description string) {
	<div class="flex flex-col">
		<h1 class="text-center text-3xl font-semibold tracking-[-0.04em] text-balance">{ title }</h1>
		<p class="mt-3 text-center text-base text-pretty text-muted-foreground">{ description }</p>
		<div class="mt-10">
			{ children... }
		</div>
		if ctxkeys.RenderConfig(ctx).Billing {
			<p class="mt-10 text-center text-xs text-muted-foreground [&_a]:underline [&_a]:underline-offset-4 [&_a:hover]:text-foreground">
				By continuing, you agree to the <a href="/legal/terms">Terms</a> and the <a href="/legal/privacy">Privacy Policy</a>.
			</p>
		}
	</div>
}

// AuthOr separates two ways to sign in.
templ AuthOr() {
	<div class="my-1 flex items-center gap-4 text-sm text-muted-foreground">
		@separator.Separator(separator.Props{Class: "w-auto flex-1", Attributes: templ.Attributes{"aria-hidden": "true"}})
		or
		@separator.Separator(separator.Props{Class: "w-auto flex-1", Attributes: templ.Attributes{"aria-hidden": "true"}})
	</div>
}

templ OAuthButtons(googleEnabled, githubEnabled bool) {
	@field.Field() {
		if googleEnabled {
			@button.Button(button.Props{Href: "/auth/google", Variant: button.VariantSecondary, Class: AuthSecondary}) {
				@icons.Google(icons.Props{Class: "size-4"})
				Continue with Google
			}
		}
		if githubEnabled {
			@button.Button(button.Props{Href: "/auth/github", Variant: button.VariantSecondary, Class: AuthSecondary}) {
				@icons.Github(icons.Props{Class: "size-4"})
				Continue with GitHub
			}
		}
	}
}
