package blocks

import (
	"github.com/axadrn/moin/controlplane/internal/ui/components/badge"
	"github.com/axadrn/moin/controlplane/internal/ui/components/button"
	"github.com/axadrn/moin/controlplane/internal/ui/components/icon"
)

// FloatingNews is the small news pill in the bottom left corner of every
// page. Its close button hides it until the next page load, and it fades
// out while the footer is in view, so it never covers the footer.
templ FloatingNews(id, href, label string) {
	<div data-floating-news={ id } class="fixed bottom-[max(1rem,env(safe-area-inset-bottom))] left-[max(1rem,env(safe-area-inset-left))] z-40 flex max-w-[calc(100%-2rem)] items-center gap-0.5 rounded-full border border-border bg-card/80 p-1 shadow-sm backdrop-blur-xl transition-opacity duration-200 data-[hidden]:pointer-events-none data-[hidden]:opacity-0 motion-reduce:transition-none">
		@badge.Badge(badge.Props{Href: href, Variant: badge.VariantGhost, Class: "h-8 min-w-0 shrink gap-2 pl-1 text-[13px]", Attributes: templ.Attributes{"target": "_blank", "rel": "noopener"}}) {
			@badge.Badge(badge.Props{Class: "h-6 px-2.5"}) {
				New
			}
			<span class="truncate">{ label }</span>
			@icon.ArrowRight(icon.Props{Class: "text-muted-foreground", Attributes: templ.Attributes{"data-icon": "inline-end"}})
		}
		@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Class: "size-7 rounded-full text-muted-foreground", Attributes: templ.Attributes{"aria-label": "Hide this news", "data-floating-news-close": id}}) {
			@icon.X()
		}
	</div>
	<script nonce={ templ.GetNonce(ctx) }>
		(function() {
			const news = document.currentScript.previousElementSibling;
			news.querySelector('[data-floating-news-close]').addEventListener('click', function() {
				news.remove();
			});
			const footer = document.querySelector('footer');
			if (footer && 'IntersectionObserver' in window) {
				new IntersectionObserver(function(entries) {
					news.toggleAttribute('data-hidden', entries[0].isIntersecting);
				}).observe(footer);
			}
		})();
	</script>
}
