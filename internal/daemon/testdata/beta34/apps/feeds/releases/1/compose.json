{
  "name": "moin-feeds",
  "networks": {
    "default": {
      "ipam": {},
      "name": "feeds_default"
    }
  },
  "services": {
    "db": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "miniflux",
        "POSTGRES_PASSWORD": "db-password-value",
        "POSTGRES_USER": "miniflux"
      },
      "healthcheck": {
        "interval": "5s",
        "retries": 30,
        "test": [
          "CMD-SHELL",
          "pg_isready -U miniflux -d miniflux"
        ],
        "timeout": "5s"
      },
      "image": "postgres:17",
      "labels": {
        "moin.app": "feeds"
      },
      "networks": {
        "default": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "bind": {},
          "source": "/var/lib/moin/apps/feeds/volumes/data/postgres",
          "target": "/var/lib/postgresql/data",
          "type": "bind"
        }
      ]
    },
    "web": {
      "command": null,
      "depends_on": {
        "db": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "ADMIN_PASSWORD": "admin-password-value",
        "ADMIN_USERNAME": "admin",
        "CREATE_ADMIN": "1",
        "DATABASE_URL": "postgres://miniflux:db-password-value@db/miniflux?sslmode=disable",
        "DB_PASSWORD": "db-password-value",
        "RUN_MIGRATIONS": "1",
        "VERSION": "2.3.4"
      },
      "image": "miniflux/miniflux:2.3.4",
      "labels": {
        "moin.app": "feeds"
      },
      "networks": {
        "default": null
      },
      "restart": "unless-stopped"
    }
  },
  "x-moin": {
    "health": "/healthcheck",
    "port": 8080,
    "service": "web"
  }
}