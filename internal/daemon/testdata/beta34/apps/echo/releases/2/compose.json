{
  "name": "moin-echo",
  "networks": {
    "default": {
      "ipam": {},
      "name": "echo_default"
    }
  },
  "services": {
    "web": {
      "command": [
        "sh",
        "-c",
        "mkdir -p /www \u0026\u0026 echo \"greeting=$$GREETING token=$$API_TOKEN\" \u003e /www/index.html \u0026\u0026 exec httpd -f -p 8080 -h /www"
      ],
      "entrypoint": null,
      "environment": {
        "API_TOKEN": "token-value",
        "GREETING": "hello-greeting"
      },
      "expose": [
        "8080"
      ],
      "image": "busybox:1.37",
      "labels": {
        "moin.app": "echo"
      },
      "networks": {
        "default": null
      },
      "restart": "unless-stopped"
    }
  }
}