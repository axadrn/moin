package layouts

import (
	"strings"

	"github.com/axadrn/moin/cloud/internal/brand"
	"github.com/axadrn/moin/cloud/internal/ctxkeys"
	"github.com/axadrn/moin/cloud/internal/githubstars"
	"github.com/axadrn/moin/cloud/internal/ui/components"
)

// GitHubURL is the open source repository of moin.
const GitHubURL = "https://github.com/" + githubstars.Repo

// XHandle is moin's account on X, without the @.
const XHandle = "usemoin"

// XURL is moin's account on X.
const XURL = "https://x.com/" + XHandle

// navLinks are the places of the site.
func navLinks(path string) []components.BarLink {
	return []components.BarLink{
		{Label: "Docs", Href: "/docs", Current: strings.HasPrefix(path, "/docs")},
		{Label: "Catalog", Href: "/catalog", Current: strings.HasPrefix(path, "/catalog")},
		{Label: "Pricing", Href: "/#pricing"},
		{Label: "Blog", Href: "/blog", Current: strings.HasPrefix(path, "/blog")},
	}
}

// Navbar is the floating pill of the site: the wordmark, the places, the
// search, GitHub and the one way in. On a phone it keeps the wordmark,
// the search and Docs; the footer has the rest, X too. No menu: links
// change pages.
templ Navbar() {
	@components.Bar() {
		<a href="/" class="moin-row" data-gap="2" aria-label={ brand.Name + " home" }>
			@components.Wordmark(components.WordmarkProps{})
			@components.Badge(components.BadgeProps{Class: "moin-hidden-phone"}) {
				Beta
			}
		</a>
		@components.BarLinks(components.BarLinksProps{Label: "Main", Links: navLinks(ctxkeys.URLPath(ctx))})
		<span class="moin-fill"></span>
		// The one search of the site, top right on every page. Without
		// JavaScript it is the page /search.
		@components.Button(components.ButtonProps{Href: "/search", Icon: true, Quiet: true, Attrs: templ.Attributes{"data-site-search-open": true, "aria-label": "Search", "aria-keyshortcuts": "Meta+K /"}}) {
			<i class="moin-icon moin-icon-search"></i>
		}
		// The stars show once GitHub answered.
		<span class="moin-only-phone">
			@components.Button(components.ButtonProps{Href: "/docs", Quiet: true}) {
				Docs
			}
		</span>
		<span class="moin-hidden-phone">
			if stars := githubstars.Stars(); stars != "" {
				@components.Button(components.ButtonProps{Href: GitHubURL, Quiet: true, Attrs: templ.Attributes{"target": "_blank", "rel": "noopener", "aria-label": "GitHub"}}) {
					<i class="moin-icon moin-icon-git-hub"></i>
					{ stars }
				}
			} else {
				@components.Button(components.ButtonProps{Href: GitHubURL, Icon: true, Quiet: true, Attrs: templ.Attributes{"target": "_blank", "rel": "noopener", "aria-label": "GitHub"}}) {
					<i class="moin-icon moin-icon-git-hub"></i>
				}
			}
		</span>
		<span class="moin-hidden-phone">
			@components.Button(components.ButtonProps{Kind: components.Primary, Href: "/docs/getting-started"}) {
				Get started
			}
		</span>
	}
}
