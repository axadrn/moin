package components

// List is a group of items: only rows, a Card is the surface. Attrs go on
// the list.
templ List(attrs ...templ.Attributes) {
	<div class="moin-list" { joinAttrs(attrs)... }>
		{ children... }
	</div>
}

// joinAttrs puts the attributes of a variadic parameter together.
func joinAttrs(attrs []templ.Attributes) templ.Attributes {
	joined := templ.Attributes{}
	for _, one := range attrs {
		for key, value := range one {
			joined[key] = value
		}
	}
	return joined
}

// ItemProps is one Item of a List. Href makes the whole item a link with a
// chevron; External opens another site in a new tab. Without Href it only
// tells. Lead stands in front of the words, a logo. Name and Note are the
// words. Children come after the words.
type ItemProps struct {
	Href     string
	External bool
	Name     string
	Note     string
	Lead     templ.Component
	Attrs    templ.Attributes
}

templ Item(p ItemProps) {
	switch  {
		case p.Href != "" && p.External:
			<a href={ templ.SafeURL(p.Href) } target="_blank" rel="noopener" class="moin-item" { p.Attrs... }>
				@itemText(p)
				{ children... }
				<i class="moin-out"></i>
			</a>
		case p.Href != "":
			<a href={ templ.SafeURL(p.Href) } class="moin-item" { p.Attrs... }>
				@itemText(p)
				{ children... }
				<i class="moin-chevron"></i>
			</a>
		default:
			<div class="moin-item" { p.Attrs... }>
				@itemText(p)
				{ children... }
			</div>
	}
}

templ itemText(p ItemProps) {
	if p.Lead != nil {
		<span data-lead>
			@p.Lead
		</span>
	}
	if p.Name != "" {
		<div class="moin-item-text">
			<div class="moin-item-name">{ p.Name }</div>
			if p.Note != "" {
				<div class="moin-item-note">{ p.Note }</div>
			}
		</div>
	}
}

// Ticks are a few short lines of what you get, each with a quiet tick in
// front.
templ Ticks(lines ...string) {
	<ul class="moin-ticks moin-text">
		for _, line := range lines {
			<li>
				@Icon("check")
				{ line }
			</li>
		}
	</ul>
}
