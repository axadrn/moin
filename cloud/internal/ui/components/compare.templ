package components

import "strconv"

// CompareCell is one answer: a Mark kind ("yes", "no", or "" for none) and
// a short note that goes under it.
// Href makes the mark a link, Title is what it says on hover.
type CompareCell struct {
	Mark  string
	Note  string
	Href  string
	Title string
}

// CompareColumn is one choice: its name, a one-line caption like the price,
// its answer for each row, and one button at the bottom. Featured is the
// one to pick: raised, with a badge and the primary button. ActionNote is
// a tiny line under the button. With no ActionHref there is no foot. Href
// makes the name a link.
type CompareColumn struct {
	Name       string
	Href       string
	Caption    string
	Badge      string
	Featured   bool
	Cells      []CompareCell
	ActionHref string
	ActionText string
	ActionNote string
}

// CompareProps is Compare: the rows to compare, and the columns that
// answer them, one cell for each row.
// On a phone the featured column comes first and the others follow in
// order; with Reverse all of them stack last to first.
type CompareProps struct {
	Rows    []string
	Columns []CompareColumn
	Reverse bool
}

// Compare sets the choices side by side. Each column is one surface from
// its name to its button, the featured one raised; the rows line up across
// them. On a phone the columns become cards, one under another, each row
// listed as its mark and what it is.
templ Compare(p CompareProps) {
	<div class="moin-compare" data-cols={ strconv.Itoa(len(p.Columns)) } data-reverse?={ p.Reverse } style={ templ.SafeCSS("--compare-rows:" + strconv.Itoa(compareLines(p))) }>
		<div class="moin-compare-labels" aria-hidden="true">
			<div class="moin-compare-head"></div>
			for _, row := range p.Rows {
				<div class="moin-compare-cell">{ row }</div>
			}
			if compareFoot(p) {
				<div class="moin-compare-foot"></div>
			}
		</div>
		for _, col := range p.Columns {
			<section class="moin-compare-col" data-featured?={ col.Featured } aria-label={ col.Name }>
				<div class="moin-compare-head">
					if col.Badge != "" {
						<span class="moin-compare-badge">{ col.Badge }</span>
					}
					if col.Href != "" {
						<a href={ templ.SafeURL(col.Href) } class="moin-compare-name moin-link">{ col.Name }</a>
					} else {
						<span class="moin-compare-name">{ col.Name }</span>
					}
					<span class="moin-small moin-muted">{ col.Caption }</span>
				</div>
				for i, row := range p.Rows {
					<div class="moin-compare-cell">
						if col.Cells[i].Href != "" {
							<a href={ templ.SafeURL(col.Cells[i].Href) } title={ col.Cells[i].Title } rel="noopener">
								@Mark(MarkProps{Kind: col.Cells[i].Mark})
							</a>
						} else {
							<span title={ col.Cells[i].Title }>
								@Mark(MarkProps{Kind: col.Cells[i].Mark})
							</span>
						}
						<span class="moin-compare-text">
							<span class="moin-compare-what">{ row }</span>
							if col.Cells[i].Note != "" {
								<span class="moin-small moin-muted">{ col.Cells[i].Note }</span>
							}
						</span>
					</div>
				}
				if compareFoot(p) {
					<div class="moin-compare-foot">
						if col.ActionHref != "" {
							@Button(compareButton(col)) {
								{ col.ActionText }
							}
						}
						if col.ActionNote != "" {
							<span class="moin-small moin-muted">{ col.ActionNote }</span>
						}
					</div>
				}
			</section>
		}
	</div>
}

func compareButton(col CompareColumn) ButtonProps {
	p := ButtonProps{Href: col.ActionHref}
	if col.Featured {
		p.Kind = Primary
	}
	return p
}

// compareFoot says whether any column has a button.
func compareFoot(p CompareProps) bool {
	for _, col := range p.Columns {
		if col.ActionHref != "" {
			return true
		}
	}
	return false
}

// compareLines is the lines of the grid: the head, the rows, the foot.
func compareLines(p CompareProps) int {
	if compareFoot(p) {
		return len(p.Rows) + 2
	}
	return len(p.Rows) + 1
}
