package components

// Features is a grid of Feature items, three across, two on a tablet and
// one on a phone, every item as wide and as high as the others.
templ Features() {
	<div class="moin-features">
		{ children... }
	</div>
}

// FeatureProps is one Feature: the name of a line icon, a title and one
// short line.
type FeatureProps struct {
	Icon  string
	Title string
	Note  string
}

// Feature is an item of Features: an icon, a bold title and one muted line.
templ Feature(p FeatureProps) {
	<div class="moin-feature">
		@Icon(p.Icon)
		<div class="moin-stack" data-gap="1">
			<span class="moin-feature-title">{ p.Title }</span>
			<span class="moin-feature-note moin-text">{ p.Note }</span>
		</div>
	</div>
}
