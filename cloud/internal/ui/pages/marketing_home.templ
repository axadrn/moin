package pages

import (
	"github.com/axadrn/moin/cloud/internal/brand"
	"github.com/axadrn/moin/cloud/internal/ctxkeys"
	"github.com/axadrn/moin/cloud/internal/githubstars"
	"github.com/axadrn/moin/cloud/internal/tweets"
	"github.com/axadrn/moin/cloud/internal/ui/components"
	"github.com/axadrn/moin/cloud/internal/ui/layouts"
)

// Home is the landing page, top to bottom: the promise and a real
// deploy; real posts that say the problem; zero trust, how nobody gets
// in; the knocks the site's own server dropped, as proof; how nothing
// gets lost; the others; the two prices; the numbers we have; the way
// in. Every part shows a real thing moin prints, sends or counts. open is
// what the changelog says about how moin ships, posts are the posts from
// X, knocks the site's own server's (nil: none), numbers what moin
// counted.
templ Home(open HomeOpen, posts []tweets.Tweet, knocks *HomeKnocks, numbers HomeNumbers) {
	@layouts.Home(layouts.SEOProps{
		Title:       "Deploy anything. Lose nothing.",
		Description: brand.Description,
		Path:        ctxkeys.URLPath(ctx),
	}) {
		@templ.Raw(homeJSONLD(ctxkeys.RenderConfig(ctx).AppURL))
		<main>
			@HomeHero()
			if len(posts) > 0 {
				@HomeVoices(posts)
			}
			<div class="moin-page">
				@HomeNobodyGetsIn()
				if knocks != nil {
					@homeKnocks(*knocks)
				}
				@HomeLoseNothing()
				@HomeCompare()
				@HomePricing(open)
				@homeNumbers(numbers)
				@HomeEnd()
			</div>
		</main>
	}
}

// homePrimary is the one main button of the page.
templ homePrimary() {
	@components.Button(components.ButtonProps{Kind: components.Primary, Href: "/docs/getting-started"}) {
		Get started
	}
}

// homeInstall is the line that installs the CLI.
func homeInstall(site string) string {
	return "curl -fsSL " + site + "/cli.sh | sh"
}

// ---------------------------------------------------------------- hero
// HomeHero is the first screen: the promise, the two commands, and a real
// first deploy below them.
templ HomeHero() {
	<section class="moin-hero">
		<div class="moin-page">
			<div class="moin-stack" data-gap="6" data-center>
				<h1 class="moin-display moin-stack" style="--gap:0">
					<span>Deploy anything.</span>
					<span class="moin-muted">Lose nothing.</span>
				</h1>
				<p class="moin-lead moin-center"><a href={ templ.SafeURL(layouts.GitHubURL) } class="moin-link moin-foreground moin-hero-open" data-quiet>Open source.</a>{ " " }<br class="moin-only-phone"/>One command to your own server.<br/>Every backup proven, every day.</p>
			</div>
			<div class="moin-stack moin-hero-start" data-gap="6">
				@components.Command(components.CommandProps{Text: homeInstall(brand.Site)})
				<div class="moin-row" data-gap="2" data-center data-wrap>
					@homePrimary()
					// The code, and its stars once GitHub answered.
					@components.Button(components.ButtonProps{Href: layouts.GitHubURL}) {
						<i class="moin-icon moin-icon-git-hub"></i>
						GitHub
						if stars := githubstars.Stars(); stars != "" {
							<span class="moin-muted moin-digits">{ stars }</span>
						}
					}
				</div>
			</div>
		</div>
		<div class="moin-page">
			@components.Terminal(components.TerminalProps{Title: "~/shop — moin deploy prod", Lines: homeDeploy, Play: true})
		</div>
	</section>
}

// homeDeploy is a first deploy, as the CLI prints it.
var homeDeploy = []components.TerminalLine{
	{Kind: "prompt", Text: "$ moin deploy prod"},
	{Text: "shop · 3f2a9c1 → prod"},
	{Kind: "ask", Text: "? Set up moin on prod and deploy shop? [y/N] y"},
	{Kind: "step", Text: "→ installing Docker"},
	{Kind: "step", Text: "→ installing moin"},
	{Kind: "step", Text: "→ starting the daemon: backups, restore checks, reports"},
	{Kind: "step", Text: "→ sending the source"},
	{Kind: "step", Text: "→ building: Node, no Dockerfile needed"},
	{Kind: "done", Text: "✓ moin. shop is live: https://shop.203-0-113-7.sslip.io"},
	{Kind: "hint", Text: "  postgres found. See its backups: moin backups shop"},
}

// ---------------------------------------------------------------- lose nothing
// HomeLoseNothing shows the promise as moin keeps it: a backup that came
// back this morning, and a watcher that noticed a server go quiet.
templ HomeLoseNothing() {
	<section id="backups" class="moin-band">
		@homeHead("Lose nothing.", "Every day, moin restores a backup. And proves it.")
		<div class="moin-grid" data-cols="3-2">
			<div class="moin-stack" data-gap="3" data-fill>
				@components.Terminal(components.TerminalProps{Title: "~ — moin backups shop", Lines: homeBackups})
				<p class="moin-small moin-muted">SQLite and Postgres. Your own bucket. A copy before every deploy.</p>
			</div>
			<div class="moin-stack" data-gap="3" data-fill>
				@homeAlert("prod stopped reporting", "No report since 2026-11-27 03:12 UTC. The server, its network or moin on it is down.\nApps on it: shop, blog.\nLook: ssh prod, or the console of your provider.")
				<p class="moin-small moin-muted">A dead server can't tell you it's dead. A watcher can.</p>
			</div>
		</div>
		@homeMore("/docs/backups", "How backups work")
	</section>
}

// homeBackups is `moin backups shop`, as the CLI prints it.
var homeBackups = []components.TerminalLine{
	{Kind: "prompt", Text: "$ moin backups shop"},
	{Kind: "prompt", Text: "postgres"},
	{Kind: "done", Text: "✓ Restore check 4 hours ago: 20261127T030000Z restored and read fine"},
	{Text: "COPY               TAKEN           SIZE"},
	{Text: "20261127T070000Z   12 minutes ago  41 MB"},
	{Text: "20261127T060000Z   1 hour ago      41 MB"},
	{Text: "20261127T030000Z   4 hours ago     40 MB"},
	{Kind: "hint", Text: "Go back to one with moin restore shop --to <copy>"},
}

// homeAlert is a message the watcher sends, as a chat app shows it.
templ homeAlert(title, text string) {
	<figure class="moin-chat" aria-label="An alert from the watcher">
		<figcaption class="moin-row moin-small moin-muted" data-gap="2">
			@components.Dot(components.DotProps{State: components.StateFailed})
			moin watcher · Telegram
		</figcaption>
		<p class="moin-strong">{ title }</p>
		<p class="moin-text moin-muted moin-pre">{ text }</p>
	</figure>
}

// ---------------------------------------------------------------- nobody gets in
// HomeNobodyGetsIn is the shape of moin: commands go in over SSH, reports
// go out, and nothing comes back the other way.
templ HomeNobodyGetsIn() {
	<section id="security" class="moin-band">
		@homeHead("Zero trust deploys.", "No dashboard holds a key to your server. Not even ours.")
		@components.Card(components.CardProps{Attrs: templ.Attributes{"style": "--pad:2rem"}}) {
			@homeRoads()
			@homeRoadsTall()
		}
		<div class="moin-grid" data-cols="2">
			@homeFact("No open ports.", "Nothing listens for moin. Public SSH closes after the first deploy. It counts every knock.")
			@homeFact("Tailscale and Cloudflare, built in.", "SSH in your tailnet. Visitors through a tunnel.")
			@homeFact("No surprise updates.", "Your server updates when you say so.")
			@homeFact("A hacked watcher is harmless.", "It can read. It can't command.")
		</div>
		@homeMore("/docs/security", "Security in detail")
	</section>
}

// homeHead is the top of a section: a statement and one short line.
templ homeHead(statement, line string) {
	<div class="moin-stack moin-band-head" data-gap="3">
		<h2 class="moin-statement">{ statement }</h2>
		<p class="moin-lead">{ line }</p>
	</div>
}

// homeMore is the link under a section to the docs about it.
templ homeMore(href, text string) {
	<p class="moin-center">
		<a href={ templ.SafeURL(href) } class="moin-link moin-foreground">{ text }</a>
	</p>
}

// homeFact is one short fact: a name, and a line under it.
templ homeFact(name, note string) {
	@components.Card(components.CardProps{Attrs: templ.Attributes{"data-gap": "1", "style": "--pad:2rem"}}) {
		<span class="moin-fact-name">{ name }</span>
		<span class="moin-text moin-muted">{ note }</span>
	}
}

// homeRoads draws the two one-way roads: laptop to server over SSH, server
// to watcher and bucket, arrows one way only.
templ homeRoads() {
	<svg class="moin-roads" viewBox="0 0 960 220" role="img" aria-label="Your laptop sends commands to your server over SSH. The server sends reports to a watcher and copies to your bucket. Nothing goes back.">
		<defs>
			<marker id="road-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
				<path d="M0 0 10 5 0 10z" fill="currentColor"></path>
			</marker>
		</defs>
		<g fill="none" stroke="currentColor" stroke-width="2">
			<rect x="10" y="70" width="190" height="80" rx="20"></rect>
			<rect x="385" y="70" width="190" height="80" rx="20" class="moin-roads-ink"></rect>
			<rect x="760" y="10" width="190" height="80" rx="20"></rect>
			<rect x="760" y="130" width="190" height="80" rx="20"></rect>
			<path d="M200 110H377" marker-end="url(#road-arrow)"></path>
			<path d="M575 95C670 95 680 50 752 50" marker-end="url(#road-arrow)"></path>
			<path d="M575 125C670 125 680 170 752 170" marker-end="url(#road-arrow)"></path>
		</g>
		<g fill="currentColor" font-family="var(--font-sans)" text-anchor="middle">
			<text x="105" y="106" font-size="20" font-weight="600">your laptop</text>
			<text x="105" y="130" font-size="15" class="moin-roads-muted">moin deploy prod</text>
			<text x="480" y="106" font-size="20" font-weight="600" class="moin-roads-ink-text">your server</text>
			<text x="480" y="130" font-size="15" class="moin-roads-ink-text">apps, backups, checks</text>
			<text x="855" y="46" font-size="20" font-weight="600">watcher</text>
			<text x="855" y="70" font-size="15" class="moin-roads-muted">alerts you</text>
			<text x="855" y="166" font-size="20" font-weight="600">your bucket</text>
			<text x="855" y="190" font-size="15" class="moin-roads-muted">the copies</text>
			<text x="290" y="96" font-size="15" class="moin-roads-muted">ssh, your key</text>
			<text x="672" y="40" font-size="15" class="moin-roads-muted">reports</text>
			<text x="672" y="200" font-size="15" class="moin-roads-muted">copies</text>
		</g>
	</svg>
}

// homeRoadsTall is homeRoads for a phone: the same roads, top to bottom.
templ homeRoadsTall() {
	<svg class="moin-roads" data-tall viewBox="0 0 360 430" role="img" aria-label="Your laptop sends commands to your server over SSH. The server sends reports to a watcher and copies to your bucket. Nothing goes back.">
		<defs>
			<marker id="road-arrow-tall" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
				<path d="M0 0 10 5 0 10z" fill="currentColor"></path>
			</marker>
		</defs>
		<g fill="none" stroke="currentColor" stroke-width="2">
			<rect x="80" y="10" width="200" height="80" rx="20"></rect>
			<rect x="80" y="175" width="200" height="80" rx="20" class="moin-roads-ink"></rect>
			<rect x="5" y="340" width="160" height="80" rx="20"></rect>
			<rect x="195" y="340" width="160" height="80" rx="20"></rect>
			<path d="M180 90V167" marker-end="url(#road-arrow-tall)"></path>
			<path d="M150 255C150 300 85 295 85 332" marker-end="url(#road-arrow-tall)"></path>
			<path d="M210 255C210 300 275 295 275 332" marker-end="url(#road-arrow-tall)"></path>
		</g>
		<g fill="currentColor" font-family="var(--font-sans)" text-anchor="middle">
			<text x="180" y="46" font-size="20" font-weight="600">your laptop</text>
			<text x="180" y="70" font-size="15" class="moin-roads-muted">moin deploy prod</text>
			<text x="250" y="134" font-size="15" class="moin-roads-muted">ssh, your key</text>
			<text x="180" y="211" font-size="20" font-weight="600" class="moin-roads-ink-text">your server</text>
			<text x="180" y="235" font-size="15" class="moin-roads-ink-text">apps, backups, checks</text>
			<text x="85" y="376" font-size="20" font-weight="600">watcher</text>
			<text x="85" y="400" font-size="15" class="moin-roads-muted">reports</text>
			<text x="275" y="376" font-size="20" font-weight="600">your bucket</text>
			<text x="275" y="400" font-size="15" class="moin-roads-muted">copies</text>
		</g>
	</svg>
}

// ---------------------------------------------------------------- pricing
// HomePricing puts the free moin next to moin cloud: everything is open
// source and free; the cloud takes two jobs off your hands.
templ HomePricing(open HomeOpen) {
	<section id="pricing" class="moin-band">
		@homeHead("Free. Or free of worries.", "Open source, all of it. Or let us watch.")
		<div class="moin-grid" data-cols="2">
			@components.Card(components.CardProps{Attrs: templ.Attributes{"data-gap": "6", "style": "--pad:2rem"}}) {
				<div class="moin-stack" data-gap="1">
					<span class="moin-strong">{ brand.Name }</span>
					<span class="moin-row" data-gap="2" data-baseline><span class="moin-title moin-digits">$0</span><span class="moin-small moin-muted">forever, open source</span></span>
					<span class="moin-small moin-muted">{ homeShips(open) }</span>
				</div>
				@homePlanRows(
					"Deploy, rollback, logs, env, domains",
					"Backups into your own bucket",
					"A restore check every day",
					"Alerts while your server lives",
					"Run your own watcher on a second server",
					"AI agents use the same CLI",
				)
				<div class="moin-card-end">
					@homePrimary()
				</div>
			}
			@components.Card(components.CardProps{Attrs: templ.Attributes{"data-gap": "6", "style": "--pad:2rem"}}) {
				<div class="moin-stack" data-gap="1">
					<span class="moin-row" data-gap="2">
						<span class="moin-strong">{ brand.Name } cloud</span>
						@components.Chip("Launch price")
					</span>
					<span class="moin-row" data-gap="2" data-baseline><span class="moin-title moin-digits">$7</span><span class="moin-small moin-muted">a month. Or $49 a year.</span></span>
					<span class="moin-small moin-muted">The only cloud in { brand.Name }: a watcher and a copy. Your apps never leave your server.</span>
					<span class="moin-small moin-muted">It costs more later. Yours stays as long as you stay.</span>
				</div>
				@homePlanRows(
					"Everything in "+brand.Name,
					"A watcher we run: you know when a server dies",
					"A copy of every backup your server can add to, never delete",
					"Encrypted on your server. We can't read it",
					"No bucket to set up",
					"Unlimited servers and apps",
				)
				<div class="moin-card-end">
					@components.Button(components.ButtonProps{Href: "mailto:hello@moin.run?subject=moin%20cloud"}) {
						Get in early
					}
				</div>
			}
		</div>
		<p class="moin-small moin-muted moin-center">{ brand.Name } cloud opens soon. Write to us, and the launch price is yours.</p>
	</section>
}

// homeShips says how often moin ships, from the real changelog.
func homeShips(open HomeOpen) string {
	if open.Releases == 0 {
		return "Every line on GitHub."
	}
	return "Every line on GitHub. " + homeVersions(open.Releases) + " since " + open.Since.Format("January 2, 2006") + "."
}

// homePlanRows are the lines of a plan, each with a check.
templ homePlanRows(rows ...string) {
	<ul class="moin-stack moin-text" data-gap="3">
		for _, row := range rows {
			<li class="moin-row" data-gap="3">
				<svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16" class="moin-muted"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				{ row }
			</li>
		}
	</ul>
}

// ---------------------------------------------------------------- end
// HomeEnd is the end of the page in one card: the name, where it comes
// from, the promise and the way in.
templ HomeEnd() {
	<section id="start" class="moin-band">
		@components.Card(components.CardProps{Attrs: templ.Attributes{"data-gap": "8", "style": "--pad:clamp(2rem,6vw,3.5rem)"}}) {
			<div class="moin-huge">
				@components.Wordmark(components.WordmarkProps{Size: "1em"})
			</div>
			<p class="moin-lead" data-large>
				<span class="moin-mono">/mɔɪn/</span> · Hamburg for hello. Any hour, one word.
			</p>
			<p class="moin-lead" data-large>
				I'm Axel. Born and raised in Hamburg, next to one of Europe's busiest ports. Millions of containers. Packed once. Shipped anywhere. Nothing goes missing. Your apps are containers too. So I built { brand.Name }, and named it after home.
			</p>
			<p class="moin-statement">
				Deploy anything. <span class="moin-muted">Lose nothing.</span>
			</p>
			@components.Command(components.CommandProps{Text: homeInstall(brand.Site)})
			<div class="moin-row" data-gap="2" data-wrap>
				@homePrimary()
				@components.Button(components.ButtonProps{Href: "/docs"}) {
					Read the docs
				}
			</div>
			@homeGulls()
			<div class="moin-bleed hub-harbor-in-card">
				@homeHarbor()
			</div>
		}
	</section>
}
