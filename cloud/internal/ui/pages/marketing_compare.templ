package pages

import (
	"fmt"
	"github.com/axadrn/moin/cloud/internal/compare"
	"github.com/axadrn/moin/cloud/internal/ui/components"

	"github.com/axadrn/moin/cloud/internal/brand"
	"github.com/axadrn/moin/cloud/internal/ui/layouts"
)

// ---------------------------------------------------------------- home
// HomeCompare is the comparison on the home page: four facts, each tool
// side by side, every answer linked to the page that says so. The row where
// the others do more stays in: it makes the others believable.
templ HomeCompare() {
	<section id="compare" class="moin-band">
		@homeHead("Next to the others.", "Fact by fact, from their own docs.")
		<div class="moin-table-wrap">
			<table class="moin-table">
				<thead>
					<tr>
						<th scope="col"></th>
						<th scope="col">{ brand.Name }</th>
						for _, competitor := range compare.Competitors {
							<th scope="col"><a href={ templ.SafeURL("/compare/" + competitor.Slug) } class="moin-link">{ competitor.Name }</a></th>
						}
					</tr>
				</thead>
				<tbody>
					for _, row := range homeCompareRows() {
						<tr>
							<th scope="row">{ compare.Rows[row].Label }</th>
							@compareCell(compare.Rows[row].Ours)
							for _, competitor := range compare.Competitors {
								@compareCell(competitor.Cells[row])
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p class="moin-small moin-muted moin-center">uncloud and Kamal run an app on several servers, without downtime. { brand.Name } runs it on one.</p>
		@homeMore("/compare", "Every fact, with its source")
	</section>
}

// compareCell is one answer in the home table: its mark and its words,
// linked to its source when it has one.
templ compareCell(cell compare.Cell) {
	<td data-mark={ string(cell.Mark) }>
		if cell.Source != "" {
			<a href={ templ.SafeURL(cell.Source) } title={ cell.Short } rel="noopener">{ markSymbol(cell.Mark) }</a>
		} else {
			<span title={ cell.Short }>{ markSymbol(cell.Mark) }</span>
		}
	</td>
}

// CompareIndex is /compare: every tool with its score, each a way to its
// page.
templ CompareIndex() {
	@layouts.Home(layouts.SEOProps{
		Title:       brand.Name + " compared",
		Description: compareIndexDescription(),
		Path:        "/compare",
	}) {
		<main class="moin-page moin-content">
			@components.Header(components.HeaderProps{Title: brand.Name + " compared"})
			<p class="moin-lead">Fact by fact, from each tool's own docs, each page with the day it was read. Where another tool does more, the page says so.</p>
			<div class="moin-bento">
				for _, competitor := range compare.Competitors {
					@compareCard(brand.Name+" vs "+competitor.Name, competitor.ScoreLine(), "/compare/"+competitor.Slug)
				}
			</div>
		</main>
	}
}

// compareCard is one tool on /compare: its name and score, a way to its page.
templ compareCard(name, note, href string) {
	@components.Card(components.CardProps{Href: href, Attrs: templ.Attributes{"data-gap": "1"}}) {
		<span class="moin-strong">{ name }</span>
		<span class="moin-small moin-muted">{ note }</span>
	}
}

// compareLine is the words of a row: unlike an Item's Name and Note they
// wrap, so a sentence is never cut on a phone.
templ compareLine(name, note string) {
	<div class="moin-stack moin-fill" style="--gap:2px">
		<span class="moin-strong">{ name }</span>
		<span class="moin-text moin-muted">{ note }</span>
	</div>
}

// ---------------------------------------------------------------- page
// Compare is one tool next to this one: what differs, the score, and the
// same facts for both, grouped, each answer with its mark and its source.
templ Compare(competitor compare.Competitor) {
	{{ score := competitor.Score() }}
	@layouts.Home(layouts.SEOProps{
		Title:       brand.Name + " vs " + competitor.Name,
		Description: competitor.Lead,
		Path:        "/compare/" + competitor.Slug,
	}) {
		<main class="moin-page moin-content">
			@components.Header(components.HeaderProps{Title: brand.Name + " or " + competitor.Name + "?"})
			<p class="moin-lead">{ competitor.Lead }</p>
			<p class="moin-title moin-digits">{ competitor.ScoreLine() }</p>
			<div class="moin-stack" data-gap="6">
				@compareHeader(competitor.Name, score)
				for _, group := range compare.Groups {
					<section class="moin-section">
						<div class="moin-section-head">
							<h2>{ group }</h2>
						</div>
						@components.Card(components.CardProps{}) {
							@components.List() {
								for i, row := range compare.Rows {
									if row.Group == group {
										@compareFact(row, competitor.Name, competitor.Cells[i])
									}
								}
							}
						}
					</section>
				}
			</div>
			<p class="moin-text moin-muted">
				From { competitor.Name }'s own docs, read { competitor.Read }. A check is the better answer, a dash a part of it, a cross not. A line without a mark is a fact to know, and it is not counted. "Not documented" means its docs say nothing, not that it cannot be done, and it is not counted either.
				<a href="/compare" class="moin-link moin-foreground">All comparisons</a>
			</p>
		</main>
	}
}

// compareHeader names the two columns over the table, each with its score,
// in line with the rows. A phone has no columns to name, and every answer
// says whose it is; the score over the table is there for it.
templ compareHeader(name string, score compare.Score) {
	<div aria-hidden="true" class="moin-hidden-phone">
		@components.List(templ.Attributes{"style": "--item-edge:var(--pad)"}) {
			@components.Item(components.ItemProps{}) {
				<div class="moin-grid moin-fill moin-text moin-muted" data-cols="2-3-3">
					<span></span>
					<span class="moin-stack" style="--gap:0"><span class="moin-strong">{ brand.Name }</span><span class="moin-digits">{ fmt.Sprintf("%d of %d", score.Ours, score.Facts) }</span></span>
					<span class="moin-stack" style="--gap:0"><span class="moin-strong">{ name }</span><span class="moin-digits">{ fmt.Sprintf("%d of %d", score.Theirs, score.Facts) }</span></span>
				</div>
			}
		}
	</div>
}

templ compareFact(row compare.Row, name string, cell compare.Cell) {
	@components.Item(components.ItemProps{}) {
		<div class="moin-grid moin-fill" data-cols="2-3-3">
			<span class="moin-strong">{ row.Label }</span>
			@compareAnswer(brand.Name, row.Ours)
			@compareAnswer(name, cell)
		</div>
	}
}

// compareAnswer is one side of a fact: its mark, its words, the line under
// them and where it says so.
templ compareAnswer(whose string, cell compare.Cell) {
	<div class="moin-row" data-gap="2" data-top>
		@compareMarkIcon(cell.Mark)
		<div class="moin-stack moin-text" style="--gap:2px">
			<span><span class="moin-muted moin-only-phone">{ whose }: </span><span class="moin-strong">{ cell.Short }</span></span>
			if cell.Detail != "" {
				<span class="moin-small moin-muted">{ cell.Detail }</span>
			}
			if cell.Source != "" {
				<span class="moin-small moin-muted"><a href={ templ.SafeURL(cell.Source) } target="_blank" rel="noopener" class="moin-link">Source</a></span>
			}
		</div>
	</div>
}

// compareMarkIcon is a mark in the ink of the page: a filled check, a
// dash, a cross, a question mark, or a blank that keeps the words in line.
templ compareMarkIcon(mark compare.Mark) {
	switch mark {
		case compare.Yes:
			<span role="img" aria-label="Yes" class="moin-mark" data-kind="yes">
				@components.Icon("check")
			</span>
		case compare.Part:
			<span role="img" aria-label="Partly" class="moin-mark" data-kind="part">
				<svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12"><path d="M3.5 8h9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
			</span>
		case compare.No:
			<span role="img" aria-label="No" class="moin-mark" data-kind="no">
				@components.Icon("x")
			</span>
		case compare.Unknown:
			<span role="img" aria-label="Not documented" class="moin-mark" data-kind="no">?</span>
		default:
			<span aria-hidden="true" class="moin-mark"></span>
	}
}
