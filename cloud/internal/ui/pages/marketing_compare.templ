package pages

import "github.com/axadrn/moin/cloud/internal/ui/components"

// ---------------------------------------------------------------- home
// HomeCompare is the comparison on the home page: four facts, each tool
// side by side, every answer linked to the page that says so. The row where
// the others do more stays in: it makes the others believable.
templ HomeCompare() {
	<section id="compare" class="moin-band">
		@homeHead("Next to the others.", "Fact by fact. From their own docs.")
		@components.Compare(homeCompare())
		@homeMore("/compare", "Every fact, with its source")
	</section>
}
