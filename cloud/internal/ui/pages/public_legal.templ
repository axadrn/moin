package pages

import (
	"github.com/axadrn/moin/cloud/internal/service"
	"github.com/axadrn/moin/cloud/internal/ui/components"
	"github.com/axadrn/moin/cloud/internal/ui/layouts"
)

// Legal is the terms or the privacy policy: the title, a tab bar between
// the two, when it changed last and the text.
templ Legal(page *service.LegalPage) {
	@layouts.Home(layouts.SEOProps{
		Title:       page.Title,
		Description: page.Description,
		Path:        "/legal/" + page.Slug,
	}) {
		<main class="moin-page">
			<section class="moin-band">
				@components.BandHead(components.BandHeadProps{Page: true, Title: page.Title, Line: "Last updated " + page.LastUpdated + "."})
				<div class="moin-narrow moin-stack" data-gap="6">
					<div class="moin-row" data-center>
						@components.Tabs(components.TabsProps{ID: "legal", Label: "Legal", Tabs: []components.Tab{
							{Label: "Terms of Service", Href: "/legal/terms", Active: page.Slug == "terms"},
							{Label: "Privacy Policy", Href: "/legal/privacy", Active: page.Slug == "privacy"},
						}})
					</div>
					<article>
						@components.Prose(components.ProseProps{HTML: page.Content})
					</article>
				</div>
			</section>
		</main>
	}
}
