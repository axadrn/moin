package pages

import (
	"github.com/axadrn/moin/cloud/internal/brand"
	"github.com/axadrn/moin/cloud/internal/ui/components"
)

// homeWatcherRow is one line of the watcher table: what, whether you get
// it with no watcher, your own, and moin cloud, and two words after a
// mark where it needs them.
type homeWatcherRow struct {
	What  string
	Marks [3]string
	Notes [3]string
}

// homeWatcherRows are the lines of the watcher table, the same as on top
// of the watcher docs.
var homeWatcherRows = []homeWatcherRow{
	{What: "Deploys", Marks: [3]string{"yes", "yes", "yes"}},
	{What: "Backups, restored every day", Marks: [3]string{"yes", "yes", "yes"}},
	{What: "Alerts while your server lives", Marks: [3]string{"yes", "yes", "yes"}},
	{What: "Alerts by email", Marks: [3]string{"yes", "yes", "yes"}},
	{What: "You hear when your server dies", Marks: [3]string{"no", "yes", "yes"}},
	{What: "Your domains, visited from outside", Marks: [3]string{"no", "yes", "yes"}},
	{What: "What happened, on your phone", Marks: [3]string{"no", "yes", "yes"}},
	{What: "A copy a hacked server can't delete", Marks: [3]string{"yes", "yes", "yes"}, Notes: [3]string{"Lock your bucket", "Lock your bucket", ""}},
	{What: "No second machine", Marks: [3]string{"yes", "no", "yes"}},
}

// homeWatcherColumns name the three ways, in the table's order.
var homeWatcherColumns = []string{"No watcher", "Self-hosted", brand.Name + " cloud"}

// HomeWatcher is the three ways side by side: no watcher, your own, and
// moin cloud.
templ HomeWatcher() {
	<section id="watcher" class="moin-band">
		@homeHead("Works alone. Better with a watcher.", "Your server watches itself while it lives. A watcher tells you when it doesn't.")
		@components.Card(components.CardProps{}) {
			@components.Rows(components.RowsProps{Head: append([]string{""}, homeWatcherColumns...), Top: true}) {
				for _, row := range homeWatcherRows {
					@components.Row(components.RowProps{}) {
						@components.Cell() {
							{ row.What }
						}
						for i, mark := range row.Marks {
							@components.Cell() {
								@components.Mark(components.MarkProps{Kind: mark})
								<span class="moin-stack" data-gap="1">
									<span class="moin-only-phone">{ homeWatcherColumns[i] }</span>
									if row.Notes[i] != "" {
										<span class="moin-small moin-muted">{ row.Notes[i] }</span>
									}
								</span>
							}
						}
					}
				}
			}
		}
		@homeMore("/docs/watcher", "How the watcher works")
	</section>
}
