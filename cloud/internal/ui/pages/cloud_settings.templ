package pages

import (
	"time"

	"github.com/axadrn/moin/cloud/internal/ui/components"
	"github.com/axadrn/moin/cloud/internal/workspace"
)

// CloudSettingsProps is the settings page: the account, the browsers and
// CLIs signed in to it, and what went wrong when deleting it.
type CloudSettingsProps struct {
	Cloud    Cloud
	Sessions []workspace.Session
	Problem  string
}

// CloudSettings shows the account and its sessions, signs one or all of
// them out, and deletes the account after typing its mail.
templ CloudSettings(p CloudSettingsProps) {
	@cloudApp(p.Cloud, "Settings", "Settings") {
		@components.Header(components.HeaderProps{Title: "Settings"})
		@components.Card(components.CardProps{Title: "Account"}) {
			<p class="moin-text">{ p.Cloud.Mail }</p>
			<p class="moin-small moin-muted">Your mail is your account. GitHub and the link by mail both sign in to it, when the mail is the same.</p>
		}
		@components.Card(components.CardProps{Title: "Sessions"}) {
			<p class="moin-text moin-muted">Every browser and every CLI signed in to your account. Lost a laptop? Sign it out here.</p>
			@components.Rows(components.RowsProps{Head: []string{"Session", "Signed in", "Last used", ""}}) {
				for _, session := range p.Sessions {
					@components.Row(components.RowProps{}) {
						@components.Cell() {
							{ sessionName(session) }
						}
						@components.Cell() {
							{ knownDay(session.Created) }
						}
						@components.Cell() {
							{ knownDay(session.LastUsed) }
						}
						@components.Cell() {
							<form method="post" action="/cloud/sessions/end">
								<input type="hidden" name="session" value={ session.ID }/>
								@components.Button(components.ButtonProps{Type: "submit", Quiet: true}) {
									Sign out
								}
							</form>
						}
					}
				}
			}
			<form method="post" action="/cloud/sessions/end">
				<input type="hidden" name="session" value="all"/>
				@components.Button(components.ButtonProps{Type: "submit"}) {
					Sign out everywhere
				}
			</form>
		}
		@components.Card(components.CardProps{Title: "Delete account"}) {
			<p class="moin-text moin-muted">This cancels your subscription, then deletes the workspace, the tokens of its servers and every session. Your servers keep running; their reports get no answer. Copies of backups stay under their 14-day lock and expire by themselves.</p>
			<form method="post" action="/cloud/delete" class="moin-stack" data-gap="3">
				<label for="mail" class="moin-small moin-muted">Type { p.Cloud.Mail } to confirm</label>
				@components.Input(components.InputProps{ID: "mail", Name: "mail", Type: "email", Attrs: templ.Attributes{"required": true, "autocomplete": "off"}})
				if p.Problem != "" {
					<p class="moin-message" data-state="failed" role="alert">{ p.Problem }</p>
				}
				<div>
					@components.Button(components.ButtonProps{Type: "submit", Kind: components.Danger}) {
						Delete account
					}
				</div>
			</form>
		}
	}
}

// CloudDeleted says the account is gone.
templ CloudDeleted() {
	@cloudAuth("Account deleted") {
		<h1 class="moin-title">Account deleted</h1>
		<p class="moin-text moin-muted">The workspace and its sessions are gone. Copies of backups expire by themselves within 14 days.</p>
		@components.Button(components.ButtonProps{Href: "/"}) {
			Back to home
		}
	}
}

// sessionName names a session: this browser, a browser, or the CLI.
func sessionName(session workspace.Session) string {
	switch {
	case session.This:
		return "This browser"
	case session.Kind == "cli":
		return "CLI"
	}
	return "Browser"
}

// knownDay is a time of a session as a person says it, or a dash for one
// from before moin cloud wrote it down.
func knownDay(t time.Time) string {
	if t.IsZero() {
		return "–"
	}
	return day(t)
}
